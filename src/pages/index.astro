---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import HomeHero from '../components/HomeHero.astro';
import Footer from '../components/Footer.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
const homeStudies = [
  {
    href: '/pripadove-studie/karierni-portal-automotive',
    category: 'ŠKODA AUTO · kariérní portál',
    title: '40 % uchazečů nenašlo cestu k volným pozicím. Web přitom „vypadal přehledně“.',
    method: 'Eye-tracking + dotazník · N = 102',
    result: '4 z 10 nenašli volné pozice',
  },
  {
    href: '/pripadove-studie/backend-stories',
    category: 'Edukační microsite',
    title: 'Čím delší text, tím méně pozornosti.',
    method: 'Eye-tracking, AOI analýza · cca 120 respondentů',
    result: '92 % zaznamenalo CTA',
  },
  {
    href: '/pripadove-studie/reklamni-bannery-smer-pohledu',
    category: 'Reklamní kreativa',
    title: 'Pohled postavy nasměroval pozornost návštěvníků.',
    method: 'Eye-tracking experiment · N = 104',
    result: 'ηp² = 0,11 · střední efekt',
  },
];

const gifSrc = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/hero.webp`;
const promoVideo = {
  youtubeId: 'P638-nDisOs',
  title: 'Kam se fanoušek opravdu dívá? Eye tracking na FC Hradec Králové',
  poster: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/video-eye-tracking-fanousek-fc-hradec-kralove.webp`,
};
const homeSchema = {
  '@type': 'VideoObject',
  name: promoVideo.title,
  description: 'Fanouškům FC Hradec Králové jsme nasadili mobilní eye-trackingové brýle a zaznamenali jejich pohled od vstupu přes občerstvení až po penaltu. Oranžový kroužek ukazuje, kam se v danou chvíli opravdu dívají.',
  thumbnailUrl: 'https://uxmind.cz/images/video-eye-tracking-fanousek-fc-hradec-kralove.webp',
  uploadDate: '2026-11-19',
  duration: 'PT1M35S',
  embedUrl: `https://www.youtube-nocookie.com/embed/${promoVideo.youtubeId}`,
  contentUrl: `https://www.youtube.com/watch?v=${promoVideo.youtubeId}`,
  inLanguage: 'cs',
};
const yearSuffix = new Date().getFullYear().toString().slice(-2);

const clientLogos = [
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/skoda.webp`, w: 1920, h: 630, alt: 'Škoda Auto' , dh: 50 },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/fchk.webp`, w: 800, h: 800, alt: 'FC Hradec Králové' , dh: 54 },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`, w: 157, h: 37, alt: 'Univerzita Hradec Králové' },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/texopluslogo.webp`, w: 216, h: 46, alt: 'TEXO Plus' },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/epodlahovka.webp`, w: 285, h: 49, alt: 'E-podlahovka' },
];
---

<BaseLayout schema={homeSchema} title="UX výzkum, eye tracking a uživatelské testování | UX MIND" description="Uživatelské testování, eye tracking a měření kognitivní zátěže (model EMLI). Objektivní UX výzkum s vědeckým zázemím FIM UHK. Otestujte svůj web na datech." preloadImages={[{ href: gifSrc, media: "(min-width: 1024px)" }]}>
  <Navbar />

  <HomeHero lang="cs" />

  <main id="main-content">

  <!-- LOGO STRIP -->
  <div class="border-y border-brand-black/10 py-6" style="background:#FDFDFD;">
    <p class="font-mono text-xs tracking-widest text-brand-black/60 text-center mb-4">[ SPOLUPRACOVALI JSME S ]</p>
    <!-- Desktop: statický pás -->
    <div class="hidden md:flex flex-wrap items-center justify-center gap-x-14 gap-y-6 px-6">
      {clientLogos.map(({ src, alt, w, h, dh }) => (
        <div class="px-4 py-1">
          <img
            src={src}
            alt={alt}
            title={alt}
            width={w} height={h}
            class="logo-strip-img select-none"
            style={`height:${dh || 42}px; width:auto; max-width:170px; object-fit:contain; display:block;`}
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
    <!-- Mobil: automatický carousel, dvě loga na řádek -->
    <div class="md:hidden overflow-hidden">
      <div class="logo-marquee flex items-center" style={`--loop:-${clientLogos.length * 50}vw; animation-duration:${(clientLogos.length * 50 / 15).toFixed(1)}s;`}>
        {[...clientLogos, ...clientLogos].map(({ src, alt, w, h, dh }) => (
          <div class="flex-shrink-0 flex justify-center items-center px-4" style="width:50vw;">
            <img
              src={src}
              alt={alt}
              title={alt}
              width={w} height={h}
              class="logo-strip-img select-none"
              style={`height:${dh ? Math.round(dh * 36 / 42) : 36}px; width:auto; max-width:40vw; object-fit:contain; display:block;`}
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <style>
    .logo-strip-img {
      filter: grayscale(1);
      opacity: 0.65;
    }
    .logo-marquee {
      width: max-content;
      /* smyčka je jen vizuální (transform) — loga se stahují jednorázově a běží z cache */
      animation: logo-scroll 10s linear infinite;
    }
    @keyframes logo-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(var(--loop)); } /* posun = počet log × 50vw → plynulá smyčka */
    }
    @media (prefers-reduced-motion: reduce) {
      .logo-marquee { animation: none; }
    }
  </style>

  <!-- VIDEO: EYE TRACKING NA STADIONU (FC Hradec Králové) -->
  <section class="desktop-gutter-x py-24 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-[5fr_7fr] gap-8 lg:gap-14 items-center">
      <div>
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ EYE TRACKING V TERÉNU ]</p>
        <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">Kam se fanoušek opravdu dívá<span style="color:#2D62FC">?</span></h2>
        <p class="text-sm text-brand-black/60 leading-relaxed">
          Na zápase FC Hradec Králové jsme fanouškům nasadili eye-trackingové brýle a zaznamenali jejich pohled od vstupu přes občerstvení až po penaltu.
          Oranžový kroužek ukazuje, kam se v danou chvíli opravdu dívají.
        </p>
        <p class="mt-7"><a href="/sluzby/terenni-mereni" class="font-mono text-xs tracking-widest border-b border-brand-black pb-0.5 hover:text-brand-blue hover:border-brand-blue transition-colors">JAK MĚŘENÍ V TERÉNU PROBÍHÁ →</a></p>
      </div>
      <div class="relative">
        <YouTubeFacade youtubeId={promoVideo.youtubeId} title={promoVideo.title} poster={promoVideo.poster} posterAlt="Fanoušek s mobilními eye-trackingovými brýlemi sleduje zápas na stadionu FC Hradec Králové" />
        <div class="lg:absolute lg:inset-x-0 lg:top-full flex justify-between mt-2.5 font-mono text-[11px] tracking-widest text-brand-black/60"><span>VIDEO · 1:35</span><span>PŘEHRAJE SE Z YOUTUBE</span></div>
      </div>
    </div>
  </section>

  <!-- SERVICES SECTION -->
  <section class="desktop-gutter-x py-24 max-w-7xl mx-auto">
    <div class="mb-12 max-w-3xl">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ NAŠE SLUŽBY ]</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">Co děláme<span style="color:#2D62FC">.</span></h2>
      <p class="text-sm text-brand-black/60 leading-relaxed">
        Pomáháme zjistit, kde web, aplikace nebo komunikace lidem komplikuje cestu. Problém změříme, vysvětlíme jeho příčinu a doporučíme, co upravit jako první.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10">
      {[
        {
          num: '01',
          title: 'UX Audit',
          desc: 'Projdeme váš web, e-shop nebo aplikaci očima uživatele. Najdeme místa, kde lidé tápou, nedokončí objednávku nebo přehlédnou důležitou informaci. Dostanete seznam úprav seřazený podle priority.',
          href: '/sluzby/ux-audit',
          tags: ['Analýza', 'Doporučení', 'Prioritizace'],
        },
        {
          num: '02',
          title: 'Testování uživatelů',
          desc: 'Dáme reálným uživatelům konkrétní úkoly a sledujeme, zda je dokážou splnit. Uvidíte, kde se ztrácejí, čemu nerozumějí a proč odcházejí — spolu s návrhy, co změnit.',
          href: '/sluzby/testovani-uzivatelu',
          tags: ['Úkolové scénáře', 'Úspěšnost', 'Kvalitativní vhledy'],
        },
        {
          num: '03',
          title: 'Eye Tracking',
          desc: 'Pomocí eye trackingu změříme, kam se lidé skutečně dívají. Heatmapy a záznam pohledu odhalí, čeho si všimnou, co přehlédnou a zda je důležitý obsah vede správným směrem.',
          href: '/sluzby/eye-tracking',
          tags: ['Heatmapa', 'Čas do prvního pohledu', 'Dráha pohledu'],
        },
        {
          num: '04',
          title: 'Terénní měření',
          desc: 'Sledujeme chování zákazníků přímo tam, kde se rozhodují — v prodejně, showroomu, na akci nebo u fyzického produktu. Mobilní eye-tracking brýle ukážou, čeho si v reálném prostředí všimnou a co minou.',
          href: '/sluzby/terenni-mereni',
          tags: ['Mobilní eye-tracking', 'Reálný kontext', 'Pozorování'],
        },
        {
          num: '05',
          title: 'UX Výzkum',
          desc: 'Když potřebujete pochopit nejen co nefunguje, ale také proč. Propojíme rozhovory, pozorování, testování a měření reakcí, abyste mohli rozhodovat podle skutečných potřeb uživatelů.',
          href: '/sluzby/ux-vyzkum',
          tags: ['Eye-tracking', 'Biometrie', 'Dotazníky'],
        },
        {
          num: '06',
          title: 'Případové studie',
          desc: 'Podívejte se, co odhalila skutečná měření: 40 % uchazečů nenašlo cestu k volným pozicím a hlavní CTA zaznamenalo 92 % respondentů. Ukazujeme data i změny, ke kterým vedla.',
          href: '/pripadove-studie',
          tags: ['Výsledky', 'Data', 'Rozhodnutí'],
        },
      ].map(service => (
        <a href={service.href} class="group bg-brand-white p-8 hover:bg-brand-black hover:text-brand-white transition-colors duration-300">
          <div class="flex justify-between items-start mb-8">
            <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/60">{service.num}</p>
            <span class="font-mono text-xs group-hover:text-brand-white/60">→</span>
          </div>
          <h3 class="font-display text-3xl font-bold mb-4 leading-tight">{service.title}</h3>
          <p class="text-sm text-brand-black/60 group-hover:text-brand-white/60 leading-relaxed mb-6">{service.desc}</p>
          <div class="flex flex-wrap gap-2">
            {service.tags.map(tag => (
              <span class="font-mono text-xs border border-brand-black/20 group-hover:border-brand-white/20 px-2 py-1">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
    <!-- Testovací balíčky — černý pás, ať vyniknou -->
    <a href="/sluzby/testovaci-balicky" class="group flex flex-col md:flex-row md:items-center justify-between gap-4 bg-brand-black text-brand-white border border-brand-black p-8 hover:bg-[#2D62FC] transition-colors duration-300">
      <div>
        <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-2">[ TESTOVACÍ BALÍČKY ]</p>
        <p class="font-display text-2xl font-bold leading-tight">Od rychlé kontroly po výzkum do hloubky. Vyberte si rozsah podle toho, co potřebujete zjistit.</p>
      </div>
      <span class="font-mono text-xs tracking-widest uppercase shrink-0">POROVNAT BALÍČKY →</span>
    </a>
  </section>

  <!-- TŘI OTÁZKY, TŘI MĚŘENÍ -->
  <section class="desktop-gutter-x py-24 max-w-7xl mx-auto">
    <div class="mb-12 max-w-3xl">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ TŘI OTÁZKY, TŘI MĚŘENÍ ]</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">Co uživatel vidí, jak reaguje<br/>a co ho zatěžuje<span style="color:#2D62FC">.</span></h2>
      <p class="text-sm text-brand-black/60 leading-relaxed">
        Analytika ukáže, KAM lidé klikli. Dotazník ukáže, CO si myslí. My měříme třetí vrstvu:
        co skutečně viděli, jak silně reagovali a kde je rozhraní mentálně přetížilo.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10">
      {[
        {
          q: 'Vidí to vůbec?',
          desc: 'Vizuální pozornost — kam se lidé dívají jako první, jak dlouho se u čeho zdrží a co úplně minou. Eye tracking objektivně zachytí, co uživatel skutečně viděl.',
          tool: 'EYE-TRACKING',
        },
        {
          q: 'Jak silně reaguje?',
          desc: 'Jak silně tělo reaguje (kožní vodivost) a co prozradí mimika — vždy v kontextu úkolu. Interpretujeme je s limity — žádné „čtení emocí“.',
          tool: 'KOŽNÍ VODIVOST + MIMIKA',
        },
        {
          q: 'Zvládá to bez námahy?',
          desc: 'Kognitivní zátěž jako jedno srozumitelné skóre 0–100. Zjistíte, kde rozhraní uživatele přetěžuje, i když úkol nakonec splní.',
          tool: 'MODEL EMLI',
        },
      ].map((item, i) => (
        <div class="bg-brand-white p-8 flex flex-col">
          <p class="font-mono text-xs text-brand-black/60 mb-8">0{i + 1}</p>
          <h3 class="font-display text-2xl font-bold mb-4 leading-tight">{item.q}</h3>
          <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{item.desc}</p>
          <p class="mt-auto"><span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{item.tool}</span></p>
        </div>
      ))}
    </div>
    <!-- Slovníček zkratek -->
    <details class="group border border-brand-black/15 mt-6">
        <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
          [ SLOVNÍK POJMŮ ]
          <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <dl class="px-5 pb-6 space-y-4">
            <div><dt class="font-display font-bold mb-1">TTFF</dt><dd class="text-sm text-brand-black/70 leading-relaxed">čas do první fixace pohledu</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">sledovaná oblast zájmu (Area of Interest)</dd></div>
            <div><dt class="font-display font-bold mb-1">dwell time</dt><dd class="text-sm text-brand-black/70 leading-relaxed">celkový čas strávený pohledem v oblasti</dd></div>
            <div><dt class="font-display font-bold mb-1">scanpath</dt><dd class="text-sm text-brand-black/70 leading-relaxed">dráha pohledu mezi fixacemi</dd></div>
            <div><dt class="font-display font-bold mb-1">GSR</dt><dd class="text-sm text-brand-black/70 leading-relaxed">měření kožní vodivosti, indikátor fyziologického arousalu</dd></div>
            <div><dt class="font-display font-bold mb-1">EMLI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">index mentální (kognitivní) zátěže odvozený z eye-tracking metrik</dd></div>
        </dl>
      </details>
  </section>

  <!-- EMLI SECTION -->
  <section class="desktop-gutter-x py-24 bg-brand-black text-brand-white">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="font-mono text-[11px] tracking-normal whitespace-nowrap md:text-xs md:tracking-widest md:whitespace-normal text-brand-white/70 mb-6">[ EMLI — EYE-TRACKING MENTAL LOAD INDEX ]</p>
        <h2 class="font-display text-4xl md:text-6xl font-bold leading-none tracking-tight mb-8">Mentální zátěž<br/>jako číslo<span style="color:#2D62FC">.</span></h2>
        <p class="text-brand-white/60 leading-relaxed mb-6">
          Heatmapa ukáže, kam se lidé dívali. Sama ale nepozná, jestli pro ně bylo rozhraní snadné,
          nebo je při plnění úkolu zbytečně zatěžovalo. EMLI spojuje osm eye-tracking metrik do jednoho
          skóre kognitivní zátěže od 0 do 100. <strong class="text-brand-white">Čím vyšší skóre, tím větší zátěž.</strong> Snadno tak porovnáte
          dvě varianty designu, jednotlivé kroky formuláře nebo konkurenční řešení — na datech, ne podle dojmu.
        </p>
        <p class="font-mono text-xs text-brand-white/70 leading-relaxed mb-10">
          Model vznikl v akademickém výzkumu FIM UHK.<br class="hidden md:block"/> Metodika je podrobně zdokumentovaná pro nezávislé ověření.
        </p>
        <a href="/kontakt" class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          CHCI ZMĚŘIT ZÁTĚŽ →
        </a>
      </div>
      <div class="flex justify-center">
        <!-- EMLI gauge 0–100 -->
        <svg viewBox="0 0 320 200" class="w-full max-w-sm" role="img" aria-label="Ilustrace indexu mentální zátěže EMLI na škále 0 až 100">
          <path d="M 30 170 A 130 130 0 0 1 290 170" fill="none" stroke="rgba(252,252,252,0.15)" stroke-width="14" stroke-linecap="round" />
          <path id="emli-arc" d="M 30 170 A 130 130 0 0 1 290 170" pathLength="100" fill="none" stroke="#FCFCFC" stroke-width="14" stroke-linecap="round" stroke-dasharray="65 100" />
          {Array.from({ length: 11 }).map((_, i) => {
            const a = Math.PI - (i * Math.PI) / 10;
            const x1 = 160 + Math.cos(a) * 108, y1 = 170 - Math.sin(a) * 108;
            const x2 = 160 + Math.cos(a) * 98,  y2 = 170 - Math.sin(a) * 98;
            return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="rgba(252,252,252,0.35)" stroke-width="2" />;
          })}
          <g id="emli-needle" style="transform-box: view-box; transform-origin: 160px 170px; transform: rotate(117deg);">
            <line x1="160" y1="170" x2="76" y2="170" stroke="#FCFCFC" stroke-width="2" />
          </g>
          <circle cx="160" cy="170" r="6" fill="#2D62FC" />
          <text x="30" y="192" fill="rgba(252,252,252,0.5)" font-family="monospace" font-size="12">0</text>
          <text x="278" y="192" fill="rgba(252,252,252,0.5)" font-family="monospace" font-size="12">100</text>
          <text id="emli-value" x="160" y="130" fill="#FCFCFC" text-anchor="middle" font-family="monospace" font-size="38" font-weight="700">65</text>
          <text x="160" y="150" fill="rgba(252,252,252,0.6)" text-anchor="middle" font-family="monospace" font-size="11" letter-spacing="3">EMLI</text>
          <text x="160" y="196" fill="rgba(252,252,252,0.5)" text-anchor="middle" font-family="monospace" font-size="10" letter-spacing="2">8 METRIK → 1 INDEX</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- STATS SECTION -->
  <section class="desktop-gutter-x py-16 border-t border-brand-black/10">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8">
      {[
        { num: '5+', label: 'Realizovaných studií' },
        { num: '800+', label: 'Respondentů ve studiích' },
        { num: '8', label: 'Metrik v modelu EMLI' },
        { num: '0–100', label: 'Škála indexu zátěže' },
      ].map(stat => (
        <div class="text-center">
          <p class="font-display text-5xl md:text-6xl font-bold mb-3">{stat.num}</p>
          <div class="border-t border-brand-black/15 mb-2"></div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest uppercase">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- VÝZKUM A TECHNOLOGIE -->
  <section class="desktop-gutter-x py-24 border-t border-brand-black/10 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ LABORATOŘ A TECHNOLOGIE ]</p>
        <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">Technologie nestačí.<br/>Rozhoduje metodika<span style="color:#2D62FC">.</span></h2>
        <p class="text-sm text-brand-black/60 leading-relaxed mb-8">
          Měříme v Laboratoři kognitivních studií FIM UHK i přímo v terénu. Moderní přístroje ale samy
          o sobě spolehlivý výsledek nezaručí. Proto každý výzkum začíná jasnou otázkou, scénář ověřujeme
          předem a během měření kontrolujeme kvalitu dat. Výsledky posuzujeme v kontextu konkrétního úkolu
          a otevřeně uvádíme, co z nich lze — a nelze — vyvodit.
        </p>
        <div class="flex flex-wrap gap-2">
