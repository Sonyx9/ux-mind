---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const researchQuestions = [
  { title: 'Pro koho produkt vytváříte', desc: 'Poznáme potřeby, očekávání a rozdíly mezi skupinami, které produkt nebo službu používají.' },
  { title: 'Jaký problém lidé řeší', desc: 'Odhalíme skutečné cíle, motivace a překážky, ne pouze požadavky formulované bez kontextu.' },
  { title: 'Jak probíhá celá cesta', desc: 'Propojíme jednotlivé kontaktní body a ukážeme, kde zkušenost funguje a kde se rozpadá.' },
  { title: 'Co změnit jako první', desc: 'Zjištění převedeme do priorit podle dopadu, jistoty a návaznosti na vaše produktové cíle.' },
];

const methods = [
  { title: 'Porozumět potřebám', methods: 'ROZHOVORY · KONTEXTUÁLNÍ VÝZKUM', desc: 'Když potřebujete pochopit motivace, pracovní postupy, rozhodování a okolnosti, ve kterých problém vzniká.' },
  { title: 'Ověřit skutečné chování', methods: 'UŽIVATELSKÉ TESTOVÁNÍ · POZOROVÁNÍ', desc: 'Když chcete zjistit, zda lidé zvládnou důležité úkoly a co jim v konkrétní situaci brání.' },
  { title: 'Změřit rozsah problému', methods: 'DOTAZNÍKY · ANALYTIKA · PROVOZNÍ DATA', desc: 'Když potřebujete ověřit, jak často se určitý vzorec objevuje a kterých skupin se týká.' },
  { title: 'Porovnat možné směry', methods: 'KONCEPTY · PROTOTYPY · VARIANTY', desc: 'Když vybíráte mezi řešeními a potřebujete rozhodnutí podložit chováním i zpětnou vazbou.' },
];

const deliverables = [
  { title: 'Odpověď na výzkumnou otázku', desc: 'Jasně shrneme, co data dovolují říct, co zůstává nejisté a co je potřeba ověřit dál.' },
  { title: 'Důkazy a souvislosti', desc: 'Zjištění doložíme konkrétními situacemi, výroky, vzorci chování a dostupnými daty.' },
  { title: 'Priority a příležitosti', desc: 'Oddělíme zásadní problémy od jednotlivostí a ukážeme, kde má změna největší smysl.' },
  { title: 'Podklady pro další práci', desc: 'Podle cíle připravíme doporučení, journey mapu, segmentaci, zadání pro návrh nebo plán dalšího ověření.' },
];

const situations = [
  { title: 'Nový produkt nebo služba', desc: 'Potřebujete ověřit, komu má řešení sloužit a jaký problém má skutečně řešit.' },
  { title: 'Redesign nebo změna směru', desc: 'Nechcete pouze překreslit současný stav, ale rozhodnout, co zachovat a co změnit.' },
  { title: 'Slabý výkon bez jasné příčiny', desc: 'Data ukazují problém, ale nevysvětlují motivace, očekávání ani kontext chování.' },
  { title: 'Nová cílová skupina nebo trh', desc: 'Potřebujete pochopit rozdílné potřeby dříve, než přenesete stávající řešení jinam.' },
  { title: 'Cesta napříč kanály', desc: 'Zkušenost vzniká mezi webem, podporou, pobočkou, prodejnou nebo fyzickým produktem.' },
  { title: 'Rozhodnutí s vysokým dopadem', desc: 'Potřebujete doložit směr vývoje, investici nebo změnu procesu před širším nasazením.' },
];

const process = [
  { num: '01', title: 'Rozhodnutí a kontext', desc: 'Ujasníme si, co potřebujete rozhodnout, co už víte a kde jsou největší mezery.' },
  { num: '02', title: 'Návrh výzkumu', desc: 'Zvolíme vhodné metody, cílové skupiny, vzorek a způsob vyhodnocení.' },
  { num: '03', title: 'Příprava a nábor', desc: 'Připravíme scénář, ověříme jej pilotem a zajistíme vhodné účastníky.' },
  { num: '04', title: 'Sběr a syntéza dat', desc: 'Propojíme rozhovory, chování a dostupná data a hledáme opakující se souvislosti.' },
  { num: '05', title: 'Doporučení a předání', desc: 'Výsledky převedeme do priorit a společně určíme další produktové kroky.' },
];

const faq = [
  { q: 'Co je UX výzkum?', a: 'UX výzkum systematicky zjišťuje, kdo jsou uživatelé, co potřebují, jak se chovají a proč. Pomáhá rozhodnout, jaký problém řešit, co navrhnout a které změny mají největší smysl.' },
  { q: 'Jak se UX výzkum liší od uživatelského testování?', a: 'Uživatelské testování ověřuje konkrétní rozhraní nebo prototyp. UX výzkum může řešit širší otázky o potřebách, cílových skupinách, celé zákaznické cestě nebo směru produktu a podle cíle kombinuje více metod.' },
  { q: 'Jak se UX výzkum liší od průzkumu trhu?', a: 'Průzkum trhu se často zaměřuje na velikost trhu, preference nebo značku. UX výzkum jde více do kontextu používání produktu či služby a hledá podklady pro konkrétní návrh a produktová rozhodnutí. Oba přístupy se mohou vhodně doplňovat.' },
  { q: 'Kolik účastníků potřebujeme?', a: 'Počet závisí na výzkumné otázce, počtu cílových skupin a zvolených metodách. Kvalitativní rozhovory pracují s jiným vzorkem než dotazník nebo porovnání variant, proto rozsah určujeme až při návrhu studie.' },
  { q: 'Jak dlouho UX výzkum trvá a kolik stojí?', a: 'Nejčastěji 3–8 týdnů podle počtu cílových skupin, způsobu náboru, metod a rozsahu výstupu. Po úvodním zadání připravíme konkrétní návrh, harmonogram i cenu.' },
  { q: 'Co když už máme analytiku nebo předchozí výzkum?', a: 'Stávající data nejprve projdeme a využijeme jako výchozí bod. Nový sběr navrhneme pouze tam, kde potřebujeme doplnit chybějící souvislosti nebo ověřit nejisté závěry.' },
  { q: 'Musí výzkum probíhat osobně?', a: 'Nemusí. Rozhovory a uživatelské testování lze podle cíle vést osobně i vzdáleně. Terénní výzkum naopak probíhá přímo v prostředí, kde lidé službu, produkt nebo pracovní postup používají.' },
  { q: 'Kdy do UX výzkumu zapojujete eye tracking a biometrii?', a: 'Pouze tehdy, když výzkumná otázka vyžaduje přesně měřit vizuální pozornost, fyziologickou aktivaci nebo mentální zátěž. Nejde o automatickou součást každého výzkumu, ale o volitelné rozšíření.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'UX výzkum',
    description: 'UX výzkum pro produktová rozhodnutí: rozhovory, pozorování, uživatelské testování, dotazníky, analýza dat a prioritizovaná doporučení.',
    serviceType: 'UX výzkum',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="UX výzkum pro produktová rozhodnutí | UX MIND"
  description="UX výzkum pomocí rozhovorů, pozorování, uživatelského testování a analýzy dat. Získejte jasná zjištění, priority a doporučení pro produkt."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SLUŽBY / UX VÝZKUM ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          POCHOPTE<br/>SOUVISLOSTI<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-3xl">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Rozhodněte, co má smysl vytvářet a zlepšovat.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify mb-4">
              UX výzkum odpovídá na širší otázky než test jedné obrazovky. Pomůže zjistit, kdo jsou vaši uživatelé, co potřebují, jak se rozhodují a které části jejich cesty mají největší vliv na zkušenost s produktem nebo službou.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify">
              Podle cíle kombinujeme rozhovory, pozorování, uživatelské testování, dotazníky a dostupná data. Výstupem jsou <strong class="text-brand-black">srozumitelná zjištění, priority a doporučení pro produktová rozhodnutí</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/kontakt" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              POPTAT UX VÝZKUM →
            </a>
            <a href="/sluzby#testovaci-balicky" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              PROJÍT BALÍČKY
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DÉLKA', '3–8 týdnů'],
          ['METODY', 'Rozhovory · pozorování · data'],
          ['VÝSTUPY', 'Zjištění · priority · doporučení'],
          ['FORMA', 'Výzkum na míru'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Výzkumné otázky -->
      <div class="reveal mb-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.35fr] gap-10 lg:gap-16">
          <div>
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ NA CO UX VÝZKUM ODPOVÍDÁ ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              Nejdřív otázka. Potom metoda<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <div class="border-t border-brand-white/20">
            {researchQuestions.map((question, i) => (
              <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_13rem_1fr] gap-x-4 gap-y-2 py-6 border-b border-brand-white/20">
                <span class="font-mono text-xs text-brand-white/50 pt-1">0{i + 1}</span>
                <h3 class="font-display text-lg font-bold leading-tight">{question.title}</h3>
                <p class="col-start-2 sm:col-start-3 text-sm text-brand-white/65 leading-relaxed">{question.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Kdy dává smysl -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ KDY UX VÝZKUM DÁVÁ SMYSL ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-4xl">
          Když nestačí upravit jednu obrazovku<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12">
          {situations.map((situation, i) => (
            <div class="grid grid-cols-[2rem_1fr] gap-x-4 py-6 border-t border-brand-black/20">
              <span class="font-mono text-xs text-brand-black/50 pt-1">0{i + 1}</span>
              <div>
                <h3 class="font-display text-xl font-bold mb-2 leading-tight">{situation.title}</h3>
                <p class="text-sm text-brand-black/60 leading-relaxed">{situation.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Metody -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ JAK METODY SKLÁDÁME ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6 max-w-4xl">
          Rozsah určuje rozhodnutí, ne seznam metod<span style="color:#2D62FC">.</span>
        </h2>
        <p class="text-brand-black/60 leading-relaxed text-justify max-w-3xl mb-10">
          Nezačínáme tím, že do projektu vložíme všechny dostupné techniky. Nejprve určíme, jaký typ odpovědi potřebujete, a teprve potom navrhneme nejmenší smysluplnou kombinaci metod.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          {methods.map((method, i) => (
            <div class="bg-brand-white p-8 flex flex-col min-h-64">
              <span class="font-mono text-xs text-brand-black/60 mb-8">0{i + 1}</span>
              <h3 class="font-display text-2xl font-bold mb-3">{method.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6 text-justify">{method.desc}</p>
              <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mt-auto pt-5 border-t border-brand-black/10">{method.methods}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Foto -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/laborator-ux-vyzkumu-vizualizace-1.webp`}
          alt="Laboratoř UX výzkumu — zázemí pro rozhovory, testování a biometrická měření"
          title="Laboratoř UX výzkumu"
          width="1200" height="800" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Výzkumné zázemí FIMEYELAB na FIM UHK — prostor pro rozhovory, uživatelské testování a podle potřeby také synchronizované měření.</p>
      </div>

      <!-- Výstupy -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-16">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CO DOSTANETE ]</p>
          <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight max-w-xl">
            Podklady pro rozhodnutí, ne dokument do archivu<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-black/60 leading-relaxed mt-6 max-w-xl text-justify">
            Podobu výstupu volíme podle toho, kdo s výsledky bude pracovat a jaké rozhodnutí má následovat. Journey mapa ani persona nejsou povinná položka — vzniknou jen tehdy, když pomohou další práci.
          </p>
        </div>
        <div class="border-t border-brand-black/20">
          {deliverables.map((deliverable, i) => (
            <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_13rem_1fr] gap-x-4 gap-y-2 py-6 border-b border-brand-black/20">
              <span class="font-mono text-xs text-brand-black/50 pt-1">0{i + 1}</span>
              <h3 class="font-display text-lg font-bold leading-tight">{deliverable.title}</h3>
              <p class="col-start-2 sm:col-start-3 text-sm text-brand-black/60 leading-relaxed">{deliverable.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Proces -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ JAK UX VÝZKUM PROBÍHÁ ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-4xl">
          Od otázky k dalšímu produktovému kroku<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-x-7 gap-y-10">
          {process.map(step => (
            <div class="border-t border-brand-black/20 pt-5">
              <span class="block font-mono text-xs text-brand-black/60 mb-5">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Pokročilé měření -->
      <div class="reveal mb-24 border border-brand-black/15 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ VOLITELNÉ POKROČILÉ MĚŘENÍ ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">Když výpovědi a pozorování nestačí<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Pokud výzkumná otázka vyžaduje přesně změřit vizuální pozornost, fyziologickou aktivaci nebo mentální zátěž, můžeme studii rozšířit o eye tracking, GSR, analýzu mimických signálů nebo EMLI. Metodu přidáváme pouze tehdy, když přinese potřebný typ důkazu.
            </p>
          </div>
          <a href="/sluzby/eye-tracking" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            PROJÍT EYE TRACKING →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ ČASTÉ DOTAZY ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
