          </p>
          <a href={`${base}/o-nas`} class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">KDO JSME →</a>
        </div>
      </section>

      <!-- FAQ -->
      <section class="reveal mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ ČASTÉ OTÁZKY ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">Na co se ptáte<span style="color:#2D62FC">.</span></h2>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
