      <section class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CO DOSTANETE ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Výsledek, ne hromadu heatmap<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
          {vystupy.map((v, i) => (
            <div class="bg-brand-white p-6 md:p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{v.d}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Postup -->
      <section class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ POSTUP ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Nejdřív otázka, potom přístroj<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
          {postup.map(s => (
            <div class="bg-brand-white p-6 md:p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">{s.num}</p>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{s.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{s.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Kdo za tím stojí -->
      <section class="reveal mb-24 grid grid-cols-1 md:grid-cols-[1.4fr_0.6fr] gap-10 lg:gap-16 items-center">
        <figure class="md:order-2">
          <img src={`${base}/images/jan-petruzalek-pred-univerzitou.webp`} alt="Ing. Jan Petružálek, Ph.D., přemýšlí před vstupem do budovy Univerzity Hradec Králové" title="Ing. Jan Petružálek, Ph.D., před univerzitou" width="860" height="1075" loading="lazy" decoding="async" class="w-full aspect-[4/5] object-cover border border-brand-black/10" />
        </figure>
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ KDO ZA TÍM STOJÍ ]</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold leading-tight mb-6">Z univerzitní výuky do praxe<span style="color:#2D62FC">.</span></h2>
          <p class="text-brand-black/60 leading-relaxed mb-4">
