        <figure class="lg:col-span-7">
          <img src={`${base}/images/pohled-divaka-sledovani-zapasu-eye-tracking.webp`} alt="Divák s mobilními eye-trackingovými brýlemi sleduje fotbalový zápas z tribuny" title="Měření pozornosti diváka během zápasu" width="1920" height="1280" loading="lazy" decoding="async" class="w-full aspect-[3/2] object-cover border border-brand-black/10" />
          <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Měření během zápasu FC Hradec Králové, listopad 2026.</figcaption>
        </figure>
        <div class="lg:col-span-5">
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SPONZORING ]</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold leading-tight mb-6">
            Pohled na logo není zapamatování<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-black/60 leading-relaxed mb-6">
