                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Zdroje (sbalené) -->
      <details class="reveal group border border-brand-black/10 px-6">
        <summary class="flex justify-between items-center gap-6 cursor-pointer py-4 font-mono text-xs tracking-widest uppercase list-none [&::-webkit-details-marker]:hidden">
          Z čeho vycházíme: odborné zdroje
          <span class="text-lg transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <ol class="space-y-2 pb-6">
          {zdroje.map(z => (
            <li class="text-sm text-brand-black/60 leading-relaxed">{z.c} <a href={`https://doi.org/${z.doi}`} class="underline hover:text-[#2D62FC]" rel="noopener" target="_blank">doi:{z.doi}</a></li>
          ))}
        </ol>
      </details>

    </div>
  </main>

  <ContactCta />
  <Footer />

  <style>
    .ukazka-tab[aria-selected='true'] { background: #0A0A0A; color: #fff; }
    .ukazka-tab[aria-selected='false']:hover { background: rgba(45, 98, 252, 0.08); }
  </style>

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));

    {
      const root = document.querySelector('[data-ukazka]');
      const dataEl = document.getElementById('ukazka-data');
      if (root && dataEl) {
        const data = JSON.parse(dataEl.textContent || '{}');
        const fmt = (n: number) => n.toLocaleString('cs-CZ', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
        const show = (key: string) => {
          const d = data[key];
          if (!d) return;
          root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach(b => b.setAttribute('aria-selected', String(b.dataset.tab === key)));
          root.querySelectorAll<HTMLElement>('[data-ikona]').forEach(el => el.classList.toggle('hidden', el.getAttribute('data-ikona') !== key));
          root.querySelectorAll<HTMLElement>('[data-metrika]').forEach(m => {
            const k = m.dataset.metrika as 'cas' | 'fix';
            const vals: number[] = d[k];
            const max = Math.max(...vals) * 1.1;
            const unit = m.dataset.unit ? ' ' + m.dataset.unit : '';
            vals.forEach((v, i) => {
              const bar = m.querySelector<HTMLElement>(`[data-bar="${i}"]`);
              const val = m.querySelector<HTMLElement>(`[data-val="${i}"]`);
              if (bar) bar.style.width = (v / max * 100).toFixed(1) + '%';
              if (val) val.textContent = fmt(v) + unit;
            });
            const sig = m.querySelector<HTMLElement>('[data-sig]');
            const isSig = d[k + 'Sig'];
            if (sig) {
              sig.textContent = isSig ? 'PRŮKAZNÝ ROZDÍL' : 'ROZDÍL NEPRŮKAZNÝ';
              sig.style.color = isSig ? '#2D62FC' : 'rgba(10,10,10,.5)';
            }
          });
          ['data', 'ne', 'dop'].forEach(t => {
            const el = root.querySelector<HTMLElement>(`[data-text="${t}"]`);
            if (el) el.textContent = d[t];
          });
        };
        root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach(b => b.addEventListener('click', () => show(b.dataset.tab || '')));
        show(Object.keys(data)[0]);
      }
    }
  </script>
</BaseLayout>
