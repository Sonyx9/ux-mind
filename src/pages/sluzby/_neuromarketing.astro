          <a href={`${base}/segmenty/sport-a-stadiony`} class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">SPORT A STADIONY →</a>
        </div>
