---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const faq = [
  { q: "Kolik respondentů je potřeba pro eye tracking studii?", a: "Pro kvalitativní vhledy stačí 8–12 respondentů na segment. Pro kvantitativní metriky (heatmapy, AOI statistiky) doporučujeme 30 a více a pro výpočet indexu kognitivní zátěže EMLI pracujeme se vzorky nad 100 respondentů." },
  { q: "Jak dlouho trvá eye tracking testování?", a: "Typický projekt trvá 1–3 týdny od schválení scénáře: příprava a pilotáž, sběr dat v laboratoři nebo v terénu, analýza a report s prioritizovanými doporučeními." },
  { q: "Je eye tracking totéž co neuromarketing?", a: "Není. Eye tracking je objektivní záznam vizuální pozornosti — neslibujeme „čtení myšlenek“ ani emocí. Data interpretujeme vždy v kontextu úkolu a s jasně popsanými limity metody." },
  { q: "Co ukáže heatmapa a co z ní nevyčtu?", a: "Heatmapa agreguje, kam se respondenti dívali nejčastěji. Neřekne ale, jak náročné pro ně rozhraní bylo — proto ji doplňujeme AOI metrikami (TTFF, dwell time) a indexem kognitivní zátěže EMLI." },
];

const steps = [
  { num: '01', title: 'Příprava', desc: 'Testovací scénáře podle vašich cílů a definice AOI (Areas of Interest).' },
  { num: '02', title: 'Testování', desc: 'Uživatelé interagují s produktem, eye tracker zaznamenává pohled.' },
  { num: '03', title: 'Analýza', desc: 'Heatmapy, gaze ploty a AOI statistiky z nasbíraných dat.' },
  { num: '04', title: 'Doporučení', desc: 'Konkrétní úpravy rozvržení a hierarchie obsahu.' },
];

const usecases = [
  { t: 'Webové stránky', d: 'Kde uživatelé tráví čas, co přehlíží a proč nereagují na vaše CTA.', tag: 'WEB' },
  { t: 'Mobilní aplikace', d: 'Navigace, čitelnost a použitelnost mobilních produktů.', tag: 'APP' },
  { t: 'E-commerce', d: 'Produktové stránky, košík a checkout pro lepší konverze.', tag: 'E-SHOP' },
  { t: 'Tiskové materiály', d: 'Bannery, plakáty, obaly — co přitahuje pozornost na fyzických materiálech.', tag: 'PRINT' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: "Eye tracking a uživatelské testování",
    description: "Měření vizuální pozornosti pomocí eye trackingu: heatmapy, AOI analýza, záznamy pohledu a uživatelské testování webů, aplikací a tiskovin.",
    serviceType: 'Eye tracking',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Eye tracking a heatmapy pozornosti"
  description="Eye tracking webů, aplikací i tiskovin: heatmapy, AOI analýza, záznamy pohledu a uživatelské testování v laboratoři FIM UHK. Zjistěte, co uživatelé skutečně vidí."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SLUŽBY / EYE TRACKING ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          VIDÍME<br/>CO VY NE<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Objektivní záznam vizuální pozornosti.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              Eye tracking odhaluje přesná data o tom, jak uživatelé vnímají váš obsah.
              Víme, <strong class="text-brand-black">kam se dívají, co přehlíží a co je zaujme</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="/kontakt" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              DOMLUVIT TESTOVÁNÍ →
            </a>
            <a href="/sluzby/testovaci-balicky" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              TESTOVACÍ BALÍČKY
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DÉLKA', '1–3 týdny'],
          ['TECHNOLOGIE', 'Tobii Pro · Smart Eye'],
          ['VÝSTUPY', 'Heatmapy · AOI · gaze ploty'],
          ['BALÍČEK', 'Standardní UX test'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Foto z měření -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
          alt="Respondentka během eye-tracking měření v laboratoři — sleduje testovaný stimul na monitoru s eye-trackerem"
          title="Průběh eye-tracking měření v laboratoři"
          width="1080" height="1920" loading="lazy" decoding="async"
          class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Sběr dat vizuální pozornosti v laboratoři — záznam pohledu se ukládá pro AOI analýzu a heatmapy.</p>
      </div>

      <!-- Kde pomůžeme -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ KDE POMŮŽEME ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Obrazovka, papír i regál<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
          {usecases.map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-xl font-bold mb-3 leading-tight">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-sm text-brand-black/60 leading-relaxed mt-4">
          Mimo laboratoř měříme s mobilními brýlemi — viz <a href="/sluzby/terenni-mereni" class="underline hover:no-underline">terénní měření</a>.
        </p>
      </div>

      <!-- Jak to funguje + EMLI -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ JAK TO FUNGUJE ]</p>
          <div class="space-y-0">
            {steps.map(step => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="border border-brand-black/10 p-8 flex flex-col justify-between">
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ NAVÍC: INDEX EMLI ]</p>
            <h3 class="font-display text-2xl font-bold mb-3">Pohled + zátěž v jednom skóre<span style="color:#2D62FC">.</span></h3>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Z eye-trackingových metrik skládáme index mentální zátěže EMLI (0–100).
              Porovnáte, které varianty nebo kroky uživatele stojí nejvíc úsilí.
            </p>
          </div>
          <p class="font-display font-bold leading-none mt-6" style="font-size: clamp(2.5rem, 5vw, 4rem); color:#2D62FC;">0–100</p>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ ČASTÉ DOTAZY ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
