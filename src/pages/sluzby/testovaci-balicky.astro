---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const packages = [
  {
    num: '01',
    id: 'rychla-diagnostika',
    title: 'Rychlá diagnostika',
    tagline: 'Tušíte, že něco nefunguje — potřebujete rychle zúžit problém.',
    chips: ['Heuristická analýza', 'Eye-tracking', 'Dotazník'],
    findings: 'Kde lidé ztrácejí orientaci, co přehlížejí a co stojí za hlubší testování.',
    forWho: 'Pro týmy, které tuší, že web, aplikace, formulář nebo kampaň nefunguje ideálně, ale potřebují nejprve rychle zúžit problém. Hodí se před větším redesignem, při přípravě zadání pro agenturu nebo jako první ověření klíčových obrazovek.',
    inside: 'Expertní heuristická analýza, eye-tracking na vybraných obrazovkách a krátké dotazníkové šetření.',
    limits: 'Rychlá diagnostika slouží k identifikaci pravděpodobných problémů. Sama o sobě neprokazuje dopad na konverzi a nemusí vysvětlit všechny příčiny chování.',
    output: 'Stručný report s hlavními zjištěními, ukázkami vizualizací a prioritizovaným seznamem doporučení.',
  },
  {
    num: '02',
    id: 'standardni-ux-test',
    title: 'Standardní UX test',
    tagline: 'Ověřujete uživatelskou cestu nebo porovnáváte dvě varianty.',
    chips: ['Eye-tracking', 'Behaviorální data', 'Dotazníky', 'Scénář'],
    findings: 'Která varianta funguje lépe, kde vznikají chyby a zda se pozornost promítá do splnění úkolu.',
    forWho: 'Pro situace, kdy potřebujete ověřit konkrétní uživatelskou cestu, porovnat dvě varianty rozhraní nebo doložit, že redesign opravdu pomáhá. Hodí se pro weby, aplikace, e-shopy, formuláře, kampaně i prototypy.',
    inside: 'Eye-tracking, behaviorální data, standardizované nebo vlastní dotazníky a řízený testovací scénář. U variant pracujeme s experimentálním designem, aby bylo srovnání co nejčistší.',
    limits: 'Standardní UX test dobře popisuje pozornost, orientaci a výkon v úkolu. Nezachycuje ale fyziologickou odezvu a neposkytuje hlubší obraz o míře arousalu nebo mentálního úsilí.',
    output: 'Výzkumný protokol, AOI metriky, heatmapy, gaze ploty, výsledky úkolů, dotazníkové vyhodnocení a doporučení pro další návrhové rozhodnutí.',
  },
  {
    num: '03',
    id: 'komplexni-biometricky-vyzkum',
    title: 'Komplexní biometrický výzkum',
    tagline: 'Drahé nebo těžko vratné rozhodnutí, které musí obstát před vedením.',
    chips: ['Vše ze 02', 'GSR', 'Mimické signály', 'EMLI', 'Workshop'],
    findings: 'Nejen co lidé viděli a udělali, ale i kde roste arousal a které kroky působí náročněji.',
    forWho: 'Pro rozhodnutí, která jsou drahá, obtížně vratná nebo musí obstát před vedením, investorem či klientem. Hodí se pro významné redesigny, klíčové kampaně, produktové inovace, HMI, retailové situace nebo výzkumy, kde samotné chování nestačí.',
    inside: 'Vše ze Standardního UX testu, doplněné podle zadání o GSR, analýzu mimických signálů, kvalitativní elicitaci, retrospektivní rozhovor nad záznamem pohledu a volitelně také měření mentální zátěže pomocí modelu EMLI.',
    limits: 'Biometrická data neinterpretujeme izolovaně. GSR neříká, zda je reakce pozitivní nebo negativní, a mimické signály nejsou samostatným „čtením emocí“. Smysl dávají až ve spojení s úkolem, scénářem, eye-trackingem a výpovědí respondenta.',
    output: 'Rozšířený výzkumný report, multimodální časová osa zjištění, interpretace kritických momentů, limity studie, redesign doporučení a workshop nad výsledky.',
    featured: true,
  },
  {
    num: '04',
    id: 'terenni-studie',
    title: 'Terénní studie',
    tagline: 'Rozhodování se neodehrává na obrazovce, ale v prodejně či prostoru.',
    chips: ['ET brýle NEON', 'Videozáznam', 'GSR', 'Rozhovory'],
    findings: 'Jak lidé procházejí reálným prostředím, čeho si všímají, co míjejí a kde se zastavují.',
    forWho: 'Pro situace, kdy se rozhodování neodehrává jen na obrazovce. Typicky v prodejně, showroomu, u fyzického produktu, na eventu, v pracovním prostředí nebo v automotive/HMI kontextu.',
    inside: 'Mobilní eye-tracking brýle Pupil Labs NEON, videozáznam situace, podle potřeby GSR, dotazníky, rozhovory a analýza chování v reálném prostředí.',
    limits: 'Terénní výzkum nabízí vyšší přirozenost situace, ale menší kontrolu podmínek než laboratoř. Proto vždy dopředu určujeme, které závěry lze z terénního měření vyvozovat bezpečně a které je vhodné ověřit ještě kontrolovaněji.',
    output: 'Videoanalýza, mapování klíčových momentů, vizualizace pozornosti v prostředí, shrnutí bariér a doporučení pro úpravu prostoru, komunikace nebo zákaznické cesty.',
  },
];

const chooseTable = [
  { need: 'Nevíte, kde je problém', pkg: 'Rychlá diagnostika', href: '#rychla-diagnostika' },
  { need: 'Porovnáváte dvě varianty webu, aplikace nebo kampaně', pkg: 'Standardní UX test', href: '#standardni-ux-test' },
  { need: 'Potřebujete obhájit významné rozhodnutí daty', pkg: 'Komplexní biometrický výzkum', href: '#komplexni-biometricky-vyzkum' },
  { need: 'Testujete chování v prodejně, showroomu nebo eventu', pkg: 'Terénní studie', href: '#terenni-studie' },
  { need: 'Máte specifické zadání nebo kombinaci prostředí', pkg: 'Balíček na míru', href: '#na-miru' },
];

const methods = [
  { m: 'Eye-tracking na obrazovce', tool: 'Tobii Pro X2-60, Smart Eye Aurora', brings: 'Zjišťuje, co lidé skutečně vidí, co přehlížejí, v jakém pořadí a jak dlouho' },
  { m: 'Mobilní eye-tracking', tool: 'Pupil Labs NEON', brings: 'Zachycuje pozornost v reálném prostředí a propojuje ji s videozáznamem situace' },
  { m: 'GSR', tool: 'Shimmer3 GSR', brings: 'Ukazuje momenty růstu fyziologického arousalu během úkolu' },
  { m: 'Analýza mimických signálů', tool: 'iMotions / Facial Expression Analysis', brings: 'Pomáhá sledovat změny mimické odezvy v čase vůči konkrétnímu stimulu' },
  { m: 'Dotazníková šetření', tool: 'VisAWI, NASA-TLX, SUS, UEQ nebo vlastní položky', brings: 'Doplňují objektivní měření o vědomé hodnocení srozumitelnosti, estetiky, důvěryhodnosti nebo zátěže' },
  { m: 'Kvalitativní elicitace', tool: 'Think-aloud, retrospektivní think-aloud, rozhovor', brings: 'Vysvětluje, proč se uživatel v určitém momentu rozhodl nebo zastavil' },
  { m: 'Behaviorální data', tool: 'Úspěšnost úkolu, čas, chybovost, kliky', brings: 'Ověřují, zda se pozornost promítla do skutečného výsledku' },
  { m: 'Expertní heuristická analýza', tool: 'Hodnocení rozhraní specialistou', brings: 'Rychle odhaluje známé problémy použitelnosti před hlubším měřením' },
  { m: 'Experimentální design', tool: 'Scénáře, pilotáž, randomizace, srovnatelnost variant', brings: 'Zajišťuje, aby výsledky nebyly jen dojmem z jedné situace' },
];

const outputs = [
  'Výzkumný protokol se zadáním a limity',
  'Metriky vizuální pozornosti',
  'Úspěšnost úkolu, čas, chybovost',
  'Heatmapy, gaze ploty, AOI srovnání',
  'Dotazníky vs. objektivní data',
  'Kvalitativní zjištění',
  'Interpretace dopadu na UX i produkt',
  'Doporučení podle dopadu a náročnosti',
  'Jasně popsané limity studie',
  'Závěrečný workshop s týmem',
];

const process = [
  { num: '01', title: 'Zadání', desc: 'Ujasníme si, jaké rozhodnutí potřebujete udělat.' },
  { num: '02', title: 'Návrh balíčku', desc: 'Metody, vzorek, scénář a co půjde bezpečně vyvodit.' },
  { num: '03', title: 'Příprava a pilotáž', desc: 'Scénář, stimuly, dotazníky, u složitějších projektů pilot.' },
  { num: '04', title: 'Měření', desc: 'Laboratoř nebo terén, kalibrace a kontrola kvality dat.' },
  { num: '05', title: 'Analýza a výstup', desc: 'Doporučení, ne izolované grafy.' },
];

const audiences = [
  { title: 'Produkt & UX', desc: 'Cesty, formuláře, navigace, prototypy.' },
  { title: 'Marketing', desc: 'Kampaně, bannery, video, landing pages.' },
  { title: 'E-commerce', desc: 'Listing, detail, filtry, košík, checkout.' },
  { title: 'Retail & služby', desc: 'Orientace v prostoru, POS, product placement.' },
  { title: 'Vedení', desc: 'Data pro dražší rozhodnutí, srozumitelná i mimo UX tým.' },
];

const faq = [
  { q: 'Musíme si vybrat celý balíček?', a: 'Ne. Balíčky jsou výchozí konfigurace, ne pevně uzavřené produkty. Podle zadání můžeme metody doplnit, zjednodušit nebo zkombinovat.' },
  { q: 'Jaký je rozdíl proti heatmapě z webové analytiky?', a: 'Analytická heatmapa obvykle pracuje s kliky, pohybem kurzoru nebo scrollováním. Eye-tracking měří skutečný pohled. Díky tomu zachytí i prvky, na které se uživatel díval, ale neklikl na ně.' },
  { q: 'Měříte emoce?', a: 'Nepoužíváme zkratku „měříme emoce“ ve smyslu spolehlivého čtení vnitřního stavu člověka. Pracujeme s indikátory fyziologického arousalu, mimickými signály a subjektivním hodnocením. Interpretujeme je vždy v kontextu konkrétního úkolu.' },
  { q: 'Kolik respondentů potřebujeme?', a: 'Záleží na cíli studie. Pro rychlou diagnostiku stačí menší vzorek a kvalitativnější interpretace. Pro srovnání variant a statistické vyhodnocení je potřeba větší a přesněji navržený soubor. Doporučený rozsah navrhujeme až podle výzkumné otázky.' },
  { q: 'Kolik testování stojí?', a: 'Cenu stanovujeme podle rozsahu balíčku, počtu respondentů, náročnosti přípravy, typu měření a formy výstupu. Pošlete nám zadání a připravíme nezávaznou nabídku.' },
  { q: 'Musí testování probíhat v laboratoři?', a: 'Ne. Laboratoř je vhodná pro kontrolované studie webů, aplikací, kampaní nebo prototypů. Pro reálné prostředí používáme mobilní eye-tracking brýle a terénní metodiku.' },
  { q: 'Jak nakládáte s daty respondentů?', a: 'Před měřením pracujeme s informovaným souhlasem a jasně vymezeným účelem výzkumu. Výstupy pro klienty připravujeme standardně v agregované nebo pseudonymizované podobě. Konkrétní režim nakládání s daty nastavujeme podle typu projektu, citlivosti dat a požadavků zadavatele.' },
  { q: 'Dostaneme jen report?', a: 'Ne. U většiny projektů doporučujeme závěrečný workshop. Díky němu lze výsledky převést do priorit, backlogu úprav nebo dalšího testování.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Testovací balíčky UXMIND',
    description: 'Testovací balíčky UX výzkumu: rychlá diagnostika, standardní UX test, komplexní biometrický výzkum a terénní studie. Eye-tracking, GSR, dotazníky a expertní analýza podle rozhodnutí, které potřebujete udělat.',
    serviceType: 'UX testování',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Testovací balíčky UXMIND | Eye-tracking, biometrie a UX výzkum"
  description="Vyberte rozsah UX testování podle rozhodnutí, které potřebujete udělat. Rychlá diagnostika, standardní UX test, komplexní biometrický výzkum i terénní studie."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-12">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ TESTOVACÍ BALÍČKY ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          JAK HLUBOKO<br/>MĚŘIT<span style="color:#2D62FC">?</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Od rychlé diagnostiky po komplexní biometrický UX výzkum.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              Heatmapa ukáže, kam se lidé dívali — ne proč se ztratili. Balíčky skládáme podle
              <strong class="text-brand-black">rozhodnutí, které potřebujete udělat</strong>, ne podle toho, co máme v laboratoři.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="/kontakt" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              POPTAT NABÍDKU →
            </a>
            <a href="#vyber" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              KTERÝ SE MI HODÍ?
            </a>
          </div>
        </div>
      </div>

      <!-- Škála rozsahu: rychlá volba -->
      <div class="mb-16">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
          {packages.map(pkg => (
            <a href={`#${pkg.id}`} class="group bg-brand-white p-5 hover:bg-brand-black hover:text-brand-white transition-colors">
              <div class="flex justify-between items-start mb-4">
                <span class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/60">{pkg.num}</span>
                <span class="font-mono text-xs opacity-0 group-hover:opacity-100 transition-opacity">↓</span>
              </div>
              <p class="font-display font-bold leading-tight">{pkg.title}</p>
            </a>
          ))}
        </div>
        <!-- Osa rozsahu -->
        <div class="flex items-center gap-3 mt-3 font-mono text-[10px] text-brand-black/60 tracking-widest uppercase">
          <span>Menší rozsah</span>
          <span class="flex-1 h-px bg-gradient-to-r from-brand-black/20 to-brand-black"></span>
          <span>Hlubší evidence</span>
        </div>
      </div>

      <!-- Důvěryhodnostní pás -->
      <div class="reveal mb-24 border-y border-brand-black/10 py-4 overflow-hidden">
        <p class="font-mono text-[11px] text-brand-black/60 tracking-wider whitespace-nowrap md:whitespace-normal overflow-x-auto">
          Výzkumné zázemí FIM UHK · Tobii Pro X2-60 · Smart Eye Aurora · Pupil Labs NEON · iMotions CORE · BeSigma · Shimmer3 GSR · laboratorní i terénní měření
        </p>
      </div>

      <!-- Proč samotný eye-tracking nestačí — tři vrstvy -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ PROČ SAMOTNÝ EYE-TRACKING NESTAČÍ ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Pozornost ≠ pochopení ≠ konverze<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {[
            { t: 'Co viděl', d: 'Eye-tracking ukáže, co uživatel skutečně vidí a co míjí.', tag: 'POHLED' },
            { t: 'Co udělal', d: 'Splnil úkol? Jak dlouho mu trval a kde chyboval?', tag: 'CHOVÁNÍ' },
            { t: 'Proč', d: 'Jak rozhraní hodnotil a co dokázal zpětně vysvětlit.', tag: 'VÝPOVĚĎ' },
          ].map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-sm text-brand-black/60 leading-relaxed mt-4 max-w-2xl">
          Teprve spojení všech tří vrstev odliší problém, který jen přitahuje pohled, od problému, který brání dokončení úkolu.
        </p>
      </div>

      <!-- Balíčky -->
      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ NAŠE TESTOVACÍ BALÍČKY ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-4">Čtyři konfigurace<span style="color:#2D62FC">.</span></h2>
        <p class="text-brand-black/60 leading-relaxed max-w-2xl mb-12">
          Nejsou to pevné produkty — upravujeme je podle zadání. U každého předem víte, co získáte i co z daného rozsahu <strong class="text-brand-black">nepůjde spolehlivě tvrdit</strong>.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          {packages.map(pkg => (
            <div id={pkg.id} class={`reveal p-8 md:p-10 flex flex-col scroll-mt-28 ${pkg.featured ? 'bg-brand-black text-brand-white' : 'bg-brand-white'}`}>
              <div class="flex justify-between items-start mb-6">
                <span class={`font-mono text-xs ${pkg.featured ? 'text-brand-white/60' : 'text-brand-black/60'}`}>{pkg.num}</span>
                {pkg.featured && (
                  <span class="font-mono text-[10px] tracking-widest px-2 py-1" style="background:#2D62FC; color:#FCFCFC;">NEJHLUBŠÍ EVIDENCE</span>
                )}
              </div>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-3 leading-tight">{pkg.title}</h3>
              <p class={`leading-relaxed mb-6 ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>{pkg.tagline}</p>

              <div class="flex flex-wrap gap-2 mb-6">
                {pkg.chips.map(chip => (
                  <span class={`font-mono text-[11px] px-2 py-1 tracking-wide border ${pkg.featured ? 'border-brand-white/30 text-brand-white/80' : 'border-brand-black/20 text-brand-black/70'}`}>{chip}</span>
                ))}
              </div>

              <p class={`text-sm leading-relaxed mb-6 ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>
                <span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Zjistíte</span>
                {pkg.findings}
              </p>

              <details class={`group mt-auto border-t pt-4 ${pkg.featured ? 'border-brand-white/20' : 'border-brand-black/10'}`}>
                <summary class="flex justify-between items-center cursor-pointer font-mono text-xs tracking-widest uppercase list-none [&::-webkit-details-marker]:hidden">
                  DETAIL BALÍČKU
                  <span class="font-mono text-lg transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <div class={`mt-4 space-y-4 text-sm leading-relaxed ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Pro koho</span>{pkg.forWho}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Co je uvnitř</span>{pkg.inside}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Hranice balíčku</span>{pkg.limits}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Typický výstup</span>{pkg.output}</p>
                </div>
              </details>
            </div>
          ))}
        </div>

        <!-- Balíček na míru -->
        <div id="na-miru" class="reveal relative overflow-hidden bg-brand-black text-brand-white p-8 md:p-12 mt-px scroll-mt-28">
          <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
          <div class="relative flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div>
              <p class="font-mono text-xs text-brand-white/60 mb-2">05</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-3">Balíček na míru<span style="color:#2D62FC">.</span></h3>
              <p class="text-brand-white/70 leading-relaxed max-w-xl">
                Nejdřív poznáme váš byznys, cíle a kontext — pak vám na míru navrhneme testování i navazující optimalizaci. Od výzkumné otázky přes vhodnou kombinaci metod až po konkrétní úpravy, které se propíšou do výsledků. Skládáme podle rozhodnutí, které se z dat bude dělat, ne podle vybavení laboratoře.
              </p>
            </div>
            <a href="/kontakt" class="shrink-0 inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              NEVÍM, KTERÝ ZVOLIT →
            </a>
          </div>
        </div>
      </div>

      <!-- Jak vybrat -->
      <div id="vyber" class="reveal mb-24 scroll-mt-28">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ JAK VYBRAT SPRÁVNÝ BALÍČEK ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10">Co potřebujete rozhodnout<span style="color:#2D62FC">?</span></h2>
        <div class="border border-brand-black/10">
          {chooseTable.map(row => (
            <a href={row.href} class="group grid grid-cols-1 md:grid-cols-2 gap-2 md:gap-6 p-5 border-b border-brand-black/10 last:border-0 hover:bg-brand-black hover:text-brand-white transition-colors">
              <p class="text-brand-black/60 group-hover:text-brand-white/70 leading-relaxed transition-colors">{row.need}</p>
              <p class="font-display font-bold flex items-center justify-between gap-4">
                {row.pkg}
                <span class="font-mono text-xs opacity-0 group-hover:opacity-100 transition-opacity">→</span>
              </p>
            </a>
          ))}
        </div>
      </div>

      <!-- Co je uvnitř balíčků (rozbalovací) -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ CO JE UVNITŘ BALÍČKŮ ]</p>
        <details class="group border border-brand-black/10">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-6 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
            9 metod a nástrojů, se kterými pracujeme
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <div class="border-t border-brand-black/10">
            {methods.map(row => (
              <div class="grid grid-cols-1 md:grid-cols-3 gap-2 md:gap-6 p-5 border-b border-brand-black/10 last:border-0">
                <p class="font-display font-bold">{row.m}</p>
                <p class="font-mono text-xs text-brand-black/60 leading-relaxed pt-1">{row.tool}</p>
                <p class="text-sm text-brand-black/60 leading-relaxed">{row.brings}</p>
              </div>
            ))}
          </div>
        </details>
        <p class="text-sm text-brand-black/60 leading-relaxed mt-4 max-w-2xl">
          Víc o technologiích: <a href="/sluzby/eye-tracking" class="underline hover:no-underline">Eye tracking</a> · <a href="/sluzby/ux-vyzkum" class="underline hover:no-underline">UX výzkum</a>
        </p>
      </div>

      <!-- EMLI -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ DOPLŇKOVĚ: INDEX MENTÁLNÍ ZÁTĚŽE EMLI ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">Mentální zátěž jako jedno skóre<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Vlastní model z výzkumu na FIM UHK skládá eye-trackingové metriky do jednoho indexu zátěže.
              Porovná, které kroky, obrazovky nebo varianty vyžadují víc úsilí. Průběžně ho ověřujeme —
              používáme ho jako doplňkovou interpretační vrstvu, ne jako samostatný důkaz.
            </p>
          </div>
          <p class="font-display font-bold leading-none shrink-0" style="font-size: clamp(3rem, 6vw, 5rem); color:#2D62FC;">0–100</p>
        </div>
      </div>

      <!-- Výstup + proces -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ CO DOSTANETE VE VÝSTUPU ]</p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2">
            {outputs.map(o => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {o}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ JAK SPOLUPRÁCE PROBÍHÁ ]</p>
          <div class="space-y-0">
            {process.map((step, i) => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Pro koho -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ PRO KOHO JSOU BALÍČKY VHODNÉ ]</p>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-px bg-brand-black/10 border border-brand-black/10">
          {audiences.map(a => (
            <div class="bg-brand-white p-6">
              <h3 class="font-display text-lg font-bold mb-2 leading-tight">{a.title}</h3>
              <p class="text-xs text-brand-black/60 leading-relaxed">{a.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ ČASTÉ DOTAZY ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- Závěrečná CTA -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            POŠLETE NÁM<br/>ZADÁNÍ<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            Web, aplikace, kampaň nebo prototyp. Navrhneme balíček odpovídající vašemu rozhodnutí —
            bez složité metodiky a bez slibů, které z dat nejde bezpečně vyvodit.
          </p>
          <div class="flex flex-wrap gap-4 justify-center">
            <a href="/kontakt" class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
              POSLAT ZADÁNÍ →
            </a>
            <a href="/kontakt" class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              ÚVODNÍ KONZULTACE
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    // Scroll-reveal — stejný pattern jako na případových studiích
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
