---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const packages = [
  {
    num: '01',
    id: 'rychla-diagnostika',
    title: 'Rychlý UX audit',
    tagline: 'Rychlá odborná kontrola, která odhalí hlavní problémy webu nebo aplikace.',
    chips: ['Expertní UX audit', 'Klíčové obrazovky', 'Priority úprav'],
    findings: 'Kde může rozhraní uživatele mást, co komplikuje dokončení úkolu a které nedostatky má smysl řešit jako první.',
    forWho: 'Pro týmy, které potřebují rychle prověřit web, e-shop, aplikaci nebo formulář. Hodí se před redesignem, při poklesu konverzí nebo jako podklad pro další úpravy.',
    inside: 'Expertní kontrola klíčových stránek a uživatelských cest. Posoudíme jejich srozumitelnost, navigaci, obsah, vizuální hierarchii a překážky při dokončení úkolu.',
    limits: 'Audit nepracuje s měřením skutečných uživatelů. Odhalí pravděpodobné problémy a určí priority, které lze následně ověřit uživatelským testováním.',
    output: 'Přehled hlavních problémů, konkrétní příklady a doporučené úpravy seřazené podle důležitosti.',
  },
  {
    num: '02',
    id: 'standardni-ux-test',
    title: 'Uživatelské testování',
    tagline: 'Sledujeme, jak skuteční uživatelé procházejí rozhraním a kde se při plnění úkolů zastavují.',
    chips: ['Testování s uživateli', 'Úkolové scénáře', 'Rozhovory', 'Dotazníky'],
    findings: 'Zda uživatelé zvládnou důležité úkoly, kde chybují, čemu nerozumějí a která varianta se používá snadněji.',
    forWho: 'Pro týmy, které potřebují ověřit konkrétní uživatelskou cestu, nový návrh nebo prototyp se skutečnými uživateli. Hodí se pro weby, aplikace, e-shopy i formuláře.',
    inside: 'Řízené testování s uživateli podle připravených úkolů. Sledujeme úspěšnost, čas, chyby a způsob práce s rozhraním. Chování doplňujeme rozhovorem a podle potřeby dotazníkem.',
    limits: 'Test ukáže, co uživatelé udělali a jak své chování vysvětlují. Neměří přesný pohyb očí ani fyziologickou reakci — pro tyto otázky slouží prémiové laboratorní měření.',
    output: 'Výsledky jednotlivých úkolů, hlavní bariéry, ukázky chování uživatelů a doporučení seřazená podle dopadu.',
  },
  {
    num: '03',
    id: 'komplexni-biometricky-vyzkum',
    title: 'Eye tracking a biometrie',
    tagline: 'Prémiové laboratorní měření pro důležitá rozhodnutí, která potřebujete podložit více zdroji dat.',
    chips: ['Vše ze 02', 'GSR', 'Mimické signály', 'EMLI', 'Workshop'],
    findings: 'Co uživatelé skutečně viděli, jak postupovali a ve kterých okamžicích rostla jejich fyziologická nebo mentální zátěž.',
    forWho: 'Pro rozhodnutí, která jsou drahá, obtížně vratná nebo musí obstát před vedením, investorem či klientem. Hodí se pro významné redesigny, klíčové kampaně, produktové inovace, HMI, retailové situace nebo výzkumy, kde samotné chování nestačí.',
    inside: 'Uživatelské testování doplníme o eye tracking a podle zadání také o GSR, analýzu mimických signálů, zpětný rozhovor nad záznamem pohledu nebo měření mentální zátěže pomocí modelu EMLI.',
    limits: 'Biometrická data neinterpretujeme izolovaně. GSR neříká, zda je reakce pozitivní nebo negativní, a mimické signály nejsou samostatným „čtením emocí“. Smysl dávají až ve spojení s úkolem, scénářem, eye-trackingem a výpovědí respondenta.',
    output: 'Rozšířený výzkumný report, propojení jednotlivých zdrojů dat, vysvětlení kritických momentů, doporučení pro úpravy a workshop nad výsledky.',
    featured: true,
  },
  {
    num: '04',
    id: 'terenni-studie',
    title: 'Terénní studie',
    tagline: 'Sledujeme chování tam, kde skutečně probíhá — v prodejně, provozu nebo jiném fyzickém prostoru.',
    chips: ['Pozorování v terénu', 'Videozáznam', 'Rozhovory', 'Mobilní eye tracking'],
    findings: 'Jak lidé procházejí reálným prostředím, čeho si všímají, co míjejí a kde se zastavují.',
    forWho: 'Pro situace, kdy se rozhodování neodehrává jen na obrazovce. Typicky v prodejně, showroomu, u fyzického produktu, na eventu, v pracovním prostředí nebo v automotive/HMI kontextu.',
    inside: 'Pozorování a videozáznam situace, rozhovory a analýza chování v reálném prostředí. Podle výzkumné otázky můžeme zapojit také mobilní eye-tracking brýle Pupil Labs NEON nebo GSR.',
    limits: 'Terénní výzkum nabízí vyšší přirozenost situace, ale menší kontrolu podmínek než laboratoř. Proto vždy dopředu určujeme, které závěry lze z terénního měření vyvozovat bezpečně a které je vhodné ověřit ještě kontrolovaněji.',
    output: 'Videoanalýza, mapování klíčových momentů, vizualizace pozornosti v prostředí, shrnutí bariér a doporučení pro úpravu prostoru, komunikace nebo zákaznické cesty.',
  },
];

const outputs = [
  {
    title: 'Hlavní zjištění',
    desc: 'Přehled problémů, výsledky úkolů a vizualizace odpovídající zvolenému balíčku.',
  },
  {
    title: 'Vysvětlení souvislostí',
    desc: 'Ukážeme, co se stalo, proč je to důležité a co lze z výsledků bezpečně vyvodit.',
  },
  {
    title: 'Priority a další kroky',
    desc: 'Doporučené úpravy seřazené podle dopadu a náročnosti. U rozsáhlejších studií také společný workshop nad výsledky.',
  },
];

const process = [
  { num: '01', title: 'Cíl', desc: 'Ujasníme si, co potřebujete zjistit a jaké rozhodnutí má výzkum podpořit.' },
  { num: '02', title: 'Návrh', desc: 'Doporučíme vhodný balíček, metody, rozsah a účastníky.' },
  { num: '03', title: 'Příprava', desc: 'Připravíme scénář, podklady a podle potřeby pilotní ověření.' },
  { num: '04', title: 'Realizace', desc: 'Provedeme audit, uživatelské testování nebo měření v laboratoři či terénu.' },
  { num: '05', title: 'Výsledky', desc: 'Data vyhodnotíme a převedeme do konkrétních doporučení.' },
];

const audiences = [
  'Produkt & UX',
  'Marketing',
  'E-commerce',
  'Retail & služby',
  'Vedení',
];

const faq = [
  {
    q: 'Jaký je rozdíl mezi UX auditem a uživatelským testováním?',
    a: 'UX audit provádí specialista bez účasti respondentů a rychle odhalí pravděpodobné problémy rozhraní. Při uživatelském testování sledujeme skutečné uživatele při plnění konkrétních úkolů. Díky tomu ověříme, kde se opravdu zastavují, chybují nebo něčemu nerozumějí.',
  },
  {
    q: 'Jaký je rozdíl mezi uživatelským testováním a eye trackingem?',
    a: 'Uživatelské testování ukáže, zda lidé zvládnou důležité úkoly a jak s rozhraním pracují. Eye tracking navíc přesně měří jejich pohled — co viděli, co přehlédli a v jakém pořadí prvky sledovali. Proto ho používáme jako prémiovou metodu pro otázky, na které samotné pozorování nestačí.',
  },
  {
    q: 'Jak se eye tracking liší od heatmapy z webové analytiky?',
    a: 'Heatmapa z webové analytiky obvykle vychází z kliknutí, pohybu kurzoru nebo posouvání stránky. Eye tracking měří skutečný pohled uživatele. Zachytí proto i prvky, kterých si člověk všiml, ale neklikl na ně — nebo místa, která zcela přehlédl.',
  },
  {
    q: 'Kolik respondentů je pro uživatelské testování potřeba?',
    a: 'Počet závisí na cíli výzkumu, rozmanitosti cílové skupiny a způsobu vyhodnocení. Pro odhalování problémů často pracujeme s menším vzorkem. Pro spolehlivé porovnání variant nebo statistické závěry je potřeba větší soubor. Konkrétní počet doporučíme podle výzkumné otázky.',
  },
  {
    q: 'Kolik stojí UX audit nebo uživatelské testování?',
    a: 'Cena závisí na rozsahu, počtu testovaných cest nebo variant, počtu respondentů, použitých metodách a podobě výstupu. Po krátkém zadání doporučíme vhodný rozsah a připravíme nezávaznou nabídku.',
  },
  {
    q: 'Musí testování probíhat v laboratoři?',
    a: 'Nemusí. Web, aplikaci nebo prototyp můžeme testovat v laboratoři i vzdáleně podle cíle projektu. Chování v prodejně, provozu nebo jiném fyzickém prostoru sledujeme přímo v terénu.',
  },
  {
    q: 'Jak chráníte data respondentů?',
    a: 'Před testováním vymezíme účel zpracování a získáme informovaný souhlas každého účastníka. Data zabezpečujeme a výstupy standardně připravujeme v agregované nebo pseudonymizované podobě. Konkrétní režim nastavíme podle citlivosti projektu, požadavků klienta a GDPR.',
  },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Testovací balíčky UX MIND',
    description: 'Testovací balíčky UX výzkumu: rychlý UX audit, uživatelské testování, prémiový eye tracking s biometrií a terénní studie.',
    serviceType: 'UX testování',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Testovací balíčky UX MIND | Eye tracking, biometrie a UX výzkum"
  description="Vyberte rozsah UX testování podle toho, co potřebujete zjistit. Rychlý UX audit, uživatelské testování, eye tracking s biometrií i terénní studie."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-12">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ TESTOVACÍ BALÍČKY ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          VYBERTE ROZSAH<br/>TESTOVÁNÍ<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Podle toho, co potřebujete zjistit.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl text-justify">
              Někdy stačí rychle odhalit hlavní překážky. Jindy potřebujete porovnat varianty nebo podložit důležité rozhodnutí více zdroji dat. Doporučíme rozsah, který odpovídá vašemu cíli, prostředí i požadované míře jistoty.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="#balicky" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              PROJÍT BALÍČKY ↓
            </a>
            <a href="/kontakt" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              PORADIT S VÝBĚREM →
            </a>
          </div>
        </div>
      </div>

      <!-- Škála rozsahu: rychlá volba -->
      <div class="mb-16">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
          {packages.map(pkg => (
            <a href={`#${pkg.id}`} class="group bg-brand-white p-5 hover:bg-brand-black hover:text-brand-white transition-colors">
              <div class="flex justify-between items-start mb-4">
                <span class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/60">{pkg.num}</span>
                <span class="font-mono text-xs opacity-0 group-hover:opacity-100 transition-opacity">↓</span>
              </div>
              <p class="font-display font-bold leading-tight">{pkg.title}</p>
            </a>
          ))}
        </div>
        <!-- Osa rozsahu -->
        <div class="flex items-center gap-3 mt-3 font-mono text-[10px] text-brand-black/60 tracking-widest uppercase">
          <span>Menší rozsah</span>
          <span class="flex-1 h-px bg-gradient-to-r from-brand-black/20 to-brand-black"></span>
          <span>Podrobnější výzkum</span>
        </div>
      </div>

      <!-- Důvěryhodnostní pás -->
      <div class="reveal mb-24 border-y border-brand-black/10 py-4 overflow-hidden">
        <p class="font-mono text-[11px] text-brand-black/60 tracking-wider whitespace-nowrap md:whitespace-normal overflow-x-auto">
          Výzkumné zázemí FIM UHK · Tobii Pro X2-60 · Smart Eye Aurora · Pupil Labs NEON · iMotions CORE · BeSigma · Shimmer3 GSR · laboratorní i terénní měření
        </p>
      </div>

      <!-- Proč samotný eye-tracking nestačí — tři vrstvy -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ PROČ SAMOTNÝ EYE-TRACKING NESTAČÍ ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Pozornost ≠ pochopení ≠ konverze<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {[
            { t: 'Co viděl', d: 'Eye-tracking ukáže, co uživatel skutečně vidí a co míjí.', tag: 'POHLED' },
            { t: 'Co udělal', d: 'Splnil úkol? Jak dlouho mu trval a kde chyboval?', tag: 'CHOVÁNÍ' },
            { t: 'Proč', d: 'Jak rozhraní hodnotil a co dokázal zpětně vysvětlit.', tag: 'VÝPOVĚĎ' },
          ].map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-sm text-brand-black/60 leading-relaxed mt-4 max-w-2xl">
          Teprve spojení všech tří vrstev odliší problém, který jen přitahuje pohled, od problému, který brání dokončení úkolu.
        </p>
      </div>

      <!-- Balíčky -->
      <div id="balicky" class="mb-24 scroll-mt-28">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ NAŠE TESTOVACÍ BALÍČKY ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-4">Čtyři konfigurace<span style="color:#2D62FC">.</span></h2>
        <p class="text-brand-black/60 leading-relaxed max-w-2xl mb-12">
          Nejsou to pevné produkty — upravujeme je podle zadání. U každého předem víte, co získáte i co z daného rozsahu <strong class="text-brand-black">nepůjde spolehlivě tvrdit</strong>.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          {packages.map(pkg => (
            <div id={pkg.id} class={`reveal p-8 md:p-10 flex flex-col scroll-mt-28 ${pkg.featured ? 'bg-brand-black text-brand-white' : 'bg-brand-white'}`}>
              <div class="flex justify-between items-start mb-6">
                <span class={`font-mono text-xs ${pkg.featured ? 'text-brand-white/60' : 'text-brand-black/60'}`}>{pkg.num}</span>
                {pkg.featured && (
                  <span class="font-mono text-[10px] tracking-widest px-2 py-1" style="background:#2D62FC; color:#FCFCFC;">PRÉMIOVÉ MĚŘENÍ</span>
                )}
              </div>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-3 leading-tight">{pkg.title}</h3>
              <p class={`leading-relaxed mb-6 ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>{pkg.tagline}</p>

              <div class="flex flex-wrap gap-2 mb-6">
                {pkg.chips.map(chip => (
                  <span class={`font-mono text-[11px] px-2 py-1 tracking-wide border ${pkg.featured ? 'border-brand-white/30 text-brand-white/80' : 'border-brand-black/20 text-brand-black/70'}`}>{chip}</span>
                ))}
              </div>

              <p class={`text-sm leading-relaxed mb-6 ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>
                <span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Zjistíte</span>
                {pkg.findings}
              </p>

              <details class={`group mt-auto border-t pt-4 ${pkg.featured ? 'border-brand-white/20' : 'border-brand-black/10'}`}>
                <summary class="flex justify-between items-center cursor-pointer font-mono text-xs tracking-widest uppercase list-none [&::-webkit-details-marker]:hidden">
                  DETAIL BALÍČKU
                  <span class="font-mono text-lg transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <div class={`mt-4 space-y-4 text-sm leading-relaxed ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Pro koho</span>{pkg.forWho}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Co je uvnitř</span>{pkg.inside}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Co je dobré vědět</span>{pkg.limits}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Typický výstup</span>{pkg.output}</p>
                </div>
              </details>
            </div>
          ))}
        </div>

        <!-- Balíček na míru -->
        <div id="na-miru" class="reveal relative overflow-hidden bg-brand-black text-brand-white p-8 md:p-12 mt-px scroll-mt-28">
          <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
          <div class="relative flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div>
              <p class="font-mono text-xs text-brand-white/60 mb-2">05</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-3">Balíček na míru<span style="color:#2D62FC">.</span></h3>
              <p class="text-brand-white/70 leading-relaxed max-w-xl">
                Nejdřív poznáme váš byznys, cíle a kontext — pak vám na míru navrhneme testování i navazující optimalizaci. Od výzkumné otázky přes vhodnou kombinaci metod až po konkrétní úpravy, které se propíšou do výsledků. Skládáme podle rozhodnutí, které se z dat bude dělat, ne podle vybavení laboratoře.
              </p>
            </div>
            <a href="/kontakt" class="shrink-0 inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              NEVÍM, KTERÝ ZVOLIT →
            </a>
          </div>
        </div>
      </div>

      <!-- EMLI -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="grid grid-cols-1 md:grid-cols-[minmax(0,2fr)_minmax(240px,1fr)] md:items-center gap-10 md:gap-16">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ EMLI: INDEX MENTÁLNÍ ZÁTĚŽE ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">Kde rozhraní vyžaduje nejvíc úsilí<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed text-justify mb-4">
              EMLI převádí vybrané ukazatele z eye trackingu do skóre od 0 do 100. Díky tomu můžeme porovnat jednotlivé obrazovky, kroky nebo varianty a určit, kde je zpracování informací pro uživatele náročnější.
            </p>
            <p class="text-sm text-brand-black/60 leading-relaxed text-justify">
              <strong class="text-brand-black">Čím vyšší skóre, tím větší zátěž.</strong> Výsledek vždy hodnotíme společně s chováním uživatele a dalšími daty, ne jako samostatný verdikt.
            </p>
          </div>
          <div aria-label="Stupnice EMLI od nižší po vyšší mentální zátěž">
            <div class="emli-scale h-2 mb-4" aria-hidden="true">
              <div class="emli-fill"></div>
            </div>
            <div class="flex items-start justify-between gap-6 font-mono text-[10px] tracking-widest uppercase">
              <p><strong class="block font-display text-3xl leading-none mb-2 text-brand-blue">0</strong>Nižší zátěž</p>
              <p class="text-right"><strong class="block font-display text-3xl leading-none mb-2 text-brand-blue">100</strong>Vyšší zátěž</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Proces a výstupy -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ JAK SPOLUPRÁCE PROBÍHÁ ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10">Od cíle ke konkrétním úpravám<span style="color:#2D62FC">.</span></h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-px bg-brand-black/10 border border-brand-black/10">
          {process.map(step => (
            <div class="bg-brand-white p-6 md:p-7 min-h-64 flex flex-col">
              <span class="font-mono text-xs text-brand-black/60 mb-10">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed text-justify mt-auto">{step.desc}</p>
            </div>
          ))}
        </div>

        <p class="font-mono text-xs text-brand-black/60 tracking-widest mt-16 mb-8">[ CO DOSTANETE VE VÝSTUPU ]</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {outputs.map((output, i) => (
            <div class="bg-brand-white p-7 md:p-8 min-h-56 flex flex-col">
              <span class="font-mono text-xs text-brand-black/60 mb-8">0{i + 1}</span>
              <h3 class="font-display text-2xl font-bold leading-tight mb-3">{output.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed text-justify mt-auto">{output.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Pro koho -->
      <div class="reveal mb-24 max-w-4xl">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ PRO KOHO JSOU BALÍČKY VHODNÉ ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6">Pro týmy, které chtějí rozhodovat podle dat<span style="color:#2D62FC">.</span></h2>
        <p class="text-brand-black/60 leading-relaxed text-justify mb-8 max-w-3xl">
          Testovací balíčky využijí produktové a UX týmy, marketing, e-commerce, retail i vedení firem. Rozsah přizpůsobíme tomu, zda řešíte navigaci, formulář, kampaň, nákupní proces, fyzický prostor nebo podklady pro důležité rozhodnutí.
        </p>
        <div class="flex flex-wrap gap-x-5 gap-y-3">
          {audiences.map(a => (
            <span class="font-mono text-[11px] text-brand-black/60 tracking-widest uppercase">{a}</span>
          ))}
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ ČASTÉ OTÁZKY K TESTOVÁNÍ ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10">Co je dobré vědět před výběrem<span style="color:#2D62FC">.</span></h2>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    // Scroll-reveal — stejný pattern jako na případových studiích
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>

  <style>
    /* EMLI stupnice — čára jednou najede (0 → 100) a ustálí se na 63; spustí se, až sekce naroluje do viewportu */
    .emli-scale {
      position: relative;
      overflow: hidden;
      background: rgba(45, 98, 252, 0.1);
    }
    .emli-fill {
      position: absolute;
      inset: 0;
      transform-origin: left center;
      background: linear-gradient(90deg, rgba(45, 98, 252, 0.16), #2d62fc);
      transform: scaleX(0.63);
    }
    .reveal.is-visible .emli-fill {
      animation: emliFill 2.8s ease-in-out both;
    }
    @keyframes emliFill {
      0% { transform: scaleX(0); }
      65% { transform: scaleX(1); }
      100% { transform: scaleX(0.63); }
    }
    @media (prefers-reduced-motion: reduce) {
      .reveal.is-visible .emli-fill { animation: none; }
      .emli-fill { transform: scaleX(0.63); }
    }
  </style>
</BaseLayout>
