---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const contexts = [
  { t: 'Retail a prodejny', d: 'Orientace v prostoru, product placement, značení, POS materiály a regálové zóny.', tag: 'IN-STORE' },
  { t: 'Showroomy a eventy', d: 'Čeho si návštěvníci všímají, kde se zastavují a co je vede k interakci.', tag: 'PROSTOR' },
  { t: 'Automotive a HMI', d: 'Pozornost při obsluze rozhraní ve vozidle nebo u fyzického produktu.', tag: 'HMI' },
];

const findings = [
  'Jak lidé skutečně procházejí prostorem — ne jak si myslíte, že jím procházejí',
  'Čeho si všímají, co míjejí a kde se zastavují',
  'Zda značení a komunikace vedou pozornost k cíli',
  'Kde prostředí rozhodování podporuje a kde ho komplikuje',
  'Jak se chování liší podle typu zákazníka nebo situace',
];

const process = [
  { num: '01', title: 'Zadání a rekognoskace', desc: 'Co se má rozhodnout a kde se měření odehraje.' },
  { num: '02', title: 'Scénář a pilotáž', desc: 'Trasy, úkoly a technický protokol ověříme pilotem na místě.' },
  { num: '03', title: 'Měření v terénu', desc: 'Mobilní eye-tracking brýle, videozáznam, podle potřeby GSR a rozhovory.' },
  { num: '04', title: 'Analýza a doporučení', desc: 'Mapování klíčových momentů a návrhy úprav prostoru či komunikace.' },
];

const faq = [
  { q: 'Jak terénní měření technicky probíhá?', a: 'Respondent má nasazené lehké eye-tracking brýle Pupil Labs NEON, které zaznamenávají pohled i scénu před ním. Podle potřeby doplňujeme GSR náramek, videozáznam situace a rozhovory po průchodu.' },
  { q: 'Čím se liší od měření v laboratoři?', a: 'Terén nabízí přirozenější chování, ale menší kontrolu podmínek — osvětlení, provoz, jiní zákazníci. Proto dopředu určujeme, které závěry lze z terénního měření vyvozovat bezpečně a které je vhodné ověřit kontrolovaněji.' },
  { q: 'Nenaruší brýle přirozené chování?', a: 'Moderní brýle vypadají jako běžné brýle a respondenti na ně obvykle po pár minutách zapomenou. Prvních pár minut záznamu proto vyhodnocujeme s rezervou.' },
  { q: 'Potřebujeme souhlas prodejny nebo návštěvníků?', a: 'Ano, měření vždy koordinujeme s provozovatelem prostoru a respondenti podepisují informovaný souhlas. Osoby v pozadí záznamu anonymizujeme.' },
  { q: 'Kde všude umíte měřit?', a: 'V prodejnách, showroomech, na eventech, v pracovním prostředí i ve vozidlech. Limitem nejsou technologie, ale bezpečnost a domluva s provozovatelem.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Terénní měření',
    description: 'Terénní UX výzkum s mobilními eye-tracking brýlemi Pupil Labs NEON: prodejny, showroomy, eventy, automotive a HMI. Pozornost a chování v reálném prostředí.',
    serviceType: 'Terénní eye-tracking',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Terénní měření | Mobilní eye-tracking v prodejně i showroomu"
  description="Terénní UX výzkum s mobilními eye-tracking brýlemi: prodejny, showroomy, eventy, automotive. Zjistěte, čeho si zákazníci všímají v reálném prostředí."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SLUŽBY / TERÉNNÍ MĚŘENÍ ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          MIMO<br/>OBRAZOVKU<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Měříme tam, kde se zákazník skutečně rozhoduje.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              V prodejně, showroomu, na eventu nebo u fyzického produktu. Mobilní eye-tracking brýle
              zachytí pozornost v reálném prostředí — <strong class="text-brand-black">vybavení, které v ČR jen tak někdo nemá</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="/kontakt" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              POPTAT MĚŘENÍ →
            </a>
            <a href="/sluzby/testovaci-balicky" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              TESTOVACÍ BALÍČKY
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DÉLKA', '2–6 týdnů'],
          ['TECHNOLOGIE', 'Pupil Labs NEON'],
          ['DOPLŇKY', 'GSR · video · rozhovory'],
          ['BALÍČEK', 'Terénní studie'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Kde měříme -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ KDE MĚŘÍME ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Zákaznická cesta nekončí na webu<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {contexts.map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Foto (TODO: nahradit reálnou fotkou z terénu — brýle NEON v prodejně) -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/laborator-ux-vyzkumu-vizualizace-2.webp`}
          alt="Výzkumné zázemí UXMIND — odsud vyrážíme s mobilním eye-trackingem do terénu"
          title="Výzkumné zázemí pro terénní měření"
          width="1200" height="800" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Zázemí laboratoře FIM UHK — kalibrace a příprava techniky před výjezdem do terénu.</p>
      </div>

      <!-- Co zjistíte + proces -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ CO ZJISTÍTE ]</p>
          <ul class="space-y-2">
            {findings.map(o => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {o}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ JAK MĚŘENÍ PROBÍHÁ ]</p>
          <div class="space-y-0">
            {process.map(step => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Hranice -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ HRANICE METODY ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">Přirozenost za cenu kontroly<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Terén nabízí vyšší přirozenost situace, ale menší kontrolu podmínek než laboratoř.
              Vždy proto dopředu určujeme, které závěry lze z terénního měření vyvozovat bezpečně
              a které je vhodné ověřit ještě kontrolovaněji.
            </p>
          </div>
          <a href="/sluzby/testovaci-balicky#terenni-studie" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            BALÍČEK TERÉNNÍ STUDIE →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ ČASTÉ DOTAZY ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            CO VIDÍ ZÁKAZNÍK<br/>VE VAŠÍ PRODEJNĚ<span style="color:#2D62FC">?</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            Popište nám prostor a rozhodnutí, které řešíte. Navrhneme scénář terénního měření a řekneme, co z něj půjde bezpečně vyvodit.
          </p>
          <a href="/kontakt" class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
            POPTAT MĚŘENÍ →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
