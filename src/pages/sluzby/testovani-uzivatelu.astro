---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const formats = [
  { t: 'Moderované testování', d: 'Výzkumník sleduje účastníka při plnění úkolů, doptává se a pomáhá odhalit, proč se na konkrétním místě zastavil nebo rozhodl jinak.', tag: 'DO HLOUBKY · V LABORATOŘI I ONLINE' },
  { t: 'Nemoderované testování', d: 'Účastníci plní připravené úkoly samostatně. Tento formát umožňuje rychle zapojit více lidí a porovnat jejich výsledky.', tag: 'VĚTŠÍ VZOREK · ONLINE' },
];

const findings = [
  { title: 'Dokončení úkolů', desc: 'Zjistíme, zda lidé zvládnou důležité úkoly, jak dlouho jim trvají a ve kterých krocích se zastavují.' },
  { title: 'Srozumitelnost rozhraní', desc: 'Odhalíme prvky, názvy a informace, kterým uživatelé nerozumějí nebo je přehlížejí.' },
  { title: 'Důvody rozhodování', desc: 'Zjistíme, co uživatelé očekávají, proč volí konkrétní cestu a zda jejich výpovědi odpovídají skutečnému chování.' },
];

const process = [
  { num: '01', title: 'Cíl a scénář', desc: 'Ujasníme si, co potřebujete ověřit, a připravíme realistické úkoly.' },
  { num: '02', title: 'Výběr účastníků', desc: 'Určíme vhodnou cílovou skupinu a zajistíme účastníky podle domluvených kritérií.' },
  { num: '03', title: 'Testování', desc: 'Účastníci plní připravené úkoly. Sledujeme jejich postup, chyby, reakce a komentáře.' },
  { num: '04', title: 'Analýza a doporučení', desc: 'Zjištění vyhodnotíme, seřadíme podle důležitosti a převedeme do konkrétních návrhů úprav.' },
];

const faq = [
  { q: 'Kolik respondentů je potřeba?', a: 'Pro kvalitativní odhalení hlavních problémů obvykle stačí 5–8 respondentů na segment. Pro srovnání variant nebo statistické vyhodnocení je potřeba větší, přesněji navržený vzorek — rozsah navrhujeme podle výzkumné otázky.' },
  { q: 'Jak dlouho uživatelské testování trvá?', a: 'Nejčastěji 1–4 týdny podle rozsahu, způsobu náboru a počtu účastníků. Přesný harmonogram stanovíme po upřesnění cíle a cílové skupiny.' },
  { q: 'Kolik uživatelské testování stojí?', a: 'Cena závisí na počtu účastníků, způsobu náboru, formátu testování a rozsahu výstupu. Po krátkém úvodním zadání doporučíme vhodný rozsah a připravíme konkrétní nabídku.' },
  { q: 'Můžeme testovat i prototyp?', a: 'Ano. Testujeme hotové weby, e-shopy a aplikace i klikací prototypy. Čím dříve problém odhalíme, tím snazší a levnější bývá jeho úprava.' },
  { q: 'Jak se uživatelské testování liší od UX auditu?', a: 'UX audit je expertní kontrola rozhraní bez účastníků. Uživatelské testování sleduje skutečné uživatele při plnění úkolů a ověřuje, jak se problémy projevují v praxi.' },
  { q: 'Je součástí uživatelského testování eye tracking?', a: 'Ne ve standardním rozsahu. Eye tracking nabízíme jako samostatné rozšíření, když potřebujete přesně změřit vizuální pozornost a zjistit, kterých prvků si lidé všimli nebo co přehlédli.' },
  { q: 'Můžeme testování sledovat naživo?', a: 'Ano. U moderovaných testů lze po domluvě sledovat průběh z odděleného místa nebo vzdáleně, vždy s ohledem na souhlas účastníků a podmínky studie.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Testování uživatelů',
    description: 'Moderované i nemoderované uživatelské testování webů, aplikací a prototypů. Think-aloud protokol, záznam obrazovky, analýza úspěšnosti úkolů a doporučení.',
    serviceType: 'Uživatelské testování',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Testování uživatelů | Moderované a nemoderované UX testy"
  description="Uživatelské testování webů, aplikací a prototypů s reálnými uživateli. Moderované i nemoderované testy, think-aloud, záznam obrazovky a konkrétní doporučení."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SLUŽBY / TESTOVÁNÍ UŽIVATELŮ ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          OVĚŘTE<br/>POUŽITELNOST<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-3xl">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Ověřte důležité úkoly se skutečnými uživateli.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify mb-4">
              Sledujeme, jak lidé používají váš web, e-shop, aplikaci nebo prototyp. Zjistíme, zda se dokážou zorientovat, dokončit důležité úkoly a kterým částem rozhraní nerozumějí.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify">
              Dostanete konkrétní zjištění a doporučení, <strong class="text-brand-black">co upravit, aby byl produkt srozumitelnější a snadněji použitelný</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/kontakt" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              POPTAT TESTOVÁNÍ →
            </a>
            <a href="/sluzby#testovaci-balicky" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              PROJÍT BALÍČKY
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DÉLKA', '1–4 týdny'],
          ['FORMÁT', 'Moderované i online'],
          ['VZOREK', 'Dle výzkumné otázky'],
          ['BALÍČEK', 'Standardní UX test'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Jak testujeme -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ JAK TESTUJEME ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Formát volíme podle cíle studie<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          {formats.map((v, i) => (
            <div class="bg-brand-white p-8 flex flex-col h-full">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed text-justify mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest self-start mt-auto">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-sm md:text-base text-brand-black/60 leading-relaxed mt-6 max-w-4xl">
          <strong class="text-brand-black">Podle cíle testování</strong> zapojujeme komentování nahlas, následný rozhovor, krátké dotazníky a záznam obrazovky.
        </p>
      </div>

      <!-- Foto -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
          alt="Respondentka během uživatelského testování v laboratoři"
          title="Průběh uživatelského testování"
          width="1080" height="1920" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">V laboratoři lze testy doplnit o eye-tracking — vidíte nejen co uživatel udělal, ale i co při tom viděl.</p>
      </div>

      <!-- Co testování odhalí -->
      <div class="reveal mb-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.35fr] gap-10 lg:gap-16">
          <div>
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ CO TESTOVÁNÍ ODHALÍ ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              Kde rozhraní pomáhá — a kde překáží<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <div class="border-t border-brand-white/20">
            {findings.map((finding, i) => (
              <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_12rem_1fr] gap-x-4 gap-y-2 py-6 border-b border-brand-white/20">
                <span class="font-mono text-xs text-brand-white/50 pt-1">0{i + 1}</span>
                <h3 class="font-display text-lg font-bold leading-tight">{finding.title}</h3>
                <p class="col-start-2 sm:col-start-3 text-sm text-brand-white/65 leading-relaxed">{finding.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Proces -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ JAK TESTOVÁNÍ PROBÍHÁ ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Od cíle ke konkrétním úpravám<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
          {process.map(step => (
            <div class="border-t border-brand-black/20 pt-5">
              <span class="block font-mono text-xs text-brand-black/60 mb-5">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Volitelné rozšíření -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ VOLITELNÉ ROZŠÍŘENÍ ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">Když potřebujete změřit také pozornost<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Uživatelské testování ukáže, zda lidé úkol zvládnou a kde se zastavují. Eye tracking může navíc přesně změřit,
              kterých prvků si všimli, co přehlédli a jak se jejich pozornost během úkolu měnila. Biometrické metody doplníme pouze tehdy, když odpovídají cíli studie.
            </p>
          </div>
          <a href="/sluzby/eye-tracking" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            PROJÍT EYE TRACKING →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ ČASTÉ DOTAZY ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
