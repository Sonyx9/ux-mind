---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const reveals = [
  { t: 'Překážky v cestě', d: 'Kroky, ve kterých může být obtížné se zorientovat, pokračovat nebo najít správnou informaci.', tag: 'UŽIVATELSKÁ CESTA' },
  { t: 'Nejasné rozhraní', d: 'Nesrozumitelné názvy, slabá vizuální hierarchie a prvky, u kterých není jasné, co udělají.', tag: 'SROZUMITELNOST' },
  { t: 'Priority úprav', d: 'Problémy seřazené podle dopadu a náročnosti, aby bylo jasné, co řešit nejdříve.', tag: 'DALŠÍ KROKY' },
];

const process = [
  { num: '01', title: 'Cíl a rozsah', desc: 'Vybereme klíčové stránky, uživatelské cesty a cíle auditu.' },
  { num: '02', title: 'Expertní kontrola', desc: 'Prověříme navigaci, obsah, hierarchii a srozumitelnost rozhraní.' },
  { num: '03', title: 'Souvislosti a data', desc: 'Zjištění zasadíme do kontextu produktu a zapojíme dostupnou analytiku.' },
  { num: '04', title: 'Doporučení a předání', desc: 'Problémy seřadíme podle důležitosti a společně projdeme další kroky.' },
];

const outputs = [
  { title: 'Přehled problémů', desc: 'Každé zjištění spojíme s konkrétním místem v rozhraní a vysvětlíme jeho dopad.' },
  { title: 'Priority podle dopadu', desc: 'Rozlišíme, co je potřeba řešit hned, co později a co zatím není důležité.' },
  { title: 'Konkrétní návrhy úprav', desc: 'Doporučíme, jak problém odstranit. U vybraných míst doplníme návrh nebo ukázku řešení.' },
  { title: 'Společné předání výsledků', desc: 'Závěry projdeme s vaším týmem, aby bylo jasné, jak je převést do praxe.' },
];

const faq = [
  { q: 'Co UX audit obsahuje?', a: 'Prověříme klíčové stránky a uživatelské cesty, navigaci, obsah, vizuální hierarchii i srozumitelnost rozhraní. Výstupem je přehled problémů, jejich priority a konkrétní doporučení k úpravám.' },
  { q: 'Jak dlouho UX audit trvá?', a: 'Nejčastěji 2–4 týdny podle rozsahu produktu a počtu prověřovaných cest. Termín upřesníme po krátkém úvodním zadání.' },
  { q: 'Kolik UX audit stojí?', a: 'Cena závisí na rozsahu produktu, počtu klíčových cest a požadované podobě výstupu. Po seznámení se zadáním připravíme konkrétní nabídku bez skrytých položek.' },
  { q: 'Čím se UX audit liší od uživatelského testování?', a: 'UX audit je expertní kontrola rozhraní bez respondentů. Uživatelské testování sleduje skutečné uživatele při plnění úkolů a ověřuje, jak se problémy projevují v praxi.' },
  { q: 'Lze auditovat také e-shop, aplikaci nebo prototyp?', a: 'Ano. Auditujeme weby, e-shopy, aplikace i dostatečně propracované prototypy. Rozsah vždy přizpůsobíme fázi produktu a rozhodnutí, které potřebujete udělat.' },
  { q: 'Co potřebujete k zahájení auditu?', a: 'Přístup k produktu nebo prototypu, popis cílových uživatelů a klíčových úkolů, které mají zvládnout. Pokud máte webovou analytiku nebo předchozí výzkum, můžeme je zapojit jako další kontext.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'UX audit',
    description: 'Expertní UX audit webu, e-shopu nebo aplikace: heuristická analýza, analýza uživatelských cest, prioritizovaná doporučení a workshop. Rychlý základ každého zlepšování.',
    serviceType: 'UX audit',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="UX audit webu a e-shopu | Expertní analýza použitelnosti"
  description="UX audit webu, e-shopu nebo aplikace za 2–4 týdny. Heuristická analýza, analýza cest, prioritizovaná doporučení a quick wins. Rychlý základ každého zlepšování."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SLUŽBY / UX AUDIT ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          ODHALTE<br/>SLABÁ MÍSTA<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-3xl">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">UX audit webu, e-shopu nebo aplikace.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed mb-4">
              Projdeme klíčové stránky a uživatelské cesty. Prověříme navigaci, srozumitelnost obsahu, vizuální hierarchii i překážky při dokončení důležitých úkolů.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed">
              Dostanete konkrétní doporučení seřazená podle dopadu a náročnosti, abyste věděli, <strong class="text-brand-black">co upravit jako první</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/kontakt" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              POPTAT UX AUDIT →
            </a>
            <a href="/sluzby#testovaci-balicky" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              PROJÍT BALÍČKY
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DÉLKA', '2–4 týdny'],
          ['METODA', 'Expertní hodnocení'],
          ['RESPONDENTI', 'Nejsou potřeba'],
          ['BALÍČEK', 'Rychlý UX audit'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Co audit odhalí -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CO UX AUDIT ODHALÍ ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Co zbytečně komplikuje dokončení úkolu<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {reveals.map((v, i) => (
            <div class="bg-brand-white p-8 flex flex-col h-full">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest self-start mt-auto">{v.tag}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Foto -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/jan-petruzalek-analyza-eye-tracking-dat.webp`}
          alt="Specialista při analýze dat z UX auditu a eye-trackingu"
          title="Analýza dat při UX auditu"
          width="1200" height="800" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Audit není dojmologie — každé zjištění dokládáme konkrétním místem v rozhraní a principem, který porušuje.</p>
      </div>

      <!-- Proces -->
      <div class="reveal mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ JAK AUDIT PROBÍHÁ ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Čtyři kroky od zadání k doporučením<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
          {process.map(step => (
            <div class="border-t border-brand-black/20 pt-5">
              <span class="block font-mono text-xs text-brand-black/60 mb-5">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Výstup -->
      <div class="reveal mb-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.35fr] gap-10 lg:gap-16">
          <div>
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ CO DOSTANETE ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              Jasný plán, co upravit jako první<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <div class="border-t border-brand-white/20">
            {outputs.map((output, i) => (
              <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_12rem_1fr] gap-x-4 gap-y-2 py-5 border-b border-brand-white/20">
                <span class="font-mono text-xs text-brand-white/50 pt-1">0{i + 1}</span>
                <h3 class="font-display text-lg font-bold leading-tight">{output.title}</h3>
                <p class="col-start-2 sm:col-start-3 text-sm text-brand-white/65 leading-relaxed">{output.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Kdy audit stačí a kdy testovat -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ KDY AUDIT STAČÍ A KDY TESTOVAT ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">Audit odhalí slabá místa. Testování ověří jejich dopad<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              UX audit je vhodný, když potřebujete rychle najít problémy a získat konkrétní plán úprav.
              Pokud chcete ověřit, jak se v rozhraní skutečně chovají uživatelé a které překážky mají největší vliv, navážeme uživatelským testováním nebo eye trackingem.
            </p>
          </div>
          <a href="/sluzby/testovaci-balicky" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            PROJÍT MOŽNOSTI TESTOVÁNÍ →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ ČASTÉ DOTAZY ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
