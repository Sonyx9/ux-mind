---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const partners = [
  {
    num: '01',
    name: 'Univerzita Hradec Králové',
    claim: 'Výzkumné zázemí a metodika.',
    logo: `${base}/logos/uhk.svg`,
    logoAlt: 'Logo Univerzity Hradec Králové',
    logoClass: 'h-16 md:h-20',
    logoW: 157, logoH: 37,
    text: [
      'V laboratoři kognitivních studií FIM UHK testujeme digitální i fyzická rozhraní v kontrolovaných podmínkách i v terénu. Zázemí nám umožňuje připravit metodiku, ověřit scénář a propojit eye tracking s dalšími výzkumnými metodami.',
      'Součástí výzkumného prostředí jsou také odborné publikace, studentské práce a rozvoj vlastních metod včetně indexu mentální zátěže EMLI.',
    ],
    tags: ['FIM UHK', 'Laboratoř', 'EMLI'],
    links: [
      { label: 'UHK.CZ →', href: 'https://www.uhk.cz' },
      { label: 'FAKULTA INFORMATIKY A MANAGEMENTU', href: 'https://www.uhk.cz/cs/fakulta-informatiky-a-managementu' },
    ],
  },
  {
    num: '02',
    name: 'MindSense',
    claim: 'Technologie a odborná podpora.',
    logo: `${base}/logos/mindsense.webp`,
    logoAlt: 'Logo MindSense — řešení pro výzkumné laboratoře',
    logoClass: 'h-10 md:h-12',
    logoW: 1118, logoH: 194,
    text: [
      'MindSense se podílel na rozšíření laboratoře o nové výzkumné vybavení a zajišťuje odbornou podporu pro používané technologie. Je výhradním autorizovaným distributorem Tobii pro Českou republiku a Slovensko.',
      'Pomáhá s propojením eye trackingu, biosenzorů, virtuální reality a softwaru tak, aby jednotlivé zdroje dat fungovaly jako jeden výzkumný celek.',
    ],
    tags: ['Tobii', 'Biosenzory', 'VR'],
    links: [
      { label: 'MINDSENSE.CZ →', href: 'https://mindsense.cz' },
    ],
  },
];

const pageSchema = [
  {
    '@type': 'WebPage',
    name: 'Partneři UX MIND',
    description: 'Partneři UX MIND: Univerzita Hradec Králové poskytuje výzkumné zázemí a MindSense technologickou a odbornou podporu.',
  },
];
---

<BaseLayout
  title="Partneři projektu"
  description="Partneři UX MIND: Univerzita Hradec Králové poskytuje výzkumné zázemí a MindSense technologickou a odbornou podporu."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ PARTNEŘI ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          NEMĚŘÍME<br/>SAMI<span style="color:#2D62FC">.</span>
        </h1>
        <p class="text-lg text-brand-black/60 leading-relaxed max-w-3xl">
          Kvalitní výzkum nestojí jen na technice. Potřebuje správnou metodiku, spolehlivé vybavení a lidi, kteří umějí data interpretovat. UX MIND proto propojuje <strong class="text-brand-black">výzkumné zázemí FIM UHK s technologickým know-how MindSense</strong>.
        </p>
      </div>

      <!-- Partneři -->
      <div class="space-y-px border border-brand-black/10">
        {partners.map(p => (
          <div class="reveal p-8 md:p-12 border-b border-brand-black/10 last:border-0">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-10 items-start">
              <!-- Logo -->
              <div class="flex flex-col gap-6">
                <span class="font-mono text-xs text-brand-black/60">{p.num}</span>
                <img src={p.logo} alt={p.logoAlt} width={p.logoW} height={p.logoH} class={`${p.logoClass} w-auto object-contain self-start`} loading="lazy" decoding="async" />
                <div class="flex flex-wrap gap-2">
                  {p.tags.map(tag => (
                    <span class="font-mono text-[11px] border border-brand-black/20 px-2 py-1 tracking-widest">{tag}</span>
                  ))}
                </div>
              </div>
              <!-- Text -->
              <div class="md:col-span-2">
                <h2 class="font-display text-3xl md:text-4xl font-bold mb-2">{p.name}</h2>
                <p class="font-mono text-xs text-brand-black/60 tracking-widest uppercase mb-6">{p.claim}</p>
                {p.text.map(t => (
                  <p class="text-brand-black/60 leading-relaxed mb-4 max-w-2xl">{t}</p>
                ))}
                <div class="flex flex-wrap gap-4 mt-6">
                  {p.links.map(l => (
                    <a href={l.href} target="_blank" rel="noopener noreferrer" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                      {l.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Jak spolupráce zapadá do měření -->
      <div class="reveal mt-24 grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          { t: 'Výzkumné zázemí', d: 'Laboratoř FIM UHK poskytuje podmínky pro přípravu, pilotní ověření a realizaci studií.', tag: 'UHK' },
          { t: 'Technologická podpora', d: 'MindSense pomáhá s vybavením, jeho propojením a odbornou podporou.', tag: 'MINDSENSE' },
          { t: 'Výsledek pro klienta', d: 'UX MIND převádí naměřená data do srozumitelných závěrů a konkrétních doporučení.', tag: 'UX MIND' },
        ].map((v, i) => (
          <div class="bg-brand-white p-8 flex flex-col h-full">
            <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
            <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
            <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
            <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest self-start mt-auto">{v.tag}</span>
          </div>
        ))}
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
