---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const fakta = [["METODA", "Eye tracking + VisAWI"], ["VZOREK", "61 respondentů"], ["STIMULY", "3 šablony · shodný sortiment"], ["SCÉNÁŘE", "Volné prohlížení · cílený úkol"]];
const zjisteni = ["Na stejné šabloně se rozložení vizuální pozornosti měnilo podle zadaného úkolu.", "Volné prohlížení a cílené hledání produktu vedly účastníky k jiným částem stránky.", "Estetické hodnocení a chování při konkrétním úkolu popisují rozdílné stránky zkušenosti. Jedna metrika proto nemůže automaticky zastoupit druhou."];
const faq = [
  { q: "Jak vybrat šablonu e-shopu?", a: "Nejprve podle sortimentu, obsahu, technických požadavků a klíčových zákaznických cest. Užší výběr je vhodné ověřit na realistických úkolech, protože náhled šablony sám neukáže, jak se v ní lidé budou orientovat." },
  { q: "Proč nestačí estetické hodnocení šablony?", a: "Vnímaná estetika a chování při úkolu jsou rozdílné konstrukty. Šablona může působit dobře, ale konkrétní cesta v ní může být obtížná — nebo naopak. Proto kombinujeme dotazník s úkolovými a behaviorálními daty." },
  { q: "Kolik šablon a úkolů se testovalo?", a: "Studie zahrnovala tři šablony se shodným sortimentem, dva odlišné kontexty úkolu a 61 respondentů. Jeden scénář podporoval volné prohlížení, druhý cílenou práci s nabídkou." },
  { q: "Našla studie jednu nejlepší šablonu?", a: "Ne univerzálně. Hlavním zjištěním bylo, že interpretace šablony závisí na úkolu. Vítěznou variantu je proto potřeba definovat podle konkrétní cesty a metrik, které má e-shop podporovat." },
  { q: "Dokazuje rozložení pozornosti vyšší konverzi?", a: "Ne. Eye tracking ukazuje, kam lidé zaměřili pohled, nikoli automaticky nákup nebo tržbu. Pro obchodní závěr je potřeba výsledek propojit s úspěšností úkolu, analytikou nebo navazujícím experimentem." },
  { q: "Lze otestovat šablonu ještě před spuštěním e-shopu?", a: "Ano. Testovat lze funkční demo, prototyp nebo několik kandidátních šablon naplněných realistickým obsahem. Čím více se podmínky blíží skutečnému použití, tím lépe lze výsledek interpretovat." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "Úkol změnil, kam lidé zaměřili pozornost.",
    about: 'Eye tracking, UX výzkum',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'cs',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Case study: Jak úkol změnil pozornost v e-shopu"
  description="Eye tracking tří e-shopových šablon se 61 respondenty: rozložení pozornosti na stejné šabloně se měnilo podle zadaného úkolu."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/pripadove-studie" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← VŠECHNY STUDIE</a>

      <!-- Hlavička studie -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">E-shop šablony</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          Úkol změnil, kam lidé zaměřili pozornost<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Design studie -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-1 md:grid-cols-3">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative p-7 md:p-9 border-t-4 border-t-brand-blue border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">3</p>
          <p class="text-brand-white/70 leading-relaxed">e-shopové šablony se stejným sortimentem</p>
        </div>
        <div class="relative p-7 md:p-9 border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">2</p>
          <p class="text-brand-white/70 leading-relaxed">odlišné kontexty úkolu</p>
        </div>
        <div class="relative p-7 md:p-9">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">61</p>
          <p class="text-brand-white/70 leading-relaxed">respondentů ve studii</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Obsah -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— CO DATA UKÁZALA</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— CO BYLO POTŘEBA ZJISTIT</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">Popíše samotný vzhled šablony, jak v ní lidé zvládnou konkrétní úkol?</p>
            <p class="text-brand-black/70 leading-relaxed">Studie porovnávala tři e-shopové šablony naplněné shodným sortimentem. Cílem bylo sledovat, jak rozdílný kontext — volné prohlížení a cílená práce s nabídkou — změní způsob, kterým lidé stránku vizuálně procházejí.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— JAK PROBĚHLO MĚŘENÍ</span></p>
            <p class="text-brand-black/70 leading-relaxed">Studie se zúčastnilo 61 respondentů. Eye tracking zaznamenal rozložení vizuální pozornosti při odlišných úkolech a dotazník VisAWI doplnil subjektivní hodnocení vnímané estetiky šablon.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ PRINCIP TESTOVANÝCH SCÉNÁŘŮ ]</p>
              <svg viewBox="0 0 640 300" class="w-full" role="img" aria-label="Ilustrační schéma: stejná šablona, dva úkoly, dvě různá rozložení pozornosti">
  <text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">ILUSTRAČNÍ SCHÉMA · NEJDE O SKUTEČNOU HEATMAPU</text>
  <g>
    <rect x="0" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <rect x="12" y="52" width="276" height="26" fill="rgba(10,10,10,0.12)"/>
    <g fill="rgba(10,10,10,0.08)">
      <rect x="12" y="92" width="84" height="52"/><rect x="108" y="92" width="84" height="52"/><rect x="204" y="92" width="84" height="52"/>
      <rect x="12" y="156" width="84" height="52"/><rect x="108" y="156" width="84" height="52"/><rect x="204" y="156" width="84" height="52"/>
    </g>
    <circle cx="150" cy="65" r="38" fill="#2D62FC" opacity="0.25"/>
    <circle cx="54" cy="118" r="30" fill="#2D62FC" opacity="0.18"/>
    <text x="8" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">ÚKOL: „PROHLÉDNĚTE SI E-SHOP“</text>
    <text x="8" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">pozornost na brandingu a úvodu</text>
  </g>
  <g>
    <rect x="340" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <rect x="352" y="52" width="276" height="26" fill="rgba(10,10,10,0.12)"/>
    <g fill="rgba(10,10,10,0.08)">
      <rect x="352" y="92" width="84" height="52"/><rect x="448" y="92" width="84" height="52"/><rect x="544" y="92" width="84" height="52"/>
      <rect x="352" y="156" width="84" height="52"/><rect x="448" y="156" width="84" height="52"/><rect x="544" y="156" width="84" height="52"/>
    </g>
    <circle cx="490" cy="118" r="34" fill="#2D62FC" opacity="0.25"/>
    <circle cx="586" cy="182" r="30" fill="#2D62FC" opacity="0.22"/>
    <text x="348" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">ÚKOL: „NAJDĚTE A KUPTE PRODUKT“</text>
    <text x="348" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">pozornost na produktech a ceně</text>
  </g>
  <text x="0" y="296" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">EYE-TRACKING + VisAWI · N = 61 · TŘI ŠABLONY SE STEJNÝM SORTIMENTEM</text>
</svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">Schéma vysvětluje rozdíl mezi scénáři. Modré plochy jsou pouze ilustrativní a nezobrazují skutečná naměřená data účastníků.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— DOPORUČENÍ PRO PRAXI</span></p>
            <p class="text-brand-black/70 leading-relaxed">Šablonu neposuzovat pouze při volném prohlížení nebo podle statického náhledu. Kandidátní řešení naplnit realistickým obsahem a ověřit na úkolech, které odpovídají skutečným zákaznickým cestám.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ CO SI Z TOHO ODNÉST ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">Šablona nefunguje sama o sobě. Funguje pro konkrétní úkol<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">Uživatelský test ukáže, zda vybrané řešení podporuje hledání, porovnání a nákup tak, jak váš e-shop potřebuje.</p>
            <a href="/kontakt" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">PROBRAT TEST E-SHOPU →</a>
          </section>
        </div>

        <!-- Fakta + foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">STUDIE VZNIKLA VE SPOLUPRÁCI S</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Fakulta informatiky a managementu"
                title="Studie vznikla ve spolupráci s FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">FAKTA MĚŘENÍ</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <div class="border border-brand-black/10 p-4 bg-brand-white">
                <svg viewBox="0 0 320 210" class="w-full" role="img" aria-label="Ilustrační schéma tří různých šablon e-shopu se stejným sortimentem">
                  <g>
                    <rect x="4" y="20" width="96" height="130" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                    <rect x="12" y="28" width="80" height="16" fill="rgba(10,10,10,0.25)"/>
                    <rect x="12" y="52" width="80" height="40" fill="rgba(10,10,10,0.08)"/>
                    <rect x="12" y="98" width="38" height="26" fill="rgba(10,10,10,0.08)"/>
                    <rect x="54" y="98" width="38" height="26" fill="rgba(10,10,10,0.08)"/>
                    <circle cx="52" cy="72" r="16" fill="#2D62FC" opacity="0.3"/>
                  </g>
                  <g>
                    <rect x="112" y="20" width="96" height="130" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                    <rect x="120" y="28" width="24" height="114" fill="rgba(10,10,10,0.18)"/>
                    <rect x="152" y="28" width="48" height="26" fill="rgba(10,10,10,0.08)"/>
                    <rect x="152" y="62" width="48" height="26" fill="rgba(10,10,10,0.08)"/>
                    <rect x="152" y="96" width="48" height="26" fill="rgba(10,10,10,0.08)"/>
                    <circle cx="176" cy="75" r="16" fill="#2D62FC" opacity="0.3"/>
                  </g>
                  <g>
                    <rect x="220" y="20" width="96" height="130" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                    <rect x="228" y="28" width="80" height="10" fill="rgba(10,10,10,0.25)"/>
                    <rect x="228" y="46" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="257" y="46" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="286" y="46" width="22" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="228" y="77" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="257" y="77" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="286" y="77" width="22" height="25" fill="rgba(10,10,10,0.08)"/>
                    <circle cx="268" cy="90" r="16" fill="#2D62FC" opacity="0.3"/>
                  </g>
                  <text x="4" y="176" font-family="monospace" font-size="11" fill="#0A0A0A">3 ŠABLONY · STEJNÝ SORTIMENT</text>
                  <text x="4" y="194" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">ilustrační náhled variant</text>
                </svg>
              </div>
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Ilustrační schéma tří šablon se shodným sortimentem</figcaption>
            </figure>
            <a href="/kontakt" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              NEZÁVAZNÁ POPTÁVKA →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ SLOVNÍK — CO ZNAMENAJÍ POJMY V TÉTO STUDII ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">N (vzorek)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Počet lidí zahrnutých do studie. V tomto případě N = 61.</dd></div>
            <div><dt class="font-display font-bold mb-1">Úkolový scénář</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Konkrétní zadání, které určuje, čeho má účastník na stránce dosáhnout.</dd></div>
            <div><dt class="font-display font-bold mb-1">Fixace</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Krátké zastavení oka v určité oblasti. Popisuje vizuální pozornost, nikoli automaticky porozumění nebo nákup.</dd></div>
            <div><dt class="font-display font-bold mb-1">VisAWI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Standardizovaný dotazník zaměřený na subjektivně vnímanou estetiku webového rozhraní.</dd></div>
          </dl>
        </details>
      </section>

      <!-- FAQ ke studii -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ ČASTÉ DOTAZY KE STUDII ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Úzký pruh: kompletní studie (otevírá modal) -->
      <section class="reveal mt-16 !hidden bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Chcete projít studii podrobněji<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">PODROBNÝ REPORT S METODIKOU A DOPORUČENÍMI — ZDARMA V PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          VYŽÁDAT STUDII →
        </button>
      </section>

      <!-- Navigace mezi studiemi -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Další případové studie">
        <a href="/pripadove-studie/reklamni-bannery-smer-pohledu" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← PŘEDCHOZÍ STUDIE</p>
          <p class="font-display font-bold leading-snug">Pohled postavy nasměroval pozornost návštěvníků</p>
        </a>
        <a href="/pripadove-studie/billboardy-sport-marketing" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">DALŠÍ STUDIE →</p>
          <p class="font-display font-bold leading-snug">Prvních šest míst patřilo černým billboardům.</p>
        </a>
      </nav>

    </div>

      <!-- Modal: žádost o kompletní studii -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ PODROBNÁ STUDIE ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Zavřít okno">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Chcete projít studii podrobněji<span style="color:#2D62FC">?</span></h2>
