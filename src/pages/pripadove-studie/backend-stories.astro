---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { features } from '../../config';

const fakta = [["METODA", "Eye-tracking, AOI analýza"], ["VZOREK", "cca 120 respondentů"], ["SCÉNÁŘE", "Více úkolových scénářů"], ["VÝSTUPY", "AOI statistiky, gradient čtení"]];
const zjisteni = ["CTA „Číst online“ zaznamenalo přibližně 92 % respondentů.", "Pozornost postupně klesala: výrazný nadpis zaznamenalo přibližně 86 % respondentů, krátký návazný text 62 % a dlouhý odstavec 33 %.", "Přibližně 75 % respondentů zaznamenalo spodní část stránky ještě před vyplněním formuláře."];
const faq = [
  { q: "Co znamená gradient pozornosti?", a: "Podíl respondentů, kteří zaznamenali jednotlivé prvky, postupně klesal: výrazný nadpis přibližně 86 %, krátký text 62 % a dlouhý odstavec 33 %. Výsledek popisuje tuto konkrétní stránku a testované scénáře." },
  { q: "Kolik respondentů zaznamenalo hlavní CTA?", a: "CTA „Číst online“ zaznamenalo přibližně 92 % z přibližně 120 respondentů. Ze všech sledovaných prvků získalo nejvyšší zásah." },
  { q: "Znamená fixace, že člověk text přečetl?", a: "Ne. Fixace dokládá, že pohled směřoval do dané oblasti, nikoli úplné přečtení nebo porozumění. Proto výsledek formulujeme jako zaznamenání prvku a interpretujeme ho v kontextu úkolu." },
  { q: "Co z výsledků plyne pro tvorbu obsahu?", a: "Na testované stránce pomohly pozornost soustředit jasné CTA, výrazný nadpis a krátký návazný text. U jiného webu je potřeba stejný princip ověřit v jeho vlastním obsahu a kontextu." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "Čím delší text, tím méně pozornosti",
    about: 'Eye tracking, UX výzkum',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'cs',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Case study: Jak délka textu ovlivnila pozornost"
  description="Eye-trackingová AOI analýza edukační microsite: CTA zaznamenalo 92 % respondentů, výrazný nadpis 86 %, krátký text 62 % a dlouhý odstavec 33 %."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/pripadove-studie" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← VŠECHNY STUDIE</a>

      <!-- Hlavička studie -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Edukační microsite</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          Čím delší text, tím méně pozornosti<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Hlavní výsledky -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-2 lg:grid-cols-4">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        {[
          ['92 %', 'CTA'],
          ['86 %', 'výrazný nadpis'],
          ['62 %', 'krátký text'],
          ['33 %', 'dlouhý odstavec'],
        ].map(([value, label], i) => (
          <div class:list={["relative p-6 md:p-8 border-brand-white/15", i === 0 && "border-t-4 border-t-brand-blue", i < 2 && "border-b lg:border-b-0", i % 2 === 0 && "border-r", i === 1 && "lg:border-r", i === 2 && "lg:border-r"]}>
            <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.5rem, 5vw, 4.5rem);">{value}</p>
            <p class="text-brand-white/70 text-sm md:text-base leading-relaxed">respondentů zaznamenalo {label}</p>
          </div>
        ))}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Obsah -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— CO DATA UKÁZALA</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— CO BYLO POTŘEBA ZJISTIT</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">Které prvky návštěvník zaznamená a kde pozornost začíná klesat?</p>
            <p class="text-brand-black/70 leading-relaxed">Edukační microsite kombinovala odborný obsah s hlavní výzvou k akci. Cílem bylo ověřit, jakou pozornost získají jednotlivé vrstvy stránky — CTA, nadpisy, krátké texty i delší odstavce.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— JAK PROBĚHLO MĚŘENÍ</span></p>
            <p class="text-brand-black/70 leading-relaxed">Přibližně 120 respondentů prošlo několika úkolovými scénáři. Eye tracking zachytil jejich vizuální pozornost a AOI analýza spočítala podíl respondentů, kteří fixovali předem vyznačené prvky stránky.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ DATA V OBRAZE ]</p>
              <svg viewBox="0 0 640 278" class="w-full" role="img" aria-label="CTA zaznamenalo 92 procent, nadpis 86, krátký text 62 a dlouhý odstavec 33 procent respondentů"><text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">GRADIENT ČTENÍ · PODÍL RESPONDENTŮ, KTEŘÍ PRVEK ZAZNAMENALI</text><text x="0" y="67" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">CTA „ČÍST ONLINE“</text><rect x="190" y="52" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="52" width="368" height="22" fill="#2D62FC" class="viz-bar"/><text x="558" y="67" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">92 %</text><text x="0" y="119" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">TUČNÝ NADPIS</text><rect x="190" y="104" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="104" width="344" height="22" fill="#0A0A0A" class="viz-bar"/><text x="534" y="119" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">86 %</text><text x="0" y="171" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">KRÁTKÝ TEXT</text><rect x="190" y="156" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="156" width="248" height="22" fill="#0A0A0A" class="viz-bar"/><text x="438" y="171" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">62 %</text><text x="0" y="223" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">DLOUHÝ ODSTAVEC</text><rect x="190" y="208" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="208" width="132" height="22" fill="#0A0A0A" class="viz-bar"/><text x="322" y="223" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">33 %</text></svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">Podíl respondentů, kteří prvek zaznamenali, klesal od hlavního CTA přes nadpis a krátký text až k dlouhému odstavci.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— CO SE ROZHODLO</span></p>
            <p class="text-brand-black/70 leading-relaxed">Výsledky podpořily výrazné oddělení hlavního CTA, zkrácení dlouhých textových bloků a důslednější práci s informační hierarchií. Tým získal konkrétní data pro rozhodnutí, které části obsahu zvýraznit, zkrátit nebo přeskládat.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ CO SI Z TOHO ODNÉST ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">Informace na stránce ještě neznamená informace zaznamenaná<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">Eye tracking ukáže, zda informační hierarchie skutečně vede pozornost k tomu, co má návštěvník vidět a použít.</p>
            <a href="/kontakt" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">PROBRAT VLASTNÍ STUDII →</a>
          </section>
        </div>

        <!-- Fakta + foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">STUDIE VZNIKLA VE SPOLUPRÁCI S</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Fakulta informatiky a managementu"
                title="Studie vznikla ve spolupráci s FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">FAKTA MĚŘENÍ</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/jan-petruzalek-analyza-eye-tracking-dat.webp`}
                alt="Výzkumník analyzuje AOI data — heatmapy pozornosti jednotlivých prvků stránky na monitoru"
                width="1080" height="720" loading="lazy" decoding="async"
                class="w-full h-52 object-cover border border-brand-black/10"
              />
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">AOI analýza: každý prvek stránky má vlastní metriky pozornosti</figcaption>
            </figure>
            <a href="/kontakt" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              NEZÁVAZNÁ POPTÁVKA →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ SLOVNÍK — CO ZNAMENAJÍ POJMY V TÉTO STUDII ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">Fixace</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Krátké zastavení oka v určité oblasti. Dokládá vizuální pozornost, nikoli úplné přečtení nebo porozumění.</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI (sledovaná oblast)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Předem vyznačená část stránky, například CTA, nadpis nebo textový blok, pro kterou počítáme metriky.</dd></div>
            <div><dt class="font-display font-bold mb-1">Zásah prvku</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Podíl respondentů, kteří během scénáře alespoň jednou fixovali danou oblast.</dd></div>
            <div><dt class="font-display font-bold mb-1">Gradient pozornosti</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Postupný pokles podílu respondentů, kteří zaznamenali jednotlivé vrstvy obsahu.</dd></div>
          </dl>
        </details>
      </section>

      <!-- FAQ ke studii -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ ČASTÉ DOTAZY KE STUDII ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Úzký pruh: kompletní studie (otevírá modal) -->
      <section class:list={["reveal mt-16 bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5", !features.studyDownloads && "!hidden"]}>
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Chcete projít studii podrobněji<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">PODROBNÝ REPORT S METODIKOU A DOPORUČENÍMI — ZDARMA V PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          VYŽÁDAT STUDII →
        </button>
      </section>

      <!-- Navigace mezi studiemi -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Další případové studie">
        <a href="/pripadove-studie/karierni-portal-automotive" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← PŘEDCHOZÍ STUDIE</p>
          <p class="font-display font-bold leading-snug">40 % uchazečů nenašlo cestu k volným pozicím</p>
        </a>
        <a href="/pripadove-studie/produktove-fotografie-e-commerce" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">DALŠÍ STUDIE →</p>
          <p class="font-display font-bold leading-snug">Stejný produkt. Jinak dlouhé rozhodování</p>
        </a>
      </nav>

    </div>

      <!-- Modal: žádost o kompletní studii -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ PODROBNÁ STUDIE ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Zavřít okno">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Chcete projít studii podrobněji<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Studie jsou zkráceny a anonymizovány.</p>
          <form class="study-request space-y-4" data-pdf="" data-study="Čím delší text, tím méně pozornosti">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">JMÉNO *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Vaše jméno"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">FIRMA</label>
              <input type="text" id="sr-company" name="company" placeholder="Název firmy (nepovinné)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="vas@email.cz"
                class="study-input" />
            </div>
            <label class="flex items-start gap-2.5 cursor-pointer">
              <input type="checkbox" name="marketing" class="mt-0.5 shrink-0 accent-[#2D62FC]" />
              <span class="font-mono text-[11px] text-brand-white/70 leading-relaxed">Chci od UX MIND dostávat občasné tipy a nabídky (nepovinné).</span>
            </label>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              ZOBRAZIT STUDII (PDF) →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/50 p-3">Děkujeme! Pokud se studie neotevřela sama, <a href="#" class="study-pdf-link underline hover:text-brand-white/70" target="_blank" rel="noopener">otevřete ji tímto odkazem</a>.</p>
            <p class="font-mono text-[11px] text-brand-white/60 leading-relaxed">Studii vám zobrazíme na základě vaší žádosti. Jak nakládáme s údaji, popisují <a href="/zasady-osobnich-udaju/" class="underline hover:text-brand-white" target="_blank" rel="noopener">zásady zpracování osobních údajů</a>.</p>
          </form>
        </div>
      </dialog>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../../scripts/case-study';
</script>
