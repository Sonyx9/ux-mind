---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const fakta = [["METODA", "Eye-tracking experiment"], ["VZOREK", "N = 104"], ["MANIPULACE", "Směr pohledu postavy"], ["STATISTIKA", "F(1,102) = 12,57 · p < 0,001"]];
const zjisteni = ["Silný statistický efekt manipulace vizuálního vodítka: F(1,102) = 12,57; p < 0,001.", "Velikost efektu ηp² = 0,11 — středně velký efekt: rozdíl, který v praxi poznáte.", "Směr pohledu je jeden z nejlevnějších nástrojů, jak vést pozornost ke sdělení a CTA — nevyžaduje změnu layoutu, jen kompozice."];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "Kam se dívá postava na banneru, tam se dívá i váš zákazník",
    about: 'Eye tracking, UX výzkum',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'cs',
  },
];
---

<BaseLayout
  title="Case study: směr pohledu na banneru (ηp² = 0,11)"
  description="Eye tracking experiment N = 104: směr pohledu postavy na banneru silně ovlivňuje rozložení pozornosti — F(1,102) = 12,57; p < 0,001; ηp² = 0,11."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/pripadove-studie" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← VŠECHNY STUDIE</a>

      <!-- Hlavička studie -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Reklamní kreativa</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-4xl" style="font-size: clamp(2rem, 4.5vw, 3.4rem);">
          Kam se dívá postava na banneru, tam se dívá i váš zákazník<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Statistický banner -->
      <div class="bg-brand-black text-brand-white p-8 md:p-12 mb-16 flex flex-col md:flex-row md:items-center gap-6 md:gap-12">
        <p class="font-display font-bold leading-none tracking-tight whitespace-nowrap" style="font-size: clamp(3rem, 8vw, 6.5rem);">ηp² = 0,11</p>
        <p class="text-brand-white/70 text-lg leading-relaxed max-w-md">středně velký efekt směru pohledu postavy na rozložení pozornosti</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Obsah -->
        <div class="lg:col-span-2">

          <section class="mb-12">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— KONTEXT</span></p>
            <p class="text-lg text-brand-black/80 leading-relaxed">Kompozice s lidskou tváří patří k nejsilnějším prvkům reklamní kreativy. Tvář ale pozornost nejen přitahuje — umí ji i předat dál. Testovali jsme, jak silný tento efekt je a zda se dá spolehlivě využít.</p>
          </section>

          <section class="mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— OBCHODNÍ OTÁZKA</span></p>
            <p class="font-display text-2xl font-bold leading-snug">Dokáže směr pohledu postavy na kreativě systematicky vést pozornost diváka ke sdělení?</p>
          </section>

          <section class="mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— MĚŘENÍ</span></p>
            <p class="text-brand-black/70 leading-relaxed">Eye-tracking experiment s manipulací vizuálního vodítka: varianty kreativy se lišily směrem pohledu postavy, měřilo se rozložení pozornosti mezi tváří, sdělením a produktem.</p>
          </section>

          <section class="mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">04</span> <span class="text-brand-black/60">— CO DATA UKÁZALA</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/50 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ DATA V OBRAZE ]</p>
              <svg viewBox="0 0 640 300" class="w-full" role="img" aria-label="Ilustrační schéma: směr pohledu postavy vede pozornost diváka">
  <text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">ILUSTRAČNÍ SCHÉMA EFEKTU · VLASTNÍ DEMO STIMUL</text>
  <g>
    <rect x="0" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <circle cx="70" cy="110" r="26" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <circle cx="62" cy="105" r="3" fill="#0A0A0A"/><circle cx="80" cy="105" r="3" fill="#0A0A0A"/>
    <rect x="200" y="140" width="70" height="46" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <circle cx="70" cy="110" r="44" fill="#2D62FC" opacity="0.25"/>
    <text x="8" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">POHLED DO KAMERY</text>
    <text x="8" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">pozornost zůstává na tváři</text>
  </g>
  <g>
    <rect x="340" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <circle cx="410" cy="110" r="26" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <circle cx="424" cy="108" r="3" fill="#0A0A0A"/><circle cx="432" cy="112" r="3" fill="#0A0A0A"/>
    <line x1="440" y1="118" x2="530" y2="152" stroke="#2D62FC" stroke-width="2" stroke-dasharray="4 4"/>
    <rect x="540" y="140" width="70" height="46" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <circle cx="575" cy="163" r="44" fill="#2D62FC" opacity="0.25"/>
    <text x="348" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">POHLED NA PRODUKT</text>
    <text x="348" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">pozornost následuje směr pohledu</text>
  </g>
  <text x="0" y="296" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">EFEKT VODÍTKA: F(1,102) = 12,57 · p &lt; 0,001 · ηp² = 0,11 (STŘEDNĚ VELKÝ EFEKT)</text>
</svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">Schéma principu na vlastním demo stimulu: modrá plocha znázorňuje těžiště pozornosti. Statistika pochází z reálného měření.</p>
          </section>

          <section class="mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— CO SE ROZHODLO</span></p>
            <p class="text-brand-black/70 leading-relaxed">Postavy na kreativách orientovat pohledem směrem ke klíčovému sdělení nebo CTA, nikoli do kamery.</p>
          </section>

          <section class="border border-brand-black p-8">
            <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-4">CO BY DNES PŘIDALO EMLI</p>
            <p class="text-brand-black/70 leading-relaxed">U podobného zadání dnes navíc měříme kognitivní zátěž zpracování kreativy — zda vodítko sdělení jen zviditelní, nebo i usnadní jeho zpracování.</p>
          </section>
        </div>

        <!-- Fakta + foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">FAKTA MĚŘENÍ</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/jan-petruzalek-analyza-eye-tracking-dat.webp`}
                alt="Analýza eye-tracking dat — heatmapy a mimické záznamy v softwaru iMotions"
                width="1080" height="720" loading="lazy" decoding="async"
                class="w-full h-52 object-cover border border-brand-black/10"
              />
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Analýza eye-tracking dat — heatmapy a mimické záznamy v softwaru iMotions</figcaption>
            </figure>
            <a href="/kontakt" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              NEZÁVAZNÁ POPTÁVKA →
            </a>
          </div>
        </aside>
      </div>

      <!-- Navigace mezi studiemi -->
      <nav class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Další případové studie">
        <a href="/pripadove-studie/produktove-fotografie-e-commerce" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/60 tracking-widest mb-2">← PŘEDCHOZÍ STUDIE</p>
          <p class="font-display font-bold leading-snug">Fotka „na člověku“ vypadá lépe. Ale zpomalila nákup.</p>
        </a>
        <a href="/pripadove-studie/sablony-e-shopu" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/60 tracking-widest mb-2">DALŠÍ STUDIE →</p>
          <p class="font-display font-bold leading-snug">Tři šablony, stejný sortiment. Rozhodl úkol.</p>
        </a>
      </nav>

      <!-- Závěrečné CTA -->
      <div class="bg-brand-black text-brand-white text-center p-10 md:p-14 mt-10">
        <h2 class="font-display text-3xl md:text-4xl font-bold mb-8">Porovnat dvě varianty kreativy<span style="color:#2D62FC">.</span></h2>
        <a href="/kontakt" class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          NEZÁVAZNÁ POPTÁVKA →
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
