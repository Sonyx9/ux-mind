---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pageSchema = [
  {
    '@type': 'Article',
    headline: 'Kam se dívá postava na banneru, tam se dívá i váš zákazník.',
    about: 'Eye tracking, UX výzkum',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'cs',
  },
];
---

<BaseLayout
  title='Case study: směr pohledu na banneru (ηp² = 0,11)'
  description='Eye tracking experiment N = 104: směr pohledu postavy na banneru silně ovlivňuje rozložení pozornosti — F(1,102) = 12,57; p < 0,001; ηp² = 0,11.'
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-4xl mx-auto px-6">

      <a href="/pripadove-studie" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← VŠECHNY STUDIE</a>

      <div class="mt-8 mb-14">
        <div class="flex flex-col gap-2 md:flex-row md:justify-between md:items-start mb-6">
          <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5 self-start">Reklamní kreativa</span>
          <span class="font-display text-3xl font-bold text-brand-black/10 leading-none">ηp² = 0,11</span>
        </div>
        <h1 class="font-display font-bold leading-tight tracking-tight" style="font-size: clamp(1.9rem, 4.5vw, 3.2rem);">
          Kam se dívá postava na banneru, tam se dívá i váš zákazník.
        </h1>
      </div>

      <section class="mb-12">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ OBCHODNÍ OTÁZKA ]</p>
        <p class="text-lg text-brand-black/80 leading-relaxed">Dokáže směr pohledu postavy na kreativě systematicky vést pozornost diváka ke sdělení?</p>
      </section>

      <section class="mb-12">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ MĚŘENÍ ]</p>
        <p class="text-brand-black/70 leading-relaxed">Eye-tracking experiment s manipulací vizuálního vodítka, N = 104.</p>
      </section>

      <section class="mb-12">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CO DATA UKÁZALA ]</p>
        <div class="space-y-4">
          {["Silný statistický efekt manipulace vizuálního vodítka: F(1,102) = 12,57; p < 0,001.", "Velikost efektu ηp² = 0,11 — středně velký efekt: rozdíl, který v praxi poznáte.", "Směr pohledu je jeden z nejlevnějších nástrojů, jak vést pozornost ke sdělení a CTA — nevyžaduje změnu layoutu, jen kompozice."].map(item => (
            <div class="flex gap-4 items-start">
              <span class="font-mono text-xs text-brand-black/40 mt-1.5 shrink-0">→</span>
              <p class="text-brand-black/80 leading-relaxed">{item}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-12">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ CO SE ROZHODLO ]</p>
        <p class="text-brand-black/70 leading-relaxed">Postavy na kreativách orientovat pohledem směrem ke klíčovému sdělení nebo CTA, nikoli do kamery.</p>
      </section>

      <section class="mb-16 border border-brand-black p-8">
        <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-4">CO BY DNES PŘIDALO EMLI</p>
        <p class="text-brand-black/70 leading-relaxed">U podobného zadání dnes navíc měříme kognitivní zátěž zpracování kreativy — zda vodítko sdělení jen zviditelní, nebo i usnadní jeho zpracování.</p>
      </section>

      <div class="text-center py-12 border-t border-brand-black/10">
        <h2 class="font-display text-3xl font-bold mb-8">Porovnat dvě varianty kreativy</h2>
        <a href="/kontakt" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
          NEZÁVAZNÁ POPTÁVKA →
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
