---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const fakta = [["METODA", "Eye-trackingový experiment"], ["VZOREK", "104 respondentů"], ["PROMĚNNÁ", "Směr pohledu postavy"], ["STATISTIKA", "F(1,102) = 12,57 · p < 0,001 · ηp² = 0,11"]];
const zjisteni = ["Změna směru pohledu postavy statisticky významně ovlivnila rozložení vizuální pozornosti: F(1,102) = 12,57; p < 0,001.", "Velikost efektu ηp² = 0,11 odpovídá podle běžně používaných orientačních hranic středně velkému efektu.", "Kompozice postavy tedy v testovaných kreativách fungovala jako vizuální vodítko. Studie však neměřila kliknutí, zapamatování sdělení ani konverzi."];
const faq = [
  { q: "Ovlivnil směr pohledu postavy pozornost?", a: "Ano, v testovaných kreativách a na vzorku 104 respondentů se rozložení pozornosti mezi variantami statisticky významně lišilo: p < 0,001; ηp² = 0,11." },
  { q: "Znamená to, že máme postavu vždy otočit k CTA?", a: "Ne automaticky. Výsledek podporuje směr pohledu jako relevantní proměnnou kompozice. Vhodná varianta závisí na konkrétní fotografii, sdělení, formátu a cíli kreativy, proto doporučujeme porovnat reálné návrhy." },
  { q: "Prokázala studie více kliknutí nebo konverzí?", a: "Ne. Studie měřila rozložení vizuální pozornosti, nikoli kliknutí, zapamatování, nákup nebo jinou obchodní metriku. Přesun pozornosti je důležitý mezikrok, ale sám o sobě nezaručuje akci." },
  { q: "Co znamená ηp² = 0,11?", a: "Parciální eta kvadrát popisuje velikost efektu v použitém statistickém modelu. Hodnota 0,11 se podle běžných orientačních hranic interpretuje jako středně velký efekt; neznamená však automaticky 11% nárůst výkonu kampaně." },
  { q: "Co znamená p < 0,001?", a: "Pokud by směr pohledu ve skutečnosti neměl v použitém modelu žádný efekt a byly splněny jeho předpoklady, stejně nebo více výrazný výsledek by byl velmi neobvyklý. Hodnota p sama nepopisuje velikost ani obchodní hodnotu efektu." },
  { q: "Musíme kvůli testu předělat celou kreativu?", a: "Ne nutně. Často stačí připravit kontrolované varianty fotografie, ořezu nebo polohy postavy. Ostatní prvky by měly zůstat co nejpodobnější, aby šel rozdíl smysluplně interpretovat." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "Pohled postavy nasměroval pozornost návštěvníků.",
    about: 'Eye tracking, UX výzkum',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'cs',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Case study: Jak směr pohledu ovlivnil pozornost"
  description="Eye-trackingový experiment se 104 respondenty: změna směru pohledu postavy ovlivnila rozložení pozornosti, F(1,102) = 12,57; p < 0,001; ηp² = 0,11."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/pripadove-studie" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← VŠECHNY STUDIE</a>

      <!-- Hlavička studie -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Reklamní kreativa</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          Pohled postavy nasměroval pozornost návštěvníků<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Hlavní výsledky -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-1 md:grid-cols-3">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative p-7 md:p-9 border-t-4 border-t-brand-blue border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-mono text-xs tracking-widest text-brand-white/60 mb-5">SMĚR POHLEDU</p>
          <p class="font-display text-2xl md:text-3xl font-bold leading-tight">Změnil rozložení pozornosti</p>
        </div>
        <div class="relative p-7 md:p-9 border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">104</p>
          <p class="text-brand-white/70 leading-relaxed">respondentů v experimentu</p>
        </div>
        <div class="relative p-7 md:p-9">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.2rem, 4.5vw, 4rem);">ηp² = 0,11</p>
          <p class="text-brand-white/70 leading-relaxed">středně velký efekt · p &lt; 0,001</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Obsah -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— CO DATA UKÁZALA</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— CO BYLO POTŘEBA ZJISTIT</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">Změní směr pohledu postavy rozložení pozornosti v kreativě?</p>
            <p class="text-brand-black/70 leading-relaxed">Lidská tvář v reklamě přitahuje pozornost. Experiment ověřoval, zda změna směru pohledu postavy ovlivní také to, jak respondenti rozdělí pozornost mezi tvář a další části testované kreativy.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— JAK PROBĚHLO MĚŘENÍ</span></p>
            <p class="text-brand-black/70 leading-relaxed">Eye-trackingového experimentu se zúčastnilo 104 respondentů. Varianty kreativy se lišily směrem pohledu postavy a analýza porovnávala rozložení vizuální pozornosti mezi předem vyznačenými oblastmi.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ PRINCIP TESTOVANÝCH VARIANT ]</p>
              <svg viewBox="0 0 640 300" class="w-full" role="img" aria-label="Ilustrační schéma: směr pohledu postavy vede pozornost diváka">
  <text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">ILUSTRAČNÍ SCHÉMA VARIANT · NEJDE O HEATMAPU</text>
  <g>
    <rect x="0" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <circle cx="70" cy="110" r="26" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <circle cx="62" cy="105" r="3" fill="#0A0A0A"/><circle cx="80" cy="105" r="3" fill="#0A0A0A"/>
    <rect x="200" y="140" width="70" height="46" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <text x="8" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">POHLED DO KAMERY</text>
    <text x="8" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">varianta kompozice A</text>
  </g>
  <g>
    <rect x="340" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <circle cx="410" cy="110" r="26" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <circle cx="424" cy="108" r="3" fill="#0A0A0A"/><circle cx="432" cy="112" r="3" fill="#0A0A0A"/>
    <line x1="440" y1="118" x2="530" y2="152" stroke="#2D62FC" stroke-width="2" stroke-dasharray="4 4"/>
    <rect x="540" y="140" width="70" height="46" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <text x="348" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">POHLED NA PRODUKT</text>
    <text x="348" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">varianta kompozice B</text>
  </g>
  <text x="0" y="296" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">EFEKT VODÍTKA: F(1,102) = 12,57 · p &lt; 0,001 · ηp² = 0,11 (STŘEDNĚ VELKÝ EFEKT)</text>
</svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">Schéma pouze vysvětluje manipulovanou proměnnou. Nezobrazuje skutečné stimuly ani heatmapu účastníků; statistika pochází z reálného měření.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— DOPORUČENÍ PRO PRAXI</span></p>
            <p class="text-brand-black/70 leading-relaxed">Směr pohledu zahrnout mezi proměnné při návrhu a testování kreativy. Pokud má postava podpořit pozornost konkrétního sdělení nebo produktu, připravit kontrolované varianty a ověřit je společně s metrikami kampaně.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ CO SI Z TOHO ODNÉST ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">I malá změna kompozice může změnit rozložení pozornosti<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">Eye tracking pomůže vybrat variantu podle toho, co lidé skutečně zaznamenají. Dopad na kliknutí nebo konverzi je potřeba ověřit navazujícími daty.</p>
            <a href="/kontakt" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">PROBRAT TEST KREATIVY →</a>
          </section>
        </div>

        <!-- Fakta + foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">STUDIE VZNIKLA VE SPOLUPRÁCI S</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Fakulta informatiky a managementu"
                title="Studie vznikla ve spolupráci s FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">FAKTA MĚŘENÍ</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/laborator-ux-vyzkumu-vizualizace-1.webp`}
                alt="Vizualizace testovacího pracoviště laboratoře — oddělené boxy s pracovními stanicemi"
                width="1080" height="720" loading="lazy" decoding="async"
                class="w-full h-52 object-cover border border-brand-black/10"
              />
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Vizualizace testovacích boxů, kde probíhá měření kreativ bez rušení</figcaption>
            </figure>
            <a href="/kontakt" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              NEZÁVAZNÁ POPTÁVKA →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ SLOVNÍK — CO ZNAMENAJÍ POJMY V TÉTO STUDII ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">N (vzorek)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Počet lidí zahrnutých do analýzy. V této studii N = 104.</dd></div>
            <div><dt class="font-display font-bold mb-1">F(1,102)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Hodnota testové statistiky a její stupně volnosti v použitém statistickém testu.</dd></div>
            <div><dt class="font-display font-bold mb-1">p-hodnota</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Pomáhá posoudit, nakolik jsou data slučitelná s předpokladem, že směr pohledu neměl v použitém modelu žádný efekt.</dd></div>
            <div><dt class="font-display font-bold mb-1">ηp²</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Parciální eta kvadrát vyjadřuje velikost efektu v daném statistickém modelu. Není to procento zvýšení výkonu kampaně.</dd></div>
          </dl>
        </details>
      </section>

      <!-- FAQ ke studii -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ ČASTÉ DOTAZY KE STUDII ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Úzký pruh: kompletní studie (otevírá modal) -->
      <section class="reveal mt-16 !hidden bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Chcete projít studii podrobněji<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">PODROBNÝ REPORT S METODIKOU A DOPORUČENÍMI — ZDARMA V PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          VYŽÁDAT STUDII →
        </button>
      </section>

      <!-- Navigace mezi studiemi -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Další případové studie">
        <a href="/pripadove-studie/produktove-fotografie-e-commerce" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← PŘEDCHOZÍ STUDIE</p>
          <p class="font-display font-bold leading-snug">Stejný produkt. Jinak dlouhé rozhodování</p>
        </a>
        <a href="/pripadove-studie/sablony-e-shopu" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">DALŠÍ STUDIE →</p>
          <p class="font-display font-bold leading-snug">Úkol změnil, kam lidé zaměřili pozornost.</p>
        </a>
      </nav>

    </div>

      <!-- Modal: žádost o kompletní studii -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ PODROBNÁ STUDIE ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Zavřít okno">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Chcete projít studii podrobněji<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Studie jsou zkráceny a anonymizovány.</p>
          <form class="study-request space-y-4" data-pdf="https://lukaskoula.com" data-study="Pohled postavy nasměroval pozornost návštěvníků.">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">JMÉNO *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Vaše jméno"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">FIRMA</label>
              <input type="text" id="sr-company" name="company" placeholder="Název firmy (nepovinné)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="vas@email.cz"
                class="study-input" />
            </div>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              ZOBRAZIT STUDII (PDF) →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/50 p-3">Děkujeme! Pokud se studie neotevřela sama, <a href="#" class="study-pdf-link underline hover:text-brand-white/70" target="_blank" rel="noopener">otevřete ji tímto odkazem</a>.</p>
            <p class="font-mono text-[11px] text-brand-white/70 leading-relaxed">Odesláním souhlasíte se zobrazením studie a zasíláním občasných obchodních nabídek UX MIND. Odhlásit se můžete kdykoli jedním kliknutím.</p>
          </form>
        </div>
      </dialog>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../../scripts/case-study';
</script>
