---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const fakta = [["METODA", "Experiment · eye-tracking + UEQ"], ["VZOREK", "84 respondentů"], ["STIMULY", "Packshot vs. lifestyle fotografie"], ["STATISTIKA", "p = 0,037 · 3,7% šance na náhodu"]];
const zjisteni = ["Typ fotografie prokazatelně ovlivnil dobu plnění úkolu: F(1,82) = 4,50; p = 0,037 — šance, že jde o náhodu, je jen 3,7 %.", "Produkt „na člověku“ vedl k delšímu plnění úkolu než čistý packshot.", "Dopad na subjektivní hodnocení UX se jednoznačně nepotvrdil — „líbivější“ ≠ „výkonnější“."];
const faq = [
  { q: "Je lepší packshot, nebo lifestyle fotografie?", a: "Záleží na cíli stránky. V měření s 84 respondenty prodloužila lifestyle fotografie dobu nákupního rozhodování (p = 0,037). Pro úkolový výběr a porovnání se hodí packshot, pro inspirační stránky lifestyle." },
  { q: "Co znamená p = 0,037?", a: "Pravděpodobnost, že by naměřený rozdíl vznikl náhodou, je jen 3,7 %. Vše pod 5 % se považuje za statisticky průkazné." },
  { q: "Ovlivnil typ fotky i to, jak se stránka líbila?", a: "Jednoznačně ne — dopad na subjektivní hodnocení UX se nepotvrdil. „Líbivější“ neznamená „výkonnější“." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "Fotka „na člověku“ vypadá lépe. Ale zpomalila nákup.",
    about: 'Eye tracking, UX výzkum',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'cs',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Case study: produktová fotka vs. výkon (p = 0,037)"
  description="Eye tracking experiment N = 84: lifestyle fotografie signifikantně prodloužila plnění nákupního úkolu (p = 0,037). Líbivější neznamená výkonnější."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/pripadove-studie" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← VŠECHNY STUDIE</a>

      <!-- Hlavička studie -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">E-commerce</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-4xl" style="font-size: clamp(2rem, 4.5vw, 3.4rem);">
          Fotka „na člověku“ vypadá lépe. Ale zpomalila nákup<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Statistický banner -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white p-8 md:p-12 mb-16 flex flex-col md:flex-row md:items-center gap-6 md:gap-12">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <p class="relative font-display font-bold leading-none tracking-tight whitespace-nowrap" style="font-size: clamp(3rem, 8vw, 6.5rem);">p = 0,037</p>
        <div class="relative max-w-md"><p class="text-brand-white/70 text-lg leading-relaxed max-w-md">signifikantně delší nákupní rozhodování u lifestyle fotografie</p><p class="font-mono text-xs text-brand-white/60 leading-relaxed mt-3">p = pravděpodobnost, že rozdíl vznikl náhodou. Hodnota 0,037 znamená jen 3,7% šanci — výsledek je statisticky průkazný.</p></div>
      </div>

      <section class="reveal mb-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ SLOVNÍK — CO ZNAMENAJÍ ČÍSLA V TÉTO STUDII ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 space-y-4">
            <div><dt class="font-display font-bold mb-1">N (vzorek)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Počet skutečných lidí, kteří se měření zúčastnili. N = 102 znamená 102 respondentů.</dd></div>
            <div><dt class="font-display font-bold mb-1">p-hodnota</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Pravděpodobnost, že by naměřený rozdíl vznikl čirou náhodou. Čím menší, tím průkaznější výsledek — p = 0,037 znamená jen 3,7% šanci na náhodu (za průkazné se považuje vše pod 5 %).</dd></div>
            <div><dt class="font-display font-bold mb-1">Velikost efektu (ηp²)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Říká, jak velký je rozdíl v praxi — ne jen jestli existuje. Orientačně: 0,01 malý, 0,06 střední, 0,14 velký efekt.</dd></div>
            <div><dt class="font-display font-bold mb-1">Fixace</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Krátké zastavení oka na jednom místě (zlomky sekundy). Ze sledu fixací se skládá vše, co člověk na stránce skutečně „viděl“.</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI (sledovaná oblast)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Předem vyznačená část stránky — tlačítko, nadpis, fotografie — pro kterou měříme, kolik pozornosti dostala.</dd></div>
            <div><dt class="font-display font-bold mb-1">UEQ / VisAWI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Standardizované vědecké dotazníky: UEQ měří celkový uživatelský zážitek, VisAWI vnímanou estetiku webu. Díky standardizaci jsou výsledky porovnatelné mezi studiemi.</dd></div>
          </dl>
        </details>
      </section>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Obsah -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— KONTEXT</span></p>
            <p class="text-lg text-brand-black/80 leading-relaxed">Volba mezi čistým packshotem a lifestyle fotografií patří k nejčastějším sporům mezi brand týmem a výkonnostním marketingem. Obě strany mají „svá“ data — my jsme spor rozhodli kontrolovaným experimentem.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— OBCHODNÍ OTÁZKA</span></p>
            <p class="font-display text-2xl font-bold leading-snug">Packshot, nebo lifestyle fotka? Většina e-shopů rozhoduje vkusem. My jsme to změřili.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— MĚŘENÍ</span></p>
            <p class="text-brand-black/70 leading-relaxed">Kontrolovaný experiment v e-commerce prostředí: respondenti plnili nákupní úkoly nad variantami produktových stránek, měřeno eye-trackingem a doplněno dotazníkem UEQ — standardizovaným nástrojem pro měření uživatelského zážitku.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">04</span> <span class="text-brand-black/60">— CO DATA UKÁZALA</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/50 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ DATA V OBRAZE ]</p>
              <svg viewBox="0 0 640 330" class="w-full" role="img" aria-label="Rozhodovací matice: typ fotografie podle cíle stránky">
  <text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">ROZHODOVACÍ MATICE · TYP FOTKY PODLE CÍLE STRÁNKY</text>
  <text x="230" y="52" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">INSPIRACE</text>
  <text x="440" y="52" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">RYCHLÝ VÝBĚR</text>
  <text x="8" y="130" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">LIFESTYLE</text>
  <text x="8" y="240" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">PACKSHOT</text>
  <g stroke="rgba(10,10,10,0.25)" fill="none">
    <rect x="120" y="65" width="240" height="110"/><rect x="360" y="65" width="240" height="110"/>
    <rect x="120" y="175" width="240" height="110"/><rect x="360" y="175" width="240" height="110"/>
  </g>
  <text x="240" y="125" font-family="monospace" font-size="26" font-weight="bold" fill="#2D62FC" text-anchor="middle">✓</text>
  <text x="480" y="235" font-family="monospace" font-size="26" font-weight="bold" fill="#2D62FC" text-anchor="middle">✓</text>
  <text x="480" y="125" font-family="monospace" font-size="20" fill="rgba(10,10,10,0.3)" text-anchor="middle">×</text>
  <text x="240" y="235" font-family="monospace" font-size="20" fill="rgba(10,10,10,0.3)" text-anchor="middle">×</text>
  <text x="0" y="318" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">SIGNIFIKANTNÍ EFEKT NA DOBU ÚKOLU: F(1,82) = 4,50 · p = 0,037 · N = 84</text>
</svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">Praktický závěr studie jako matice: lifestyle fotka pro inspirační stránky, packshot pro úkolový výběr a porovnání.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— CO SE ROZHODLO</span></p>
            <p class="text-brand-black/70 leading-relaxed">Typ fotografie volit podle cíle stránky: inspirace vs. rychlé porovnání a úkolový výběr. Testovat v kontextu úlohy, ne izolovaně.</p>
          </section>

          <section class="reveal border border-brand-black p-8">
            <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-4">CO BY DNES PŘIDALO EMLI</p>
            <p class="text-brand-black/70 leading-relaxed">U podobného zadání dnes navíc měříme, zda delší čas u lifestyle fotek znamená příjemné prohlížení, nebo skutečnou kognitivní zátěž při hledání parametrů — přesně tento typ nejednoznačnosti index EMLI adresuje.</p>
          </section>
        </div>

        <!-- Fakta + foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">STUDIE VZNIKLA VE SPOLUPRÁCI S</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Fakulta informatiky a managementu"
                title="Studie vznikla ve spolupráci s FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">FAKTA MĚŘENÍ</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <div class="border border-brand-black/10 p-4 bg-brand-white">
                <svg viewBox="0 0 320 210" class="w-full" role="img" aria-label="Schéma dvou variant produktové stránky: packshot a lifestyle fotografie">
                  <rect x="4" y="4" width="150" height="170" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="24" y="24" width="110" height="90" fill="rgba(10,10,10,0.06)"/>
                  <rect x="62" y="40" width="34" height="58" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="70" y="32" width="18" height="10" fill="#0A0A0A"/>
                  <rect x="24" y="126" width="70" height="7" fill="rgba(10,10,10,0.35)"/>
                  <rect x="24" y="140" width="46" height="7" fill="#2D62FC"/>
                  <text x="4" y="196" font-family="monospace" font-size="11" fill="#0A0A0A">PACKSHOT</text>
                  <rect x="166" y="4" width="150" height="170" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="186" y="24" width="110" height="90" fill="rgba(10,10,10,0.06)"/>
                  <circle cx="222" cy="52" r="14" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <path d="M 200 114 Q 222 76 244 114" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="256" y="62" width="20" height="36" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="186" y="126" width="70" height="7" fill="rgba(10,10,10,0.35)"/>
                  <rect x="186" y="140" width="46" height="7" fill="rgba(10,10,10,0.2)"/>
                  <text x="166" y="196" font-family="monospace" font-size="11" fill="#0A0A0A">LIFESTYLE</text>
                </svg>
              </div>
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Schéma testovaných variant: čistý packshot vs. produkt „na člověku“</figcaption>
            </figure>
            <a href="/kontakt" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              NEZÁVAZNÁ POPTÁVKA →
            </a>
          </div>
        </aside>
      </div>

      <!-- FAQ ke studii -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ ČASTÉ DOTAZY KE STUDII ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Úzký pruh: kompletní studie (otevírá modal) -->
      <section class="reveal mt-16 bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Chcete projít celou studii<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/60 tracking-wide mt-1">KOMPLETNÍ REPORT S METODIKOU A DOPORUČENÍMI — ZDARMA E-MAILEM</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          VYŽÁDAT STUDII →
        </button>
      </section>

      <!-- Navigace mezi studiemi -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Další případové studie">
        <a href="/pripadove-studie/backend-stories" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/60 tracking-widest mb-2">← PŘEDCHOZÍ STUDIE</p>
          <p class="font-display font-bold leading-snug">92 % pohledů skončilo na hlavním CTA</p>
        </a>
        <a href="/pripadove-studie/reklamni-bannery-smer-pohledu" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/60 tracking-widest mb-2">DALŠÍ STUDIE →</p>
          <p class="font-display font-bold leading-snug">Kam se dívá postava na banneru, tam se dívá i váš zákazník</p>
        </a>
      </nav>

      <!-- Závěrečné CTA -->
      <div class="reveal bg-brand-black text-brand-white text-center p-10 md:p-14 mt-10">
        <h2 class="font-display text-3xl md:text-4xl font-bold mb-8">Porovnat varianty produktové prezentace<span style="color:#2D62FC">.</span></h2>
        <a href="/kontakt" class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          NEZÁVAZNÁ POPTÁVKA →
        </a>
      </div>
    </div>

      <!-- Modal: žádost o kompletní studii -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest">[ KOMPLETNÍ STUDIE ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/60 transition-colors" aria-label="Zavřít okno">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Chcete projít celou studii<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Kompletní report včetně metodiky, grafů a prioritizovaných doporučení zasíláme e-mailem do 24 hodin.</p>
          <form class="study-request space-y-4" data-study="Fotka „na člověku“ vypadá lépe. Ale zpomalila nákup.">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/60 tracking-widest block mb-2">JMÉNO *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Vaše jméno"
                class="w-full border border-brand-white/30 px-4 py-3 font-sans text-base bg-transparent text-brand-white placeholder:text-brand-white/40 focus:outline-none focus:border-brand-white transition-colors" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/60 tracking-widest block mb-2">FIRMA</label>
              <input type="text" id="sr-company" name="company" placeholder="Název firmy (nepovinné)"
                class="w-full border border-brand-white/30 px-4 py-3 font-sans text-base bg-transparent text-brand-white placeholder:text-brand-white/40 focus:outline-none focus:border-brand-white transition-colors" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/60 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="vas@email.cz"
                class="w-full border border-brand-white/30 px-4 py-3 font-sans text-base bg-transparent text-brand-white placeholder:text-brand-white/40 focus:outline-none focus:border-brand-white transition-colors" />
            </div>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              VYŽÁDAT KOMPLETNÍ STUDII →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/30 p-3">Děkujeme! Otevřeli jsme vám e-mail s předvyplněnou žádostí — stačí odeslat a studii pošleme do 24 hodin.</p>
