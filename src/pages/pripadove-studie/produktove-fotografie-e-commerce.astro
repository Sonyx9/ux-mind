---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const fakta = [["METODA", "Experiment · eye tracking + UEQ"], ["VZOREK", "84 respondentů"], ["VARIANTY", "Packshot vs. lifestyle fotografie"], ["STATISTIKA", "F(1,82) = 4,50 · p = 0,037"]];
const zjisteni = ["Typ fotografie statisticky významně ovlivnil dobu plnění úkolu: F(1,82) = 4,50; p = 0,037.", "U varianty s produktem „na člověku“ trvalo splnění testovaného úkolu déle než u čistého packshotu.", "Studie neposkytla jednoznačný důkaz, že by se varianty lišily také v subjektivním hodnocení uživatelského zážitku."];
const faq = [
  { q: "Je lepší packshot, nebo lifestyle fotografie?", a: "Z jedné studie nelze určit univerzálně lepší typ fotografie. V testovaném úkolu vedla lifestyle varianta k delšímu času než packshot. Volbu je potřeba vztáhnout ke konkrétnímu produktu, stránce a cíli uživatele." },
  { q: "Co znamená p = 0,037?", a: "Pokud by mezi variantami ve skutečnosti nebyl rozdíl a byly splněny předpoklady použitého testu, stejně nebo více výrazný výsledek by se objevil přibližně ve 3,7 % opakování. Hodnota p sama neříká, jak velký je praktický nebo obchodní dopad." },
  { q: "Ovlivnil typ fotografie také hodnocení stránky?", a: "Studie neposkytla jednoznačný důkaz rozdílu v subjektivním hodnocení uživatelského zážitku. Delší čas proto nelze automaticky vysvětlit tím, že se jedna varianta lidem více nebo méně líbila." },
  { q: "Znamená delší čas nižší konverzi?", a: "Ne. Studie měřila dobu splnění konkrétního úkolu, nikoli dopad na reálnou konverzi nebo tržby. Pro takový závěr by bylo potřeba propojit výzkum s dalšími daty nebo navazujícím experimentem." },
  { q: "K čemu byl ve studii eye tracking?", a: "Eye tracking doplnil průběh úkolu o data o vizuální pozornosti. Hlavní popsaný rozdíl mezi variantami se však týká času splnění úkolu, proto ho nepřisuzujeme automaticky konkrétnímu vzorci pohledu bez další analýzy." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "Stejný produkt. Jinak dlouhé rozhodování.",
    about: 'Eye tracking, UX výzkum',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'cs',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Case study: packshot vs. lifestyle fotografie"
  description="Experiment s 84 respondenty: lifestyle fotografie vedla v testovaném e-commerce úkolu k delšímu času než čistý packshot, F(1,82) = 4,50; p = 0,037."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/pripadove-studie" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← VŠECHNY STUDIE</a>

      <!-- Hlavička studie -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">E-commerce</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          Stejný produkt. Jinak dlouhé rozhodování<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Hlavní výsledky -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-1 md:grid-cols-3">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative p-7 md:p-9 border-t-4 border-t-brand-blue border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-mono text-xs tracking-widest text-brand-white/60 mb-5">LIFESTYLE VARIANTA</p>
          <p class="font-display text-2xl md:text-3xl font-bold leading-tight">Delší čas splnění úkolu</p>
        </div>
        <div class="relative p-7 md:p-9 border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">84</p>
          <p class="text-brand-white/70 leading-relaxed">respondentů porovnávalo dvě varianty</p>
        </div>
        <div class="relative p-7 md:p-9">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.2rem, 4.5vw, 4rem);">p = 0,037</p>
          <p class="text-brand-white/70 leading-relaxed">statisticky významný rozdíl v době úkolu</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Obsah -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— CO DATA UKÁZALA</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— CO BYLO POTŘEBA ZJISTIT</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">Ovlivní způsob prezentace produktu průběh nákupního úkolu?</p>
            <p class="text-brand-black/70 leading-relaxed">Studie porovnávala čistý packshot s fotografií produktu „na člověku“. Cílem nebylo vybrat hezčí obrázek, ale ověřit, zda typ fotografie mění dobu potřebnou ke splnění stejného úkolu.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— JAK PROBĚHLO MĚŘENÍ</span></p>
            <p class="text-brand-black/70 leading-relaxed">Kontrolovaného experimentu se zúčastnilo 84 respondentů. Plnili e-commerce úkoly nad variantami produktové prezentace; průběh doplnila eye-trackingová data a standardizovaný dotazník UEQ pro subjektivní hodnocení uživatelského zážitku.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ CO STUDIE ŘÍKÁ — A CO NE ]</p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
                <div class="bg-brand-white p-6">
                  <p class="font-mono text-xs tracking-widest mb-4" style="color:#2D62FC">DOLOŽENO DATY</p>
                  <p class="text-brand-black/70 leading-relaxed">V testovaném úkolu vedla lifestyle fotografie k delšímu času než čistý packshot. Rozdíl byl statisticky významný.</p>
                </div>
                <div class="bg-brand-white p-6">
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">NELZE VYVODIT</p>
                  <p class="text-brand-black/70 leading-relaxed">Že lifestyle fotografie obecně snižuje konverzi, že je vždy horší nebo že ji uživatelé hodnotili lépe či hůře.</p>
                </div>
              </div>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">Výsledek se vztahuje ke konkrétním variantám, vzorku a testovanému e-commerce úkolu.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— DOPORUČENÍ PRO PRAXI</span></p>
            <p class="text-brand-black/70 leading-relaxed">Produktovou fotografii nevybírat jen podle dojmu. Ověřit ji na konkrétním úkolu, který má stránka podporovat, a dobu či průběh rozhodování posuzovat společně s chováním, pozorností a obchodními daty.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ CO SI Z TOHO ODNÉST ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">Stejný produkt může změnit způsob rozhodování podle toho, jak ho ukážete<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">Test variant pomůže vybrat fotografii podle úkolu zákazníka, ne podle preference týmu.</p>
            <a href="/kontakt" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">PROBRAT VLASTNÍ STUDII →</a>
          </section>
        </div>

        <!-- Fakta + foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">STUDIE VZNIKLA VE SPOLUPRÁCI S</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Fakulta informatiky a managementu"
                title="Studie vznikla ve spolupráci s FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">FAKTA MĚŘENÍ</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <div class="border border-brand-black/10 p-4 bg-brand-white">
                <svg viewBox="0 0 320 210" class="w-full" role="img" aria-label="Schéma dvou variant produktové stránky: packshot a lifestyle fotografie">
                  <rect x="4" y="4" width="150" height="170" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="24" y="24" width="110" height="90" fill="rgba(10,10,10,0.06)"/>
                  <rect x="62" y="40" width="34" height="58" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="70" y="32" width="18" height="10" fill="#0A0A0A"/>
                  <rect x="24" y="126" width="70" height="7" fill="rgba(10,10,10,0.35)"/>
                  <rect x="24" y="140" width="46" height="7" fill="#2D62FC"/>
                  <text x="4" y="196" font-family="monospace" font-size="11" fill="#0A0A0A">PACKSHOT</text>
                  <rect x="166" y="4" width="150" height="170" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="186" y="24" width="110" height="90" fill="rgba(10,10,10,0.06)"/>
                  <circle cx="222" cy="52" r="14" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <path d="M 200 114 Q 222 76 244 114" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="256" y="62" width="20" height="36" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="186" y="126" width="70" height="7" fill="rgba(10,10,10,0.35)"/>
                  <rect x="186" y="140" width="46" height="7" fill="rgba(10,10,10,0.2)"/>
                  <text x="166" y="196" font-family="monospace" font-size="11" fill="#0A0A0A">LIFESTYLE</text>
                </svg>
              </div>
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Schéma testovaných variant: čistý packshot vs. produkt „na člověku“</figcaption>
            </figure>
            <a href="/kontakt" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              NEZÁVAZNÁ POPTÁVKA →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ SLOVNÍK — CO ZNAMENAJÍ POJMY V TÉTO STUDII ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">N (vzorek)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Počet lidí zahrnutých do analýzy. V této studii N = 84.</dd></div>
            <div><dt class="font-display font-bold mb-1">F(1,82)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Hodnota testové statistiky a její stupně volnosti v použitém statistickém testu.</dd></div>
            <div><dt class="font-display font-bold mb-1">p-hodnota</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Pomáhá posoudit, nakolik jsou data slučitelná s předpokladem, že mezi variantami není rozdíl. Sama nepopisuje velikost dopadu.</dd></div>
            <div><dt class="font-display font-bold mb-1">UEQ</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Standardizovaný dotazník pro subjektivní hodnocení uživatelského zážitku.</dd></div>
          </dl>
        </details>
      </section>

      <!-- FAQ ke studii -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ ČASTÉ DOTAZY KE STUDII ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Úzký pruh: kompletní studie (otevírá modal) -->
      <section class="reveal mt-16 !hidden bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Chcete projít studii podrobněji<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">PODROBNÝ REPORT S METODIKOU A DOPORUČENÍMI — ZDARMA V PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          VYŽÁDAT STUDII →
        </button>
      </section>

      <!-- Navigace mezi studiemi -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Další případové studie">
        <a href="/pripadove-studie/backend-stories" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← PŘEDCHOZÍ STUDIE</p>
          <p class="font-display font-bold leading-snug">Čím delší text, tím méně pozornosti</p>
        </a>
        <a href="/pripadove-studie/reklamni-bannery-smer-pohledu" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">DALŠÍ STUDIE →</p>
          <p class="font-display font-bold leading-snug">Pohled postavy nasměroval pozornost návštěvníků</p>
        </a>
      </nav>

    </div>

      <!-- Modal: žádost o kompletní studii -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ PODROBNÁ STUDIE ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Zavřít okno">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Chcete projít studii podrobněji<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Studie jsou zkráceny a anonymizovány.</p>
          <form class="study-request space-y-4" data-pdf="" data-study="Stejný produkt. Jinak dlouhé rozhodování.">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">JMÉNO *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Vaše jméno"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">FIRMA</label>
              <input type="text" id="sr-company" name="company" placeholder="Název firmy (nepovinné)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="vas@email.cz"
                class="study-input" />
            </div>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              ZOBRAZIT STUDII (PDF) →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/50 p-3">Děkujeme! Pokud se studie neotevřela sama, <a href="#" class="study-pdf-link underline hover:text-brand-white/70" target="_blank" rel="noopener">otevřete ji tímto odkazem</a>.</p>
            <p class="font-mono text-[11px] text-brand-white/70 leading-relaxed">Odesláním souhlasíte se zobrazením studie a zasíláním občasných obchodních nabídek UX MIND. Odhlásit se můžete kdykoli jedním kliknutím.</p>
          </form>
        </div>
      </dialog>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../../scripts/case-study';
</script>
