---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const fakta = [["METODA", "Eye tracking + hodnoticí dotazník + TOP3"], ["VZOREK", "79 respondentů · 43 mužů, 36 žen · 17–25 let"], ["STIMULY", "16 návrhů · každý zobrazen 10 sekund"], ["VÝSTUPY", "Pořadí variant + metriky vizuální pozornosti"]];
const zjisteni = ["Všech šest nejlépe hodnocených návrhů mělo černé pozadí. Bílé varianty se soustředily ve spodní části pořadí.", "Vítězný návrh získal nejvyšší vážené skóre ve výběru TOP3 a zároveň nejlepší průměrné pořadí.", "Fixační metriky se mezi nejlépe a nejhůře hodnocenými variantami lišily jen málo. O pořadí proto nerozhodla samotná míra vizuální pozornosti.", "V dotazníku uvedlo 39 % žen a 16 % mužů, že jejich návštěvu sportovní akce ovlivňuje vizuální reklama. Jde o deklarovaný vliv, nikoli o změřenou změnu nákupního chování."];
const faq = [
  { q: "Znamená výsledek, že černý billboard funguje vždy lépe?", a: "Ne. Černé pozadí dominovalo v tomto souboru 16 návrhů pro konkrétní fotbalovou kampaň a cílovou skupinu. Výsledek nelze bez dalšího přenést na každou značku, sdělení nebo umístění." },
  { q: "Co přesně rozhodlo o vítězné variantě?", a: "Vítězný návrh získal nejlepší vážené skóre ve výběru TOP3 i nejlepší průměrné pořadí. Eye tracking pomohl popsat vizuální pozornost, ale samotné fixační metriky pořadí variant nevysvětlily." },
  { q: "Dokazuje 39 % vs. 16 %, že reklama více ovlivňuje ženy?", a: "Respondenti to uvedli v dotazníku, takže jde o deklarovaný vliv. Studie tím neprokazuje, že billboard skutečně změnil nákup vstupenek ani že pohlaví bylo příčinou rozdílu." },
  { q: "Proč kombinovat eye tracking s dotazníkem?", a: "Eye tracking ukáže, kam směřovala vizuální pozornost. Dotazník zachytí preference, srozumitelnost a záměr. V této studii právě jejich kombinace ukázala, že více pozornosti automaticky neznamená lepší hodnocení." },
  { q: "Lze podobně vybrat kreativu ještě před spuštěním kampaně?", a: "Ano. Několik finálních variant lze porovnat na cílové skupině ještě před produkcí a mediálním nasazením. Důležité je předem určit, podle jakého cíle se bude vítěz vybírat." },
  { q: "Měří podobná studie také prodej vstupenek?", a: "Ne automaticky. Laboratorní studie pomůže vybrat a vysvětlit kreativu. Skutečný dopad na návštěvnost nebo prodej je potřeba ověřit následnými daty z kampaně či terénním experimentem." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "Prvních šest míst patřilo černým billboardům.",
    about: 'Eye tracking, UX výzkum',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'cs',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Case study: Výběr billboardu pomocí eye trackingu"
  description="Eye tracking a hodnocení 16 návrhů billboardů u 79 respondentů: prvních šest míst obsadily černé varianty, samotné fixační metriky však vítěze neurčily."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/pripadove-studie" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← VŠECHNY STUDIE</a>

      <!-- Hlavička studie -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Sport marketing · venkovní reklama</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          Prvních šest míst patřilo černým billboardům<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Design studie -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-1 md:grid-cols-3">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative p-7 md:p-9 border-t-4 border-t-brand-blue border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">6/6</p>
          <p class="text-brand-white/70 leading-relaxed">nejlépe hodnocených variant mělo černé pozadí</p>
        </div>
        <div class="relative p-7 md:p-9 border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">16</p>
          <p class="text-brand-white/70 leading-relaxed">návrhů billboardu v porovnání</p>
        </div>
        <div class="relative p-7 md:p-9">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">79</p>
          <p class="text-brand-white/70 leading-relaxed">respondentů z cílové věkové skupiny</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Obsah -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— CO DATA UKÁZALA</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— CO BYLO POTŘEBA ROZHODNOUT</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">Který z 16 návrhů má jít do kampaně na podporu návštěvnosti stadionu?</p>
            <p class="text-brand-black/70 leading-relaxed">Fotbalový klub nechtěl vybírat jen podle názoru marketingového týmu. Varianty proto porovnal na mladých lidech z cílové skupiny a sledoval jejich pozornost i následné hodnocení.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— JAK PROBĚHLO MĚŘENÍ</span></p>
            <p class="text-brand-black/70 leading-relaxed">Každý z 79 respondentů viděl všech 16 návrhů po dobu 10 sekund. Eye tracking zaznamenal vizuální pozornost. Hodnoticí dotazník a výběr TOP3 doplnily celkové hodnocení, přehlednost a deklarovaný záměr navštívit utkání.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">04</span> <span class="text-brand-black/60">— JAK VÝSLEDEK ČÍST</span></p>
            <p class="text-brand-black/70 leading-relaxed">Studie vybrala vítěze mezi konkrétními návrhy. Neprokazuje, že černé pozadí obecně zvyšuje výkon každého billboardu. Stejně tak dotazníkový údaj 39 % vs. 16 % popisuje, co respondenti uvedli — nikoli skutečnou změnu prodeje vstupenek.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ DATA V OBRAZE ]</p>
              <svg viewBox="0 0 640 174" class="w-full" role="img" aria-label="V dotazníku uvedlo 39 procent žen a 16 procent mužů, že vizuální reklama ovlivňuje jejich návštěvu sportovní akce"><text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">DEKLAROVANÝ VLIV VIZUÁLNÍ REKLAMY · DOTAZNÍK · N = 79</text><text x="0" y="67" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">ŽENY</text><rect x="190" y="52" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="52" width="156" height="22" fill="#2D62FC" class="viz-bar"/><text x="346" y="67" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">39 %</text><text x="0" y="119" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">MUŽI</text><rect x="190" y="104" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="104" width="64" height="22" fill="#0A0A0A" class="viz-bar"/><text x="254" y="119" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">16 %</text></svg>
<svg viewBox="0 0 640 120" class="w-full mt-2" role="img" aria-label="Šest nejlépe hodnocených návrhů mělo černé pozadí, spodní shluk tvořily bílé varianty">
  <text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">HODNOCENÍ 16 NÁVRHŮ · TOP 6 vs SPODNÍ SHLUK</text>
  <g>
    <rect x="0" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="48" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="96" y="36" width="40" height="26" fill="#0A0A0A"/>
    <rect x="144" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="192" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="240" y="36" width="40" height="26" fill="#0A0A0A"/>
    <text x="292" y="54" font-family="monospace" font-size="11" fill="#0A0A0A">TOP 6 = ČERNÉ POZADÍ</text>
  </g>
  <g stroke="rgba(10,10,10,0.4)" fill="none">
    <rect x="0" y="76" width="40" height="26"/><rect x="48" y="76" width="40" height="26"/><rect x="96" y="76" width="40" height="26"/><rect x="144" y="76" width="40" height="26"/>
    <text x="196" y="94" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)" stroke="none">SPODNÍ SHLUK = BÍLÉ VARIANTY</text>
  </g>
</svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">Graf kombinuje pořadí testovaných variant s odpověďmi z dotazníku. Údaj 39 % vs. 16 % nevyjadřuje naměřený dopad kampaně na prodej vstupenek.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— DOPORUČENÍ PRO KAMPAŇ</span></p>
            <p class="text-brand-black/70 leading-relaxed">Pro další rozpracování vybrat vítěznou černou variantu a zachovat její jasnou hierarchii, výrazný nadpis a jeden hlavní cíl. Skutečný dopad kreativy následně vyhodnotit na datech z nasazené kampaně.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ CO SI Z TOHO ODNÉST ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">Pozornost a preference nejsou totéž<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">Eye tracking ukáže, co lidé vidí. Hodnocení variant doplní, kterou kreativu preferují. Pro výběr kampaně je potřeba číst oba výsledky společně.</p>
            <a href="/kontakt" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">PROBRAT TEST KREATIVY →</a>
          </section>
        </div>

        <!-- Fakta + foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">STUDIE VZNIKLA VE SPOLUPRÁCI S</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Fakulta informatiky a managementu"
                title="Studie vznikla ve spolupráci s FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">FAKTA MĚŘENÍ</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <div class="border border-brand-black/10 p-4 bg-brand-white">
                <svg viewBox="0 0 320 210" class="w-full" role="img" aria-label="Ilustrační schéma principu nejlépe hodnocených billboardů: černé pozadí s výrazným nadpisem">
                  <rect x="24" y="16" width="272" height="120" fill="#0A0A0A"/>
                  <rect x="48" y="44" width="130" height="14" fill="#FCFCFC"/>
                  <rect x="48" y="68" width="90" height="8" fill="rgba(252,252,252,0.5)"/>
                  <rect x="48" y="100" width="64" height="16" fill="#2D62FC"/>
                  <circle cx="248" cy="76" r="26" fill="none" stroke="rgba(252,252,252,0.6)" stroke-width="2"/>
                  <rect x="96" y="136" width="10" height="52" fill="#0A0A0A"/>
                  <rect x="214" y="136" width="10" height="52" fill="#0A0A0A"/>
                  <text x="24" y="204" font-family="monospace" font-size="11" fill="#0A0A0A">TOP 6: ČERNÉ POZADÍ · VÝRAZNÝ NADPIS</text>
                </svg>
              </div>
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Ilustrační schéma společného principu šesti nejlépe hodnocených variant</figcaption>
            </figure>
            <a href="/kontakt" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              NEZÁVAZNÁ POPTÁVKA →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ SLOVNÍK — JAK ČÍST VÝSLEDKY STUDIE ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">N (vzorek)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Počet lidí zahrnutých do studie. V tomto případě N = 79.</dd></div>
            <div><dt class="font-display font-bold mb-1">TOP3</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Výběr tří preferovaných variant. Pořadí a četnost voleb lze převést na vážené skóre.</dd></div>
            <div><dt class="font-display font-bold mb-1">Fixace</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Krátké zastavení oka v určité oblasti. Popisuje vizuální pozornost, ne automaticky porozumění, oblibu nebo nákup.</dd></div>
            <div><dt class="font-display font-bold mb-1">Deklarovaný vliv</dt><dd class="text-sm text-brand-black/70 leading-relaxed">To, co účastník uvedl v dotazníku. Nejde o přímo změřenou změnu jeho skutečného chování.</dd></div>
          </dl>
        </details>
      </section>

      <!-- FAQ ke studii -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ ČASTÉ DOTAZY KE STUDII ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Úzký pruh: kompletní studie (otevírá modal) -->
      <section class="reveal mt-16 !hidden bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Chcete projít studii podrobněji<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">PODROBNÝ REPORT S METODIKOU A DOPORUČENÍMI — ZDARMA V PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          VYŽÁDAT STUDII →
        </button>
      </section>

      <!-- Navigace mezi studiemi -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Další případové studie">
        <a href="/pripadove-studie/sablony-e-shopu" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← PŘEDCHOZÍ STUDIE</p>
          <p class="font-display font-bold leading-snug">Úkol změnil, kam lidé zaměřili pozornost.</p>
        </a>
        <a href="/pripadove-studie/karierni-portal-automotive" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">DALŠÍ STUDIE →</p>
          <p class="font-display font-bold leading-snug">40 % uchazečů nenašlo cestu k volným pozicím</p>
        </a>
      </nav>

    </div>

      <!-- Modal: žádost o kompletní studii -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ PODROBNÁ STUDIE ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Zavřít okno">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Chcete projít studii podrobněji<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Studie jsou zkráceny a anonymizovány.</p>
          <form class="study-request space-y-4" data-pdf="" data-study="Prvních šest míst patřilo černým billboardům.">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">JMÉNO *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Vaše jméno"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">FIRMA</label>
              <input type="text" id="sr-company" name="company" placeholder="Název firmy (nepovinné)"
