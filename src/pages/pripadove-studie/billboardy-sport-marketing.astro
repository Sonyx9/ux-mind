---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const fakta = [["METODA", "Eye-tracking + dotazník + TOP3"], ["VZOREK", "79 respondentů (43 mužů, 36 žen) · 17–25 let"], ["STIMULY", "16 návrhů á 10 sekund"], ["VÝSTUPY", "Žebříček variant, gender analýza"]];
const zjisteni = ["Jasná dominance černých návrhů: všech šest nejvýše hodnocených variant mělo černé pozadí, spodní shluk tvořily bílé varianty.", "Vítězná varianta dosáhla nejvyššího váženého skóre ve výběru TOP3 i nejlepší průměrné finální pozice.", "Nejsilnější insight: vizuální reklamou je ovlivněno 39 % žen vs. 16 % mužů. Ženy více řeší i komfortní faktory — počasí (78 % vs. 56 %) a čas výkopu (72 % vs. 56 %).", "Férový limit: fixační metriky TOP3 a nejhůře hodnocených variant se lišily jen minimálně — o vítězi rozhodla subjektivní preference a čitelnost, ne dramatický rozdíl v chování oka."];
const faq = [
  { q: "Jaké billboardy fungují nejlépe?", a: "V měření 16 návrhů na 79 respondentech jednoznačně vyhrály černé minimalistické varianty s výrazným nadpisem — všech šest nejlépe hodnocených mělo černé pozadí." },
  { q: "Působí venkovní reklama na muže a ženy stejně?", a: "Ne — vizuální reklamou je ovlivněno 39 % žen vs. 16 % mužů. Ženy více zohledňují i komfortní faktory, jako je počasí nebo čas výkopu." },
  { q: "Rozhodly o vítězi oční metriky?", a: "Ne — fixační metriky se mezi variantami lišily minimálně; rozhodla subjektivní preference a čitelnost. Právě proto dnes měření doplňujeme o index kognitivní zátěže EMLI." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "16 návrhů billboardů, 79 párů očí",
    about: 'Eye tracking, UX výzkum',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'cs',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Case study: 16 billboardů, 79 respondentů"
  description="Eye tracking 16 návrhů billboardů fotbalového klubu (N = 79): vyhrály černé minimalistické varianty. Vizuální reklama ovlivňuje 39 % žen vs. 16 % mužů."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/pripadove-studie" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← VŠECHNY STUDIE</a>

      <!-- Hlavička studie -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Sport marketing · venkovní reklama</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-4xl" style="font-size: clamp(2rem, 4.5vw, 3.4rem);">
          16 návrhů billboardů, 79 párů očí<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Statistický banner -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white p-8 md:p-12 mb-16 flex flex-col md:flex-row md:items-center gap-6 md:gap-12">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <p class="relative font-display font-bold leading-none tracking-tight whitespace-nowrap" style="font-size: clamp(3rem, 8vw, 6.5rem);">39 : 16</p>
        <p class="relative text-brand-white/70 text-lg leading-relaxed max-w-md">% žen vs. mužů ovlivněných vizuální reklamou — a jasné vítězství černých variant</p>
      </div>

      <section class="reveal mb-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ SLOVNÍK — CO ZNAMENAJÍ ČÍSLA V TÉTO STUDII ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 space-y-4">
            <div><dt class="font-display font-bold mb-1">N (vzorek)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Počet skutečných lidí, kteří se měření zúčastnili. N = 102 znamená 102 respondentů.</dd></div>
            <div><dt class="font-display font-bold mb-1">p-hodnota</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Pravděpodobnost, že by naměřený rozdíl vznikl čirou náhodou. Čím menší, tím průkaznější výsledek — p = 0,037 znamená jen 3,7% šanci na náhodu (za průkazné se považuje vše pod 5 %).</dd></div>
            <div><dt class="font-display font-bold mb-1">Velikost efektu (ηp²)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Říká, jak velký je rozdíl v praxi — ne jen jestli existuje. Orientačně: 0,01 malý, 0,06 střední, 0,14 velký efekt.</dd></div>
            <div><dt class="font-display font-bold mb-1">Fixace</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Krátké zastavení oka na jednom místě (zlomky sekundy). Ze sledu fixací se skládá vše, co člověk na stránce skutečně „viděl“.</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI (sledovaná oblast)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Předem vyznačená část stránky — tlačítko, nadpis, fotografie — pro kterou měříme, kolik pozornosti dostala.</dd></div>
            <div><dt class="font-display font-bold mb-1">UEQ / VisAWI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Standardizované vědecké dotazníky: UEQ měří celkový uživatelský zážitek, VisAWI vnímanou estetiku webu. Díky standardizaci jsou výsledky porovnatelné mezi studiemi.</dd></div>
          </dl>
        </details>
      </section>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Obsah -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— KONTEXT</span></p>
            <p class="text-lg text-brand-black/80 leading-relaxed">Fotbalový klub připravoval kampaň na podporu návštěvnosti stadionu a měl na výběr 16 grafických návrhů billboardů. Místo hlasování v marketingovém týmu se rozhodl pro měření na cílové skupině.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— OBCHODNÍ OTÁZKA</span></p>
            <p class="font-display text-2xl font-bold leading-snug">Který z 16 grafických návrhů billboardu nejlépe zaujme a vede k záměru koupit vstupenku — a liší se to podle pohlaví diváka?</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— MĚŘENÍ</span></p>
            <p class="text-brand-black/70 leading-relaxed">Každý respondent viděl všech 16 návrhů přesně 10 sekund. Eye-tracking doplnil hodnotící dotazník (celkové hodnocení, přehlednost, pozornost, nákupní záměr) a výběr TOP3 variant.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">04</span> <span class="text-brand-black/60">— CO DATA UKÁZALA</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ DATA V OBRAZE ]</p>
              <svg viewBox="0 0 640 174" class="w-full" role="img" aria-label="Vizuální reklamou je ovlivněno 39 procent žen a 16 procent mužů"><text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">PODÍL DIVÁKŮ OVLIVNĚNÝCH VIZUÁLNÍ REKLAMOU · N = 79</text><text x="0" y="67" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">ŽENY</text><rect x="190" y="52" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="52" width="156" height="22" fill="#2D62FC" class="viz-bar"/><text x="346" y="67" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">39 %</text><text x="0" y="119" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">MUŽI</text><rect x="190" y="104" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="104" width="64" height="22" fill="#0A0A0A" class="viz-bar"/><text x="254" y="119" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">16 %</text></svg>
<svg viewBox="0 0 640 120" class="w-full mt-2" role="img" aria-label="Šest nejlépe hodnocených návrhů mělo černé pozadí, spodní shluk tvořily bílé varianty">
  <text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">HODNOCENÍ 16 NÁVRHŮ · TOP 6 vs SPODNÍ SHLUK</text>
  <g>
    <rect x="0" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="48" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="96" y="36" width="40" height="26" fill="#0A0A0A"/>
    <rect x="144" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="192" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="240" y="36" width="40" height="26" fill="#0A0A0A"/>
    <text x="292" y="54" font-family="monospace" font-size="11" fill="#0A0A0A">TOP 6 = ČERNÉ POZADÍ</text>
  </g>
  <g stroke="rgba(10,10,10,0.4)" fill="none">
    <rect x="0" y="76" width="40" height="26"/><rect x="48" y="76" width="40" height="26"/><rect x="96" y="76" width="40" height="26"/><rect x="144" y="76" width="40" height="26"/>
    <text x="196" y="94" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)" stroke="none">SPODNÍ SHLUK = BÍLÉ VARIANTY</text>
  </g>
</svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">Gender rozdíl je největší přenositelný insight studie; žebříček ukazuje jednoznačnou dominanci černých variant.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— CO SE ROZHODLO</span></p>
            <p class="text-brand-black/70 leading-relaxed">Černé, jednoduché a minimalistické pozadí, výrazný nadpis, neagresivní kompozice postav a jasně definovaný cíl billboardu.</p>
          </section>

          <section class="reveal border border-brand-black p-8">
            <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-4">CO BY DNES PŘIDALO EMLI</p>
            <p class="text-brand-black/70 leading-relaxed">U podobného zadání dnes navíc měříme index zátěže EMLI — protože fixační metriky se mezi variantami téměř nelišily, byl by ideálním rozhodčím: ukázal by, zda „čisté“ návrhy skutečně snižují zátěž čtení sdělení.</p>
          </section>
        </div>

        <!-- Fakta + foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">STUDIE VZNIKLA VE SPOLUPRÁCI S</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Fakulta informatiky a managementu"
                title="Studie vznikla ve spolupráci s FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">FAKTA MĚŘENÍ</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <div class="border border-brand-black/10 p-4 bg-brand-white">
                <svg viewBox="0 0 320 210" class="w-full" role="img" aria-label="Schéma vítězného principu billboardu: černé minimalistické pozadí s výrazným nadpisem">
                  <rect x="24" y="16" width="272" height="120" fill="#0A0A0A"/>
                  <rect x="48" y="44" width="130" height="14" fill="#FCFCFC"/>
                  <rect x="48" y="68" width="90" height="8" fill="rgba(252,252,252,0.5)"/>
                  <rect x="48" y="100" width="64" height="16" fill="#2D62FC"/>
                  <circle cx="248" cy="76" r="26" fill="none" stroke="rgba(252,252,252,0.6)" stroke-width="2"/>
                  <rect x="96" y="136" width="10" height="52" fill="#0A0A0A"/>
                  <rect x="214" y="136" width="10" height="52" fill="#0A0A0A"/>
                  <text x="24" y="204" font-family="monospace" font-size="11" fill="#0A0A0A">VÍTĚZNÝ PRINCIP: ČERNÁ · MINIMALISMUS · JASNÝ NADPIS</text>
                </svg>
              </div>
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Schéma vítězného principu — černé pozadí, výrazný nadpis, jeden jasný cíl</figcaption>
            </figure>
            <a href="/kontakt" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              NEZÁVAZNÁ POPTÁVKA →
            </a>
          </div>
        </aside>
      </div>

      <!-- FAQ ke studii -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ ČASTÉ DOTAZY KE STUDII ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Úzký pruh: kompletní studie (otevírá modal) -->
      <section class="reveal mt-16 bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Chcete projít studii podrobněji<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">PODROBNÝ REPORT S METODIKOU A DOPORUČENÍMI — ZDARMA V PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          VYŽÁDAT STUDII →
        </button>
      </section>

      <!-- Navigace mezi studiemi -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Další případové studie">
        <a href="/pripadove-studie/sablony-e-shopu" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← PŘEDCHOZÍ STUDIE</p>
          <p class="font-display font-bold leading-snug">Tři šablony, stejný sortiment. Rozhodl úkol.</p>
        </a>
        <a href="/pripadove-studie/karierni-portal-automotive" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">DALŠÍ STUDIE →</p>
          <p class="font-display font-bold leading-snug">40 % uchazečů nenašlo cestu k volným pozicím</p>
        </a>
      </nav>

      <!-- Závěrečné CTA -->
      <div class="reveal bg-brand-black text-brand-white text-center p-10 md:p-14 mt-10">
        <h2 class="font-display text-3xl md:text-4xl font-bold mb-8">Otestovat vizuál kampaně na reálných divácích<span style="color:#2D62FC">.</span></h2>
        <a href="/kontakt" class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          NEZÁVAZNÁ POPTÁVKA →
        </a>
        <p class="font-mono text-xs text-brand-white/60 mt-6">TYPICKÝ BALÍČEK PRO TENTO TYP ZAKÁZKY: <a href="/sluzby/testovaci-balicky" class="text-brand-white underline hover:no-underline">Standardní UX test</a></p>
      </div>
    </div>

      <!-- Modal: žádost o kompletní studii -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ PODROBNÁ STUDIE ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Zavřít okno">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Chcete projít studii podrobněji<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Studie jsou zkráceny a anonymizovány.</p>
          <form class="study-request space-y-4" data-pdf={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/studie/billboardy-sport-marketing.pdf`} data-study="16 návrhů billboardů, 79 párů očí">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">JMÉNO *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Vaše jméno"
                class="w-full border border-brand-white/50 px-4 py-3 font-sans text-base bg-transparent text-brand-white placeholder:text-brand-white/70 focus:outline-none focus:border-brand-white transition-colors" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">FIRMA</label>
              <input type="text" id="sr-company" name="company" placeholder="Název firmy (nepovinné)"
                class="w-full border border-brand-white/50 px-4 py-3 font-sans text-base bg-transparent text-brand-white placeholder:text-brand-white/70 focus:outline-none focus:border-brand-white transition-colors" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="vas@email.cz"
                class="w-full border border-brand-white/50 px-4 py-3 font-sans text-base bg-transparent text-brand-white placeholder:text-brand-white/70 focus:outline-none focus:border-brand-white transition-colors" />
            </div>
