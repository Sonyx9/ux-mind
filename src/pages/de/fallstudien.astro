---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="de"
  title="Fallstudien"
  description="Echte Eye-Tracking-Messungen mit belegbaren Zahlen: 40 % der Bewerber fanden keine offenen Stellen, den CTA nahmen 92 % der Befragten wahr, p = 0,037. Wir geben Methode, Stichprobe und Grenzen an."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ FALLSTUDIEN ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          WAS DIE<br/>MESSUNG ZEIGTE<span style="color:#2D62FC">.</span>
        </h1>
        <p class="text-xl text-brand-black/60 max-w-3xl leading-relaxed">
          Echte Messungen, echte Stichproben. Wir publizieren nur Zahlen, die wir mit Primärdaten belegen können — inklusive Methode, Stichprobengröße und Grenzen.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10">
        {[
          {
            href: '/de/fallstudien/karierni-portal-automotive',
            category: "ŠKODA AUTO · Karriereportal",
            title: "40 % der Bewerber fanden nicht zu den offenen Stellen. Die Website „wirkte dabei übersichtlich“.",
            desc: "Eye Tracking mit dem Szenario „Finden Sie offene Stellen“ zeigte, dass die subjektive Bewertung der Übersichtlichkeit nicht der tatsächlichen Fähigkeit entspricht, die Aufgabe zu lösen. Der A/B-Vergleich eines schwebenden CTA brachte messbare Unterschiede bei Fixationsmetriken und Besuchsdauer. Das Ergebnis war eine vereinfachte Route zu den Stellenangeboten und eine neu aufgebaute Navigation.",
            method: "Eye Tracking + Befragung · N = 102",
            tags: ["Eye Tracking", "Navigation", "A/B-Test"],
            result: "4 von 10 fanden keine Stellen",
          },
          {
            href: '/de/fallstudien/backend-stories',
            category: "Edukative Microsite",
            title: "Je länger der Text, desto weniger Aufmerksamkeit.",
            desc: "Die AOI-Analyse deckte einen Aufmerksamkeitsgradienten auf: Die auffällige Überschrift registrierten etwa 86 % der Befragten, den kurzen Folgetext 62 % und den langen Absatz 33 %. Die Ergebnisse führten zu einer stärkeren Hervorhebung des primären CTA und zur Kürzung langer Textblöcke.",
            method: "Eye Tracking, AOI-Analyse · ca. 120 Probanden",
            tags: ["AOI-Analyse", "Inhaltshierarchie", "CTA"],
            result: "92 % nahmen den CTA wahr",
          },
          {
            href: '/de/fallstudien/produktove-fotografie-e-commerce',
            category: "E-Commerce",
            title: "Dasselbe Produkt. Unterschiedlich lange Entscheidung.",
            desc: "Ein Experiment verglich einen reinen Packshot mit einem Lifestyle-Foto. Der Fototyp beeinflusste die Aufgabendauer statistisch signifikant — F(1,82) = 4,50; p = 0,037. Die Lifestyle-Variante führte im getesteten Szenario zu einer längeren Dauer, ein Unterschied bei der subjektiven Bewertung bestätigte sich nicht eindeutig.",
            method: "Eye Tracking + UEQ · N = 84",
            tags: ["Produktfotos", "Experiment", "PDP"],
            result: "Lifestyle verlängerte die Aufgabendauer",
          },
          {
            href: '/de/fallstudien/reklamni-bannery-smer-pohledu',
            category: "Werbekreation",
            title: "Der Blick der Figur lenkte die Aufmerksamkeit der Besucher.",
            desc: "Die Änderung der Blickrichtung der Figur beeinflusste die Verteilung der Aufmerksamkeit statistisch signifikant: F(1,102) = 12,57; p < 0,001; ηp² = 0,11. Das Experiment belegte einen mittelgroßen Effekt in den getesteten Kreationen; Klicks oder Konversion wurden nicht gemessen.",
            method: "Eye-Tracking-Experiment · N = 104",
            tags: ["Banner", "Visuelle Hinweise", "Aufmerksamkeit"],
            result: "ηp² = 0,11 · mittlerer Effekt",
          },
          {
            href: '/de/fallstudien/sablony-e-shopu',
            category: "E-Shop-Templates",
            title: "Die Aufgabe veränderte, worauf Menschen ihre Aufmerksamkeit richteten.",
            desc: "Eye Tracking von drei Templates mit demselben Sortiment zeigte, dass sich die Verteilung der Aufmerksamkeit je nach gestellter Aufgabe veränderte. VisAWI ergänzte die subjektive Bewertung der Optik — die Studie zeigt so, warum Ästhetik und Verhalten bei der Kaufaufgabe getrennt beurteilt werden müssen.",
            method: "Eye Tracking + VisAWI · N = 61",
            tags: ["E-Commerce", "Ästhetik vs. Leistung", "Aufgabenbasiertes Testen"],
            result: "3 Templates · 2 Aufgabentypen",
          },
          {
            href: '/de/fallstudien/billboardy-sport-marketing',
            category: "Sportmarketing · OOH",
            title: "Die ersten sechs Plätze gingen an schwarze Billboards.",
            desc: "Eye Tracking und die Bewertung von 16 Entwürfen zeigten eine klare Präferenz für die schwarzen Varianten. Die Fixationsmetriken allein bestimmten jedoch nicht den Sieger — die Studie zeigt, warum bei der Wahl der Kreation Aufmerksamkeit mit der Bewertung der Zielgruppe verbunden werden muss.",
            method: "Eye Tracking + Bewertungsfragebogen · N = 79 · 16 Stimuli à 10 s",
            tags: ["Billboards", "OOH", "Gender-Insight"],
            result: "TOP 6 · schwarzer Hintergrund",
          },
        ].map(study => (
          <div class="bg-brand-white p-10 flex flex-col">
            <div class="flex flex-col gap-2 md:flex-row md:justify-between md:items-start mb-6">
              <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5 self-start">{study.category}</span>
              <a href={study.href} class="font-display text-lg font-bold leading-tight md:text-right md:whitespace-nowrap hover:opacity-70 transition-opacity" style="color:#2D62FC">{study.result}</a>
            </div>
            <h3 class="font-display text-2xl font-bold mb-4 leading-tight"><a href={study.href} class="hover:opacity-60 transition-opacity">{study.title}</a></h3>
            <p class="text-brand-black/60 leading-relaxed mb-6 text-justify">{study.desc}</p>
            <p class="font-mono text-[11px] text-brand-black/60 tracking-wide mb-6">METHODE: {study.method}</p>
            <div class="flex flex-wrap gap-2 mt-auto mb-6">
              {study.tags.map(tag => (
                <span class="font-mono text-xs text-brand-black/60 border border-brand-black/10 px-2 py-1">{tag}</span>
              ))}
            </div>
            <a href={study.href} class="inline-block self-start border border-brand-black px-5 py-2.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              STUDIE ANSEHEN →
            </a>
          </div>
        ))}
      </div>

      <details class="group border border-brand-black/15 mt-6">
        <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
          [ GLOSSAR ]
          <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <dl class="px-5 pb-6 space-y-4">
            <div><dt class="font-display font-bold mb-1">p</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Wahrscheinlichkeit, dass das Ergebnis Zufall ist (0,037 = 3,7 % — je kleiner, desto aussagekräftiger)</dd></div>
            <div><dt class="font-display font-bold mb-1">ηp²</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Effektstärke (0,11 ≈ mittlerer, praxisrelevanter Effekt)</dd></div>
            <div><dt class="font-display font-bold mb-1">N</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Anzahl der Testpersonen</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">beobachteter Seitenbereich</dd></div>
        </dl>
      </details>

      <div class="text-center py-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ SOLCHE DATEN FÜR IHRE WEBSITE? ]</p>
        <h2 class="font-display text-5xl font-bold mb-8">Messen wir Ihr Projekt</h2>
        <a href="/de/kontakt" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
          ANGEBOT ANFRAGEN →
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
