---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="de"
  title="Eye Tracking"
  description="Eye Tracking für Websites, Apps und Printmaterialien. Heatmaps, AOI-Analyse und Aufzeichnungen der Augenbewegungen."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Header -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ EYE TRACKING ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          WIR SEHEN,<br/>WAS SIE NICHT SEHEN.
        </h1>
        <p class="text-xl text-brand-black/60 max-w-2xl leading-relaxed">
          Eye Tracking liefert präzise Daten darüber, wie Nutzer Ihre Inhalte wahrnehmen. Wir wissen, wohin sie schauen, was sie übersehen und was ihre Aufmerksamkeit fesselt.
        </p>
      </div>

      <!-- Foto aus einer Messung -->
      <div class="mb-24">
        <img
          src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/eye-tracking-mereni-respondentka-laborator.webp`}
          alt="Probandin während einer Eye-Tracking-Messung im Labor — sie betrachtet den Teststimulus auf einem Monitor mit Eye-Tracker"
          title="Eine Eye-Tracking-Messung im Labor"
          width="1080" height="1920" loading="lazy" decoding="async"
          class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Erhebung visueller Aufmerksamkeitsdaten im Labor — Blickaufzeichnungen fließen in AOI-Analysen und Heatmaps ein.</p>
      </div>

      <!-- So funktioniert es -->
      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ SO FUNKTIONIERT ES ]</p>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-px bg-brand-black/10">
          {[
            { num: '01', title: 'Vorbereitung', desc: 'Wir definieren Testszenarien nach Ihren Zielen und legen die AOIs (Areas of Interest) fest, die wir verfolgen wollen.' },
            { num: '02', title: 'Testung', desc: 'Nutzer interagieren mit Ihrem Produkt, während der Eye-Tracker ihre Augenbewegungen präzise aufzeichnet.' },
            { num: '03', title: 'Analyse', desc: 'Wir verarbeiten die Daten zu visuellen Heatmaps, Gaze Plots und AOI-Statistiken.' },
            { num: '04', title: 'Empfehlungen', desc: 'Sie erhalten konkrete Empfehlungen zur Verbesserung von Layout und Inhaltshierarchie.' },
          ].map(step => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/50 mb-6">{step.num}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Einsatzbereiche -->
      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ WO WIR HELFEN ]</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10">
          {[
            { title: 'Websites', desc: 'Wir finden heraus, wo Nutzer Zeit verbringen, was sie übersehen und warum sie nicht auf Ihre CTAs reagieren.' },
            { title: 'Mobile Apps', desc: 'Wir testen Navigation, Lesbarkeit und Usability Ihrer mobilen Produkte.' },
            { title: 'E-Commerce', desc: 'Wir optimieren Produktseiten, Warenkorb und Checkout für bessere Conversions.' },
            { title: 'Printmaterialien', desc: 'Banner, Plakate, Verpackungen — wir zeigen, was auf physischen Materialien Aufmerksamkeit erzeugt.' },
          ].map(usecase => (
            <div class="bg-brand-white p-8">
              <h3 class="font-display text-2xl font-bold mb-3">{usecase.title}</h3>
              <p class="text-brand-black/60 leading-relaxed">{usecase.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="text-center py-16 border-t border-brand-black/10">
        <h2 class="font-display text-4xl font-bold mb-6">Erfahren Sie, was Ihre Nutzer sehen</h2>
        <a href="/de/kontakt" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
          TESTUNG VEREINBAREN →
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
