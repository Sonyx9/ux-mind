---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const partners = [{"num":"01","name":"Univerzita Hradec Králové","claim":"Wo UXMIND zu Hause ist.","logo":`${base}/logos/uhk.svg`,"logoAlt":"Logo der Universität Hradec Králové","logoClass":"h-16 md:h-20","text":["Wir forschen nicht „in Zusammenarbeit mit Akademikern“ — wir tun es direkt im Eye-Tracking-Labor der Fakultät für Informatik und Management der UHK. Eine universitäre Basis bedeutet kalibrierte Technik, methodische Strenge und Pilotierung, bevor ein einziger echter Datenpunkt erhoben wird.","Hier ist unser Index der mentalen Belastung EMLI entstanden, und von hier aus gehen wir auch ins Feld. Akademische Präzision, kommerzielles Tempo."],"tags":["FIM UHK","Labor","EMLI"],"links":[{"label":"UHK.CZ →","href":"https://www.uhk.cz"},{"label":"FAKULTÄT FÜR INFORMATIK UND MANAGEMENT","href":"https://www.uhk.cz/cs/fakulta-informatiky-a-managementu"}]},{"num":"02","name":"MindSense","claim":"Science of attention.","logo":`${base}/logos/mindsense.webp`,"logoAlt":"MindSense-Logo — Lösungen für Forschungslabore","logoClass":"h-10 md:h-12","text":["Ein Technologiepartner, der unser Labor versteht — weil er es mit aufgebaut hat. MindSense hat das Eye-Tracking-Labor der UHK um neue Forschungsausrüstung erweitert und hält als exklusiver autorisierter Tobii-Distributor für Tschechien und die Slowakei unsere Technik auf Weltklasse-Niveau.","Biosensoren, EEG, GSR, Motion Capture und Eye Tracking in der virtuellen Realität: Wenn wir etwas Neues messen müssen, wissen wir, wohin wir für Hardware, Software und Know-how gehen."],"tags":["Tobii","Biosensoren","VR"],"links":[{"label":"MINDSENSE.CZ →","href":"https://mindsense.cz"}]}];

const pageSchema = [
  {
    '@type': 'WebPage',
    name: "Partner des UXMIND-Projekts",
    description: "Partner des UXMIND-Projekts: Universität Hradec Králové (Forschungsbasis der FIM UHK) und MindSense (Technologie für Forschungslabore, Tobii-Distributor).",
  },
];
---

<BaseLayout
  lang="de"
  title="Partner"
  description="Partner des UXMIND-Projekts: Universität Hradec Králové — Forschungsbasis des FIM-UHK-Labors, und MindSense — Technologie für Forschungslabore und Tobii-Distributor für CZ und SK."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ PROJEKTPARTNER ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          WIR MESSEN<br/>NICHT ALLEIN<span style="color:#2D62FC">.</span>
        </h1>
        <p class="text-lg text-brand-black/60 leading-relaxed max-w-2xl">
          Hinter jeder guten Messung stehen eine Basis, Technik und Menschen, die sie verstehen. UXMIND ruht auf zwei Säulen — <strong class="text-brand-black">universitärer Forschung und Spitzentechnologie</strong>.
        </p>
      </div>

      <div class="space-y-px border border-brand-black/10">
        {partners.map(p => (
          <div class="reveal p-8 md:p-12 border-b border-brand-black/10 last:border-0">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-10 items-start">
              <div class="flex flex-col gap-6">
                <span class="font-mono text-xs text-brand-black/60">{p.num}</span>
                <img src={p.logo} alt={p.logoAlt} class={`${p.logoClass} w-auto object-contain self-start`} loading="lazy" decoding="async" />
                <div class="flex flex-wrap gap-2">
                  {p.tags.map(tag => (
                    <span class="font-mono text-[11px] border border-brand-black/20 px-2 py-1 tracking-widest">{tag}</span>
                  ))}
                </div>
              </div>
              <div class="md:col-span-2">
                <h2 class="font-display text-3xl md:text-4xl font-bold mb-2">{p.name}</h2>
                <p class="font-mono text-xs text-brand-black/60 tracking-widest uppercase mb-6">{p.claim}</p>
                {p.text.map(t => (
                  <p class="text-brand-black/60 leading-relaxed mb-4 max-w-2xl">{t}</p>
                ))}
                <div class="flex flex-wrap gap-4 mt-6">
                  {p.links.map(l => (
                    <a href={l.href} target="_blank" rel="noopener noreferrer" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                      {l.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="reveal mt-24 grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
        {[{"t":"Basis","d":"Das FIM-UHK-Labor — kontrollierte Bedingungen, Kalibrierung, Pilotierung.","tag":"UHK"},{"t":"Technik","d":"Tobii, Shimmer GSR, Pupil Labs NEON und weitere Biosensoren hält MindSense aktuell.","tag":"MINDSENSE"},{"t":"Ergebnis","d":"Sie erhalten eine Messung, die standhält — methodisch und technisch.","tag":"UXMIND"}].map((v, i) => (
          <div class="bg-brand-white p-8">
            <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
            <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
            <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
            <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
          </div>
        ))}
      </div>

      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16 mt-24">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            MÖCHTEN SIE MESSEN<br/>MIT UNS<span style="color:#2D62FC">?</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            Universitäre Basis und Spitzentechnik sind die halbe Arbeit. Die andere Hälfte beginnt mit Ihrem Briefing.
          </p>
          <a href="/de/kontakt" class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
            KONTAKT AUFNEHMEN →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
