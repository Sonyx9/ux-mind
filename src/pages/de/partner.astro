---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const partners = [
  {
    num: '01',
    name: 'Univerzita Hradec Králové',
    claim: 'Forschungsfundament und Methodik.',
    logo: `${base}/logos/uhk.svg`,
    logoAlt: 'Logo der Univerzita Hradec Králové',
    logoClass: 'h-16 md:h-20',
    text: [
      'Im Labor für kognitive Studien der FIM UHK testen wir digitale wie physische Oberflächen unter kontrollierten Bedingungen sowie im Feld. Das Umfeld ermöglicht es uns, die Methodik vorzubereiten, das Szenario zu überprüfen und Eye Tracking mit weiteren Forschungsmethoden zu verbinden.',
      'Zum Forschungsumfeld gehören auch Fachpublikationen, studentische Arbeiten und die Entwicklung eigener Methoden — einschließlich des Index der mentalen Belastung EMLI.',
    ],
    tags: ['FIM UHK', 'Labor', 'EMLI'],
    links: [
      { label: 'UHK.CZ →', href: 'https://www.uhk.cz' },
      { label: 'FAKULTÄT FÜR INFORMATIK UND MANAGEMENT', href: 'https://www.uhk.cz/cs/fakulta-informatiky-a-managementu' },
    ],
  },
  {
    num: '02',
    name: 'MindSense',
    claim: 'Technologie und Fachsupport.',
    logo: `${base}/logos/mindsense.webp`,
    logoAlt: 'MindSense-Logo — Lösungen für Forschungslabore',
    logoClass: 'h-10 md:h-12',
    text: [
      'MindSense war an der Erweiterung des Labors um neue Forschungsausrüstung beteiligt und bietet fachlichen Support für die eingesetzten Technologien. Das Unternehmen ist exklusiver autorisierter Tobii-Distributor für Tschechien und die Slowakei.',
      'Es hilft dabei, Eye Tracking, Biosensoren, virtuelle Realität und Software so zu verbinden, dass die einzelnen Datenquellen als ein zusammenhängendes Forschungssystem funktionieren.',
    ],
    tags: ['Tobii', 'Biosensoren', 'VR'],
    links: [
      { label: 'MINDSENSE.CZ →', href: 'https://mindsense.cz' },
    ],
  },
];

const pageSchema = [
  {
    '@type': 'WebPage',
    name: 'Partner von UX MIND',
    description: 'Partner von UX MIND: Die Univerzita Hradec Králové stellt das Forschungsfundament, MindSense die technologische und fachliche Unterstützung.',
  },
];
---

<BaseLayout
  lang="de"
  title="Partner des Projekts"
  description="Partner von UX MIND: Die Univerzita Hradec Králové stellt das Forschungsfundament, MindSense die technologische und fachliche Unterstützung."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ PARTNER ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          WIR MESSEN<br/>NICHT ALLEIN<span style="color:#2D62FC">.</span>
        </h1>
        <p class="text-lg text-brand-black/60 leading-relaxed max-w-3xl text-justify">
          Guter Forschung genügt Technik allein nicht. Es braucht die richtige Methodik, verlässliche Ausrüstung und Menschen, die Daten interpretieren können. UX MIND verbindet deshalb <strong class="text-brand-black">das Forschungsfundament der FIM UHK mit dem technologischen Know-how von MindSense</strong>.
        </p>
      </div>

      <!-- Partneři -->
      <div class="space-y-px border border-brand-black/10">
        {partners.map(p => (
          <div class="reveal p-8 md:p-12 border-b border-brand-black/10 last:border-0">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-10 items-start">
              <!-- Logo -->
              <div class="flex flex-col gap-6">
                <span class="font-mono text-xs text-brand-black/60">{p.num}</span>
                <img src={p.logo} alt={p.logoAlt} class={`${p.logoClass} w-auto object-contain self-start`} loading="lazy" decoding="async" />
                <div class="flex flex-wrap gap-2">
                  {p.tags.map(tag => (
                    <span class="font-mono text-[11px] border border-brand-black/20 px-2 py-1 tracking-widest">{tag}</span>
                  ))}
                </div>
              </div>
              <!-- Text -->
              <div class="md:col-span-2">
                <h2 class="font-display text-3xl md:text-4xl font-bold mb-2">{p.name}</h2>
                <p class="font-mono text-xs text-brand-black/60 tracking-widest uppercase mb-6">{p.claim}</p>
                {p.text.map(t => (
                  <p class="text-brand-black/60 leading-relaxed mb-4 max-w-2xl text-justify">{t}</p>
                ))}
                <div class="flex flex-wrap gap-4 mt-6">
                  {p.links.map(l => (
                    <a href={l.href} target="_blank" rel="noopener noreferrer" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                      {l.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Jak spolupráce zapadá do měření -->
      <div class="reveal mt-24 grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          { t: 'Forschungsfundament', d: 'Das Labor der FIM UHK bietet die Bedingungen für Vorbereitung, Pilotierung und Durchführung von Studien.', tag: 'UHK' },
          { t: 'Technologische Unterstützung', d: 'MindSense hilft bei der Ausrüstung, ihrer Vernetzung und mit fachlichem Support.', tag: 'MINDSENSE' },
          { t: 'Ergebnis für den Kunden', d: 'UX MIND übersetzt die erhobenen Daten in verständliche Schlussfolgerungen und konkrete Empfehlungen.', tag: 'UX MIND' },
        ].map((v, i) => (
          <div class="bg-brand-white p-8 flex flex-col h-full">
            <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
            <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
            <p class="text-sm text-brand-black/60 leading-relaxed mb-6 text-justify">{v.d}</p>
            <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest self-start mt-auto">{v.tag}</span>
          </div>
        ))}
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
</content>
