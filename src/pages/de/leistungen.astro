---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="de"
  title="Leistungen"
  description="UX-Audit für Website und Onlineshop, Eye Tracking, UX-Forschung, Nutzertests und Feldmessungen mit mobilen Eye-Tracking-Brillen. Empfehlungen auf Datenbasis, nicht nach Gefühl."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Header -->
      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ UNSERE LEISTUNGEN ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter" style="font-size: clamp(3rem, 9vw, 8rem);">
          WAS WIR<br/>TUN<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Services list -->
      <div class="space-y-px border border-brand-black/10">
        {[
          // Reihenfolge: von der schnellen Basis (Audit) bis zur umfassendsten Forschung
          {
            num: '01',
            id: 'ux-audit',
            href: '/de/leistungen/ux-audit',
            title: 'UX-Audit',
            desc: 'Die schnelle Basis jeder Verbesserung. Eine systematische Analyse Ihres digitalen Produkts — wir gehen die Oberfläche aus Nutzerperspektive durch, identifizieren Barrieren und schlagen konkrete Verbesserungen mit wirkungsbasierter Priorisierung vor.',
            details: ['Heuristische Analyse', 'User-Flow-Analyse', 'Priorisierte Empfehlungsliste', 'Team-Workshop', 'Ergebnisbericht mit Mockups'],
            duration: '2–4 Wochen',
            pkg: 'Schnelldiagnose',
          },
          {
            num: '02',
            id: 'testovani-uzivatelu',
            href: '/de/leistungen/nutzertests',
            title: 'Nutzertests',
            desc: 'Moderierte und unmoderierte Tests mit echten Nutzern. Wir beobachten, wie Nutzer Aufgaben in Ihrem Produkt lösen, und identifizieren, wo sie scheitern.',
            details: ['Moderierte Testsitzungen', 'Unmoderierte Online-Tests', 'Think-Aloud-Protokoll', 'Bildschirmaufzeichnung', 'Analyse und Empfehlungen'],
            duration: '1–4 Wochen',
            pkg: 'Standard-UX-Test',
          },
          {
            num: '03',
            href: '/de/leistungen/eye-tracking',
            title: 'Eye Tracking',
            desc: 'Präzise Daten zur visuellen Wahrnehmung Ihrer Inhalte. Wir verfolgen die Augenbewegungen von Nutzern bei der Interaktion mit Ihrer Website, App oder Ihren Printmaterialien.',
            details: ['Aufmerksamkeits-Heatmaps', 'AOI-Analyse (Areas of Interest)', 'Aufzeichnungen der Augenbewegungen', 'F-Pattern- & Z-Pattern-Analyse', 'Vergleichende Variantentests'],
            duration: '1–3 Wochen',
            pkg: 'Standard-UX-Test',
          },
          {
            num: '04',
            id: 'terenni-mereni',
            href: '/de/leistungen/feldforschung',
            title: 'Feldforschung',
            desc: 'Wir messen dort, wo der Kunde wirklich entscheidet — im Store, im Showroom, auf einem Event oder am physischen Produkt. Die mobile Eye-Tracking-Brille erfasst Aufmerksamkeit in realer Umgebung, nicht nur am Bildschirm. Eine Ausstattung, über die nur wenige verfügen.',
            details: ['Mobile Eye-Tracking-Brille Pupil Labs NEON', 'Videoaufzeichnung von Situation und Verhalten im Raum', 'GSR und Interviews nach Bedarf', 'Product Placement, Beschilderung, POS-Materialien', 'Empfehlungen zur Anpassung von Raum und Customer Journey'],
            duration: '2–6 Wochen',
            pkg: 'Feldstudie',
          },
          {
            num: '05',
            href: '/de/leistungen/ux-forschung',
            title: 'UX-Forschung',
            desc: 'Der tiefste Umfang: eine Kombination qualitativer und quantitativer Methoden. Wir helfen Ihnen, die Bedürfnisse, Frustrationen und mentalen Modelle Ihrer Nutzer zu verstehen.',
            details: ['Tiefeninterviews', 'Kontextuelle Forschung', 'Usability-Tests', 'Datenanalyse', 'Personas & Journey Maps'],
            duration: '3–8 Wochen',
            pkg: 'Umfassende biometrische Forschung',
          },
        ].map(service => (
          <div id={service.id} class="p-8 md:p-12 border-b border-brand-black/10 last:border-0 scroll-mt-28">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <div class="md:col-span-2">
                <div class="flex items-baseline gap-4 mb-4">
                  <span class="font-mono text-xs text-brand-black/60">{service.num}</span>
                  <h2 class="font-display text-3xl md:text-4xl font-bold">
                    <a href={service.href} class="hover:opacity-60 transition-opacity">{service.title}</a>
                  </h2>
                </div>
                <p class="text-brand-black/60 leading-relaxed mb-6">{service.desc}</p>
                <ul class="space-y-1">
                  {service.details.map(d => (
                    <li class="font-mono text-xs text-brand-black/60 flex gap-2">
                      <span>→</span> {d}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="flex flex-col justify-between">
                <div>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">PROJEKTDAUER</p>
                  <p class="font-display text-lg font-semibold">{service.duration}</p>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mt-4 mb-1">TYPISCHES PAKET</p>
                  <a href="/de/leistungen/test-pakete" class="font-display text-lg font-semibold underline hover:no-underline">{service.pkg}</a>
                </div>
                <div class="flex flex-col gap-2 mt-6">
                  <a href={service.href} class="inline-block bg-brand-black text-brand-white border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors text-center">
                    LEISTUNG IM DETAIL →
                  </a>
                  <a href="/de/kontakt" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors text-center">
                    UNVERBINDLICH ANFRAGEN
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Test-Pakete -->
      <div class="mt-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
          <div class="md:col-span-2">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ TEST-PAKETE ]</p>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-4">Von der Schnelldiagnose bis zur umfassenden biometrischen Forschung</h2>
            <p class="text-brand-white/70 leading-relaxed max-w-2xl">
              Wir stellen unsere Leistungen zu Test-Paketen zusammen — je nach Entscheidung, die Sie treffen müssen: Eye-Tracking, Verhaltensdaten, Fragebögen, GSR und Feldmessungen. Sie wissen vorab, was Sie aus dem Testing gewinnen und was sich mit dem jeweiligen Umfang nicht zuverlässig behaupten lässt.
            </p>
          </div>
          <div class="flex md:justify-end">
            <a href="/de/leistungen/test-pakete" class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              PAKETE ANSEHEN →
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
