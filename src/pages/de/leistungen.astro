---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="de"
  title="Leistungen"
  description="UX-Audit für Website und Onlineshop, Eye Tracking, UX-Forschung, Nutzertests und Feldmessungen mit mobilen Eye-Tracking-Brillen. Empfehlungen auf Datenbasis, nicht nach Gefühl."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Header -->
      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ UNSERE LEISTUNGEN ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter" style="font-size: clamp(3rem, 9vw, 8rem);">
          WAS WIR<br/>TUN<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Services list -->
      <div class="space-y-px border border-brand-black/10">
        {[
          // Reihenfolge: von der schnellen Basis (Audit) bis zur umfassendsten Forschung
          {
            num: '01',
            id: 'ux-audit',
            href: '/de/leistungen/ux-audit',
            title: 'UX-Audit',
            desc: 'Wir durchlaufen Ihre Website, Ihren Onlineshop oder Ihre App mit den Augen der Nutzer. Wir finden Stellen, an denen Menschen zögern, abspringen oder einen wichtigen Schritt nicht abschließen. Sie erhalten konkrete Empfehlungen, geordnet nach ihrer Wirkung.',
            details: ['Heuristische Analyse', 'Analyse der Nutzerpfade', 'Priorisierte Empfehlungsliste', 'Workshop mit dem Team', 'Ergebnisbericht mit Änderungsvorschlägen'],
            duration: '2–4 Wochen',
            pkg: 'Schnelldiagnose',
          },
          {
            num: '02',
            id: 'testovani-uzivatelu',
            href: '/de/leistungen/nutzertests',
            title: 'Nutzertests',
            desc: 'Wir geben echten Nutzern konkrete Aufgaben und beobachten, ob sie diese lösen können. Sie erfahren, wo sie sich verlieren, was sie nicht verstehen und warum sie abspringen.',
            details: ['Moderiertes Testing', 'Unmoderiertes Online-Testing', 'Nutzer beschreibt seine Schritte laut', 'Bildschirmaufzeichnung', 'Ergebnisse und Empfehlungen'],
            duration: '1–4 Wochen',
            pkg: 'Standard-UX-Test',
          },
          {
            num: '03',
            href: '/de/leistungen/eye-tracking',
            title: 'Eye Tracking',
            desc: 'Mit Eye Tracking messen wir, wohin Menschen wirklich schauen. Sie erfahren, was ihnen auffällt, was sie übersehen und ob wichtiger Inhalt ihre Aufmerksamkeit in die richtige Richtung lenkt.',
            details: ['Aufmerksamkeits-Heatmaps', 'AOI-Analyse (Areas of Interest)', 'Aufzeichnungen der Augenbewegungen', 'F-Pattern- & Z-Pattern-Analyse', 'Vergleichende Variantentests'],
            duration: '1–3 Wochen',
            pkg: 'Standard-UX-Test',
          },
          {
            num: '04',
            id: 'terenni-mereni',
            href: '/de/leistungen/feldforschung',
            title: 'Feldforschung',
            desc: 'Wir beobachten Kunden genau dort, wo sie entscheiden — im Geschäft, im Showroom, auf einer Veranstaltung oder am physischen Produkt. Mobile Eye-Tracking-Brillen zeigen, was ihnen im realen Umfeld auffällt und was sie übersehen.',
            details: ['Mobile Eye-Tracking-Brille Pupil Labs NEON', 'Videoaufzeichnung von Situation und Verhalten im Raum', 'GSR und Interviews nach Bedarf', 'Product Placement, Beschilderung, POS-Materialien', 'Empfehlungen zur Anpassung von Raum und Customer Journey'],
            duration: '2–6 Wochen',
            pkg: 'Feldstudie',
          },
          {
            num: '05',
            href: '/de/leistungen/ux-forschung',
            title: 'UX-Forschung',
            desc: 'Wir helfen Ihnen zu verstehen, was Nutzer brauchen, was sie frustriert und warum sie sich auf eine bestimmte Weise verhalten. Je nach Forschungsfrage verbinden wir Interviews, Beobachtung, Tests und Daten.',
            details: ['Tiefeninterviews', 'Kontextuelle Forschung', 'Usability-Tests', 'Datenanalyse', 'Personas & Journey Maps'],
            duration: '3–8 Wochen',
            pkg: 'Umfassende biometrische Forschung',
          },
        ].map(service => (
          <div id={service.id} class="p-8 md:p-12 border-b border-brand-black/10 last:border-0 scroll-mt-28">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <div class="md:col-span-2">
                <div class="flex items-baseline gap-4 mb-4">
                  <span class="font-mono text-xs text-brand-black/60">{service.num}</span>
                  <h2 class="font-display text-3xl md:text-4xl font-bold">
                    <a href={service.href} class="hover:opacity-60 transition-opacity">{service.title}</a>
                  </h2>
                </div>
                <p class="text-brand-black/60 leading-relaxed mb-6">{service.desc}</p>
                <ul class="space-y-1">
                  {service.details.map(d => (
                    <li class="font-mono text-xs text-brand-black/60 flex gap-2">
                      <span>→</span> {d}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="flex flex-col justify-between">
                <div>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">PROJEKTDAUER</p>
                  <p class="font-display text-lg font-semibold">{service.duration}</p>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mt-4 mb-1">TYPISCHES PAKET</p>
                  <a href="/de/leistungen/test-pakete" class="font-display text-lg font-semibold underline hover:no-underline">{service.pkg}</a>
                </div>
                <div class="flex flex-col gap-2 mt-6">
                  <a href={service.href} class="inline-block bg-brand-black text-brand-white border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-[#2D62FC] hover:border-[#2D62FC] hover:text-brand-white transition-colors text-center">
                    LEISTUNG IM DETAIL →
                  </a>
                  <a href="/de/kontakt" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors text-center">
                    UNVERBINDLICH ANFRAGEN
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Testovací balíčky -->
      <a id="testovaci-balicky" href="/de/leistungen/test-pakete" class="group block mt-24 border border-brand-black bg-brand-black text-brand-white p-8 md:p-12 hover:bg-brand-white hover:text-brand-black transition-colors duration-300 scroll-mt-28">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
          <div class="md:col-span-2">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4 group-hover:text-brand-black/60 transition-colors">[ TEST-PAKETE ]</p>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-4">Von der schnellen Kontrolle bis zur Tiefenforschung<span style="color:#2D62FC">.</span></h2>
            <p class="text-brand-white/70 leading-relaxed max-w-2xl group-hover:text-brand-black/70 transition-colors">
              Wählen Sie den Umfang nach dem, was Sie herausfinden möchten. Wir kombinieren passende Methoden und erklären vorab, welche Antworten Sie aus dem Testing erhalten.
            </p>
          </div>
          <div class="flex md:justify-end">
            <span class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase group-hover:border-brand-black group-hover:text-brand-black transition-colors">
              PAKETE VERGLEICHEN →
            </span>
          </div>
        </div>
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
</content>
