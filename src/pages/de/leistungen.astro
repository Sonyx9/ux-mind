---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="de"
  title="Leistungen"
  description="UX-Audit, Eye Tracking, UX-Forschung und Nutzertests. Ein umfassendes Portfolio an UX-Leistungen für digitale Produkte."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ UNSERE LEISTUNGEN ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter" style="font-size: clamp(3.5rem, 10vw, 9rem);">
          WAS WIR<br/>TUN.
        </h1>
      </div>

      <div class="space-y-px border border-brand-black/10">
        {[
          {
            num: '01',
            title: 'UX-Audit',
            desc: 'Eine systematische Analyse Ihres digitalen Produkts. Wir gehen die Oberfläche aus Nutzerperspektive durch, identifizieren Barrieren und schlagen konkrete Verbesserungen mit wirkungsbasierter Priorisierung vor.',
            details: ['Heuristische Analyse', 'User-Flow-Analyse', 'Priorisierte Empfehlungsliste', 'Team-Workshop', 'Ergebnisbericht mit Mockups'],
            duration: '2–4 Wochen',
          },
          {
            num: '02',
            title: 'Eye Tracking',
            desc: 'Präzise Daten zur visuellen Wahrnehmung Ihrer Inhalte. Wir verfolgen die Augenbewegungen von Nutzern bei der Interaktion mit Ihrer Website, App oder Ihren Printmaterialien.',
            details: ['Aufmerksamkeits-Heatmaps', 'AOI-Analyse (Areas of Interest)', 'Aufzeichnungen der Augenbewegungen', 'F-Pattern- & Z-Pattern-Analyse', 'Vergleichende Variantentests'],
            duration: '1–3 Wochen',
          },
          {
            num: '03',
            title: 'UX-Forschung',
            desc: 'Tiefgehende Nutzerforschung mit qualitativen und quantitativen Methoden. Wir helfen Ihnen, die Bedürfnisse, Frustrationen und mentalen Modelle Ihrer Nutzer zu verstehen.',
            details: ['Tiefeninterviews', 'Kontextuelle Forschung', 'Usability-Tests', 'Datenanalyse', 'Personas & Journey Maps'],
            duration: '3–8 Wochen',
          },
          {
            num: '04',
            title: 'Nutzertests',
            desc: 'Moderierte und unmoderierte Tests mit echten Nutzern. Wir beobachten, wie Nutzer Aufgaben in Ihrem Produkt lösen, und identifizieren, woran sie scheitern.',
            details: ['Moderierte Testsitzungen', 'Unmoderierte Online-Tests', 'Think-Aloud-Protokoll', 'Bildschirmaufzeichnung', 'Analyse und Empfehlungen'],
            duration: '1–4 Wochen',
          },
        ].map(service => (
          <div class="p-8 md:p-12 border-b border-brand-black/10 last:border-0">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <div class="md:col-span-2">
                <div class="flex items-baseline gap-4 mb-4">
                  <span class="font-mono text-xs text-brand-black/60">{service.num}</span>
                  <h2 class="font-display text-3xl md:text-4xl font-bold">{service.title}</h2>
                </div>
                <p class="text-brand-black/60 leading-relaxed mb-6">{service.desc}</p>
                <ul class="space-y-1">
                  {service.details.map(d => (
                    <li class="font-mono text-xs text-brand-black/60 flex gap-2">
                      <span>→</span> {d}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="flex flex-col justify-between">
                <div>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">PROJEKTDAUER</p>
                  <p class="font-display text-lg font-semibold">{service.duration}</p>
                </div>
                <a href="/de/kontakt" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors mt-6 text-center">
                  ANFRAGEN →
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
