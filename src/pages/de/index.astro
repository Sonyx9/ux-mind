---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import HomeHero from '../../components/HomeHero.astro';
import Footer from '../../components/Footer.astro';
const homeStudies = [
  {
    href: '/de/fallstudien/karriereportal-automotive',
    category: 'ŠKODA AUTO · Karriereportal',
    title: '40 % der Bewerber fanden nicht zu den offenen Stellen. Die Website „wirkte dabei übersichtlich".',
    method: 'Eye-Tracking + Fragebogen · N = 102',
    result: '4 von 10 fanden keine Stellen',
  },
  {
    href: '/de/fallstudien/backend-stories',
    category: 'Edukative Microsite',
    title: 'Je länger der Text, desto weniger Aufmerksamkeit.',
    method: 'Eye-Tracking, AOI-Analyse · ca. 120 Probanden',
    result: '92 % nahmen den CTA wahr',
  },
  {
    href: '/de/fallstudien/werbebanner-blickrichtung',
    category: 'Werbekreation',
    title: 'Der Blick der Figur lenkte die Aufmerksamkeit der Besucher.',
    method: 'Eye-Tracking-Experiment · N = 104',
    result: 'ηp² = 0,11 · mittlerer Effekt',
  },
];

const gifSrc = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/hero.webp`;
const yearSuffix = new Date().getFullYear().toString().slice(-2);

const clientLogos = [
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/skoda.webp`, w: 1920, h: 630, alt: 'Škoda Auto' , dh: 50 },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/fchk.webp`, w: 800, h: 800, alt: 'FC Hradec Králové' , dh: 54 },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`, w: 157, h: 37, alt: 'Univerzita Hradec Králové' },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/texopluslogo.webp`, w: 216, h: 46, alt: 'TEXO Plus' },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/epodlahovka.webp`, w: 285, h: 49, alt: 'E-podlahovka' },
];
---

<BaseLayout lang="de" title="UX-Forschung, Eye Tracking und Nutzertests | UX MIND" description="Nutzertests, Eye Tracking und Messung der kognitiven Belastung (Modell EMLI). Objektive UX-Forschung mit wissenschaftlichem Hintergrund der FIM UHK. Testen Sie Ihre Website anhand von Daten." preloadImages={[{ href: gifSrc, media: "(min-width: 1024px)" }]}>
  <Navbar />

  <HomeHero lang="de" />

  <main id="main-content">

  <!-- LOGO STRIP -->
  <div class="border-y border-brand-black/10 py-6" style="background:#FDFDFD;">
    <p class="font-mono text-xs tracking-widest text-brand-black/60 text-center mb-4">[ WIR HABEN ZUSAMMENGEARBEITET MIT ]</p>
    <!-- Desktop: statický pás -->
    <div class="hidden md:flex flex-wrap items-center justify-center gap-x-14 gap-y-6 px-6">
      {clientLogos.map(({ src, alt, w, h, dh }) => (
        <div class="px-4 py-1">
          <img
            src={src}
            alt={alt}
            title={alt}
            width={w} height={h}
            class="logo-strip-img select-none"
            style={`height:${dh || 42}px; width:auto; max-width:170px; object-fit:contain; display:block;`}
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
    <!-- Mobil: tři hlavní loga v jednom řádku (Škoda, FC Hradec Králové, UHK) -->
    <div class="md:hidden grid grid-cols-3 items-center gap-4 px-6">
      {clientLogos.slice(0, 3).map(({ src, alt, w, h, dh }) => (
        <div class="flex justify-center items-center min-w-0">
          <img
            src={src}
            alt={alt}
            title={alt}
            width={w} height={h}
            class="logo-strip-img select-none"
            style={`height:${dh ? Math.round(dh * 36 / 42) : 30}px; width:auto; max-width:100%; object-fit:contain; display:block;`}
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
  </div>

  <style>
    .logo-strip-img {
      filter: grayscale(1);
      opacity: 0.65;
    }
  </style>

  <!-- SERVICES SECTION -->
  <section class="desktop-gutter-x py-24 max-w-7xl mx-auto">
    <div class="mb-12 max-w-3xl">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ UNSERE LEISTUNGEN ]</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">Was wir tun<span style="color:#2D62FC">.</span></h2>
      <p class="text-sm text-brand-black/60 leading-relaxed">
        Wir helfen herauszufinden, wo eine Website, App oder Kommunikation Menschen den Weg erschwert. Wir messen das Problem, erklären seine Ursache und empfehlen, was zuerst zu ändern ist.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10">
      {[
        {
          num: '01',
          title: 'UX-Audit',
          desc: 'Wir durchlaufen Ihre Website, Ihren Onlineshop oder Ihre App mit den Augen der Nutzer. Wir finden Stellen, an denen Menschen zögern, eine Bestellung nicht abschließen oder wichtige Informationen übersehen. Sie erhalten eine nach Priorität geordnete Liste an Anpassungen.',
          href: '/de/leistungen/ux-audit',
          tags: ['Analyse', 'Empfehlungen', 'Priorisierung'],
        },
        {
          num: '02',
          title: 'Nutzertests',
          desc: 'Wir geben echten Nutzern konkrete Aufgaben und beobachten, ob sie diese lösen können. Sie sehen, wo sie sich verlieren, was sie nicht verstehen und warum sie abspringen — samt Vorschlägen, was zu ändern ist.',
          href: '/de/leistungen/nutzertests',
          tags: ['Aufgabenszenarien', 'Erfolgsquote', 'Qualitative Einsichten'],
        },
        {
          num: '03',
          title: 'Eye Tracking',
          desc: 'Mit Eye Tracking messen wir, wohin Menschen wirklich schauen. Heatmaps und Blickaufzeichnungen zeigen, was ihnen auffällt, was sie übersehen und ob wichtiger Inhalt sie in die richtige Richtung lenkt.',
          href: '/de/leistungen/eye-tracking',
          tags: ['Heatmap', 'Zeit bis zum ersten Blick', 'Blickverlauf'],
        },
        {
          num: '04',
          title: 'Feldforschung',
          desc: 'Wir beobachten das Verhalten von Kunden genau dort, wo sie entscheiden — im Geschäft, im Showroom, auf einer Veranstaltung oder am physischen Produkt. Mobile Eye-Tracking-Brillen zeigen, was ihnen im realen Umfeld auffällt und was sie übersehen.',
          href: '/de/leistungen/feldforschung',
          tags: ['Mobiles Eye-Tracking', 'Realer Kontext', 'Beobachtung'],
        },
        {
          num: '05',
          title: 'UX-Forschung',
          desc: 'Wenn Sie nicht nur verstehen müssen, was nicht funktioniert, sondern auch warum. Wir verbinden Interviews, Beobachtung, Tests und die Messung von Reaktionen, damit Sie nach den tatsächlichen Bedürfnissen der Nutzer entscheiden können.',
          href: '/de/leistungen/ux-forschung',
          tags: ['Eye-Tracking', 'Biometrie', 'Fragebögen'],
        },
        {
          num: '06',
          title: 'Fallstudien',
          desc: 'Sehen Sie, was echte Messungen zeigten: 40 % der Bewerber fanden nicht zu den offenen Stellen, und den Haupt-CTA nahmen 92 % der Befragten wahr. Wir zeigen die Daten und die Änderungen, zu denen sie führten.',
          href: '/de/fallstudien',
          tags: ['Ergebnisse', 'Daten', 'Entscheidungen'],
        },
      ].map(service => (
        <a href={service.href} class="group bg-brand-white p-8 hover:bg-brand-black hover:text-brand-white transition-colors duration-300">
          <div class="flex justify-between items-start mb-8">
            <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/60">{service.num}</p>
            <span class="font-mono text-xs group-hover:text-brand-white/60">→</span>
          </div>
          <h3 class="font-display text-3xl font-bold mb-4 leading-tight">{service.title}</h3>
          <p class="text-sm text-brand-black/60 group-hover:text-brand-white/60 leading-relaxed mb-6">{service.desc}</p>
          <div class="flex flex-wrap gap-2">
            {service.tags.map(tag => (
              <span class="font-mono text-xs border border-brand-black/20 group-hover:border-brand-white/20 px-2 py-1">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
    <!-- Testovací balíčky — černý pás, ať vyniknou -->
    <a href="/de/leistungen/test-pakete" class="group flex flex-col md:flex-row md:items-center justify-between gap-4 bg-brand-black text-brand-white border border-brand-black p-8 hover:bg-[#2D62FC] transition-colors duration-300">
      <div>
        <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-2">[ TEST-PAKETE ]</p>
        <p class="font-display text-2xl font-bold leading-tight">Von der schnellen Kontrolle bis zur Tiefenforschung. Wählen Sie den Umfang nach dem, was Sie herausfinden möchten.</p>
      </div>
      <span class="font-mono text-xs tracking-widest uppercase shrink-0">PAKETE VERGLEICHEN →</span>
    </a>
  </section>

  <!-- TŘI OTÁZKY, TŘI MĚŘENÍ -->
  <section class="desktop-gutter-x py-24 max-w-7xl mx-auto">
    <div class="mb-12 max-w-3xl">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ DREI FRAGEN, DREI MESSUNGEN ]</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">Was Nutzer sehen, wie sie reagieren<br/>und was sie belastet<span style="color:#2D62FC">.</span></h2>
      <p class="text-sm text-brand-black/60 leading-relaxed">
        Analytics zeigt, WOHIN Menschen geklickt haben. Umfragen zeigen, WAS sie denken. Wir messen die dritte Ebene:
        was sie tatsächlich gesehen haben, wie stark sie reagiert haben und wo die Oberfläche sie mental überlastet hat.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10">
      {[
        {
          q: 'Sehen sie es überhaupt?',
          desc: 'Visuelle Aufmerksamkeit — wohin Menschen zuerst schauen, wie lange sie wo verweilen und was sie komplett übersehen. Eye Tracking hält objektiv fest, was Nutzer wirklich gesehen haben.',
          tool: 'EYE-TRACKING',
        },
        {
          q: 'Wie stark reagieren sie?',
          desc: 'Wie stark der Körper reagiert (Hautleitfähigkeit) und was die Mimik verrät — immer im Kontext der Aufgabe. Wir deuten sie mit ihren Grenzen — kein „Emotionslesen“.',
          tool: 'HAUTLEITFÄHIGKEIT + MIMIK',
        },
        {
          q: 'Schaffen sie es ohne Anstrengung?',
          desc: 'Kognitive Belastung als ein klar verständlicher Score von 0–100. Sie erfahren, wo die Oberfläche Nutzer überlastet, selbst wenn sie die Aufgabe am Ende schaffen.',
          tool: 'MODELL EMLI',
        },
      ].map((item, i) => (
        <div class="bg-brand-white p-8 flex flex-col">
          <p class="font-mono text-xs text-brand-black/60 mb-8">0{i + 1}</p>
          <h3 class="font-display text-2xl font-bold mb-4 leading-tight">{item.q}</h3>
          <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{item.desc}</p>
          <p class="mt-auto"><span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{item.tool}</span></p>
        </div>
      ))}
    </div>
    <!-- Slovníček zkratek -->
    <details class="group border border-brand-black/15 mt-6">
        <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
          [ GLOSSAR ]
          <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <dl class="px-5 pb-6 space-y-4">
            <div><dt class="font-display font-bold mb-1">TTFF</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Zeit bis zur ersten Blickfixation</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">beobachteter Interessenbereich (Area of Interest)</dd></div>
            <div><dt class="font-display font-bold mb-1">Dwell Time</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Gesamtzeit, die der Blick in einem Bereich verweilt</dd></div>
            <div><dt class="font-display font-bold mb-1">Scanpath</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Blickpfad zwischen den Fixationen</dd></div>
            <div><dt class="font-display font-bold mb-1">GSR</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Messung der Hautleitfähigkeit, Indikator physiologischer Erregung</dd></div>
            <div><dt class="font-display font-bold mb-1">EMLI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">aus Eye-Tracking-Metriken abgeleiteter Index der mentalen (kognitiven) Belastung</dd></div>
        </dl>
      </details>
  </section>

  <!-- EMLI SECTION -->
  <section class="desktop-gutter-x py-24 bg-brand-black text-brand-white">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="font-mono text-[11px] tracking-normal whitespace-nowrap md:text-xs md:tracking-widest md:whitespace-normal text-brand-white/70 mb-6">[ EMLI — EYE-TRACKING MENTAL LOAD INDEX ]</p>
        <h2 class="font-display text-4xl md:text-6xl font-bold leading-none tracking-tight mb-8">Mentale Belastung<br/>als Zahl<span style="color:#2D62FC">.</span></h2>
        <p class="text-brand-white/60 leading-relaxed mb-6">
          Eine Heatmap zeigt, wohin Menschen geschaut haben. Sie allein erkennt aber nicht, ob die Oberfläche für sie einfach war
          oder sie bei der Aufgabe unnötig belastete. EMLI verbindet acht Eye-Tracking-Metriken zu einem einzigen
          Score der kognitiven Belastung von 0 bis 100. <strong class="text-brand-white">Je höher der Score, desto größer die Belastung.</strong> So vergleichen Sie leicht
          zwei Designvarianten, einzelne Formularschritte oder Wettbewerbslösungen — auf Basis von Daten, nicht nach Gefühl.
        </p>
        <p class="font-mono text-xs text-brand-white/70 leading-relaxed mb-10">
          Das Modell entstand in der akademischen Forschung der FIM UHK.<br class="hidden md:block"/> Die Methodik ist für eine unabhängige Überprüfung ausführlich dokumentiert.
        </p>
        <a href="/de/kontakt" class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          BELASTUNG MESSEN LASSEN →
        </a>
      </div>
      <div class="flex justify-center">
        <!-- EMLI gauge 0–100 -->
        <svg viewBox="0 0 320 200" class="w-full max-w-sm" role="img" aria-label="Illustration des EMLI-Index der mentalen Belastung auf einer Skala von 0 bis 100">
          <path d="M 30 170 A 130 130 0 0 1 290 170" fill="none" stroke="rgba(252,252,252,0.15)" stroke-width="14" stroke-linecap="round" />
          <path id="emli-arc" d="M 30 170 A 130 130 0 0 1 290 170" pathLength="100" fill="none" stroke="#FCFCFC" stroke-width="14" stroke-linecap="round" stroke-dasharray="65 100" />
          {Array.from({ length: 11 }).map((_, i) => {
            const a = Math.PI - (i * Math.PI) / 10;
            const x1 = 160 + Math.cos(a) * 108, y1 = 170 - Math.sin(a) * 108;
            const x2 = 160 + Math.cos(a) * 98,  y2 = 170 - Math.sin(a) * 98;
            return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="rgba(252,252,252,0.35)" stroke-width="2" />;
          })}
          <g id="emli-needle" style="transform-box: view-box; transform-origin: 160px 170px; transform: rotate(117deg);">
            <line x1="160" y1="170" x2="76" y2="170" stroke="#FCFCFC" stroke-width="2" />
          </g>
          <circle cx="160" cy="170" r="6" fill="#2D62FC" />
          <text x="30" y="192" fill="rgba(252,252,252,0.5)" font-family="monospace" font-size="12">0</text>
          <text x="278" y="192" fill="rgba(252,252,252,0.5)" font-family="monospace" font-size="12">100</text>
          <text id="emli-value" x="160" y="130" fill="#FCFCFC" text-anchor="middle" font-family="monospace" font-size="38" font-weight="700">65</text>
          <text x="160" y="150" fill="rgba(252,252,252,0.6)" text-anchor="middle" font-family="monospace" font-size="11" letter-spacing="3">EMLI</text>
          <text x="160" y="196" fill="rgba(252,252,252,0.5)" text-anchor="middle" font-family="monospace" font-size="10" letter-spacing="2">8 METRIKEN → 1 INDEX</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- STATS SECTION -->
  <section class="desktop-gutter-x py-16 border-t border-brand-black/10">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8">
      {[
        { num: '5+', label: 'Durchgeführte Studien' },
        { num: '800+', label: 'Probanden in Studien' },
        { num: '8', label: 'Metriken im Modell EMLI' },
        { num: '0–100', label: 'Skala des Belastungsindex' },
      ].map(stat => (
        <div class="text-center">
          <p class="font-display text-5xl md:text-6xl font-bold mb-3">{stat.num}</p>
          <div class="border-t border-brand-black/15 mb-2"></div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest uppercase">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- VÝZKUM A TECHNOLOGIE -->
  <section class="desktop-gutter-x py-24 border-t border-brand-black/10 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ LABOR UND TECHNOLOGIE ]</p>
        <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">Technologie allein reicht nicht.<br/>Entscheidend ist die Methodik<span style="color:#2D62FC">.</span></h2>
        <p class="text-sm text-brand-black/60 leading-relaxed mb-8">
          Wir messen im Labor für kognitive Studien der FIM UHK sowie direkt im Feld. Moderne Geräte allein
          garantieren aber kein verlässliches Ergebnis. Deshalb beginnt jede Untersuchung mit einer klaren
          Fragestellung, wir prüfen das Szenario vorab und kontrollieren während der Messung die Datenqualität.
          Ergebnisse bewerten wir im Kontext der konkreten Aufgabe und sagen offen, was sich daraus ableiten
          lässt — und was nicht.
        </p>
        <div class="flex flex-wrap gap-2">
          {['TOBII PRO X2-60', 'SMART EYE AURORA', 'MOBILE EYE-TRACKING-BRILLE', 'EYE-TRACKING-AUSWERTUNGSSOFTWARE', 'SHIMMER3 GSR'].map(tech => (
            <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{tech}</span>
          ))}
        </div>
        <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mt-8">AKADEMISCHER HINTERGRUND</p>
        <p class="text-sm text-brand-black/60 leading-relaxed mt-4">
          Mitglieder des Teams veröffentlichen ihre Ergebnisse in den Fachzeitschriften Scientific Reports
          (Nature Portfolio) und Journal of Environmental Psychology sowie auf der Konferenz ACM ETRA. Dieselbe
          Sorgfalt bringen wir in Kundenprojekte ein — von der Messplanung bis zur verständlichen Interpretation
          der Ergebnisse.
        </p>
      </div>
      <div class="flex flex-col">
        <!-- Fotka vyplní výšku sloupce (ořez object-cover) -->
        <div class="border border-brand-black flex flex-col flex-1 min-h-0">
          <img
            src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/analyza-heatmapy-eye-tracking.webp`}
            alt="Jan Petružálek und Filip Oborník besprechen am Monitor eine Aufmerksamkeits-Heatmap aus einer Eye-Tracking-Studie"
            title="Auswertung einer Aufmerksamkeits-Heatmap im Labor FIMEYELAB, FIM UHK"
            width="1920" height="1280" loading="lazy" decoding="async"
            class="w-full flex-1 min-h-0 object-cover block"
          />
        </div>
        <div class="mt-4 pt-3 border-t border-brand-black/20 flex items-center justify-between">
          <p class="font-mono text-[10px] text-brand-black/60 tracking-widest">IN ZUSAMMENARBEIT MIT:</p>
          <img width="157" height="37" loading="lazy" decoding="async" src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`} alt="Univerzita Hradec Králové" title="Univerzita Hradec Králové" class="h-[40px] w-auto" />
        </div>
      </div>
    </div>
  </section>

  <!-- PŘÍPADOVÉ STUDIE -->
  <section class="desktop-gutter-x py-24 max-w-7xl mx-auto">
    <div class="flex justify-between items-end mb-12">
      <div>
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ FALLSTUDIEN ]</p>
        <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight">Was die<br/>Messung zeigte<span style="color:#2D62FC">.</span></h2>
      </div>
      <a href="/de/fallstudien" class="font-mono text-xs tracking-widest border-b border-brand-black pb-1 hover:opacity-50 transition-opacity">
        ALLE FALLSTUDIEN →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
      {homeStudies.map(study => (
        <a href={study.href} class="group bg-brand-white p-8 flex flex-col hover:bg-brand-black transition-colors">
          <div class="flex justify-between items-start gap-3 mb-6">
            <span class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 border border-brand-black/20 group-hover:border-brand-white/50 px-2 py-0.5 transition-colors">{study.category}</span>
          </div>
          <h3 class="font-display text-xl font-bold mb-4 leading-tight group-hover:text-brand-white transition-colors">{study.title}</h3>
          <p class="font-mono text-[11px] text-brand-black/60 group-hover:text-brand-white/70 tracking-wide mb-6 transition-colors">METHODE: {study.method}</p>
          <div class="mt-auto">
            <span class="block font-display text-lg font-bold leading-none whitespace-nowrap mb-4" style="color:#2D62FC">{study.result}</span>
            <span class="block font-mono text-xs tracking-widest group-hover:text-brand-white transition-colors">STUDIE ANSEHEN →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- JAK TO U NÁS FUNGUJE -->
  <section class="desktop-gutter-x py-24 border-t border-brand-black/10 max-w-7xl mx-auto">
    <div class="flex flex-col items-start gap-6 md:flex-row md:justify-between md:items-end mb-12">
      <div>
