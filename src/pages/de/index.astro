---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
const homeStudies = [
  {
    href: '/de/fallstudien/karriereportal-automotive',
    category: 'ŠKODA AUTO · Karriereportal',
    title: '40 % der Bewerber fanden nicht zu den offenen Stellen. Die Website „wirkte dabei übersichtlich".',
    method: 'Eye-Tracking + Fragebogen · N = 102',
    result: '4 von 10 fanden keine Stellen',
  },
  {
    href: '/de/fallstudien/backend-stories',
    category: 'Edukative Microsite',
    title: 'Je länger der Text, desto weniger Aufmerksamkeit.',
    method: 'Eye-Tracking, AOI-Analyse · ca. 120 Probanden',
    result: '92 % nahmen den CTA wahr',
  },
  {
    href: '/de/fallstudien/werbebanner-blickrichtung',
    category: 'Werbekreation',
    title: 'Der Blick der Figur lenkte die Aufmerksamkeit der Besucher.',
    method: 'Eye-Tracking-Experiment · N = 104',
    result: 'ηp² = 0,11 · mittlerer Effekt',
  },
];

const gifSrc = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/hero.webp`;
const yearSuffix = new Date().getFullYear().toString().slice(-2);

const clientLogos = [
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/skoda.webp`, w: 1920, h: 630, alt: 'Škoda Auto' , dh: 50 },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/fchk.webp`, w: 800, h: 800, alt: 'FC Hradec Králové' , dh: 54 },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`, w: 157, h: 37, alt: 'Univerzita Hradec Králové' },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/texopluslogo.webp`, w: 216, h: 46, alt: 'TEXO Plus' },
];
---

<BaseLayout lang="de" title="UX-Forschung, Eye Tracking und Nutzertests | UXMIND" description="Nutzertests, Eye Tracking und Messung der kognitiven Belastung (Modell EMLI). Objektive UX-Forschung mit wissenschaftlichem Hintergrund der FIM UHK. Testen Sie Ihre Website anhand von Daten." preloadImage={{ href: gifSrc, media: "(min-width: 768px)" }}>
  <Navbar />

  <!-- HERO SECTION -->
  <section class="hero-shell relative overflow-hidden" style="background:#FDFDFD;">

    <!-- Background grid: 4 columns × 3 rows, plus markers at intersections -->
    <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true"
      style="background-image: linear-gradient(rgba(10,10,10,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.07) 1px, transparent 1px); background-size: 25% 33.333%;">
      <div class="hidden md:block">
      {[0, 25, 50, 75, 100].flatMap(x =>
        [0, 33.333, 66.667, 100].map(y => (
          <div class="absolute" style={`left:${x}%; top:${y}%; width:14px; height:14px; transform:translate(-50%,-50%); background:linear-gradient(rgba(10,10,10,0.22),rgba(10,10,10,0.22)) center/14px 1px no-repeat, linear-gradient(rgba(10,10,10,0.22),rgba(10,10,10,0.22)) center/1px 14px no-repeat;`}></div>
        ))
      )}
      </div>
    </div>

    <!-- Center CTA — pod středovým obrázkem, na ose řádku mřížky se specializacemi -->
    <div class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 z-[60] hidden md:block" style="top: 83.333%;">
      <a href="/de/kontakt" class="inline-block bg-brand-black text-brand-white border border-brand-black px-6 py-2 font-mono text-xs tracking-widest uppercase transition-colors duration-200 hover:bg-transparent hover:text-brand-black">
        TERMIN VEREINBAREN
      </a>
    </div>

    <!-- Large headline — top-aligned s horní linkou (stejná výška jako začínala horní tabulka) -->
    <div class="absolute z-10" style="left: var(--desktop-gutter); top: calc(var(--desktop-top-offset) + 3rem); line-height: 1; margin: 0; padding: 0;">
      <h1 class="m-0 p-0 relative" style="line-height:0;">
        <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logo-2line.svg`} alt="UX Mind" width="264" height="88" style="width: clamp(8.4rem, 16.8vw, 264px); height:auto; display:block;" />
        <!-- Easter egg: hotspot nad modrou tečkou loga + záslepka, když tečka "uteče" -->
        <span id="logo-dot-hotspot" class="hidden md:block" style="position:absolute; left:89%; top:64%; width:14%; height:24%;"></span>
        <span id="logo-dot-patch" style="position:absolute; left:92.4%; top:69%; width:8%; height:14%; background:#FCFCFC; border-radius:50%; display:none;"></span>
      </h1>
      <!-- Mobile-only: first annotation below heading -->
      <p class="md:hidden font-mono tracking-widest text-brand-black/70 mt-3" style="font-size:10px;">FORSCHUNG STATT VERMUTUNGEN</p>
    </div>

    <!-- Mobile hero image — static, shown immediately -->
    <div class="md:hidden absolute left-0 right-0 flex items-center justify-center" style="top: 33.333%; height: 33.334%;">
      <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/hero-mobile.webp`} alt="UX Mind — UX-Forschung und Eye-Tracking" style="width:100%; height:auto; object-fit:contain;" width="800" height="450" fetchpriority="high" decoding="async" />
    </div>

    <!-- Center 3D Brain — desktop only -->
    <div class="hidden md:flex absolute inset-0 items-center justify-center">
      <div id="hero-gif-container" class="relative" style="width: min(48vw, 760px); height: min(50vh, 540px);">
        <!-- Hero GIF - plays once then freezes on last frame -->
        <img
          id="hero-gif"
          src={gifSrc}
          alt="Animiertes neuronales Netz — Visualisierung der Verbindung von UX-Forschung, Eye-Tracking und Daten"
          class="w-full h-full object-contain"
          width="960" height="540" loading="lazy" decoding="async"
        />

        <!-- Annotation: top — text visible in hero below CTA, line goes down into image -->
        <div class="ann absolute hidden md:flex flex-col items-center opacity-0" style="left:50%; top:-30px; transform:translateX(-50%);">
          <p class="font-mono hero-fluid-micro tracking-widest text-center mb-1 max-w-32">FORSCHUNG STATT<br/>VERMUTUNGEN</p>
          <div class="ann-line w-px bg-brand-black" style="height:0;" data-size="200"></div>
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
        </div>

        <!-- Annotation: left — text left of container, dot at 22% from left -->
        <div class="ann absolute hidden md:flex items-center opacity-0" style="left:22%; top:42%; transform:translate(-100%,-50%);">
          <div class="text-right mr-2">
            <p class="font-mono hero-fluid-micro tracking-widest">DESIGN BEGINNT<br/>BEIM NUTZER</p>
          </div>
          <div class="ann-line h-px bg-brand-black" style="width:0;"></div>
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
        </div>

        <!-- Annotation: right top — text right of container, dot at 22% from right; top 40% = pod spodní hranou stats boxu -->
        <div class="ann absolute hidden md:flex items-center opacity-0" style="right:22%; top:40%; transform:translate(100%,-50%);">
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
          <div class="ann-line h-px bg-brand-black" style="width:0;" data-size="110"></div>
          <div class="ml-2">
            <p class="font-mono hero-fluid-micro tracking-widest">EYE TRACKING<br/>ZEIGT, WAS<br/>MENSCHEN SEHEN</p>
          </div>
        </div>

        <!-- Annotation: right bottom — text right of container, dot at 22% from right -->
        <div class="ann absolute hidden md:flex items-center opacity-0" style="right:22%; top:65%; transform:translate(100%,-50%);">
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
          <div class="ann-line h-px bg-brand-black" style="width:0;" data-size="110"></div>
          <div class="ml-2">
            <p class="font-mono hero-fluid-micro tracking-widest">MESSEN<br/>VERSTEHEN<br/>VERBESSERN</p>
          </div>
        </div>

        <!-- Annotation: bottom — text below container, dot at 18% from bottom -->
        <div class="ann absolute hidden md:flex flex-col items-center opacity-0" style="left:50%; bottom:35%; transform:translate(-50%,100%);">
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
          <div class="ann-line w-px bg-brand-black" style="height:0;"></div>
          <p class="font-mono hero-fluid-micro tracking-widest text-center mt-1 max-w-24">DATEN<br/>STATT EINDRÜCKE</p>
        </div>

      </div>
    </div><!-- end desktop gif container -->

    <!-- Info box: stats (top right) -->

    <!-- Core services — vertically centered in 3rd grid rectangle (66.667%–100%) -->
    <div class="hero-spec-list absolute z-10" style="left: var(--desktop-gutter); top: 83.333%; transform: translateY(-50%);">
      <p class="font-mono text-xs tracking-widest mb-4 text-brand-black/60">[ UNSERE SPEZIALISIERUNG ]</p>
      <div class="space-y-3">
        {[
          { num: '01', label: 'UX AUDIT' },
          { num: '02', label: 'NUTZERTESTS' },
          { num: '03', label: 'EYE TRACKING' },
          { num: '04', label: 'FELDFORSCHUNG' },
          { num: '05', label: 'UX-FORSCHUNG' },
        ].map((item) => (
          <div class="flex items-center gap-2">
            <p class="font-mono text-xs text-brand-black/60 shrink-0">{item.num}.</p>
            <span class="spec-dashes font-mono text-xs tracking-tight">
              {Array.from({length: 20}).map(() => (
                <span style="color:rgb(200,200,200); transition:color 0.8s ease;">|</span>
              ))}
            </span>
            <p class="font-mono text-xs font-medium tracking-widest whitespace-nowrap">{item.label}</p>
          </div>
        ))}
      </div>
      <div class="flex items-center gap-3 mt-3">
        <p id="local-time" class="font-mono text-xs tracking-widest">PRG --:-- -- &nbsp; --/--/----</p>
      </div>
    </div>

    <!-- Info box: about us — fills right half of bottom grid rectangle -->
    <div id="info-box" class="hidden md:flex absolute z-30 border border-brand-black bg-brand-black text-brand-white flex-col"
      style="left:calc(75% + clamp(12px,1.8vw,32px)); right: var(--desktop-gutter); top: 83.333%; transform: translateY(-50%); padding:clamp(8px,1.1vh,18px) clamp(10px,1.2vw,20px);">
      <div>
        <div class="mb-2">
          <p class="font-mono font-medium tracking-widest bg-brand-white text-brand-black px-1 py-0.5 block w-full" style="font-size:calc(clamp(11px,0.85vw,13px) * min(var(--fs, 1), 1.08));">KEINE AGENTUR – SPEZIALISTEN</p>
        </div>
        <p class="font-mono text-brand-white/90 leading-relaxed infobox-desc" style="font-size:calc(clamp(11px,0.85vw,13px) * min(var(--fs, 1), 1.08));">
          Wir sind ein Team von UX-Spezialisten. Wir helfen Unternehmen, ihre Nutzer durch Daten, Forschung und Eye-Tracking zu verstehen.
        </p>
      </div>
      <div class="shrink-0" style="margin-top:clamp(10px,1.4vh,20px);">
        <div class="pt-2 border-t border-brand-white/20 flex flex-col items-start gap-1.5">
          <p class="font-mono text-brand-white/75 tracking-widest whitespace-nowrap" style="font-size:calc(clamp(10px,0.75vw,12px) * min(var(--fs, 1), 1.08));">PROJEKT MIT:</p>
          <img width="157" height="37" loading="lazy" decoding="async" src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`} alt="Univerzita Hradec Králové" class="max-w-full shrink-0" style="height:clamp(24px,2.8vh,40px); object-fit:contain; margin-top:4px; margin-bottom:4px; filter: invert(1);" />
        </div>
      </div>
    </div>

    <!-- Cursor dot — only in hero area -->
    <div id="cursor-dot" style="position:fixed;top:0;left:0;width:8px;height:8px;background:#2D62FC;border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);opacity:0;"></div>

    <!-- Scroll indicator -->
    <button type="button" aria-label="Zum Inhalt scrollen" class="hidden md:flex absolute bottom-6 z-10 flex-col items-start gap-2 animate-bounce cursor-pointer" style="left: 50%;" onclick="window.scrollBy({ top: window.innerHeight * 0.6, behavior: 'smooth' })">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest" style="transform: translateX(-50%);">SCROLL</p>
      <div class="h-8 bg-brand-black/20" style="width: 1px;"></div>
    </button>
  </section>

  <main id="main-content">

  <!-- Mobile info box — NE AGENTURA, above logo carousel -->
  <div class="md:hidden border border-brand-black bg-brand-black text-brand-white mx-6 my-8 p-6 flex flex-col gap-4">
    <div>
      <p class="font-mono font-medium tracking-widest bg-brand-white text-brand-black px-1 py-0.5 block w-full" style="font-size:12px;">KEINE AGENTUR – SPEZIALISTEN</p>
    </div>
    <p class="font-mono text-sm text-brand-white/90 leading-relaxed">Wir sind ein Team von UX-Spezialisten. Wir helfen Unternehmen, ihre Nutzer durch Daten, Forschung und Eye-Tracking zu verstehen.</p>
    <div class="flex gap-2">
      <a href="/de/ueber-uns" class="font-mono text-xs border border-brand-white px-2 py-1">ÜBER UNS</a>
      <a href="/de/kontakt" class="font-mono text-xs border border-brand-white px-2 py-1">KONTAKT</a>
    </div>
    <div class="border-t border-brand-white/20 pt-2 flex items-center justify-between">
      <p class="font-mono text-[11px] text-brand-white/75 tracking-widest">PROJEKT MIT:</p>
      <img width="157" height="37" loading="lazy" decoding="async" src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`} alt="Univerzita Hradec Králové" class="h-[40px] w-auto ml-6 my-1" style="filter: invert(1);" />
    </div>
  </div>

  <!-- LOGO STRIP -->
  <div class="border-y border-brand-black/10 py-6" style="background:#FDFDFD;">
    <!-- Desktop: statický pás -->
    <div class="hidden md:flex flex-wrap items-center justify-center gap-x-14 gap-y-6 px-6">
      {clientLogos.map(({ src, alt, w, h, dh }) => (
        <div class="px-4 py-1">
          <img
            src={src}
            alt={alt}
            title={alt}
            width={w} height={h}
            class="logo-strip-img select-none"
            style={`height:${dh || 42}px; width:auto; max-width:170px; object-fit:contain; display:block;`}
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
    <!-- Mobil: automatický carousel, dvě loga na řádek -->
    <div class="md:hidden overflow-hidden">
      <div class="logo-marquee flex items-center">
        {[...clientLogos, ...clientLogos].map(({ src, alt, w, h, dh }) => (
          <div class="flex-shrink-0 flex justify-center items-center px-4" style="width:50vw;">
            <img
              src={src}
              alt={alt}
              title={alt}
              width={w} height={h}
              class="logo-strip-img select-none"
              style={`height:${dh ? Math.round(dh * 36 / 42) : 36}px; width:auto; max-width:40vw; object-fit:contain; display:block;`}
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <style>
    .logo-strip-img {
      filter: grayscale(1);
      opacity: 0.65;
    }
    .logo-marquee {
      width: max-content;
      /* smyčka je jen vizuální (transform) — loga se stahují jednorázově a běží z cache */
      animation: logo-scroll 10s linear infinite;
    }
    @keyframes logo-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(-150vw); }
    }
    @media (prefers-reduced-motion: reduce) {
      .logo-marquee { animation: none; }
    }
  </style>

  <!-- TŘI OTÁZKY, TŘI MĚŘENÍ -->
  <section class="desktop-gutter-x pt-24 pb-12 max-w-7xl mx-auto">
    <div class="mb-12 max-w-3xl">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ DREI FRAGEN, DREI MESSUNGEN ]</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">Was Nutzer sehen, wie sie reagieren<br/>und was sie belastet<span style="color:#2D62FC">.</span></h2>
      <p class="text-sm text-brand-black/60 leading-relaxed">
        Analytics zeigt, WOHIN Menschen geklickt haben. Umfragen zeigen, WAS sie denken. Wir messen die dritte Ebene:
        was sie tatsächlich gesehen haben, wie stark sie reagiert haben und wo die Oberfläche sie mental überlastet hat.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10">
      {[
        {
          q: 'Sehen sie es überhaupt?',
          desc: 'Visuelle Aufmerksamkeit — Heatmaps, Fixationen, TTFF, Dwell Time, AOI-Analyse und Scanpaths. Eye Tracking hält objektiv fest, was Nutzer wirklich gesehen und was sie übersehen haben.',
          tool: 'EYE-TRACKING',
        },
        {
          q: 'Wie stark reagieren sie?',
          desc: 'Physiologische Erregung und mimische Signale im Kontext der Aufgabe. Wir interpretieren sie stets mit ihren Grenzen — kein „Gedankenlesen".',
          tool: 'GSR + MIMISCHE SIGNALE',
        },
        {
          q: 'Schaffen sie es ohne Anstrengung?',
          desc: 'Kognitive Belastung als ein klar verständlicher Score von 0–100. Sie erfahren, wo die Oberfläche Nutzer überlastet, selbst wenn sie die Aufgabe am Ende schaffen.',
          tool: 'MODELL EMLI',
        },
      ].map((item, i) => (
        <div class="bg-brand-white p-8 flex flex-col">
          <p class="font-mono text-xs text-brand-black/60 mb-8">0{i + 1}</p>
          <h3 class="font-display text-2xl font-bold mb-4 leading-tight">{item.q}</h3>
          <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{item.desc}</p>
          <p class="mt-auto"><span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{item.tool}</span></p>
        </div>
      ))}
    </div>
    <!-- Slovníček zkratek -->
    <details class="group border border-brand-black/15 mt-6">
        <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
          [ GLOSSAR ]
          <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <dl class="px-5 pb-6 space-y-4">
            <div><dt class="font-display font-bold mb-1">TTFF</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Zeit bis zur ersten Blickfixation</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">beobachteter Interessenbereich (Area of Interest)</dd></div>
            <div><dt class="font-display font-bold mb-1">Dwell Time</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Gesamtzeit, die der Blick in einem Bereich verweilt</dd></div>
            <div><dt class="font-display font-bold mb-1">Scanpath</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Blickpfad zwischen den Fixationen</dd></div>
            <div><dt class="font-display font-bold mb-1">GSR</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Messung der Hautleitfähigkeit, Indikator physiologischer Erregung</dd></div>
            <div><dt class="font-display font-bold mb-1">EMLI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">aus Eye-Tracking-Metriken abgeleiteter Index der mentalen (kognitiven) Belastung</dd></div>
        </dl>
      </details>
  </section>

  <!-- SERVICES SECTION -->
  <section class="desktop-gutter-x py-24 max-w-7xl mx-auto">
    <div class="mb-12 max-w-3xl">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ UNSERE LEISTUNGEN ]</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">Was wir tun<span style="color:#2D62FC">.</span></h2>
      <p class="text-sm text-brand-black/60 leading-relaxed">
        Wir helfen herauszufinden, wo eine Website, App oder Kommunikation Menschen den Weg erschwert. Wir messen das Problem, erklären seine Ursache und empfehlen, was zuerst zu ändern ist.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10">
      {[
        {
          num: '01',
          title: 'UX-Audit',
          desc: 'Wir durchlaufen Ihre Website, Ihren Onlineshop oder Ihre App mit den Augen der Nutzer. Wir finden Stellen, an denen Menschen zögern, eine Bestellung nicht abschließen oder wichtige Informationen übersehen. Sie erhalten eine nach Priorität geordnete Liste an Anpassungen.',
          href: '/de/leistungen/ux-audit',
          tags: ['Analyse', 'Empfehlungen', 'Priorisierung'],
        },
        {
          num: '02',
          title: 'Nutzertests',
          desc: 'Wir geben echten Nutzern konkrete Aufgaben und beobachten, ob sie diese lösen können. Sie sehen, wo sie sich verlieren, was sie nicht verstehen und warum sie abspringen — samt Vorschlägen, was zu ändern ist.',
          href: '/de/leistungen/nutzertests',
          tags: ['Aufgabenszenarien', 'Erfolgsquote', 'Qualitative Einsichten'],
        },
        {
          num: '03',
          title: 'Eye Tracking',
          desc: 'Mit Eye Tracking messen wir, wohin Menschen wirklich schauen. Heatmaps und Blickaufzeichnungen zeigen, was ihnen auffällt, was sie übersehen und ob wichtiger Inhalt sie in die richtige Richtung lenkt.',
          href: '/de/leistungen/eye-tracking',
          tags: ['Heatmap', 'AOI · TTFF', 'Scanpath'],
        },
        {
          num: '04',
          title: 'Feldforschung',
