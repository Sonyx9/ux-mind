---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="de"
  title="Über uns"
  description="Ein Team von UX-Spezialisten für Nutzerforschung, Eye Tracking und UX-Audits. Wir helfen Unternehmen, bessere Produkte zu entwickeln."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ ÜBER UNS ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          EIN TEAM<br/>VON EXPERTEN<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 mb-24">
        <div>
          <p class="text-xl text-brand-black/60 leading-relaxed mb-6">
            UX Mind sind wir zwei: ein <strong class="text-brand-black">Forscher</strong> und ein <strong class="text-brand-black">Stratege</strong>. Wir glauben, dass die besten Produkte aus einem tiefen Verständnis der Menschen entstehen.
          </p>
          <p class="text-brand-black/60 leading-relaxed">
            Einer misst im Labor, der andere überführt die Erkenntnisse in Websites, Onlineshops und Kampagnen. Wir verbinden fortschrittliche Eye-Tracking-Technologie mit bewährten UX-Forschungsmethoden — für Start-ups und Konzerne, die auf Basis von Daten entscheiden wollen, nicht von Annahmen.
          </p>
        </div>
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ UNSERE WERTE ]</p>
          <ul class="space-y-4">
            {[{"title":"Daten statt Eindrücke","desc":"Jede Empfehlung durch Forschung belegt."},{"title":"Empathie für Nutzer","desc":"Wir verstehen Menschen, nicht nur Metriken."},{"title":"Praktische Empfehlungen","desc":"Ergebnisse, die sich wirklich umsetzen lassen."},{"title":"Transparenz","desc":"Klare Kommunikation von Prozess und Ergebnissen."}].map(value => (
              <li class="border-b border-brand-black/10 pb-4">
                <p class="font-semibold mb-1">{value.title}</p>
                <p class="text-sm text-brand-black/60">{value.desc}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ WER WIR SIND ]</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10">

          <div class="bg-brand-white flex flex-col">
            <div class="border-b border-brand-black/10 aspect-[3/2] flex flex-col items-center justify-center text-center px-6" style="background-image: linear-gradient(rgba(10,10,10,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.06) 1px, transparent 1px); background-size: 20% 25%;">
              <p class="font-mono text-[10px] tracking-widest text-brand-black/40 mb-3">[ FOTO FOLGT ]</p>
              <p class="font-display text-lg md:text-xl font-bold text-brand-black/40 leading-snug max-w-xs">Wir messen, wohin Sie schauen. Die Kamera auf uns selbst noch nicht gerichtet.</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase mb-2" style="color:#2D62FC">FORSCHUNG & METHODIK · AUTOR VON EMLI</p>
              <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">Ing. Jan Petružálek, Ph.D.</h2>
              <p class="text-brand-black/60 leading-relaxed mb-4">
                UX-Forscher mit Doktortitel der FIM UHK. In seiner Dissertation verglich und kombinierte er Methoden zur Messung der Nutzererfahrung mit Eye-Tracking-Technologie und schuf die <strong class="text-brand-black">EMLI</strong>-Methodik — einen aus Augenbewegungen berechneten Index der kognitiven Belastung. Jahre von Experimenten im FIMEYELAB-Labor, Hunderte Probanden, Publikationen in HCI und E-Commerce.
              </p>
              <p class="text-brand-black/60 leading-relaxed mb-6">
                Bei UX MIND leitet er die Forschung: Er entwirft Experimente, wacht über die methodische Sauberkeit und entwickelt EMLI an Daten aus realen Projekten weiter.
              </p>
              <a href="https://www.linkedin.com/in/jan-petru%C5%BE%C3%A1lek-79167474/" target="_blank" rel="noopener noreferrer" class="mt-auto self-start inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                LINKEDIN ↗
              </a>
            </div>
          </div>

          <div class="bg-brand-white flex flex-col">
            <div class="border-b border-brand-black/10 aspect-[3/2] flex flex-col items-center justify-center text-center px-6" style="background-image: linear-gradient(rgba(10,10,10,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.06) 1px, transparent 1px); background-size: 20% 25%;">
              <p class="font-mono text-[10px] tracking-widest text-brand-black/40 mb-3">[ FOTO FOLGT ]</p>
              <p class="font-display text-lg md:text-xl font-bold text-brand-black/40 leading-snug max-w-xs">Porträt in Arbeit. Versprochen — kein Stockfoto.</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase mb-2" style="color:#2D62FC">STRATEGIE, WEB & MARKETING</p>
              <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">Mgr. Lukáš Koula</h2>
              <p class="text-brand-black/60 leading-relaxed mb-4">
                Spezialist für E-Commerce und digitales Marketing. Zertifizierter <strong class="text-brand-black">Shoptet Partner</strong> und <strong class="text-brand-black">Google Partner</strong> — er baut Onlineshops und Websites, die verkaufen, und führt Performance-Kampagnen in Google Ads und Sklik.
              </p>
              <p class="text-brand-black/60 leading-relaxed mb-6">
                Bei UX MIND übersetzt er Forschung in die Praxis: Aus Laborerkenntnissen macht er konkrete Änderungen an Websites, Onlineshops und Kampagnen, die sich in Conversions niederschlagen. Er leitet Projekte und die Kommunikation mit Kunden.
              </p>
              <a href="https://www.linkedin.com/in/lukaskoula/" target="_blank" rel="noopener noreferrer" class="mt-auto self-start inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                LINKEDIN ↗
              </a>
            </div>
          </div>

        </div>
      </div>

      <div class="text-center py-16 border-t border-brand-black/10">
        <h2 class="font-display text-4xl font-bold mb-6">Lassen Sie uns zusammenarbeiten</h2>
        <a href="/de/kontakt" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
          SCHREIBEN SIE UNS →
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
