---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { localizedPath } from '../../i18n/utils';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const vrstvy = [
  {
    t: 'Visuelle Aufmerksamkeit',
    d: 'Wohin ein Mensch blickt, in welcher Reihenfolge, wie lange er dort verweilt und was er völlig übersieht. Heatmaps, Interessensbereiche, Zeit bis zur ersten Fixation, Betrachtungsdauer.',
    tag: 'EYE TRACKING',
  },
  {
    t: 'Emotionen und Aktivierung',
    d: 'Was ein Fragebogen nicht erfasst, weil der Mensch es nicht weiß oder nicht zugibt. Die Hautleitfähigkeit misst die physiologische Reaktion, die Mimikanalyse erkennt den Gesichtsausdruck.',
    tag: 'GSR + MIMIK',
  },
  {
    t: 'Kognitive Belastung',
    d: 'Wie viel Anstrengung die Nutzung einer Oberfläche kostet. Belastung ist der stille Killer von Conversion und Verständlichkeit — der Nutzer geht nicht mit dem Gedanken „das war anstrengend“, er geht einfach.',
    tag: 'MENTALE ANSTRENGUNG',
  },
];

const vybaveni = [
  { nazev: 'Smart Eye Aurora', typ: 'stationäres Eye Tracking', k: 'Aktuelle Konfiguration für kontrollierte Studien am Bildschirm.' },
  { nazev: 'Tobii Pro X2-60', typ: 'stationäres Eye Tracking', k: '60-Hz-Plattform, tragbares Setup für fixationsorientierte Studien.' },
  { nazev: 'Pupil Labs Neon (2×)', typ: 'mobile Brille', k: 'Messung in realer Umgebung — Verkaufsraum, Stadion, Verkehr, Straße.' },
  { nazev: 'iMotions + Mimikanalyse', typ: 'Software', k: 'Synchronisation aller Signale mit den Stimuli und Erkennung des Gesichtsausdrucks.' },
  { nazev: 'Shimmer3 GSR', typ: 'Biometrie', k: 'Hautleitfähigkeit — physiologische Reaktion und Aktivierungsgrad.' },
];

const postup = [
  { num: '01', title: 'Studiendesign', desc: 'Forschungsfrage, Definition der Metriken, Größe und Struktur der Stichprobe, Aufgabenszenarien.' },
  { num: '02', title: 'Datenerhebung', desc: 'Protokoll für Labor oder Feld, Kalibrierung, Stimuli, gleichzeitige Aufzeichnung aller Signale.' },
  { num: '03', title: 'Analyse', desc: 'Metriken über Interessensbereichen, zeitliche Kennzahlen, Verknüpfung von Blick und Biometrie, Statistik.' },
  { num: '04', title: 'Transfer in die Praxis', desc: 'Priorisierte Empfehlungen, Report mit Methodik und Workshop mit Ihrem Team.' },
];

const rizika = [
  'Kalibrierungsdrift im Laufe der Messung',
  'Ermüdung der Probanden',
  'Reihenfolgeeffekt — daher Randomisierung und Ausbalancierung',
  'mehrdeutig gestellte Aufgabe',
  'Überbewertung einer einzelnen Metrik',
];

const etika = [
  'Standardisiertes Protokoll und Pilottest vor jeder Studie',
  'Informierte Einwilligung jedes Probanden',
  'Datenverarbeitung nach DSGVO, in der Regel unter NDA',
  'Möglichkeit vollständig anonymisierter Daten und eines reproduzierbaren Reports',
  'Bei Forschungsprojekten bei Bedarf Bewertung durch eine Ethikkommission',
];

const tymLaboratore = [
  ['01', 'Forschungsleitung'],
  ['01', 'Senior-Forscher'],
  ['01', 'Laborverwaltung'],
  ['02', 'Senior-Operatoren'],
  ['06', 'Junior-Operatoren'],
];

const pageSchema = [
  {
    '@type': 'ResearchOrganization',
    name: 'FIMEYELAB',
    description:
      'Labor für Eye Tracking und Biometrie der Fakultät für Informatik und Management der Universität Hradec Králové. Messung von visueller Aufmerksamkeit, emotionaler Reaktion und kognitiver Belastung im Labor und im Feld.',
    parentOrganization: {
      '@type': 'CollegeOrUniversity',
      name: 'Univerzita Hradec Králové — Fakulta informatiky a managementu',
    },
  },
  {
    '@type': 'AboutPage',
    name: 'Über uns — Labor FIMEYELAB',
    description:
      'UX MIND misst im Labor FIMEYELAB an der FIM UHK. Fünf Messsysteme, acht Fachpublikationen, zwei verteidigte Dissertationen.',
  },
];
---

<BaseLayout
  lang="de"
  title="Labor FIMEYELAB | Wer hinter UX MIND steht"
  description="Wir messen nicht im Besprechungsraum. UX MIND misst im Labor FIMEYELAB an der Fakultät für Informatik und Management der UHK — fünf Messsysteme, acht Fachpublikationen, zwei verteidigte Dissertationen."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ ÜBER UNS / LABOR ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          LABOR,<br/>KEINE AGENTUR<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl mb-4">
              UX-Agenturen gibt es viele. Labore, die Augenbewegungen, Hautleitfähigkeit und Mimik
              gleichzeitig messen — und Publikationen in begutachteten Fachzeitschriften vorweisen können — gibt es deutlich weniger.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              UX MIND misst im Labor <strong class="text-brand-black">FIMEYELAB</strong> an der Fakultät für Informatik
              und Management der Universität Hradec Králové. Das ist keine Marketing-Zierde: Es bedeutet methodische Kontrolle,
              Geräte, die sich eine kommerzielle Agentur nicht anschafft, und die Pflicht, jede Schlussfolgerung vor einem Gutachter zu verteidigen.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href={localizedPath('de', 'contact')} class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              BESUCH VEREINBAREN →
            </a>
            <a href={localizedPath('de', 'case-studies')} class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              FALLSTUDIEN
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['MESSSYSTEME', '5'],
          ['FACHPUBLIKATIONEN', '8'],
          ['VERTEIDIGTE DISSERTATIONEN', '2'],
          ['WIR MESSEN', 'Labor und Feld'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight text-xl">{v}</p>
          </div>
        ))}
      </div>

      <!-- Foto laboratoře -->
      <div class="reveal mb-24 grid grid-cols-1 md:grid-cols-5 gap-8 items-center">
        <div class="md:col-span-2">
          <img
            src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
            alt="Probandin bei der Messung an einem Setup mit Eye Tracker im Labor FIMEYELAB"
            title="Messung im Labor FIMEYELAB"
            width="1080" height="1920" loading="lazy" decoding="async"
            class="w-full border border-brand-black/10"
          />
          <p class="font-mono text-[11px] text-brand-black/60 mt-2">
            Labor FIMEYELAB, FIM UHK. Kein Render, kein Stockfoto.
          </p>
        </div>
        <div class="md:col-span-3">
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WAS AUF DIESEM FOTO ZU SEHEN IST ]</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold leading-tight mb-6">
            Nichts davon ist Kulisse<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-black/60 leading-relaxed mb-4">
            Unter dem Monitor sitzt die Leiste des Eye Trackers, die die Augenbewegungen sechzigmal pro Sekunde erfasst.
            Über dem Monitor eine Kamera für die Mimikanalyse. Die Probandin erfüllt eine gestellte Aufgabe auf einer echten Seite
            — sie kommentiert nicht, was ihr gefällt.
          </p>
          <p class="text-brand-black/60 leading-relaxed">
            Genau darin liegt der Unterschied zwischen einer Messung und einer Fokusgruppe. Wir fragen die Menschen nicht, was sie glauben,
            zu tun. Wir sehen, was sie tatsächlich tun.
          </p>
        </div>
      </div>

      <!-- Jak to spolu souvisí -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-12">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WIE DAS ZUSAMMENHÄNGT ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-8 max-w-3xl">
          Universitäres Labor, kommerzielles Tempo<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <p class="font-mono text-xs tracking-widest mb-2" style="color:#2D62FC">LABOR</p>
            <p class="text-brand-black/60 leading-relaxed text-sm">
              FIMEYELAB gehört der Universität Hradec Králové. Es dient der Forschung, der Lehre und der Betreuung von Diplom-
              und Dissertationsarbeiten — und hält damit eine methodische Messlatte, die sich der kommerzielle Betrieb selbst nicht setzt.
            </p>
          </div>
          <div>
            <p class="font-mono text-xs tracking-widest mb-2" style="color:#2D62FC">UX MIND</p>
            <p class="text-brand-black/60 leading-relaxed text-sm">
              Kommerzielle Aufträge im Labor laufen immer über UX MIND. Wir sind der Vertragspartner, mit dem
              Sie den Auftrag unterzeichnen, einen Termin, einen Preis und ein Ergebnis erhalten — und der für das Resultat verantwortlich ist.
            </p>
          </div>
          <div>
            <p class="font-mono text-xs tracking-widest mb-2" style="color:#2D62FC">BINDEGLIED</p>
            <p class="text-brand-black/60 leading-relaxed text-sm">
              Jan Petružálek ist Leiter des Labors FIMEYELAB und zugleich Mitinhaber von UX MIND.
              Methodik und Ausführung sind so keine zwei Welten, die sich etwas über den Zaun zuwerfen.
            </p>
          </div>
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Praktisch bedeutet das für Sie nur eines: Sie erhalten akademische Methodik ohne akademische Fristen.
          So haben wir das Karriereportal für <strong class="text-brand-black">ŠKODA AUTO</strong> gemessen,
          die Kampagne eines Fußballvereins sowie Produktseiten von Online-Shops.
        </p>
      </div>

      <!-- Co umíme změřit -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WAS WIR MESSEN KÖNNEN ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Drei Ebenen dessen, was im Kopf des Nutzers passiert<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {vrstvy.map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Die Methoden kontrollieren sich gegenseitig. Wenn das Eye Tracking langes Betrachten zeigt, die Biometrie erhöhte
          Aktivierung und der Fragebogen Ruhe, wissen wir, dass etwas passiert — und wir wissen, wo.
        </p>
      </div>

      <!-- Čím měříme -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WOMIT WIR MESSEN ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Fünf Systeme, eine synchronisierte Aufzeichnung<span style="color:#2D62FC">.</span>
        </h2>
        <div class="border border-brand-black/10">
          {vybaveni.map(z => (
            <div class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-6 p-6 border-b border-brand-black/10 last:border-0">
              <div class="md:col-span-4">
                <p class="font-display text-lg font-bold leading-tight">{z.nazev}</p>
                <p class="font-mono text-[11px] text-brand-black/60 tracking-wide uppercase">{z.typ}</p>
              </div>
              <p class="md:col-span-8 text-sm text-brand-black/60 leading-relaxed">{z.k}</p>
            </div>
          ))}
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Zwei mobile Brillen bedeuten, dass wir zwei Personen gleichzeitig messen können — oder weitermachen, während ein
          Satz gerade lädt. Im Feld ist das der Unterschied zwischen „wir haben es geschafft“ und „wir kommen nächstes Mal“.
        </p>
      </div>

      <!-- Vizualizace laboratoře -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/laborator-ux-vyzkumu-vizualizace-1.webp`}
          alt="Visualisierung der geplanten Anordnung des Labors FIMEYELAB"
          title="Geplante Anordnung des Labors"
          width="1600" height="1127" loading="lazy" decoding="async"
          class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">
          Visualisierung der geplanten Anordnung des Labors — getrennte Messplätze für paralleles Testen.
        </p>
      </div>

      <!-- Jak měření probíhá -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ WIE EINE MESSUNG ABLÄUFT ]</p>
          <div class="space-y-0">
            {postup.map(step => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ WORAUF WIR IM PROTOKOLL ACHTEN ]</p>
          <ul class="space-y-2 mb-6">
            {rizika.map(r => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {r}
              </li>
            ))}
          </ul>
          <p class="text-sm text-brand-black/60 leading-relaxed">
            Diese Liste ist der Grund, warum eine Messung im Labor nicht dasselbe ist wie „wir haben uns eine Bildschirmaufnahme angeschaut“.
            Jeder dieser fünf Punkte kann das Ergebnis auf den Kopf stellen, und alle lassen sich nur vorab absichern.
          </p>
        </div>
      </div>

      <!-- Akademické zázemí -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ AKADEMISCHER HINTERGRUND ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Das, was Sie bei einer Agentur nicht erfahren<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          <div class="bg-brand-white p-8">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">PUBLIKATIONEN</p>
            <p class="font-display text-5xl font-bold mb-2">8</p>
            <p class="text-sm text-brand-black/60 leading-relaxed mb-6">
              Fachpublikationen mit Fokus auf Eye Tracking.
            </p>
            <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-2">Q1-ZEITSCHRIFT (2021–2025)</p>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Franěk, M., &amp; Petružálek, J. (2025). <em>Perceptual fluency and eye movements when viewing
              urban and natural scenes.</em> Scientific Reports, 15(1), Art. 25772.
            </p>
          </div>
          <div class="bg-brand-white p-8">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">HOCHSCHULE UND NACHWUCHS</p>
            <ul class="space-y-3 text-sm text-brand-black/60 leading-relaxed">
              <li class="pb-3 border-b border-brand-black/5">
                <strong class="text-brand-black">2 verteidigte Dissertationen</strong><br/>
                Jan Petružálek (2023) — Komparace a kombinace metod měření uživatelské zkušenosti
                s využitím eye-tracking technologie<br/>
                Denis Šefara (2022) — Business dashboardy pracující s pozorností uživatele
              </li>
              <li class="pb-3 border-b border-brand-black/5">
                <strong class="text-brand-black">8 verteidigte Diplom- und Bachelorarbeiten</strong><br/>
                2 Master-, 6 Bachelorarbeiten
              </li>
              <li>
                <strong class="text-brand-black">10 neue Themen für das Jahr 2025/2026</strong><br/>
                davon 5 mit Fokus auf Eye Tracking
              </li>
            </ul>
          </div>
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Studierende sind keine billige Arbeitskraft. Sie sind der Grund, warum das Labor seine eigenen Methoden ständig
          an neuen Aufgabenstellungen erprobt — und warum man sich darin nicht bei einem einzigen Vorgehen einrichten kann.
        </p>
      </div>

      <!-- Lidé -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ MENSCHEN ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6 max-w-3xl">
          Die Firma führen wir zu zweit. Die Messungen machen nicht zwei<span style="color:#2D62FC">.</span>
        </h2>
        <p class="text-brand-black/60 leading-relaxed max-w-3xl mb-10">
          UX MIND hat zwei Gesellschafter. Hinter Erhebung und Verarbeitung der Daten steht das Team des Labors — Forschungsleitung,
          Laborverwaltung und geschulte Operatoren.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mb-px">

          <!-- Jan Petružálek -->
          <div class="bg-brand-white flex flex-col">
            <div class="border-b border-brand-black/10 aspect-[3/2] flex flex-col items-center justify-center text-center px-6" style="background-image: linear-gradient(rgba(10,10,10,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.06) 1px, transparent 1px); background-size: 20% 25%;">
              <p class="font-mono text-[10px] tracking-widest text-brand-black/40 mb-3">[ FOTO IN VORBEREITUNG ]</p>
              <p class="font-display text-lg md:text-xl font-bold text-brand-black/40 leading-snug max-w-xs">Wir messen, wohin Sie blicken. Auf uns selbst haben wir die Kamera noch nicht gerichtet.</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase mb-2" style="color:#2D62FC">LEITER DES LABORS FIMEYELAB · MITINHABER UX MIND</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-4">Ing. Jan Petružálek, Ph.D.</h3>
              <p class="text-brand-black/60 leading-relaxed mb-6">
                Leitet Labor und Forschung: entwirft Experimente, wacht über die methodische Sauberkeit der Messungen und verantwortet
                die Interpretation der Daten. Promotion an der FIM UHK, Dissertation über die Kombination von Methoden zur Messung der
                Nutzererfahrung mit Eye Tracking, Publikationen im Bereich HCI und E-Commerce.
              </p>
              <a href="https://www.linkedin.com/in/jan-petru%C5%BE%C3%A1lek-79167474/" target="_blank" rel="noopener noreferrer" class="mt-auto self-start inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                LINKEDIN ↗
              </a>
            </div>
          </div>

          <!-- Lukáš Koula -->
          <div class="bg-brand-white flex flex-col">
            <div class="border-b border-brand-black/10 aspect-[3/2] flex flex-col items-center justify-center text-center px-6" style="background-image: linear-gradient(rgba(10,10,10,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.06) 1px, transparent 1px); background-size: 20% 25%;">
              <p class="font-mono text-[10px] tracking-widest text-brand-black/40 mb-3">[ FOTO IN VORBEREITUNG ]</p>
              <p class="font-display text-lg md:text-xl font-bold text-brand-black/40 leading-snug max-w-xs">Porträt in Arbeit. Versprochen — kein Stockfoto.</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase mb-2" style="color:#2D62FC">STRATEGIE, WEB UND MARKETING · MITINHABER UX MIND</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-4">Mgr. Lukáš Koula</h3>
              <p class="text-brand-black/60 leading-relaxed mb-6">
                Überträgt Forschung in die Praxis: aus Laborerkenntnissen macht er konkrete Anpassungen an Websites, Online-Shops
                und Kampagnen. Zertifizierter Shoptet Partner und Google Partner. Leitet Projekte und die Kommunikation
                mit den Kunden.
              </p>
              <a href="https://www.linkedin.com/in/lukaskoula/" target="_blank" rel="noopener noreferrer" class="mt-auto self-start inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                LINKEDIN ↗
              </a>
            </div>
          </div>
        </div>

        <!-- Tým laboratoře -->
        <div class="border border-brand-black/10 p-8 md:p-10">
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ LABORTEAM ]</p>
          <div class="border border-brand-black/10 divide-y divide-brand-black/10 mb-6">
            {tymLaboratore.map(([pocet, role]) => (
              <div class="flex items-center gap-4 md:gap-6 px-4 py-4 md:px-6">
                <p class="font-mono text-[11px] text-brand-black/70 tracking-wide uppercase leading-snug w-28 md:w-44 shrink-0">{role}</p>
                <div class="flex flex-wrap gap-1.5 flex-1 min-w-0">
                  {Array.from({ length: Number(pocet) }).map(() => (
                    <span class="w-3.5 h-3.5 bg-brand-black" aria-hidden="true"></span>
                  ))}
                </div>
                <p class="font-mono text-[11px] text-brand-black/40 tabular-nums shrink-0 w-6 text-right">{pocet}</p>
              </div>
            ))}
          </div>
          <p class="text-sm text-brand-black/60 leading-relaxed max-w-3xl">
            Die Datenerhebung übernehmen geschulte Operatoren nach Protokoll. Darauf beruht die Wiederholbarkeit — das Ergebnis
            einer Messung darf nicht davon abhängen, wer gerade am Rechner sitzt.
          </p>
        </div>
      </div>

      <!-- Etika a data -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ ETHIK UND DATEN ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">
              Wir messen Menschen Augen, Haut und Gesichtsausdruck<span style="color:#2D62FC">.</span>
            </h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Das ist kein Abschnitt für die Fußzeile. Ohne ordentliches Protokoll und Einwilligung wird bei uns nichts gemessen.
            </p>
          </div>
          <ul class="space-y-2">
            {etika.map(e => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5 last:border-0">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {e}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- CTA -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            MÖCHTEN SIE<br/>VORBEIKOMMEN<span style="color:#2D62FC">?</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            Das Labor lässt sich besuchen. Wir zeigen die Ausstattung, spielen eine echte Messaufzeichnung ab und sagen Ihnen direkt,
            ob eine Messung bei Ihrer Aufgabenstellung Sinn ergibt — oder ob Ihnen ein günstigeres Werkzeug genügt.
          </p>
          <a href={localizedPath('de', 'contact')} class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
            BESUCH VEREINBAREN →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
