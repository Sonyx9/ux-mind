---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const vystupyMereni = [
  ['Aufmerksamkeit', 'Welche Elemente der Nutzer wahrnimmt, in welcher Reihenfolge und was er völlig übersieht.'],
  ['Aufgabenverlauf', 'Wo er zügig vorankommt, wo er zurückgeht und bei welchem Schritt er stockt.'],
  ['Reaktion', 'An welchen Stellen die Aktivierung oder die mentale Belastung ansteigt.'],
];

const vrstvy = [
  {
    t: 'Visuelle Aufmerksamkeit',
    d: 'Eye Tracking zeigt, wohin der Nutzer blickt, in welcher Reihenfolge und was er völlig übersieht. Wir stellen auch fest, wie schnell er ein wichtiges Element findet und wie lange er ihm Aufmerksamkeit schenkt.',
    tag: 'EYE TRACKING',
  },
  {
    t: 'Emotionale Reaktion',
    d: 'Die Hautleitfähigkeit erfasst Veränderungen der physiologischen Aktivierung, die Mimikanalyse den Gesichtsausdruck. Beide helfen, die Momente zu bestimmen, die eine Reaktion auslösen — sagen aber allein nicht, warum sie entstand.',
    tag: 'GSR + MIMIK',
  },
  {
    t: 'Mentale Belastung',
    d: 'Wir messen, wo die Oberfläche mehr Aufmerksamkeit und Anstrengung verlangt. Wir decken Stellen auf, die Nutzer verlangsamen, verwirren oder den Abschluss der Aufgabe unnötig erschweren.',
    tag: 'MENTALE ANSTRENGUNG',
  },
];

const vybaveni = [
  { nazev: 'Smart Eye Aurora', typ: 'stationäres Eye Tracking', k: 'Präzise Blickverfolgung beim Testen von Websites, Apps und anderen digitalen Oberflächen.' },
  { nazev: 'Tobii Pro X2-60', typ: 'stationäres Eye Tracking', k: 'Tragbarer Eye Tracker für Bildschirmstudien und den Vergleich verschiedener Varianten.' },
  { nazev: 'Pupil Labs Neon (2×)', typ: 'mobiles Eye Tracking', k: 'Brille zur Erfassung der Aufmerksamkeit in Geschäften, Showrooms, Stadien oder im Straßenverkehr.' },
  { nazev: 'iMotions + Mimikanalyse', typ: 'Forschungssoftware', k: 'Verbindet Eye Tracking, Mimik und weitere Signale zu einer zeitlich synchronisierten Aufzeichnung.' },
  { nazev: 'Shimmer3 GSR', typ: 'Biometrie', k: 'Erfasst Veränderungen der Hautleitfähigkeit, die den Grad der physiologischen Aktivierung anzeigen.' },
];

const postup = [
  { num: '01', title: 'Studiendesign', desc: 'Wir klären, was Sie herausfinden möchten, wen es sinnvoll ist zu testen und woran wir das Ergebnis bewerten.' },
  { num: '02', title: 'Vorbereitung und Messung', desc: 'Wir bereiten Aufgaben vor, stellen die Technik ein und führen die Messung im Labor oder direkt im Feld durch.' },
  { num: '03', title: 'Analyse', desc: 'Wir verbinden Blick, Verhalten, Reaktionen und Aussagen der Teilnehmer. Wir suchen Zusammenhänge, keine isolierten Zahlen ohne Kontext.' },
  { num: '04', title: 'Empfehlungen für die Praxis', desc: 'Sie erhalten klare Schlussfolgerungen, Prioritäten und konkrete Empfehlungen, was zu ändern ist.' },
];

const rizika = [
  'die korrekte Kalibrierung während der gesamten Messung',
  'die Ermüdung der Teilnehmer',
  'die Reihenfolge der Aufgaben, damit sie das Ergebnis nicht verfälscht',
  'eine eindeutige und verständliche Aufgabenstellung',
  'dass die Schlussfolgerung nicht nur auf einer einzigen Metrik beruht',
];

const etika = [
  'Standardisiertes Protokoll und Pilottest der Studie',
  'Informierte Einwilligung jedes Teilnehmers',
  'Datenverarbeitung gemäß DSGVO und bei Bedarf auch unter NDA',
  'Möglichkeit der Anonymisierung von Daten und eines Ergebnisberichts mit beschriebener Methodik',
  'Prüfung durch eine Ethikkommission, sofern es die Art des Projekts erfordert',
];

const tymLaboratore = [
  ['02', 'Leitung und Methodik'],
  ['01', 'Laborverwaltung'],
  ['08', 'Geschulte Operatoren'],
];

const pageSchema = [
  {
    '@type': 'ResearchOrganization',
    name: 'FIMEYELAB',
    description:
      'Labor für Eye Tracking und Biometrie der Fakultät für Informatik und Management der Univerzita Hradec Králové. Messung von visueller Aufmerksamkeit, emotionaler Reaktion und kognitiver Belastung im Labor und im Feld.',
    parentOrganization: {
      '@type': 'CollegeOrUniversity',
      name: 'Univerzita Hradec Králové — Fakulta informatiky a managementu',
    },
  },
  {
    '@type': 'AboutPage',
    name: 'Über uns — Labor FIMEYELAB',
    description:
      'UX MIND misst im Labor FIMEYELAB an der FIM UHK. Fünf Messsysteme, acht Fachpublikationen, zwei verteidigte Dissertationen.',
  },
];
---

<BaseLayout
  lang="de"
  title="Labor FIMEYELAB | Wer hinter UX MIND steht"
  description="Wir messen nicht im Besprechungsraum. UX MIND misst im Labor FIMEYELAB an der Fakultät für Informatik und Management der UHK — fünf Messsysteme, acht Fachpublikationen, zwei verteidigte Dissertationen."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ ÜBER UNS / LABOR ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          FORSCHUNG<br/>STATT EINDRÜCKE<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-4xl">
          <div>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify mb-4">
              UX MIND verbindet Erfahrung mit digitalen Produkten und das Forschungsfundament des Labors
              <strong class="text-brand-black">FIMEYELAB</strong> an der Fakultät für Informatik und Management
              der Univerzita Hradec Králové. Mit Eye Tracking, Nutzertests und biometrischen Methoden
              finden wir heraus, was Menschen wirklich sehen, was sie nicht verstehen und wo sie bei Entscheidungen ins Straucheln geraten.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify">
              Das Ergebnis sind nicht nur Heatmaps und Diagramme. Sie erhalten verständliche Schlussfolgerungen
              und konkrete Empfehlungen für Website, App, Kampagne oder physischen Raum.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/de/fallstudien" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              FALLSTUDIEN
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['MESSSYSTEME', '5'],
          ['FACHPUBLIKATIONEN', '8'],
          ['VERTEIDIGTE DISSERTATIONEN', '2'],
          ['WIR MESSEN', 'Labor und Feld'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight text-xl">{v}</p>
          </div>
        ))}
      </div>

      <!-- Foto laboratoře -->
      <div class="reveal mb-24 grid grid-cols-1 md:grid-cols-5 gap-8 items-start">
        <div class="md:col-span-2">
          <img
            src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
            alt="Probandin bei der Messung an einem Setup mit Eye Tracker im Labor FIMEYELAB"
            title="Messung im Labor FIMEYELAB"
            width="1080" height="1920" loading="lazy" decoding="async"
            class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
          />
          <p class="font-mono text-[11px] text-brand-black/60 mt-2">
            Labor FIMEYELAB, Fakultät für Informatik und Management der UHK.
          </p>
        </div>
        <div class="md:col-span-3">
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ MESSUNG IN DER PRAXIS ]</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold leading-tight mb-6">
            Was wir während des Testens beobachten<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-black/60 leading-relaxed text-justify mb-4">
            Der Eye Tracker unter dem Monitor zeichnet die Augenbewegungen sechzigmal pro Sekunde auf.
            Die Kamera über dem Monitor erfasst die mimischen Reaktionen, während die Probandin eine
            konkrete Aufgabe auf der getesteten Seite löst.
          </p>
          <p class="text-brand-black/60 leading-relaxed text-justify">
            Durch die Verknüpfung von Blick, Verhalten und Reaktionen finden wir heraus, was der Nutzer
            bemerkt hat, was er übersehen hat und an welcher Stelle er bei der Aufgabe gezögert hat.
          </p>
          <dl class="mt-8 border-t border-brand-black/10 pt-6 space-y-4">
            {vystupyMereni.map(([label, desc], i) => (
              <div class="flex gap-4">
                <span class="font-mono text-xs shrink-0 pt-0.5" style="color:#2D62FC;">0{i + 1}</span>
                <div>
                  <dt class="font-mono text-[11px] tracking-widest uppercase text-brand-black/70 mb-0.5">{label}</dt>
                  <dd class="text-sm text-brand-black/60 leading-relaxed">{desc}</dd>
                </div>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <!-- Jak to spolu souvisí -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WIE DAS ZUSAMMENHÄNGT ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-8 max-w-3xl">
          Universitäres Labor, kommerzielles Tempo<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          <div class="bg-brand-white p-6 md:p-8">
            <p class="font-mono text-xs text-brand-black/60 mb-6">01</p>
            <h3 class="font-display text-2xl font-bold mb-3">Labor FIMEYELAB</h3>
            <p class="text-brand-black/60 leading-relaxed text-sm text-justify">
              FIMEYELAB gehört der Univerzita Hradec Králové. Es dient Forschung, Lehre und der Betreuung
              von Diplom- und Dissertationsarbeiten — und hält damit eine methodische Messlatte, die sich
              ein kommerzieller Betrieb von sich aus nicht setzt.
            </p>
          </div>
          <div class="bg-brand-white p-6 md:p-8">
            <p class="font-mono text-xs text-brand-black/60 mb-6">02</p>
            <h3 class="font-display text-2xl font-bold mb-3">UX MIND</h3>
            <p class="text-brand-black/60 leading-relaxed text-sm text-justify">
              Kommerzielle Aufträge im Labor laufen immer über UX MIND. Wir sind der Vertragspartner, mit dem
              Sie den Auftrag unterzeichnen, einen Termin, einen Preis und ein Ergebnis erhalten — und der für das Resultat verantwortlich ist.
            </p>
          </div>
          <div class="bg-brand-white p-6 md:p-8">
            <p class="font-mono text-xs text-brand-black/60 mb-6">03</p>
            <h3 class="font-display text-2xl font-bold mb-3">Verbindung</h3>
            <p class="text-brand-black/60 leading-relaxed text-sm text-justify">
              Jan Petružálek ist Leiter des Labors FIMEYELAB und zugleich Mitinhaber von UX MIND.
              Methodik und Umsetzung sind so keine zwei Welten, die sich etwas über den Zaun zuwerfen.
            </p>
          </div>
        </div>
        <p class="text-brand-black/60 leading-relaxed text-justify mt-8 max-w-3xl">
          Praktisch bedeutet das für Sie nur eines: Sie erhalten akademische Methodik ohne akademische Fristen.
          So haben wir das Karriereportal für <strong class="text-brand-black">ŠKODA AUTO</strong> gemessen,
          die Kampagne eines Fußballvereins sowie Produktseiten von Online-Shops.
        </p>
      </div>

      <!-- Co umíme změřit -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WAS WIR MESSEN KÖNNEN ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Drei Ebenen der Nutzererfahrung<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {vrstvy.map((v, i) => (
            <div class="bg-brand-white p-8 flex flex-col">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed text-justify mb-6">{v.d}</p>
              <span class="mt-auto self-start font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Eine Metrik allein reicht nicht. Deshalb verbinden wir Blick, Aufgabenverlauf, Reaktion und Aussage
          des Nutzers. Erst ihr Zusammenhang zeigt, wo das Problem entsteht und was sinnvoll zu ändern ist.
        </p>
      </div>

      <!-- Čím měříme -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WOMIT WIR MESSEN ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Fünf Systeme für Labor und Feld<span style="color:#2D62FC">.</span>
        </h2>
        <div class="border border-brand-black/10">
          {vybaveni.map(z => (
            <div class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-6 p-6 border-b border-brand-black/10 last:border-0">
              <div class="md:col-span-4">
                <p class="font-display text-lg font-bold leading-tight">{z.nazev}</p>
                <p class="font-mono text-[11px] text-brand-black/60 tracking-wide uppercase">{z.typ}</p>
              </div>
              <p class="md:col-span-8 text-sm text-brand-black/60 leading-relaxed">{z.k}</p>
            </div>
          ))}
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Zwei Sätze mobiler Brillen ermöglichen es uns, mehr Teilnehmer oder Situationen in kürzerer Zeit zu messen.
        </p>
      </div>

      <!-- Vizualizace laboratoře -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/laborator-ux-vyzkumu-vizualizace-1.webp`}
          alt="Visualisierung der geplanten Anordnung des Labors FIMEYELAB"
          title="Geplante Anordnung des Labors"
          width="1600" height="1127" loading="lazy" decoding="async"
          class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">
          Visualisierung der geplanten Anordnung des Labors — getrennte Messplätze für paralleles Testen.
        </p>
      </div>

      <!-- Jak měření probíhá -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WIE EINE MESSUNG ABLÄUFT ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Von der Frage zur konkreten Empfehlung<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
          {postup.map(step => (
            <div class="bg-brand-white p-6 md:p-8 flex flex-col">
              <p class="font-mono text-xs text-brand-black/60 mb-6">{step.num}</p>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
        <div class="mt-6 border border-brand-black/10 p-8 md:p-10">
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ WORAUF WIR IM PROTOKOLL ACHTEN ]</p>
          <ul class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-x-8 gap-y-4 mb-8">
            {rizika.map(r => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed">
                <span class="font-mono text-xs pt-0.5 shrink-0" style="color:#2D62FC;">→</span> {r}
              </li>
            ))}
          </ul>
          <p class="text-sm text-brand-black/60 leading-relaxed max-w-3xl border-t border-brand-black/10 pt-6">
            Dank dessen sind die Ergebnisse vergleichbar, und Empfehlungen beruhen nicht auf Zufall oder einer einzigen Aufzeichnung.
          </p>
        </div>
      </div>

      <!-- Akademické zázemí -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ AKADEMISCHER HINTERGRUND ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Fachlicher Hintergrund in Zahlen<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          <div class="bg-brand-white p-8">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">PUBLIKATIONEN</p>
            <p class="font-display text-5xl font-bold mb-2">8</p>
            <p class="text-sm text-brand-black/60 leading-relaxed mb-6">
              Fachpublikationen mit Fokus auf Eye Tracking und Nutzererfahrung.
            </p>
            <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-2">BEISPIELPUBLIKATION</p>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Franěk, M., &amp; Petružálek, J. (2025). <em>Perceptual fluency and eye movements when viewing
              urban and natural scenes.</em> Scientific Reports, 15(1), čl. 25772.
            </p>
          </div>
          <div class="bg-brand-white p-8">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">FORSCHUNG UND AUSBILDUNG</p>
            <ul class="space-y-3 text-sm text-brand-black/60 leading-relaxed">
              <li class="pb-3 border-b border-brand-black/5">
                <strong class="text-brand-black">2 verteidigte Dissertationen</strong><br/>
                Jan Petružálek (2023) — kombinace metod měření uživatelské zkušenosti s využitím eye trackingu<br/>
                Denis Šefara (2022) — využití pozornosti při návrhu business dashboardů
              </li>
              <li>
                <strong class="text-brand-black">8 verteidigte Diplom- und Bachelorarbeiten</strong><br/>
                2 Diplomarbeiten, 6 Bachelorarbeiten
              </li>
            </ul>
          </div>
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Die fortlaufende Arbeit an Forschungsthemen ermöglicht es uns, Methoden an unterschiedlichen
          Aufgabenstellungen zu überprüfen, zu vergleichen und weiterzuentwickeln.
        </p>
      </div>

      <!-- Lidé -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ MENSCHEN ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6 max-w-3xl">
          Zwei Gesellschafter, ein breiteres Forschungsteam<span style="color:#2D62FC">.</span>
        </h2>
        <p class="text-brand-black/60 leading-relaxed max-w-3xl mb-10">
          UX MIND wird von zwei Gesellschaftern geführt. Je nach Umfang des Projekts wirken an Studiendesign,
          Messung und Datenverarbeitung auch die Laborleitung und geschulte Operatoren mit.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mb-px">

          <!-- Jan Petružálek -->
          <div class="bg-brand-white flex flex-col">
            <div class="border-b border-brand-black/10 aspect-[3/2] flex flex-col items-center justify-center text-center px-6" style="background-image: linear-gradient(rgba(10,10,10,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.06) 1px, transparent 1px); background-size: 20% 25%;">
              <p class="font-mono text-[10px] tracking-widest text-brand-black/40 mb-3">[ PORTRÄT IN VORBEREITUNG ]</p>
              <p class="font-display text-lg md:text-xl font-bold text-brand-black/40 leading-snug max-w-xs">Jan Petružálek</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase mb-2" style="color:#2D62FC">LEITER DES LABORS FIMEYELAB · MITINHABER UX MIND</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-4">Ing. Jan Petružálek, Ph.D.</h3>
              <p class="text-brand-black/60 leading-relaxed mb-6">
                Entwirft die Forschung, überwacht den Ablauf der Messungen und verantwortet die Analyse und
                Interpretation der Daten. In seiner Dissertation widmete er sich der Kombination von Methoden
                der UX-Forschung mit Eye Tracking. Er publiziert im Bereich Nutzererfahrung und E-Commerce.
              </p>
              <a href="https://www.linkedin.com/in/jan-petru%C5%BE%C3%A1lek-79167474/" target="_blank" rel="noopener noreferrer" class="mt-auto self-start inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                LINKEDIN ↗
              </a>
            </div>
          </div>

          <!-- Lukáš Koula -->
          <div class="bg-brand-white flex flex-col">
            <div class="border-b border-brand-black/10 aspect-[3/2] flex flex-col items-center justify-center text-center px-6" style="background-image: linear-gradient(rgba(10,10,10,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.06) 1px, transparent 1px); background-size: 20% 25%;">
              <p class="font-mono text-[10px] tracking-widest text-brand-black/40 mb-3">[ PORTRÄT IN VORBEREITUNG ]</p>
              <p class="font-display text-lg md:text-xl font-bold text-brand-black/40 leading-snug max-w-xs">Lukáš Koula</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase mb-2" style="color:#2D62FC">STRATEGIE, WEB UND MARKETING · MITINHABER UX MIND</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-4">Mgr. Lukáš Koula</h3>
              <p class="text-brand-black/60 leading-relaxed mb-6">
                Überträgt Forschungsergebnisse in konkrete Empfehlungen für Websites, Online-Shops und
                Kampagnen. Leitet Projekte und die Kommunikation mit Kunden und verbindet Forschung mit
                geschäftlichen und Marketingzielen. Ist zertifizierter Shoptet Partner und Google Partner.
              </p>
              <a href="https://www.linkedin.com/in/lukaskoula/" target="_blank" rel="noopener noreferrer" class="mt-auto self-start inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                LINKEDIN ↗
              </a>
            </div>
          </div>
        </div>

        <!-- Tým laboratoře -->
        <div class="border border-brand-black/10 p-8 md:p-10">
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ LABORTEAM ]</p>
          <div class="border border-brand-black/10 divide-y divide-brand-black/10 mb-6">
            {tymLaboratore.map(([pocet, role]) => (
              <div class="flex items-center gap-4 md:gap-6 px-4 py-4 md:px-6">
                <p class="font-mono text-[11px] text-brand-black/70 tracking-wide uppercase leading-snug w-28 md:w-44 shrink-0">{role}</p>
                <div class="flex flex-wrap gap-1.5 flex-1 min-w-0">
                  {Array.from({ length: Number(pocet) }).map(() => (
                    <span class="w-3.5 h-3.5 bg-brand-black" aria-hidden="true"></span>
                  ))}
                </div>
                <p class="font-mono text-[11px] text-brand-black/40 tabular-nums shrink-0 w-6 text-right">{pocet}</p>
              </div>
            ))}
          </div>
          <p class="text-sm text-brand-black/60 leading-relaxed max-w-3xl">
            Jede Messung läuft nach einem einheitlichen Protokoll und unter fachlicher Aufsicht ab. Dadurch
            bleibt die Datenerhebung unabhängig von der Zusammensetzung des Teams konsistent.
          </p>
        </div>
      </div>

      <!-- Etika a data -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ ETHIK UND DATEN ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">
              Einwilligung und Datenschutz sind Teil der Messung<span style="color:#2D62FC">.</span>
            </h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Jeder Teilnehmer weiß vorab, was wir erfassen, warum wir die Daten sammeln und wie wir mit ihnen umgehen.
            </p>
          </div>
          <ul class="space-y-2">
            {etika.map(e => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5 last:border-0">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {e}
              </li>
            ))}
          </ul>
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
</content>
