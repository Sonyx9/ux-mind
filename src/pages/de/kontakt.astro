---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="de"
  title="Kontakt"
  description="Kontaktieren Sie UX Mind. Vereinbaren Sie eine kostenlose Beratung zu UX-Audit, Eye Tracking oder UX-Forschung."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ KONTAKT ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          SPRECHEN<br/>WIR.
        </h1>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-16">

        <div>
          <p class="text-xl text-brand-black/60 leading-relaxed mb-12">
            Wir freuen uns auf Ihr Projekt. Schreiben Sie uns oder füllen Sie das Formular aus — wir melden uns innerhalb von 24 Stunden.
          </p>

          <div class="space-y-6">
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">E-MAIL</p>
              <a href="mailto:spoluprace@uxmind.cz" class="font-display text-2xl font-bold hover:opacity-50 transition-opacity">
                spoluprace@uxmind.cz
              </a>
            </div>
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">TELEFON</p>
              <a href="tel:+420728601160" class="font-display text-2xl font-bold hover:opacity-50 transition-opacity">
                +420 728 601 160
              </a>
            </div>
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">SITZ</p>
              <p class="font-display text-xl font-bold">K Lesu 180, Svinary<br/>500 09 Hradec Králové, Tschechien</p>
            </div>
          </div>

          <div class="mt-12 p-6 border border-brand-black/10">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ WIR ANTWORTEN INNERHALB VON ]</p>
            <p class="font-display text-3xl font-bold">24 Stunden</p>
            <p class="text-sm text-brand-black/60 mt-1">an Werktagen</p>
          </div>

          <div class="mt-6 p-6 border border-brand-black/10">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WEBSITE-BETREIBER ]</p>
            <div class="space-y-3 text-sm">
              <div>
                <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-0.5">FIRMENNAME</p>
                <p class="text-brand-black/80">UX MIND Research Lab s.r.o.</p>
              </div>
              <div>
                <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-0.5">ID-NUMMER (IČO)</p>
                <p class="text-brand-black/80">29714966</p>
              </div>
              <div>
                <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-0.5">AKTENZEICHEN</p>
                <p class="text-brand-black/80">C 57053, geführt beim Kreisgericht in Hradec Králové</p>
              </div>
              <div>
                <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-0.5">EINTRAGUNGSDATUM</p>
                <p class="text-brand-black/80">24. Juni 2026</p>
              </div>
              <div>
                <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-0.5">EINGETRAGENER SITZ</p>
                <p class="text-brand-black/80">K Lesu 180, Svinary, 500 09 Hradec Králové, Tschechien</p>
              </div>
            </div>
          </div>
        </div>

        <div>
          <form class="space-y-6" name="kontakt-de" method="POST" data-netlify="true">
            <div>
              <label for="f-name" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">NAME *</label>
              <input
                type="text"
                id="f-name"
                name="name"
                required
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent"
                placeholder="Ihr Name"
              />
            </div>

            <div>
              <label for="f-email" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">E-MAIL *</label>
              <input
                type="email"
                id="f-email"
                name="email"
                required
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent"
                placeholder="ihre@email.de"
              />
            </div>

            <div>
              <label for="f-company" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">UNTERNEHMEN</label>
              <input
                type="text"
                id="f-company"
                name="company"
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent"
                placeholder="Name des Unternehmens"
              />
            </div>

            <div>
              <label for="f-service" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">GEWÜNSCHTE LEISTUNG</label>
              <select
                id="f-service"
                name="service"
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent appearance-none"
              >
                <option value="">Leistung auswählen…</option>
                <option value="ux-audit">UX-Audit</option>
                <option value="eye-tracking">Eye Tracking</option>
                <option value="ux-forschung">UX-Forschung</option>
                <option value="nutzertests">Nutzertests</option>
                <option value="beratung">Beratung</option>
                <option value="sonstiges">Sonstiges</option>
              </select>
            </div>

            <div>
              <label for="f-message" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">NACHRICHT *</label>
              <textarea
                id="f-message"
                name="message"
                required
                rows="5"
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent resize-none"
                placeholder="Beschreiben Sie Ihr Projekt oder Ihre Frage…"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors"
            >
              NACHRICHT SENDEN →
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
