---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="de"
  title="UX-Forschung"
  description="Tiefgehende UX-Nutzerforschung. Interviews, Usability-Tests, Personas und Journey Maps."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ UX-FORSCHUNG ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          DATEN STATT<br/>ANNAHMEN.
        </h1>
        <p class="text-xl text-brand-black/60 max-w-2xl leading-relaxed">
          Entscheidungen auf Basis von Daten, nicht von Vermutungen. UX-Forschung zeigt Ihnen, was Ihre Nutzer wirklich brauchen.
        </p>
      </div>

      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ FORSCHUNGSMETHODEN ]</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10">
          {[
            { title: 'Tiefeninterviews', type: 'Qualitativ', desc: 'Einzelgespräche mit Nutzern decken Motivationen, Frustrationen und mentale Modelle auf.' },
            { title: 'Usability-Tests', type: 'Qualitativ', desc: 'Wir beobachten Nutzer beim Lösen von Aufgaben und identifizieren, woran sie scheitern.' },
            { title: 'Kontextuelle Forschung', type: 'Qualitativ', desc: 'Wir beobachten Nutzer in ihrer natürlichen Umgebung und sehen, wie sie tatsächlich arbeiten.' },
            { title: 'Umfrageforschung', type: 'Quantitativ', desc: 'Große Datensätze vieler Befragter für statistisch belastbare Schlussfolgerungen.' },
            { title: 'A/B-Tests', type: 'Quantitativ', desc: 'Wir vergleichen Designvarianten mit echtem Traffic und messen die Ergebnisse.' },
            { title: 'Card Sorting', type: 'Gemischt', desc: 'Wir erfahren, wie Nutzer Inhalte kategorisieren, und verbessern so die Informationsarchitektur.' },
          ].map(method => (
            <div class="bg-brand-white p-8">
              <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5 mb-4 inline-block">{method.type}</span>
              <h3 class="font-display text-xl font-bold mb-3 mt-3">{method.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{method.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="mb-24 border-t border-brand-black/10 pt-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ WAS SIE ERHALTEN ]</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          {[
            { title: 'Forschungsbericht', desc: 'Ein umfassendes Dokument mit Methodik, Erkenntnissen und Empfehlungen.' },
            { title: 'Personas', desc: 'Datenbasierte Charaktere, die Ihre wichtigsten Nutzergruppen repräsentieren.' },
            { title: 'Journey Maps', desc: 'Visualisierung des Nutzerwegs durch das Produkt, inklusive Pain Points.' },
            { title: 'Priorisierte Empfehlungen', desc: 'Konkrete Schritte, geordnet nach Wirkung und Umsetzungsaufwand.' },
          ].map(item => (
            <div>
              <h3 class="font-display text-2xl font-bold mb-3">{item.title}</h3>
              <p class="text-brand-black/60 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="text-center py-16 border-t border-brand-black/10">
        <h2 class="font-display text-4xl font-bold mb-6">Lernen Sie Ihre Nutzer wirklich kennen</h2>
        <a href="/de/kontakt" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
          FORSCHUNG STARTEN →
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
