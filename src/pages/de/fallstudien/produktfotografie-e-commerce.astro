---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { features } from '../../../config';

const fakta = [["METHODE", "Experiment · Eye Tracking + UEQ"], ["STICHPROBE", "84 Probanden"], ["VARIANTEN", "Packshot vs. Lifestyle-Foto"], ["STATISTIK", "F(1,82) = 4,50 · p = 0,037"]];
const zjisteni = ["Der Fototyp beeinflusste die Aufgabendauer statistisch signifikant: F(1,82) = 4,50; p = 0,037.", "Bei der Variante mit dem Produkt „am Model“ dauerte die Erfüllung der getesteten Aufgabe länger als beim reinen Packshot.", "Die Studie lieferte keinen eindeutigen Beleg dafür, dass sich die Varianten auch in der subjektiven Bewertung des Nutzererlebnisses unterschieden."];
const faq = [
  { q: "Ist ein Packshot oder ein Lifestyle-Foto besser?", a: "Aus einer einzelnen Studie lässt sich kein universell besserer Fototyp bestimmen. In der getesteten Aufgabe führte die Lifestyle-Variante zu einer längeren Dauer als der Packshot. Die Wahl muss auf das konkrete Produkt, die Seite und das Ziel des Nutzers bezogen werden." },
  { q: "Was bedeutet p = 0,037?", a: "Gäbe es zwischen den Varianten tatsächlich keinen Unterschied und wären die Annahmen des verwendeten Tests erfüllt, würde ein ebenso oder noch deutlicheres Ergebnis in etwa 3,7 % der Wiederholungen auftreten. Der p-Wert allein sagt nicht aus, wie groß die praktische oder geschäftliche Wirkung ist." },
  { q: "Beeinflusste der Fototyp auch die Bewertung der Seite?", a: "Die Studie lieferte keinen eindeutigen Beleg für einen Unterschied in der subjektiven Bewertung des Nutzererlebnisses. Die längere Dauer lässt sich daher nicht automatisch damit erklären, dass eine Variante den Menschen mehr oder weniger gefiel." },
  { q: "Bedeutet eine längere Dauer eine niedrigere Konversion?", a: "Nein. Die Studie maß die Dauer der Erfüllung einer konkreten Aufgabe, nicht die Wirkung auf die tatsächliche Konversion oder den Umsatz. Für eine solche Schlussfolgerung müsste die Forschung mit weiteren Daten oder einem nachgelagerten Experiment verbunden werden." },
  { q: "Wozu diente Eye Tracking in der Studie?", a: "Eye Tracking ergänzte den Ablauf der Aufgabe um Daten zur visuellen Aufmerksamkeit. Der beschriebene Hauptunterschied zwischen den Varianten betrifft jedoch die Aufgabendauer, weshalb wir ihn ohne weitere Analyse nicht automatisch einem bestimmten Blickmuster zuschreiben." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "Dasselbe Produkt. Unterschiedlich lange Entscheidung.",
    about: 'Eye Tracking, UX-Forschung',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'de',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="de"
  title="Fallstudie: Packshot vs. Lifestyle-Foto"
  description="Experiment mit 84 Probanden: Das Lifestyle-Foto führte in der getesteten E-Commerce-Aufgabe zu einer längeren Dauer als der reine Packshot, F(1,82) = 4,50; p = 0,037."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/de/fallstudien" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← ALLE FALLSTUDIEN</a>

      <!-- Studien-Kopf -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">E-Commerce</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          Dasselbe Produkt. Unterschiedlich lange Entscheidung<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Hauptergebnisse -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-1 md:grid-cols-3">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative p-7 md:p-9 border-t-4 border-t-brand-blue border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-mono text-xs tracking-widest text-brand-white/60 mb-5">LIFESTYLE-VARIANTE</p>
          <p class="font-display text-2xl md:text-3xl font-bold leading-tight">Längere Aufgabendauer</p>
        </div>
        <div class="relative p-7 md:p-9 border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">84</p>
          <p class="text-brand-white/70 leading-relaxed">Probanden verglichen zwei Varianten</p>
        </div>
        <div class="relative p-7 md:p-9">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.2rem, 4.5vw, 4rem);">p = 0,037</p>
          <p class="text-brand-white/70 leading-relaxed">statistisch signifikanter Unterschied in der Aufgabendauer</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Inhalt -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— WAS DIE DATEN ZEIGTEN</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— WAS HERAUSZUFINDEN WAR</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">Beeinflusst die Art der Produktpräsentation den Ablauf der Kaufaufgabe?</p>
            <p class="text-brand-black/70 leading-relaxed">Die Studie verglich einen reinen Packshot mit einem Foto des Produkts „am Model“. Ziel war nicht, das schönere Bild auszuwählen, sondern zu prüfen, ob der Fototyp die für dieselbe Aufgabe benötigte Zeit verändert.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— WIE DIE MESSUNG ABLIEF</span></p>
            <p class="text-brand-black/70 leading-relaxed">An dem kontrollierten Experiment nahmen 84 Probanden teil. Sie erfüllten E-Commerce-Aufgaben an Varianten der Produktpräsentation; den Ablauf ergänzten Eye-Tracking-Daten und der standardisierte Fragebogen UEQ zur subjektiven Bewertung des Nutzererlebnisses.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ WAS DIE STUDIE SAGT — UND WAS NICHT ]</p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
                <div class="bg-brand-white p-6">
                  <p class="font-mono text-xs tracking-widest mb-4" style="color:#2D62FC">DURCH DATEN BELEGT</p>
                  <p class="text-brand-black/70 leading-relaxed">In der getesteten Aufgabe führte das Lifestyle-Foto zu einer längeren Dauer als der reine Packshot. Der Unterschied war statistisch signifikant.</p>
                </div>
                <div class="bg-brand-white p-6">
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">NICHT ABLEITBAR</p>
                  <p class="text-brand-black/70 leading-relaxed">Dass ein Lifestyle-Foto generell die Konversion senkt, dass es immer schlechter ist oder dass es von Nutzern besser oder schlechter bewertet wurde.</p>
                </div>
              </div>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">Das Ergebnis bezieht sich auf die konkreten Varianten, die Stichprobe und die getestete E-Commerce-Aufgabe.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— EMPFEHLUNG FÜR DIE PRAXIS</span></p>
            <p class="text-brand-black/70 leading-relaxed">Das Produktfoto nicht nur nach Eindruck auswählen. Es an der konkreten Aufgabe überprüfen, die die Seite unterstützen soll, und die Dauer bzw. den Ablauf der Entscheidung gemeinsam mit Verhalten, Aufmerksamkeit und Geschäftsdaten bewerten.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ WAS SICH DARAUS MITNEHMEN LÄSST ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">Dasselbe Produkt kann die Art der Entscheidung verändern, je nachdem, wie Sie es zeigen<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">Ein Variantentest hilft, das Foto nach der Aufgabe des Kunden auszuwählen, nicht nach der Präferenz des Teams.</p>
            <a href="/de/kontakt" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">EIGENE STUDIE BESPRECHEN →</a>
          </section>
        </div>

        <!-- Fakten + Foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">STUDIE ENTSTAND IN ZUSAMMENARBEIT MIT</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Fakultät für Informatik und Management"
                title="Studie entstand in Zusammenarbeit mit der FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">MESSDATEN</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <div class="border border-brand-black/10 p-4 bg-brand-white">
                <svg viewBox="0 0 320 210" class="w-full" role="img" aria-label="Schema zweier Varianten der Produktseite: Packshot und Lifestyle-Foto">
                  <rect x="4" y="4" width="150" height="170" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="24" y="24" width="110" height="90" fill="rgba(10,10,10,0.06)"/>
                  <rect x="62" y="40" width="34" height="58" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="70" y="32" width="18" height="10" fill="#0A0A0A"/>
                  <rect x="24" y="126" width="70" height="7" fill="rgba(10,10,10,0.35)"/>
                  <rect x="24" y="140" width="46" height="7" fill="#2D62FC"/>
                  <text x="4" y="196" font-family="monospace" font-size="11" fill="#0A0A0A">PACKSHOT</text>
                  <rect x="166" y="4" width="150" height="170" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="186" y="24" width="110" height="90" fill="rgba(10,10,10,0.06)"/>
                  <circle cx="222" cy="52" r="14" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <path d="M 200 114 Q 222 76 244 114" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="256" y="62" width="20" height="36" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="186" y="126" width="70" height="7" fill="rgba(10,10,10,0.35)"/>
                  <rect x="186" y="140" width="46" height="7" fill="rgba(10,10,10,0.2)"/>
                  <text x="166" y="196" font-family="monospace" font-size="11" fill="#0A0A0A">LIFESTYLE</text>
                </svg>
              </div>
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Schema der getesteten Varianten: reiner Packshot vs. Produkt „am Model“</figcaption>
            </figure>
            <a href="/de/kontakt" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              UNVERBINDLICHE ANFRAGE →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ GLOSSAR — WAS DIE BEGRIFFE IN DIESER STUDIE BEDEUTEN ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">N (Stichprobe)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Anzahl der in die Analyse einbezogenen Personen. In dieser Studie N = 84.</dd></div>
            <div><dt class="font-display font-bold mb-1">F(1,82)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Wert der Teststatistik und ihre Freiheitsgrade im verwendeten statistischen Test.</dd></div>
            <div><dt class="font-display font-bold mb-1">p-Wert</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Hilft zu beurteilen, wie gut die Daten mit der Annahme vereinbar sind, dass es zwischen den Varianten keinen Unterschied gibt. Sie beschreibt allein nicht die Größe der Wirkung.</dd></div>
            <div><dt class="font-display font-bold mb-1">UEQ</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Standardisierter Fragebogen zur subjektiven Bewertung des Nutzererlebnisses.</dd></div>
          </dl>
        </details>
      </section>

      <!-- FAQ zur Studie -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ HÄUFIGE FRAGEN ZUR STUDIE ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Schmaler Streifen: vollständige Studie (öffnet Modal) -->
      <section class:list={["reveal mt-16 bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5", !features.studyDownloads && "!hidden"]}>
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Möchten Sie die Studie im Detail durchgehen<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">AUSFÜHRLICHER REPORT MIT METHODIK UND EMPFEHLUNGEN — KOSTENLOS ALS PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          STUDIE ANFORDERN →
        </button>
      </section>

      <!-- Navigation zwischen Studien -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Weitere Fallstudien">
        <a href="/de/fallstudien/backend-stories" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← VORHERIGE STUDIE</p>
          <p class="font-display font-bold leading-snug">Je länger der Text, desto weniger Aufmerksamkeit</p>
        </a>
        <a href="/de/fallstudien/werbebanner-blickrichtung" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">NÄCHSTE STUDIE →</p>
          <p class="font-display font-bold leading-snug">Der Blick der Figur lenkte die Aufmerksamkeit der Besucher</p>
        </a>
      </nav>

    </div>

      <!-- Modal: Anforderung der vollständigen Studie -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ AUSFÜHRLICHE STUDIE ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Fenster schließen">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Möchten Sie die Studie im Detail durchgehen<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Die Studien sind gekürzt und anonymisiert.</p>
          <form class="study-request space-y-4" data-pdf="" data-study="Dasselbe Produkt. Unterschiedlich lange Entscheidung.">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">NAME *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Ihr Name"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">FIRMA</label>
              <input type="text" id="sr-company" name="company" placeholder="Firmenname (optional)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="ihre@email.de"
                class="study-input" />
            </div>
            <label class="flex items-start gap-2.5 cursor-pointer">
              <input type="checkbox" name="marketing" class="mt-0.5 shrink-0 accent-[#2D62FC]" />
              <span class="font-mono text-[11px] text-brand-white/70 leading-relaxed">Ich möchte gelegentlich Tipps und Angebote von UX MIND erhalten (optional).</span>
            </label>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              STUDIE ANZEIGEN (PDF) →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/50 p-3">Danke! Falls sich die Studie nicht von selbst geöffnet hat, <a href="#" class="study-pdf-link underline hover:text-brand-white/70" target="_blank" rel="noopener">öffnen Sie sie über diesen Link</a>.</p>
            <p class="font-mono text-[11px] text-brand-white/60 leading-relaxed">Wir zeigen Ihnen die Studie auf Ihre Anfrage hin. Wie wir mit Ihren Daten umgehen, beschreibt unsere <a href="/de/datenschutz/" class="underline hover:text-brand-white" target="_blank" rel="noopener">Datenschutzerklärung</a>.</p>
          </form>
        </div>
      </dialog>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../../../scripts/case-study';
</script>
</content>
