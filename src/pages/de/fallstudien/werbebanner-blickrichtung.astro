---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { features } from '../../../config';

const fakta = [["METHODE", "Eye-Tracking-Experiment"], ["STICHPROBE", "104 Probanden"], ["VARIABLE", "Blickrichtung der Person"], ["STATISTIK", "F(1,102) = 12,57 · p < 0,001 · ηp² = 0,11"]];
const zjisteni = ["Die Änderung der Blickrichtung der Figur beeinflusste die Verteilung der visuellen Aufmerksamkeit statistisch signifikant: F(1,102) = 12,57; p < 0,001.", "Die Effektgröße ηp² = 0,11 entspricht nach gängigen Orientierungswerten einem mittelgroßen Effekt.", "Die Komposition der Figur funktionierte in den getesteten Kreationen also als visueller Hinweisreiz. Die Studie maß jedoch keine Klicks, kein Erinnern der Botschaft und keine Konversion."];
const faq = [
  { q: "Beeinflusste die Blickrichtung der Figur die Aufmerksamkeit?", a: "Ja, in den getesteten Kreationen und bei einer Stichprobe von 104 Probanden unterschied sich die Verteilung der Aufmerksamkeit zwischen den Varianten statistisch signifikant: p < 0,001; ηp² = 0,11." },
  { q: "Bedeutet das, dass wir die Figur immer zum CTA ausrichten sollten?", a: "Nicht automatisch. Das Ergebnis bestätigt die Blickrichtung als relevante Kompositionsvariable. Die passende Variante hängt vom konkreten Foto, der Botschaft, dem Format und dem Ziel der Kreation ab, deshalb empfehlen wir, reale Entwürfe zu vergleichen." },
  { q: "Belegte die Studie mehr Klicks oder Konversionen?", a: "Nein. Die Studie maß die Verteilung der visuellen Aufmerksamkeit, nicht Klicks, Erinnerung, Kauf oder eine andere Geschäftskennzahl. Die Verlagerung der Aufmerksamkeit ist ein wichtiger Zwischenschritt, garantiert aber allein keine Handlung." },
  { q: "Was bedeutet ηp² = 0,11?", a: "Das partielle Eta-Quadrat beschreibt die Effektgröße im verwendeten statistischen Modell. Der Wert 0,11 wird nach gängigen Orientierungswerten als mittelgroßer Effekt interpretiert; er bedeutet jedoch nicht automatisch eine Steigerung der Kampagnenleistung um 11 %." },
  { q: "Was bedeutet p < 0,001?", a: "Hätte die Blickrichtung im verwendeten Modell tatsächlich keinen Effekt und wären dessen Annahmen erfüllt, wäre ein ebenso oder noch deutlicheres Ergebnis sehr ungewöhnlich. Der p-Wert allein beschreibt weder die Größe noch den geschäftlichen Wert des Effekts." },
  { q: "Müssen wir wegen des Tests die ganze Kreation neu gestalten?", a: "Nicht unbedingt. Oft genügt es, kontrollierte Varianten von Foto, Bildausschnitt oder Position der Figur vorzubereiten. Die übrigen Elemente sollten möglichst ähnlich bleiben, damit sich der Unterschied sinnvoll interpretieren lässt." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "Der Blick der Figur lenkte die Aufmerksamkeit der Besucher.",
    about: 'Eye Tracking, UX-Forschung',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'de',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="de"
  title="Fallstudie: Wie die Blickrichtung die Aufmerksamkeit beeinflusste"
  description="Eye-Tracking-Experiment mit 104 Probanden: Die Änderung der Blickrichtung der Figur beeinflusste die Verteilung der Aufmerksamkeit, F(1,102) = 12,57; p < 0,001; ηp² = 0,11."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/de/fallstudien" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← ALLE FALLSTUDIEN</a>

      <!-- Studien-Kopf -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Werbekreation</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          Der Blick der Figur lenkte die Aufmerksamkeit der Besucher<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Hauptergebnisse -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-1 md:grid-cols-3">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative p-7 md:p-9 border-t-4 border-t-brand-blue border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-mono text-xs tracking-widest text-brand-white/60 mb-5">BLICKRICHTUNG</p>
          <p class="font-display text-2xl md:text-3xl font-bold leading-tight">Veränderte die Verteilung der Aufmerksamkeit</p>
        </div>
        <div class="relative p-7 md:p-9 border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">104</p>
          <p class="text-brand-white/70 leading-relaxed">Probanden im Experiment</p>
        </div>
        <div class="relative p-7 md:p-9">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.2rem, 4.5vw, 4rem);">ηp² = 0,11</p>
          <p class="text-brand-white/70 leading-relaxed">mittelgroßer Effekt · p &lt; 0,001</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Inhalt -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— WAS DIE DATEN ZEIGTEN</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— WAS HERAUSZUFINDEN WAR</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">Verändert die Blickrichtung der Figur die Verteilung der Aufmerksamkeit in der Kreation?</p>
            <p class="text-brand-black/70 leading-relaxed">Ein menschliches Gesicht in der Werbung zieht Aufmerksamkeit an. Das Experiment prüfte, ob eine Änderung der Blickrichtung der Figur auch beeinflusst, wie Probanden ihre Aufmerksamkeit zwischen dem Gesicht und den übrigen Teilen der getesteten Kreation aufteilen.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— WIE DIE MESSUNG ABLIEF</span></p>
            <p class="text-brand-black/70 leading-relaxed">An dem Eye-Tracking-Experiment nahmen 104 Probanden teil. Die Varianten der Kreation unterschieden sich in der Blickrichtung der Figur, und die Analyse verglich die Verteilung der visuellen Aufmerksamkeit zwischen vorab markierten Bereichen.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ PRINZIP DER GETESTETEN VARIANTEN ]</p>
              <svg viewBox="0 0 640 300" class="w-full" role="img" aria-label="Illustratives Schema: die Blickrichtung der Figur lenkt die Aufmerksamkeit des Betrachters">
  <text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">ILLUSTRATIVES SCHEMA DER VARIANTEN · KEINE HEATMAP</text>
  <g>
    <rect x="0" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <circle cx="70" cy="110" r="26" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <circle cx="62" cy="105" r="3" fill="#0A0A0A"/><circle cx="80" cy="105" r="3" fill="#0A0A0A"/>
    <rect x="200" y="140" width="70" height="46" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <text x="8" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">BLICK IN DIE KAMERA</text>
    <text x="8" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">Kompositionsvariante A</text>
  </g>
  <g>
    <rect x="340" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <circle cx="410" cy="110" r="26" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <circle cx="424" cy="108" r="3" fill="#0A0A0A"/><circle cx="432" cy="112" r="3" fill="#0A0A0A"/>
    <line x1="440" y1="118" x2="530" y2="152" stroke="#2D62FC" stroke-width="2" stroke-dasharray="4 4"/>
    <rect x="540" y="140" width="70" height="46" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <text x="348" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">BLICK AUF DAS PRODUKT</text>
    <text x="348" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">Kompositionsvariante B</text>
  </g>
  <text x="0" y="296" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">EFFEKT DES HINWEISREIZES: F(1,102) = 12,57 · p &lt; 0,001 · ηp² = 0,11 (MITTELGROSSER EFFEKT)</text>
</svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">Das Schema erklärt lediglich die manipulierte Variable. Es zeigt weder die tatsächlichen Stimuli noch eine Heatmap der Probanden; die Statistik stammt aus einer realen Messung.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— EMPFEHLUNG FÜR DIE PRAXIS</span></p>
            <p class="text-brand-black/70 leading-relaxed">Die Blickrichtung als Variable in Entwurf und Test der Kreation einbeziehen. Soll die Figur die Aufmerksamkeit auf eine konkrete Botschaft oder ein Produkt lenken, kontrollierte Varianten vorbereiten und sie gemeinsam mit den Kampagnenkennzahlen überprüfen.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ WAS SICH DARAUS MITNEHMEN LÄSST ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">Schon eine kleine Änderung der Komposition kann die Verteilung der Aufmerksamkeit verändern<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">Eye Tracking hilft, die Variante danach auszuwählen, was Menschen tatsächlich wahrnehmen. Die Wirkung auf Klicks oder Konversion muss mit nachgelagerten Daten überprüft werden.</p>
            <a href="/de/kontakt" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">KREATIVTEST BESPRECHEN →</a>
          </section>
        </div>

        <!-- Fakten + Foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">STUDIE ENTSTAND IN ZUSAMMENARBEIT MIT</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Fakultät für Informatik und Management"
                title="Studie entstand in Zusammenarbeit mit der FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">MESSDATEN</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/laborator-ux-vyzkumu-vizualizace-1.webp`}
                alt="Visualisierung des Testarbeitsplatzes im Labor — getrennte Boxen mit Arbeitsstationen"
                width="1080" height="762" loading="lazy" decoding="async"
                class="w-full h-52 object-cover border border-brand-black/10"
              />
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Visualisierung der Test-Boxen, in denen die Messung der Kreationen ohne Störung erfolgt</figcaption>
            </figure>
            <a href="/de/kontakt" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              UNVERBINDLICHE ANFRAGE →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ GLOSSAR — WAS DIE BEGRIFFE IN DIESER STUDIE BEDEUTEN ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">N (Stichprobe)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Anzahl der in die Analyse einbezogenen Personen. In dieser Studie N = 104.</dd></div>
            <div><dt class="font-display font-bold mb-1">F(1,102)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Wert der Teststatistik und ihre Freiheitsgrade im verwendeten statistischen Test.</dd></div>
            <div><dt class="font-display font-bold mb-1">p-Wert</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Hilft zu beurteilen, wie gut die Daten mit der Annahme vereinbar sind, dass die Blickrichtung im verwendeten Modell keinen Effekt hatte.</dd></div>
            <div><dt class="font-display font-bold mb-1">ηp²</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Das partielle Eta-Quadrat drückt die Effektgröße im jeweiligen statistischen Modell aus. Es ist kein Prozentsatz der Steigerung der Kampagnenleistung.</dd></div>
          </dl>
        </details>
      </section>

      <!-- FAQ zur Studie -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ HÄUFIGE FRAGEN ZUR STUDIE ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Schmaler Streifen: vollständige Studie (öffnet Modal) -->
      <section class:list={["reveal mt-16 bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5", !features.studyDownloads && "!hidden"]}>
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Möchten Sie die Studie im Detail durchgehen<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">AUSFÜHRLICHER REPORT MIT METHODIK UND EMPFEHLUNGEN — KOSTENLOS ALS PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          STUDIE ANFORDERN →
        </button>
      </section>

      <!-- Navigation zwischen Studien -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Weitere Fallstudien">
        <a href="/de/fallstudien/produktfotografie-e-commerce" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← VORHERIGE STUDIE</p>
          <p class="font-display font-bold leading-snug">Dasselbe Produkt. Unterschiedlich lange Entscheidung</p>
        </a>
        <a href="/de/fallstudien/shop-vorlagen" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">NÄCHSTE STUDIE →</p>
          <p class="font-display font-bold leading-snug">Die Aufgabe veränderte, worauf Menschen ihre Aufmerksamkeit richteten.</p>
        </a>
      </nav>

    </div>

      <!-- Modal: Anforderung der vollständigen Studie -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ AUSFÜHRLICHE STUDIE ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Fenster schließen">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Möchten Sie die Studie im Detail durchgehen<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Die Studien sind gekürzt und anonymisiert.</p>
          <form class="study-request space-y-4" data-pdf="" data-study="Der Blick der Figur lenkte die Aufmerksamkeit der Besucher.">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">NAME *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Ihr Name"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">FIRMA</label>
              <input type="text" id="sr-company" name="company" placeholder="Firmenname (optional)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="ihre@email.de"
                class="study-input" />
            </div>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              STUDIE ANZEIGEN (PDF) →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/50 p-3">Danke! Falls sich die Studie nicht von selbst geöffnet hat, <a href="#" class="study-pdf-link underline hover:text-brand-white/70" target="_blank" rel="noopener">öffnen Sie sie über diesen Link</a>.</p>
            <p class="font-mono text-[11px] text-brand-white/70 leading-relaxed">Mit dem Absenden stimmen Sie der Anzeige der Studie und dem gelegentlichen Erhalt von Geschäftsangeboten von UX MIND zu. Sie können sich jederzeit mit einem Klick abmelden.</p>
          </form>
        </div>
      </dialog>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../../../scripts/case-study';
</script>
</content>
