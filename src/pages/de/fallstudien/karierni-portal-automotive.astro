---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const fakta = [["METHODE", "Eye-Tracking + Befragung"], ["STICHPROBE", "102 Probanden"], ["SZENARIO", "„Finden Sie offene IT-Stellen“"], ["ERGEBNISSE", "Fixationsmetriken, A/B-Vergleich der CTA"]];
const zjisteni = ["40 % der Nutzer fanden keinen effektiven Weg zu den offenen Stellen.", "Der A/B-Vergleich des schwebenden CTA ergab messbare Unterschiede in den Fixationsmetriken und der Besuchsdauer der Varianten.", "Kernaussage: Die subjektive Bewertung der „Übersichtlichkeit“ entsprach nicht der Fähigkeit, die Aufgabe zu lösen — die Website gefiel auch Personen, die die Stellen nicht fanden."];
const faq = [
  { q: "Wie viele Personen nahmen an der Studie zum Karriereportal teil?", a: "102 Probanden, überwiegend aus der Zielgruppe der Junior-Rekrutierung. Wir haben mit Eye-Tracking und dem Szenario „Finden Sie offene IT-Stellen“ gemessen, ergänzt durch eine Befragung." },
  { q: "Was war das Hauptergebnis der Studie?", a: "40 % der Bewerber fanden keinen effektiven Weg zu den offenen Stellen, obwohl sie die Website als übersichtlich bewerteten. Der subjektive Eindruck der Übersichtlichkeit entsprach nicht dem tatsächlichen Aufgabenerfolg." },
  { q: "Was hat sich nach der Studie an der Website geändert?", a: "Der Weg zu den offenen Stellen wurde vereinfacht, die Navigation neu aufgebaut und der CTA an den Aufgabenkontext der Bewerber angepasst." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "40 % der Bewerber fanden den Weg zu offenen Stellen nicht",
    about: 'Eye Tracking, UX-Forschung',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'de',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="de"
  title="Fallstudie ŠKODA AUTO: 40 % der Bewerber fanden keine offenen Stellen"
  description="Eye Tracking des Karriereportals von ŠKODA AUTO: 40 % von 102 Probanden fanden keinen effektiven Weg zu den offenen Stellen. A/B-Test des CTA, Fixationsmetriken, Umbau der Navigation."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/de/fallstudien" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← ALLE FALLSTUDIEN</a>

      <!-- Studien-Kopf -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">ŠKODA AUTO · Karriereportal</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          Eine übersichtliche Website reicht nicht<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Hauptergebnisse -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-1 md:grid-cols-3">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative p-7 md:p-9 border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);" data-count="40" data-suffix=" %">40 %</p>
          <p class="text-brand-white/70 leading-relaxed">der Bewerber fanden keine offenen Stellen</p>
        </div>
        <div class="relative p-7 md:p-9 border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">102</p>
          <p class="text-brand-white/70 leading-relaxed">Probanden durchliefen dieselbe Aufgabe</p>
        </div>
        <div class="relative p-7 md:p-9">
          <p class="font-mono text-xs tracking-widest text-brand-blue mb-5">EINDRUCK ≠ LEISTUNG</p>
          <p class="text-brand-white/70 leading-relaxed">Die Website wirkte auch auf einen Teil der Personen übersichtlich, die die Aufgabe nicht erfüllten.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Inhalt -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— WAS DIE DATEN ZEIGTEN</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— WAS HERAUSZUFINDEN WAR</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">Kann das Karriereportal die Bewerber zu den Angeboten offener Stellen führen?</p>
            <p class="text-brand-black/70 leading-relaxed">Das Karriereportal von ŠKODA AUTO durchlief ein Redesign. Die Website wirkte übersichtlich, doch die Besucherzahl schlug sich nicht in einer entsprechenden Zahl abgesendeter Lebensläufe nieder. Die übliche Analytik zeigte das Ergebnis des Wegs, nicht den Grund, warum ihn ein Teil der Bewerber nicht abschloss.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— WIE DIE MESSUNG ABLIEF</span></p>
            <p class="text-brand-black/70 leading-relaxed">Alle 102 Probanden erfüllten dasselbe Szenario: „Finden Sie offene IT-Stellen.“ Das Eye-Tracking erfasste die Arbeit mit Inhalt und CTA, die Befragung ergänzte die subjektive Bewertung der Website. Die Stichprobe bestand überwiegend aus einer studentischen Population mit hohem Anteil an IT-Studierenden, daher beziehen wir die Ergebnisse vor allem auf die Junior-Rekrutierung.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ DATEN IM BILD ]</p>
              <svg viewBox="0 0 640 174" class="w-full" role="img" aria-label="Von 102 Probanden fanden 60 Prozent den Weg zu den Stellen und 40 Prozent nicht"><text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">N = 102 · SZENARIO „FINDEN SIE OFFENE STELLEN“</text><text x="0" y="67" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">WEG GEFUNDEN</text><rect x="190" y="52" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="52" width="240" height="22" fill="#0A0A0A" class="viz-bar"/><text x="430" y="67" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">60 %</text><text x="0" y="119" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">WEG NICHT GEFUNDEN</text><rect x="190" y="104" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="104" width="160" height="22" fill="#2D62FC" class="viz-bar"/><text x="350" y="119" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">40 %</text></svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">Vier von zehn Bewerbern gelangten während des gestellten Szenarios nicht zu den offenen Stellen.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— WAS ENTSCHIEDEN WURDE</span></p>
            <p class="text-brand-black/70 leading-relaxed">Die Ergebnisse unterstützten die Vereinfachung des Wegs zu den offenen Stellen, die Anpassung der Navigation und die Arbeit am CTA im Kontext der konkreten Aufgabe des Bewerbers. So erhielt das Team nicht nur eine Liste von Eindrücken, sondern konkrete Stellen, auf die es sich beim Redesign konzentrieren kann.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ WAS SICH DARAUS MITNEHMEN LÄSST ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">Ein übersichtlicher Eindruck bedeutet noch keine erfüllte Aufgabe<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">Wenn die Analytik ein schwaches Ergebnis zeigt, hilft eine Nutzermessung, das konkrete Hindernis zwischen Besuch und Zielerreichung zu finden.</p>
            <a href="/de/kontakt" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">EIGENE STUDIE BESPRECHEN →</a>
          </section>
        </div>

        <!-- Fakten + Foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">STUDIE ENTSTAND IN ZUSAMMENARBEIT MIT</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Fakultät für Informatik und Management"
                title="Studie entstand in Zusammenarbeit mit der FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">MESSDATEN</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/eye-tracking-mereni-respondentka-laborator.webp`}
                alt="Eine Probandin während einer Eye-Tracking-Messung im Labor — sie betrachtet die getestete Website auf einem Monitor mit Eye-Tracker"
                width="1080" height="1920" loading="lazy" decoding="async"
                class="w-full h-52 object-cover border border-brand-black/10"
              />
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Die Messung erfolgte mit dem Szenario „Finden Sie offene Stellen“ an einem Monitor mit Eye-Tracker</figcaption>
            </figure>
            <a href="/de/kontakt" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              UNVERBINDLICHE ANFRAGE →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ GLOSSAR — WAS DIE BEGRIFFE IN DIESER STUDIE BEDEUTEN ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">N (Stichprobe)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Anzahl der Personen, die an der Messung teilgenommen haben. N = 102 bedeutet 102 Probanden.</dd></div>
            <div><dt class="font-display font-bold mb-1">Fixation</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Kurzes Verweilen des Auges an einer Stelle. Aus der Abfolge der Fixationen lässt sich beschreiben, welchen Teilen der Seite ein Mensch Aufmerksamkeit geschenkt hat.</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI (beobachteter Bereich)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Ein vorab markierter Teil der Seite, etwa eine Schaltfläche, eine Überschrift oder ein Foto, für den wir Aufmerksamkeitsmetriken berechnen.</dd></div>
            <div><dt class="font-display font-bold mb-1">A/B-Vergleich</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Vergleich zweier Varianten desselben Elements oder derselben Seite unter vorab festgelegten Bedingungen.</dd></div>
          </dl>
        </details>
      </section>

      <!-- FAQ zur Studie -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ HÄUFIGE FRAGEN ZUR STUDIE ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Schmaler Streifen: vollständige Studie (öffnet Modal) -->
      <section class="reveal mt-16 !hidden bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Möchten Sie die Studie im Detail durchgehen<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">AUSFÜHRLICHER REPORT MIT METHODIK UND EMPFEHLUNGEN — KOSTENLOS ALS PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          STUDIE ANFORDERN →
        </button>
      </section>

      <!-- Navigation zwischen Studien -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Weitere Fallstudien">
        <a href="/de/fallstudien/billboardy-sport-marketing" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← VORHERIGE STUDIE</p>
          <p class="font-display font-bold leading-snug">Die ersten sechs Plätze gehörten den schwarzen Billboards.</p>
        </a>
        <a href="/de/fallstudien/backend-stories" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">NÄCHSTE STUDIE →</p>
          <p class="font-display font-bold leading-snug">Je länger der Text, desto weniger Aufmerksamkeit</p>
        </a>
      </nav>

    </div>

      <!-- Modal: Anforderung der vollständigen Studie -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ AUSFÜHRLICHE STUDIE ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Fenster schließen">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Möchten Sie die Studie im Detail durchgehen<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Die Studien sind gekürzt und anonymisiert.</p>
          <form class="study-request space-y-4" data-pdf="https://lukaskoula.com" data-study="40 % der Bewerber fanden den Weg zu offenen Stellen nicht">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">NAME *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Ihr Name"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">FIRMA</label>
              <input type="text" id="sr-company" name="company" placeholder="Firmenname (optional)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="ihre@email.de"
                class="study-input" />
            </div>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              STUDIE ANZEIGEN (PDF) →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/50 p-3">Danke! Falls sich die Studie nicht von selbst geöffnet hat, <a href="#" class="study-pdf-link underline hover:text-brand-white/70" target="_blank" rel="noopener">öffnen Sie sie über diesen Link</a>.</p>
            <p class="font-mono text-[11px] text-brand-white/70 leading-relaxed">Mit dem Absenden stimmen Sie der Anzeige der Studie und dem gelegentlichen Erhalt von Geschäftsangeboten von UX MIND zu. Sie können sich jederzeit mit einem Klick abmelden.</p>
          </form>
        </div>
      </dialog>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../../../scripts/case-study';
</script>
