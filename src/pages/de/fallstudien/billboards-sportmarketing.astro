---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { features } from '../../../config';

const fakta = [["METHODE", "Eye Tracking + Bewertungsfragebogen + TOP3"], ["STICHPROBE", "79 Probanden · 43 Männer, 36 Frauen · 17–25 Jahre"], ["STIMULI", "16 Entwürfe · je 10 Sekunden gezeigt"], ["ERGEBNISSE", "Ranking der Varianten + Metriken der visuellen Aufmerksamkeit"]];
const zjisteni = ["Alle sechs bestbewerteten Entwürfe hatten einen schwarzen Hintergrund. Die weißen Varianten konzentrierten sich im unteren Bereich des Rankings.", "Der Siegerentwurf erzielte den höchsten gewichteten Score in der TOP3-Auswahl und zugleich den besten durchschnittlichen Rang.", "Die Fixationsmetriken unterschieden sich zwischen den bestbewerteten und den schlechtestbewerteten Varianten nur wenig. Über das Ranking entschied deshalb nicht allein das Ausmaß der visuellen Aufmerksamkeit.", "Im Fragebogen gaben 39 % der Frauen und 16 % der Männer an, dass visuelle Werbung ihren Besuch einer Sportveranstaltung beeinflusst. Es handelt sich um einen angegebenen Einfluss, nicht um eine gemessene Veränderung des Kaufverhaltens."];
const faq = [
  { q: "Bedeutet das Ergebnis, dass ein schwarzes Billboard immer besser funktioniert?", a: "Nein. Der schwarze Hintergrund dominierte in diesem Set von 16 Entwürfen für eine konkrete Fußballkampagne und Zielgruppe. Das Ergebnis lässt sich nicht ohne Weiteres auf jede Marke, Botschaft oder Platzierung übertragen." },
  { q: "Was genau entschied über die Siegervariante?", a: "Der Siegerentwurf erzielte den besten gewichteten Score in der TOP3-Auswahl sowie den besten durchschnittlichen Rang. Eye Tracking half, die visuelle Aufmerksamkeit zu beschreiben, aber die Fixationsmetriken allein erklärten das Ranking der Varianten nicht." },
  { q: "Belegt 39 % vs. 16 %, dass Werbung Frauen stärker beeinflusst?", a: "Die Probanden gaben dies im Fragebogen an, es handelt sich also um einen angegebenen Einfluss. Die Studie belegt damit nicht, dass das Billboard tatsächlich den Ticketkauf veränderte oder dass das Geschlecht die Ursache des Unterschieds war." },
  { q: "Warum Eye Tracking mit einem Fragebogen kombinieren?", a: "Eye Tracking zeigt, wohin die visuelle Aufmerksamkeit gerichtet war. Der Fragebogen erfasst Präferenzen, Verständlichkeit und Absicht. In dieser Studie zeigte gerade ihre Kombination, dass mehr Aufmerksamkeit nicht automatisch eine bessere Bewertung bedeutet." },
  { q: "Lässt sich eine Kreation auf ähnliche Weise noch vor dem Kampagnenstart auswählen?", a: "Ja. Mehrere finale Varianten lassen sich noch vor der Produktion und dem Media-Einsatz an der Zielgruppe vergleichen. Wichtig ist, vorab festzulegen, nach welchem Ziel der Sieger ausgewählt wird." },
  { q: "Misst eine solche Studie auch den Ticketverkauf?", a: "Nicht automatisch. Eine Laborstudie hilft, die Kreation auszuwählen und zu erklären. Die tatsächliche Wirkung auf Besucherzahlen oder Verkauf muss mit nachgelagerten Kampagnendaten oder einem Feldexperiment überprüft werden." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "Die ersten sechs Plätze gingen an schwarze Billboards.",
    about: 'Eye Tracking, UX-Forschung',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'de',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="de"
  title="Fallstudie: Billboard-Auswahl mittels Eye Tracking"
  description="Eye Tracking und Bewertung von 16 Billboard-Entwürfen bei 79 Probanden: Die ersten sechs Plätze belegten die schwarzen Varianten, die Fixationsmetriken allein bestimmten jedoch nicht den Sieger."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/de/fallstudien" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← ALLE FALLSTUDIEN</a>

      <!-- Studien-Kopf -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Sportmarketing · Außenwerbung</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          Die ersten sechs Plätze gingen an schwarze Billboards<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Design studie -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-1 md:grid-cols-3">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative p-7 md:p-9 border-t-4 border-t-brand-blue border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">6/6</p>
          <p class="text-brand-white/70 leading-relaxed">der bestbewerteten Varianten hatten einen schwarzen Hintergrund</p>
        </div>
        <div class="relative p-7 md:p-9 border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">16</p>
          <p class="text-brand-white/70 leading-relaxed">Billboard-Entwürfe im Vergleich</p>
        </div>
        <div class="relative p-7 md:p-9">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">79</p>
          <p class="text-brand-white/70 leading-relaxed">Probanden aus der Zielaltersgruppe</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Inhalt -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— WAS DIE DATEN ZEIGTEN</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— WAS ZU ENTSCHEIDEN WAR</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">Welcher der 16 Entwürfe soll in die Kampagne zur Steigerung der Stadionauslastung gehen?</p>
            <p class="text-brand-black/70 leading-relaxed">Der Fußballverein wollte nicht nur nach der Meinung des Marketingteams auswählen. Er verglich die Varianten deshalb an jungen Menschen aus der Zielgruppe und beobachtete ihre Aufmerksamkeit sowie die anschließende Bewertung.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— WIE DIE MESSUNG ABLIEF</span></p>
            <p class="text-brand-black/70 leading-relaxed">Jeder der 79 Probanden sah alle 16 Entwürfe 10 Sekunden lang. Das Eye Tracking erfasste die visuelle Aufmerksamkeit. Der Bewertungsfragebogen und die TOP3-Auswahl ergänzten die Gesamtbewertung, die Übersichtlichkeit und die angegebene Absicht, das Spiel zu besuchen.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">04</span> <span class="text-brand-black/60">— WIE DAS ERGEBNIS ZU LESEN IST</span></p>
            <p class="text-brand-black/70 leading-relaxed">Die Studie wählte einen Sieger unter konkreten Entwürfen. Sie belegt nicht, dass ein schwarzer Hintergrund generell die Wirkung jedes Billboards steigert. Ebenso beschreibt der Fragebogenwert 39 % vs. 16 %, was die Probanden angaben — nicht eine tatsächliche Veränderung des Ticketverkaufs.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ DATEN IM BILD ]</p>
              <svg viewBox="0 0 640 174" class="w-full" role="img" aria-label="Im Fragebogen gaben 39 Prozent der Frauen und 16 Prozent der Männer an, dass visuelle Werbung ihren Besuch einer Sportveranstaltung beeinflusst"><text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">ANGEGEBENER EINFLUSS VISUELLER WERBUNG · FRAGEBOGEN · N = 79</text><text x="0" y="67" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">FRAUEN</text><rect x="190" y="52" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="52" width="156" height="22" fill="#2D62FC" class="viz-bar"/><text x="346" y="67" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">39 %</text><text x="0" y="119" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">MÄNNER</text><rect x="190" y="104" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="104" width="64" height="22" fill="#0A0A0A" class="viz-bar"/><text x="254" y="119" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">16 %</text></svg>
<svg viewBox="0 0 640 120" class="w-full mt-2" role="img" aria-label="Sechs bestbewertete Entwürfe hatten einen schwarzen Hintergrund, das untere Cluster bildeten die weißen Varianten">
  <text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">BEWERTUNG DER 16 ENTWÜRFE · TOP 6 vs UNTERES CLUSTER</text>
  <g>
    <rect x="0" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="48" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="96" y="36" width="40" height="26" fill="#0A0A0A"/>
    <rect x="144" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="192" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="240" y="36" width="40" height="26" fill="#0A0A0A"/>
    <text x="292" y="54" font-family="monospace" font-size="11" fill="#0A0A0A">TOP 6 = SCHWARZER HINTERGRUND</text>
  </g>
  <g stroke="rgba(10,10,10,0.4)" fill="none">
    <rect x="0" y="76" width="40" height="26"/><rect x="48" y="76" width="40" height="26"/><rect x="96" y="76" width="40" height="26"/><rect x="144" y="76" width="40" height="26"/>
    <text x="196" y="94" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)" stroke="none">UNTERES CLUSTER = WEISSE VARIANTEN</text>
  </g>
</svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">Die Grafik kombiniert das Ranking der getesteten Varianten mit den Antworten aus dem Fragebogen. Der Wert 39 % vs. 16 % drückt keine gemessene Auswirkung der Kampagne auf den Ticketverkauf aus.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— EMPFEHLUNG FÜR DIE KAMPAGNE</span></p>
            <p class="text-brand-black/70 leading-relaxed">Für die weitere Ausarbeitung die siegreiche schwarze Variante wählen und ihre klare Hierarchie, die markante Überschrift und ein einziges Hauptziel beibehalten. Die tatsächliche Wirkung der Kreation anschließend anhand der Daten aus der laufenden Kampagne bewerten.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ WAS SICH DARAUS MITNEHMEN LÄSST ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">Aufmerksamkeit und Präferenz sind nicht dasselbe<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">Eye Tracking zeigt, was Menschen sehen. Die Bewertung der Varianten ergänzt, welche Kreation sie bevorzugen. Für die Wahl der Kampagne müssen beide Ergebnisse gemeinsam gelesen werden.</p>
            <a href="/de/kontakt" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">KREATIVTEST BESPRECHEN →</a>
          </section>
        </div>

        <!-- Fakten + Foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">STUDIE ENTSTAND IN ZUSAMMENARBEIT MIT</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Fakultät für Informatik und Management"
                title="Studie entstand in Zusammenarbeit mit der FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">MESSDATEN</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <div class="border border-brand-black/10 p-4 bg-brand-white">
                <svg viewBox="0 0 320 210" class="w-full" role="img" aria-label="Illustratives Schema des Prinzips der bestbewerteten Billboards: schwarzer Hintergrund mit markanter Überschrift">
                  <rect x="24" y="16" width="272" height="120" fill="#0A0A0A"/>
                  <rect x="48" y="44" width="130" height="14" fill="#FCFCFC"/>
                  <rect x="48" y="68" width="90" height="8" fill="rgba(252,252,252,0.5)"/>
                  <rect x="48" y="100" width="64" height="16" fill="#2D62FC"/>
                  <circle cx="248" cy="76" r="26" fill="none" stroke="rgba(252,252,252,0.6)" stroke-width="2"/>
                  <rect x="96" y="136" width="10" height="52" fill="#0A0A0A"/>
                  <rect x="214" y="136" width="10" height="52" fill="#0A0A0A"/>
                  <text x="24" y="204" font-family="monospace" font-size="11" fill="#0A0A0A">TOP 6: SCHWARZER HINTERGRUND · MARKANTE ÜBERSCHRIFT</text>
                </svg>
              </div>
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Illustratives Schema des gemeinsamen Prinzips der sechs bestbewerteten Varianten</figcaption>
            </figure>
            <a href="/de/kontakt" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              UNVERBINDLICHE ANFRAGE →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ GLOSSAR — WIE DIE ERGEBNISSE DER STUDIE ZU LESEN SIND ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">N (Stichprobe)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Anzahl der in die Studie einbezogenen Personen. In diesem Fall N = 79.</dd></div>
            <div><dt class="font-display font-bold mb-1">TOP3</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Auswahl der drei bevorzugten Varianten. Reihenfolge und Häufigkeit der Wahl lassen sich in einen gewichteten Score umrechnen.</dd></div>
            <div><dt class="font-display font-bold mb-1">Fixation</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Kurzes Verweilen des Auges in einem bestimmten Bereich. Beschreibt visuelle Aufmerksamkeit, nicht automatisch Verständnis, Vorliebe oder Kauf.</dd></div>
            <div><dt class="font-display font-bold mb-1">Angegebener Einfluss</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Was der Teilnehmer im Fragebogen angegeben hat. Es handelt sich nicht um eine direkt gemessene Veränderung seines tatsächlichen Verhaltens.</dd></div>
          </dl>
        </details>
      </section>

      <!-- FAQ zur Studie -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ HÄUFIGE FRAGEN ZUR STUDIE ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Schmaler Streifen: vollständige Studie (öffnet Modal) -->
      <section class:list={["reveal mt-16 bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5", !features.studyDownloads && "!hidden"]}>
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Möchten Sie die Studie im Detail durchgehen<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">AUSFÜHRLICHER REPORT MIT METHODIK UND EMPFEHLUNGEN — KOSTENLOS ALS PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          STUDIE ANFORDERN →
        </button>
      </section>

      <!-- Navigation zwischen Studien -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Weitere Fallstudien">
        <a href="/de/fallstudien/shop-vorlagen" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← VORHERIGE STUDIE</p>
          <p class="font-display font-bold leading-snug">Mehr Informationen in der Karte beschleunigten die Auswahl nicht.</p>
        </a>
        <a href="/de/fallstudien/karriereportal-automotive" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">NÄCHSTE STUDIE →</p>
          <p class="font-display font-bold leading-snug">40 % der Bewerber fanden nicht zu den offenen Stellen</p>
        </a>
      </nav>

    </div>

      <!-- Modal: Anforderung der vollständigen Studie -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ AUSFÜHRLICHE STUDIE ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Fenster schließen">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Möchten Sie die Studie im Detail durchgehen<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Die Studien sind gekürzt und anonymisiert.</p>
          <form class="study-request space-y-4" data-pdf="" data-study="Die ersten sechs Plätze gingen an schwarze Billboards.">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">NAME *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Ihr Name"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">FIRMA</label>
              <input type="text" id="sr-company" name="company" placeholder="Firmenname (optional)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="ihre@email.de"
                class="study-input" />
            </div>
            <label class="flex items-start gap-2.5 cursor-pointer">
