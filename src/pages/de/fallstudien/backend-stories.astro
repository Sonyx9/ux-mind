---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { features } from '../../../config';

const fakta = [["METHODE", "Eye-Tracking, AOI-Analyse"], ["STICHPROBE", "ca. 120 Probanden"], ["SZENARIEN", "Mehrere Aufgabenszenarien"], ["ERGEBNISSE", "AOI-Statistiken, Lesegradient"]];
const zjisteni = ["Das CTA „Online lesen“ bemerkten etwa 92 % der Probanden.", "Die Aufmerksamkeit sank allmählich: die markante Überschrift bemerkten etwa 86 % der Probanden, den kurzen Folgetext 62 % und den langen Absatz 33 %.", "Etwa 75 % der Probanden bemerkten den unteren Seitenbereich noch vor dem Ausfüllen des Formulars."];
const faq = [
  { q: "Was bedeutet der Aufmerksamkeitsgradient?", a: "Der Anteil der Probanden, die die einzelnen Elemente bemerkten, sank allmählich: die markante Überschrift etwa 86 %, den kurzen Text 62 % und den langen Absatz 33 %. Das Ergebnis beschreibt diese konkrete Seite und die getesteten Szenarien." },
  { q: "Wie viele Probanden bemerkten das Haupt-CTA?", a: "Das CTA „Online lesen“ bemerkten etwa 92 % von rund 120 Probanden. Von allen beobachteten Elementen erzielte es den höchsten Treffer." },
  { q: "Bedeutet eine Fixation, dass die Person den Text gelesen hat?", a: "Nein. Eine Fixation belegt, dass der Blick in den betreffenden Bereich gerichtet war, nicht das vollständige Lesen oder Verstehen. Deshalb formulieren wir das Ergebnis als Bemerken des Elements und interpretieren es im Kontext der Aufgabe." },
  { q: "Was folgt aus den Ergebnissen für die Content-Erstellung?", a: "Auf der getesteten Seite halfen ein klares CTA, eine markante Überschrift und ein kurzer Folgetext, die Aufmerksamkeit zu bündeln. Bei einer anderen Website muss dasselbe Prinzip in ihrem eigenen Inhalt und Kontext überprüft werden." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "Je länger der Text, desto weniger Aufmerksamkeit",
    about: 'Eye Tracking, UX-Forschung',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'de',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="de"
  title="Fallstudie: Wie die Textlänge die Aufmerksamkeit beeinflusste"
  description="Eye-Tracking-AOI-Analyse einer edukativen Microsite: Das CTA bemerkten 92 % der Probanden, die markante Überschrift 86 %, den kurzen Text 62 % und den langen Absatz 33 %."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/de/fallstudien" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← ALLE FALLSTUDIEN</a>

      <!-- Studien-Kopf -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Edukative Microsite</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          Je länger der Text, desto weniger Aufmerksamkeit<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Hauptergebnisse -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-2 lg:grid-cols-4">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        {[
          ['92 %', 'das CTA'],
          ['86 %', 'die markante Überschrift'],
          ['62 %', 'den kurzen Text'],
          ['33 %', 'den langen Absatz'],
        ].map(([value, label], i) => (
          <div class:list={["relative p-6 md:p-8 border-brand-white/15", i === 0 && "border-t-4 border-t-brand-blue", i < 2 && "border-b lg:border-b-0", i % 2 === 0 && "border-r", i === 1 && "lg:border-r", i === 2 && "lg:border-r"]}>
            <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.5rem, 5vw, 4.5rem);">{value}</p>
            <p class="text-brand-white/70 text-sm md:text-base leading-relaxed">der Probanden bemerkten {label}</p>
          </div>
        ))}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Inhalt -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— WAS DIE DATEN ZEIGTEN</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— WAS HERAUSZUFINDEN WAR</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">Welche Elemente bemerkt der Besucher und wo beginnt die Aufmerksamkeit zu sinken?</p>
            <p class="text-brand-black/70 leading-relaxed">Die edukative Microsite kombinierte fachlichen Inhalt mit einem zentralen Handlungsaufruf. Ziel war zu prüfen, wie viel Aufmerksamkeit die einzelnen Ebenen der Seite erhalten — CTA, Überschriften, kurze Texte und längere Absätze.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— WIE DIE MESSUNG ABLIEF</span></p>
            <p class="text-brand-black/70 leading-relaxed">Etwa 120 Probanden durchliefen mehrere Aufgabenszenarien. Das Eye-Tracking erfasste ihre visuelle Aufmerksamkeit, und die AOI-Analyse berechnete den Anteil der Probanden, die die vorab markierten Elemente der Seite fixierten.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ DATEN IM BILD ]</p>
              <svg viewBox="0 0 640 278" class="w-full" role="img" aria-label="Der CTA wurde von 92 Prozent, die Überschrift von 86, der kurze Text von 62 und der lange Absatz von 33 Prozent der Probanden registriert"><text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">LESEGRADIENT · ANTEIL DER PROBANDEN, DIE DAS ELEMENT REGISTRIERTEN</text><text x="0" y="67" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">CTA „ONLINE LESEN“</text><rect x="190" y="52" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="52" width="368" height="22" fill="#2D62FC" class="viz-bar"/><text x="558" y="67" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">92 %</text><text x="0" y="119" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">FETTE ÜBERSCHRIFT</text><rect x="190" y="104" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="104" width="344" height="22" fill="#0A0A0A" class="viz-bar"/><text x="534" y="119" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">86 %</text><text x="0" y="171" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">KURZER TEXT</text><rect x="190" y="156" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="156" width="248" height="22" fill="#0A0A0A" class="viz-bar"/><text x="438" y="171" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">62 %</text><text x="0" y="223" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">LANGER ABSATZ</text><rect x="190" y="208" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="208" width="132" height="22" fill="#0A0A0A" class="viz-bar"/><text x="322" y="223" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">33 %</text></svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">Der Anteil der Probanden, die das Element bemerkten, sank vom Haupt-CTA über die Überschrift und den kurzen Text bis zum langen Absatz.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— WAS ENTSCHIEDEN WURDE</span></p>
            <p class="text-brand-black/70 leading-relaxed">Die Ergebnisse unterstützten die deutliche Abgrenzung des Haupt-CTA, die Kürzung langer Textblöcke und eine konsequentere Arbeit mit der Informationshierarchie. Das Team erhielt konkrete Daten für die Entscheidung, welche Teile des Inhalts hervorzuheben, zu kürzen oder umzustellen sind.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ WAS SICH DARAUS MITNEHMEN LÄSST ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">Eine Information auf der Seite bedeutet noch keine bemerkte Information<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">Eye Tracking zeigt, ob die Informationshierarchie die Aufmerksamkeit tatsächlich zu dem lenkt, was der Besucher sehen und nutzen soll.</p>
            <a href="/de/kontakt" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">EIGENE STUDIE BESPRECHEN →</a>
          </section>
        </div>

        <!-- Fakten + Foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">STUDIE ENTSTAND IN ZUSAMMENARBEIT MIT</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Fakultät für Informatik und Management"
                title="Studie entstand in Zusammenarbeit mit der FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">MESSDATEN</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/jan-petruzalek-analyza-eye-tracking-dat.webp`}
                alt="Ein Forscher analysiert AOI-Daten — Aufmerksamkeits-Heatmaps einzelner Seitenelemente auf dem Monitor"
                width="1080" height="720" loading="lazy" decoding="async"
                class="w-full h-52 object-cover border border-brand-black/10"
              />
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">AOI-Analyse: jedes Seitenelement hat eigene Aufmerksamkeitsmetriken</figcaption>
            </figure>
            <a href="/de/kontakt" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              UNVERBINDLICHE ANFRAGE →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ GLOSSAR — WAS DIE BEGRIFFE IN DIESER STUDIE BEDEUTEN ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">Fixation</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Kurzes Verweilen des Auges in einem bestimmten Bereich. Belegt visuelle Aufmerksamkeit, nicht das vollständige Lesen oder Verstehen.</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI (beobachteter Bereich)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Ein vorab markierter Teil der Seite, etwa ein CTA, eine Überschrift oder ein Textblock, für den wir Metriken berechnen.</dd></div>
            <div><dt class="font-display font-bold mb-1">Elementtreffer</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Anteil der Probanden, die den Bereich während des Szenarios mindestens einmal fixiert haben.</dd></div>
            <div><dt class="font-display font-bold mb-1">Aufmerksamkeitsgradient</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Allmähliches Absinken des Anteils der Probanden, die die einzelnen Inhaltsebenen bemerkt haben.</dd></div>
          </dl>
        </details>
      </section>

      <!-- FAQ zur Studie -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ HÄUFIGE FRAGEN ZUR STUDIE ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Schmaler Streifen: vollständige Studie (öffnet Modal) -->
      <section class:list={["reveal mt-16 bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5", !features.studyDownloads && "!hidden"]}>
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Möchten Sie die Studie im Detail durchgehen<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">AUSFÜHRLICHER REPORT MIT METHODIK UND EMPFEHLUNGEN — KOSTENLOS ALS PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          STUDIE ANFORDERN →
        </button>
      </section>

      <!-- Navigation zwischen Studien -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Weitere Fallstudien">
        <a href="/de/fallstudien/karriereportal-automotive" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← VORHERIGE STUDIE</p>
          <p class="font-display font-bold leading-snug">40 % der Bewerber fanden den Weg zu offenen Stellen nicht</p>
        </a>
        <a href="/de/fallstudien/produktfotografie-e-commerce" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">NÄCHSTE STUDIE →</p>
          <p class="font-display font-bold leading-snug">Dasselbe Produkt. Unterschiedlich lange Entscheidung</p>
        </a>
      </nav>

    </div>

      <!-- Modal: Anforderung der vollständigen Studie -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ AUSFÜHRLICHE STUDIE ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Fenster schließen">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Möchten Sie die Studie im Detail durchgehen<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Die Studien sind gekürzt und anonymisiert.</p>
          <form class="study-request space-y-4" data-pdf="" data-study="Je länger der Text, desto weniger Aufmerksamkeit">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">NAME *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Ihr Name"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">FIRMA</label>
              <input type="text" id="sr-company" name="company" placeholder="Firmenname (optional)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="ihre@email.de"
                class="study-input" />
            </div>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              STUDIE ANZEIGEN (PDF) →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/50 p-3">Danke! Falls sich die Studie nicht von selbst geöffnet hat, <a href="#" class="study-pdf-link underline hover:text-brand-white/70" target="_blank" rel="noopener">öffnen Sie sie über diesen Link</a>.</p>
            <p class="font-mono text-[11px] text-brand-white/70 leading-relaxed">Mit dem Absenden stimmen Sie der Anzeige der Studie und dem gelegentlichen Erhalt von Geschäftsangeboten von UX MIND zu. Sie können sich jederzeit mit einem Klick abmelden.</p>
          </form>
        </div>
      </dialog>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../../../scripts/case-study';
</script>
