---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const formats = [
  { t: 'Moderierte Tests', d: 'Ein Researcher führt die Testperson durch das Szenario, fragt nach und geht dort in die Tiefe, wo etwas passiert.', tag: 'LABOR / ONLINE' },
  { t: 'Unmoderierte Tests', d: 'Testpersonen lösen Aufgaben selbstständig. Schnellere Erhebung, größere Stichprobe, natürlichere Bedingungen.', tag: 'ONLINE' },
  { t: 'Think-Aloud', d: 'Die Testperson kommentiert während der Arbeit laut, was sie sieht und warum sie klickt. Das zeigt das mentale Modell, nicht nur das Verhalten.', tag: 'PROTOKOLL' },
];

const findings = [
  'Ob Nutzer die Schlüsselaufgaben abschließen — und wo genau sie scheitern',
  'Wie lange Aufgaben dauern und wie viele Fehler dabei entstehen',
  'Welche Elemente Nutzer nicht verstehen oder übersehen',
  'Wie sich das Verhalten von Neulingen und erfahrenen Nutzern unterscheidet',
  'Was Nutzer sagen vs. was sie tatsächlich tun',
];

const process = [
  { num: '01', title: 'Szenario und Aufgaben', desc: 'Wir definieren, was überprüft werden soll, und bereiten realistische Aufgaben vor.' },
  { num: '02', title: 'Rekrutierung der Testpersonen', desc: 'Wir rekrutieren nach Ihrer Zielgruppe, kein zufälliges Publikum.' },
  { num: '03', title: 'Testing', desc: 'Moderiert oder unmoderiert, mit Bildschirmaufzeichnung und Pilottest.' },
  { num: '04', title: 'Analyse und Empfehlungen', desc: 'Erfolgsquote, Zeit, Fehlerrate und konkrete Verbesserungsvorschläge.' },
];

const faq = [
  { q: 'Wie viele Testpersonen sind nötig?', a: 'Um die Hauptprobleme qualitativ aufzudecken, genügen in der Regel 5–8 Testpersonen pro Segment. Für Variantenvergleiche oder statistische Auswertungen ist eine größere, präziser geplante Stichprobe nötig — den Umfang schlagen wir auf Basis der Forschungsfrage vor.' },
  { q: 'Können wir auch einen Prototyp testen?', a: 'Ja. Wir testen produktive Websites und Apps ebenso wie klickbare Prototypen (Figma und Ähnliches). Je früher getestet wird, desto günstiger sind die Anpassungen.' },
  { q: 'Worin unterscheiden sich Nutzertests vom UX-Audit?', a: 'Das Audit ist eine Expertenbewertung ohne Testpersonen — der schnellere erste Schritt. Nutzertests beobachten echte Nutzer beim Lösen von Aufgaben und überprüfen das tatsächliche Verhalten. Idealerweise bauen beide aufeinander auf.' },
  { q: 'Können wir die Tests live verfolgen?', a: 'Ja, bei moderierten Tests können Sie über eine Beobachtungsleitung dabei sein. Die eigenen Nutzer zu beobachten ist für ein Team oft das überzeugendste Argument.' },
  { q: 'Was, wenn Nutzer die Website positiv bewerten, die Aufgabe aber nicht lösen?', a: 'Genau das decken Nutzertests auf. Der subjektive Eindruck einer „übersichtlichen Seite“ entspricht oft nicht der tatsächlichen Erfolgsquote — deshalb messen wir Verhalten, nicht nur Meinungen.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Nutzertests',
    description: 'Moderierte und unmoderierte Nutzertests von Websites, Apps und Prototypen. Think-Aloud-Protokoll, Bildschirmaufzeichnung, Analyse des Aufgabenerfolgs und Empfehlungen.',
    serviceType: 'Nutzertests',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="de"
  title="Nutzertests | Moderierte und unmoderierte UX-Tests"
  description="Nutzertests von Websites, Apps und Prototypen mit echten Nutzern. Moderierte und unmoderierte Tests, Think-Aloud, Bildschirmaufzeichnung und konkrete Empfehlungen."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ LEISTUNGEN / NUTZERTESTS ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          SEHEN SIE,<br/>WO SIE SCHEITERN<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Tests mit echten Nutzern, nicht mit Eindrücken.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              Wir beobachten, wie Menschen echte Aufgaben in Ihrem Produkt lösen. Sie erfahren,
              <strong class="text-brand-black">was Nutzer tun</strong> — nicht nur, was sie über das Produkt sagen.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="/de/kontakt" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              TESTS ANFRAGEN →
            </a>
            <a href="/de/leistungen/test-pakete" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              TEST-PAKETE
            </a>
          </div>
        </div>
      </div>

      <!-- Infoleiste -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DAUER', '1–4 Wochen'],
          ['FORMAT', 'Moderiert und online'],
          ['STICHPROBE', 'Je nach Forschungsfrage'],
          ['PAKET', 'Standard-UX-Test'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Formate -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ TESTFORMATE ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Drei Arten hinzusehen<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {formats.map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Foto -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
          alt="Testperson während eines Nutzertests im Labor"
          title="Ablauf eines Nutzertests"
          width="1080" height="1920" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Im Labor lassen sich Tests um Eye-Tracking ergänzen — Sie sehen nicht nur, was der Nutzer getan hat, sondern auch, was er dabei gesehen hat.</p>
      </div>

      <!-- Was Sie erfahren + Prozess -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ WAS SIE ERFAHREN ]</p>
          <ul class="space-y-2">
            {findings.map(o => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {o}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ SO LAUFEN DIE TESTS AB ]</p>
          <div class="space-y-0">
            {process.map(step => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Grenzen -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ WENN SIE MEHR BRAUCHEN ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">Verhalten sehen Sie. Aufmerksamkeit und Belastung nicht<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Ein klassischer Test zeigt, ob der Nutzer die Aufgabe gelöst hat. Er zeigt aber nicht, was er dabei wirklich gesehen hat,
              was er übersehen hat und wie viel es ihn gekostet hat. Deshalb kombinieren wir Tests mit Eye-Tracking und Biometrie.
            </p>
          </div>
          <a href="/de/leistungen/eye-tracking" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            EYE-TRACKING ERGÄNZEN →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ HÄUFIGE FRAGEN ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            LÖSEN NUTZER<br/>IHRE AUFGABE<span style="color:#2D62FC">?</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            Schicken Sie uns Ihr Produkt und die Schlüssel-Journey. Wir entwerfen ein Testszenario und ein Format, das am schnellsten eine Antwort liefert.
          </p>
          <a href="/de/kontakt" class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
            TESTS ANFRAGEN →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
