---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const formats = [
  { t: 'Moderiertes Testing', d: 'Ein Researcher begleitet die Testperson beim Lösen der Aufgaben, fragt nach und hilft herauszufinden, warum sie an einer bestimmten Stelle gestockt oder anders entschieden hat.', tag: 'IN DIE TIEFE · IM LABOR UND ONLINE' },
  { t: 'Unmoderiertes Testing', d: 'Testpersonen lösen die vorbereiteten Aufgaben selbstständig. Dieses Format erlaubt es, schnell mehr Menschen einzubeziehen und ihre Ergebnisse zu vergleichen.', tag: 'GRÖSSERE STICHPROBE · ONLINE' },
];

const findings = [
  { title: 'Abschluss der Aufgaben', desc: 'Wir stellen fest, ob Menschen wichtige Aufgaben bewältigen, wie lange sie dafür brauchen und bei welchen Schritten sie stocken.' },
  { title: 'Verständlichkeit der Oberfläche', desc: 'Wir decken Elemente, Bezeichnungen und Informationen auf, die Nutzer nicht verstehen oder übersehen.' },
  { title: 'Gründe der Entscheidung', desc: 'Wir stellen fest, was Nutzer erwarten, warum sie einen bestimmten Weg wählen und ob ihre Aussagen dem tatsächlichen Verhalten entsprechen.' },
];

const process = [
  { num: '01', title: 'Ziel und Szenario', desc: 'Wir klären, was Sie überprüfen möchten, und bereiten realistische Aufgaben vor.' },
  { num: '02', title: 'Auswahl der Teilnehmer', desc: 'Wir bestimmen die passende Zielgruppe und rekrutieren Teilnehmer nach vereinbarten Kriterien.' },
  { num: '03', title: 'Testing', desc: 'Teilnehmer lösen die vorbereiteten Aufgaben. Wir beobachten ihren Fortschritt, Fehler, Reaktionen und Kommentare.' },
  { num: '04', title: 'Analyse und Empfehlungen', desc: 'Wir werten die Erkenntnisse aus, ordnen sie nach Wichtigkeit und überführen sie in konkrete Änderungsvorschläge.' },
];

const faq = [
  { q: 'Wie viele Testpersonen sind nötig?', a: 'Um die Hauptprobleme qualitativ aufzudecken, genügen in der Regel 5–8 Testpersonen pro Segment. Für den Vergleich von Varianten oder eine statistische Auswertung ist eine größere, präziser geplante Stichprobe nötig — den Umfang schlagen wir je nach Forschungsfrage vor.' },
  { q: 'Wie lange dauern Nutzertests?', a: 'Meist 1–4 Wochen, je nach Umfang, Rekrutierungsart und Anzahl der Teilnehmer. Den genauen Zeitplan legen wir nach Klärung von Ziel und Zielgruppe fest.' },
  { q: 'Was kosten Nutzertests?', a: 'Der Preis hängt von der Anzahl der Teilnehmer, der Rekrutierungsart, dem Testformat und dem Umfang des Ergebnisses ab. Nach einem kurzen Briefing empfehlen wir den passenden Umfang und erstellen ein konkretes Angebot.' },
  { q: 'Können wir auch einen Prototyp testen?', a: 'Ja. Wir testen fertige Websites, Onlineshops und Apps ebenso wie klickbare Prototypen. Je früher wir ein Problem entdecken, desto einfacher und günstiger lässt es sich beheben.' },
  { q: 'Worin unterscheiden sich Nutzertests vom UX-Audit?', a: 'Ein UX-Audit ist eine Expertenprüfung der Oberfläche ohne Teilnehmer. Nutzertests beobachten echte Nutzer beim Lösen von Aufgaben und zeigen, wie sich Probleme in der Praxis auswirken.' },
  { q: 'Ist Eye Tracking Teil der Nutzertests?', a: 'Nicht im Standardumfang. Eye Tracking bieten wir als eigenständige Erweiterung an, wenn Sie die visuelle Aufmerksamkeit präzise messen und feststellen möchten, welche Elemente aufgefallen sind oder übersehen wurden.' },
  { q: 'Können wir das Testing live verfolgen?', a: 'Ja. Bei moderierten Tests lässt sich der Ablauf nach Absprache von einem getrennten Ort oder remote verfolgen — stets unter Berücksichtigung der Einwilligung der Teilnehmer und der Studienbedingungen.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Nutzertests',
    description: 'Moderierte und unmoderierte Nutzertests von Websites, Apps und Prototypen. Think-Aloud-Protokoll, Bildschirmaufzeichnung, Analyse des Aufgabenerfolgs und Empfehlungen.',
    serviceType: 'Nutzertests',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="de"
  title="Nutzertests | Moderierte und unmoderierte UX-Tests"
  description="Nutzertests von Websites, Apps und Prototypen mit echten Nutzern. Moderierte und unmoderierte Tests, Think-Aloud, Bildschirmaufzeichnung und konkrete Empfehlungen."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ LEISTUNGEN / NUTZERTESTS ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          PRÜFEN SIE<br/>DIE NUTZBARKEIT<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-3xl">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Prüfen Sie wichtige Aufgaben mit echten Nutzern.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed mb-4">
              Wir beobachten, wie Menschen Ihre Website, Ihren Onlineshop, Ihre App oder Ihren Prototyp nutzen. Wir stellen fest, ob sie sich orientieren können, wichtige Aufgaben abschließen und welche Teile der Oberfläche sie nicht verstehen.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed">
              Sie erhalten konkrete Erkenntnisse und Empfehlungen, <strong class="text-brand-black">was zu ändern ist, damit das Produkt verständlicher und leichter nutzbar wird</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/de/kontakt" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              TESTS ANFRAGEN →
            </a>
            <a href="/de/leistungen#testovaci-balicky" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              PAKETE ANSEHEN
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DAUER', '1–4 Wochen'],
          ['FORMAT', 'Moderiert und online'],
          ['STICHPROBE', 'Je nach Forschungsfrage'],
          ['PAKET', 'Standard-UX-Test'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Jak testujeme -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WIE WIR TESTEN ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Das Format wählen wir nach dem Ziel der Studie<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          {formats.map((v, i) => (
            <div class="bg-brand-white p-8 flex flex-col h-full">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest self-start mt-auto">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-sm md:text-base text-brand-black/60 leading-relaxed mt-6 max-w-4xl">
          <strong class="text-brand-black">Je nach Ziel des Testings</strong> setzen wir lautes Kommentieren, ein anschließendes Interview, kurze Fragebögen und Bildschirmaufzeichnung ein.
        </p>
      </div>

      <!-- Foto -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
          alt="Testperson während eines Nutzertests im Labor"
          title="Ablauf eines Nutzertests"
          width="1080" height="1920" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Im Labor lassen sich Tests um Eye-Tracking ergänzen — Sie sehen nicht nur, was der Nutzer getan hat, sondern auch, was er dabei gesehen hat.</p>
      </div>

      <!-- Co testování odhalí -->
      <div class="reveal mb-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.35fr] gap-10 lg:gap-16">
          <div>
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ WAS DAS TESTING AUFDECKT ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              Wo die Oberfläche hilft — und wo sie im Weg steht<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <div class="border-t border-brand-white/20">
            {findings.map((finding, i) => (
              <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_12rem_1fr] gap-x-4 gap-y-2 py-6 border-b border-brand-white/20">
                <span class="font-mono text-xs text-brand-white/50 pt-1">0{i + 1}</span>
                <h3 class="font-display text-lg font-bold leading-tight">{finding.title}</h3>
                <p class="col-start-2 sm:col-start-3 text-sm text-brand-white/65 leading-relaxed">{finding.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Proces -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WIE DAS TESTING ABLÄUFT ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Vom Ziel zu konkreten Anpassungen<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
          {process.map(step => (
            <div class="border-t border-brand-black/20 pt-5">
              <span class="block font-mono text-xs text-brand-black/60 mb-5">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Volitelné rozšíření -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ OPTIONALE ERWEITERUNG ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">Wenn Sie zusätzlich die Aufmerksamkeit messen möchten<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Nutzertests zeigen, ob Menschen die Aufgabe bewältigen und wo sie stocken. Eye Tracking kann zusätzlich präzise messen,
              welche Elemente ihnen aufgefallen sind, was sie übersehen haben und wie sich ihre Aufmerksamkeit während der Aufgabe verändert hat. Biometrische Methoden ergänzen wir nur dann, wenn sie dem Ziel der Studie entsprechen.
            </p>
          </div>
          <a href="/de/leistungen/eye-tracking" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            EYE TRACKING ANSEHEN →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ HÄUFIGE FRAGEN ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
</content>
