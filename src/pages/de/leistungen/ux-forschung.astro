---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const researchQuestions = [
  { title: 'Für wen Sie das Produkt entwickeln', desc: 'Wir lernen die Bedürfnisse, Erwartungen und Unterschiede zwischen den Gruppen kennen, die das Produkt oder die Leistung nutzen.' },
  { title: 'Welches Problem Menschen lösen', desc: 'Wir decken die echten Ziele, Motivationen und Hürden auf, nicht nur Anforderungen, die ohne Kontext formuliert wurden.' },
  { title: 'Wie die gesamte Journey verläuft', desc: 'Wir verbinden die einzelnen Kontaktpunkte und zeigen, wo die Erfahrung funktioniert und wo sie zerfällt.' },
  { title: 'Was zuerst zu ändern ist', desc: 'Wir überführen die Erkenntnisse in Prioritäten nach Wirkung, Sicherheit und Bezug zu Ihren Produktzielen.' },
];

const methods = [
  { title: 'Bedürfnisse verstehen', methods: 'INTERVIEWS · KONTEXTUELLE FORSCHUNG', desc: 'Wenn Sie Motivationen, Arbeitsabläufe, Entscheidungen und die Umstände verstehen müssen, unter denen das Problem entsteht.' },
  { title: 'Tatsächliches Verhalten überprüfen', methods: 'NUTZERTESTS · BEOBACHTUNG', desc: 'Wenn Sie herausfinden wollen, ob Menschen wichtige Aufgaben bewältigen und was sie in der konkreten Situation daran hindert.' },
  { title: 'Das Ausmaß des Problems messen', methods: 'FRAGEBÖGEN · ANALYTIK · BETRIEBSDATEN', desc: 'Wenn Sie überprüfen müssen, wie oft ein bestimmtes Muster auftritt und welche Gruppen es betrifft.' },
  { title: 'Mögliche Richtungen vergleichen', methods: 'KONZEPTE · PROTOTYPEN · VARIANTEN', desc: 'Wenn Sie zwischen Lösungen wählen und die Entscheidung mit Verhalten und Feedback untermauern müssen.' },
];

const deliverables = [
  { title: 'Antwort auf die Forschungsfrage', desc: 'Wir fassen klar zusammen, was die Daten zu sagen erlauben, was unsicher bleibt und was weiter zu überprüfen ist.' },
  { title: 'Belege und Zusammenhänge', desc: 'Die Erkenntnisse belegen wir mit konkreten Situationen, Aussagen, Verhaltensmustern und verfügbaren Daten.' },
  { title: 'Prioritäten und Chancen', desc: 'Wir trennen grundlegende Probleme von Einzelfällen und zeigen, wo eine Änderung am sinnvollsten ist.' },
  { title: 'Grundlagen für die weitere Arbeit', desc: 'Je nach Ziel bereiten wir Empfehlungen, eine Journey Map, eine Segmentierung, ein Briefing für den Entwurf oder einen Plan für die weitere Überprüfung vor.' },
];

const situations = [
  { title: 'Neues Produkt oder neue Leistung', desc: 'Sie müssen prüfen, wem die Lösung dienen soll und welches Problem sie wirklich lösen soll.' },
  { title: 'Redesign oder Richtungswechsel', desc: 'Sie wollen nicht nur den aktuellen Stand neu zeichnen, sondern entscheiden, was zu behalten und was zu ändern ist.' },
  { title: 'Schwache Leistung ohne klare Ursache', desc: 'Die Daten zeigen ein Problem, erklären aber weder Motivationen noch Erwartungen oder den Verhaltenskontext.' },
  { title: 'Neue Zielgruppe oder neuer Markt', desc: 'Sie müssen die unterschiedlichen Bedürfnisse verstehen, bevor Sie die bestehende Lösung anderswohin übertragen.' },
  { title: 'Journey über mehrere Kanäle', desc: 'Die Erfahrung entsteht zwischen Website, Support, Filiale, Geschäft oder physischem Produkt.' },
  { title: 'Entscheidung mit hoher Tragweite', desc: 'Sie müssen eine Entwicklungsrichtung, eine Investition oder eine Prozessänderung vor dem breiteren Einsatz belegen.' },
];

const process = [
  { num: '01', title: 'Entscheidung und Kontext', desc: 'Wir klären, was Sie entscheiden müssen, was Sie bereits wissen und wo die größten Lücken sind.' },
  { num: '02', title: 'Forschungsdesign', desc: 'Wir wählen die passenden Methoden, Zielgruppen, Stichprobe und Art der Auswertung.' },
  { num: '03', title: 'Vorbereitung und Rekrutierung', desc: 'Wir bereiten das Szenario vor, überprüfen es mit einem Pilottest und sorgen für passende Teilnehmer.' },
  { num: '04', title: 'Erhebung und Synthese der Daten', desc: 'Wir verbinden Interviews, Verhalten und verfügbare Daten und suchen wiederkehrende Zusammenhänge.' },
  { num: '05', title: 'Empfehlungen und Übergabe', desc: 'Wir überführen die Ergebnisse in Prioritäten und legen gemeinsam die nächsten Produktschritte fest.' },
];

const faq = [
  { q: 'Was ist UX-Forschung?', a: 'UX-Forschung ermittelt systematisch, wer die Nutzer sind, was sie brauchen, wie sie sich verhalten und warum. Sie hilft zu entscheiden, welches Problem zu lösen ist, was zu entwerfen ist und welche Änderungen am sinnvollsten sind.' },
  { q: 'Wie unterscheidet sich UX-Forschung von Nutzertests?', a: 'Nutzertests überprüfen eine konkrete Oberfläche oder einen Prototyp. UX-Forschung kann breitere Fragen zu Bedürfnissen, Zielgruppen, der gesamten Customer Journey oder der Produktrichtung beantworten und kombiniert je nach Ziel mehrere Methoden.' },
  { q: 'Wie unterscheidet sich UX-Forschung von Marktforschung?', a: 'Marktforschung konzentriert sich oft auf Marktgröße, Präferenzen oder die Marke. UX-Forschung geht stärker in den Kontext der Nutzung eines Produkts oder einer Leistung und sucht Grundlagen für einen konkreten Entwurf und Produktentscheidungen. Beide Ansätze können sich sinnvoll ergänzen.' },
  { q: 'Wie viele Teilnehmer brauchen wir?', a: 'Die Zahl hängt von der Forschungsfrage, der Zahl der Zielgruppen und den gewählten Methoden ab. Qualitative Interviews arbeiten mit einer anderen Stichprobe als ein Fragebogen oder ein Variantenvergleich, deshalb legen wir den Umfang erst beim Studiendesign fest.' },
  { q: 'Wie lange dauert UX-Forschung und was kostet sie?', a: 'Am häufigsten 3–8 Wochen, je nach Zahl der Zielgruppen, Art der Rekrutierung, Methoden und Umfang der Ergebnisse. Nach dem ersten Briefing bereiten wir einen konkreten Vorschlag, Zeitplan und Preis vor.' },
  { q: 'Was, wenn wir bereits Analytik oder frühere Forschung haben?', a: 'Die vorhandenen Daten gehen wir zuerst durch und nutzen sie als Ausgangspunkt. Eine neue Erhebung schlagen wir nur dort vor, wo wir fehlende Zusammenhänge ergänzen oder unsichere Schlussfolgerungen überprüfen müssen.' },
  { q: 'Muss die Forschung persönlich stattfinden?', a: 'Nicht unbedingt. Interviews und Nutzertests lassen sich je nach Ziel persönlich oder aus der Ferne durchführen. Feldforschung findet dagegen direkt in der Umgebung statt, in der Menschen die Leistung, das Produkt oder den Arbeitsablauf nutzen.' },
  { q: 'Wann beziehen Sie Eye Tracking und Biometrie in die UX-Forschung ein?', a: 'Nur dann, wenn die Forschungsfrage erfordert, die visuelle Aufmerksamkeit, die physiologische Aktivierung oder die mentale Belastung genau zu messen. Es ist kein automatischer Bestandteil jeder Forschung, sondern eine optionale Erweiterung.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'UX-Forschung',
    description: 'UX-Forschung für Produktentscheidungen: Interviews, Beobachtung, Nutzertests, Fragebögen, Datenanalyse und priorisierte Empfehlungen.',
    serviceType: 'UX-Forschung',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="de"
  title="UX-Forschung für Produktentscheidungen | UX MIND"
  description="UX-Forschung mit Interviews, Beobachtung, Nutzertests und Datenanalyse. Erhalten Sie klare Erkenntnisse, Prioritäten und Empfehlungen für Ihr Produkt."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ LEISTUNGEN / UX-FORSCHUNG ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          VERSTEHEN SIE<br/>DIE ZUSAMMENHÄNGE<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-3xl">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Entscheiden Sie, was zu entwickeln und zu verbessern sinnvoll ist.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed mb-4">
              UX-Forschung beantwortet breitere Fragen als der Test eines einzelnen Bildschirms. Sie hilft herauszufinden, wer Ihre Nutzer sind, was sie brauchen, wie sie entscheiden und welche Teile ihrer Journey den größten Einfluss auf die Erfahrung mit dem Produkt oder der Leistung haben.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed">
              Je nach Ziel kombinieren wir Interviews, Beobachtung, Nutzertests, Fragebögen und verfügbare Daten. Das Ergebnis sind <strong class="text-brand-black">verständliche Erkenntnisse, Prioritäten und Empfehlungen für Produktentscheidungen</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/de/kontakt" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              UX-FORSCHUNG ANFRAGEN →
            </a>
            <a href="/de/leistungen#testovaci-balicky" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              PAKETE ANSEHEN
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DAUER', '3–8 Wochen'],
          ['METHODEN', 'Interviews · Beobachtung · Daten'],
          ['ERGEBNISSE', 'Erkenntnisse · Prioritäten · Empfehlungen'],
          ['FORM', 'Maßgeschneiderte Forschung'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Výzkumné otázky -->
      <div class="reveal mb-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.35fr] gap-10 lg:gap-16">
          <div>
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ WORAUF UX-FORSCHUNG ANTWORTET ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              Zuerst die Frage. Dann die Methode<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <div class="border-t border-brand-white/20">
            {researchQuestions.map((question, i) => (
              <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_13rem_1fr] gap-x-4 gap-y-2 py-6 border-b border-brand-white/20">
                <span class="font-mono text-xs text-brand-white/50 pt-1">0{i + 1}</span>
                <h3 class="font-display text-lg font-bold leading-tight">{question.title}</h3>
                <p class="col-start-2 sm:col-start-3 text-sm text-brand-white/65 leading-relaxed">{question.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Kdy dává smysl -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WANN UX-FORSCHUNG SINNVOLL IST ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-4xl">
          Wenn es nicht genügt, einen Bildschirm anzupassen<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12">
          {situations.map((situation, i) => (
            <div class="grid grid-cols-[2rem_1fr] gap-x-4 py-6 border-t border-brand-black/20">
              <span class="font-mono text-xs text-brand-black/50 pt-1">0{i + 1}</span>
              <div>
                <h3 class="font-display text-xl font-bold mb-2 leading-tight">{situation.title}</h3>
                <p class="text-sm text-brand-black/60 leading-relaxed">{situation.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Metody -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WIE WIR DIE METHODEN ZUSAMMENSTELLEN ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6 max-w-4xl">
          Den Umfang bestimmt die Entscheidung, nicht eine Methodenliste<span style="color:#2D62FC">.</span>
        </h2>
        <p class="text-brand-black/60 leading-relaxed max-w-3xl mb-10">
          Wir beginnen nicht damit, alle verfügbaren Techniken in das Projekt zu packen. Zuerst legen wir fest, welche Art von Antwort Sie brauchen, und erst dann schlagen wir die kleinste sinnvolle Kombination von Methoden vor.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          {methods.map((method, i) => (
            <div class="bg-brand-white p-8 flex flex-col min-h-64">
              <span class="font-mono text-xs text-brand-black/60 mb-8">0{i + 1}</span>
              <h3 class="font-display text-2xl font-bold mb-3">{method.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{method.desc}</p>
              <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mt-auto pt-5 border-t border-brand-black/10">{method.methods}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Foto -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/laborator-ux-vyzkumu-vizualizace-1.webp`}
          alt="UX-Forschungslabor — Umfeld für Interviews, Tests und biometrische Messungen"
          title="UX-Forschungslabor"
          width="1200" height="846" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Forschungsumfeld FIMEYELAB an der FIM UHK — Raum für Interviews, Nutzertests und bei Bedarf auch synchronisierte Messungen.</p>
      </div>

      <!-- Výstupy -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-16">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WAS SIE ERHALTEN ]</p>
          <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight max-w-xl">
            Grundlagen für Entscheidungen, kein Dokument fürs Archiv<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-black/60 leading-relaxed mt-6 max-w-xl">
            Die Form des Ergebnisses wählen wir danach, wer mit den Ergebnissen arbeiten wird und welche Entscheidung folgen soll. Weder eine Journey Map noch eine Persona sind Pflicht — sie entstehen nur dann, wenn sie der weiteren Arbeit helfen.
          </p>
        </div>
        <div class="border-t border-brand-black/20">
          {deliverables.map((deliverable, i) => (
            <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_13rem_1fr] gap-x-4 gap-y-2 py-6 border-b border-brand-black/20">
              <span class="font-mono text-xs text-brand-black/50 pt-1">0{i + 1}</span>
              <h3 class="font-display text-lg font-bold leading-tight">{deliverable.title}</h3>
              <p class="col-start-2 sm:col-start-3 text-sm text-brand-black/60 leading-relaxed">{deliverable.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Proces -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WIE UX-FORSCHUNG ABLÄUFT ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-4xl">
          Von der Frage zum nächsten Produktschritt<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-x-7 gap-y-10">
          {process.map(step => (
            <div class="border-t border-brand-black/20 pt-5">
              <span class="block font-mono text-xs text-brand-black/60 mb-5">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Pokročilé měření -->
      <div class="reveal mb-24 border border-brand-black/15 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ OPTIONALE ERWEITERTE MESSUNG ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">Wenn Aussagen und Beobachtung nicht genügen<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Wenn die Forschungsfrage erfordert, die visuelle Aufmerksamkeit, die physiologische Aktivierung oder die mentale Belastung genau zu messen, können wir die Studie um Eye Tracking, GSR, die Analyse mimischer Signale oder EMLI erweitern. Eine Methode fügen wir nur dann hinzu, wenn sie die benötigte Art von Beleg liefert.
            </p>
          </div>
          <a href="/de/leistungen/eye-tracking" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            EYE TRACKING ANSEHEN →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ HÄUFIGE FRAGEN ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
