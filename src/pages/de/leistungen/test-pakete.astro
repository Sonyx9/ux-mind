---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const packages = [
  {
    num: '01',
    id: 'rychla-diagnostika',
    title: 'Schneller UX-Audit',
    tagline: 'Eine schnelle Expertenprüfung, die die Hauptprobleme einer Website oder App aufdeckt.',
    chips: ['Experten-UX-Audit', 'Schlüsselbildschirme', 'Prioritäten der Anpassungen'],
    findings: 'Wo die Oberfläche Nutzer verwirren kann, was den Abschluss einer Aufgabe erschwert und welche Mängel zuerst zu beheben sinnvoll ist.',
    forWho: 'Für Teams, die schnell eine Website, einen Onlineshop, eine App oder ein Formular prüfen müssen. Geeignet vor einem Redesign, bei sinkenden Konversionen oder als Grundlage für weitere Anpassungen.',
    inside: 'Expertenprüfung der wichtigsten Seiten und Nutzerpfade. Wir bewerten Verständlichkeit, Navigation, Inhalt, visuelle Hierarchie und Hindernisse beim Abschluss der Aufgabe.',
    limits: 'Der Audit arbeitet nicht mit der Messung echter Nutzer. Er deckt wahrscheinliche Probleme auf und legt Prioritäten fest, die sich anschließend mit Nutzertests überprüfen lassen.',
    output: 'Übersicht der Hauptprobleme, konkrete Beispiele und empfohlene Anpassungen, geordnet nach Wichtigkeit.',
  },
  {
    num: '02',
    id: 'standardni-ux-test',
    title: 'Nutzertests',
    tagline: 'Wir beobachten, wie echte Nutzer die Oberfläche durchlaufen und wo sie beim Lösen von Aufgaben ins Stocken geraten.',
    chips: ['Tests mit Nutzern', 'Aufgabenszenarien', 'Interviews', 'Fragebögen'],
    findings: 'Ob Nutzer wichtige Aufgaben bewältigen, wo sie Fehler machen, was sie nicht verstehen und welche Variante sich leichter bedienen lässt.',
    forWho: 'Für Teams, die eine konkrete User Journey, einen neuen Entwurf oder einen Prototyp mit echten Nutzern überprüfen müssen. Geeignet für Websites, Apps, Onlineshops und Formulare.',
    inside: 'Geführte Tests mit Nutzern anhand vorbereiteter Aufgaben. Wir beobachten Erfolgsquote, Zeit, Fehler und die Art der Interaktion mit der Oberfläche. Das Verhalten ergänzen wir durch ein Interview und bei Bedarf einen Fragebogen.',
    limits: 'Der Test zeigt, was Nutzer getan haben und wie sie ihr Verhalten erklären. Er misst weder die genaue Augenbewegung noch die physiologische Reaktion — dafür dient die Premium-Labormessung.',
    output: 'Ergebnisse der einzelnen Aufgaben, die wichtigsten Barrieren, Beispiele für das Nutzerverhalten und Empfehlungen, geordnet nach Wirkung.',
  },
  {
    num: '03',
    id: 'komplexni-biometricky-vyzkum',
    title: 'Eye Tracking und Biometrie',
    tagline: 'Eine Premium-Labormessung für wichtige Entscheidungen, die Sie mit mehreren Datenquellen absichern müssen.',
    chips: ['Alles aus 02', 'GSR', 'Mimische Signale', 'EMLI', 'Workshop'],
    findings: 'Was Nutzer tatsächlich gesehen haben, wie sie vorgegangen sind und in welchen Momenten ihre physiologische oder mentale Belastung anstieg.',
    forWho: 'Für Entscheidungen, die teuer, schwer umkehrbar sind oder vor Geschäftsführung, Investoren oder Kunden bestehen müssen. Geeignet für bedeutende Redesigns, zentrale Kampagnen, Produktinnovationen, HMI, Retail-Situationen oder Studien, bei denen das Verhalten allein nicht ausreicht.',
    inside: 'Wir ergänzen die Nutzertests um Eye Tracking und je nach Aufgabenstellung auch um GSR, die Analyse mimischer Signale, ein retrospektives Interview über der Blickaufzeichnung oder die Messung der mentalen Belastung mit dem Modell EMLI.',
    limits: 'Biometrische Daten interpretieren wir nie isoliert. GSR sagt nicht, ob eine Reaktion positiv oder negativ ist, und mimische Signale sind kein eigenständiges „Emotionslesen“. Aussagekraft entsteht erst in Verbindung mit Aufgabe, Szenario, Eye Tracking und der Aussage des Teilnehmers.',
    output: 'Erweiterter Forschungsreport, Verknüpfung der einzelnen Datenquellen, Erklärung kritischer Momente, Empfehlungen für Anpassungen und ein Workshop zu den Ergebnissen.',
    featured: true,
  },
  {
    num: '04',
    id: 'terenni-studie',
    title: 'Feldstudie',
    tagline: 'Wir beobachten das Verhalten dort, wo es wirklich stattfindet — im Geschäft, im Betrieb oder in einem anderen physischen Raum.',
    chips: ['Beobachtung im Feld', 'Videoaufzeichnung', 'Interviews', 'Mobiles Eye Tracking'],
    findings: 'Wie Menschen sich durch die reale Umgebung bewegen, was ihnen auffällt, was sie übergehen und wo sie stehen bleiben.',
    forWho: 'Für Situationen, in denen die Entscheidung nicht nur am Bildschirm fällt. Typischerweise im Geschäft, im Showroom, am physischen Produkt, auf einer Veranstaltung, im Arbeitsumfeld oder im Automotive-/HMI-Kontext.',
    inside: 'Beobachtung und Videoaufzeichnung der Situation, Interviews und Verhaltensanalyse in realer Umgebung. Je nach Forschungsfrage können wir auch die mobile Eye-Tracking-Brille Pupil Labs NEON oder GSR einbeziehen.',
    limits: 'Feldforschung bietet eine höhere Natürlichkeit der Situation, aber weniger Kontrolle über die Bedingungen als das Labor. Deshalb legen wir immer vorab fest, welche Schlüsse sich aus einer Feldmessung sicher ziehen lassen und welche sich kontrollierter überprüfen lassen sollten.',
    output: 'Videoanalyse, Mapping der Schlüsselmomente, Visualisierung der Aufmerksamkeit im Raum, Zusammenfassung der Barrieren und Empfehlungen zur Anpassung von Raum, Kommunikation oder Customer Journey.',
  },
];

const outputs = [
  {
    title: 'Hauptergebnisse',
    desc: 'Problemübersicht, Aufgabenergebnisse und Visualisierungen passend zum gewählten Paket.',
  },
  {
    title: 'Erklärung der Zusammenhänge',
    desc: 'Wir zeigen, was passiert ist, warum es wichtig ist und was sich aus den Ergebnissen sicher ableiten lässt.',
  },
  {
    title: 'Prioritäten und nächste Schritte',
    desc: 'Empfohlene Anpassungen, geordnet nach Wirkung und Aufwand. Bei umfangreicheren Studien auch ein gemeinsamer Workshop zu den Ergebnissen.',
  },
];

const process = [
  { num: '01', title: 'Ziel', desc: 'Wir klären, was Sie herausfinden möchten und welche Entscheidung die Forschung unterstützen soll.' },
  { num: '02', title: 'Entwurf', desc: 'Wir empfehlen das passende Paket, Methoden, Umfang und Teilnehmer.' },
  { num: '03', title: 'Vorbereitung', desc: 'Wir bereiten Szenario, Unterlagen und bei Bedarf einen Pilottest vor.' },
  { num: '04', title: 'Durchführung', desc: 'Wir führen den Audit, die Nutzertests oder die Messung im Labor oder im Feld durch.' },
  { num: '05', title: 'Ergebnisse', desc: 'Wir werten die Daten aus und überführen sie in konkrete Empfehlungen.' },
];

const audiences = [
  'Produkt & UX',
  'Marketing',
  'E-Commerce',
  'Retail & Dienstleistungen',
  'Geschäftsführung',
];

const faq = [
  {
    q: 'Was ist der Unterschied zwischen einem UX-Audit und Nutzertests?',
    a: 'Einen UX-Audit führt ein Spezialist ohne Beteiligung von Probanden durch und deckt schnell wahrscheinliche Probleme der Oberfläche auf. Bei Nutzertests beobachten wir echte Nutzer beim Lösen konkreter Aufgaben. So überprüfen wir, wo sie wirklich ins Stocken geraten, Fehler machen oder etwas nicht verstehen.',
  },
  {
    q: 'Was ist der Unterschied zwischen Nutzertests und Eye Tracking?',
    a: 'Nutzertests zeigen, ob Menschen wichtige Aufgaben bewältigen und wie sie mit der Oberfläche arbeiten. Eye Tracking misst zusätzlich präzise ihren Blick — was sie gesehen haben, was sie übersehen haben und in welcher Reihenfolge sie Elemente betrachtet haben. Deshalb setzen wir es als Premium-Methode für Fragen ein, bei denen bloße Beobachtung nicht ausreicht.',
  },
  {
    q: 'Wie unterscheidet sich Eye Tracking von einer Heatmap aus der Web-Analytics?',
    a: 'Eine Heatmap aus der Web-Analytics basiert meist auf Klicks, Mausbewegungen oder dem Scrollverhalten. Eye Tracking misst den tatsächlichen Blick des Nutzers. Dadurch erfasst es auch Elemente, die jemand wahrgenommen, aber nicht angeklickt hat — oder Stellen, die komplett übersehen wurden.',
  },
  {
    q: 'Wie viele Testpersonen sind für Nutzertests nötig?',
    a: 'Die Anzahl hängt vom Forschungsziel, der Vielfalt der Zielgruppe und der Auswertungsmethode ab. Zur Problemerkennung arbeiten wir oft mit einer kleineren Stichprobe. Für einen verlässlichen Variantenvergleich oder statistische Schlussfolgerungen ist eine größere Stichprobe nötig. Die konkrete Anzahl empfehlen wir je nach Forschungsfrage.',
  },
  {
    q: 'Was kostet ein UX-Audit oder Nutzertests?',
    a: 'Der Preis hängt vom Umfang, der Anzahl der getesteten Pfade oder Varianten, der Anzahl der Testpersonen, den eingesetzten Methoden und der Form des Ergebnisses ab. Nach einem kurzen Briefing empfehlen wir den passenden Umfang und erstellen ein unverbindliches Angebot.',
  },
  {
    q: 'Muss das Testing im Labor stattfinden?',
    a: 'Nein. Website, App oder Prototyp können wir je nach Projektziel im Labor oder auch remote testen. Das Verhalten im Geschäft, im Betrieb oder in einem anderen physischen Raum beobachten wir direkt im Feld.',
  },
  {
    q: 'Wie schützen Sie die Daten der Testpersonen?',
    a: 'Vor dem Testing legen wir den Verarbeitungszweck fest und holen die informierte Einwilligung jedes Teilnehmers ein. Wir sichern die Daten ab und bereiten die Ergebnisse standardmäßig in aggregierter oder pseudonymisierter Form auf. Den konkreten Umgang legen wir je nach Sensibilität des Projekts, Kundenanforderungen und DSGVO fest.',
  },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'UX MIND Test-Pakete',
    description: 'Test-Pakete der UX-Forschung: schneller UX-Audit, Nutzertests, Premium-Eye-Tracking mit Biometrie und Feldstudie.',
    serviceType: 'UX-Testing',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="de"
  title="Test-Pakete UX MIND | Eye Tracking, Biometrie und UX-Forschung"
  description="Wählen Sie den Umfang des UX-Testings nach dem, was Sie herausfinden möchten. Schneller UX-Audit, Nutzertests, Eye Tracking mit Biometrie und Feldstudie."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-12">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ TEST-PAKETE ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          WÄHLEN SIE DEN<br/>TESTUMFANG<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Danach, was Sie herausfinden möchten.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              Manchmal reicht es, schnell die größten Hindernisse aufzudecken. Ein anderes Mal müssen Sie Varianten vergleichen oder eine wichtige Entscheidung mit mehreren Datenquellen absichern. Wir empfehlen den Umfang, der zu Ihrem Ziel, Ihrem Umfeld und dem gewünschten Grad an Sicherheit passt.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="#balicky" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              PAKETE ANSEHEN ↓
            </a>
            <a href="/de/kontakt" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              BERATUNG ZUR AUSWAHL →
            </a>
          </div>
        </div>
      </div>

      <!-- Škála rozsahu: rychlá volba -->
      <div class="mb-16">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
          {packages.map(pkg => (
            <a href={`#${pkg.id}`} class="group bg-brand-white p-5 hover:bg-brand-black hover:text-brand-white transition-colors">
              <div class="flex justify-between items-start mb-4">
                <span class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/60">{pkg.num}</span>
                <span class="font-mono text-xs opacity-0 group-hover:opacity-100 transition-opacity">↓</span>
              </div>
              <p class="font-display font-bold leading-tight">{pkg.title}</p>
            </a>
          ))}
        </div>
        <!-- Osa rozsahu -->
        <div class="flex items-center gap-3 mt-3 font-mono text-[10px] text-brand-black/60 tracking-widest uppercase">
          <span>Kleinerer Umfang</span>
          <span class="flex-1 h-px bg-gradient-to-r from-brand-black/20 to-brand-black"></span>
          <span>Ausführlichere Forschung</span>
        </div>
      </div>

      <!-- Důvěryhodnostní pás -->
      <div class="reveal mb-24 border-y border-brand-black/10 py-4 overflow-hidden">
        <p class="font-mono text-[11px] text-brand-black/60 tracking-wider whitespace-nowrap md:whitespace-normal overflow-x-auto">
          Forschungsumfeld der FIM UHK · Tobii Pro X2-60 · Smart Eye Aurora · Pupil Labs NEON · iMotions CORE · BeSigma · Shimmer3 GSR · Labor- und Feldmessungen
        </p>
      </div>

      <!-- Proč samotný eye-tracking nestačí — tři vrstvy -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WARUM EYE-TRACKING ALLEIN NICHT REICHT ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Aufmerksamkeit ≠ Verständnis ≠ Konversion<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {[
            { t: 'Was er sah', d: 'Eye Tracking zeigt, was ein Nutzer wirklich sieht und was er übersieht.', tag: 'BLICK' },
            { t: 'Was er tat', d: 'Hat er die Aufgabe erfüllt? Wie lange hat er gebraucht und wo hat er Fehler gemacht?', tag: 'VERHALTEN' },
            { t: 'Warum', d: 'Wie er die Oberfläche bewertet hat und was er im Nachhinein erklären konnte.', tag: 'AUSSAGE' },
          ].map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-sm text-brand-black/60 leading-relaxed mt-4 max-w-2xl">
          Erst die Verbindung aller drei Ebenen unterscheidet ein Problem, das nur den Blick anzieht, von einem Problem, das den Abschluss der Aufgabe verhindert.
        </p>
      </div>

      <!-- Balíčky -->
      <div id="balicky" class="mb-24 scroll-mt-28">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ UNSERE TEST-PAKETE ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-4">Vier Konfigurationen<span style="color:#2D62FC">.</span></h2>
        <p class="text-brand-black/60 leading-relaxed max-w-2xl mb-12">
          Es sind keine starren Produkte — wir passen sie an Ihre Aufgabenstellung an. Bei jedem wissen Sie vorab, was Sie erhalten und was sich mit dem jeweiligen Umfang <strong class="text-brand-black">nicht zuverlässig behaupten lässt</strong>.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          {packages.map(pkg => (
            <div id={pkg.id} class={`reveal p-8 md:p-10 flex flex-col scroll-mt-28 ${pkg.featured ? 'bg-brand-black text-brand-white' : 'bg-brand-white'}`}>
              <div class="flex justify-between items-start mb-6">
                <span class={`font-mono text-xs ${pkg.featured ? 'text-brand-white/60' : 'text-brand-black/60'}`}>{pkg.num}</span>
                {pkg.featured && (
                  <span class="font-mono text-[10px] tracking-widest px-2 py-1" style="background:#2D62FC; color:#FCFCFC;">PREMIUM-MESSUNG</span>
                )}
              </div>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-3 leading-tight">{pkg.title}</h3>
              <p class={`leading-relaxed mb-6 ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>{pkg.tagline}</p>

              <div class="flex flex-wrap gap-2 mb-6">
                {pkg.chips.map(chip => (
                  <span class={`font-mono text-[11px] px-2 py-1 tracking-wide border ${pkg.featured ? 'border-brand-white/30 text-brand-white/80' : 'border-brand-black/20 text-brand-black/70'}`}>{chip}</span>
                ))}
              </div>

              <p class={`text-sm leading-relaxed mb-6 ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>
                <span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Sie erfahren</span>
                {pkg.findings}
              </p>

              <details class={`group mt-auto border-t pt-4 ${pkg.featured ? 'border-brand-white/20' : 'border-brand-black/10'}`}>
                <summary class="flex justify-between items-center cursor-pointer font-mono text-xs tracking-widest uppercase list-none [&::-webkit-details-marker]:hidden">
                  PAKET IM DETAIL
                  <span class="font-mono text-lg transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <div class={`mt-4 space-y-4 text-sm leading-relaxed ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Für wen</span>{pkg.forWho}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Was enthalten ist</span>{pkg.inside}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Was gut zu wissen ist</span>{pkg.limits}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Typisches Ergebnis</span>{pkg.output}</p>
                </div>
              </details>
            </div>
          ))}
        </div>

        <!-- Balíček na míru -->
        <div id="na-miru" class="reveal relative overflow-hidden bg-brand-black text-brand-white p-8 md:p-12 mt-px scroll-mt-28">
          <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
          <div class="relative flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div>
              <p class="font-mono text-xs text-brand-white/60 mb-2">05</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-3">Individuelles Paket<span style="color:#2D62FC">.</span></h3>
              <p class="text-brand-white/70 leading-relaxed max-w-xl">
                Zuerst lernen wir Ihr Geschäft, Ihre Ziele und den Kontext kennen — dann entwerfen wir maßgeschneidert das Testing und die anschließende Optimierung. Von der Forschungsfrage über die passende Methodenkombination bis zu konkreten Anpassungen, die sich in den Ergebnissen niederschlagen. Wir stellen es nach der Entscheidung zusammen, die aus den Daten getroffen wird — nicht nach der Ausstattung des Labors.
              </p>
            </div>
            <a href="/de/kontakt" class="shrink-0 inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              UNSICHER BEI DER WAHL? →
            </a>
          </div>
        </div>
      </div>

      <!-- EMLI -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="grid grid-cols-1 md:grid-cols-[minmax(0,2fr)_minmax(240px,1fr)] md:items-center gap-10 md:gap-16">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ EMLI: INDEX MENTALER BELASTUNG ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">Wo die Oberfläche die meiste Anstrengung erfordert<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed mb-4">
              EMLI überführt ausgewählte Eye-Tracking-Kennwerte in einen Score von 0 bis 100. Dadurch können wir einzelne Bildschirme, Schritte oder Varianten vergleichen und feststellen, wo die Informationsverarbeitung für Nutzer anspruchsvoller ist.
            </p>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              <strong class="text-brand-black">Je höher der Score, desto größer die Belastung.</strong> Das Ergebnis bewerten wir immer gemeinsam mit dem Nutzerverhalten und weiteren Daten, nicht als eigenständiges Urteil.
            </p>
          </div>
          <div aria-label="Skala EMLI von geringerer zu höherer mentaler Belastung">
            <div class="emli-scale h-2 mb-4" aria-hidden="true">
              <div class="emli-fill"></div>
            </div>
            <div class="flex items-start justify-between gap-6 font-mono text-[10px] tracking-widest uppercase">
              <p><strong class="block font-display text-3xl leading-none mb-2 text-brand-blue">0</strong>Geringere Belastung</p>
              <p class="text-right"><strong class="block font-display text-3xl leading-none mb-2 text-brand-blue">100</strong>Höhere Belastung</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Proces a výstupy -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WIE DIE ZUSAMMENARBEIT ABLÄUFT ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10">Vom Ziel zu konkreten Anpassungen<span style="color:#2D62FC">.</span></h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-px bg-brand-black/10 border border-brand-black/10">
          {process.map(step => (
            <div class="bg-brand-white p-6 md:p-7 min-h-64 flex flex-col">
              <span class="font-mono text-xs text-brand-black/60 mb-10">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mt-auto">{step.desc}</p>
            </div>
          ))}
        </div>

        <p class="font-mono text-xs text-brand-black/60 tracking-widest mt-16 mb-8">[ WAS SIE ALS ERGEBNIS ERHALTEN ]</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {outputs.map((output, i) => (
            <div class="bg-brand-white p-7 md:p-8 min-h-56 flex flex-col">
              <span class="font-mono text-xs text-brand-black/60 mb-8">0{i + 1}</span>
              <h3 class="font-display text-2xl font-bold leading-tight mb-3">{output.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mt-auto">{output.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Pro koho -->
      <div class="reveal mb-24 max-w-4xl">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ FÜR WEN DIE PAKETE GEEIGNET SIND ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6">Für Teams, die nach Daten entscheiden möchten<span style="color:#2D62FC">.</span></h2>
        <p class="text-brand-black/60 leading-relaxed mb-8 max-w-3xl">
          Die Test-Pakete nutzen Produkt- und UX-Teams, Marketing, E-Commerce, Retail sowie die Geschäftsführung. Den Umfang passen wir daran an, ob Sie Navigation, ein Formular, eine Kampagne, den Kaufprozess, einen physischen Raum oder Entscheidungsgrundlagen für eine wichtige Entscheidung bearbeiten.
        </p>
        <div class="flex flex-wrap gap-x-5 gap-y-3">
          {audiences.map(a => (
            <span class="font-mono text-[11px] text-brand-black/60 tracking-widest uppercase">{a}</span>
          ))}
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ HÄUFIGE FRAGEN ZUM TESTING ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10">Was gut zu wissen ist, bevor Sie wählen<span style="color:#2D62FC">.</span></h2>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    // Scroll-Reveal — gleiches Pattern wie bei den Fallstudien
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>

  <style>
    /* EMLI stupnice — čára jednou najede (0 → 100) a ustálí se na 63; spustí se, až sekce naroluje do viewportu */
    .emli-scale {
      position: relative;
      overflow: hidden;
      background: rgba(45, 98, 252, 0.1);
    }
    .emli-fill {
      position: absolute;
      inset: 0;
      transform-origin: left center;
      background: linear-gradient(90deg, rgba(45, 98, 252, 0.16), #2d62fc);
      transform: scaleX(0.63);
    }
    .reveal.is-visible .emli-fill {
      animation: emliFill 2.8s ease-in-out both;
    }
    @keyframes emliFill {
      0% { transform: scaleX(0); }
      65% { transform: scaleX(1); }
      100% { transform: scaleX(0.63); }
    }
    @media (prefers-reduced-motion: reduce) {
      .reveal.is-visible .emli-fill { animation: none; }
      .emli-fill { transform: scaleX(0.63); }
    }
  </style>
</BaseLayout>
</content>
