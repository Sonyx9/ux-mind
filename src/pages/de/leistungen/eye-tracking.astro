---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const faq = [
  { q: "Wie viele Testpersonen braucht eine Eye-Tracking-Studie?", a: "Für qualitative Einblicke genügen 8–12 Testpersonen pro Segment. Für quantitative Metriken (Heatmaps, AOI-Statistiken) empfehlen wir 30 und mehr, und für die Berechnung des kognitiven Belastungsindex EMLI arbeiten wir mit Stichproben von über 100 Testpersonen." },
  { q: "Wie lange dauert ein Eye-Tracking-Test?", a: "Ein typisches Projekt dauert 1–3 Wochen ab Freigabe des Szenarios: Vorbereitung und Pilotierung, Datenerhebung im Labor oder im Feld, Analyse und Report mit priorisierten Empfehlungen." },
  { q: "Ist Eye Tracking dasselbe wie Neuromarketing?", a: "Nein. Eye Tracking ist eine objektive Aufzeichnung visueller Aufmerksamkeit — wir versprechen weder „Gedankenlesen“ noch das Lesen von Emotionen. Wir interpretieren die Daten stets im Kontext der Aufgabe und mit klar benannten Grenzen der Methode." },
  { q: "Was zeigt eine Heatmap und was lese ich nicht daraus ab?", a: "Eine Heatmap aggregiert, wohin die Testpersonen am häufigsten geschaut haben. Sie sagt aber nicht, wie anspruchsvoll die Oberfläche für sie war — deshalb ergänzen wir sie um AOI-Metriken (TTFF, Dwell Time) und den kognitiven Belastungsindex EMLI." },
];

const steps = [
  { num: '01', title: 'Vorbereitung', desc: 'Testszenarien nach Ihren Zielen und Definition der AOI (Areas of Interest).' },
  { num: '02', title: 'Testing', desc: 'Nutzer interagieren mit dem Produkt, der Eye Tracker zeichnet den Blick auf.' },
  { num: '03', title: 'Analyse', desc: 'Heatmaps, Gaze Plots und AOI-Statistiken aus den erhobenen Daten.' },
  { num: '04', title: 'Empfehlungen', desc: 'Konkrete Anpassungen von Layout und Inhaltshierarchie.' },
];

const usecases = [
  { t: 'Websites', d: 'Wo Nutzer Zeit verbringen, was sie übersehen und warum sie nicht auf Ihre CTAs reagieren.', tag: 'WEB' },
  { t: 'Mobile Apps', d: 'Navigation, Lesbarkeit und Usability mobiler Produkte.', tag: 'APP' },
  { t: 'E-Commerce', d: 'Produktseiten, Warenkorb und Checkout für bessere Konversionen.', tag: 'E-SHOP' },
  { t: 'Printmaterialien', d: 'Banner, Plakate, Verpackungen — was auf physischen Materialien Aufmerksamkeit anzieht.', tag: 'PRINT' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: "Eye Tracking und Nutzertests",
    description: "Messung visueller Aufmerksamkeit mit Eye Tracking: Heatmaps, AOI-Analyse, Blickaufzeichnungen und Nutzertests von Websites, Apps und Printmaterialien.",
    serviceType: 'Eye Tracking',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="de"
  title="Eye Tracking und Aufmerksamkeits-Heatmaps"
  description="Eye Tracking für Websites, Apps und Printmaterialien: Heatmaps, AOI-Analyse, Blickaufzeichnungen und Nutzertests im Labor der FIM UHK. Erfahren Sie, was Nutzer wirklich sehen."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ LEISTUNGEN / EYE TRACKING ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          WIR SEHEN,<br/>WAS SIE NICHT SEHEN<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Objektive Aufzeichnung visueller Aufmerksamkeit.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              Eye Tracking liefert präzise Daten darüber, wie Nutzer Ihre Inhalte wahrnehmen.
              Wir wissen, <strong class="text-brand-black">wohin sie schauen, was sie übersehen und was sie fesselt</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="/de/kontakt" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              TESTING VEREINBAREN →
            </a>
            <a href="/de/leistungen/test-pakete" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              TEST-PAKETE
            </a>
          </div>
        </div>
      </div>

      <!-- Infoleiste -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DAUER', '1–3 Wochen'],
          ['TECHNOLOGIE', 'Tobii Pro · Smart Eye'],
          ['ERGEBNISSE', 'Heatmaps · AOI · Gaze Plots'],
          ['PAKET', 'Standard-UX-Test'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Foto von der Messung -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
          alt="Testperson während einer Eye-Tracking-Messung im Labor — sie betrachtet den getesteten Stimulus auf einem Monitor mit Eye Tracker"
          title="Ablauf einer Eye-Tracking-Messung im Labor"
          width="1080" height="1920" loading="lazy" decoding="async"
          class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Erhebung visueller Aufmerksamkeitsdaten im Labor — die Blickaufzeichnung wird für AOI-Analysen und Heatmaps gespeichert.</p>
      </div>

      <!-- Wo wir helfen -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WO WIR HELFEN ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Bildschirm, Papier und Regal<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
          {usecases.map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-xl font-bold mb-3 leading-tight">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-sm text-brand-black/60 leading-relaxed mt-4">
          Außerhalb des Labors messen wir mit mobilen Brillen — siehe <a href="/de/leistungen/feldforschung" class="underline hover:no-underline">Feldforschung</a>.
        </p>
      </div>

      <!-- So funktioniert es + EMLI -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ SO FUNKTIONIERT ES ]</p>
          <div class="space-y-0">
            {steps.map(step => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="border border-brand-black/10 p-8 flex flex-col justify-between">
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ ZUSÄTZLICH: EMLI-INDEX ]</p>
            <h3 class="font-display text-2xl font-bold mb-3">Blick + Belastung in einem Score<span style="color:#2D62FC">.</span></h3>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Aus Eye-Tracking-Metriken bilden wir den Index mentaler Belastung EMLI (0–100).
              Vergleichen Sie, welche Varianten oder Schritte Nutzer die meiste Anstrengung kosten.
            </p>
          </div>
          <p class="font-display font-bold leading-none mt-6" style="font-size: clamp(2.5rem, 5vw, 4rem); color:#2D62FC;">0–100</p>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ HÄUFIGE FRAGEN ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            WAS SEHEN IHRE<br/>NUTZER<span style="color:#2D62FC">?</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            Schicken Sie uns Ihre Website, App oder Kreation. Wir entwerfen ein Messszenario und sagen Ihnen, was sich daraus sicher ableiten lässt.
          </p>
          <a href="/de/kontakt" class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
            TESTING VEREINBAREN →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
