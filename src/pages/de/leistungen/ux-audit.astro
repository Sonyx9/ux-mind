---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const reveals = [
  { t: 'Barrieren in der Journey', d: 'Wo Nutzer die Orientierung verlieren, wo sie hängen bleiben und was sie zum Abbruch bewegt.', tag: 'JOURNEY' },
  { t: 'Bekannte Probleme', d: 'Verstöße gegen bewährte Usability-Prinzipien — bevor Ihre Kunden sie finden.', tag: 'HEURISTIKEN' },
  { t: 'Quick Wins', d: 'Anpassungen mit großer Wirkung und geringem Aufwand, die sich sofort umsetzen lassen.', tag: 'PRIORITÄTEN' },
];

const process = [
  { num: '01', title: 'Aufgabenstellung und Umfang', desc: 'Schlüsselpfade, Ziele und Business-Kontext des Produkts.' },
  { num: '02', title: 'Heuristische Analyse', desc: 'Systematischer Durchgang der Oberfläche nach bewährten Prinzipien.' },
  { num: '03', title: 'Analyse der Pfade und Daten', desc: 'User Flows; wenn Sie Analytics haben, beziehen wir sie ein.' },
  { num: '04', title: 'Report und Workshop', desc: 'Priorisierte Empfehlungen und gemeinsame Planung der Anpassungen.' },
];

const outputs = [
  'Priorisierte Problemliste nach Wirkung',
  'Konkrete Empfehlungen mit Lösungsvorschlägen',
  'Quick Wins zur sofortigen Umsetzung',
  'Ergebnisbericht mit Mockups',
  'Workshop mit Ihrem Team',
];

const faq = [
  { q: 'Wie lange dauert ein UX-Audit?', a: 'Typischerweise 2–4 Wochen je nach Produktumfang: Erstanalyse, heuristische Bewertung, Datenanalyse und Präsentation der Ergebnisse.' },
  { q: 'Worin unterscheidet sich ein Audit von Nutzertests?', a: 'Ein Audit ist eine Expertenbewertung — ein Spezialist beurteilt die Oberfläche nach bewährten Prinzipien, ohne Testpersonen. Nutzertests beobachten echte Nutzer beim Lösen von Aufgaben. Das Audit ist der schnellere und günstigere erste Schritt, Tests überprüfen das Verhalten in der Praxis.' },
  { q: 'Wann reicht ein Audit nicht aus?', a: 'Ein Audit identifiziert wahrscheinliche Probleme, belegt aber weder ihren Einfluss auf das Nutzerverhalten noch auf die Konversion. Wenn Sie Entscheidungen mit Daten untermauern müssen, schließen Messungen an — Eye-Tracking, Nutzertests oder Biometrie.' },
  { q: 'Was brauchen Sie von uns?', a: 'Zugang zum Produkt (Website, App, Prototyp), eine Beschreibung der Schlüsselpfade und Ziele. Wenn Sie Analytics haben, beziehen wir sie in die Analyse ein.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'UX-Audit',
    description: 'Experten-UX-Audit für Website, Onlineshop oder App: heuristische Analyse, Analyse der User Journeys, priorisierte Empfehlungen und Workshop. Die schnelle Basis jeder Verbesserung.',
    serviceType: 'UX-Audit',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="de"
  title="UX-Audit für Website und Onlineshop | Expertenanalyse der Usability"
  description="UX-Audit für Website, Onlineshop oder App in 2–4 Wochen. Heuristische Analyse, Pfadanalyse, priorisierte Empfehlungen und Quick Wins. Die schnelle Basis jeder Verbesserung."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ LEISTUNGEN / UX-AUDIT ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          STARTEN SIE<br/>MIT DEM AUDIT<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Die schnelle Basis jeder Verbesserung.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              Ein Spezialist geht Ihre Oberfläche aus Nutzerperspektive durch und findet Barrieren,
              bevor Ihre Kunden sie finden. Das Ergebnis ist ein <strong class="text-brand-black">priorisierter Maßnahmenplan</strong>, nicht nur eine Fehlerliste.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="/de/kontakt" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              AUDIT ANFRAGEN →
            </a>
            <a href="/de/leistungen/test-pakete" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              TEST-PAKETE
            </a>
          </div>
        </div>
      </div>

      <!-- Infoleiste -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DAUER', '2–4 Wochen'],
          ['METHODE', 'Expertenbewertung'],
          ['TESTPERSONEN', 'Nicht erforderlich'],
          ['PAKET', 'Schnelldiagnose'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Was das Audit aufdeckt -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WAS DAS AUDIT AUFDECKT ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Probleme, die Nutzer stillschweigend hinnehmen<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {reveals.map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Foto -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/jan-petruzalek-analyza-eye-tracking-dat.webp`}
          alt="Spezialist bei der Analyse von Daten aus UX-Audit und Eye-Tracking"
          title="Datenanalyse beim UX-Audit"
          width="1200" height="800" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Ein Audit ist keine Meinungssache — jede Erkenntnis belegen wir mit einer konkreten Stelle in der Oberfläche und dem Prinzip, gegen das sie verstößt.</p>
      </div>

      <!-- Prozess + Ergebnis -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ SO LÄUFT DAS AUDIT AB ]</p>
          <div class="space-y-0">
            {process.map(step => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ WAS SIE ERHALTEN ]</p>
          <ul class="space-y-2">
            {outputs.map(o => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {o}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Grenzen der Leistung -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ GRENZEN DES AUDITS ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">Das Audit zeigt wo, die Messung belegt warum<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Eine Expertenbewertung identifiziert wahrscheinliche Probleme, belegt aber nicht deren Einfluss auf Verhalten und Konversion.
              Wenn Sie Entscheidungen mit Daten verteidigen müssen, schließen an das Audit Eye-Tracking, Nutzertests oder Biometrie an.
            </p>
          </div>
          <a href="/de/leistungen/test-pakete" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            ANSCHLIESSENDE MESSUNGEN →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ HÄUFIGE FRAGEN ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            WAS KOSTET SIE<br/>IHRE WEBSITE<span style="color:#2D62FC">?</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            Schicken Sie uns einen Link. Innerhalb weniger Tage sagen wir Ihnen, ob ein Audit sinnvoll ist und was Sie davon erwarten können.
          </p>
          <a href="/de/kontakt" class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
            AUDIT ANFRAGEN →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
