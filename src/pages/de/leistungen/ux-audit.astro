---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const reveals = [
  { t: 'Hindernisse im Ablauf', d: 'Schritte, bei denen es schwerfällt, sich zu orientieren, weiterzukommen oder die richtige Information zu finden.', tag: 'NUTZERPFAD' },
  { t: 'Unklare Oberfläche', d: 'Unverständliche Bezeichnungen, schwache visuelle Hierarchie und Elemente, bei denen unklar ist, was sie bewirken.', tag: 'VERSTÄNDLICHKEIT' },
  { t: 'Prioritäten der Anpassungen', d: 'Probleme geordnet nach Wirkung und Aufwand, damit klar ist, was zuerst zu lösen ist.', tag: 'NÄCHSTE SCHRITTE' },
];

const process = [
  { num: '01', title: 'Ziel und Umfang', desc: 'Wir wählen die wichtigsten Seiten, Nutzerpfade und Ziele des Audits aus.' },
  { num: '02', title: 'Expertenprüfung', desc: 'Wir prüfen Navigation, Inhalt, Hierarchie und Verständlichkeit der Oberfläche.' },
  { num: '03', title: 'Zusammenhänge und Daten', desc: 'Wir setzen die Erkenntnisse in den Kontext des Produkts und beziehen verfügbare Analytics ein.' },
  { num: '04', title: 'Empfehlungen und Übergabe', desc: 'Wir ordnen die Probleme nach Wichtigkeit und besprechen gemeinsam die nächsten Schritte.' },
];

const outputs = [
  { title: 'Problemübersicht', desc: 'Wir verknüpfen jede Erkenntnis mit einer konkreten Stelle in der Oberfläche und erklären ihre Wirkung.' },
  { title: 'Prioritäten nach Wirkung', desc: 'Wir unterscheiden, was sofort zu lösen ist, was später und was vorerst nicht wichtig ist.' },
  { title: 'Konkrete Änderungsvorschläge', desc: 'Wir empfehlen, wie das Problem zu beheben ist. Bei ausgewählten Stellen ergänzen wir einen Entwurf oder ein Lösungsbeispiel.' },
  { title: 'Gemeinsame Ergebnisübergabe', desc: 'Wir gehen die Schlussfolgerungen gemeinsam mit Ihrem Team durch, damit klar ist, wie sie in die Praxis umzusetzen sind.' },
];

const faq = [
  { q: 'Was umfasst ein UX-Audit?', a: 'Wir prüfen die wichtigsten Seiten und Nutzerpfade, Navigation, Inhalt, visuelle Hierarchie sowie die Verständlichkeit der Oberfläche. Das Ergebnis ist eine Problemübersicht, ihre Priorisierung und konkrete Empfehlungen für Anpassungen.' },
  { q: 'Wie lange dauert ein UX-Audit?', a: 'Meist 2–4 Wochen, je nach Umfang des Produkts und der Anzahl geprüfter Pfade. Den genauen Termin legen wir nach einem kurzen Briefing fest.' },
  { q: 'Was kostet ein UX-Audit?', a: 'Der Preis hängt vom Umfang des Produkts, der Anzahl der Schlüsselpfade und der gewünschten Form des Ergebnisses ab. Nach Kenntnis Ihrer Aufgabenstellung erstellen wir ein konkretes Angebot ohne versteckte Posten.' },
  { q: 'Worin unterscheidet sich ein UX-Audit von Nutzertests?', a: 'Ein UX-Audit ist eine Expertenprüfung der Oberfläche ohne Probanden. Nutzertests beobachten echte Nutzer beim Lösen von Aufgaben und zeigen, wie sich Probleme in der Praxis auswirken.' },
  { q: 'Lässt sich auch ein Onlineshop, eine App oder ein Prototyp auditieren?', a: 'Ja. Wir auditieren Websites, Onlineshops, Apps sowie ausreichend ausgearbeitete Prototypen. Den Umfang passen wir immer an die Phase des Produkts und die Entscheidung an, die Sie treffen müssen.' },
  { q: 'Was benötigen Sie, um den Audit zu starten?', a: 'Zugang zum Produkt oder Prototyp, eine Beschreibung der Zielnutzer und der wichtigsten Aufgaben, die sie bewältigen sollen. Wenn Sie Web-Analytics oder frühere Forschung haben, können wir diese als zusätzlichen Kontext einbeziehen.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'UX-Audit',
    description: 'Experten-UX-Audit für Website, Onlineshop oder App: heuristische Analyse, Analyse der User Journeys, priorisierte Empfehlungen und Workshop. Die schnelle Basis jeder Verbesserung.',
    serviceType: 'UX-Audit',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="de"
  title="UX-Audit für Website und Onlineshop | Expertenanalyse der Usability"
  description="UX-Audit für Website, Onlineshop oder App in 2–4 Wochen. Heuristische Analyse, Pfadanalyse, priorisierte Empfehlungen und Quick Wins. Die schnelle Basis jeder Verbesserung."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ LEISTUNGEN / UX-AUDIT ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          DECKEN SIE<br/>SCHWACHSTELLEN AUF<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-3xl">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">UX-Audit für Website, Onlineshop oder App.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify mb-4">
              Wir gehen die wichtigsten Seiten und Nutzerpfade durch. Wir prüfen Navigation, Verständlichkeit der Inhalte, visuelle Hierarchie sowie Hindernisse beim Abschluss wichtiger Aufgaben.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify">
              Sie erhalten konkrete Empfehlungen, geordnet nach Wirkung und Aufwand, damit Sie wissen, <strong class="text-brand-black">was Sie zuerst ändern sollten</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/de/kontakt" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              UX-AUDIT ANFRAGEN →
            </a>
            <a href="/de/leistungen#testovaci-balicky" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              PAKETE ANSEHEN
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DAUER', '2–4 Wochen'],
          ['METHODE', 'Expertenbewertung'],
          ['TESTPERSONEN', 'Nicht erforderlich'],
          ['PAKET', 'Schneller UX-Audit'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Co audit odhalí -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WAS DER UX-AUDIT AUFDECKT ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Was den Abschluss einer Aufgabe unnötig erschwert<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {reveals.map((v, i) => (
            <div class="bg-brand-white p-8 flex flex-col h-full">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed text-justify mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest self-start mt-auto">{v.tag}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Foto -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/jan-petruzalek-analyza-eye-tracking-dat.webp`}
          alt="Spezialist bei der Analyse von Daten aus UX-Audit und Eye-Tracking"
          title="Datenanalyse beim UX-Audit"
          width="1200" height="800" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Ein Audit ist keine Meinungssache — jede Erkenntnis belegen wir mit einer konkreten Stelle in der Oberfläche und dem Prinzip, gegen das sie verstößt.</p>
      </div>

      <!-- Proces -->
      <div class="reveal mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WIE DER AUDIT ABLÄUFT ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Vier Schritte von der Aufgabenstellung zu den Empfehlungen<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
          {process.map(step => (
            <div class="border-t border-brand-black/20 pt-5">
              <span class="block font-mono text-xs text-brand-black/60 mb-5">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Výstup -->
      <div class="reveal mb-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.35fr] gap-10 lg:gap-16">
          <div>
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ WAS SIE ERHALTEN ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              Ein klarer Plan, was zuerst zu ändern ist<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <div class="border-t border-brand-white/20">
            {outputs.map((output, i) => (
              <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_12rem_1fr] gap-x-4 gap-y-2 py-5 border-b border-brand-white/20">
                <span class="font-mono text-xs text-brand-white/50 pt-1">0{i + 1}</span>
                <h3 class="font-display text-lg font-bold leading-tight">{output.title}</h3>
                <p class="col-start-2 sm:col-start-3 text-sm text-brand-white/65 leading-relaxed">{output.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Kdy audit stačí a kdy testovat -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ WANN AUDIT REICHT, WANN GETESTET WIRD ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">Der Audit deckt Schwachstellen auf. Testing belegt ihre Wirkung<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Ein UX-Audit eignet sich, wenn Sie schnell Probleme finden und einen konkreten Plan für Anpassungen erhalten möchten.
              Wenn Sie prüfen möchten, wie sich Nutzer in der Oberfläche tatsächlich verhalten und welche Hindernisse den größten Einfluss haben, schließen wir mit Nutzertests oder Eye Tracking an.
            </p>
          </div>
          <a href="/de/leistungen/test-pakete" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            TESTMÖGLICHKEITEN ANSEHEN →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ HÄUFIGE FRAGEN ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
</content>
