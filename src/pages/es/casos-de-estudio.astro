---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="es"
  title="Casos de estudio"
  description="Estudios reales de eye tracking con cifras verificables: 40 % de candidatos perdidos, 92 % de miradas en el CTA principal, p = 0,037. Solo publicamos lo que los datos respaldan."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CASOS DE ESTUDIO ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          LOS RESULTADOS<br/>HABLAN<span style="color:#2D62FC">.</span>
        </h1>
        <p class="text-xl text-brand-black/60 max-w-3xl leading-relaxed">
          Mediciones reales, muestras reales. Solo publicamos cifras respaldadas por datos primarios — incluidos el método, el tamaño de la muestra y los límites.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10">
        {[
          {
            href: '/es/casos-de-estudio/karierni-portal-automotive',
            category: "ŠKODA AUTO · portal de empleo",
            title: "El 40 % de los candidatos no encontró el camino hacia las vacantes. Y la web «parecía clara».",
            desc: "El eye tracking con el escenario «encuentre las vacantes» mostró que la valoración subjetiva de la claridad no coincide con la capacidad de completar la tarea. La comparación A/B de un CTA flotante arrojó diferencias medibles en las métricas de fijación y en la duración de la visita. El resultado fue un recorrido simplificado hacia las vacantes y una navegación rediseñada.",
            method: "Eye tracking + cuestionario · N = 102",
            tags: ["Eye tracking", "Navegación", "Test A/B"],
            result: "4 de 10 no encontraron las vacantes",
          },
          {
            href: '/es/casos-de-estudio/backend-stories',
            category: "Microsite educativo",
            title: "Cuanto más largo el texto, menos atención.",
            desc: "El análisis AOI reveló un gradiente de atención: el titular destacado lo registró aproximadamente el 86 % de los participantes, el texto corto siguiente el 62 % y el párrafo largo el 33 %. Los resultados respaldaron destacar el CTA principal y acortar los bloques largos.",
            method: "Eye tracking, análisis AOI · aprox. 120 participantes",
            tags: ["Análisis AOI", "Jerarquía de contenido", "CTA"],
            result: "92 % registró el CTA",
          },
          {
            href: '/es/casos-de-estudio/produktove-fotografie-e-commerce',
            category: "E-commerce",
            title: "Mismo producto. Decisiones de distinta duración.",
            desc: "El experimento comparó un packshot limpio con una fotografía lifestyle. El tipo de fotografía influyó de forma estadísticamente significativa en el tiempo de finalización de la tarea — F(1,82) = 4,50; p = 0,037. La variante lifestyle llevó, en el escenario probado, a un tiempo más largo; la diferencia en la valoración subjetiva no se confirmó con claridad.",
            method: "Eye tracking + UEQ · N = 84",
            tags: ["Foto de producto", "Experimento", "PDP"],
            result: "Lifestyle alargó la tarea",
          },
          {
            href: '/es/casos-de-estudio/reklamni-bannery-smer-pohledu',
            category: "Creatividad publicitaria",
            title: "La mirada del personaje dirigió la atención de los visitantes.",
            desc: "El cambio en la dirección de la mirada del personaje influyó de forma estadísticamente significativa en la distribución de la atención: F(1,102) = 12,57; p < 0,001; ηp² = 0,11. El experimento documentó un efecto de tamaño medio en las creatividades probadas; no midió clics ni conversión.",
            method: "Experimento de eye tracking · N = 104",
            tags: ["Banners", "Señales visuales", "Atención"],
            result: "ηp² = 0,11 · efecto medio",
          },
          {
            href: '/es/casos-de-estudio/sablony-e-shopu',
            category: "Plantillas de e-shop",
            title: "La tarea cambió hacia dónde dirigían la atención.",
            desc: "El eye tracking de tres plantillas con el mismo surtido mostró que la distribución de la atención cambiaba según la tarea asignada. VisAWI complementó la valoración subjetiva del aspecto — el estudio muestra así por qué es necesario evaluar por separado la estética y el comportamiento durante la tarea de compra.",
            method: "Eye tracking + VisAWI · N = 61",
            tags: ["E-commerce", "Estética vs. rendimiento", "Pruebas por tareas"],
            result: "3 plantillas · 2 tipos de tarea",
          },
          {
            href: '/es/casos-de-estudio/billboardy-sport-marketing',
            category: "Marketing deportivo · publicidad exterior",
            title: "Los seis primeros puestos fueron para las vallas negras.",
            desc: "El eye tracking y la valoración de 16 diseños mostraron una clara preferencia por las variantes negras. Sin embargo, las métricas de fijación por sí solas no determinaron el ganador — el estudio muestra por qué, al elegir la creatividad, es necesario combinar la atención con la valoración del público objetivo.",
            method: "Eye tracking + cuestionario de valoración · N = 79 · 16 estímulos de 10 s",
            tags: ["Vallas", "OOH", "Insight de género"],
            result: "TOP 6 · fondo negro",
          },
        ].map(study => (
          <div class="bg-brand-white p-10 flex flex-col">
            <div class="flex flex-col gap-2 md:flex-row md:justify-between md:items-start mb-6">
              <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5 self-start">{study.category}</span>
              <a href={study.href} class="font-display text-lg font-bold leading-tight md:text-right md:whitespace-nowrap hover:opacity-70 transition-opacity" style="color:#2D62FC">{study.result}</a>
            </div>
            <h3 class="font-display text-2xl font-bold mb-4 leading-tight"><a href={study.href} class="hover:opacity-60 transition-opacity">{study.title}</a></h3>
            <p class="text-brand-black/60 leading-relaxed mb-6 text-justify">{study.desc}</p>
            <p class="font-mono text-[11px] text-brand-black/60 tracking-wide mb-6">MÉTODO: {study.method}</p>
            <div class="flex flex-wrap gap-2 mt-auto mb-6">
              {study.tags.map(tag => (
                <span class="font-mono text-xs text-brand-black/60 border border-brand-black/10 px-2 py-1">{tag}</span>
              ))}
            </div>
            <a href={study.href} class="inline-block self-start border border-brand-black px-5 py-2.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              VER EL ESTUDIO →
            </a>
          </div>
        ))}
      </div>

      <details class="group border border-brand-black/15 mt-6">
        <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
          [ GLOSARIO ]
          <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <dl class="px-5 pb-6 space-y-4">
            <div><dt class="font-display font-bold mb-1">p</dt><dd class="text-sm text-brand-black/70 leading-relaxed">probabilidad de que el resultado sea casualidad (0,037 = 3,7 % — cuanto menor, más concluyente)</dd></div>
            <div><dt class="font-display font-bold mb-1">ηp²</dt><dd class="text-sm text-brand-black/70 leading-relaxed">tamaño del efecto (0,11 ≈ efecto medio, visible en la práctica)</dd></div>
            <div><dt class="font-display font-bold mb-1">N</dt><dd class="text-sm text-brand-black/70 leading-relaxed">número de personas testadas</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">área observada de la página</dd></div>
        </dl>
      </details>

    </div>
  </main>

  <Footer />
</BaseLayout>
