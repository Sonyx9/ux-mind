---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="es"
  title="Casos de estudio"
  description="Estudios reales de eye tracking con cifras verificables: 40 % de candidatos perdidos, 92 % de miradas en el CTA principal, p = 0,037. Solo publicamos lo que los datos respaldan."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CASOS DE ESTUDIO ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          LOS RESULTADOS<br/>HABLAN.
        </h1>
        <p class="text-xl text-brand-black/60 max-w-3xl leading-relaxed">
          Mediciones reales, muestras reales. Solo publicamos cifras respaldadas por datos primarios — incluidos el método, el tamaño de la muestra y los límites.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10">
        {[
          {
            category: "Automoción · portal de empleo",
            title: "El 40 % de los candidatos no encontró las vacantes — en una web que «parecía clara».",
            desc: "El eye tracking con el escenario «encuentre las vacantes» mostró que la claridad percibida no coincide con el éxito en la tarea. Una comparación A/B de un CTA flotante produjo diferencias medibles en métricas de fijación y duración de la visita. Resultado: recorrido simplificado y navegación rediseñada.",
            method: "Eye tracking + cuestionario · N = 102",
            tags: ["Eye tracking", "Navegación", "Test A/B"],
            result: "40 % perdidos",
          },
          {
            category: "Microsite educativo",
            title: "El 92 % de las miradas terminó en el CTA principal. Solo un tercio leyó el párrafo largo.",
            desc: "El análisis AOI reveló un gradiente de lectura: ~86 % registró el titular en negrita, 62 % el texto corto y solo ~33 % el párrafo largo. La orientación la aporta la jerarquía, no la cantidad de texto — se destacó el CTA principal y se acortaron los bloques largos.",
            method: "Eye tracking, análisis AOI · ~120 participantes",
            tags: ["Análisis AOI", "Jerarquía de contenido", "CTA"],
            result: "92 % en el CTA",
          },
          {
            category: "E-commerce",
            title: "Las fotos lifestyle se ven mejor. Pero ralentizaron la decisión de compra — de forma medible.",
            desc: "Un experimento comparó un packshot limpio con una foto lifestyle. El tipo de foto tuvo un efecto significativo en el tiempo de la tarea — F(1,82) = 4,50; p = 0,037. Sin efecto claro en las valoraciones subjetivas: «más bonito» no significa «más eficaz».",
            method: "Eye tracking + UEQ · N = 84",
            tags: ["Fotos de producto", "Experimento", "PDP"],
            result: "p = 0,037",
          },
          {
            category: "Creatividad publicitaria",
            title: "Adonde mira la persona de su banner, mira también su cliente.",
            desc: "La manipulación de la señal visual (dirección de la mirada del modelo) tuvo un fuerte efecto estadístico en la distribución de la atención: F(1,102) = 12,57; p < 0,001; ηp² = 0,11 — un efecto de tamaño medio. La dirección de la mirada es una de las herramientas más baratas para guiar la atención al mensaje y al CTA.",
            method: "Experimento de eye tracking · N = 104",
            tags: ["Banners", "Señales visuales", "Atención"],
            result: "ηp² = 0,11",
          },
          {
            category: "Plantillas de e-shop",
            title: "Tres plantillas, el mismo surtido. La atención cambiaba según la tarea asignada.",
            desc: "La misma plantilla producía patrones de atención distintos según la tarea recibida. Las valoraciones estéticas sin contexto de tarea son engañosas — pruebe su plantilla con tareas de compra reales, no «por impresión».",
            method: "Eye tracking + VisAWI · N = 61",
            tags: ["E-commerce", "Estética vs. rendimiento", "Pruebas por tareas"],
            result: "3 plantillas × 2 tareas",
          },
          {
            category: "Marketing deportivo · OOH",
            title: "16 diseños de vallas, 79 pares de ojos. Ganaron las variantes negras minimalistas.",
            desc: "Los seis diseños mejor valorados tenían fondo negro; la variante ganadora logró la mejor puntuación TOP3 y el mejor puesto medio. El insight más fuerte: la publicidad visual influye en el 39 % de las mujeres frente al 16 % de los hombres. Recomendación: fondo limpio, titular claro, composición no agresiva.",
            method: "Eye tracking + cuestionario de valoración · N = 79 · 16 estímulos de 10 s",
            tags: ["Vallas", "OOH", "Insight de género"],
            result: "39 % vs 16 %",
          },
        ].map(study => (
          <div class="bg-brand-white p-10 flex flex-col">
            <div class="flex flex-col gap-2 md:flex-row md:justify-between md:items-start mb-6">
              <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5 self-start">{study.category}</span>
              <span class="font-display text-2xl font-bold leading-none md:text-right" style="color:#2D62FC">{study.result}</span>
            </div>
            <h3 class="font-display text-2xl font-bold mb-4 leading-tight">{study.title}</h3>
            <p class="text-brand-black/60 leading-relaxed mb-6">{study.desc}</p>
            <p class="font-mono text-[11px] text-brand-black/60 tracking-wide mb-6">MÉTODO: {study.method}</p>
            <div class="flex flex-wrap gap-2 mt-auto">
              {study.tags.map(tag => (
                <span class="font-mono text-xs text-brand-black/60 border border-brand-black/10 px-2 py-1">{tag}</span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <p class="font-mono text-[11px] text-brand-black/60 leading-relaxed mt-6">GLOSARIO: p = probabilidad de que el resultado sea casualidad (0,037 = 3,7 % — cuanto menor, más concluyente) · ηp² = tamaño del efecto (0,11 ≈ efecto medio, visible en la práctica) · N = número de personas testadas · AOI = área observada de la página</p>

      <div class="text-center py-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ ¿QUIERE DATOS ASÍ PARA SU WEB? ]</p>
        <h2 class="font-display text-5xl font-bold mb-8">Midamos su proyecto</h2>
        <a href="/es/contacto" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
          SOLICITAR PRESUPUESTO →
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
