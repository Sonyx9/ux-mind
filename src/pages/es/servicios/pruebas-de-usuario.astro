---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const formats = [
  { t: 'Pruebas moderadas', d: 'Un investigador observa al participante mientras completa las tareas, pregunta y ayuda a descubrir por qué se detuvo en un punto concreto o decidió de otra manera.', tag: 'EN PROFUNDIDAD · EN LABORATORIO Y ONLINE' },
  { t: 'Pruebas no moderadas', d: 'Los participantes completan las tareas preparadas por su cuenta. Este formato permite incorporar rápidamente a más personas y comparar sus resultados.', tag: 'MUESTRA MAYOR · ONLINE' },
];

const findings = [
  { title: 'Finalización de tareas', desc: 'Comprobamos si las personas logran completar tareas importantes, cuánto tiempo tardan y en qué pasos se detienen.' },
  { title: 'Claridad de la interfaz', desc: 'Detectamos elementos, nombres e información que los usuarios no entienden o pasan por alto.' },
  { title: 'Motivos de la decisión', desc: 'Averiguamos qué esperan los usuarios, por qué eligen un camino concreto y si sus declaraciones coinciden con su comportamiento real.' },
];

const process = [
  { num: '01', title: 'Objetivo y guion', desc: 'Aclaramos qué necesita verificar y preparamos tareas realistas.' },
  { num: '02', title: 'Selección de participantes', desc: 'Determinamos el público objetivo adecuado y reclutamos participantes según los criterios acordados.' },
  { num: '03', title: 'Pruebas', desc: 'Los participantes completan las tareas preparadas. Observamos su progreso, errores, reacciones y comentarios.' },
  { num: '04', title: 'Análisis y recomendaciones', desc: 'Evaluamos los hallazgos, los ordenamos por importancia y los convertimos en propuestas concretas de mejora.' },
];

const faq = [
  { q: '¿Cuántos participantes se necesitan?', a: 'Para detectar cualitativamente los problemas principales suelen bastar 5–8 participantes por segmento. Para comparar variantes o hacer una evaluación estadística se necesita una muestra mayor y diseñada con más precisión — el alcance lo proponemos según la pregunta de investigación.' },
  { q: '¿Cuánto duran las pruebas de usuario?', a: 'Normalmente 1–4 semanas según el alcance, la forma de reclutamiento y el número de participantes. Concretamos el calendario exacto tras precisar el objetivo y el público objetivo.' },
  { q: '¿Cuánto cuestan las pruebas de usuario?', a: 'El precio depende del número de participantes, la forma de reclutamiento, el formato de las pruebas y el alcance de la entrega. Tras un breve encargo inicial, le recomendamos el alcance adecuado y preparamos una propuesta concreta.' },
  { q: '¿Podemos probar también un prototipo?', a: 'Sí. Probamos webs, e-commerce y aplicaciones terminados, así como prototipos clicables. Cuanto antes se detecta un problema, más fácil y económico suele ser su ajuste.' },
  { q: '¿En qué se diferencian las pruebas de usuario de una auditoría UX?', a: 'La auditoría UX es una revisión experta de la interfaz sin participantes. Las pruebas de usuario observan a usuarios reales completando tareas y comprueban cómo se manifiestan los problemas en la práctica.' },
  { q: '¿Las pruebas de usuario incluyen eye tracking?', a: 'No en el alcance estándar. Ofrecemos el eye tracking como una ampliación independiente, cuando necesita medir con precisión la atención visual y saber qué elementos notaron las personas o qué pasaron por alto.' },
  { q: '¿Podemos ver las pruebas en directo?', a: 'Sí. En las pruebas moderadas, previo acuerdo, puede seguir el desarrollo desde un espacio separado o de forma remota, siempre respetando el consentimiento de los participantes y las condiciones del estudio.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Pruebas de usuario',
    description: 'Pruebas de usuario moderadas y no moderadas de webs, aplicaciones y prototipos. Protocolo think-aloud, grabación de pantalla, análisis del éxito en las tareas y recomendaciones.',
    serviceType: 'Pruebas de usuario',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="es"
  title="Pruebas de usuario | Pruebas UX moderadas y no moderadas"
  description="Pruebas de usuario de webs, aplicaciones y prototipos con usuarios reales. Pruebas moderadas y no moderadas, think-aloud, grabación de pantalla y recomendaciones concretas."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICIOS / PRUEBAS DE USUARIO ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          VERIFIQUE<br/>LA USABILIDAD<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-3xl">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Verifique tareas importantes con usuarios reales.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify mb-4">
              Observamos cómo utilizan las personas su web, e-commerce, aplicación o prototipo. Comprobamos si logran orientarse, completar tareas importantes y qué partes de la interfaz no entienden.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify">
              Recibirá hallazgos concretos y recomendaciones sobre <strong class="text-brand-black">qué ajustar para que el producto sea más claro y fácil de usar</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/es/contacto" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              SOLICITAR PRUEBAS →
            </a>
            <a href="/es/servicios#testovaci-balicky" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              VER PAQUETES
            </a>
          </div>
        </div>
      </div>

      <!-- Franja informativa -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURACIÓN', '1–4 semanas'],
          ['FORMATO', 'Moderadas y online'],
          ['MUESTRA', 'Según la pregunta de investigación'],
          ['PAQUETE', 'Prueba UX estándar'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Cómo probamos -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CÓMO PROBAMOS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Elegimos el formato según el objetivo del estudio<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          {formats.map((v, i) => (
            <div class="bg-brand-white p-8 flex flex-col h-full">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed text-justify mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest self-start mt-auto">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-sm md:text-base text-brand-black/60 leading-relaxed mt-6 max-w-4xl">
          <strong class="text-brand-black">Según el objetivo de las pruebas</strong> incorporamos el pensamiento en voz alta, una entrevista posterior, cuestionarios breves y grabación de pantalla.
        </p>
      </div>

      <!-- Foto -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
          alt="Participante durante una prueba de usuario en el laboratorio"
          title="Desarrollo de una prueba de usuario"
          width="1080" height="1920" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">En el laboratorio, las pruebas pueden complementarse con eye-tracking — verá no solo qué hizo el usuario, sino también qué vio mientras tanto.</p>
      </div>

      <!-- Qué revelan las pruebas -->
      <div class="reveal mb-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.35fr] gap-10 lg:gap-16">
          <div>
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ QUÉ REVELAN LAS PRUEBAS ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              Dónde ayuda la interfaz — y dónde estorba<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <div class="border-t border-brand-white/20">
            {findings.map((finding, i) => (
              <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_12rem_1fr] gap-x-4 gap-y-2 py-6 border-b border-brand-white/20">
                <span class="font-mono text-xs text-brand-white/50 pt-1">0{i + 1}</span>
                <h3 class="font-display text-lg font-bold leading-tight">{finding.title}</h3>
                <p class="col-start-2 sm:col-start-3 text-sm text-brand-white/65 leading-relaxed">{finding.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Proceso -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CÓMO SE DESARROLLAN LAS PRUEBAS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Del objetivo a las mejoras concretas<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
          {process.map(step => (
            <div class="border-t border-brand-black/20 pt-5">
              <span class="block font-mono text-xs text-brand-black/60 mb-5">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Ampliación opcional -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ AMPLIACIÓN OPCIONAL ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">Cuando también necesita medir la atención<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Las pruebas de usuario muestran si las personas completan la tarea y dónde se detienen. El eye tracking, además,
              puede medir con precisión qué elementos notaron, qué pasaron por alto y cómo cambió su atención durante la tarea. Añadimos métodos biométricos solo cuando responden al objetivo del estudio.
            </p>
          </div>
          <a href="/es/servicios/eye-tracking" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            VER EYE TRACKING →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ PREGUNTAS FRECUENTES ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
</content>
