---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const formats = [
  { t: 'Pruebas moderadas', d: 'Un investigador guía al participante por el escenario, repregunta y profundiza allí donde ocurre algo.', tag: 'LAB / ONLINE' },
  { t: 'Pruebas no moderadas', d: 'Los participantes completan las tareas por su cuenta. Recogida más rápida, muestra mayor, condiciones más naturales.', tag: 'ONLINE' },
  { t: 'Think-aloud', d: 'El participante comenta en voz alta qué ve y por qué hace clic mientras trabaja. Revela el modelo mental, no solo el comportamiento.', tag: 'PROTOCOLO' },
];

const findings = [
  'Si los usuarios completan las tareas clave — y dónde fallan exactamente',
  'Cuánto duran las tareas y cuántos errores surgen en ellas',
  'Qué elementos no entienden los usuarios o pasan por alto',
  'En qué se diferencia el comportamiento de los principiantes y de los usuarios experimentados',
  'Qué dicen los usuarios vs. qué hacen realmente',
];

const process = [
  { num: '01', title: 'Escenario y tareas', desc: 'Definimos qué debe verificarse y preparamos tareas realistas.' },
  { num: '02', title: 'Reclutamiento de participantes', desc: 'Reclutamos según su público objetivo, no una audiencia aleatoria.' },
  { num: '03', title: 'Pruebas', desc: 'Moderadas o no moderadas, con grabación de pantalla y piloto.' },
  { num: '04', title: 'Análisis y recomendaciones', desc: 'Tasa de éxito, tiempo, tasa de errores y propuestas concretas de ajustes.' },
];

const faq = [
  { q: '¿Cuántos participantes se necesitan?', a: 'Para detectar cualitativamente los problemas principales suelen bastar 5–8 participantes por segmento. Para comparar variantes o hacer una evaluación estadística se necesita una muestra mayor y diseñada con más precisión — el tamaño lo proponemos según la pregunta de investigación.' },
  { q: '¿Podemos probar también un prototipo?', a: 'Sí. Probamos webs y aplicaciones en producción, así como prototipos clicables (Figma y similares). Cuanto antes se prueba, más económicos son los ajustes.' },
  { q: '¿En qué se diferencian las pruebas de una auditoría UX?', a: 'La auditoría es una evaluación realizada por un experto sin participantes — un primer paso más rápido. Las pruebas observan a usuarios reales completando tareas y verifican el comportamiento real. Idealmente se complementan.' },
  { q: '¿Podremos ver las pruebas en directo?', a: 'Sí, en las pruebas moderadas puede estar en la línea de observación. Ver a sus propios usuarios suele ser el argumento más convincente para el equipo.' },
  { q: '¿Y si los usuarios valoran la web positivamente pero no completan la tarea?', a: 'Eso es exactamente lo que revelan las pruebas. La impresión subjetiva de una «página clara» a menudo no coincide con la tasa de éxito real — por eso medimos el comportamiento, no solo las opiniones.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Pruebas de usuario',
    description: 'Pruebas de usuario moderadas y no moderadas de webs, aplicaciones y prototipos. Protocolo think-aloud, grabación de pantalla, análisis del éxito en las tareas y recomendaciones.',
    serviceType: 'Pruebas de usuario',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="es"
  title="Pruebas de usuario | Pruebas UX moderadas y no moderadas"
  description="Pruebas de usuario de webs, aplicaciones y prototipos con usuarios reales. Pruebas moderadas y no moderadas, think-aloud, grabación de pantalla y recomendaciones concretas."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICIOS / PRUEBAS DE USUARIO ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          OBSERVE<br/>DÓNDE FALLAN<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Pruebas con usuarios reales, no con impresiones.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              Observamos cómo la gente completa tareas reales en su producto. Descubrirá
              <strong class="text-brand-black">qué hacen los usuarios</strong> — no solo qué dicen del producto.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="/es/contacto" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              SOLICITAR PRUEBAS →
            </a>
            <a href="/es/servicios/paquetes-de-prueba" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              PAQUETES DE PRUEBA
            </a>
          </div>
        </div>
      </div>

      <!-- Franja informativa -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURACIÓN', '1–4 semanas'],
          ['FORMATO', 'Moderadas y online'],
          ['MUESTRA', 'Según la pregunta de investigación'],
          ['PAQUETE', 'Prueba UX estándar'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Formatos -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ FORMATOS DE PRUEBA ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Tres maneras de observar<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {formats.map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Foto -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
          alt="Participante durante una prueba de usuario en el laboratorio"
          title="Desarrollo de una prueba de usuario"
          width="1080" height="1920" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">En el laboratorio, las pruebas pueden complementarse con eye-tracking — verá no solo qué hizo el usuario, sino también qué vio mientras tanto.</p>
      </div>

      <!-- Qué descubrirá + proceso -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ QUÉ DESCUBRIRÁ ]</p>
          <ul class="space-y-2">
            {findings.map(o => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {o}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ CÓMO SE DESARROLLAN LAS PRUEBAS ]</p>
          <div class="space-y-0">
            {process.map(step => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Límites -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ CUANDO NECESITA MÁS ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">El comportamiento lo ve. La atención y la carga, no<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Una prueba clásica muestra si el usuario completó la tarea. Pero no muestra qué vio realmente,
              qué pasó por alto y cuánto le costó. Por eso combinamos las pruebas con eye-tracking y biometría.
            </p>
          </div>
          <a href="/es/servicios/eye-tracking" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            AÑADIR EYE-TRACKING →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ PREGUNTAS FRECUENTES ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            ¿COMPLETARÁN LOS USUARIOS<br/>SU TAREA<span style="color:#2D62FC">?</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            Envíenos el producto y el recorrido clave. Propondremos un escenario de prueba y el formato que dé la respuesta más rápido.
          </p>
          <a href="/es/contacto" class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
            SOLICITAR PRUEBAS →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
