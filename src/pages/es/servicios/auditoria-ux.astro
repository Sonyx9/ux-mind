---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const reveals = [
  { t: 'Barreras en el recorrido', d: 'Pasos en los que puede resultar difícil orientarse, continuar o encontrar la información correcta.', tag: 'RECORRIDO DEL USUARIO' },
  { t: 'Interfaz poco clara', d: 'Nombres confusos, jerarquía visual débil y elementos cuya función no está clara.', tag: 'CLARIDAD' },
  { t: 'Prioridades de mejora', d: 'Problemas ordenados según impacto y dificultad, para que quede claro qué resolver primero.', tag: 'PRÓXIMOS PASOS' },
];

const process = [
  { num: '01', title: 'Objetivo y alcance', desc: 'Seleccionamos las páginas clave, los recorridos de usuario y los objetivos de la auditoría.' },
  { num: '02', title: 'Revisión experta', desc: 'Revisamos la navegación, el contenido, la jerarquía y la claridad de la interfaz.' },
  { num: '03', title: 'Contexto y datos', desc: 'Situamos los hallazgos en el contexto del producto e incorporamos la analítica disponible.' },
  { num: '04', title: 'Recomendaciones y entrega', desc: 'Ordenamos los problemas según su importancia y revisamos juntos los próximos pasos.' },
];

const outputs = [
  { title: 'Resumen de problemas', desc: 'Vinculamos cada hallazgo con un lugar concreto de la interfaz y explicamos su impacto.' },
  { title: 'Prioridades según impacto', desc: 'Distinguimos qué hay que resolver de inmediato, qué más adelante y qué aún no es prioritario.' },
  { title: 'Propuestas concretas de mejora', desc: 'Recomendamos cómo resolver cada problema. En los puntos seleccionados añadimos una propuesta o ejemplo de solución.' },
  { title: 'Entrega conjunta de resultados', desc: 'Revisamos las conclusiones con su equipo para que quede claro cómo llevarlas a la práctica.' },
];

const faq = [
  { q: '¿Qué incluye una auditoría UX?', a: 'Revisamos las páginas clave y los recorridos de usuario, la navegación, el contenido, la jerarquía visual y la claridad de la interfaz. El resultado es un resumen de problemas, sus prioridades y recomendaciones concretas de mejora.' },
  { q: '¿Cuánto dura una auditoría UX?', a: 'Normalmente 2–4 semanas según el alcance del producto y el número de recorridos revisados. Concretamos el plazo tras un breve encargo inicial.' },
  { q: '¿Cuánto cuesta una auditoría UX?', a: 'El precio depende del alcance del producto, del número de recorridos clave y del formato de entrega solicitado. Tras conocer el encargo, preparamos una propuesta concreta sin partidas ocultas.' },
  { q: '¿En qué se diferencia la auditoría UX de las pruebas de usuario?', a: 'La auditoría UX es una revisión experta de la interfaz sin participantes. Las pruebas de usuario observan a usuarios reales completando tareas y comprueban cómo se manifiestan los problemas en la práctica.' },
  { q: '¿Se puede auditar también un e-commerce, una aplicación o un prototipo?', a: 'Sí. Auditamos webs, tiendas online, aplicaciones y prototipos suficientemente desarrollados. Siempre adaptamos el alcance a la fase del producto y a la decisión que necesita tomar.' },
  { q: '¿Qué necesita para iniciar la auditoría?', a: 'Acceso al producto o prototipo, una descripción de los usuarios objetivo y de las tareas clave que deben completar. Si dispone de analítica web o de investigación previa, podemos incorporarlas como contexto adicional.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Auditoría UX',
    description: 'Auditoría UX experta de webs, e-commerce o aplicaciones: análisis heurístico, análisis de los recorridos de usuario, recomendaciones priorizadas y taller. La base rápida de toda mejora.',
    serviceType: 'Auditoría UX',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="es"
  title="Auditoría UX de webs y e-commerce | Análisis experto de usabilidad"
  description="Auditoría UX de su web, e-commerce o aplicación en 2–4 semanas. Análisis heurístico, análisis de recorridos, recomendaciones priorizadas y quick wins. La base rápida de toda mejora."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICIOS / AUDITORÍA UX ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          DETECTE<br/>LOS PUNTOS DÉBILES<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-3xl">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Auditoría UX de su web, e-commerce o aplicación.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify mb-4">
              Revisamos las páginas clave y los recorridos de usuario. Analizamos la navegación, la claridad del contenido, la jerarquía visual y las barreras que dificultan completar tareas importantes.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify">
              Recibirá recomendaciones concretas ordenadas según su impacto y dificultad, para que sepa <strong class="text-brand-black">qué ajustar primero</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/es/contacto" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              SOLICITAR AUDITORÍA UX →
            </a>
            <a href="/es/servicios#testovaci-balicky" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              VER PAQUETES
            </a>
          </div>
        </div>
      </div>

      <!-- Franja informativa -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURACIÓN', '2–4 semanas'],
          ['MÉTODO', 'Evaluación experta'],
          ['PARTICIPANTES', 'No son necesarios'],
          ['PAQUETE', 'Auditoría UX rápida'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Qué revela la auditoría -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ QUÉ REVELA LA AUDITORÍA UX ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Qué complica innecesariamente completar una tarea<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {reveals.map((v, i) => (
            <div class="bg-brand-white p-8 flex flex-col h-full">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed text-justify mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest self-start mt-auto">{v.tag}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Foto -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/jan-petruzalek-analyza-eye-tracking-dat.webp`}
          alt="Especialista analizando datos de una auditoría UX y de eye-tracking"
          title="Análisis de datos durante una auditoría UX"
          width="1200" height="800" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">La auditoría no es cuestión de impresiones — cada hallazgo lo documentamos con un lugar concreto de la interfaz y el principio que infringe.</p>
      </div>

      <!-- Proceso -->
      <div class="reveal mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CÓMO SE DESARROLLA LA AUDITORÍA ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Cuatro pasos, del encargo a las recomendaciones<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
          {process.map(step => (
            <div class="border-t border-brand-black/20 pt-5">
              <span class="block font-mono text-xs text-brand-black/60 mb-5">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Qué recibirá -->
      <div class="reveal mb-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.35fr] gap-10 lg:gap-16">
          <div>
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ QUÉ RECIBIRÁ ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              Un plan claro de qué ajustar primero<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <div class="border-t border-brand-white/20">
            {outputs.map((output, i) => (
              <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_12rem_1fr] gap-x-4 gap-y-2 py-5 border-b border-brand-white/20">
                <span class="font-mono text-xs text-brand-white/50 pt-1">0{i + 1}</span>
                <h3 class="font-display text-lg font-bold leading-tight">{output.title}</h3>
                <p class="col-start-2 sm:col-start-3 text-sm text-brand-white/65 leading-relaxed">{output.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Cuándo basta con la auditoría y cuándo probar -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ CUÁNDO BASTA CON LA AUDITORÍA Y CUÁNDO PROBAR ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">La auditoría detecta los puntos débiles. Las pruebas confirman su impacto<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              La auditoría UX es adecuada cuando necesita encontrar problemas rápidamente y obtener un plan de mejora concreto.
              Si quiere comprobar cómo se comportan realmente los usuarios en la interfaz y qué barreras tienen mayor impacto, continuamos con pruebas de usuario o eye tracking.
            </p>
          </div>
          <a href="/es/servicios/paquetes-de-prueba" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            VER OPCIONES DE PRUEBA →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ PREGUNTAS FRECUENTES ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
</content>
