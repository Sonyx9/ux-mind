---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const faq = [
  { q: '¿Cuántos participantes se necesitan para un estudio de eye tracking?', a: 'Para insights cualitativos bastan 8–12 participantes por segmento. Para métricas cuantitativas (heatmaps, estadísticas AOI) recomendamos 30 o más, y para el cálculo del índice de carga cognitiva EMLI trabajamos con muestras de más de 100 participantes.' },
  { q: '¿Cuánto duran las pruebas de eye tracking?', a: 'Un proyecto típico dura 1–3 semanas desde la aprobación del escenario: preparación y pilotaje, recogida de datos en el laboratorio o en campo, análisis e informe con recomendaciones priorizadas.' },
  { q: '¿El eye tracking es lo mismo que el neuromarketing?', a: 'No. El eye tracking es un registro objetivo de la atención visual — no prometemos «leer la mente» ni las emociones. Siempre interpretamos los datos en el contexto de la tarea y con los límites del método claramente descritos.' },
  { q: '¿Qué muestra un heatmap y qué no puedo leer en él?', a: 'Un heatmap agrega hacia dónde miraron los participantes con más frecuencia. Pero no dice cuán exigente les resultó la interfaz — por eso lo complementamos con métricas AOI (TTFF, dwell time) y el índice de carga cognitiva EMLI.' },
];

const steps = [
  { num: '01', title: 'Preparación', desc: 'Escenarios de prueba según sus objetivos y definición de las AOI (Areas of Interest).' },
  { num: '02', title: 'Pruebas', desc: 'Los usuarios interactúan con el producto, el eye tracker registra la mirada.' },
  { num: '03', title: 'Análisis', desc: 'Heatmaps, gaze plots y estadísticas AOI a partir de los datos recogidos.' },
  { num: '04', title: 'Recomendaciones', desc: 'Ajustes concretos del layout y de la jerarquía del contenido.' },
];

const usecases = [
  { t: 'Sitios web', d: 'Dónde pasan tiempo los usuarios, qué pasan por alto y por qué no reaccionan a sus CTA.', tag: 'WEB' },
  { t: 'Aplicaciones móviles', d: 'Navegación, legibilidad y usabilidad de los productos móviles.', tag: 'APP' },
  { t: 'E-commerce', d: 'Fichas de producto, carrito y checkout para mejorar las conversiones.', tag: 'E-SHOP' },
  { t: 'Materiales impresos', d: 'Banners, carteles, envases — qué atrae la atención en los materiales físicos.', tag: 'PRINT' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Eye tracking y pruebas de usuario',
    description: 'Medición de la atención visual mediante eye tracking: heatmaps, análisis AOI, grabaciones de la mirada y pruebas de usuario de webs, aplicaciones y materiales impresos.',
    serviceType: 'Eye tracking',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="es"
  title="Eye tracking y heatmaps de atención"
  description="Eye tracking de webs, aplicaciones y materiales impresos: heatmaps, análisis AOI, grabaciones de la mirada y pruebas de usuario en el laboratorio de la FIM UHK. Descubra qué ven realmente los usuarios."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICIOS / EYE TRACKING ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          VEMOS LO QUE<br/>USTED NO VE<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Un registro objetivo de la atención visual.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              El eye tracking revela datos precisos sobre cómo los usuarios perciben sus contenidos.
              Sabemos <strong class="text-brand-black">hacia dónde miran, qué pasan por alto y qué les llama la atención</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="/es/contacto" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              CONCERTAR PRUEBAS →
            </a>
            <a href="/es/servicios/paquetes-de-prueba" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              PAQUETES DE PRUEBA
            </a>
          </div>
        </div>
      </div>

      <!-- Franja informativa -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURACIÓN', '1–3 semanas'],
          ['TECNOLOGÍA', 'Tobii Pro · Smart Eye'],
          ['ENTREGAS', 'Heatmaps · AOI · gaze plots'],
          ['PAQUETE', 'Prueba UX estándar'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Foto de la medición -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
          alt="Participante durante una medición de eye-tracking en el laboratorio — observa el estímulo de prueba en un monitor con eye-tracker"
          title="Desarrollo de una medición de eye-tracking en el laboratorio"
          width="1080" height="1920" loading="lazy" decoding="async"
          class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Recogida de datos de atención visual en el laboratorio — la grabación de la mirada se guarda para el análisis AOI y los heatmaps.</p>
      </div>

      <!-- Dónde ayudamos -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ DÓNDE AYUDAMOS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Pantalla, papel y lineal<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
          {usecases.map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-xl font-bold mb-3 leading-tight">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-sm text-brand-black/60 leading-relaxed mt-4">
          Fuera del laboratorio medimos con gafas móviles — vea la <a href="/es/servicios/investigacion-de-campo" class="underline hover:no-underline">investigación de campo</a>.
        </p>
      </div>

      <!-- Cómo funciona + EMLI -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ CÓMO FUNCIONA ]</p>
          <div class="space-y-0">
            {steps.map(step => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="border border-brand-black/10 p-8 flex flex-col justify-between">
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ ADEMÁS: ÍNDICE EMLI ]</p>
            <h3 class="font-display text-2xl font-bold mb-3">Mirada + carga en una sola puntuación<span style="color:#2D62FC">.</span></h3>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              A partir de las métricas de eye-tracking componemos el índice de carga mental EMLI (0–100).
              Compare qué variantes o pasos cuestan más esfuerzo a los usuarios.
            </p>
          </div>
          <p class="font-display font-bold leading-none mt-6" style="font-size: clamp(2.5rem, 5vw, 4rem); color:#2D62FC;">0–100</p>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ PREGUNTAS FRECUENTES ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            ¿QUÉ VEN SUS<br/>USUARIOS<span style="color:#2D62FC">?</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            Envíenos su web, aplicación o creatividad. Propondremos un escenario de medición y le diremos qué podrá concluirse de él con seguridad.
          </p>
          <a href="/es/contacto" class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
            CONCERTAR PRUEBAS →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
