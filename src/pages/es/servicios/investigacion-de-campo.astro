---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const contexts = [
  { t: 'Retail y tiendas', d: 'Movimiento entre estanterías, visibilidad de categorías, disposición de productos, precios y materiales POS.' },
  { t: 'Servicios y showrooms', d: 'Orientación del visitante, interacción con los productos expuestos y momentos que conducen a la interacción.' },
  { t: 'Deporte y eventos', d: 'Navegación en el recinto, espacios patrocinados, zonas de restauración, señalización de seguridad y experiencia del visitante.' },
  { t: 'Transporte y ciudades', d: 'Sistemas de información, mapas, puntos de transbordo, señalización y orientación en el espacio público.' },
  { t: 'Automoción y movilidad', d: 'Atención al manejar el vehículo, el infotainment, un punto de recarga o un producto físico.' },
  { t: 'Industria y lugares de trabajo', d: 'Procedimientos de trabajo, paneles de control, información de seguridad e interacción con el equipamiento.' },
  { t: 'Sanidad y servicios', d: 'Orientación de los pacientes, instrucciones, elementos de autoservicio y recorrido por el servicio prestado.' },
  { t: 'Aviación', d: 'Navegación de pasajeros, procedimientos operativos, interfaces informativas y situaciones de formación.' },
];

const findings = [
  { title: 'Movimiento real por el espacio', desc: 'Captamos la ruta, las paradas, los regresos y los lugares donde las personas cambian de dirección o dudan.' },
  { title: 'Atención en contexto', desc: 'Descubrimos qué notan las personas mientras se mueven y qué información, productos o señalización pasan por alto.' },
  { title: 'Momentos de decisión', desc: 'Vinculamos la mirada con la interacción, la elección de producto, la finalización de la tarea o la petición de ayuda.' },
  { title: 'Influencia del entorno', desc: 'Evaluamos cómo influyen en el comportamiento la disposición del espacio, el tráfico, la iluminación o la presencia de otras personas.' },
];

const process = [
  { num: '01', title: 'Objetivo y ubicación', desc: 'Aclaramos la decisión que debe respaldar el estudio y las condiciones del entorno concreto.' },
  { num: '02', title: 'Reconocimiento del lugar', desc: 'Revisamos la ubicación, los riesgos, los permisos necesarios y los momentos que tiene sentido observar.' },
  { num: '03', title: 'Guion y pilotaje', desc: 'Preparamos las tareas, las rutas y el protocolo, y los verificamos directamente en el lugar.' },
  { num: '04', title: 'Medición de campo', desc: 'Realizamos la calibración y la recogida de datos con gafas móviles, observación o entrevistas.' },
  { num: '05', title: 'Análisis y recomendaciones', desc: 'Vinculamos la mirada, el movimiento y la situación, y proponemos cambios concretos del espacio o del procedimiento.' },
];

const outputs = [
  { title: 'Grabación de la mirada en primera persona', desc: 'El vídeo muestra la escena frente al participante y el punto exacto al que miraba en cada momento.' },
  { title: 'Mapa de los momentos clave', desc: 'Señalamos los lugares donde las personas buscan, se detienen, regresan o reaccionan a un estímulo.' },
  { title: 'Comportamiento y contexto', desc: 'Vinculamos la mirada con la ruta, las interacciones, el éxito de la tarea y la explicación posterior del participante.' },
  { title: 'Recomendaciones para el funcionamiento real', desc: 'Proponemos ajustes de la señalización, la disposición, la comunicación, el equipamiento o el procedimiento de trabajo.' },
];

const controls = [
  { title: 'Calibración en movimiento', desc: 'Controlamos la calidad de la grabación antes de la medición y durante su desarrollo.' },
  { title: 'Condiciones variables', desc: 'Registramos el tráfico, la luz, el ruido y otros factores que pueden alterar el resultado.' },
  { title: 'Protocolo comparable', desc: 'Definimos las tareas, las rutas y el orden de forma que las grabaciones puedan compararse con sentido.' },
  { title: 'Consentimiento y privacidad', desc: 'Coordinamos el estudio con el operador, trabajamos con consentimiento informado y protegemos a las personas que aparecen en la grabación.' },
];

const faq = [
  { q: '¿Qué es la investigación de campo y cuándo tiene sentido?', a: 'La investigación de campo observa el comportamiento de las personas directamente en el entorno donde realizan habitualmente la tarea. Es adecuada cuando el resultado depende del espacio, el movimiento, el tráfico del entorno o la interacción física, y una situación de laboratorio no podría captar ese contexto con fidelidad.' },
  { q: '¿El estudio de campo tiene que incluir eye tracking?', a: 'No necesariamente. Según el objetivo, puede bastar con la observación, la grabación en vídeo y una entrevista. Incorporamos el eye tracking móvil cuando necesita saber con precisión qué notaron las personas durante el movimiento y qué pasaron por alto.' },
  { q: '¿Cómo funciona técnicamente el eye tracking móvil?', a: 'El participante lleva puestas unas ligeras gafas Pupil Labs Neon que registran la escena frente a él y la dirección de la mirada. Antes de cada medición realizamos una calibración y controlamos la calidad de la grabación de forma continua.' },
  { q: '¿En qué se diferencia la medición de campo del laboratorio?', a: 'En el campo captamos el espacio real, el tráfico y la toma de decisiones en contexto. Pero las condiciones cambian más, por eso usamos pilotaje, un protocolo unificado y registramos las circunstancias que pueden influir en los resultados.' },
  { q: '¿Las gafas no alteran el comportamiento natural?', a: 'Toda observación puede influir hasta cierto punto en el comportamiento. Por eso damos tiempo a los participantes para acostumbrarse al equipo y evaluamos con reserva la parte inicial de la grabación.' },
  { q: '¿Necesitamos el consentimiento del operador y de los participantes?', a: 'Sí. Coordinamos la medición con el operador del espacio y cada participante firma un consentimiento informado. Protegemos a las personas que aparecen en la grabación y la información sensible según un protocolo de datos acordado de antemano.' },
  { q: '¿Cuántos participantes necesitamos?', a: 'El número depende del objetivo del estudio, del número de entornos y de los grupos que necesite comparar. Proponemos la muestra según la pregunta de investigación, no según una cifra universal.' },
  { q: '¿Cuánto dura un estudio de campo y cuánto cuesta?', a: 'Normalmente 2–6 semanas según la ubicación, los permisos, el número de participantes y el alcance del análisis. Tras el encargo inicial y el reconocimiento del entorno, preparamos un calendario y un precio concretos.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Investigación de campo',
    description: 'Investigación UX de campo con gafas móviles de eye-tracking Pupil Labs NEON: tiendas, showrooms, eventos, automotive y HMI. Atención y comportamiento en el entorno real.',
    serviceType: 'Eye-tracking de campo',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="es"
  title="Investigación de campo y eye tracking móvil | UX MIND"
  description="Investigación de campo y eye tracking móvil en tiendas, transporte, automoción, industria y servicios. Mida la atención y el comportamiento en el entorno real."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICIOS / INVESTIGACIÓN DE CAMPO ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          MIDA<br/>LA REALIDAD<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-3xl">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Observe las decisiones donde realmente ocurren.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify mb-4">
              La investigación de campo muestra cómo se orientan y deciden las personas en una tienda, un showroom, un estadio, el transporte, un lugar de trabajo u otro entorno real. Captamos la mirada, el movimiento y las circunstancias que no pueden reproducirse por completo en el laboratorio.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify">
              Según el objetivo del estudio, complementamos el eye tracking móvil con observación, grabación en vídeo o una entrevista posterior. El resultado son <strong class="text-brand-black">recomendaciones concretas para el espacio, la señalización, la disposición de los productos y los procedimientos de trabajo</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/es/contacto" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              SOLICITAR ESTUDIO DE CAMPO →
            </a>
            <a href="/es/servicios#testovaci-balicky" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              VER PAQUETES
            </a>
          </div>
        </div>
      </div>

      <!-- Franja informativa -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURACIÓN', '2–6 semanas'],
          ['MEDICIÓN', 'Observación · eye tracking móvil'],
          ['COMPLEMENTOS', 'Vídeo · entrevistas · GSR'],
          ['PAQUETE', 'Estudio de campo'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Qué captamos en el campo -->
      <div class="reveal mb-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.35fr] gap-10 lg:gap-16">
          <div>
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ QUÉ CAPTAMOS EN EL CAMPO ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              Comportamiento en contexto, no aislado<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <div class="border-t border-brand-white/20">
            {findings.map((finding, i) => (
              <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_13rem_1fr] gap-x-4 gap-y-2 py-6 border-b border-brand-white/20">
                <span class="font-mono text-xs text-brand-white/50 pt-1">0{i + 1}</span>
                <h3 class="font-display text-lg font-bold leading-tight">{finding.title}</h3>
                <p class="col-start-2 sm:col-start-3 text-sm text-brand-white/65 leading-relaxed">{finding.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Dónde medimos -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ DÓNDE MEDIMOS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6 max-w-4xl">
          En todos los lugares donde el entorno cambia la decisión<span style="color:#2D62FC">.</span>
        </h2>
        <p class="text-brand-black/60 leading-relaxed text-justify max-w-3xl mb-12">
          El estudio de campo tiene sentido en todos los lugares donde no basta con mostrarle una pantalla a la persona. Observamos el movimiento real, la interacción física y las influencias del entorno que determinan si la persona se orienta y completa la tarea.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12">
          {contexts.map((context, i) => (
            <div class="grid grid-cols-[2rem_1fr] gap-x-4 py-6 border-t border-brand-black/20">
              <span class="font-mono text-xs text-brand-black/50 pt-1">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="font-display text-xl font-bold mb-2 leading-tight">{context.t}</h3>
                <p class="text-sm text-brand-black/60 leading-relaxed">{context.d}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Tecnología -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 border border-brand-black/15">
        <div class="min-h-[360px]">
          <img
            src={`${base}/images/laborator-ux-vyzkumu-vizualizace-2.webp`}
            alt="Infraestructura de investigación de UX MIND para preparar el eye tracking móvil de campo"
            title="Preparación del equipo para la medición de campo"
            width="1200" height="771" loading="lazy" decoding="async"
            class="w-full h-full object-cover object-center"
          />
        </div>
        <div class="p-8 md:p-12 flex flex-col justify-center">
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ EYE TRACKING MÓVIL ]</p>
          <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6">
            Dos equipos. Un protocolo preciso<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-black/60 leading-relaxed text-justify mb-5">
            Pupil Labs Neon graba la escena frente al participante y, al mismo tiempo, el punto al que mira. Su diseño ligero permite medir durante el movimiento natural en el espacio.
          </p>
          <p class="text-brand-black/60 leading-relaxed text-justify">
            Disponemos de dos equipos de gafas móviles. Según el diseño del estudio, podemos medir a dos participantes a la vez, trabajar en varios lugares o mantener un equipo de reserva para una recogida de datos sin interrupciones.
          </p>
          <p class="font-mono text-[11px] text-brand-black/60 tracking-wide mt-8 pt-5 border-t border-brand-black/10">
            PUPIL LABS NEON (2×) · VÍDEO · OBSERVACIÓN · GSR OPCIONAL
          </p>
        </div>
      </div>

      <!-- Qué recibirá -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-16">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ QUÉ RECIBIRÁ ]</p>
          <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight max-w-xl">
            La grabación no basta. Necesita saber qué cambiar<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-black/60 leading-relaxed mt-6 max-w-xl text-justify">
            No entregamos horas de vídeo sin contexto. Vinculamos los momentos clave con la tarea, el entorno y el comportamiento del participante, y los convertimos en prioridades para el funcionamiento real.
          </p>
        </div>
        <div class="border-t border-brand-black/20">
          {outputs.map((output, i) => (
            <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_13rem_1fr] gap-x-4 gap-y-2 py-6 border-b border-brand-black/20">
              <span class="font-mono text-xs text-brand-black/50 pt-1">0{i + 1}</span>
              <h3 class="font-display text-lg font-bold leading-tight">{output.title}</h3>
              <p class="col-start-2 sm:col-start-3 text-sm text-brand-black/60 leading-relaxed">{output.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Proceso -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CÓMO SE DESARROLLA EL ESTUDIO DE CAMPO ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-4xl">
          Del reconocimiento del lugar al cambio en el funcionamiento<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-x-7 gap-y-10">
          {process.map(step => (
            <div class="border-t border-brand-black/20 pt-5">
              <span class="block font-mono text-xs text-brand-black/60 mb-5">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Control de calidad -->
      <div class="reveal mb-24 border border-brand-black/15 p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.75fr_1.4fr] gap-10 lg:gap-16 mb-10">
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CONTROL DE CALIDAD EN EL CAMPO ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              Contexto real. Protocolo controlado<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <p class="text-brand-black/60 leading-relaxed text-justify max-w-2xl">
            El campo cambia a cada minuto. Por eso determinamos de antemano qué se puede comparar, registramos las condiciones de la medición y separamos los hallazgos reales de las situaciones que surgen por azar.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
          {controls.map(control => (
            <div class="border-t border-brand-black/20 pt-5">
              <h3 class="font-display text-lg font-bold leading-tight mb-3">{control.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{control.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ PREGUNTAS FRECUENTES ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
</content>
