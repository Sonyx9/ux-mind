---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const packages = [
  {
    num: '01',
    id: 'rychla-diagnostika',
    title: 'Diagnóstico rápido',
    tagline: 'Sospecha que algo no funciona — necesita acotar el problema con rapidez.',
    chips: ['Análisis heurístico', 'Eye-tracking', 'Cuestionario'],
    findings: 'Dónde la gente pierde la orientación, qué pasa por alto y qué merece una prueba más profunda.',
    forWho: 'Para equipos que sospechan que su web, aplicación, formulario o campaña no funciona de forma óptima, pero primero necesitan acotar el problema con rapidez. Es útil antes de un rediseño mayor, al preparar el briefing para una agencia o como primera verificación de las pantallas clave.',
    inside: 'Análisis heurístico experto, eye-tracking en pantallas seleccionadas y una breve encuesta mediante cuestionario.',
    limits: 'El diagnóstico rápido sirve para identificar problemas probables. Por sí solo no demuestra el impacto en la conversión y puede no explicar todas las causas del comportamiento.',
    output: 'Informe breve con los hallazgos principales, ejemplos de visualizaciones y una lista priorizada de recomendaciones.',
  },
  {
    num: '02',
    id: 'standardni-ux-test',
    title: 'Prueba UX estándar',
    tagline: 'Verifica un recorrido de usuario o compara dos variantes.',
    chips: ['Eye-tracking', 'Datos conductuales', 'Cuestionarios', 'Escenario'],
    findings: 'Qué variante funciona mejor, dónde surgen los errores y si la atención se traduce en la finalización de la tarea.',
    forWho: 'Para situaciones en las que necesita verificar un recorrido de usuario concreto, comparar dos variantes de interfaz o demostrar que el rediseño realmente ayuda. Es adecuada para webs, aplicaciones, e-commerce, formularios, campañas y prototipos.',
    inside: 'Eye-tracking, datos conductuales, cuestionarios estandarizados o propios y un escenario de prueba guiado. Con variantes trabajamos con diseño experimental para que la comparación sea lo más limpia posible.',
    limits: 'La prueba UX estándar describe bien la atención, la orientación y el rendimiento en la tarea. Sin embargo, no captura la respuesta fisiológica ni ofrece una imagen más profunda del nivel de arousal o del esfuerzo mental.',
    output: 'Protocolo de investigación, métricas AOI, heatmaps, gaze plots, resultados de las tareas, evaluación de los cuestionarios y recomendaciones para la siguiente decisión de diseño.',
  },
  {
    num: '03',
    id: 'komplexni-biometricky-vyzkum',
    title: 'Investigación biométrica integral',
    tagline: 'Una decisión costosa o difícil de revertir que debe sostenerse ante la dirección.',
    chips: ['Todo lo del 02', 'GSR', 'Señales faciales', 'EMLI', 'Taller'],
    findings: 'No solo qué vio e hizo la gente, sino también dónde aumenta el arousal y qué pasos resultan más exigentes.',
    forWho: 'Para decisiones costosas, difíciles de revertir o que deben sostenerse ante la dirección, un inversor o un cliente. Es adecuada para rediseños importantes, campañas clave, innovaciones de producto, HMI, situaciones de retail o investigaciones donde el comportamiento por sí solo no basta.',
    inside: 'Todo lo de la Prueba UX estándar, complementado según el encargo con GSR, análisis de señales faciales, elicitación cualitativa, entrevista retrospectiva sobre la grabación de la mirada y, opcionalmente, medición de la carga mental mediante el modelo EMLI.',
    limits: 'No interpretamos los datos biométricos de forma aislada. El GSR no dice si la reacción es positiva o negativa, y las señales faciales no constituyen una «lectura de emociones» por sí solas. Solo cobran sentido junto con la tarea, el escenario, el eye-tracking y el testimonio del participante.',
    output: 'Informe de investigación ampliado, línea temporal multimodal de hallazgos, interpretación de los momentos críticos, límites del estudio, recomendaciones de rediseño y un taller sobre los resultados.',
    featured: true,
  },
  {
    num: '04',
    id: 'terenni-studie',
    title: 'Estudio de campo',
    tagline: 'La decisión no ocurre en la pantalla, sino en la tienda o en el espacio físico.',
    chips: ['Gafas ET NEON', 'Grabación de vídeo', 'GSR', 'Entrevistas'],
    findings: 'Cómo la gente recorre el entorno real, qué le llama la atención, qué pasa de largo y dónde se detiene.',
    forWho: 'Para situaciones en las que la decisión no ocurre solo en la pantalla. Típicamente en una tienda, un showroom, junto a un producto físico, en un evento, en un entorno de trabajo o en un contexto automotive/HMI.',
    inside: 'Gafas móviles de eye-tracking Pupil Labs NEON, grabación en vídeo de la situación y, según las necesidades, GSR, cuestionarios, entrevistas y análisis del comportamiento en el entorno real.',
    limits: 'La investigación de campo ofrece mayor naturalidad de la situación, pero menor control de las condiciones que el laboratorio. Por eso siempre determinamos de antemano qué conclusiones pueden extraerse con seguridad de la medición de campo y cuáles conviene verificar en condiciones más controladas.',
    output: 'Videoanálisis, mapeo de los momentos clave, visualización de la atención en el entorno, resumen de barreras y recomendaciones para ajustar el espacio, la comunicación o el recorrido del cliente.',
  },
];

const chooseTable = [
  { need: 'No sabe dónde está el problema', pkg: 'Diagnóstico rápido', href: '#rychla-diagnostika' },
  { need: 'Compara dos variantes de una web, aplicación o campaña', pkg: 'Prueba UX estándar', href: '#standardni-ux-test' },
  { need: 'Necesita respaldar una decisión importante con datos', pkg: 'Investigación biométrica integral', href: '#komplexni-biometricky-vyzkum' },
  { need: 'Prueba el comportamiento en una tienda, showroom o evento', pkg: 'Estudio de campo', href: '#terenni-studie' },
  { need: 'Tiene un encargo específico o una combinación de entornos', pkg: 'Paquete a medida', href: '#na-miru' },
];

const methods = [
  { m: 'Eye-tracking en pantalla', tool: 'Tobii Pro X2-60, Smart Eye Aurora', brings: 'Determina qué ve realmente la gente, qué pasa por alto, en qué orden y durante cuánto tiempo' },
  { m: 'Eye-tracking móvil', tool: 'Pupil Labs NEON', brings: 'Captura la atención en el entorno real y la vincula con la grabación en vídeo de la situación' },
  { m: 'GSR', tool: 'Shimmer3 GSR', brings: 'Muestra los momentos de aumento del arousal fisiológico durante la tarea' },
  { m: 'Análisis de señales faciales', tool: 'iMotions / Facial Expression Analysis', brings: 'Ayuda a seguir los cambios de la respuesta facial en el tiempo frente a un estímulo concreto' },
  { m: 'Encuestas mediante cuestionario', tool: 'VisAWI, NASA-TLX, SUS, UEQ o ítems propios', brings: 'Complementan la medición objetiva con la valoración consciente de la comprensibilidad, la estética, la credibilidad o la carga' },
  { m: 'Elicitación cualitativa', tool: 'Think-aloud, think-aloud retrospectivo, entrevista', brings: 'Explica por qué el usuario decidió o se detuvo en un momento determinado' },
  { m: 'Datos conductuales', tool: 'Éxito de la tarea, tiempo, tasa de errores, clics', brings: 'Verifican si la atención se tradujo en un resultado real' },
  { m: 'Análisis heurístico experto', tool: 'Evaluación de la interfaz por un especialista', brings: 'Revela rápidamente problemas de usabilidad conocidos antes de una medición más profunda' },
  { m: 'Diseño experimental', tool: 'Escenarios, pilotaje, aleatorización, comparabilidad de variantes', brings: 'Garantiza que los resultados no sean solo la impresión de una única situación' },
];

const outputs = [
  'Protocolo de investigación con el encargo y los límites',
  'Métricas de atención visual',
  'Éxito de la tarea, tiempo, tasa de errores',
  'Heatmaps, gaze plots, comparación de AOI',
  'Cuestionarios vs. datos objetivos',
  'Hallazgos cualitativos',
  'Interpretación del impacto en la UX y el producto',
  'Recomendaciones según impacto y esfuerzo',
  'Límites del estudio claramente descritos',
  'Taller final con el equipo',
];

const process = [
  { num: '01', title: 'Encargo', desc: 'Aclaramos qué decisión necesita tomar.' },
  { num: '02', title: 'Propuesta del paquete', desc: 'Métodos, muestra, escenario y qué podrá concluirse con seguridad.' },
  { num: '03', title: 'Preparación y pilotaje', desc: 'Escenario, estímulos, cuestionarios y, en proyectos más complejos, un piloto.' },
  { num: '04', title: 'Medición', desc: 'Laboratorio o campo, calibración y control de calidad de los datos.' },
  { num: '05', title: 'Análisis y entrega', desc: 'Recomendaciones, no gráficos aislados.' },
];

const audiences = [
  { title: 'Producto y UX', desc: 'Recorridos, formularios, navegación, prototipos.' },
  { title: 'Marketing', desc: 'Campañas, banners, vídeo, landing pages.' },
  { title: 'E-commerce', desc: 'Listado, ficha de producto, filtros, carrito, checkout.' },
  { title: 'Retail y servicios', desc: 'Orientación en el espacio, POS, product placement.' },
  { title: 'Dirección', desc: 'Datos para decisiones costosas, comprensibles también fuera del equipo UX.' },
];

const faq = [
  { q: '¿Tenemos que elegir un paquete completo?', a: 'No. Los paquetes son configuraciones de partida, no productos cerrados. Según el encargo podemos añadir, simplificar o combinar los métodos.' },
  { q: '¿En qué se diferencia de un heatmap de la analítica web?', a: 'El heatmap analítico suele trabajar con clics, movimiento del cursor o scroll. El eye-tracking mide la mirada real. Gracias a ello captura también los elementos que el usuario miró pero en los que no hizo clic.' },
  { q: '¿Miden emociones?', a: 'No usamos el atajo «medimos emociones» en el sentido de una lectura fiable del estado interno de una persona. Trabajamos con indicadores de arousal fisiológico, señales faciales y valoraciones subjetivas. Siempre los interpretamos en el contexto de la tarea concreta.' },
  { q: '¿Cuántos participantes necesitamos?', a: 'Depende del objetivo del estudio. Para un diagnóstico rápido basta una muestra más pequeña y una interpretación más cualitativa. Para comparar variantes y hacer una evaluación estadística se necesita una muestra mayor y diseñada con más precisión. El tamaño recomendado lo proponemos según la pregunta de investigación.' },
  { q: '¿Cuánto cuestan las pruebas?', a: 'El precio se determina según el alcance del paquete, el número de participantes, la complejidad de la preparación, el tipo de medición y la forma de la entrega. Envíenos su encargo y prepararemos una oferta sin compromiso.' },
  { q: '¿Las pruebas tienen que realizarse en el laboratorio?', a: 'No. El laboratorio es adecuado para estudios controlados de webs, aplicaciones, campañas o prototipos. Para entornos reales usamos gafas móviles de eye-tracking y metodología de campo.' },
  { q: '¿Cómo tratan los datos de los participantes?', a: 'Antes de la medición trabajamos con el consentimiento informado y un propósito de investigación claramente definido. Las entregas para los clientes se preparan de forma estándar en formato agregado o seudonimizado. El régimen concreto de tratamiento de datos lo configuramos según el tipo de proyecto, la sensibilidad de los datos y los requisitos del cliente.' },
  { q: '¿Recibiremos solo un informe?', a: 'No. En la mayoría de los proyectos recomendamos un taller final. Gracias a él, los resultados pueden convertirse en prioridades, en un backlog de ajustes o en nuevas pruebas.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Paquetes de prueba UXMIND',
    description: 'Paquetes de prueba de investigación UX: diagnóstico rápido, prueba UX estándar, investigación biométrica integral y estudio de campo. Eye-tracking, GSR, cuestionarios y análisis experto según la decisión que necesita tomar.',
    serviceType: 'Pruebas UX',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="es"
  title="Paquetes de prueba UXMIND | Eye-tracking, biometría e investigación UX"
  description="Elija el alcance de las pruebas UX según la decisión que necesita tomar. Diagnóstico rápido, prueba UX estándar, investigación biométrica integral y estudio de campo."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-12">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ PAQUETES DE PRUEBA ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          ¿A QUÉ PROFUNDIDAD<br/>MEDIR<span style="color:#2D62FC">?</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Del diagnóstico rápido a la investigación UX biométrica integral.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              Un heatmap muestra dónde miró la gente — no por qué se perdió. Componemos los paquetes según
              <strong class="text-brand-black">la decisión que necesita tomar</strong>, no según lo que tenemos en el laboratorio.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="/es/contacto" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              SOLICITAR OFERTA →
            </a>
            <a href="#vyber" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              ¿CUÁL ME CONVIENE?
            </a>
          </div>
        </div>
      </div>

      <!-- Escala de alcance: elección rápida -->
      <div class="mb-16">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
          {packages.map(pkg => (
            <a href={`#${pkg.id}`} class="group bg-brand-white p-5 hover:bg-brand-black hover:text-brand-white transition-colors">
              <div class="flex justify-between items-start mb-4">
                <span class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/60">{pkg.num}</span>
                <span class="font-mono text-xs opacity-0 group-hover:opacity-100 transition-opacity">↓</span>
              </div>
              <p class="font-display font-bold leading-tight">{pkg.title}</p>
            </a>
          ))}
        </div>
        <!-- Eje de alcance -->
        <div class="flex items-center gap-3 mt-3 font-mono text-[10px] text-brand-black/60 tracking-widest uppercase">
          <span>Menor alcance</span>
          <span class="flex-1 h-px bg-gradient-to-r from-brand-black/20 to-brand-black"></span>
          <span>Evidencia más profunda</span>
        </div>
      </div>

      <!-- Franja de credibilidad -->
      <div class="reveal mb-24 border-y border-brand-black/10 py-4 overflow-hidden">
        <p class="font-mono text-[11px] text-brand-black/60 tracking-wider whitespace-nowrap md:whitespace-normal overflow-x-auto">
          Infraestructura de investigación de la FIM UHK · Tobii Pro X2-60 · Smart Eye Aurora · Pupil Labs NEON · iMotions CORE · BeSigma · Shimmer3 GSR · mediciones en laboratorio y en campo
        </p>
      </div>

      <!-- Por qué el eye-tracking por sí solo no basta — tres capas -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ POR QUÉ EL EYE-TRACKING POR SÍ SOLO NO BASTA ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Atención ≠ comprensión ≠ conversión<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {[
            { t: 'Qué vio', d: 'El eye-tracking muestra qué ve realmente el usuario y qué pasa de largo.', tag: 'MIRADA' },
            { t: 'Qué hizo', d: '¿Completó la tarea? ¿Cuánto tardó y dónde se equivocó?', tag: 'COMPORTAMIENTO' },
            { t: 'Por qué', d: 'Cómo valoró la interfaz y qué supo explicar a posteriori.', tag: 'TESTIMONIO' },
          ].map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-sm text-brand-black/60 leading-relaxed mt-4 max-w-2xl">
          Solo la unión de las tres capas distingue un problema que simplemente atrae la mirada de uno que impide completar la tarea.
        </p>
      </div>

      <!-- Paquetes -->
      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ NUESTROS PAQUETES DE PRUEBA ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-4">Cuatro configuraciones<span style="color:#2D62FC">.</span></h2>
        <p class="text-brand-black/60 leading-relaxed max-w-2xl mb-12">
          No son productos fijos — los ajustamos según el encargo. En cada uno sabe de antemano qué obtendrá y qué <strong class="text-brand-black">no podrá afirmarse con fiabilidad</strong> con ese alcance.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          {packages.map(pkg => (
            <div id={pkg.id} class={`reveal p-8 md:p-10 flex flex-col scroll-mt-28 ${pkg.featured ? 'bg-brand-black text-brand-white' : 'bg-brand-white'}`}>
              <div class="flex justify-between items-start mb-6">
                <span class={`font-mono text-xs ${pkg.featured ? 'text-brand-white/60' : 'text-brand-black/60'}`}>{pkg.num}</span>
                {pkg.featured && (
                  <span class="font-mono text-[10px] tracking-widest px-2 py-1" style="background:#2D62FC; color:#FCFCFC;">LA EVIDENCIA MÁS PROFUNDA</span>
                )}
              </div>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-3 leading-tight">{pkg.title}</h3>
              <p class={`leading-relaxed mb-6 ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>{pkg.tagline}</p>

              <div class="flex flex-wrap gap-2 mb-6">
                {pkg.chips.map(chip => (
                  <span class={`font-mono text-[11px] px-2 py-1 tracking-wide border ${pkg.featured ? 'border-brand-white/30 text-brand-white/80' : 'border-brand-black/20 text-brand-black/70'}`}>{chip}</span>
                ))}
              </div>

              <p class={`text-sm leading-relaxed mb-6 ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>
                <span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Descubrirá</span>
                {pkg.findings}
              </p>

              <details class={`group mt-auto border-t pt-4 ${pkg.featured ? 'border-brand-white/20' : 'border-brand-black/10'}`}>
                <summary class="flex justify-between items-center cursor-pointer font-mono text-xs tracking-widest uppercase list-none [&::-webkit-details-marker]:hidden">
                  DETALLE DEL PAQUETE
                  <span class="font-mono text-lg transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <div class={`mt-4 space-y-4 text-sm leading-relaxed ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Para quién</span>{pkg.forWho}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Qué incluye</span>{pkg.inside}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Límites del paquete</span>{pkg.limits}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Entrega típica</span>{pkg.output}</p>
                </div>
              </details>
            </div>
          ))}
        </div>

        <!-- Paquete a medida -->
        <div id="na-miru" class="reveal relative overflow-hidden bg-brand-black text-brand-white p-8 md:p-12 mt-px scroll-mt-28">
          <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
          <div class="relative flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div>
              <p class="font-mono text-xs text-brand-white/60 mb-2">05</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-3">Paquete a medida<span style="color:#2D62FC">.</span></h3>
              <p class="text-brand-white/70 leading-relaxed max-w-xl">
                Primero conocemos tu negocio, tus objetivos y tu contexto — luego diseñamos las pruebas y la optimización posterior a tu medida. Desde la pregunta de investigación y la combinación adecuada de métodos hasta cambios concretos que se ven en los resultados. Componemos según la decisión que los datos van a informar, no según el equipamiento del laboratorio.
              </p>
            </div>
            <a href="/es/contacto" class="shrink-0 inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              NO SÉ CUÁL ELEGIR →
            </a>
          </div>
        </div>
      </div>

      <!-- Cómo elegir -->
      <div id="vyber" class="reveal mb-24 scroll-mt-28">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CÓMO ELEGIR EL PAQUETE ADECUADO ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10">¿Qué necesita decidir<span style="color:#2D62FC">?</span></h2>
        <div class="border border-brand-black/10">
          {chooseTable.map(row => (
            <a href={row.href} class="group grid grid-cols-1 md:grid-cols-2 gap-2 md:gap-6 p-5 border-b border-brand-black/10 last:border-0 hover:bg-brand-black hover:text-brand-white transition-colors">
              <p class="text-brand-black/60 group-hover:text-brand-white/70 leading-relaxed transition-colors">{row.need}</p>
              <p class="font-display font-bold flex items-center justify-between gap-4">
                {row.pkg}
                <span class="font-mono text-xs opacity-0 group-hover:opacity-100 transition-opacity">→</span>
              </p>
            </a>
          ))}
        </div>
      </div>

      <!-- Qué incluyen los paquetes (desplegable) -->
      <div class="reveal mb-24">
