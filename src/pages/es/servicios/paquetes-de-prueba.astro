---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const packages = [
  {
    num: '01',
    id: 'rychla-diagnostika',
    title: 'Auditoría UX rápida',
    tagline: 'Un control experto y rápido que detecta los principales problemas de una web o aplicación.',
    chips: ['Auditoría UX experta', 'Pantallas clave', 'Prioridades de mejora'],
    findings: 'Dónde puede confundir la interfaz al usuario, qué complica completar una tarea y qué deficiencias tiene sentido resolver primero.',
    forWho: 'Para equipos que necesitan revisar rápidamente una web, un e-commerce, una aplicación o un formulario. Es útil antes de un rediseño, ante una caída de las conversiones o como base para futuros ajustes.',
    inside: 'Revisión experta de las páginas clave y los recorridos de usuario. Evaluamos su claridad, la navegación, el contenido, la jerarquía visual y las barreras para completar una tarea.',
    limits: 'La auditoría no mide a usuarios reales. Detecta problemas probables y establece prioridades que después pueden verificarse con pruebas de usuario.',
    output: 'Resumen de los principales problemas, ejemplos concretos y mejoras recomendadas ordenadas por importancia.',
  },
  {
    num: '02',
    id: 'standardni-ux-test',
    title: 'Pruebas de usuario',
    tagline: 'Observamos cómo los usuarios reales recorren la interfaz y dónde se detienen al completar tareas.',
    chips: ['Pruebas con usuarios', 'Escenarios de tareas', 'Entrevistas', 'Cuestionarios'],
    findings: 'Si los usuarios logran completar tareas importantes, dónde se equivocan, qué no entienden y qué variante resulta más fácil de usar.',
    forWho: 'Para equipos que necesitan verificar un recorrido de usuario concreto, un nuevo diseño o un prototipo con usuarios reales. Es adecuado para webs, aplicaciones, e-commerce y formularios.',
    inside: 'Pruebas guiadas con usuarios según tareas preparadas. Observamos la tasa de éxito, el tiempo, los errores y la forma de usar la interfaz. Completamos el comportamiento con una entrevista y, si es necesario, un cuestionario.',
    limits: 'La prueba muestra qué hicieron los usuarios y cómo explican su comportamiento. No mide el movimiento ocular exacto ni la respuesta fisiológica — para esas preguntas existe la medición premium en laboratorio.',
    output: 'Resultados de cada tarea, principales barreras, ejemplos del comportamiento de los usuarios y recomendaciones ordenadas por impacto.',
  },
  {
    num: '03',
    id: 'komplexni-biometricky-vyzkum',
    title: 'Eye tracking y biometría',
    tagline: 'Medición premium en laboratorio para decisiones importantes que necesita respaldar con varias fuentes de datos.',
    chips: ['Todo lo del 02', 'GSR', 'Señales faciales', 'EMLI', 'Taller'],
    findings: 'Qué vieron realmente los usuarios, cómo procedieron y en qué momentos aumentó su activación fisiológica o su carga mental.',
    forWho: 'Para decisiones costosas, difíciles de revertir o que deben sostenerse ante la dirección, un inversor o un cliente. Es adecuado para rediseños importantes, campañas clave, innovaciones de producto, HMI, situaciones de retail o investigaciones en las que el comportamiento por sí solo no basta.',
    inside: 'Completamos las pruebas de usuario con eye tracking y, según el encargo, también con GSR, análisis de señales faciales, una entrevista retrospectiva sobre la grabación de la mirada o la medición de la carga mental mediante el modelo EMLI.',
    limits: 'No interpretamos los datos biométricos de forma aislada. El GSR no indica si la reacción es positiva o negativa, y las señales faciales no constituyen por sí solas una «lectura de emociones». Cobran sentido solo junto con la tarea, el escenario, el eye tracking y el testimonio del participante.',
    output: 'Informe de investigación ampliado, conexión de las distintas fuentes de datos, explicación de los momentos críticos, recomendaciones de mejora y un taller sobre los resultados.',
    featured: true,
  },
  {
    num: '04',
    id: 'terenni-studie',
    title: 'Estudio de campo',
    tagline: 'Observamos el comportamiento donde realmente ocurre — en la tienda, el punto de venta u otro espacio físico.',
    chips: ['Observación de campo', 'Grabación de vídeo', 'Entrevistas', 'Eye tracking móvil'],
    findings: 'Cómo recorren las personas el entorno real, qué notan, qué pasan por alto y dónde se detienen.',
    forWho: 'Para situaciones en las que la decisión no ocurre solo en la pantalla. Típicamente en una tienda, un showroom, junto a un producto físico, en un evento, en un entorno laboral o en un contexto automotive/HMI.',
    inside: 'Observación y grabación en vídeo de la situación, entrevistas y análisis del comportamiento en un entorno real. Según la pregunta de investigación, también podemos incorporar las gafas móviles de eye tracking Pupil Labs NEON o GSR.',
    limits: 'La investigación de campo ofrece mayor naturalidad, pero menos control de las condiciones que el laboratorio. Por eso siempre determinamos de antemano qué conclusiones pueden extraerse con seguridad de la medición de campo y cuáles conviene verificar en condiciones más controladas.',
    output: 'Videoanálisis, mapeo de los momentos clave, visualización de la atención en el entorno, resumen de barreras y recomendaciones para ajustar el espacio, la comunicación o el recorrido del cliente.',
  },
];

const outputs = [
  {
    title: 'Hallazgos principales',
    desc: 'Resumen de problemas, resultados de las tareas y visualizaciones según el paquete elegido.',
  },
  {
    title: 'Explicación del contexto',
    desc: 'Mostramos qué ocurrió, por qué es importante y qué puede concluirse con seguridad a partir de los resultados.',
  },
  {
    title: 'Prioridades y próximos pasos',
    desc: 'Mejoras recomendadas ordenadas por impacto y dificultad. En estudios más amplios, también un taller conjunto sobre los resultados.',
  },
];

const process = [
  { num: '01', title: 'Objetivo', desc: 'Aclaramos qué necesita averiguar y qué decisión debe respaldar la investigación.' },
  { num: '02', title: 'Propuesta', desc: 'Recomendamos el paquete adecuado, los métodos, el alcance y los participantes.' },
  { num: '03', title: 'Preparación', desc: 'Preparamos el guion, los materiales y, si es necesario, una prueba piloto.' },
  { num: '04', title: 'Realización', desc: 'Llevamos a cabo la auditoría, las pruebas de usuario o la medición en laboratorio o en campo.' },
  { num: '05', title: 'Resultados', desc: 'Evaluamos los datos y los convertimos en recomendaciones concretas.' },
];

const audiences = [
  'Producto y UX',
  'Marketing',
  'E-commerce',
  'Retail y servicios',
  'Dirección',
];

const faq = [
  {
    q: '¿Cuál es la diferencia entre una auditoría UX y las pruebas de usuario?',
    a: 'La auditoría UX la realiza un especialista sin la participación de usuarios y detecta rápidamente problemas probables de la interfaz. En las pruebas de usuario observamos a usuarios reales completando tareas concretas. Así comprobamos dónde se detienen, se equivocan o no entienden algo realmente.',
  },
  {
    q: '¿Cuál es la diferencia entre las pruebas de usuario y el eye tracking?',
    a: 'Las pruebas de usuario muestran si las personas logran completar tareas importantes y cómo interactúan con la interfaz. El eye tracking, además, mide con precisión su mirada — qué vieron, qué pasaron por alto y en qué orden siguieron los elementos. Por eso lo usamos como método premium para preguntas que la simple observación no resuelve.',
  },
  {
    q: '¿En qué se diferencia el eye tracking de un heatmap de la analítica web?',
    a: 'El heatmap de la analítica web suele basarse en clics, movimiento del cursor o desplazamiento de la página. El eye tracking mide la mirada real del usuario. Por eso también capta elementos que la persona notó pero en los que no hizo clic, o lugares que pasó totalmente por alto.',
  },
  {
    q: '¿Cuántos participantes se necesitan para las pruebas de usuario?',
    a: 'El número depende del objetivo de la investigación, de la diversidad del público objetivo y de la forma de evaluación. Para detectar problemas solemos trabajar con una muestra más pequeña. Para comparar variantes de forma fiable o extraer conclusiones estadísticas se necesita una muestra mayor. Recomendamos el número concreto según la pregunta de investigación.',
  },
  {
    q: '¿Cuánto cuesta una auditoría UX o unas pruebas de usuario?',
    a: 'El precio depende del alcance, del número de recorridos o variantes probados, del número de participantes, de los métodos utilizados y del formato de entrega. Tras un breve encargo, le recomendamos el alcance adecuado y preparamos una propuesta sin compromiso.',
  },
  {
    q: '¿Las pruebas tienen que realizarse en el laboratorio?',
    a: 'No necesariamente. Podemos probar una web, una aplicación o un prototipo tanto en laboratorio como de forma remota, según el objetivo del proyecto. El comportamiento en una tienda, un punto de venta u otro espacio físico lo observamos directamente en el campo.',
  },
  {
    q: '¿Cómo protegen los datos de los participantes?',
    a: 'Antes de las pruebas definimos el propósito del tratamiento y obtenemos el consentimiento informado de cada participante. Protegemos los datos y, por norma, preparamos las entregas en formato agregado o seudonimizado. El régimen concreto se ajusta según la sensibilidad del proyecto, los requisitos del cliente y el RGPD.',
  },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Paquetes de prueba de UX MIND',
    description: 'Paquetes de prueba de investigación UX: auditoría UX rápida, pruebas de usuario, eye tracking premium con biometría y estudio de campo.',
    serviceType: 'Pruebas UX',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="es"
  title="Paquetes de prueba UX MIND | Eye tracking, biometría e investigación UX"
  description="Elija el alcance de las pruebas UX según lo que necesite averiguar. Auditoría UX rápida, pruebas de usuario, eye tracking con biometría y estudio de campo."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-12">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ PAQUETES DE PRUEBA ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          ELIJA EL ALCANCE<br/>DE LAS PRUEBAS<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Según lo que necesite averiguar.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl text-justify">
              A veces basta con detectar rápidamente los principales obstáculos. Otras veces necesita comparar variantes o respaldar una decisión importante con varias fuentes de datos. Le recomendaremos el alcance que se ajuste a su objetivo, su entorno y el nivel de certeza que necesita.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="#balicky" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              VER PAQUETES ↓
            </a>
            <a href="/es/contacto" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              PEDIR CONSEJO PARA ELEGIR →
            </a>
          </div>
        </div>
      </div>

      <!-- Escala de alcance: elección rápida -->
      <div class="mb-16">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
          {packages.map(pkg => (
            <a href={`#${pkg.id}`} class="group bg-brand-white p-5 hover:bg-brand-black hover:text-brand-white transition-colors">
              <div class="flex justify-between items-start mb-4">
                <span class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/60">{pkg.num}</span>
                <span class="font-mono text-xs opacity-0 group-hover:opacity-100 transition-opacity">↓</span>
              </div>
              <p class="font-display font-bold leading-tight">{pkg.title}</p>
            </a>
          ))}
        </div>
        <!-- Eje de alcance -->
        <div class="flex items-center gap-3 mt-3 font-mono text-[10px] text-brand-black/60 tracking-widest uppercase">
          <span>Menor alcance</span>
          <span class="flex-1 h-px bg-gradient-to-r from-brand-black/20 to-brand-black"></span>
          <span>Investigación más detallada</span>
        </div>
      </div>

      <!-- Franja de credibilidad -->
      <div class="reveal mb-24 border-y border-brand-black/10 py-4 overflow-hidden">
        <p class="font-mono text-[11px] text-brand-black/60 tracking-wider whitespace-nowrap md:whitespace-normal overflow-x-auto">
          Infraestructura de investigación FIM UHK · Tobii Pro X2-60 · Smart Eye Aurora · Pupil Labs NEON · iMotions CORE · BeSigma · Shimmer3 GSR · mediciones en laboratorio y en campo
        </p>
      </div>

      <!-- Por qué el eye-tracking por sí solo no basta — tres capas -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ POR QUÉ EL EYE-TRACKING POR SÍ SOLO NO BASTA ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Atención ≠ comprensión ≠ conversión<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {[
            { t: 'Qué vio', d: 'El eye-tracking muestra qué ve realmente el usuario y qué pasa de largo.', tag: 'MIRADA' },
            { t: 'Qué hizo', d: '¿Completó la tarea? ¿Cuánto tardó y dónde se equivocó?', tag: 'COMPORTAMIENTO' },
            { t: 'Por qué', d: 'Cómo valoró la interfaz y qué supo explicar a posteriori.', tag: 'TESTIMONIO' },
          ].map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-sm text-brand-black/60 leading-relaxed mt-4 max-w-2xl">
          Solo la unión de las tres capas distingue un problema que simplemente atrae la mirada de uno que impide completar la tarea.
        </p>
      </div>

      <!-- Paquetes -->
      <div id="balicky" class="mb-24 scroll-mt-28">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ NUESTROS PAQUETES DE PRUEBA ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-4">Cuatro configuraciones<span style="color:#2D62FC">.</span></h2>
        <p class="text-brand-black/60 leading-relaxed max-w-2xl mb-12">
          No son productos fijos — los ajustamos según el encargo. En cada uno sabe de antemano qué obtendrá y qué <strong class="text-brand-black">no podrá afirmarse con fiabilidad</strong> con ese alcance.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          {packages.map(pkg => (
            <div id={pkg.id} class={`reveal p-8 md:p-10 flex flex-col scroll-mt-28 ${pkg.featured ? 'bg-brand-black text-brand-white' : 'bg-brand-white'}`}>
              <div class="flex justify-between items-start mb-6">
                <span class={`font-mono text-xs ${pkg.featured ? 'text-brand-white/60' : 'text-brand-black/60'}`}>{pkg.num}</span>
                {pkg.featured && (
                  <span class="font-mono text-[10px] tracking-widest px-2 py-1" style="background:#2D62FC; color:#FCFCFC;">MEDICIÓN PREMIUM</span>
                )}
              </div>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-3 leading-tight">{pkg.title}</h3>
              <p class={`leading-relaxed mb-6 ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>{pkg.tagline}</p>

              <div class="flex flex-wrap gap-2 mb-6">
                {pkg.chips.map(chip => (
                  <span class={`font-mono text-[11px] px-2 py-1 tracking-wide border ${pkg.featured ? 'border-brand-white/30 text-brand-white/80' : 'border-brand-black/20 text-brand-black/70'}`}>{chip}</span>
                ))}
              </div>

              <p class={`text-sm leading-relaxed mb-6 ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>
                <span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Descubrirá</span>
                {pkg.findings}
              </p>

              <details class={`group mt-auto border-t pt-4 ${pkg.featured ? 'border-brand-white/20' : 'border-brand-black/10'}`}>
                <summary class="flex justify-between items-center cursor-pointer font-mono text-xs tracking-widest uppercase list-none [&::-webkit-details-marker]:hidden">
                  DETALLE DEL PAQUETE
                  <span class="font-mono text-lg transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <div class={`mt-4 space-y-4 text-sm leading-relaxed ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Para quién</span>{pkg.forWho}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Qué incluye</span>{pkg.inside}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Qué es bueno saber</span>{pkg.limits}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Entrega típica</span>{pkg.output}</p>
                </div>
              </details>
            </div>
          ))}
        </div>

        <!-- Paquete a medida -->
        <div id="na-miru" class="reveal relative overflow-hidden bg-brand-black text-brand-white p-8 md:p-12 mt-px scroll-mt-28">
          <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
          <div class="relative flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div>
              <p class="font-mono text-xs text-brand-white/60 mb-2">05</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-3">Paquete a medida<span style="color:#2D62FC">.</span></h3>
              <p class="text-brand-white/70 leading-relaxed max-w-xl">
                Primero conocemos su negocio, sus objetivos y su contexto — luego le diseñamos las pruebas y la optimización posterior a medida. Desde la pregunta de investigación y la combinación adecuada de métodos hasta cambios concretos que se reflejan en los resultados. Componemos según la decisión que se tomará con los datos, no según el equipamiento del laboratorio.
              </p>
            </div>
            <a href="/es/contacto" class="shrink-0 inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              NO SÉ CUÁL ELEGIR →
            </a>
          </div>
        </div>
      </div>

      <!-- EMLI -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="grid grid-cols-1 md:grid-cols-[minmax(0,2fr)_minmax(240px,1fr)] md:items-center gap-10 md:gap-16">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ EMLI: ÍNDICE DE CARGA MENTAL ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">Dónde exige más esfuerzo la interfaz<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed text-justify mb-4">
              EMLI convierte indicadores seleccionados del eye tracking en una puntuación de 0 a 100. Así podemos comparar distintas pantallas, pasos o variantes y determinar dónde resulta más exigente para el usuario procesar la información.
            </p>
            <p class="text-sm text-brand-black/60 leading-relaxed text-justify">
              <strong class="text-brand-black">Cuanto más alta la puntuación, mayor la carga.</strong> El resultado siempre lo evaluamos junto con el comportamiento del usuario y otros datos, nunca como un veredicto aislado.
            </p>
          </div>
          <div aria-label="Escala EMLI de menor a mayor carga mental">
            <div class="emli-scale h-2 mb-4" aria-hidden="true">
              <div class="emli-fill"></div>
            </div>
            <div class="flex items-start justify-between gap-6 font-mono text-[10px] tracking-widest uppercase">
              <p><strong class="block font-display text-3xl leading-none mb-2 text-brand-blue">0</strong>Menor carga</p>
              <p class="text-right"><strong class="block font-display text-3xl leading-none mb-2 text-brand-blue">100</strong>Mayor carga</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Proceso y entregas -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CÓMO ES LA COLABORACIÓN ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10">Del objetivo a las mejoras concretas<span style="color:#2D62FC">.</span></h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-px bg-brand-black/10 border border-brand-black/10">
          {process.map(step => (
            <div class="bg-brand-white p-6 md:p-7 min-h-64 flex flex-col">
              <span class="font-mono text-xs text-brand-black/60 mb-10">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed text-justify mt-auto">{step.desc}</p>
            </div>
          ))}
        </div>

        <p class="font-mono text-xs text-brand-black/60 tracking-widest mt-16 mb-8">[ QUÉ RECIBIRÁ EN LA ENTREGA ]</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {outputs.map((output, i) => (
            <div class="bg-brand-white p-7 md:p-8 min-h-56 flex flex-col">
              <span class="font-mono text-xs text-brand-black/60 mb-8">0{i + 1}</span>
              <h3 class="font-display text-2xl font-bold leading-tight mb-3">{output.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed text-justify mt-auto">{output.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Para quién -->
      <div class="reveal mb-24 max-w-4xl">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ PARA QUIÉN SON ADECUADOS LOS PAQUETES ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6">Para equipos que quieren decidir según datos<span style="color:#2D62FC">.</span></h2>
        <p class="text-brand-black/60 leading-relaxed text-justify mb-8 max-w-3xl">
          Los paquetes de prueba los utilizan equipos de producto y UX, marketing, e-commerce, retail y la dirección de empresas. Adaptamos el alcance según si trabaja en la navegación, un formulario, una campaña, el proceso de compra, un espacio físico o los datos para una decisión importante.
        </p>
        <div class="flex flex-wrap gap-x-5 gap-y-3">
          {audiences.map(a => (
            <span class="font-mono text-[11px] text-brand-black/60 tracking-widest uppercase">{a}</span>
          ))}
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ PREGUNTAS FRECUENTES SOBRE LAS PRUEBAS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10">Qué es bueno saber antes de elegir<span style="color:#2D62FC">.</span></h2>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    // Scroll-reveal — el mismo patrón que en los casos de estudio
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>

  <style>
    /* Escala EMLI — la línea avanza una vez (0 → 100) y se estabiliza en 63; se activa al entrar en el viewport */
    .emli-scale {
      position: relative;
      overflow: hidden;
      background: rgba(45, 98, 252, 0.1);
    }
    .emli-fill {
      position: absolute;
      inset: 0;
      transform-origin: left center;
      background: linear-gradient(90deg, rgba(45, 98, 252, 0.16), #2d62fc);
      transform: scaleX(0.63);
    }
    .reveal.is-visible .emli-fill {
      animation: emliFill 2.8s ease-in-out both;
    }
    @keyframes emliFill {
      0% { transform: scaleX(0); }
      65% { transform: scaleX(1); }
      100% { transform: scaleX(0.63); }
    }
    @media (prefers-reduced-motion: reduce) {
      .reveal.is-visible .emli-fill { animation: none; }
      .emli-fill { transform: scaleX(0.63); }
    }
  </style>
</BaseLayout>
</content>
