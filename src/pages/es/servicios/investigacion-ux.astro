---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const researchQuestions = [
  { title: 'Para quién crea el producto', desc: 'Conocemos las necesidades, expectativas y diferencias entre los grupos que usan el producto o servicio.' },
  { title: 'Qué problema resuelven las personas', desc: 'Descubrimos los objetivos, motivaciones y obstáculos reales, no solo requisitos formulados sin contexto.' },
  { title: 'Cómo es todo el recorrido', desc: 'Conectamos los distintos puntos de contacto y mostramos dónde funciona la experiencia y dónde se rompe.' },
  { title: 'Qué cambiar primero', desc: 'Convertimos los hallazgos en prioridades según el impacto, la certeza y su relación con los objetivos de su producto.' },
];

const methods = [
  { title: 'Entender las necesidades', methods: 'ENTREVISTAS · INVESTIGACIÓN CONTEXTUAL', desc: 'Cuando necesita comprender las motivaciones, los procesos de trabajo, la toma de decisiones y las circunstancias en las que surge el problema.' },
  { title: 'Verificar el comportamiento real', methods: 'PRUEBAS DE USUARIO · OBSERVACIÓN', desc: 'Cuando quiere saber si las personas logran completar tareas importantes y qué se lo impide en una situación concreta.' },
  { title: 'Medir el alcance del problema', methods: 'CUESTIONARIOS · ANALÍTICA · DATOS OPERATIVOS', desc: 'Cuando necesita comprobar con qué frecuencia aparece un patrón determinado y a qué grupos afecta.' },
  { title: 'Comparar posibles direcciones', methods: 'CONCEPTOS · PROTOTIPOS · VARIANTES', desc: 'Cuando elige entre soluciones y necesita respaldar la decisión con comportamiento y con feedback.' },
];

const deliverables = [
  { title: 'Respuesta a la pregunta de investigación', desc: 'Resumimos con claridad qué permiten afirmar los datos, qué sigue siendo incierto y qué hay que verificar más adelante.' },
  { title: 'Evidencias y contexto', desc: 'Respaldamos los hallazgos con situaciones concretas, declaraciones, patrones de comportamiento y los datos disponibles.' },
  { title: 'Prioridades y oportunidades', desc: 'Separamos los problemas fundamentales de los casos aislados y mostramos dónde tiene más sentido el cambio.' },
  { title: 'Material de base para seguir trabajando', desc: 'Según el objetivo, preparamos recomendaciones, un journey map, una segmentación, un encargo de diseño o un plan de verificación posterior.' },
];

const situations = [
  { title: 'Nuevo producto o servicio', desc: 'Necesita verificar a quién debe servir la solución y qué problema debe resolver realmente.' },
  { title: 'Rediseño o cambio de dirección', desc: 'No quiere solo redibujar el estado actual, sino decidir qué mantener y qué cambiar.' },
  { title: 'Bajo rendimiento sin causa clara', desc: 'Los datos muestran un problema, pero no explican las motivaciones, expectativas ni el contexto del comportamiento.' },
  { title: 'Nuevo público objetivo o mercado', desc: 'Necesita entender necesidades diferentes antes de trasladar una solución existente a otro lugar.' },
  { title: 'Recorrido a través de canales', desc: 'La experiencia se construye entre la web, el soporte, la sucursal, la tienda o el producto físico.' },
  { title: 'Decisión de alto impacto', desc: 'Necesita respaldar la dirección del desarrollo, una inversión o un cambio de proceso antes de una implantación más amplia.' },
];

const process = [
  { num: '01', title: 'Decisión y contexto', desc: 'Aclaramos qué necesita decidir, qué sabe ya y dónde están las mayores lagunas.' },
  { num: '02', title: 'Diseño de la investigación', desc: 'Elegimos los métodos adecuados, los públicos objetivo, la muestra y la forma de evaluación.' },
  { num: '03', title: 'Preparación y reclutamiento', desc: 'Preparamos el guion, lo verificamos con un piloto y conseguimos los participantes adecuados.' },
  { num: '04', title: 'Recogida y síntesis de datos', desc: 'Vinculamos entrevistas, comportamiento y datos disponibles, y buscamos patrones recurrentes.' },
  { num: '05', title: 'Recomendaciones y entrega', desc: 'Convertimos los resultados en prioridades y determinamos juntos los siguientes pasos de producto.' },
];

const faq = [
  { q: '¿Qué es la investigación UX?', a: 'La investigación UX averigua de forma sistemática quiénes son los usuarios, qué necesitan, cómo se comportan y por qué. Ayuda a decidir qué problema resolver, qué diseñar y qué cambios tienen más sentido.' },
  { q: '¿En qué se diferencia la investigación UX de las pruebas de usuario?', a: 'Las pruebas de usuario verifican una interfaz o un prototipo concretos. La investigación UX puede abordar preguntas más amplias sobre necesidades, públicos objetivo, todo el recorrido del cliente o la dirección del producto, y combina varios métodos según el objetivo.' },
  { q: '¿En qué se diferencia la investigación UX del estudio de mercado?', a: 'El estudio de mercado suele centrarse en el tamaño del mercado, las preferencias o la marca. La investigación UX profundiza más en el contexto de uso del producto o servicio y busca argumentos para un diseño concreto y para decisiones de producto. Ambos enfoques pueden complementarse bien.' },
  { q: '¿Cuántos participantes necesitamos?', a: 'El número depende de la pregunta de investigación, del número de públicos objetivo y de los métodos elegidos. Las entrevistas cualitativas trabajan con una muestra distinta a la de un cuestionario o una comparación de variantes, por eso determinamos el alcance al diseñar el estudio.' },
  { q: '¿Cuánto dura la investigación UX y cuánto cuesta?', a: 'Normalmente 3–8 semanas según el número de públicos objetivo, la forma de reclutamiento, los métodos y el alcance de la entrega. Tras el encargo inicial preparamos una propuesta, un calendario y un precio concretos.' },
  { q: '¿Y si ya tenemos analítica o investigación previa?', a: 'Primero revisamos los datos existentes y los usamos como punto de partida. Proponemos una nueva recogida solo donde necesitamos completar información que falta o verificar conclusiones inciertas.' },
  { q: '¿La investigación tiene que realizarse en persona?', a: 'No necesariamente. Las entrevistas y las pruebas de usuario pueden realizarse en persona o de forma remota, según el objetivo. La investigación de campo, en cambio, se desarrolla directamente en el entorno donde las personas usan el servicio, el producto o el procedimiento de trabajo.' },
  { q: '¿Cuándo incorporan el eye tracking y la biometría a la investigación UX?', a: 'Solo cuando la pregunta de investigación exige medir con precisión la atención visual, la activación fisiológica o la carga mental. No forman parte automática de toda investigación, sino que son una ampliación opcional.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Investigación UX',
    description: 'Investigación UX para decisiones de producto: entrevistas, observación, pruebas de usuario, cuestionarios, análisis de datos y recomendaciones priorizadas.',
    serviceType: 'Investigación UX',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="es"
  title="Investigación UX para decisiones de producto | UX MIND"
  description="Investigación UX mediante entrevistas, observación, pruebas de usuario y análisis de datos. Obtenga hallazgos claros, prioridades y recomendaciones para su producto."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICIOS / INVESTIGACIÓN UX ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          ENTIENDA<br/>LAS CONEXIONES<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-3xl">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Decida qué tiene sentido crear y mejorar.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify mb-4">
              La investigación UX responde a preguntas más amplias que la prueba de una sola pantalla. Ayuda a averiguar quiénes son sus usuarios, qué necesitan, cómo deciden y qué partes de su recorrido tienen mayor influencia en la experiencia con el producto o servicio.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify">
              Según el objetivo, combinamos entrevistas, observación, pruebas de usuario, cuestionarios y los datos disponibles. El resultado son <strong class="text-brand-black">hallazgos claros, prioridades y recomendaciones para las decisiones de producto</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/es/contacto" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              SOLICITAR INVESTIGACIÓN UX →
            </a>
            <a href="/es/servicios#testovaci-balicky" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              VER PAQUETES
            </a>
          </div>
        </div>
      </div>

      <!-- Franja informativa -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURACIÓN', '3–8 semanas'],
          ['MÉTODOS', 'Entrevistas · observación · datos'],
          ['ENTREGAS', 'Hallazgos · prioridades · recomendaciones'],
          ['FORMATO', 'Investigación a medida'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- A qué responde la investigación UX -->
      <div class="reveal mb-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.35fr] gap-10 lg:gap-16">
          <div>
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ A QUÉ RESPONDE LA INVESTIGACIÓN UX ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              Primero la pregunta. Luego el método<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <div class="border-t border-brand-white/20">
            {researchQuestions.map((question, i) => (
              <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_13rem_1fr] gap-x-4 gap-y-2 py-6 border-b border-brand-white/20">
                <span class="font-mono text-xs text-brand-white/50 pt-1">0{i + 1}</span>
                <h3 class="font-display text-lg font-bold leading-tight">{question.title}</h3>
                <p class="col-start-2 sm:col-start-3 text-sm text-brand-white/65 leading-relaxed">{question.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Cuándo tiene sentido -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CUÁNDO TIENE SENTIDO LA INVESTIGACIÓN UX ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-4xl">
          Cuando no basta con ajustar una sola pantalla<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12">
          {situations.map((situation, i) => (
            <div class="grid grid-cols-[2rem_1fr] gap-x-4 py-6 border-t border-brand-black/20">
              <span class="font-mono text-xs text-brand-black/50 pt-1">0{i + 1}</span>
              <div>
                <h3 class="font-display text-xl font-bold mb-2 leading-tight">{situation.title}</h3>
                <p class="text-sm text-brand-black/60 leading-relaxed">{situation.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Métodos -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CÓMO COMBINAMOS LOS MÉTODOS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6 max-w-4xl">
          La decisión determina el alcance, no una lista de métodos<span style="color:#2D62FC">.</span>
        </h2>
        <p class="text-brand-black/60 leading-relaxed text-justify max-w-3xl mb-10">
          No empezamos metiendo en el proyecto todas las técnicas disponibles. Primero determinamos qué tipo de respuesta necesita y solo después proponemos la combinación más pequeña de métodos que tenga sentido.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          {methods.map((method, i) => (
            <div class="bg-brand-white p-8 flex flex-col min-h-64">
              <span class="font-mono text-xs text-brand-black/60 mb-8">0{i + 1}</span>
              <h3 class="font-display text-2xl font-bold mb-3">{method.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6 text-justify">{method.desc}</p>
              <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mt-auto pt-5 border-t border-brand-black/10">{method.methods}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Foto -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/laborator-ux-vyzkumu-vizualizace-1.webp`}
          alt="Laboratorio de investigación UX — instalaciones para entrevistas, pruebas y mediciones biométricas"
          title="Laboratorio de investigación UX"
          width="1200" height="846" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Infraestructura de investigación FIMEYELAB en la FIM UHK — un espacio para entrevistas, pruebas de usuario y, si es necesario, mediciones sincronizadas.</p>
      </div>

      <!-- Qué recibirá -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-16">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ QUÉ RECIBIRÁ ]</p>
          <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight max-w-xl">
            Argumentos para decidir, no un documento de archivo<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-black/60 leading-relaxed mt-6 max-w-xl text-justify">
            Elegimos el formato de la entrega según quién trabajará con los resultados y qué decisión debe seguir. Ni el journey map ni las personas son un elemento obligatorio — solo se crean cuando ayudan al trabajo posterior.
          </p>
        </div>
        <div class="border-t border-brand-black/20">
          {deliverables.map((deliverable, i) => (
            <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_13rem_1fr] gap-x-4 gap-y-2 py-6 border-b border-brand-black/20">
              <span class="font-mono text-xs text-brand-black/50 pt-1">0{i + 1}</span>
              <h3 class="font-display text-lg font-bold leading-tight">{deliverable.title}</h3>
              <p class="col-start-2 sm:col-start-3 text-sm text-brand-black/60 leading-relaxed">{deliverable.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Proceso -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CÓMO SE DESARROLLA LA INVESTIGACIÓN UX ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-4xl">
          De la pregunta al siguiente paso de producto<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-x-7 gap-y-10">
          {process.map(step => (
            <div class="border-t border-brand-black/20 pt-5">
              <span class="block font-mono text-xs text-brand-black/60 mb-5">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Medición avanzada -->
      <div class="reveal mb-24 border border-brand-black/15 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ MEDICIÓN AVANZADA OPCIONAL ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">Cuando los testimonios y la observación no bastan<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Si la pregunta de investigación exige medir con precisión la atención visual, la activación fisiológica o la carga mental, podemos ampliar el estudio con eye tracking, GSR, análisis de señales faciales o EMLI. Añadimos el método solo cuando aporta el tipo de evidencia necesario.
            </p>
          </div>
          <a href="/es/servicios/eye-tracking" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            VER EYE TRACKING →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ PREGUNTAS FRECUENTES ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
</content>
