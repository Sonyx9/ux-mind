---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const methods = [
  { title: 'Entrevistas en profundidad', type: 'CUALITATIVO', desc: 'Las entrevistas individuales revelan motivaciones, frustraciones y modelos mentales.' },
  { title: 'Pruebas de usabilidad', type: 'CUALITATIVO', desc: 'Observamos a los usuarios completando tareas e identificamos dónde fallan.' },
  { title: 'Investigación contextual', type: 'CUALITATIVO', desc: 'Observamos a los usuarios en su entorno natural, cómo trabajan realmente.' },
  { title: 'Encuestas mediante cuestionario', type: 'CUANTITATIVO', desc: 'Datos de muchos participantes para conclusiones estadísticamente relevantes.' },
  { title: 'Pruebas A/B', type: 'CUANTITATIVO', desc: 'Comparamos variantes de diseño en tráfico real y medimos los resultados.' },
  { title: 'Card sorting', type: 'MIXTO', desc: 'Cómo categorizan los usuarios el contenido — la base de una mejor arquitectura de la información.' },
];

const deliverables = [
  'Informe de investigación con metodología y hallazgos',
  'Personas — perfiles basados en datos de los grupos clave',
  'Journey maps incluyendo los pain points',
  'Recomendaciones priorizadas según el impacto',
  'Material de base para el rediseño o nuevas pruebas',
];

const process = [
  { num: '01', title: 'Pregunta de investigación', desc: 'Qué necesita decidir y a quién afecta.' },
  { num: '02', title: 'Diseño de los métodos', desc: 'Combinación de métodos cualitativos y cuantitativos según la pregunta.' },
  { num: '03', title: 'Recogida de datos', desc: 'Entrevistas, pruebas, cuestionarios — con pilotaje y control de calidad.' },
  { num: '04', title: 'Síntesis y entrega', desc: 'Conectamos los hallazgos en recomendaciones, personas y journey maps.' },
];

const faq = [
  { q: '¿Cuándo tiene sentido una investigación en profundidad en lugar de una prueba rápida?', a: 'Cuando no decide sobre una sola interfaz, sino sobre la estrategia de producto: para quién construye, qué necesidades resuelve, dónde es más débil el recorrido del usuario. Una prueba rápida verifica una solución concreta; la investigación dice qué construir en primer lugar.' },
  { q: '¿Cuánto dura la investigación UX?', a: 'Según el alcance, normalmente 3–8 semanas: diseño de la investigación, reclutamiento, recogida de datos, análisis y síntesis en recomendaciones.' },
  { q: '¿Combinan la investigación con biometría?', a: 'Sí. Las entrevistas y observaciones pueden complementarse con eye-tracking, GSR o el índice de carga mental EMLI — así verificamos los testimonios subjetivos frente a datos objetivos.' },
  { q: '¿Y si ya tenemos datos propios?', a: 'Perfecto — incorporamos a la síntesis la analítica, la atención al cliente o investigaciones anteriores. La nueva recogida se dirige entonces solo a los puntos donde faltan datos.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Investigación UX',
    description: 'Investigación UX en profundidad que combina métodos cualitativos y cuantitativos: entrevistas, pruebas de usabilidad, cuestionarios, personas y journey maps.',
    serviceType: 'Investigación UX',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="es"
  title="Investigación UX y pruebas de usuario de webs"
  description="Pruebas de usuario de webs, entrevistas en profundidad, pruebas de usabilidad, personas y journey maps. Decida con datos, no con suposiciones."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICIOS / INVESTIGACIÓN UX ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          DATOS EN LUGAR<br/>DE IMPRESIONES<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">El alcance más profundo: entender a los usuarios, no solo la interfaz.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              Combinamos métodos cualitativos y cuantitativos para revelar
              <strong class="text-brand-black">las necesidades, frustraciones y modelos mentales</strong> de sus usuarios.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="/es/contacto" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              INICIAR LA INVESTIGACIÓN →
            </a>
            <a href="/es/servicios/paquetes-de-prueba" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              PAQUETES DE PRUEBA
            </a>
          </div>
        </div>
      </div>

      <!-- Franja informativa -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURACIÓN', '3–8 semanas'],
          ['MÉTODOS', 'Cuali + cuanti'],
          ['ENTREGAS', 'Personas · journey maps'],
          ['PAQUETE', 'Biométrico integral'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Métodos -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ MÉTODOS DE INVESTIGACIÓN ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          El método correcto para la pregunta correcta<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {methods.map(method => (
            <div class="bg-brand-white p-8">
              <span class="font-mono text-[10px] text-brand-black/60 border border-brand-black/20 px-2 py-0.5 tracking-widest">{method.type}</span>
              <h3 class="font-display text-xl font-bold mb-3 mt-4">{method.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{method.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Foto -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/laborator-ux-vyzkumu-vizualizace-1.webp`}
          alt="Laboratorio de investigación UX — instalaciones para entrevistas, pruebas y mediciones biométricas"
          title="Laboratorio de investigación UX"
          width="1200" height="800" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Infraestructura de investigación de la FIM UHK — las entrevistas y pruebas pueden complementarse con eye-tracking y biometría en la misma sesión.</p>
      </div>

      <!-- Qué recibirá + proceso -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ QUÉ RECIBIRÁ ]</p>
          <ul class="space-y-2">
            {deliverables.map(o => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {o}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ CÓMO SE DESARROLLA LA INVESTIGACIÓN ]</p>
          <div class="space-y-0">
            {process.map(step => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Biometría -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ TESTIMONIOS + DATOS OBJETIVOS ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">Qué dice la gente vs. qué hace<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Verificamos las respuestas declaradas frente al comportamiento: combinamos entrevistas y cuestionarios
              con eye-tracking, GSR y el índice de carga mental EMLI. Así decide sobre lo que realmente sucedió.
            </p>
          </div>
          <a href="/es/servicios/paquetes-de-prueba#komplexni-biometricky-vyzkum" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            PAQUETE BIOMÉTRICO →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ PREGUNTAS FRECUENTES ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            CONOZCA A SUS<br/>USUARIOS<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            Descríbanos qué necesita decidir. Diseñaremos una investigación que lo responda — sin métodos de más.
          </p>
          <a href="/es/contacto" class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
            INICIAR LA INVESTIGACIÓN →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
