---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="es"
  title="Contacto"
  description="Concierte una consulta sin compromiso sobre pruebas de usuario, auditoría UX de su web o eye tracking. Respondemos en 48 horas."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CONTACTO ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          VAMOS A<br/>COMPROBARLO<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-16">

        <!-- Contact info -->
        <div>
          <p class="text-xl text-brand-black/60 leading-relaxed mb-12 text-justify">
            Envíenos su web, aplicación, campaña o una breve descripción del problema. Responderemos en 48 horas y le propondremos qué tiene sentido verificar y qué enfoque elegir.
          </p>

          <div class="space-y-6">
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">E-MAIL</p>
              <a href="mailto:spoluprace@uxmind.cz" class="font-display text-2xl font-bold hover:text-brand-blue transition-colors">
                spoluprace@uxmind.cz
              </a>
            </div>
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">TELÉFONO</p>
              <a href="tel:+420728601160" class="font-display text-2xl font-bold hover:text-brand-blue transition-colors">
                +420 728 601 160
              </a>
            </div>
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">SEDE</p>
              <p class="font-display text-xl font-bold">K Lesu 180, Svinary<br/>500 09 Hradec Králové</p>
            </div>
          </div>

        </div>

        <!-- Contact form -->
        <div class="relative min-h-[620px]">
          <div class="absolute inset-0 z-10 border border-brand-black/10 bg-brand-white/95 flex items-center justify-center p-8 text-center">
            <div class="max-w-sm">
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ FORMULARIO DE CONTACTO ]</p>
              <p class="font-display text-4xl md:text-5xl font-bold tracking-tight mb-5">EN PREPARACIÓN<span class="text-brand-blue">.</span></p>
              <p class="text-brand-black/60 leading-relaxed">
                Mientras preparamos el formulario, escríbanos a <a href="mailto:spoluprace@uxmind.cz" class="font-bold text-brand-black hover:text-brand-blue transition-colors">spoluprace@uxmind.cz</a>.
              </p>
            </div>
          </div>
          <form class="space-y-6 opacity-20 pointer-events-none select-none" name="contacto" method="POST" data-netlify="true" aria-hidden="true">
            <fieldset disabled>
            <div class="space-y-6">
            <div>
              <label for="f-name" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">NOMBRE *</label>
              <input
                type="text"
                id="f-name"
                name="name"
                required
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent"
                placeholder="Su nombre"
              />
            </div>

            <div>
              <label for="f-email" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">E-MAIL *</label>
              <input
                type="email"
                id="f-email"
                name="email"
                required
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent"
                placeholder="su@email.es"
              />
            </div>

            <div>
              <label for="f-company" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">EMPRESA</label>
              <input
                type="text"
                id="f-company"
                name="company"
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent"
                placeholder="Nombre de la empresa"
              />
            </div>

            <div>
              <label for="f-service" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">TEMA DEL PROYECTO</label>
              <select
                id="f-service"
                name="service"
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent appearance-none"
              >
                <option value="">Seleccione una opción...</option>
                <option value="auditoria-ux">Auditoría UX</option>
                <option value="eye-tracking">Eye Tracking</option>
                <option value="investigacion-ux">Investigación UX</option>
                <option value="pruebas-de-usuario">Pruebas de usuario</option>
                <option value="consultoria">Consultoría</option>
                <option value="otro">Otro</option>
              </select>
            </div>

            <div>
              <label for="f-message" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">¿QUÉ NECESITA DESCUBRIR? *</label>
              <textarea
                id="f-message"
                name="message"
                required
                rows="5"
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent resize-none"
                placeholder="Basta con describir brevemente el proyecto, el problema o la decisión con la que necesita ayuda."
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors"
            >
              ENVIAR CONSULTA →
            </button>
            </div>
            </fieldset>
          </form>
        </div>
      </div>

      <!-- Operador del sitio y datos bancarios -->
      <div class="mt-16 border border-brand-black/10 p-8 md:p-10">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ OPERADOR DEL SITIO ]</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-8 text-sm">
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">RAZÓN SOCIAL</p>
            <p class="text-brand-black/80">UX MIND Research Lab s.r.o.</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">N.º DE IDENTIFICACIÓN (IČO)</p>
            <p class="text-brand-black/80">29714966</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">FECHA DE REGISTRO</p>
            <p class="text-brand-black/80">24 de junio de 2026</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">EXPEDIENTE</p>
            <p class="text-brand-black/80">C 57053, registrado en el Tribunal Regional de Hradec Králové</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">SEDE</p>
            <p class="text-brand-black/80">K Lesu 180, Svinary, 500 09 Hradec Králové</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">BANCO</p>
            <p class="text-brand-black/80">MONETA Money Bank, a.s.</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">NÚMERO DE CUENTA</p>
            <p class="text-brand-black/80">283221603/0600</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">IBAN</p>
            <p class="text-brand-black/80 break-words">CZ96 0600 0000 0002 8322 1603</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">SWIFT / BIC</p>
            <p class="text-brand-black/80">AGBACZPP</p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
</content>
