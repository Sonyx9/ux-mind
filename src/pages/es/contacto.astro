---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="es"
  title="Contacto"
  description="Contacte con UX Mind. Reserve una consulta gratuita de auditoría UX, eye tracking o investigación UX."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CONTACTO ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          HABLE-<br/>MOS<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-16">

        <div>
          <p class="text-xl text-brand-black/60 leading-relaxed mb-12">
            Nos encantará conocer su proyecto. Escríbanos o rellene el formulario — respondemos en 24 horas.
          </p>

          <div class="space-y-6">
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">E-MAIL</p>
              <a href="mailto:spoluprace@uxmind.cz" class="font-display text-2xl font-bold hover:opacity-50 transition-opacity">
                spoluprace@uxmind.cz
              </a>
            </div>
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">TELÉFONO</p>
              <a href="tel:+420728601160" class="font-display text-2xl font-bold hover:opacity-50 transition-opacity">
                +420 728 601 160
              </a>
            </div>
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">SEDE</p>
              <p class="font-display text-xl font-bold">K Lesu 180, Svinary<br/>500 09 Hradec Králové, Chequia</p>
            </div>
          </div>

          <div class="mt-12 p-6 border border-brand-black/10">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ RESPONDEMOS EN ]</p>
            <p class="font-display text-3xl font-bold">24 horas</p>
            <p class="text-sm text-brand-black/60 mt-1">en días laborables</p>
          </div>

          <div class="mt-6 p-6 border border-brand-black/10">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ OPERADOR DEL SITIO ]</p>
            <div class="space-y-3 text-sm">
              <div>
                <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-0.5">RAZÓN SOCIAL</p>
                <p class="text-brand-black/80">UX MIND Research Lab s.r.o.</p>
              </div>
              <div>
                <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-0.5">N.º DE IDENTIFICACIÓN (IČO)</p>
                <p class="text-brand-black/80">29714966</p>
              </div>
              <div>
                <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-0.5">EXPEDIENTE</p>
                <p class="text-brand-black/80">C 57053, registrado en el Tribunal Regional de Hradec Králové</p>
              </div>
              <div>
                <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-0.5">FECHA DE REGISTRO</p>
                <p class="text-brand-black/80">24 de junio de 2026</p>
              </div>
              <div>
                <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-0.5">DOMICILIO SOCIAL</p>
                <p class="text-brand-black/80">K Lesu 180, Svinary, 500 09 Hradec Králové, Chequia</p>
              </div>
            </div>
          </div>
        </div>

        <div>
          <form class="space-y-6" name="contacto-es" method="POST" data-netlify="true">
            <div>
              <label for="f-name" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">NOMBRE *</label>
              <input
                type="text"
                id="f-name"
                name="name"
                required
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent"
                placeholder="Su nombre"
              />
            </div>

            <div>
              <label for="f-email" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">E-MAIL *</label>
              <input
                type="email"
                id="f-email"
                name="email"
                required
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent"
                placeholder="su@email.es"
              />
            </div>

            <div>
              <label for="f-company" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">EMPRESA</label>
              <input
                type="text"
                id="f-company"
                name="company"
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent"
                placeholder="Nombre de la empresa"
              />
            </div>

            <div>
              <label for="f-service" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">SERVICIO DE INTERÉS</label>
              <select
                id="f-service"
                name="service"
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent appearance-none"
              >
                <option value="">Seleccione un servicio…</option>
                <option value="auditoria-ux">Auditoría UX</option>
                <option value="eye-tracking">Eye Tracking</option>
                <option value="investigacion-ux">Investigación UX</option>
                <option value="pruebas-de-usuario">Pruebas de usuario</option>
                <option value="consultoria">Consultoría</option>
                <option value="otro">Otro</option>
              </select>
            </div>

            <div>
              <label for="f-message" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">MENSAJE *</label>
              <textarea
                id="f-message"
                name="message"
                required
                rows="5"
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent resize-none"
                placeholder="Describa su proyecto o su consulta…"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors"
            >
              ENVIAR MENSAJE →
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
