---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const vystupyMereni = [
  ['Atención', 'Qué elementos registra el usuario, en qué orden y qué pasa completamente por alto.'],
  ['Desarrollo de la tarea', 'Dónde avanza con fluidez, dónde retrocede y en qué paso se detiene.'],
  ['Reacción', 'En qué puntos aumenta la activación o la carga mental.'],
];

const vrstvy = [
  {
    t: 'Atención visual',
    d: 'El eye tracking muestra hacia dónde mira el usuario, en qué orden y qué pasa completamente por alto. También determinamos con qué rapidez encuentra un elemento importante y cuánto tiempo le dedica.',
    tag: 'EYE TRACKING',
  },
  {
    t: 'Reacción emocional',
    d: 'La conductancia de la piel capta los cambios de activación fisiológica, y el análisis de la expresión facial, el gesto del rostro. Ayudan a determinar los momentos que provocan una reacción, aunque por sí solos no explican por qué surgió.',
    tag: 'GSR + EXPRESIÓN FACIAL',
  },
  {
    t: 'Carga mental',
    d: 'Medimos dónde exige la interfaz más atención y esfuerzo. Detectamos los puntos que ralentizan al usuario, lo confunden o complican innecesariamente la finalización de la tarea.',
    tag: 'ESFUERZO MENTAL',
  },
];

const vybaveni = [
  { nazev: 'Smart Eye Aurora', typ: 'eye tracking de sobremesa', k: 'Seguimiento preciso de la mirada al probar webs, aplicaciones y otras interfaces digitales.' },
  { nazev: 'Tobii Pro X2-60', typ: 'eye tracking de sobremesa', k: 'Eye tracker portátil para estudios en pantalla y comparación de distintas variantes.' },
  { nazev: 'Pupil Labs Neon (2×)', typ: 'eye tracking móvil', k: 'Gafas para seguir la atención en tiendas, showrooms, estadios o en el punto de venta.' },
  { nazev: 'iMotions + análisis de expresión facial', typ: 'software de investigación', k: 'Combina el eye tracking, la expresión facial y otras señales en un único registro sincronizado en el tiempo.' },
  { nazev: 'Shimmer3 GSR', typ: 'biometría', k: 'Registra los cambios de conductancia de la piel, que indican el nivel de activación fisiológica.' },
];

const postup = [
  { num: '01', title: 'Diseño del estudio', desc: 'Aclaramos qué necesita averiguar, a quién tiene sentido probar y según qué criterios evaluaremos el resultado.' },
  { num: '02', title: 'Preparación y medición', desc: 'Preparamos las tareas, configuramos el equipo y realizamos la medición en el laboratorio o directamente en el campo.' },
  { num: '03', title: 'Análisis', desc: 'Vinculamos la mirada, el comportamiento, las reacciones y los testimonios de los participantes. Buscamos relaciones, no cifras aisladas sin contexto.' },
  { num: '04', title: 'Recomendaciones para la práctica', desc: 'Recibirá conclusiones claras, prioridades y recomendaciones concretas sobre qué cambiar.' },
];

const rizika = [
  'la calibración correcta durante toda la medición',
  'la fatiga de los participantes',
  'el orden de las tareas, para que no influya en el resultado',
  'un encargo claro e inequívoco',
  'que la conclusión no se apoye solo en una métrica',
];

const etika = [
  'Protocolo estandarizado y verificación piloto del estudio',
  'Consentimiento informado de cada participante',
  'Tratamiento de datos conforme al RGPD y, si es necesario, también bajo NDA',
  'Posibilidad de anonimizar los datos y un informe con la metodología descrita',
  'Evaluación por un comité de ética cuando la naturaleza del proyecto lo requiera',
];

const tymLaboratore = [
  ['02', 'Dirección y metodología'],
  ['01', 'Gestión del laboratorio'],
  ['08', 'Operadores formados'],
];

const pageSchema = [
  {
    '@type': 'ResearchOrganization',
    name: 'FIMEYELAB',
    description:
      'Laboratorio de eye tracking y biometría de la Facultad de Informática y Gestión de Univerzita Hradec Králové. Medición de la atención visual, la reacción emocional y la carga cognitiva en laboratorio y en campo.',
    parentOrganization: {
      '@type': 'CollegeOrUniversity',
      name: 'Univerzita Hradec Králové — Fakulta informatiky a managementu',
    },
  },
  {
    '@type': 'AboutPage',
    name: 'Sobre nosotros — laboratorio FIMEYELAB',
    description:
      'UX MIND mide en el laboratorio FIMEYELAB en la FIM UHK. Cinco sistemas de medición, ocho publicaciones especializadas, dos tesis doctorales defendidas.',
  },
];
---

<BaseLayout
  lang="es"
  title="Laboratorio FIMEYELAB | Quién está detrás de UX MIND"
  description="No medimos en una sala de reuniones. UX MIND mide en el laboratorio FIMEYELAB en la Facultad de Informática y Gestión de la UHK: cinco sistemas de medición, ocho publicaciones especializadas, dos tesis doctorales defendidas."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SOBRE NOSOTROS / LABORATORIO ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          INVESTIGACIÓN<br/>EN LUGAR DE IMPRESIONES<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-4xl">
          <div>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify mb-4">
              UX MIND combina la experiencia con productos digitales y la infraestructura de investigación del laboratorio
              <strong class="text-brand-black">FIMEYELAB</strong> de la Facultad de Informática y Gestión de
              Univerzita Hradec Králové. Mediante eye tracking, pruebas de usuario y métodos biométricos,
              averiguamos qué ven realmente las personas, qué no entienden y dónde se pierden al decidir.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify">
              El resultado no son solo heatmaps y gráficos. Recibirá conclusiones claras y recomendaciones concretas
              para una web, una aplicación, una campaña o un espacio físico.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/es/casos-de-estudio" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              CASOS DE ESTUDIO
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['SISTEMAS DE MEDICIÓN', '5'],
          ['PUBLICACIONES ESPECIALIZADAS', '8'],
          ['TESIS DOCTORALES DEFENDIDAS', '2'],
          ['MEDIMOS EN', 'Laboratorio y campo'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight text-xl">{v}</p>
          </div>
        ))}
      </div>

      <!-- Foto laboratorio -->
      <div class="reveal mb-24 grid grid-cols-1 md:grid-cols-5 gap-8 items-start">
        <div class="md:col-span-2">
          <img
            src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
            alt="Participante durante la medición ante un equipo con eye tracker en el laboratorio FIMEYELAB"
            title="Medición en el laboratorio FIMEYELAB"
            width="1080" height="1920" loading="lazy" decoding="async"
            class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
          />
          <p class="font-mono text-[11px] text-brand-black/60 mt-2">
            Laboratorio FIMEYELAB, Facultad de Informática y Gestión de la UHK.
          </p>
        </div>
        <div class="md:col-span-3">
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ LA MEDICIÓN EN LA PRÁCTICA ]</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold leading-tight mb-6">
            Qué observamos durante las pruebas<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-black/60 leading-relaxed text-justify mb-4">
            El eye tracker bajo el monitor registra el movimiento de los ojos sesenta veces por segundo. La cámara
            sobre el monitor capta las reacciones faciales, mientras la participante completa una tarea concreta en la página evaluada.
          </p>
          <p class="text-brand-black/60 leading-relaxed text-justify">
            Al vincular la mirada, el comportamiento y las reacciones, averiguamos qué notó el usuario, qué pasó
            por alto y en qué punto dudó al completar la tarea.
          </p>
          <dl class="mt-8 border-t border-brand-black/10 pt-6 space-y-4">
            {vystupyMereni.map(([label, desc], i) => (
              <div class="flex gap-4">
                <span class="font-mono text-xs shrink-0 pt-0.5" style="color:#2D62FC;">0{i + 1}</span>
                <div>
                  <dt class="font-mono text-[11px] tracking-widest uppercase text-brand-black/70 mb-0.5">{label}</dt>
                  <dd class="text-sm text-brand-black/60 leading-relaxed">{desc}</dd>
                </div>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <!-- Jak to spolu souvisí -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CÓMO SE RELACIONA TODO ESTO ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-8 max-w-3xl">
          Laboratorio universitario, ritmo comercial<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          <div class="bg-brand-white p-6 md:p-8">
            <p class="font-mono text-xs text-brand-black/60 mb-6">01</p>
            <h3 class="font-display text-2xl font-bold mb-3">Laboratorio FIMEYELAB</h3>
            <p class="text-brand-black/60 leading-relaxed text-sm text-justify">
              FIMEYELAB pertenece a Univerzita Hradec Králové. Sirve a la investigación, la docencia y la dirección
              de trabajos de fin de grado y tesis doctorales, y con ello mantiene un listón metodológico que la
              actividad comercial no se impone a sí misma.
            </p>
          </div>
          <div class="bg-brand-white p-6 md:p-8">
            <p class="font-mono text-xs text-brand-black/60 mb-6">02</p>
            <h3 class="font-display text-2xl font-bold mb-3">UX MIND</h3>
            <p class="text-brand-black/60 leading-relaxed text-sm text-justify">
              Los encargos comerciales en el laboratorio siempre pasan por UX MIND. Somos el socio contractual con
              el que firma el encargo, recibe un plazo, un precio y un resultado, y que responde por él.
            </p>
          </div>
          <div class="bg-brand-white p-6 md:p-8">
            <p class="font-mono text-xs text-brand-black/60 mb-6">03</p>
            <h3 class="font-display text-2xl font-bold mb-3">Conexión</h3>
            <p class="text-brand-black/60 leading-relaxed text-sm text-justify">
              Jan Petružálek es el director del laboratorio FIMEYELAB y, al mismo tiempo, copropietario de UX MIND.
              La metodología y la ejecución no son, por tanto, dos mundos que se lanzan cosas por encima de la valla.
            </p>
          </div>
        </div>
        <p class="text-brand-black/60 leading-relaxed text-justify mt-8 max-w-3xl">
          En la práctica, esto significa una sola cosa para usted: recibe metodología académica sin plazos académicos.
          Así hemos medido el portal de empleo de <strong class="text-brand-black">ŠKODA AUTO</strong>,
          la campaña de un club de fútbol y las páginas de producto de tiendas online.
        </p>
      </div>

      <!-- Co umíme změřit -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ QUÉ SABEMOS MEDIR ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Tres capas de la experiencia de usuario<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {vrstvy.map((v, i) => (
            <div class="bg-brand-white p-8 flex flex-col">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed text-justify mb-6">{v.d}</p>
              <span class="mt-auto self-start font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Una sola métrica no basta. Por eso vinculamos la mirada, el desarrollo de la tarea, las reacciones y el
          testimonio del usuario. Solo su relación conjunta muestra dónde surge el problema y qué tiene sentido cambiar.
        </p>
      </div>

      <!-- Čím měříme -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CON QUÉ MEDIMOS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Cinco sistemas para el laboratorio y el campo<span style="color:#2D62FC">.</span>
        </h2>
        <div class="border border-brand-black/10">
          {vybaveni.map(z => (
            <div class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-6 p-6 border-b border-brand-black/10 last:border-0">
              <div class="md:col-span-4">
                <p class="font-display text-lg font-bold leading-tight">{z.nazev}</p>
                <p class="font-mono text-[11px] text-brand-black/60 tracking-wide uppercase">{z.typ}</p>
              </div>
              <p class="md:col-span-8 text-sm text-brand-black/60 leading-relaxed">{z.k}</p>
            </div>
          ))}
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Dos equipos de gafas móviles nos permiten medir a más participantes o situaciones en menos tiempo.
        </p>
      </div>

      <!-- Vizualizace laboratoře -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/laborator-ux-vyzkumu-vizualizace-1.webp`}
          alt="Visualización de la disposición prevista del laboratorio FIMEYELAB"
          title="Disposición prevista del laboratorio"
          width="1600" height="1127" loading="lazy" decoding="async"
          class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">
          Visualización de la disposición prevista del laboratorio: puestos de medición separados para pruebas simultáneas.
        </p>
      </div>

      <!-- Jak měření probíhá -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CÓMO TRANSCURRE LA MEDICIÓN ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          De la pregunta a una recomendación concreta<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
          {postup.map(step => (
            <div class="bg-brand-white p-6 md:p-8 flex flex-col">
              <p class="font-mono text-xs text-brand-black/60 mb-6">{step.num}</p>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
        <div class="mt-6 border border-brand-black/10 p-8 md:p-10">
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ QUÉ VIGILAMOS EN EL PROTOCOLO ]</p>
          <ul class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-x-8 gap-y-4 mb-8">
            {rizika.map(r => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed">
                <span class="font-mono text-xs pt-0.5 shrink-0" style="color:#2D62FC;">→</span> {r}
              </li>
            ))}
          </ul>
          <p class="text-sm text-brand-black/60 leading-relaxed max-w-3xl border-t border-brand-black/10 pt-6">
            Gracias a ello, los resultados son comparables y las recomendaciones no se basan en el azar ni en una única grabación.
          </p>
        </div>
      </div>

      <!-- Akademické zázemí -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ RESPALDO ACADÉMICO ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Respaldo especializado en cifras<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          <div class="bg-brand-white p-8">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">PUBLICACIONES</p>
            <p class="font-display text-5xl font-bold mb-2">8</p>
            <p class="text-sm text-brand-black/60 leading-relaxed mb-6">
              publicaciones especializadas centradas en eye tracking y experiencia de usuario.
            </p>
            <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-2">EJEMPLO DE PUBLICACIÓN</p>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Franěk, M., &amp; Petružálek, J. (2025). <em>Perceptual fluency and eye movements when viewing
              urban and natural scenes.</em> Scientific Reports, 15(1), art. 25772.
            </p>
          </div>
          <div class="bg-brand-white p-8">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">INVESTIGACIÓN Y DOCENCIA</p>
            <ul class="space-y-3 text-sm text-brand-black/60 leading-relaxed">
              <li class="pb-3 border-b border-brand-black/5">
                <strong class="text-brand-black">2 tesis doctorales defendidas</strong><br/>
                Jan Petružálek (2023) — combinación de métodos de medición de la experiencia de usuario mediante eye tracking<br/>
                Denis Šefara (2022) — uso de la atención en el diseño de dashboards de negocio
              </li>
              <li>
                <strong class="text-brand-black">8 trabajos de fin de máster y de grado defendidos</strong><br/>
                2 trabajos de fin de máster, 6 trabajos de fin de grado
              </li>
            </ul>
          </div>
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          El trabajo continuo en temas de investigación nos permite verificar, comparar y desarrollar los métodos
          en distintos tipos de encargos.
        </p>
      </div>

      <!-- Lidé -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ PERSONAS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6 max-w-3xl">
          Dos socios, un equipo de investigación más amplio<span style="color:#2D62FC">.</span>
        </h2>
        <p class="text-brand-black/60 leading-relaxed max-w-3xl mb-10">
          UX MIND está dirigida por dos socios. Según el alcance del proyecto, en el diseño del estudio, la medición
          y el procesamiento de datos también participan la dirección del laboratorio y operadores formados.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mb-px">

          <!-- Jan Petružálek -->
          <div class="bg-brand-white flex flex-col">
            <div class="border-b border-brand-black/10 aspect-[3/2] flex flex-col items-center justify-center text-center px-6" style="background-image: linear-gradient(rgba(10,10,10,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.06) 1px, transparent 1px); background-size: 20% 25%;">
              <p class="font-mono text-[10px] tracking-widest text-brand-black/40 mb-3">[ RETRATO EN PREPARACIÓN ]</p>
              <p class="font-display text-lg md:text-xl font-bold text-brand-black/40 leading-snug max-w-xs">Jan Petružálek</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase mb-2" style="color:#2D62FC">DIRECTOR DEL LABORATORIO FIMEYELAB · COPROPIETARIO DE UX MIND</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-4">Ing. Jan Petružálek, Ph.D.</h3>
              <p class="text-brand-black/60 leading-relaxed mb-6">
                Diseña la investigación, supervisa el desarrollo de las mediciones y responde del análisis e
                interpretación de los datos. En su tesis doctoral se centró en la combinación de métodos de
                investigación UX con eye tracking. Publica en el ámbito de la experiencia de usuario y el e-commerce.
              </p>
              <a href="https://www.linkedin.com/in/jan-petru%C5%BE%C3%A1lek-79167474/" target="_blank" rel="noopener noreferrer" class="mt-auto self-start inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                LINKEDIN ↗
              </a>
            </div>
          </div>

          <!-- Lukáš Koula -->
          <div class="bg-brand-white flex flex-col">
            <div class="border-b border-brand-black/10 aspect-[3/2] flex flex-col items-center justify-center text-center px-6" style="background-image: linear-gradient(rgba(10,10,10,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.06) 1px, transparent 1px); background-size: 20% 25%;">
              <p class="font-mono text-[10px] tracking-widest text-brand-black/40 mb-3">[ RETRATO EN PREPARACIÓN ]</p>
              <p class="font-display text-lg md:text-xl font-bold text-brand-black/40 leading-snug max-w-xs">Lukáš Koula</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase mb-2" style="color:#2D62FC">ESTRATEGIA, WEB Y MARKETING · COPROPIETARIO DE UX MIND</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-4">Mgr. Lukáš Koula</h3>
              <p class="text-brand-black/60 leading-relaxed mb-6">
                Traduce los resultados de la investigación en recomendaciones concretas para webs, e-commerce y
                campañas. Dirige los proyectos, la comunicación con los clientes y vincula la investigación con
