---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="es"
  title="Servicios"
  description="Auditoría UX de webs y e-commerce, eye tracking, investigación UX, pruebas de usuario y mediciones de campo con gafas móviles de eye-tracking. Recomendaciones respaldadas por datos, no por impresiones."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Header -->
      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ NUESTROS SERVICIOS ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter" style="font-size: clamp(3rem, 9vw, 8rem);">
          LO QUE<br/>HACEMOS<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Services list -->
      <div class="space-y-px border border-brand-black/10">
        {[
          // Orden: de la base rápida (auditoría) a la investigación más completa
          {
            num: '01',
            id: 'ux-audit',
            href: '/es/servicios/auditoria-ux',
            title: 'Auditoría UX',
            desc: 'Revisamos su web, e-commerce o aplicación con los ojos del usuario. Encontramos los puntos donde las personas se pierden, abandonan o no completan un paso importante. Recibirá recomendaciones concretas ordenadas por impacto.',
            details: ['Análisis heurístico', 'Análisis de flujos de usuario', 'Lista de recomendaciones priorizadas', 'Taller con el equipo', 'Informe final con propuestas de ajustes'],
            duration: '2–4 semanas',
            pkg: 'Diagnóstico rápido',
          },
          {
            num: '02',
            id: 'testovani-uzivatelu',
            href: '/es/servicios/pruebas-de-usuario',
            title: 'Pruebas de usuario',
            desc: 'Damos a usuarios reales tareas concretas y observamos si son capaces de completarlas. Descubrirá dónde se pierden, qué no entienden y por qué abandonan.',
            details: ['Pruebas moderadas', 'Pruebas online no moderadas', 'El usuario piensa en voz alta mientras actúa', 'Grabación de pantalla', 'Resultados y recomendaciones'],
            duration: '1–4 semanas',
            pkg: 'Prueba UX estándar',
          },
          {
            num: '03',
            href: '/es/servicios/eye-tracking',
            title: 'Eye Tracking',
            desc: 'Con eye tracking medimos hacia dónde miran realmente las personas. Descubrirá qué notan, qué pasan por alto y si el contenido importante dirige su atención en la dirección correcta.',
            details: ['Heatmaps de atención', 'Análisis AOI (Areas of Interest)', 'Grabaciones de movimientos oculares', 'Análisis F-pattern y Z-pattern', 'Pruebas comparativas de variantes'],
            duration: '1–3 semanas',
            pkg: 'Prueba UX estándar',
          },
          {
            num: '04',
            id: 'terenni-mereni',
            href: '/es/servicios/investigacion-de-campo',
            title: 'Investigación de campo',
            desc: 'Observamos a los clientes justo donde deciden — en la tienda, el showroom, un evento o junto a un producto físico. Las gafas móviles de eye-tracking muestran qué notan y qué se les escapa en un entorno real.',
            details: ['Gafas móviles de eye-tracking Pupil Labs NEON', 'Grabación en vídeo de la situación y el comportamiento en el espacio', 'GSR y entrevistas según las necesidades', 'Product placement, señalización, materiales POS', 'Recomendaciones para ajustar el espacio y el recorrido del cliente'],
            duration: '2–6 semanas',
            pkg: 'Estudio de campo',
          },
          {
            num: '05',
            href: '/es/servicios/investigacion-ux',
            title: 'Investigación UX',
            desc: 'Le ayudamos a entender qué necesitan los usuarios, qué les frustra y por qué se comportan de determinada manera. Según la pregunta de investigación, combinamos entrevistas, observación, pruebas y datos.',
            details: ['Entrevistas en profundidad', 'Investigación contextual', 'Pruebas de usabilidad', 'Análisis de datos', 'Personas & Journey maps'],
            duration: '3–8 semanas',
            pkg: 'Investigación biométrica integral',
          },
        ].map(service => (
          <div id={service.id} class="p-8 md:p-12 border-b border-brand-black/10 last:border-0 scroll-mt-28">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <div class="md:col-span-2">
                <div class="flex items-baseline gap-4 mb-4">
                  <span class="font-mono text-xs text-brand-black/60">{service.num}</span>
                  <h2 class="font-display text-3xl md:text-4xl font-bold">
                    <a href={service.href} class="hover:opacity-60 transition-opacity">{service.title}</a>
                  </h2>
                </div>
                <p class="text-brand-black/60 leading-relaxed mb-6">{service.desc}</p>
                <ul class="space-y-1">
                  {service.details.map(d => (
                    <li class="font-mono text-xs text-brand-black/60 flex gap-2">
                      <span>→</span> {d}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="flex flex-col justify-between">
                <div>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">DURACIÓN DEL PROYECTO</p>
                  <p class="font-display text-lg font-semibold">{service.duration}</p>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mt-4 mb-1">PAQUETE TÍPICO</p>
                  <a href="/es/servicios/paquetes-de-prueba" class="font-display text-lg font-semibold underline hover:no-underline">{service.pkg}</a>
                </div>
                <div class="flex flex-col gap-2 mt-6">
                  <a href={service.href} class="inline-block bg-brand-black text-brand-white border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-[#2D62FC] hover:border-[#2D62FC] hover:text-brand-white transition-colors text-center">
                    DETALLE DEL SERVICIO →
                  </a>
                  <a href="/es/contacto" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors text-center">
                    CONSULTA SIN COMPROMISO
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Paquetes de prueba -->
      <a id="testovaci-balicky" href="/es/servicios/paquetes-de-prueba" class="group block mt-24 border border-brand-black bg-brand-black text-brand-white p-8 md:p-12 hover:bg-brand-white hover:text-brand-black transition-colors duration-300 scroll-mt-28">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
          <div class="md:col-span-2">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4 group-hover:text-brand-black/60 transition-colors">[ PAQUETES DE PRUEBA ]</p>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-4">Del control rápido a la investigación en profundidad<span style="color:#2D62FC">.</span></h2>
            <p class="text-brand-white/70 leading-relaxed max-w-2xl group-hover:text-brand-black/70 transition-colors">
              Elija el alcance según lo que necesite averiguar. Combinamos los métodos adecuados y le explicamos de antemano qué respuestas obtendrá de las pruebas.
            </p>
          </div>
          <div class="flex md:justify-end">
            <span class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase group-hover:border-brand-black group-hover:text-brand-black transition-colors">
              COMPARAR PAQUETES →
            </span>
          </div>
        </div>
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
