---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="es"
  title="Servicios"
  description="Auditoría UX, eye tracking, investigación UX y pruebas de usuario. Un portafolio completo de servicios UX para productos digitales."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ NUESTROS SERVICIOS ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter" style="font-size: clamp(3.5rem, 10vw, 9rem);">
          LO QUE<br/>HACEMOS.
        </h1>
      </div>

      <div class="space-y-px border border-brand-black/10">
        {[
          {
            num: '01',
            title: 'Auditoría UX',
            desc: 'Un análisis sistemático de su producto digital. Recorremos la interfaz desde la perspectiva del usuario, identificamos barreras y proponemos mejoras concretas priorizadas por impacto.',
            details: ['Análisis heurístico', 'Análisis de flujos de usuario', 'Lista de recomendaciones priorizadas', 'Taller con el equipo', 'Informe final con mockups'],
            duration: '2–4 semanas',
          },
          {
            num: '02',
            title: 'Eye Tracking',
            desc: 'Datos precisos sobre la percepción visual de sus contenidos. Seguimos los movimientos oculares de los usuarios al interactuar con su web, app o materiales impresos.',
            details: ['Heatmaps de atención', 'Análisis AOI (Areas of Interest)', 'Grabaciones de movimientos oculares', 'Análisis F-pattern y Z-pattern', 'Pruebas comparativas de variantes'],
            duration: '1–3 semanas',
          },
          {
            num: '03',
            title: 'Investigación UX',
            desc: 'Investigación profunda de usuarios que combina métodos cualitativos y cuantitativos. Le ayudamos a entender las necesidades, frustraciones y modelos mentales de sus usuarios.',
            details: ['Entrevistas en profundidad', 'Investigación contextual', 'Pruebas de usabilidad', 'Análisis de datos', 'Personas y Journey maps'],
            duration: '3–8 semanas',
          },
          {
            num: '04',
            title: 'Pruebas de usuario',
            desc: 'Pruebas moderadas y no moderadas con usuarios reales. Observamos cómo los usuarios completan tareas en su producto e identificamos dónde fallan.',
            details: ['Sesiones de prueba moderadas', 'Pruebas online no moderadas', 'Protocolo think-aloud', 'Grabación de pantalla', 'Análisis y recomendaciones'],
            duration: '1–4 semanas',
          },
        ].map(service => (
          <div class="p-8 md:p-12 border-b border-brand-black/10 last:border-0">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <div class="md:col-span-2">
                <div class="flex items-baseline gap-4 mb-4">
                  <span class="font-mono text-xs text-brand-black/60">{service.num}</span>
                  <h2 class="font-display text-3xl md:text-4xl font-bold">{service.title}</h2>
                </div>
                <p class="text-brand-black/60 leading-relaxed mb-6">{service.desc}</p>
                <ul class="space-y-1">
                  {service.details.map(d => (
                    <li class="font-mono text-xs text-brand-black/60 flex gap-2">
                      <span>→</span> {d}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="flex flex-col justify-between">
                <div>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">DURACIÓN DEL PROYECTO</p>
                  <p class="font-display text-lg font-semibold">{service.duration}</p>
                </div>
                <a href="/es/contacto" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors mt-6 text-center">
                  CONSULTAR →
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
