---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="es"
  title="Servicios"
  description="Auditoría UX de webs y e-commerce, eye tracking, investigación UX, pruebas de usuario y mediciones de campo con gafas móviles de eye-tracking. Recomendaciones respaldadas por datos, no por impresiones."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Header -->
      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ NUESTROS SERVICIOS ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter" style="font-size: clamp(3rem, 9vw, 8rem);">
          LO QUE<br/>HACEMOS<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Services list -->
      <div class="space-y-px border border-brand-black/10">
        {[
          // Orden: de la base rápida (auditoría) a la investigación más completa
          {
            num: '01',
            id: 'ux-audit',
            href: '/es/servicios/auditoria-ux',
            title: 'Auditoría UX',
            desc: 'La base rápida de toda mejora. Un análisis sistemático de su producto digital — recorremos la interfaz desde la perspectiva del usuario, identificamos barreras y proponemos mejoras concretas priorizadas según el impacto.',
            details: ['Análisis heurístico', 'Análisis de flujos de usuario', 'Lista de recomendaciones priorizadas', 'Taller con el equipo', 'Informe final con mockups'],
            duration: '2–4 semanas',
            pkg: 'Diagnóstico rápido',
          },
          {
            num: '02',
            id: 'testovani-uzivatelu',
            href: '/es/servicios/pruebas-de-usuario',
            title: 'Pruebas de usuario',
            desc: 'Pruebas moderadas y no moderadas con usuarios reales. Observamos cómo los usuarios completan tareas en su producto e identificamos dónde fallan.',
            details: ['Sesiones de prueba moderadas', 'Pruebas online no moderadas', 'Protocolo think-aloud', 'Grabación de pantalla', 'Análisis y recomendaciones'],
            duration: '1–4 semanas',
            pkg: 'Prueba UX estándar',
          },
          {
            num: '03',
            href: '/es/servicios/eye-tracking',
            title: 'Eye Tracking',
            desc: 'Datos precisos sobre la percepción visual de sus contenidos. Seguimos los movimientos oculares de los usuarios al interactuar con su web, aplicación o materiales impresos.',
            details: ['Heatmaps de atención', 'Análisis AOI (Areas of Interest)', 'Grabaciones de movimientos oculares', 'Análisis F-pattern y Z-pattern', 'Pruebas comparativas de variantes'],
            duration: '1–3 semanas',
            pkg: 'Prueba UX estándar',
          },
          {
            num: '04',
            id: 'terenni-mereni',
            href: '/es/servicios/investigacion-de-campo',
            title: 'Investigación de campo',
            desc: 'Medimos allí donde el cliente decide realmente — en la tienda, el showroom, un evento o junto a un producto físico. Las gafas móviles de eye-tracking capturan la atención en el entorno real, no solo en la pantalla. Un equipamiento que en la República Checa pocos tienen.',
            details: ['Gafas móviles de eye-tracking Pupil Labs NEON', 'Grabación en vídeo de la situación y el comportamiento en el espacio', 'GSR y entrevistas según las necesidades', 'Product placement, señalización, materiales POS', 'Recomendaciones para ajustar el espacio y el recorrido del cliente'],
            duration: '2–6 semanas',
            pkg: 'Estudio de campo',
          },
          {
            num: '05',
            href: '/es/servicios/investigacion-ux',
            title: 'Investigación UX',
            desc: 'El alcance más profundo: una combinación de métodos cualitativos y cuantitativos. Le ayudamos a entender las necesidades, frustraciones y modelos mentales de sus usuarios.',
            details: ['Entrevistas en profundidad', 'Investigación contextual', 'Pruebas de usabilidad', 'Análisis de datos', 'Personas y Journey maps'],
            duration: '3–8 semanas',
            pkg: 'Investigación biométrica integral',
          },
        ].map(service => (
          <div id={service.id} class="p-8 md:p-12 border-b border-brand-black/10 last:border-0 scroll-mt-28">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <div class="md:col-span-2">
                <div class="flex items-baseline gap-4 mb-4">
                  <span class="font-mono text-xs text-brand-black/60">{service.num}</span>
                  <h2 class="font-display text-3xl md:text-4xl font-bold">
                    <a href={service.href} class="hover:opacity-60 transition-opacity">{service.title}</a>
                  </h2>
                </div>
                <p class="text-brand-black/60 leading-relaxed mb-6">{service.desc}</p>
                <ul class="space-y-1">
                  {service.details.map(d => (
                    <li class="font-mono text-xs text-brand-black/60 flex gap-2">
                      <span>→</span> {d}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="flex flex-col justify-between">
                <div>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">DURACIÓN DEL PROYECTO</p>
                  <p class="font-display text-lg font-semibold">{service.duration}</p>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mt-4 mb-1">PAQUETE TÍPICO</p>
                  <a href="/es/servicios/paquetes-de-prueba" class="font-display text-lg font-semibold underline hover:no-underline">{service.pkg}</a>
                </div>
                <div class="flex flex-col gap-2 mt-6">
                  <a href={service.href} class="inline-block bg-brand-black text-brand-white border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors text-center">
                    DETALLE DEL SERVICIO →
                  </a>
                  <a href="/es/contacto" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors text-center">
                    CONSULTA SIN COMPROMISO
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Paquetes de prueba -->
      <div class="mt-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
          <div class="md:col-span-2">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ PAQUETES DE PRUEBA ]</p>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-4">Del diagnóstico rápido a la investigación biométrica integral</h2>
            <p class="text-brand-white/70 leading-relaxed max-w-2xl">
              Componemos los servicios en paquetes de prueba según la decisión que necesita tomar — eye-tracking, datos conductuales, cuestionarios, GSR y mediciones de campo. Sabe de antemano qué obtendrá de las pruebas y qué no podrá afirmarse con fiabilidad con ese alcance.
            </p>
          </div>
          <div class="flex md:justify-end">
            <a href="/es/servicios/paquetes-de-prueba" class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              VER LOS PAQUETES →
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
