---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const partners = [
  {
    num: '01',
    name: 'Univerzita Hradec Králové',
    claim: 'Base de investigación y metodología.',
    logo: `${base}/logos/uhk.svg`,
    logoAlt: 'Logo de Univerzita Hradec Králové',
    logoClass: 'h-16 md:h-20',
    text: [
      'En el laboratorio de estudios cognitivos de FIM UHK probamos interfaces digitales y físicas tanto en condiciones controladas como en campo. Esta base nos permite preparar la metodología, validar el guion y combinar el eye tracking con otros métodos de investigación.',
      'El entorno de investigación incluye también publicaciones académicas, trabajos de estudiantes y el desarrollo de métodos propios, entre ellos el índice de carga mental EMLI.',
    ],
    tags: ['FIM UHK', 'Laboratorio', 'EMLI'],
    links: [
      { label: 'UHK.CZ →', href: 'https://www.uhk.cz' },
      { label: 'FACULTAD DE INFORMÁTICA Y GESTIÓN', href: 'https://www.uhk.cz/cs/fakulta-informatiky-a-managementu' },
    ],
  },
  {
    num: '02',
    name: 'MindSense',
    claim: 'Tecnología y apoyo especializado.',
    logo: `${base}/logos/mindsense.webp`,
    logoAlt: 'Logo de MindSense — soluciones para laboratorios de investigación',
    logoClass: 'h-10 md:h-12',
    text: [
      'MindSense participó en la ampliación del laboratorio con nuevo equipamiento de investigación y ofrece apoyo especializado para las tecnologías utilizadas. Es distribuidor autorizado exclusivo de Tobii para la República Checa y Eslovaquia.',
      'Ayuda a integrar el eye tracking, los biosensores, la realidad virtual y el software para que las distintas fuentes de datos funcionen como un único conjunto de investigación.',
    ],
    tags: ['Tobii', 'Biosensores', 'VR'],
    links: [
      { label: 'MINDSENSE.CZ →', href: 'https://mindsense.cz' },
    ],
  },
];

const pageSchema = [
  {
    '@type': 'WebPage',
    name: 'Socios de UX MIND',
    description: 'Socios de UX MIND: Univerzita Hradec Králové aporta la base de investigación y MindSense el apoyo tecnológico y especializado.',
  },
];
---

<BaseLayout
  lang="es"
  title="Socios del proyecto"
  description="Socios de UX MIND: Univerzita Hradec Králové aporta la base de investigación y MindSense el apoyo tecnológico y especializado."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SOCIOS ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          NO MEDIMOS<br/>SOLOS<span style="color:#2D62FC">.</span>
        </h1>
        <p class="text-lg text-brand-black/60 leading-relaxed max-w-3xl text-justify">
          Una investigación de calidad no se basa solo en la tecnología. Necesita una metodología correcta, equipamiento fiable y personas capaces de interpretar los datos. Por eso UX MIND combina <strong class="text-brand-black">la base de investigación de FIM UHK con el know-how tecnológico de MindSense</strong>.
        </p>
      </div>

      <!-- Socios -->
      <div class="space-y-px border border-brand-black/10">
        {partners.map(p => (
          <div class="reveal p-8 md:p-12 border-b border-brand-black/10 last:border-0">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-10 items-start">
              <!-- Logo -->
              <div class="flex flex-col gap-6">
                <span class="font-mono text-xs text-brand-black/60">{p.num}</span>
                <img src={p.logo} alt={p.logoAlt} class={`${p.logoClass} w-auto object-contain self-start`} loading="lazy" decoding="async" />
                <div class="flex flex-wrap gap-2">
                  {p.tags.map(tag => (
                    <span class="font-mono text-[11px] border border-brand-black/20 px-2 py-1 tracking-widest">{tag}</span>
                  ))}
                </div>
              </div>
              <!-- Texto -->
              <div class="md:col-span-2">
                <h2 class="font-display text-3xl md:text-4xl font-bold mb-2">{p.name}</h2>
                <p class="font-mono text-xs text-brand-black/60 tracking-widest uppercase mb-6">{p.claim}</p>
                {p.text.map(t => (
                  <p class="text-brand-black/60 leading-relaxed mb-4 max-w-2xl text-justify">{t}</p>
                ))}
                <div class="flex flex-wrap gap-4 mt-6">
                  {p.links.map(l => (
                    <a href={l.href} target="_blank" rel="noopener noreferrer" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                      {l.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Cómo encaja la colaboración en la medición -->
      <div class="reveal mt-24 grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          { t: 'Base de investigación', d: 'El laboratorio FIM UHK ofrece las condiciones para preparar, pilotar y realizar los estudios.', tag: 'UHK' },
          { t: 'Apoyo tecnológico', d: 'MindSense ayuda con el equipamiento, su integración y el apoyo especializado.', tag: 'MINDSENSE' },
          { t: 'Resultado para el cliente', d: 'UX MIND convierte los datos medidos en conclusiones claras y recomendaciones concretas.', tag: 'UX MIND' },
        ].map((v, i) => (
          <div class="bg-brand-white p-8 flex flex-col h-full">
            <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
            <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
            <p class="text-sm text-brand-black/60 leading-relaxed mb-6 text-justify">{v.d}</p>
            <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest self-start mt-auto">{v.tag}</span>
          </div>
        ))}
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
</content>
