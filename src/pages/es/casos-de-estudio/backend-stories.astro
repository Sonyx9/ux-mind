---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const fakta = [["MÉTODO", "Eye-tracking, análisis AOI"], ["MUESTRA", "aprox. 120 participantes"], ["ESCENARIOS", "Varios escenarios con tareas"], ["RESULTADOS", "Estadísticas AOI, gradiente de lectura"]];
const zjisteni = ["El CTA «Leer online» lo registró aproximadamente el 92 % de los participantes.", "La atención disminuía progresivamente: el titular destacado lo registró aproximadamente el 86 % de los participantes, el texto breve siguiente el 62 % y el párrafo largo el 33 %.", "Aproximadamente el 75 % de los participantes registró la parte inferior de la página incluso antes de rellenar el formulario."];
const faq = [
  { q: "¿Qué significa el gradiente de atención?", a: "La proporción de participantes que registró cada elemento fue disminuyendo progresivamente: el titular destacado aproximadamente el 86 %, el texto breve el 62 % y el párrafo largo el 33 %. El resultado describe esta página concreta y los escenarios probados." },
  { q: "¿Cuántos participantes registraron el CTA principal?", a: "El CTA «Leer online» lo registró aproximadamente el 92 % de los cerca de 120 participantes. De todos los elementos observados, fue el que obtuvo mayor alcance." },
  { q: "¿Una fijación significa que la persona leyó el texto?", a: "No. La fijación demuestra que la mirada se dirigió a esa zona, no que se leyera por completo ni que se comprendiera. Por eso formulamos el resultado como «registro del elemento» y lo interpretamos en el contexto de la tarea." },
  { q: "¿Qué implica esto para la creación de contenido?", a: "En la página probada, un CTA claro, un titular destacado y un texto breve de continuación ayudaron a concentrar la atención. En otra web, este mismo principio debe verificarse en su propio contenido y contexto." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "Cuanto más largo el texto, menos atención",
    about: 'Eye tracking, investigación UX',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'es',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="es"
  title="Caso de estudio: cómo la longitud del texto afectó la atención"
  description="Análisis AOI de eye tracking de una microsite educativa: el CTA lo registró el 92 % de los participantes, el titular destacado el 86 %, el texto breve el 62 % y el párrafo largo el 33 %."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/es/casos-de-estudio" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← TODOS LOS CASOS</a>

      <!-- Cabecera del estudio -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Microsite educativo</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          Cuanto más largo el texto, menos atención<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Resultados principales -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-2 lg:grid-cols-4">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        {[
          ['92 %', 'CTA'],
          ['86 %', 'título destacado'],
          ['62 %', 'texto breve'],
          ['33 %', 'párrafo largo'],
        ].map(([value, label], i) => (
          <div class:list={["relative p-6 md:p-8 border-brand-white/15", i === 0 && "border-t-4 border-t-brand-blue", i < 2 && "border-b lg:border-b-0", i % 2 === 0 && "border-r", i === 1 && "lg:border-r", i === 2 && "lg:border-r"]}>
            <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.5rem, 5vw, 4.5rem);">{value}</p>
            <p class="text-brand-white/70 text-sm md:text-base leading-relaxed">de los participantes registró {label}</p>
          </div>
        ))}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Contenido -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— LO QUE MOSTRARON LOS DATOS</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— QUÉ HABÍA QUE DESCUBRIR</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">¿Qué elementos registra el visitante y dónde empieza a caer la atención?</p>
            <p class="text-brand-black/70 leading-relaxed">La microsite educativa combinaba contenido especializado con la llamada a la acción principal. El objetivo era comprobar qué atención recibía cada capa de la página — el CTA, los titulares, los textos breves y los párrafos más largos.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— CÓMO SE REALIZÓ LA MEDICIÓN</span></p>
            <p class="text-brand-black/70 leading-relaxed">Aproximadamente 120 participantes completaron varios escenarios con tareas. El eye tracking registró su atención visual y el análisis AOI calculó la proporción de participantes que fijaron los elementos marcados de antemano en la página.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ DATOS EN IMAGEN ]</p>
              <svg viewBox="0 0 640 278" class="w-full" role="img" aria-label="El CTA lo registró el 92 por ciento, el titular el 86, el texto breve el 62 y el párrafo largo el 33 por ciento de los participantes"><text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">GRADIENTE DE LECTURA · PROPORCIÓN DE PARTICIPANTES QUE REGISTRARON EL ELEMENTO</text><text x="0" y="67" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">CTA «LEER ONLINE»</text><rect x="190" y="52" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="52" width="368" height="22" fill="#2D62FC" class="viz-bar"/><text x="558" y="67" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">92 %</text><text x="0" y="119" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">TITULAR EN NEGRITA</text><rect x="190" y="104" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="104" width="344" height="22" fill="#0A0A0A" class="viz-bar"/><text x="534" y="119" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">86 %</text><text x="0" y="171" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">TEXTO BREVE</text><rect x="190" y="156" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="156" width="248" height="22" fill="#0A0A0A" class="viz-bar"/><text x="438" y="171" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">62 %</text><text x="0" y="223" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">PÁRRAFO LARGO</text><rect x="190" y="208" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="208" width="132" height="22" fill="#0A0A0A" class="viz-bar"/><text x="322" y="223" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">33 %</text></svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">La proporción de participantes que registró el elemento disminuía desde el CTA principal, pasando por el titular y el texto breve, hasta el párrafo largo.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— QUÉ SE DECIDIÓ</span></p>
            <p class="text-brand-black/70 leading-relaxed">Los resultados respaldaron separar claramente el CTA principal, acortar los bloques largos de texto y trabajar de forma más rigurosa con la jerarquía de la información. El equipo obtuvo datos concretos para decidir qué partes del contenido destacar, acortar o reorganizar.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ QUÉ APRENDER DE ESTO ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">Que la información esté en la página no significa que se haya registrado<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">El eye tracking muestra si la jerarquía de la información realmente dirige la atención hacia lo que el visitante debe ver y usar.</p>
            <a href="/es/contacto" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">HABLAR DE SU PROPIO ESTUDIO →</a>
          </section>
        </div>

        <!-- Datos + foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">ESTUDIO REALIZADO EN COLABORACIÓN CON</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Facultad de Informática y Gestión"
                title="El estudio se realizó en colaboración con FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">DATOS DE LA MEDICIÓN</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/jan-petruzalek-analyza-eye-tracking-dat.webp`}
                alt="Un investigador analiza datos AOI — mapas de calor de atención de cada elemento de la página en el monitor"
                width="1080" height="720" loading="lazy" decoding="async"
                class="w-full h-52 object-cover border border-brand-black/10"
              />
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Análisis AOI: cada elemento de la página tiene sus propias métricas de atención</figcaption>
            </figure>
            <a href="/es/contacto" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              SOLICITUD SIN COMPROMISO →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ GLOSARIO — QUÉ SIGNIFICAN LOS TÉRMINOS DE ESTE ESTUDIO ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">Fijación</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Breve detención del ojo en una zona determinada. Documenta la atención visual, no la lectura completa ni la comprensión.</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI (área de interés)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Parte de la página marcada de antemano, por ejemplo el CTA, un titular o un bloque de texto, para la que calculamos métricas.</dd></div>
            <div><dt class="font-display font-bold mb-1">Alcance del elemento</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Proporción de participantes que, durante el escenario, fijaron al menos una vez esa zona.</dd></div>
            <div><dt class="font-display font-bold mb-1">Gradiente de atención</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Descenso progresivo de la proporción de participantes que registraron cada capa del contenido.</dd></div>
          </dl>
        </details>
      </section>

      <!-- FAQ del estudio -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ PREGUNTAS FRECUENTES SOBRE EL ESTUDIO ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Franja estrecha: estudio completo (abre modal) -->
      <section class="reveal mt-16 !hidden bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">¿Quiere revisar el estudio en detalle<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">INFORME DETALLADO CON METODOLOGÍA Y RECOMENDACIONES — GRATIS EN PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          SOLICITAR EL ESTUDIO →
        </button>
      </section>

      <!-- Navegación entre estudios -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Otros casos de estudio">
        <a href="/es/casos-de-estudio/karierni-portal-automotive" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← ESTUDIO ANTERIOR</p>
          <p class="font-display font-bold leading-snug">El 40 % de los candidatos no encontró el camino a las vacantes</p>
        </a>
        <a href="/es/casos-de-estudio/produktove-fotografie-e-commerce" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">ESTUDIO SIGUIENTE →</p>
          <p class="font-display font-bold leading-snug">Mismo producto. Decisiones de distinta duración</p>
        </a>
      </nav>

    </div>

      <!-- Modal: solicitud de estudio completo -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ ESTUDIO DETALLADO ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Cerrar ventana">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">¿Quiere revisar el estudio en detalle<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Los estudios están resumidos y anonimizados.</p>
          <form class="study-request space-y-4" data-pdf="https://lukaskoula.com" data-study="Cuanto más largo el texto, menos atención">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">NOMBRE *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Su nombre"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">EMPRESA</label>
              <input type="text" id="sr-company" name="company" placeholder="Nombre de la empresa (opcional)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="su@email.com"
                class="study-input" />
            </div>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              VER EL ESTUDIO (PDF) →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/50 p-3">¡Gracias! Si el estudio no se abrió automáticamente, <a href="#" class="study-pdf-link underline hover:text-brand-white/70" target="_blank" rel="noopener">ábralo con este enlace</a>.</p>
            <p class="font-mono text-[11px] text-brand-white/70 leading-relaxed">Al enviar, acepta la visualización del estudio y el envío de ofertas comerciales ocasionales de UX MIND. Puede darse de baja en cualquier momento con un solo clic.</p>
          </form>
        </div>
      </dialog>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../../../scripts/case-study';
</script>
</content>
