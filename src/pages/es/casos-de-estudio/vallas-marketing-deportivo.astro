---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const fakta = [["MÉTODO", "Eye tracking + cuestionario de valoración + TOP3"], ["MUESTRA", "79 participantes · 43 hombres, 36 mujeres · 17–25 años"], ["ESTÍMULOS", "16 diseños · cada uno mostrado 10 segundos"], ["RESULTADOS", "Ranking de variantes + métricas de atención visual"]];
const zjisteni = ["Los seis diseños mejor valorados tenían fondo negro. Las variantes blancas se concentraron en la parte baja del ranking.", "El diseño ganador obtuvo la puntuación ponderada más alta en la selección TOP3 y también la mejor posición media.", "Las métricas de fijación apenas se diferenciaron entre las variantes mejor y peor valoradas. Por eso, el ranking no lo decidió únicamente el nivel de atención visual.", "En el cuestionario, el 39 % de las mujeres y el 16 % de los hombres declararon que la publicidad visual influye en su asistencia al evento deportivo. Se trata de una influencia declarada, no de un cambio medido en el comportamiento de compra."];
const faq = [
  { q: "¿Significa el resultado que una valla negra siempre funciona mejor?", a: "No. El fondo negro dominó en este conjunto de 16 diseños para una campaña de fútbol y un público objetivo concretos. El resultado no puede trasladarse sin más a cualquier marca, mensaje o ubicación." },
  { q: "¿Qué decidió exactamente la variante ganadora?", a: "El diseño ganador obtuvo la mejor puntuación ponderada en la selección TOP3 y también la mejor posición media. El eye tracking ayudó a describir la atención visual, pero las métricas de fijación por sí solas no explicaron el ranking de las variantes." },
  { q: "¿El 39 % frente al 16 % demuestra que la publicidad influye más en las mujeres?", a: "Los participantes lo indicaron en el cuestionario, por lo que se trata de una influencia declarada. El estudio no demuestra con ello que la valla realmente cambiara la compra de entradas ni que el género fuera la causa de la diferencia." },
  { q: "¿Por qué combinar el eye tracking con un cuestionario?", a: "El eye tracking muestra hacia dónde se dirigió la atención visual. El cuestionario recoge la preferencia, la claridad y la intención. En este estudio, precisamente su combinación mostró que más atención no significa automáticamente una mejor valoración." },
  { q: "¿Se puede elegir así una creatividad antes de lanzar la campaña?", a: "Sí. Se pueden comparar varias variantes finales con el público objetivo antes de la producción y la difusión en medios. Es importante determinar de antemano según qué objetivo se elegirá al ganador." },
  { q: "¿Un estudio así también mide la venta de entradas?", a: "No de forma automática. Un estudio de laboratorio ayuda a elegir y explicar la creatividad. El impacto real en la asistencia o en las ventas debe verificarse con datos posteriores de la campaña o con un experimento de campo." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "Los seis primeros puestos fueron para las vallas negras.",
    about: 'Eye tracking, investigación UX',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'es',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="es"
  title="Caso de estudio: selección de una valla mediante eye tracking"
  description="Eye tracking y valoración de 16 diseños de vallas con 79 participantes: los seis primeros puestos los ocuparon las variantes negras, aunque las métricas de fijación por sí solas no determinaron el ganador."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/es/casos-de-estudio" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← TODOS LOS CASOS</a>

      <!-- Cabecera del estudio -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Marketing deportivo · publicidad exterior</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          Los seis primeros puestos fueron para las vallas negras<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Diseño del estudio -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-1 md:grid-cols-3">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative p-7 md:p-9 border-t-4 border-t-brand-blue border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">6/6</p>
          <p class="text-brand-white/70 leading-relaxed">de las variantes mejor valoradas tenían fondo negro</p>
        </div>
        <div class="relative p-7 md:p-9 border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">16</p>
          <p class="text-brand-white/70 leading-relaxed">diseños de valla comparados</p>
        </div>
        <div class="relative p-7 md:p-9">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">79</p>
          <p class="text-brand-white/70 leading-relaxed">participantes del grupo de edad objetivo</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Contenido -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— LO QUE MOSTRARON LOS DATOS</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— QUÉ HABÍA QUE DECIDIR</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">¿Cuál de los 16 diseños debe usarse en la campaña para impulsar la asistencia al estadio?</p>
            <p class="text-brand-black/70 leading-relaxed">El club de fútbol no quería elegir solo según la opinión del equipo de marketing. Por eso comparó las variantes con jóvenes del público objetivo y observó tanto su atención como su valoración posterior.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— CÓMO SE REALIZÓ LA MEDICIÓN</span></p>
            <p class="text-brand-black/70 leading-relaxed">Cada uno de los 79 participantes vio los 16 diseños durante 10 segundos. El eye tracking registró la atención visual. Un cuestionario de valoración y la selección de las TOP3 variantes complementaron la valoración global, la claridad y la intención declarada de asistir al partido.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">04</span> <span class="text-brand-black/60">— CÓMO INTERPRETAR EL RESULTADO</span></p>
            <p class="text-brand-black/70 leading-relaxed">El estudio eligió un ganador entre diseños concretos. No demuestra que el fondo negro aumente en general el rendimiento de cualquier valla. De igual modo, el dato del cuestionario 39 % frente a 16 % describe lo que declararon los participantes, no un cambio real en la venta de entradas.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ DATOS EN IMAGEN ]</p>
              <svg viewBox="0 0 640 174" class="w-full" role="img" aria-label="En el cuestionario, el 39 por ciento de las mujeres y el 16 por ciento de los hombres declararon que la publicidad visual influye en su asistencia al evento deportivo"><text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">INFLUENCIA DECLARADA DE LA PUBLICIDAD VISUAL · CUESTIONARIO · N = 79</text><text x="0" y="67" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">MUJERES</text><rect x="190" y="52" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="52" width="156" height="22" fill="#2D62FC" class="viz-bar"/><text x="346" y="67" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">39 %</text><text x="0" y="119" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">HOMBRES</text><rect x="190" y="104" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="104" width="64" height="22" fill="#0A0A0A" class="viz-bar"/><text x="254" y="119" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">16 %</text></svg>
<svg viewBox="0 0 640 120" class="w-full mt-2" role="img" aria-label="Los seis diseños mejor valorados tenían fondo negro; el grupo inferior lo formaban las variantes blancas">
  <text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">VALORACIÓN DE 16 DISEÑOS · TOP 6 vs GRUPO INFERIOR</text>
  <g>
    <rect x="0" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="48" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="96" y="36" width="40" height="26" fill="#0A0A0A"/>
    <rect x="144" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="192" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="240" y="36" width="40" height="26" fill="#0A0A0A"/>
    <text x="292" y="54" font-family="monospace" font-size="11" fill="#0A0A0A">TOP 6 = FONDO NEGRO</text>
  </g>
  <g stroke="rgba(10,10,10,0.4)" fill="none">
    <rect x="0" y="76" width="40" height="26"/><rect x="48" y="76" width="40" height="26"/><rect x="96" y="76" width="40" height="26"/><rect x="144" y="76" width="40" height="26"/>
    <text x="196" y="94" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)" stroke="none">GRUPO INFERIOR = VARIANTES BLANCAS</text>
  </g>
</svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">El gráfico combina el ranking de las variantes probadas con las respuestas del cuestionario. El dato 39 % frente a 16 % no representa un impacto medido de la campaña en la venta de entradas.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— RECOMENDACIÓN PARA LA CAMPAÑA</span></p>
            <p class="text-brand-black/70 leading-relaxed">Para seguir desarrollándolo, elegir la variante negra ganadora y mantener su jerarquía clara, su titular destacado y un único objetivo principal. Evaluar después el impacto real de la creatividad con los datos de la campaña ya en marcha.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ QUÉ APRENDER DE ESTO ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">La atención y la preferencia no son lo mismo<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">El eye tracking muestra qué ven las personas. La valoración de las variantes añade qué creatividad prefieren. Para elegir la campaña es necesario leer ambos resultados juntos.</p>
            <a href="/es/contacto" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">HABLAR DE UN TEST DE CREATIVIDAD →</a>
          </section>
        </div>

        <!-- Datos + foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">ESTUDIO REALIZADO EN COLABORACIÓN CON</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Facultad de Informática y Gestión"
                title="El estudio se realizó en colaboración con FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">DATOS DE LA MEDICIÓN</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <div class="border border-brand-black/10 p-4 bg-brand-white">
                <svg viewBox="0 0 320 210" class="w-full" role="img" aria-label="Esquema ilustrativo del principio de las vallas mejor valoradas: fondo negro con un titular destacado">
                  <rect x="24" y="16" width="272" height="120" fill="#0A0A0A"/>
                  <rect x="48" y="44" width="130" height="14" fill="#FCFCFC"/>
                  <rect x="48" y="68" width="90" height="8" fill="rgba(252,252,252,0.5)"/>
                  <rect x="48" y="100" width="64" height="16" fill="#2D62FC"/>
                  <circle cx="248" cy="76" r="26" fill="none" stroke="rgba(252,252,252,0.6)" stroke-width="2"/>
                  <rect x="96" y="136" width="10" height="52" fill="#0A0A0A"/>
                  <rect x="214" y="136" width="10" height="52" fill="#0A0A0A"/>
                  <text x="24" y="204" font-family="monospace" font-size="11" fill="#0A0A0A">TOP 6: FONDO NEGRO · TITULAR DESTACADO</text>
                </svg>
              </div>
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Esquema ilustrativo del principio común de las seis variantes mejor valoradas</figcaption>
            </figure>
            <a href="/es/contacto" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              SOLICITUD SIN COMPROMISO →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ GLOSARIO — CÓMO INTERPRETAR LOS RESULTADOS DEL ESTUDIO ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">N (muestra)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Número de personas incluidas en el estudio. En este caso, N = 79.</dd></div>
            <div><dt class="font-display font-bold mb-1">TOP3</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Selección de las tres variantes preferidas. El orden y la frecuencia de las elecciones pueden convertirse en una puntuación ponderada.</dd></div>
            <div><dt class="font-display font-bold mb-1">Fijación</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Breve detención del ojo en una zona determinada. Describe la atención visual, no necesariamente la comprensión, la preferencia o la compra.</dd></div>
            <div><dt class="font-display font-bold mb-1">Influencia declarada</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Lo que el participante indicó en el cuestionario. No es un cambio medido directamente en su comportamiento real.</dd></div>
          </dl>
        </details>
      </section>

      <!-- FAQ del estudio -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ PREGUNTAS FRECUENTES SOBRE EL ESTUDIO ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Franja estrecha: estudio completo (abre modal) -->
      <section class="reveal mt-16 !hidden bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">¿Quiere revisar el estudio en detalle<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">INFORME DETALLADO CON METODOLOGÍA Y RECOMENDACIONES — GRATIS EN PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          SOLICITAR EL ESTUDIO →
        </button>
      </section>

      <!-- Navegación entre estudios -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Otros casos de estudio">
        <a href="/es/casos-de-estudio/plantillas-tienda-online" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← ESTUDIO ANTERIOR</p>
          <p class="font-display font-bold leading-snug">La tarea cambió hacia dónde dirigían la atención.</p>
        </a>
        <a href="/es/casos-de-estudio/portal-empleo-automocion" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">ESTUDIO SIGUIENTE →</p>
          <p class="font-display font-bold leading-snug">El 40 % de los candidatos no encontró el camino a las vacantes</p>
        </a>
      </nav>

    </div>

      <!-- Modal: solicitud de estudio completo -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ ESTUDIO DETALLADO ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Cerrar ventana">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">¿Quiere revisar el estudio en detalle<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Los estudios están resumidos y anonimizados.</p>
          <form class="study-request space-y-4" data-pdf="https://lukaskoula.com" data-study="Los seis primeros puestos fueron para las vallas negras.">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">NOMBRE *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Su nombre"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">EMPRESA</label>
              <input type="text" id="sr-company" name="company" placeholder="Nombre de la empresa (opcional)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="su@email.com"
                class="study-input" />
            </div>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              VER EL ESTUDIO (PDF) →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/50 p-3">¡Gracias! Si el estudio no se abrió automáticamente, <a href="#" class="study-pdf-link underline hover:text-brand-white/70" target="_blank" rel="noopener">ábralo con este enlace</a>.</p>
            <p class="font-mono text-[11px] text-brand-white/70 leading-relaxed">Al enviar, acepta la visualización del estudio y el envío de ofertas comerciales ocasionales de UX MIND. Puede darse de baja en cualquier momento con un solo clic.</p>
          </form>
        </div>
      </dialog>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../../../scripts/case-study';
</script>
</content>
