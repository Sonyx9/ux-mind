---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const fakta = [["MÉTODO", "Experimento · eye tracking + UEQ"], ["MUESTRA", "84 participantes"], ["VARIANTES", "Packshot vs. fotografía lifestyle"], ["ESTADÍSTICA", "F(1,82) = 4,50 · p = 0,037"]];
const zjisteni = ["El tipo de fotografía influyó de forma estadísticamente significativa en el tiempo de finalización de la tarea: F(1,82) = 4,50; p = 0,037.", "Con la variante del producto «sobre una persona», completar la tarea probada llevó más tiempo que con el packshot limpio.", "El estudio no aportó pruebas claras de que las variantes también difirieran en la valoración subjetiva de la experiencia de usuario."];
const faq = [
  { q: "¿Es mejor el packshot o la fotografía lifestyle?", a: "A partir de un solo estudio no se puede determinar un tipo de fotografía universalmente mejor. En la tarea probada, la variante lifestyle llevó a un tiempo más largo que el packshot. La elección debe relacionarse con el producto concreto, la página y el objetivo del usuario." },
  { q: "¿Qué significa p = 0,037?", a: "Si en realidad no hubiera diferencia entre las variantes y se cumplieran los supuestos de la prueba utilizada, un resultado igual o más pronunciado aparecería en aproximadamente el 3,7 % de las repeticiones. El valor p por sí solo no indica cuán grande es el impacto práctico o comercial." },
  { q: "¿Influyó el tipo de fotografía también en la valoración de la página?", a: "El estudio no aportó pruebas claras de una diferencia en la valoración subjetiva de la experiencia de usuario. Por eso, el tiempo más largo no puede explicarse automáticamente porque una variante gustara más o menos." },
  { q: "¿Un tiempo más largo significa una conversión menor?", a: "No. El estudio midió el tiempo de finalización de una tarea concreta, no el impacto en la conversión real o en las ventas. Para esa conclusión sería necesario combinar la investigación con otros datos o con un experimento posterior." },
  { q: "¿Para qué sirvió el eye tracking en el estudio?", a: "El eye tracking complementó el desarrollo de la tarea con datos de atención visual. Sin embargo, la principal diferencia descrita entre las variantes se refiere al tiempo de finalización de la tarea, por lo que no la atribuimos automáticamente a un patrón de mirada concreto sin un análisis adicional." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "Mismo producto. Decisiones de distinta duración.",
    about: 'Eye tracking, investigación UX',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'es',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="es"
  title="Caso de estudio: packshot vs. fotografía lifestyle"
  description="Experimento con 84 participantes: la fotografía lifestyle llevó, en la tarea de e-commerce probada, a un tiempo más largo que el packshot limpio, F(1,82) = 4,50; p = 0,037."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/es/casos-de-estudio" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← TODOS LOS CASOS</a>

      <!-- Cabecera del estudio -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">E-commerce</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          Mismo producto. Decisiones de distinta duración<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Resultados principales -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-1 md:grid-cols-3">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative p-7 md:p-9 border-t-4 border-t-brand-blue border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-mono text-xs tracking-widest text-brand-white/60 mb-5">VARIANTE LIFESTYLE</p>
          <p class="font-display text-2xl md:text-3xl font-bold leading-tight">Tiempo de tarea más largo</p>
        </div>
        <div class="relative p-7 md:p-9 border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">84</p>
          <p class="text-brand-white/70 leading-relaxed">participantes compararon dos variantes</p>
        </div>
        <div class="relative p-7 md:p-9">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.2rem, 4.5vw, 4rem);">p = 0,037</p>
          <p class="text-brand-white/70 leading-relaxed">diferencia estadísticamente significativa en el tiempo de la tarea</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Contenido -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— LO QUE MOSTRARON LOS DATOS</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— QUÉ HABÍA QUE DESCUBRIR</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">¿Influye la forma de presentar el producto en el desarrollo de la tarea de compra?</p>
            <p class="text-brand-black/70 leading-relaxed">El estudio comparó un packshot limpio con una fotografía del producto «sobre una persona». El objetivo no era elegir la imagen más atractiva, sino comprobar si el tipo de fotografía cambia el tiempo necesario para completar la misma tarea.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— CÓMO SE REALIZÓ LA MEDICIÓN</span></p>
            <p class="text-brand-black/70 leading-relaxed">En el experimento controlado participaron 84 personas. Completaron tareas de e-commerce sobre las variantes de presentación del producto; el desarrollo se complementó con datos de eye tracking y el cuestionario estandarizado UEQ para la valoración subjetiva de la experiencia de usuario.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ QUÉ DICE EL ESTUDIO — Y QUÉ NO ]</p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
                <div class="bg-brand-white p-6">
                  <p class="font-mono text-xs tracking-widest mb-4" style="color:#2D62FC">RESPALDADO POR LOS DATOS</p>
                  <p class="text-brand-black/70 leading-relaxed">En la tarea probada, la fotografía lifestyle llevó a un tiempo más largo que el packshot limpio. La diferencia fue estadísticamente significativa.</p>
                </div>
                <div class="bg-brand-white p-6">
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">NO PUEDE CONCLUIRSE</p>
                  <p class="text-brand-black/70 leading-relaxed">Que la fotografía lifestyle reduce la conversión en general, que siempre es peor, o que los usuarios la valoraron mejor o peor.</p>
                </div>
              </div>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">El resultado se refiere a las variantes concretas, la muestra y la tarea de e-commerce probada.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— RECOMENDACIÓN PARA LA PRÁCTICA</span></p>
            <p class="text-brand-black/70 leading-relaxed">No elegir la fotografía de producto solo por impresión. Verificarla con la tarea concreta que la página debe respaldar, y valorar el tiempo o el proceso de decisión junto con el comportamiento, la atención y los datos de negocio.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ QUÉ APRENDER DE ESTO ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">El mismo producto puede cambiar la forma de decidir según cómo lo muestre<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">Probar variantes ayuda a elegir la fotografía según la tarea del cliente, no según la preferencia del equipo.</p>
            <a href="/es/contacto" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">HABLAR DE SU PROPIO ESTUDIO →</a>
          </section>
        </div>

        <!-- Datos + foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">ESTUDIO REALIZADO EN COLABORACIÓN CON</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Facultad de Informática y Gestión"
                title="El estudio se realizó en colaboración con FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">DATOS DE LA MEDICIÓN</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <div class="border border-brand-black/10 p-4 bg-brand-white">
                <svg viewBox="0 0 320 210" class="w-full" role="img" aria-label="Esquema de dos variantes de la página de producto: packshot y fotografía lifestyle">
                  <rect x="4" y="4" width="150" height="170" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="24" y="24" width="110" height="90" fill="rgba(10,10,10,0.06)"/>
                  <rect x="62" y="40" width="34" height="58" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="70" y="32" width="18" height="10" fill="#0A0A0A"/>
                  <rect x="24" y="126" width="70" height="7" fill="rgba(10,10,10,0.35)"/>
                  <rect x="24" y="140" width="46" height="7" fill="#2D62FC"/>
                  <text x="4" y="196" font-family="monospace" font-size="11" fill="#0A0A0A">PACKSHOT</text>
                  <rect x="166" y="4" width="150" height="170" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="186" y="24" width="110" height="90" fill="rgba(10,10,10,0.06)"/>
                  <circle cx="222" cy="52" r="14" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <path d="M 200 114 Q 222 76 244 114" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="256" y="62" width="20" height="36" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="186" y="126" width="70" height="7" fill="rgba(10,10,10,0.35)"/>
                  <rect x="186" y="140" width="46" height="7" fill="rgba(10,10,10,0.2)"/>
                  <text x="166" y="196" font-family="monospace" font-size="11" fill="#0A0A0A">LIFESTYLE</text>
                </svg>
              </div>
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Esquema de las variantes evaluadas: packshot limpio vs. producto «sobre una persona»</figcaption>
            </figure>
            <a href="/es/contacto" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              SOLICITUD SIN COMPROMISO →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ GLOSARIO — QUÉ SIGNIFICAN LOS TÉRMINOS DE ESTE ESTUDIO ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">N (muestra)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Número de personas incluidas en el análisis. En este estudio, N = 84.</dd></div>
            <div><dt class="font-display font-bold mb-1">F(1,82)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Valor del estadístico de la prueba y sus grados de libertad en el test estadístico utilizado.</dd></div>
            <div><dt class="font-display font-bold mb-1">Valor p</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Ayuda a valorar hasta qué punto los datos son compatibles con la suposición de que no hay diferencia entre las variantes. Por sí solo no describe el tamaño del impacto.</dd></div>
            <div><dt class="font-display font-bold mb-1">UEQ</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Cuestionario estandarizado para la valoración subjetiva de la experiencia de usuario.</dd></div>
          </dl>
        </details>
      </section>

      <!-- FAQ del estudio -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ PREGUNTAS FRECUENTES SOBRE EL ESTUDIO ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Franja estrecha: estudio completo (abre modal) -->
      <section class="reveal mt-16 !hidden bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">¿Quiere revisar el estudio en detalle<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">INFORME DETALLADO CON METODOLOGÍA Y RECOMENDACIONES — GRATIS EN PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          SOLICITAR EL ESTUDIO →
        </button>
      </section>

      <!-- Navegación entre estudios -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Otros casos de estudio">
        <a href="/es/casos-de-estudio/backend-stories" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← ESTUDIO ANTERIOR</p>
          <p class="font-display font-bold leading-snug">Cuanto más largo el texto, menos atención</p>
        </a>
        <a href="/es/casos-de-estudio/reklamni-bannery-smer-pohledu" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">ESTUDIO SIGUIENTE →</p>
          <p class="font-display font-bold leading-snug">La mirada del personaje dirigió la atención de los visitantes</p>
        </a>
      </nav>

    </div>

      <!-- Modal: solicitud de estudio completo -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ ESTUDIO DETALLADO ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Cerrar ventana">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">¿Quiere revisar el estudio en detalle<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Los estudios están resumidos y anonimizados.</p>
          <form class="study-request space-y-4" data-pdf="https://lukaskoula.com" data-study="Mismo producto. Decisiones de distinta duración.">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">NOMBRE *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Su nombre"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">EMPRESA</label>
              <input type="text" id="sr-company" name="company" placeholder="Nombre de la empresa (opcional)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="su@email.com"
                class="study-input" />
            </div>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              VER EL ESTUDIO (PDF) →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/50 p-3">¡Gracias! Si el estudio no se abrió automáticamente, <a href="#" class="study-pdf-link underline hover:text-brand-white/70" target="_blank" rel="noopener">ábralo con este enlace</a>.</p>
            <p class="font-mono text-[11px] text-brand-white/70 leading-relaxed">Al enviar, acepta la visualización del estudio y el envío de ofertas comerciales ocasionales de UX MIND. Puede darse de baja en cualquier momento con un solo clic.</p>
          </form>
        </div>
      </dialog>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../../../scripts/case-study';
</script>
</content>
