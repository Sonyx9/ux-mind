---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const fakta = [["MÉTODO", "Eye-tracking + VisAWI"], ["MUESTRA", "61 participantes"], ["ESTÍMULOS", "3 plantillas · catálogo idéntico"], ["RESULTADOS", "Distribución de la atención según la tarea"]];
const zjisteni = ["La misma plantilla llevó a una distribución distinta de la atención según la tarea asignada.", "La percepción del diseño cambia según la tarea — la valoración estética sin contexto de tarea es engañosa.", "„Bonito“ y „funcional“ son dos métricas distintas y hay que medirlas por separado."];
const faq = [
  { q: "¿Cómo elegir la plantilla de una tienda online?", a: "Según una prueba con tareas de compra reales, no según el aspecto de la vista previa. En la medición con 61 participantes, la atención sobre la misma plantilla cambiaba según la tarea asignada." },
  { q: "¿Por qué no basta con la valoración estética de la plantilla?", a: "Porque cambia según la tarea — „bonito“ y „funcional“ son dos métricas distintas y hay que medirlas por separado (cuestionario VisAWI + datos de rendimiento)." },
  { q: "¿Cuántas plantillas y tareas se probaron?", a: "Tres plantillas con el mismo catálogo y distintos tipos de tareas (navegación libre vs. compra dirigida) en una muestra de 61 participantes." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "Tres plantillas, el mismo catálogo. Decidió la tarea.",
    about: 'Eye tracking, investigación UX',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'es',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="es"
  title="Caso de estudio: plantillas de tiendas online y el efecto de la tarea"
  description="Eye tracking de tres plantillas de tienda online (N = 61): la distribución de la atención cambiaba según la tarea asignada. La valoración estética sin tarea es engañosa."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/es/casos-de-estudio" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← TODOS LOS CASOS</a>

      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Plantillas de tienda online</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-4xl" style="font-size: clamp(3rem, 9vw, 8rem);">
          Tres plantillas, el mismo catálogo. Decidió la tarea<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white p-8 md:p-12 mb-16 flex flex-col md:flex-row md:items-center gap-6 md:gap-12">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <p class="relative font-display font-bold leading-none tracking-tight whitespace-nowrap" style="font-size: clamp(3rem, 8vw, 6.5rem);">3 × 2</p>
        <p class="relative text-brand-white/70 text-lg leading-relaxed max-w-md">tres plantillas, dos tareas — cada vez un mapa de atención diferente</p>
      </div>

      <section class="reveal mb-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ GLOSARIO — QUÉ SIGNIFICAN LAS CIFRAS DE ESTE ESTUDIO ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 space-y-4">
            <div><dt class="font-display font-bold mb-1">N (muestra)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Número de personas reales que participaron en la medición. N = 102 significa 102 participantes.</dd></div>
            <div><dt class="font-display font-bold mb-1">valor p</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Probabilidad de que la diferencia medida se deba al puro azar. Cuanto menor, más concluyente es el resultado — p = 0,037 significa solo un 3,7 % de probabilidad de azar (se considera concluyente todo lo que está por debajo del 5 %).</dd></div>
            <div><dt class="font-display font-bold mb-1">Tamaño del efecto (ηp²)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Indica cuán grande es la diferencia en la práctica — no solo si existe. De forma orientativa: 0,01 efecto pequeño, 0,06 medio, 0,14 grande.</dd></div>
            <div><dt class="font-display font-bold mb-1">Fijación</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Breve detención del ojo en un punto (fracciones de segundo). De la secuencia de fijaciones se compone todo lo que una persona realmente „vio“ en la página.</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI (área de interés)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Parte de la página marcada de antemano — botón, título, fotografía — para la que medimos cuánta atención recibió.</dd></div>
            <div><dt class="font-display font-bold mb-1">UEQ / VisAWI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Cuestionarios científicos estandarizados: UEQ mide la experiencia de usuario global, VisAWI la estética percibida del sitio. Gracias a la estandarización, los resultados son comparables entre estudios.</dd></div>
          </dl>
        </details>
      </section>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— CONTEXTO</span></p>
            <p class="text-lg text-brand-black/80 leading-relaxed">La elección de la plantilla es una de las primeras decisiones de toda tienda online — y suele hacerse según el aspecto de la vista previa. Medimos si la impresión estética es una buena guía para el rendimiento real de compra.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— PREGUNTA DE NEGOCIO</span></p>
            <p class="font-display text-2xl font-bold leading-snug">¿Basta con elegir la plantilla de la tienda online por cómo se ve? ¿O importa lo que los clientes tienen que hacer en ella?</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— MEDICIÓN</span></p>
            <p class="text-brand-black/70 leading-relaxed">Eye-tracking de tres plantillas con el mismo catálogo, con distintas tareas asignadas, complementado con el cuestionario VisAWI — una herramienta estandarizada para medir la estética percibida del sitio.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">04</span> <span class="text-brand-black/60">— LO QUE MOSTRARON LOS DATOS</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ DATOS EN IMAGEN ]</p>
              <svg viewBox="0 0 640 300" class="w-full" role="img" aria-label="Esquema ilustrativo: la misma plantilla, dos tareas, dos distribuciones distintas de la atención">
  <text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">ESQUEMA ILUSTRATIVO · LA MISMA PLANTILLA, DOS TAREAS</text>
  <g>
    <rect x="0" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <rect x="12" y="52" width="276" height="26" fill="rgba(10,10,10,0.12)"/>
    <g fill="rgba(10,10,10,0.08)">
      <rect x="12" y="92" width="84" height="52"/><rect x="108" y="92" width="84" height="52"/><rect x="204" y="92" width="84" height="52"/>
      <rect x="12" y="156" width="84" height="52"/><rect x="108" y="156" width="84" height="52"/><rect x="204" y="156" width="84" height="52"/>
    </g>
    <circle cx="150" cy="65" r="38" fill="#2D62FC" opacity="0.25"/>
    <circle cx="54" cy="118" r="30" fill="#2D62FC" opacity="0.18"/>
    <text x="8" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">TAREA: „EXPLORE LA TIENDA ONLINE“</text>
    <text x="8" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">atención en el branding y la introducción</text>
  </g>
  <g>
    <rect x="340" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <rect x="352" y="52" width="276" height="26" fill="rgba(10,10,10,0.12)"/>
    <g fill="rgba(10,10,10,0.08)">
      <rect x="352" y="92" width="84" height="52"/><rect x="448" y="92" width="84" height="52"/><rect x="544" y="92" width="84" height="52"/>
      <rect x="352" y="156" width="84" height="52"/><rect x="448" y="156" width="84" height="52"/><rect x="544" y="156" width="84" height="52"/>
    </g>
    <circle cx="490" cy="118" r="34" fill="#2D62FC" opacity="0.25"/>
    <circle cx="586" cy="182" r="30" fill="#2D62FC" opacity="0.22"/>
    <text x="348" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">TAREA: „ENCUENTRE Y COMPRE UN PRODUCTO“</text>
    <text x="348" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">atención en los productos y el precio</text>
  </g>
  <text x="0" y="296" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">EYE-TRACKING + VisAWI · N = 61 · TRES PLANTILLAS CON EL MISMO CATÁLOGO</text>
</svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">Esquema del principio: las superficies azules representan el centro de atención en distintas tareas sobre la misma plantilla.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— QUÉ SE DECIDIÓ</span></p>
            <p class="text-brand-black/70 leading-relaxed">Elegir la plantilla de la tienda online sobre la base de pruebas con tareas de compra reales, no según la impresión de la vista previa.</p>
          </section>

          <section class="reveal border border-brand-black p-8">
            <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-4">LO QUE HOY APORTARÍA EMLI</p>
            <p class="text-brand-black/70 leading-relaxed">En un encargo similar, hoy medimos además el índice de carga EMLI para cada tarea y plantilla — cuantifica qué combinación agota menos al cliente.</p>
          </section>
        </div>

        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">ESTUDIO REALIZADO EN COLABORACIÓN CON</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Universidad de Hradec Králové — Facultad de Informática y Gestión"
                title="Estudio realizado en colaboración con la FIM de la Universidad de Hradec Králové"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">DATOS DE LA MEDICIÓN</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <div class="border border-brand-black/10 p-4 bg-brand-white">
                <svg viewBox="0 0 320 210" class="w-full" role="img" aria-label="Esquema de tres plantillas distintas de tienda online con el mismo catálogo">
                  <g>
                    <rect x="4" y="20" width="96" height="130" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                    <rect x="12" y="28" width="80" height="16" fill="rgba(10,10,10,0.25)"/>
                    <rect x="12" y="52" width="80" height="40" fill="rgba(10,10,10,0.08)"/>
                    <rect x="12" y="98" width="38" height="26" fill="rgba(10,10,10,0.08)"/>
                    <rect x="54" y="98" width="38" height="26" fill="rgba(10,10,10,0.08)"/>
                    <circle cx="52" cy="72" r="16" fill="#2D62FC" opacity="0.3"/>
                  </g>
                  <g>
                    <rect x="112" y="20" width="96" height="130" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                    <rect x="120" y="28" width="24" height="114" fill="rgba(10,10,10,0.18)"/>
                    <rect x="152" y="28" width="48" height="26" fill="rgba(10,10,10,0.08)"/>
                    <rect x="152" y="62" width="48" height="26" fill="rgba(10,10,10,0.08)"/>
                    <rect x="152" y="96" width="48" height="26" fill="rgba(10,10,10,0.08)"/>
                    <circle cx="176" cy="75" r="16" fill="#2D62FC" opacity="0.3"/>
                  </g>
                  <g>
                    <rect x="220" y="20" width="96" height="130" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                    <rect x="228" y="28" width="80" height="10" fill="rgba(10,10,10,0.25)"/>
                    <rect x="228" y="46" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="257" y="46" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="286" y="46" width="22" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="228" y="77" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="257" y="77" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="286" y="77" width="22" height="25" fill="rgba(10,10,10,0.08)"/>
                    <circle cx="268" cy="90" r="16" fill="#2D62FC" opacity="0.3"/>
                  </g>
                  <text x="4" y="176" font-family="monospace" font-size="11" fill="#0A0A0A">3 PLANTILLAS · MISMO CATÁLOGO</text>
                  <text x="4" y="194" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">en azul: centro de atención</text>
                </svg>
              </div>
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Esquema de las tres plantillas evaluadas — la atención se desplazaba según la tarea</figcaption>
            </figure>
            <a href="/es/contacto" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              SOLICITUD SIN COMPROMISO →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ PREGUNTAS FRECUENTES SOBRE EL ESTUDIO ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="reveal mt-16 bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">¿Quiere revisar el estudio en detalle<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">INFORME DETALLADO CON METODOLOGÍA Y RECOMENDACIONES — GRATIS EN PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          SOLICITAR EL ESTUDIO →
        </button>
      </section>

      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Otros casos de estudio">
        <a href="/es/casos-de-estudio/reklamni-bannery-smer-pohledu" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← ESTUDIO ANTERIOR</p>
          <p class="font-display font-bold leading-snug">Adonde mira el personaje del banner, mira también su cliente</p>
        </a>
        <a href="/es/casos-de-estudio/billboardy-sport-marketing" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">ESTUDIO SIGUIENTE →</p>
          <p class="font-display font-bold leading-snug">16 diseños de vallas, 79 pares de ojos</p>
        </a>
      </nav>

      <div class="reveal bg-brand-black text-brand-white text-center p-10 md:p-14 mt-10">
        <h2 class="font-display text-3xl md:text-4xl font-bold mb-8">Probar su tienda online con tareas reales<span style="color:#2D62FC">.</span></h2>
        <a href="/es/contacto" class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          SOLICITUD SIN COMPROMISO →
        </a>
        <p class="font-mono text-xs text-brand-white/60 mt-6">PAQUETE TÍPICO PARA ESTE TIPO DE ENCARGO: <a href="/es/servicios/paquetes-de-prueba" class="text-brand-white underline hover:no-underline">Prueba UX estándar</a></p>
      </div>
    </div>

      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ ESTUDIO DETALLADO ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Cerrar ventana">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">¿Quiere revisar el estudio en detalle<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Los estudios están resumidos y anonimizados.</p>
          <form class="study-request space-y-4" data-pdf="https://lukaskoula.com" data-study="Tres plantillas, el mismo catálogo. Decidió la tarea.">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">NOMBRE *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Su nombre"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">EMPRESA</label>
              <input type="text" id="sr-company" name="company" placeholder="Nombre de la empresa (opcional)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="su@email.com"
                class="study-input" />
            </div>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              VER EL ESTUDIO (PDF) →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/50 p-3">¡Gracias! Si el estudio no se abrió automáticamente, <a href="#" class="study-pdf-link underline hover:text-brand-white/70" target="_blank" rel="noopener">ábralo con este enlace</a>.</p>
            <p class="font-mono text-[11px] text-brand-white/70 leading-relaxed">Al enviar, acepta la visualización del estudio y el envío de ofertas comerciales ocasionales de UX MIND. Puede darse de baja en cualquier momento con un solo clic.</p>
          </form>
        </div>
