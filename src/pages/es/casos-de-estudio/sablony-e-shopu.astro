---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const fakta = [["MÉTODO", "Eye tracking + VisAWI"], ["MUESTRA", "61 participantes"], ["ESTÍMULOS", "3 plantillas · surtido idéntico"], ["ESCENARIOS", "Navegación libre · tarea dirigida"]];
const zjisteni = ["En la misma plantilla, la distribución de la atención visual cambiaba según la tarea asignada.", "La navegación libre y la búsqueda dirigida de un producto llevaron a los participantes a partes distintas de la página.", "La valoración estética y el comportamiento durante una tarea concreta describen aspectos distintos de la experiencia. Por eso, una métrica no puede sustituir automáticamente a la otra."];
const faq = [
  { q: "¿Cómo elegir la plantilla de un e-commerce?", a: "Primero según el surtido, el contenido, los requisitos técnicos y los recorridos clave del cliente. Conviene verificar la selección final con tareas realistas, porque la vista previa de la plantilla por sí sola no muestra cómo se orientarán las personas en ella." },
  { q: "¿Por qué no basta con la valoración estética de la plantilla?", a: "La estética percibida y el comportamiento durante una tarea son constructos distintos. Una plantilla puede parecer buena, pero un recorrido concreto en ella puede ser difícil — o al revés. Por eso combinamos el cuestionario con datos de tareas y de comportamiento." },
  { q: "¿Cuántas plantillas y tareas se probaron?", a: "El estudio incluyó tres plantillas con el mismo surtido, dos contextos de tarea distintos y 61 participantes. Un escenario favorecía la navegación libre; el otro, el trabajo dirigido con el catálogo." },
  { q: "¿El estudio encontró una plantilla mejor que las demás?", a: "No de forma universal. El principal hallazgo fue que la interpretación de la plantilla depende de la tarea. Por eso, la variante ganadora debe definirse según el recorrido concreto y las métricas que el e-commerce necesita favorecer." },
  { q: "¿La distribución de la atención demuestra una mayor conversión?", a: "No. El eye tracking muestra hacia dónde dirigieron la mirada las personas, no automáticamente la compra o la venta. Para una conclusión de negocio es necesario relacionar el resultado con el éxito de la tarea, la analítica o un experimento posterior." },
  { q: "¿Se puede probar la plantilla antes de lanzar el e-commerce?", a: "Sí. Se puede probar una demo funcional, un prototipo o varias plantillas candidatas rellenas con contenido realista. Cuanto más se acerquen las condiciones al uso real, mejor podrá interpretarse el resultado." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "La tarea cambió hacia dónde dirigían la atención.",
    about: 'Eye tracking, investigación UX',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'es',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="es"
  title="Caso de estudio: cómo la tarea cambió la atención en un e-commerce"
  description="Eye tracking de tres plantillas de e-commerce con 61 participantes: la distribución de la atención en la misma plantilla cambiaba según la tarea asignada."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/es/casos-de-estudio" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← TODOS LOS CASOS</a>

      <!-- Cabecera del estudio -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Plantillas de e-shop</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          La tarea cambió hacia dónde dirigían la atención<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Diseño del estudio -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-1 md:grid-cols-3">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative p-7 md:p-9 border-t-4 border-t-brand-blue border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">3</p>
          <p class="text-brand-white/70 leading-relaxed">plantillas de e-commerce con el mismo surtido</p>
        </div>
        <div class="relative p-7 md:p-9 border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">2</p>
          <p class="text-brand-white/70 leading-relaxed">contextos de tarea distintos</p>
        </div>
        <div class="relative p-7 md:p-9">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">61</p>
          <p class="text-brand-white/70 leading-relaxed">participantes en el estudio</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Contenido -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— LO QUE MOSTRARON LOS DATOS</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— QUÉ HABÍA QUE DESCUBRIR</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">¿Describe el simple aspecto de la plantilla cómo las personas resuelven en ella una tarea concreta?</p>
            <p class="text-brand-black/70 leading-relaxed">El estudio comparó tres plantillas de e-commerce con el mismo surtido. El objetivo era observar cómo un contexto distinto —la navegación libre y el trabajo dirigido con el catálogo— cambia la forma en que las personas recorren visualmente la página.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— CÓMO SE REALIZÓ LA MEDICIÓN</span></p>
            <p class="text-brand-black/70 leading-relaxed">En el estudio participaron 61 personas. El eye tracking registró la distribución de la atención visual en las distintas tareas, y el cuestionario VisAWI complementó la valoración subjetiva de la estética percibida de las plantillas.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ PRINCIPIO DE LOS ESCENARIOS PROBADOS ]</p>
              <svg viewBox="0 0 640 300" class="w-full" role="img" aria-label="Esquema ilustrativo: la misma plantilla, dos tareas, dos distribuciones distintas de la atención">
  <text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">ESQUEMA ILUSTRATIVO · NO ES UN HEATMAP REAL</text>
  <g>
    <rect x="0" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <rect x="12" y="52" width="276" height="26" fill="rgba(10,10,10,0.12)"/>
    <g fill="rgba(10,10,10,0.08)">
      <rect x="12" y="92" width="84" height="52"/><rect x="108" y="92" width="84" height="52"/><rect x="204" y="92" width="84" height="52"/>
      <rect x="12" y="156" width="84" height="52"/><rect x="108" y="156" width="84" height="52"/><rect x="204" y="156" width="84" height="52"/>
    </g>
    <circle cx="150" cy="65" r="38" fill="#2D62FC" opacity="0.25"/>
    <circle cx="54" cy="118" r="30" fill="#2D62FC" opacity="0.18"/>
    <text x="8" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">TAREA: «EXPLORE LA TIENDA ONLINE»</text>
    <text x="8" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">atención en el branding y la introducción</text>
  </g>
  <g>
    <rect x="340" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <rect x="352" y="52" width="276" height="26" fill="rgba(10,10,10,0.12)"/>
    <g fill="rgba(10,10,10,0.08)">
      <rect x="352" y="92" width="84" height="52"/><rect x="448" y="92" width="84" height="52"/><rect x="544" y="92" width="84" height="52"/>
      <rect x="352" y="156" width="84" height="52"/><rect x="448" y="156" width="84" height="52"/><rect x="544" y="156" width="84" height="52"/>
    </g>
    <circle cx="490" cy="118" r="34" fill="#2D62FC" opacity="0.25"/>
    <circle cx="586" cy="182" r="30" fill="#2D62FC" opacity="0.22"/>
    <text x="348" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">TAREA: «ENCUENTRE Y COMPRE UN PRODUCTO»</text>
    <text x="348" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">atención en los productos y el precio</text>
  </g>
  <text x="0" y="296" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">EYE-TRACKING + VisAWI · N = 61 · TRES PLANTILLAS CON EL MISMO SURTIDO</text>
</svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">El esquema explica la diferencia entre los escenarios. Las superficies azules son solo ilustrativas y no representan datos reales medidos de los participantes.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— RECOMENDACIÓN PARA LA PRÁCTICA</span></p>
            <p class="text-brand-black/70 leading-relaxed">No evaluar la plantilla solo con navegación libre o según una vista previa estática. Rellenar las soluciones candidatas con contenido realista y verificarlas con tareas que correspondan a los recorridos reales del cliente.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ QUÉ APRENDER DE ESTO ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">Una plantilla no funciona por sí sola. Funciona para una tarea concreta<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">Una prueba de usuario muestra si la solución elegida favorece la búsqueda, la comparación y la compra tal como su e-commerce necesita.</p>
            <a href="/es/contacto" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">HABLAR DE UNA PRUEBA PARA SU E-COMMERCE →</a>
          </section>
        </div>

        <!-- Datos + foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">ESTUDIO REALIZADO EN COLABORACIÓN CON</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Facultad de Informática y Gestión"
                title="El estudio se realizó en colaboración con FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">DATOS DE LA MEDICIÓN</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <div class="border border-brand-black/10 p-4 bg-brand-white">
                <svg viewBox="0 0 320 210" class="w-full" role="img" aria-label="Esquema ilustrativo de tres plantillas distintas de e-commerce con el mismo surtido">
                  <g>
                    <rect x="4" y="20" width="96" height="130" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                    <rect x="12" y="28" width="80" height="16" fill="rgba(10,10,10,0.25)"/>
                    <rect x="12" y="52" width="80" height="40" fill="rgba(10,10,10,0.08)"/>
                    <rect x="12" y="98" width="38" height="26" fill="rgba(10,10,10,0.08)"/>
                    <rect x="54" y="98" width="38" height="26" fill="rgba(10,10,10,0.08)"/>
                    <circle cx="52" cy="72" r="16" fill="#2D62FC" opacity="0.3"/>
                  </g>
                  <g>
                    <rect x="112" y="20" width="96" height="130" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                    <rect x="120" y="28" width="24" height="114" fill="rgba(10,10,10,0.18)"/>
                    <rect x="152" y="28" width="48" height="26" fill="rgba(10,10,10,0.08)"/>
                    <rect x="152" y="62" width="48" height="26" fill="rgba(10,10,10,0.08)"/>
                    <rect x="152" y="96" width="48" height="26" fill="rgba(10,10,10,0.08)"/>
                    <circle cx="176" cy="75" r="16" fill="#2D62FC" opacity="0.3"/>
                  </g>
                  <g>
                    <rect x="220" y="20" width="96" height="130" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                    <rect x="228" y="28" width="80" height="10" fill="rgba(10,10,10,0.25)"/>
                    <rect x="228" y="46" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="257" y="46" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="286" y="46" width="22" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="228" y="77" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="257" y="77" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="286" y="77" width="22" height="25" fill="rgba(10,10,10,0.08)"/>
                    <circle cx="268" cy="90" r="16" fill="#2D62FC" opacity="0.3"/>
                  </g>
                  <text x="4" y="176" font-family="monospace" font-size="11" fill="#0A0A0A">3 PLANTILLAS · MISMO SURTIDO</text>
                  <text x="4" y="194" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">vista previa ilustrativa de las variantes</text>
                </svg>
              </div>
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Esquema ilustrativo de tres plantillas con el mismo surtido</figcaption>
            </figure>
            <a href="/es/contacto" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              SOLICITUD SIN COMPROMISO →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ GLOSARIO — QUÉ SIGNIFICAN LOS TÉRMINOS DE ESTE ESTUDIO ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">N (muestra)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Número de personas incluidas en el estudio. En este caso, N = 61.</dd></div>
            <div><dt class="font-display font-bold mb-1">Escenario de tarea</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Encargo concreto que determina qué debe lograr el participante en la página.</dd></div>
            <div><dt class="font-display font-bold mb-1">Fijación</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Breve detención del ojo en una zona determinada. Describe la atención visual, no necesariamente la comprensión o la compra.</dd></div>
            <div><dt class="font-display font-bold mb-1">VisAWI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Cuestionario estandarizado centrado en la estética percibida subjetivamente de una interfaz web.</dd></div>
          </dl>
        </details>
      </section>

      <!-- FAQ del estudio -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ PREGUNTAS FRECUENTES SOBRE EL ESTUDIO ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Franja estrecha: estudio completo (abre modal) -->
      <section class="reveal mt-16 !hidden bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">¿Quiere revisar el estudio en detalle<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">INFORME DETALLADO CON METODOLOGÍA Y RECOMENDACIONES — GRATIS EN PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          SOLICITAR EL ESTUDIO →
        </button>
      </section>

      <!-- Navegación entre estudios -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Otros casos de estudio">
        <a href="/es/casos-de-estudio/reklamni-bannery-smer-pohledu" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← ESTUDIO ANTERIOR</p>
          <p class="font-display font-bold leading-snug">La mirada del personaje dirigió la atención de los visitantes</p>
        </a>
        <a href="/es/casos-de-estudio/billboardy-sport-marketing" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">ESTUDIO SIGUIENTE →</p>
          <p class="font-display font-bold leading-snug">Los seis primeros puestos fueron para las vallas negras.</p>
        </a>
      </nav>

    </div>

      <!-- Modal: solicitud de estudio completo -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ ESTUDIO DETALLADO ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Cerrar ventana">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">¿Quiere revisar el estudio en detalle<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Los estudios están resumidos y anonimizados.</p>
          <form class="study-request space-y-4" data-pdf="https://lukaskoula.com" data-study="La tarea cambió hacia dónde dirigían la atención.">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">NOMBRE *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Su nombre"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">EMPRESA</label>
              <input type="text" id="sr-company" name="company" placeholder="Nombre de la empresa (opcional)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="su@email.com"
                class="study-input" />
            </div>
