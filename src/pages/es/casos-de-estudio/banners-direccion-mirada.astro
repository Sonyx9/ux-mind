---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const fakta = [["MÉTODO", "Experimento de eye tracking"], ["MUESTRA", "104 participantes"], ["VARIABLE", "Dirección de la mirada del personaje"], ["ESTADÍSTICA", "F(1,102) = 12,57 · p < 0,001 · ηp² = 0,11"]];
const zjisteni = ["El cambio en la dirección de la mirada del personaje influyó de forma estadísticamente significativa en la distribución de la atención visual: F(1,102) = 12,57; p < 0,001.", "El tamaño del efecto ηp² = 0,11 corresponde, según los límites orientativos habituales, a un efecto de tamaño medio.", "La composición del personaje funcionó, por tanto, como una guía visual en las creatividades probadas. Sin embargo, el estudio no midió clics, memorización del mensaje ni conversión."];
const faq = [
  { q: "¿La dirección de la mirada del personaje influyó en la atención?", a: "Sí, en las creatividades probadas y con una muestra de 104 participantes, la distribución de la atención entre las variantes difirió de forma estadísticamente significativa: p < 0,001; ηp² = 0,11." },
  { q: "¿Significa esto que siempre debemos orientar al personaje hacia el CTA?", a: "No de forma automática. El resultado respalda la dirección de la mirada como una variable relevante de la composición. La variante adecuada depende de la fotografía concreta, el mensaje, el formato y el objetivo de la creatividad, por lo que recomendamos comparar diseños reales." },
  { q: "¿El estudio demostró más clics o conversiones?", a: "No. El estudio midió la distribución de la atención visual, no los clics, la memorización, la compra ni otra métrica de negocio. El desplazamiento de la atención es un paso intermedio importante, pero por sí solo no garantiza la acción." },
  { q: "¿Qué significa ηp² = 0,11?", a: "La eta cuadrado parcial describe el tamaño del efecto en el modelo estadístico utilizado. El valor 0,11 se interpreta, según los límites orientativos habituales, como un efecto de tamaño medio; sin embargo, no significa automáticamente un aumento del 11 % en el rendimiento de la campaña." },
  { q: "¿Qué significa p < 0,001?", a: "Si la dirección de la mirada en realidad no tuviera ningún efecto en el modelo utilizado y se cumplieran sus supuestos, un resultado igual o más pronunciado sería muy poco habitual. El valor p por sí solo no describe la magnitud ni el valor comercial del efecto." },
  { q: "¿Tenemos que rehacer toda la creatividad para hacer la prueba?", a: "No necesariamente. A menudo basta con preparar variantes controladas de la fotografía, el recorte o la posición del personaje. El resto de los elementos deben permanecer lo más parecidos posible para poder interpretar la diferencia con sentido." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "La mirada del personaje dirigió la atención de los visitantes.",
    about: 'Eye tracking, investigación UX',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'es',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="es"
  title="Caso de estudio: cómo la dirección de la mirada influyó en la atención"
  description="Experimento de eye tracking con 104 participantes: el cambio en la dirección de la mirada del personaje influyó en la distribución de la atención, F(1,102) = 12,57; p < 0,001; ηp² = 0,11."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/es/casos-de-estudio" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← TODOS LOS CASOS</a>

      <!-- Cabecera del estudio -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Creatividad publicitaria</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          La mirada del personaje dirigió la atención de los visitantes<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Resultados principales -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-1 md:grid-cols-3">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative p-7 md:p-9 border-t-4 border-t-brand-blue border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-mono text-xs tracking-widest text-brand-white/60 mb-5">DIRECCIÓN DE LA MIRADA</p>
          <p class="font-display text-2xl md:text-3xl font-bold leading-tight">Cambió la distribución de la atención</p>
        </div>
        <div class="relative p-7 md:p-9 border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">104</p>
          <p class="text-brand-white/70 leading-relaxed">participantes en el experimento</p>
        </div>
        <div class="relative p-7 md:p-9">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.2rem, 4.5vw, 4rem);">ηp² = 0,11</p>
          <p class="text-brand-white/70 leading-relaxed">efecto medio · p &lt; 0,001</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Contenido -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— LO QUE MOSTRARON LOS DATOS</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— QUÉ HABÍA QUE DESCUBRIR</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">¿Cambia la dirección de la mirada del personaje la distribución de la atención en la creatividad?</p>
            <p class="text-brand-black/70 leading-relaxed">Un rostro humano en la publicidad atrae la atención. El experimento comprobó si un cambio en la dirección de la mirada del personaje también influye en cómo los participantes distribuyen la atención entre el rostro y el resto de la creatividad probada.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— CÓMO SE REALIZÓ LA MEDICIÓN</span></p>
            <p class="text-brand-black/70 leading-relaxed">En el experimento de eye tracking participaron 104 personas. Las variantes de la creatividad se diferenciaban en la dirección de la mirada del personaje, y el análisis comparó la distribución de la atención visual entre las áreas marcadas de antemano.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ PRINCIPIO DE LAS VARIANTES PROBADAS ]</p>
              <svg viewBox="0 0 640 300" class="w-full" role="img" aria-label="Esquema ilustrativo: la dirección de la mirada del personaje dirige la atención del espectador">
  <text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">ESQUEMA ILUSTRATIVO DE LAS VARIANTES · NO ES UN HEATMAP</text>
  <g>
    <rect x="0" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <circle cx="70" cy="110" r="26" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <circle cx="62" cy="105" r="3" fill="#0A0A0A"/><circle cx="80" cy="105" r="3" fill="#0A0A0A"/>
    <rect x="200" y="140" width="70" height="46" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <text x="8" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">MIRADA A LA CÁMARA</text>
    <text x="8" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">variante de composición A</text>
  </g>
  <g>
    <rect x="340" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <circle cx="410" cy="110" r="26" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <circle cx="424" cy="108" r="3" fill="#0A0A0A"/><circle cx="432" cy="112" r="3" fill="#0A0A0A"/>
    <line x1="440" y1="118" x2="530" y2="152" stroke="#2D62FC" stroke-width="2" stroke-dasharray="4 4"/>
    <rect x="540" y="140" width="70" height="46" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <text x="348" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">MIRADA AL PRODUCTO</text>
    <text x="348" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">variante de composición B</text>
  </g>
  <text x="0" y="296" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">EFECTO DE LA GUÍA: F(1,102) = 12,57 · p &lt; 0,001 · ηp² = 0,11 (EFECTO MEDIO)</text>
</svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">El esquema solo explica la variable manipulada. No muestra los estímulos reales ni el heatmap de los participantes; la estadística procede de una medición real.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— RECOMENDACIÓN PARA LA PRÁCTICA</span></p>
            <p class="text-brand-black/70 leading-relaxed">Incluir la dirección de la mirada entre las variables al diseñar y probar la creatividad. Si el personaje debe reforzar la atención hacia un mensaje o producto concreto, preparar variantes controladas y verificarlas junto con las métricas de la campaña.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ QUÉ APRENDER DE ESTO ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">Incluso un pequeño cambio de composición puede alterar la distribución de la atención<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">El eye tracking ayuda a elegir la variante según lo que las personas realmente registran. El impacto en los clics o en la conversión debe verificarse con datos posteriores.</p>
            <a href="/es/contacto" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">HABLAR DE UN TEST DE CREATIVIDAD →</a>
          </section>
        </div>

        <!-- Datos + foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">ESTUDIO REALIZADO EN COLABORACIÓN CON</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Facultad de Informática y Gestión"
                title="El estudio se realizó en colaboración con FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">DATOS DE LA MEDICIÓN</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/laborator-ux-vyzkumu-vizualizace-1.webp`}
                alt="Visualización del puesto de pruebas del laboratorio — cabinas separadas con estaciones de trabajo"
                width="1080" height="762" loading="lazy" decoding="async"
                class="w-full h-52 object-cover border border-brand-black/10"
              />
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Visualización de las cabinas de prueba donde se realiza la medición de creatividades sin distracciones</figcaption>
            </figure>
            <a href="/es/contacto" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              SOLICITUD SIN COMPROMISO →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ GLOSARIO — QUÉ SIGNIFICAN LOS TÉRMINOS DE ESTE ESTUDIO ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">N (muestra)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Número de personas incluidas en el análisis. En este estudio, N = 104.</dd></div>
            <div><dt class="font-display font-bold mb-1">F(1,102)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Valor del estadístico de la prueba y sus grados de libertad en el test estadístico utilizado.</dd></div>
            <div><dt class="font-display font-bold mb-1">Valor p</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Ayuda a valorar hasta qué punto los datos son compatibles con la suposición de que la dirección de la mirada no tuvo ningún efecto en el modelo utilizado.</dd></div>
            <div><dt class="font-display font-bold mb-1">ηp²</dt><dd class="text-sm text-brand-black/70 leading-relaxed">La eta cuadrado parcial expresa el tamaño del efecto en el modelo estadístico correspondiente. No es un porcentaje de aumento del rendimiento de la campaña.</dd></div>
          </dl>
        </details>
      </section>

      <!-- FAQ del estudio -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ PREGUNTAS FRECUENTES SOBRE EL ESTUDIO ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Franja estrecha: estudio completo (abre modal) -->
      <section class="reveal mt-16 !hidden bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">¿Quiere revisar el estudio en detalle<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">INFORME DETALLADO CON METODOLOGÍA Y RECOMENDACIONES — GRATIS EN PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          SOLICITAR EL ESTUDIO →
        </button>
      </section>

      <!-- Navegación entre estudios -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Otros casos de estudio">
        <a href="/es/casos-de-estudio/fotografia-producto-e-commerce" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← ESTUDIO ANTERIOR</p>
          <p class="font-display font-bold leading-snug">Mismo producto. Decisiones de distinta duración</p>
        </a>
        <a href="/es/casos-de-estudio/plantillas-tienda-online" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">ESTUDIO SIGUIENTE →</p>
          <p class="font-display font-bold leading-snug">La tarea cambió hacia dónde dirigían la atención</p>
        </a>
      </nav>

    </div>

      <!-- Modal: solicitud de estudio completo -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ ESTUDIO DETALLADO ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Cerrar ventana">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">¿Quiere revisar el estudio en detalle<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Los estudios están resumidos y anonimizados.</p>
          <form class="study-request space-y-4" data-pdf="https://lukaskoula.com" data-study="La mirada del personaje dirigió la atención de los visitantes.">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">NOMBRE *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Su nombre"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">EMPRESA</label>
              <input type="text" id="sr-company" name="company" placeholder="Nombre de la empresa (opcional)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="su@email.com"
                class="study-input" />
            </div>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              VER EL ESTUDIO (PDF) →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/50 p-3">¡Gracias! Si el estudio no se abrió automáticamente, <a href="#" class="study-pdf-link underline hover:text-brand-white/70" target="_blank" rel="noopener">ábralo con este enlace</a>.</p>
            <p class="font-mono text-[11px] text-brand-white/70 leading-relaxed">Al enviar, acepta la visualización del estudio y el envío de ofertas comerciales ocasionales de UX MIND. Puede darse de baja en cualquier momento con un solo clic.</p>
          </form>
        </div>
      </dialog>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../../../scripts/case-study';
</script>
</content>
