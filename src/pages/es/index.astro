---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const homeStudies = [
  {
    href: '/es/casos-de-estudio/portal-empleo-automocion',
    category: 'ŠKODA AUTO · portal de empleo',
    title: 'El 40 % de los candidatos no encontró el camino hacia las vacantes. Y la web «parecía clara».',
    method: 'Eye tracking + cuestionario · N = 102',
    result: '4 de 10 no encontraron las vacantes',
  },
  {
    href: '/es/casos-de-estudio/backend-stories',
    category: 'Microsite educativo',
    title: 'Cuanto más largo el texto, menos atención.',
    method: 'Eye tracking, análisis AOI · aprox. 120 participantes',
    result: '92 % registró el CTA',
  },
  {
    href: '/es/casos-de-estudio/banners-direccion-mirada',
    category: 'Creatividad publicitaria',
    title: 'La mirada del personaje dirigió la atención de los visitantes.',
    method: 'Experimento de eye tracking · N = 104',
    result: 'ηp² = 0,11 · efecto medio',
  },
];

const gifSrc = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/hero.webp`;
const yearSuffix = new Date().getFullYear().toString().slice(-2);

const clientLogos = [
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/skoda.webp`, w: 1920, h: 630, alt: 'Škoda Auto' , dh: 50 },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/fchk.webp`, w: 800, h: 800, alt: 'FC Hradec Králové' , dh: 54 },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`, w: 157, h: 37, alt: 'Univerzita Hradec Králové' },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/texopluslogo.webp`, w: 216, h: 46, alt: 'TEXO Plus' },
];
---

<BaseLayout lang="es" title="Investigación UX, eye tracking y pruebas de usuario | UXMIND" description="Pruebas de usuario, eye tracking y medición de la carga cognitiva (modelo EMLI). Investigación UX objetiva con el respaldo científico de la FIM UHK. Pruebe su web con datos." preloadImage={{ href: gifSrc, media: "(min-width: 768px)" }}>
  <Navbar />

  <!-- HERO SECTION -->
  <section class="hero-shell relative overflow-hidden" style="background:#FDFDFD;">

    <!-- Background grid: 4 columns × 3 rows, plus markers at intersections -->
    <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true"
      style="background-image: linear-gradient(rgba(10,10,10,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.07) 1px, transparent 1px); background-size: 25% 33.333%;">
      <div class="hidden md:block">
      {[0, 25, 50, 75, 100].flatMap(x =>
        [0, 33.333, 66.667, 100].map(y => (
          <div class="absolute" style={`left:${x}%; top:${y}%; width:14px; height:14px; transform:translate(-50%,-50%); background:linear-gradient(rgba(10,10,10,0.22),rgba(10,10,10,0.22)) center/14px 1px no-repeat, linear-gradient(rgba(10,10,10,0.22),rgba(10,10,10,0.22)) center/1px 14px no-repeat;`}></div>
        ))
      )}
      </div>
    </div>

    <!-- Center CTA — pod středovým obrázkem, na ose řádku mřížky se specializacemi -->
    <div class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 z-[60] hidden md:block" style="top: 83.333%;">
      <a href="/es/contacto" class="inline-block bg-brand-black text-brand-white border border-brand-black px-6 py-2 font-mono text-xs tracking-widest uppercase transition-colors duration-200 hover:bg-transparent hover:text-brand-black">
        CONCERTAR UNA CITA
      </a>
    </div>

    <!-- Large headline — top-aligned s horní linkou (stejná výška jako začínala horní tabulka) -->
    <div class="absolute z-10" style="left: var(--desktop-gutter); top: calc(var(--desktop-top-offset) + 3rem); line-height: 1; margin: 0; padding: 0;">
      <h1 class="m-0 p-0 relative" style="line-height:0;">
        <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logo-2line.svg`} alt="UX Mind" width="264" height="88" style="width: clamp(8.4rem, 16.8vw, 264px); height:auto; display:block;" />
        <!-- Easter egg: hotspot nad modrou tečkou loga + záslepka, když tečka "uteče" -->
        <span id="logo-dot-hotspot" class="hidden md:block" style="position:absolute; left:89%; top:64%; width:14%; height:24%;"></span>
        <span id="logo-dot-patch" style="position:absolute; left:92.4%; top:69%; width:8%; height:14%; background:#FCFCFC; border-radius:50%; display:none;"></span>
      </h1>
      <!-- Mobile-only: first annotation below heading -->
      <p class="md:hidden font-mono tracking-widest text-brand-black/70 mt-3" style="font-size:10px;">INVESTIGACIÓN, NO SUPOSICIONES</p>
    </div>

    <!-- Mobile hero image — static, shown immediately -->
    <div class="md:hidden absolute left-0 right-0 flex items-center justify-center" style="top: 33.333%; height: 33.334%;">
      <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/hero-mobile.webp`} alt="UX Mind — investigación UX y eye tracking" style="width:100%; height:auto; object-fit:contain;" width="800" height="450" fetchpriority="high" decoding="async" />
    </div>

    <!-- Center 3D Brain — desktop only -->
    <div class="hidden md:flex absolute inset-0 items-center justify-center">
      <div id="hero-gif-container" class="relative" style="width: min(48vw, 760px); height: min(50vh, 540px);">
        <!-- Hero GIF - plays once then freezes on last frame -->
        <img
          id="hero-gif"
          src={gifSrc}
          alt="Red neuronal animada — visualización que conecta investigación UX, eye tracking y datos"
          class="w-full h-full object-contain"
          width="960" height="540" loading="lazy" decoding="async"
        />

        <!-- Annotation: top — text visible in hero below CTA, line goes down into image -->
        <div class="ann absolute hidden md:flex flex-col items-center opacity-0" style="left:50%; top:-30px; transform:translateX(-50%);">
          <p class="font-mono hero-fluid-micro tracking-widest text-center mb-1 max-w-32">INVESTIGACIÓN<br/>NO SUPOSICIONES</p>
          <div class="ann-line w-px bg-brand-black" style="height:0;" data-size="200"></div>
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
        </div>

        <!-- Annotation: left — text left of container, dot at 22% from left -->
        <div class="ann absolute hidden md:flex items-center opacity-0" style="left:22%; top:42%; transform:translate(-100%,-50%);">
          <div class="text-right mr-2">
            <p class="font-mono hero-fluid-micro tracking-widest">EL DISEÑO EMPIEZA<br/>POR EL USUARIO</p>
          </div>
          <div class="ann-line h-px bg-brand-black" style="width:0;"></div>
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
        </div>

        <!-- Annotation: right top — text right of container, dot at 22% from right; top 40% = pod spodní hranou stats boxu -->
        <div class="ann absolute hidden md:flex items-center opacity-0" style="right:22%; top:40%; transform:translate(100%,-50%);">
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
          <div class="ann-line h-px bg-brand-black" style="width:0;" data-size="110"></div>
          <div class="ml-2">
            <p class="font-mono hero-fluid-micro tracking-widest">EL EYE TRACKING<br/>MUESTRA LO QUE<br/>LA GENTE VE</p>
          </div>
        </div>

        <!-- Annotation: right bottom — text right of container, dot at 22% from right -->
        <div class="ann absolute hidden md:flex items-center opacity-0" style="right:22%; top:65%; transform:translate(100%,-50%);">
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
          <div class="ann-line h-px bg-brand-black" style="width:0;" data-size="110"></div>
          <div class="ml-2">
            <p class="font-mono hero-fluid-micro tracking-widest">MEDIR<br/>ENTENDER<br/>MEJORAR</p>
          </div>
        </div>

        <!-- Annotation: bottom — text below container, dot at 18% from bottom -->
        <div class="ann absolute hidden md:flex flex-col items-center opacity-0" style="left:50%; bottom:35%; transform:translate(-50%,100%);">
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
          <div class="ann-line w-px bg-brand-black" style="height:0;"></div>
          <p class="font-mono hero-fluid-micro tracking-widest text-center mt-1 max-w-24">DATOS<br/>NO IMPRESIONES</p>
        </div>

      </div>
    </div><!-- end desktop gif container -->

    <!-- Info box: stats (top right) -->
    <div class="hero-stats-box hidden absolute z-10 border border-brand-black p-4 bg-brand-white/90 backdrop-blur-sm" style="top: calc(var(--desktop-top-offset) + 3rem); left: calc(75% + clamp(12px,1.8vw,32px)); right: var(--desktop-gutter);">
      <div class="flex justify-between items-center mb-3">
        <p class="font-mono text-xs font-medium tracking-widest">UX MIND</p>
        <p class="font-mono text-xs text-brand-black/60">/{yearSuffix}</p>
      </div>
      <div class="space-y-2">
        <div class="flex items-baseline justify-between">
          <p class="font-display font-bold leading-none stat-projects" style="font-size: calc(clamp(24px, 1.2vw + 14px, 32px) * min(var(--fs, 1), 1.08));">50+</p>
          <p class="font-mono hero-fluid-micro text-brand-black/60 tracking-widest">PROYECTOS</p>
        </div>
        <div class="flex items-baseline justify-between">
          <p class="font-display font-bold leading-none stat-respondents" style="font-size: calc(clamp(24px, 1.2vw + 14px, 32px) * min(var(--fs, 1), 1.08));">200+</p>
          <p class="font-mono hero-fluid-micro text-brand-black/60 tracking-widest">PARTICIPANTES</p>
        </div>
        <div class="flex items-baseline justify-between gap-3 border-t border-brand-black/20 pt-2 mt-1">
          <p class="font-display font-bold leading-none stat-clicks" style="font-size: calc(clamp(24px, 1.2vw + 14px, 32px) * min(var(--fs, 1), 1.08));">50%</p>
          <p class="font-mono hero-fluid-micro text-brand-black/60 tracking-widest">MÁS CLICS</p>
        </div>
      </div>
    </div>

    <!-- Core services — vertically centered in 3rd grid rectangle (66.667%–100%) -->
    <div class="hero-spec-list absolute z-10" style="left: var(--desktop-gutter); top: 83.333%; transform: translateY(-50%);">
      <p class="font-mono text-xs tracking-widest mb-4 text-brand-black/60">[ NUESTRA ESPECIALIZACIÓN ]</p>
      <div class="space-y-3">
        {[
          { num: '01', label: 'AUDITORÍA UX' },
          { num: '02', label: 'PRUEBAS DE USUARIO' },
          { num: '03', label: 'EYE TRACKING' },
          { num: '04', label: 'INVESTIGACIÓN DE CAMPO' },
          { num: '05', label: 'INVESTIGACIÓN UX' },
        ].map((item) => (
          <div class="flex items-center gap-2">
            <p class="font-mono text-xs text-brand-black/60 shrink-0">{item.num}.</p>
            <span class="spec-dashes font-mono text-xs tracking-tight">
              {Array.from({length: 20}).map(() => (
                <span style="color:rgb(200,200,200); transition:color 0.8s ease;">|</span>
              ))}
            </span>
            <p class="font-mono text-xs font-medium tracking-widest whitespace-nowrap">{item.label}</p>
          </div>
        ))}
      </div>
      <div class="flex items-center gap-3 mt-3">
        <p id="local-time" class="font-mono text-xs tracking-widest">PRG --:-- -- &nbsp; --/--/----</p>
      </div>
    </div>

    <!-- Info box: about us — fills right half of bottom grid rectangle -->
    <div id="info-box" class="hidden md:flex absolute z-30 border border-brand-black bg-brand-black text-brand-white flex-col"
      style="left:calc(75% + clamp(12px,1.8vw,32px)); right: var(--desktop-gutter); top: 83.333%; transform: translateY(-50%); padding:clamp(8px,1.1vh,18px) clamp(10px,1.2vw,20px);">
      <div>
        <div class="mb-2">
          <p class="font-mono font-medium tracking-widest bg-brand-white text-brand-black px-1 py-0.5 block w-full" style="font-size:calc(clamp(11px,0.85vw,13px) * min(var(--fs, 1), 1.08));">NO SOMOS AGENCIA – ESPECIALISTAS</p>
        </div>
        <p class="font-mono text-brand-white/90 leading-relaxed text-justify infobox-desc" style="font-size:calc(clamp(11px,0.85vw,13px) * min(var(--fs, 1), 1.08));">
          Somos un equipo de especialistas en UX. Ayudamos a las empresas a entender a sus usuarios mediante datos, investigación y eye tracking.
        </p>
      </div>
      <div class="shrink-0" style="margin-top:clamp(10px,1.4vh,20px);">
        <div class="pt-2 border-t border-brand-white/20 flex flex-col items-start gap-1.5">
          <p class="font-mono text-brand-white/75 tracking-widest whitespace-nowrap" style="font-size:calc(clamp(10px,0.75vw,12px) * min(var(--fs, 1), 1.08));">PROYECTO CON:</p>
          <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`} alt="Univerzita Hradec Králové" class="max-w-full shrink-0" style="height:clamp(24px,2.8vh,40px); object-fit:contain; margin-top:4px; margin-bottom:4px; filter: invert(1);" />
        </div>
      </div>
    </div>

    <!-- Cursor dot — only in hero area -->
    <div id="cursor-dot" style="position:fixed;top:0;left:0;width:8px;height:8px;background:#2D62FC;border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);opacity:0;"></div>

    <!-- Scroll indicator -->
    <button type="button" aria-label="Desplazarse al contenido" class="hidden md:flex absolute bottom-6 z-10 flex-col items-start gap-2 animate-bounce cursor-pointer" style="left: 50%;" onclick="window.scrollBy({ top: window.innerHeight * 0.6, behavior: 'smooth' })">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest" style="transform: translateX(-50%);">SCROLL</p>
      <div class="h-8 bg-brand-black/20" style="width: 1px;"></div>
    </button>
  </section>

  <main id="main-content">

  <!-- Mobile info box — NE AGENTURA, above logo carousel -->
  <div class="md:hidden border border-brand-black bg-brand-black text-brand-white mx-6 my-8 p-6 flex flex-col gap-4">
    <div>
      <p class="font-mono font-medium tracking-widest bg-brand-white text-brand-black px-1 py-0.5 block w-full" style="font-size:12px;">NO SOMOS AGENCIA – ESPECIALISTAS</p>
    </div>
    <p class="font-mono text-sm text-brand-white/90 leading-relaxed text-justify">Somos un equipo de especialistas en UX. Ayudamos a las empresas a entender a sus usuarios mediante datos, investigación y eye tracking.</p>
    <div class="flex gap-2">
      <a href="/es/sobre-nosotros" class="font-mono text-xs border border-brand-white px-2 py-1">SOBRE NOSOTROS</a>
      <a href="/es/contacto" class="font-mono text-xs border border-brand-white px-2 py-1">CONTACTO</a>
    </div>
    <div class="border-t border-brand-white/20 pt-2 flex items-center justify-between">
      <p class="font-mono text-[11px] text-brand-white/75 tracking-widest">PROYECTO CON:</p>
      <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`} alt="Univerzita Hradec Králové" class="h-[40px] w-auto ml-6 my-1" style="filter: invert(1);" />
    </div>
  </div>

  <!-- LOGO STRIP -->
  <div class="border-y border-brand-black/10 py-6" style="background:#FDFDFD;">
    <!-- Desktop: statický pás -->
    <div class="hidden md:flex flex-wrap items-center justify-center gap-x-14 gap-y-6 px-6">
      {clientLogos.map(({ src, alt, w, h, dh }) => (
        <div class="px-4 py-1">
          <img
            src={src}
            alt={alt}
            title={alt}
            width={w} height={h}
            class="logo-strip-img select-none"
            style={`height:${dh || 42}px; width:auto; max-width:170px; object-fit:contain; display:block;`}
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
    <!-- Mobil: automatický carousel, dvě loga na řádek -->
    <div class="md:hidden overflow-hidden">
      <div class="logo-marquee flex items-center">
        {[...clientLogos, ...clientLogos].map(({ src, alt, w, h, dh }) => (
          <div class="flex-shrink-0 flex justify-center items-center px-4" style="width:50vw;">
            <img
              src={src}
              alt={alt}
              title={alt}
              width={w} height={h}
              class="logo-strip-img select-none"
              style={`height:${dh ? Math.round(dh * 36 / 42) : 36}px; width:auto; max-width:40vw; object-fit:contain; display:block;`}
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <style>
    .logo-strip-img {
      filter: grayscale(1);
      opacity: 0.65;
    }
    .logo-marquee {
      width: max-content;
      /* smyčka je jen vizuální (transform) — loga se stahují jednorázově a běží z cache */
      animation: logo-scroll 10s linear infinite;
    }
    @keyframes logo-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(-150vw); }
    }
    @media (prefers-reduced-motion: reduce) {
      .logo-marquee { animation: none; }
    }
  </style>

  <!-- TŘI OTÁZKY, TŘI MĚŘENÍ -->
  <section class="desktop-gutter-x pt-24 pb-12 max-w-7xl mx-auto">
    <div class="mb-12 max-w-3xl">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ TRES PREGUNTAS, TRES MEDICIONES ]</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">Qué ven los usuarios, cómo reaccionan<br/>y cuánto les cuesta<span style="color:#2D62FC">.</span></h2>
      <p class="text-sm text-brand-black/60 leading-relaxed">
        La analítica muestra DÓNDE hizo clic la gente. El cuestionario muestra QUÉ piensa. Nosotros medimos la tercera capa:
        qué vieron realmente, con qué intensidad reaccionaron y dónde la interfaz los sobrecargó mentalmente.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10">
      {[
        {
          q: '¿Siquiera lo ven?',
          desc: 'Atención visual — mapas de calor, fijaciones, TTFF, dwell time, análisis AOI y scanpaths. El eye tracking registra de forma objetiva lo que el usuario vio realmente y lo que pasó por alto.',
          tool: 'EYE-TRACKING',
        },
        {
          q: '¿Con qué intensidad reacciona?',
          desc: 'Activación fisiológica y señales faciales en el contexto de la tarea. Siempre interpretadas con sus límites — nada de «lectura de emociones».',
          tool: 'GSR + SEÑALES FACIALES',
        },
        {
          q: '¿Lo logra sin esfuerzo?',
          desc: 'La carga cognitiva como una única puntuación clara de 0 a 100. Descubrirá dónde la interfaz sobrecarga al usuario, aunque al final complete la tarea.',
          tool: 'MODELO EMLI',
        },
      ].map((item, i) => (
        <div class="bg-brand-white p-8 flex flex-col">
          <p class="font-mono text-xs text-brand-black/60 mb-8">0{i + 1}</p>
          <h3 class="font-display text-2xl font-bold mb-4 leading-tight">{item.q}</h3>
          <p class="text-sm text-brand-black/60 leading-relaxed mb-6 text-justify">{item.desc}</p>
          <p class="mt-auto"><span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{item.tool}</span></p>
        </div>
      ))}
    </div>
    <!-- Slovníček zkratek -->
    <details class="group border border-brand-black/15 mt-6">
        <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
          [ GLOSARIO ]
          <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <dl class="px-5 pb-6 space-y-4">
            <div><dt class="font-display font-bold mb-1">TTFF</dt><dd class="text-sm text-brand-black/70 leading-relaxed">tiempo hasta la primera fijación de la mirada</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">área de interés observada (Area of Interest)</dd></div>
            <div><dt class="font-display font-bold mb-1">dwell time</dt><dd class="text-sm text-brand-black/70 leading-relaxed">tiempo total pasado mirando el área</dd></div>
            <div><dt class="font-display font-bold mb-1">scanpath</dt><dd class="text-sm text-brand-black/70 leading-relaxed">recorrido de la mirada entre fijaciones</dd></div>
            <div><dt class="font-display font-bold mb-1">GSR</dt><dd class="text-sm text-brand-black/70 leading-relaxed">medición de la conductancia de la piel, indicador de activación fisiológica</dd></div>
            <div><dt class="font-display font-bold mb-1">EMLI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">índice de carga mental (cognitiva) derivado de métricas de eye tracking</dd></div>
        </dl>
      </details>
  </section>

  <!-- SERVICES SECTION -->
  <section class="desktop-gutter-x py-24 max-w-7xl mx-auto">
    <div class="mb-12 max-w-3xl">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ NUESTROS SERVICIOS ]</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">Qué hacemos<span style="color:#2D62FC">.</span></h2>
      <p class="text-sm text-brand-black/60 leading-relaxed">
