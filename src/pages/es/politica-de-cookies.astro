---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const updated = '28/07/2026';

const categories = [
  {
    name: 'Necesarias',
    consent: 'No requieren consentimiento',
    purpose: 'Funcionamiento básico del sitio — elección de idioma, seguridad y memorización de tu elección de cookies.',
    examples: 'uxmind-consent, uxmind_consent (almacenamiento del consentimiento), cookies técnicas del servidor',
    expiry: 'Sesión hasta 6 meses',
  },
  {
    name: 'Analíticas',
    consent: 'Solo con tu consentimiento',
    purpose: 'Estadísticas de tráfico anónimas — cuántas personas visitan el sitio y qué páginas leen. Nos ayudan a mejorar el sitio.',
    examples: 'Google Analytics 4 (_ga, _ga_*)',
    expiry: 'Hasta 24 meses',
  },
  {
    name: 'Marketing',
    consent: 'Solo con tu consentimiento',
    purpose: 'Remarketing y medición de la eficacia publicitaria — publicidad más relevante y medible.',
    examples: 'Google Ads (_gcl_*), cookies de conversión y remarketing',
    expiry: 'Hasta 24 meses',
  },
];
---

<BaseLayout
  lang="es"
  title="Política de cookies"
  description="Cómo UX MIND usa cookies: necesarias, analíticas y de marketing. Consentimiento según Google Consent Mode v2, el RGPD y la Ley n.º 127/2005 Rec. Modificable en cualquier momento."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-3xl mx-auto px-6">

      <div class="mb-12">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ INFORMACIÓN LEGAL ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.25rem, 6vw, 4.5rem);">
          Política de cookies<span style="color:#2D62FC">.</span>
        </h1>
        <p class="text-sm text-brand-black/50 font-mono">Última actualización: {updated}</p>
      </div>

      <div class="space-y-10 text-brand-black/70 leading-relaxed">

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-3">Qué son las cookies</h2>
          <p>
            Las cookies son pequeños archivos de texto que un sitio web guarda en tu navegador. Garantizan las
            funciones básicas del sitio, miden el tráfico y, cuando procede, apoyan el marketing. Algunas las
            establecemos nosotros y otras servicios de terceros (Google).
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-3">Cómo obtenemos el consentimiento</h2>
          <p class="mb-3">
            En tu primera visita mostramos un banner de cookies. Las cookies necesarias siempre se ejecutan —
            son imprescindibles para el funcionamiento del sitio. Las cookies analíticas y de marketing se
            activan <strong class="text-brand-black">solo tras tu consentimiento</strong>. El consentimiento
            es voluntario, granular y puede cambiarse o retirarse en cualquier momento.
          </p>
          <p>
            Usamos <strong class="text-brand-black">Google Consent Mode v2</strong>. Hasta que se otorga el
            consentimiento no se ejecuta ninguna cookie analítica ni publicitaria; las etiquetas de Google
            funcionan en modo sin cookies, sin almacenar identificadores. Actuamos conforme al Reglamento RGPD
            (UE) 2016/679 y al § 89 de la Ley n.º 127/2005 Rec. sobre comunicaciones electrónicas.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-5">Categorías de cookies</h2>
          <div class="space-y-px bg-brand-black/10 border border-brand-black/10">
            {categories.map(c => (
              <div class="bg-brand-white p-5">
                <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2">
                  <h3 class="font-mono text-sm tracking-widest uppercase text-brand-black">{c.name}</h3>
                  <span class="font-mono text-[10px] tracking-widest uppercase" style="color:#2D62FC">{c.consent}</span>
                </div>
                <p class="text-sm mb-2">{c.purpose}</p>
                <dl class="text-xs text-brand-black/50 space-y-0.5">
                  <div><dt class="inline font-mono">Ejemplos: </dt><dd class="inline">{c.examples}</dd></div>
                  <div><dt class="inline font-mono">Duración: </dt><dd class="inline">{c.expiry}</dd></div>
                </dl>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-3">Cambiar o retirar el consentimiento</h2>
          <p class="mb-4">
            Puedes cambiar tu configuración en cualquier momento — abre el panel y ajusta o retira tu
            consentimiento. Recordamos tu elección durante 6 meses, tras lo cual volvemos a preguntar. Las
            cookies también pueden eliminarse directamente en la configuración de tu navegador.
          </p>
          <button type="button" onclick="window.uxmindConsent && window.uxmindConsent.open()"
            class="inline-block font-mono text-xs tracking-widest uppercase bg-brand-black text-brand-white px-6 py-3 hover:bg-[#2D62FC] transition-colors">
            Abrir configuración de cookies →
          </button>
        </section>

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-3">Terceros</h2>
          <p>
            Las cookies analíticas y de marketing las trata Google (Google Analytics, Google Ads). Las
            condiciones y el tratamiento de datos se describen en la
            <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="underline hover:text-brand-black">Política de privacidad de Google ↗</a>.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-3">Responsable</h2>
          <p>
            UX MIND Research Lab s.r.o., N.º de identificación: 29714966.<br/>
            Preguntas sobre cookies y datos personales:
            <a href="mailto:spoluprace@uxmind.cz" class="underline hover:text-brand-black">spoluprace@uxmind.cz</a>.
          </p>
        </section>

      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
