---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="404 — stránka nenalezena"
  description="Stránka nebyla nalezena. Pokračujte na úvodní stránku UX Mind."
  noindex
  hreflang={false}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="mb-16">
        <p id="e404-tag" class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CHYBA 404 ]</p>
        <h1 id="e404-h1" class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          TADY NIC<br/>NEVIDÍME<span style="color:#2D62FC">.</span>
        </h1>
        <p id="e404-body" class="text-lg text-brand-black/60 leading-relaxed max-w-xl mb-4">
          A že se na pozornost díváme profesionálně. Stránka neexistuje, byla přesunuta — nebo jste narazili na překlep v odkazu.
        </p>
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-10">PAGE NOT FOUND / SEITE NICHT GEFUNDEN / PAGE INTROUVABLE / PÁGINA NO ENCONTRADA</p>
        <div class="flex flex-wrap gap-4">
          <a id="e404-home" href={`${base}/`} class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
            NA ÚVOD →
          </a>
          <a id="e404-services" href={`${base}/sluzby`} class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            NAŠE SLUŽBY
          </a>
          <a id="e404-contact" href={`${base}/kontakt`} class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            KONTAKT
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <!-- Lokalizace 404 podle jazyka v URL (jedna 404 obsluhuje celý web) -->
  <script is:inline define:vars={{ base }}>
    (function () {
      const rel = location.pathname.startsWith(base) ? location.pathname.slice(base.length) : location.pathname;
      const lang = rel.startsWith('/en') ? 'en' : rel.startsWith('/de') ? 'de' : rel.startsWith('/fr') ? 'fr' : rel.startsWith('/es') ? 'es' : 'cs';
      const T = {
        cs: { title: '404 — stránka nenalezena', tag: '[ CHYBA 404 ]', h1: 'TADY NIC<br/>NEVIDÍME<span style="color:#2D62FC">.</span>', body: 'A že se na pozornost díváme profesionálně. Stránka neexistuje, byla přesunuta — nebo jste narazili na překlep v odkazu.', home: 'NA ÚVOD →', homeHref: '/', services: 'NAŠE SLUŽBY', servicesHref: '/sluzby', contact: 'KONTAKT', contactHref: '/kontakt' },
        en: { title: '404 — page not found', tag: '[ ERROR 404 ]', h1: 'NOTHING<br/>TO SEE HERE<span style="color:#2D62FC">.</span>', body: 'And attention is literally our job. The page doesn’t exist, was moved — or you hit a typo in the link.', home: 'HOME →', homeHref: '/en/', services: 'OUR SERVICES', servicesHref: '/en/services', contact: 'CONTACT', contactHref: '/en/contact' },
        de: { title: '404 — Seite nicht gefunden', tag: '[ FEHLER 404 ]', h1: 'HIER GIBT ES<br/>NICHTS ZU SEHEN<span style="color:#2D62FC">.</span>', body: 'Und dabei ist Aufmerksamkeit unser Beruf. Die Seite existiert nicht, wurde verschoben — oder Sie sind auf einen Tippfehler im Link gestoßen.', home: 'STARTSEITE →', homeHref: '/de/', services: 'LEISTUNGEN', servicesHref: '/de/leistungen', contact: 'KONTAKT', contactHref: '/de/kontakt' },
        fr: { title: '404 — page introuvable', tag: '[ ERREUR 404 ]', h1: 'RIEN<br/>À VOIR ICI<span style="color:#2D62FC">.</span>', body: 'Et pourtant, l’attention, c’est notre métier. La page n’existe pas, a été déplacée — ou vous avez rencontré une faute de frappe dans le lien.', home: 'ACCUEIL →', homeHref: '/fr/', services: 'NOS SERVICES', servicesHref: '/fr/services', contact: 'CONTACT', contactHref: '/fr/contact' },
        es: { title: '404 — página no encontrada', tag: '[ ERROR 404 ]', h1: 'AQUÍ NO HAY<br/>NADA QUE VER<span style="color:#2D62FC">.</span>', body: 'Y eso que la atención es literalmente nuestro trabajo. La página no existe, se ha movido — o has dado con una errata en el enlace.', home: 'INICIO →', homeHref: '/es/', services: 'SERVICIOS', servicesHref: '/es/servicios', contact: 'CONTACTO', contactHref: '/es/contacto' },
      };
      const t = T[lang];
      if (lang !== 'cs') {
        document.documentElement.lang = lang;
        document.title = t.title;
        const set = (id, html) => { const el = document.getElementById(id); if (el) el.innerHTML = html; };
        set('e404-tag', t.tag);
        set('e404-h1', t.h1);
        set('e404-body', t.body);
      }
      const link = (id, label, href) => { const a = document.getElementById(id); if (a) { a.textContent = label; a.setAttribute('href', base + href); } };
      link('e404-home', t.home, t.homeHref);
      link('e404-services', t.services, t.servicesHref);
      link('e404-contact', t.contact, t.contactHref);
    })();
  </script>
</BaseLayout>
