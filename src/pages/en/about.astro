---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="en"
  title="About"
  description="A team of UX specialists focused on user research, eye tracking and UX audits. We help companies build better products."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ ABOUT ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          A TEAM<br/>OF EXPERTS<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 mb-24">
        <div>
          <p class="text-xl text-brand-black/60 leading-relaxed mb-6">
            UX Mind is two of us: a <strong class="text-brand-black">researcher</strong> and a <strong class="text-brand-black">strategist</strong>. We believe the best products come from a deep understanding of people.
          </p>
          <p class="text-brand-black/60 leading-relaxed">
            One measures in the lab, the other turns findings into websites, e-shops and campaigns. We combine advanced eye-tracking technology with proven UX research methods — for startups and enterprises that want to decide on data, not assumptions.
          </p>
        </div>
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ OUR VALUES ]</p>
          <ul class="space-y-4">
            {[{"title":"Data over impressions","desc":"Every recommendation backed by research."},{"title":"Empathy for users","desc":"We understand people, not just metrics."},{"title":"Practical recommendations","desc":"Outputs you can actually implement."},{"title":"Transparency","desc":"Clear communication of process and results."}].map(value => (
              <li class="border-b border-brand-black/10 pb-4">
                <p class="font-semibold mb-1">{value.title}</p>
                <p class="text-sm text-brand-black/60">{value.desc}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ WHO WE ARE ]</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10">

          <div class="bg-brand-white flex flex-col">
            <div class="border-b border-brand-black/10">
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/jan-petruzalek-analyza-eye-tracking-dat.webp`}
                alt="Ing. Jan Petružálek, Ph.D., author of the EMLI methodology, analysing eye-tracking data in the lab"
                title="Author of the EMLI methodology analysing eye-tracking data"
                width="1920" height="1280" loading="lazy" decoding="async"
                class="w-full aspect-[3/2] object-cover block"
              />
            </div>
            <div class="p-8 flex flex-col flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase mb-2" style="color:#2D62FC">RESEARCH & METHODOLOGY · AUTHOR OF EMLI</p>
              <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">Ing. Jan Petružálek, Ph.D.</h2>
              <p class="text-brand-black/60 leading-relaxed mb-4">
                A UX researcher with a doctorate from FIM UHK. In his dissertation he compared and combined user-experience measurement methods with eye-tracking technology and created the <strong class="text-brand-black">EMLI</strong> methodology — a cognitive load index computed from eye movement. Years of experiments in the FIMEYELAB lab, hundreds of respondents, publications in HCI and e-commerce.
              </p>
              <p class="text-brand-black/60 leading-relaxed mb-6">
                At UX MIND he leads research: designing experiments, guarding methodological rigour and developing EMLI on data from real projects.
              </p>
              <a href="https://www.linkedin.com/in/jan-petru%C5%BE%C3%A1lek-79167474/" target="_blank" rel="noopener noreferrer" class="mt-auto self-start inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                LINKEDIN ↗
              </a>
            </div>
          </div>

          <div class="bg-brand-white flex flex-col">
            <div class="border-b border-brand-black/10 aspect-[3/2] flex items-center justify-center"
              style="background-image: linear-gradient(rgba(10,10,10,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.06) 1px, transparent 1px); background-size: 20% 25%;">
              <p class="font-display text-6xl font-bold text-brand-black/20">LK</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase mb-2" style="color:#2D62FC">STRATEGY, WEB & MARKETING</p>
              <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">Mgr. Lukáš Koula</h2>
              <p class="text-brand-black/60 leading-relaxed mb-4">
                An e-commerce and digital marketing specialist. Certified <strong class="text-brand-black">Shoptet Partner</strong> and <strong class="text-brand-black">Google Partner</strong> — he builds e-shops and websites that sell, and runs performance campaigns in Google Ads and Sklik.
              </p>
              <p class="text-brand-black/60 leading-relaxed mb-6">
                At UX MIND he turns research into practice: from lab findings he makes concrete changes to websites, e-shops and campaigns that show up in conversions. He leads projects and client communication.
              </p>
              <a href="https://www.linkedin.com/in/lukaskoula/" target="_blank" rel="noopener noreferrer" class="mt-auto self-start inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                LINKEDIN ↗
              </a>
            </div>
          </div>

        </div>
      </div>

      <div class="text-center py-16 border-t border-brand-black/10">
        <h2 class="font-display text-4xl font-bold mb-6">Let’s work together</h2>
        <a href="/en/contact" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
          WRITE TO US →
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
