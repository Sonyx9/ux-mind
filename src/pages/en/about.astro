---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const vystupyMereni = [
  ['Attention', 'Which elements the user notices, in what order and what they miss entirely.'],
  ['Task progress', 'Where they move smoothly, where they go back and at which step they get stuck.'],
  ['Reactions', 'Where activation or mental load rises.'],
];

const vrstvy = [
  {
    t: 'Visual attention',
    d: 'Eye tracking shows where the user looks, in what order and what they miss entirely. We also find out how quickly they find an important element and how long they pay attention to it.',
    tag: 'EYE TRACKING',
  },
  {
    t: 'Emotional response',
    d: 'Skin conductance captures changes in physiological activation and facial analysis captures the facial expression. They help identify the moments that trigger a reaction — but on their own they don’t say why it arose.',
    tag: 'GSR + FACIAL EXPRESSION',
  },
  {
    t: 'Mental load',
    d: 'We measure where the interface requires more attention and effort. We reveal the places that slow users down, confuse them or needlessly complicate completing the task.',
    tag: 'MENTAL EFFORT',
  },
];

const vybaveni = [
  { nazev: 'Smart Eye Aurora', typ: 'desktop eye tracking', k: 'Precise gaze tracking when testing websites, apps and other digital interfaces.' },
  { nazev: 'Tobii Pro X2-60', typ: 'desktop eye tracking', k: 'A portable eye tracker for on-screen studies and comparing different variants.' },
  { nazev: 'Pupil Labs Neon (2×)', typ: 'mobile eye tracking', k: 'Glasses for tracking attention in stores, showrooms, at stadiums or on the shop floor.' },
  { nazev: 'iMotions + facial analysis', typ: 'research software', k: 'Connects eye tracking, facial expression and other signals into a single time-synchronised recording.' },
  { nazev: 'Shimmer3 GSR', typ: 'biometrics', k: 'Captures changes in skin conductance that indicate the level of physiological activation.' },
];

const postup = [
  { num: '01', title: 'Study design', desc: 'We clarify what you need to find out, who is worth testing and what we will evaluate the result against.' },
  { num: '02', title: 'Preparation and measurement', desc: 'We prepare the tasks, set up the equipment and carry out the measurement in the lab or directly in the field.' },
  { num: '03', title: 'Analysis', desc: 'We connect gaze, behaviour, reactions and participants’ statements. We look for connections, not isolated numbers without context.' },
  { num: '04', title: 'Recommendations for practice', desc: 'You get clear conclusions, priorities and concrete recommendations on what to change.' },
];

const rizika = [
  'correct calibration throughout the measurement',
  'participant fatigue',
  'the order of tasks, so it doesn’t affect the result',
  'a clear and unambiguous brief',
  'that the conclusion doesn’t rest on a single metric',
];

const etika = [
  'A standardised protocol and pilot validation of the study',
  'Informed consent from every participant',
  'Data processing in line with GDPR and, as needed, under NDA',
  'The option of anonymising the data and an output with documented methodology',
  'Review by an ethics committee if the nature of the project requires it',
];

const tymLaboratore = [
  ['02', 'Leadership and methodology'],
  ['01', 'Lab management'],
  ['08', 'Trained operators'],
];

const pageSchema = [
  {
    '@type': 'ResearchOrganization',
    name: 'FIMEYELAB',
    description:
      'The eye tracking and biometrics laboratory of the Faculty of Informatics and Management at the University of Hradec Králové. Measuring visual attention, emotional response and cognitive load in the lab and in the field.',
    parentOrganization: {
      '@type': 'CollegeOrUniversity',
      name: 'Univerzita Hradec Králové — Fakulta informatiky a managementu',
    },
  },
  {
    '@type': 'AboutPage',
    name: 'About us — the FIMEYELAB laboratory',
    description:
      'UX MIND measures at the FIMEYELAB laboratory at FIM UHK. Five measurement systems, eight academic publications, two defended dissertations.',
  },
];
---

<BaseLayout
  lang="en"
  title="The FIMEYELAB laboratory | Who is behind UX MIND"
  description="We do not measure in a meeting room. UX MIND measures at the FIMEYELAB laboratory at the Faculty of Informatics and Management, UHK — five measurement systems, eight academic publications, two defended dissertations."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ ABOUT / LAB ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          RESEARCH,<br/>NOT IMPRESSIONS<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-4xl">
          <div>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify mb-4">
              UX MIND combines experience with digital products and the research facilities of the
              <strong class="text-brand-black">FIMEYELAB</strong> laboratory at the Faculty of Informatics and Management
              of the University of Hradec Králové. Using eye tracking, user testing and biometric methods, we find out
              what people actually see, what they don’t understand and where they get lost when making decisions.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify">
              The result is not just heatmaps and charts. You get clear conclusions and concrete recommendations
              for a website, app, campaign or physical space.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/en/case-studies" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              CASE STUDIES
            </a>
          </div>
        </div>
      </div>

      <!-- Info strip -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['MEASUREMENT SYSTEMS', '5'],
          ['ACADEMIC PUBLICATIONS', '8'],
          ['DEFENDED DISSERTATIONS', '2'],
          ['WE MEASURE', 'Lab and field'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight text-xl">{v}</p>
          </div>
        ))}
      </div>

      <!-- Lab photo -->
      <div class="reveal mb-24 grid grid-cols-1 md:grid-cols-5 gap-8 items-start">
        <div class="md:col-span-2">
          <img
            src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
            alt="A respondent during measurement at a rig with an eye tracker in the FIMEYELAB laboratory"
            title="Measurement in the FIMEYELAB laboratory"
            width="1080" height="1920" loading="lazy" decoding="async"
            class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
          />
          <p class="font-mono text-[11px] text-brand-black/60 mt-2">
            The FIMEYELAB laboratory, Faculty of Informatics and Management, UHK.
          </p>
        </div>
        <div class="md:col-span-3">
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ MEASUREMENT IN PRACTICE ]</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold leading-tight mb-6">
            What we observe during testing<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-black/60 leading-relaxed text-justify mb-4">
            The eye tracker below the monitor records eye movement sixty times a second. A camera above the monitor
            captures facial reactions while the respondent completes a specific task on the tested page.
          </p>
          <p class="text-brand-black/60 leading-relaxed text-justify">
            By connecting gaze, behaviour and reactions we find out what the user noticed, what they overlooked
            and at which point they hesitated while completing the task.
          </p>
          <dl class="mt-8 border-t border-brand-black/10 pt-6 space-y-4">
            {vystupyMereni.map(([label, desc], i) => (
              <div class="flex gap-4">
                <span class="font-mono text-xs shrink-0 pt-0.5" style="color:#2D62FC;">0{i + 1}</span>
                <div>
                  <dt class="font-mono text-[11px] tracking-widest uppercase text-brand-black/70 mb-0.5">{label}</dt>
                  <dd class="text-sm text-brand-black/60 leading-relaxed">{desc}</dd>
                </div>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <!-- How it all fits together -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ HOW IT ALL FITS TOGETHER ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-8 max-w-3xl">
          A university laboratory, at a commercial pace<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          <div class="bg-brand-white p-6 md:p-8">
            <p class="font-mono text-xs text-brand-black/60 mb-6">01</p>
            <h3 class="font-display text-2xl font-bold mb-3">The FIMEYELAB laboratory</h3>
            <p class="text-brand-black/60 leading-relaxed text-sm text-justify">
              FIMEYELAB belongs to the University of Hradec Králové. It serves research, teaching and the supervision
              of master’s and doctoral theses — and in doing so it holds a methodological bar that a commercial operation would not set for itself.
            </p>
          </div>
          <div class="bg-brand-white p-6 md:p-8">
            <p class="font-mono text-xs text-brand-black/60 mb-6">02</p>
            <h3 class="font-display text-2xl font-bold mb-3">UX MIND</h3>
            <p class="text-brand-black/60 leading-relaxed text-sm text-justify">
              Commercial work in the laboratory always runs through UX MIND. We are the contractual partner with whom
              you sign the engagement, receive a deadline, a price and a deliverable — and who is accountable for the result.
            </p>
          </div>
          <div class="bg-brand-white p-6 md:p-8">
            <p class="font-mono text-xs text-brand-black/60 mb-6">03</p>
            <h3 class="font-display text-2xl font-bold mb-3">The link</h3>
            <p class="text-brand-black/60 leading-relaxed text-sm text-justify">
              Jan Petružálek is the head of the FIMEYELAB laboratory and, at the same time, a co-owner of UX MIND.
              So methodology and execution are not two worlds tossing things to each other over a fence.
            </p>
          </div>
        </div>
        <p class="text-brand-black/60 leading-relaxed text-justify mt-8 max-w-3xl">
          In practice, that means one thing for you: you get academic methodology without academic timelines.
          This is how we measured a careers portal for <strong class="text-brand-black">ŠKODA AUTO</strong>,
          a football club’s campaign and the product pages of e-shops.
        </p>
      </div>

      <!-- What we can measure -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WHAT WE CAN MEASURE ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Three layers of user experience<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {vrstvy.map((v, i) => (
            <div class="bg-brand-white p-8 flex flex-col">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed text-justify mb-6">{v.d}</p>
              <span class="mt-auto self-start font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          One metric is not enough. That’s why we connect gaze, task progress, reactions and the user’s account.
          Only their connection shows where the problem arises and what is worth changing.
        </p>
      </div>

      <!-- What we measure with -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WHAT WE MEASURE WITH ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Five systems for the lab and the field<span style="color:#2D62FC">.</span>
        </h2>
        <div class="border border-brand-black/10">
          {vybaveni.map(z => (
            <div class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-6 p-6 border-b border-brand-black/10 last:border-0">
              <div class="md:col-span-4">
                <p class="font-display text-lg font-bold leading-tight">{z.nazev}</p>
                <p class="font-mono text-[11px] text-brand-black/60 tracking-wide uppercase">{z.typ}</p>
              </div>
              <p class="md:col-span-8 text-sm text-brand-black/60 leading-relaxed">{z.k}</p>
            </div>
          ))}
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Two sets of mobile glasses let us measure more participants or situations in less time.
        </p>
      </div>

      <!-- Lab visualisation -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/laborator-ux-vyzkumu-vizualizace-1.webp`}
          alt="A visualisation of the planned layout of the FIMEYELAB laboratory"
          title="The planned layout of the laboratory"
          width="1600" height="1127" loading="lazy" decoding="async"
          class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">
          A visualisation of the planned layout of the laboratory — separate measurement stations for simultaneous testing.
        </p>
      </div>

      <!-- How measurement works -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ HOW MEASUREMENT WORKS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          From the question to a concrete recommendation<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
          {postup.map(step => (
            <div class="bg-brand-white p-6 md:p-8 flex flex-col">
              <p class="font-mono text-xs text-brand-black/60 mb-6">{step.num}</p>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
        <div class="mt-6 border border-brand-black/10 p-8 md:p-10">
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ WHAT THE PROTOCOL WATCHES FOR ]</p>
          <ul class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-x-8 gap-y-4 mb-8">
            {rizika.map(r => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed">
                <span class="font-mono text-xs pt-0.5 shrink-0" style="color:#2D62FC;">→</span> {r}
              </li>
            ))}
          </ul>
          <p class="text-sm text-brand-black/60 leading-relaxed max-w-3xl border-t border-brand-black/10 pt-6">
            As a result, the outcomes are comparable and the recommendations don’t come from chance or a single recording.
          </p>
        </div>
      </div>

      <!-- Academic background -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ ACADEMIC BACKGROUND ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Academic background in numbers<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          <div class="bg-brand-white p-8">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">PUBLICATIONS</p>
            <p class="font-display text-5xl font-bold mb-2">8</p>
            <p class="text-sm text-brand-black/60 leading-relaxed mb-6">
              academic publications focused on eye tracking and user experience.
            </p>
            <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-2">EXAMPLE PUBLICATION</p>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Franěk, M., &amp; Petružálek, J. (2025). <em>Perceptual fluency and eye movements when viewing
              urban and natural scenes.</em> Scientific Reports, 15(1), art. 25772.
            </p>
          </div>
          <div class="bg-brand-white p-8">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">RESEARCH AND EDUCATION</p>
            <ul class="space-y-3 text-sm text-brand-black/60 leading-relaxed">
              <li class="pb-3 border-b border-brand-black/5">
                <strong class="text-brand-black">2 defended dissertations</strong><br/>
                Jan Petružálek (2023) — combination of methods for measuring user experience using eye tracking<br/>
                Denis Šefara (2022) — using attention in the design of business dashboards
              </li>
              <li>
                <strong class="text-brand-black">8 defended master’s and bachelor’s theses</strong><br/>
                2 master’s theses, 6 bachelor’s theses
              </li>
            </ul>
          </div>
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Ongoing work on research topics allows us to validate, compare and develop the methods on various types of briefs.
        </p>
      </div>

      <!-- People -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ PEOPLE ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6 max-w-3xl">
          Two partners, a wider research team<span style="color:#2D62FC">.</span>
        </h2>
        <p class="text-brand-black/60 leading-relaxed max-w-3xl mb-10">
          UX MIND is led by two partners. Depending on the scope of the project, the lab leadership and trained
          operators also take part in the study design, measurement and data processing.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mb-px">

          <!-- Jan Petružálek -->
          <div class="bg-brand-white flex flex-col">
            <div class="border-b border-brand-black/10 aspect-[3/2] flex flex-col items-center justify-center text-center px-6" style="background-image: linear-gradient(rgba(10,10,10,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.06) 1px, transparent 1px); background-size: 20% 25%;">
              <p class="font-mono text-[10px] tracking-widest text-brand-black/40 mb-3">[ PHOTO IN PREPARATION ]</p>
              <p class="font-display text-lg md:text-xl font-bold text-brand-black/40 leading-snug max-w-xs">Jan Petružálek</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase mb-2" style="color:#2D62FC">HEAD OF THE FIMEYELAB LABORATORY · CO-OWNER OF UX MIND</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-4">Ing. Jan Petružálek, Ph.D.</h3>
              <p class="text-brand-black/60 leading-relaxed mb-6">
                He designs the research, oversees the course of measurement and is responsible for the analysis and
                interpretation of data. In his dissertation he focused on combining UX research methods with eye tracking.
                He publishes in the area of user experience and e-commerce.
              </p>
              <a href="https://www.linkedin.com/in/jan-petru%C5%BE%C3%A1lek-79167474/" target="_blank" rel="noopener noreferrer" class="mt-auto self-start inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                LINKEDIN ↗
              </a>
            </div>
          </div>

          <!-- Lukáš Koula -->
          <div class="bg-brand-white flex flex-col">
            <div class="border-b border-brand-black/10 aspect-[3/2] flex flex-col items-center justify-center text-center px-6" style="background-image: linear-gradient(rgba(10,10,10,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.06) 1px, transparent 1px); background-size: 20% 25%;">
              <p class="font-mono text-[10px] tracking-widest text-brand-black/40 mb-3">[ PHOTO IN PREPARATION ]</p>
              <p class="font-display text-lg md:text-xl font-bold text-brand-black/40 leading-snug max-w-xs">Lukáš Koula</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase mb-2" style="color:#2D62FC">STRATEGY, WEB AND MARKETING · CO-OWNER OF UX MIND</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-4">Mgr. Lukáš Koula</h3>
              <p class="text-brand-black/60 leading-relaxed mb-6">
                He translates research results into concrete recommendations for websites, e-shops and campaigns.
                He leads projects, client communication and connects research with business and marketing goals.
                He is a certified Shoptet Partner and Google Partner.
              </p>
              <a href="https://www.linkedin.com/in/lukaskoula/" target="_blank" rel="noopener noreferrer" class="mt-auto self-start inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                LINKEDIN ↗
              </a>
            </div>
          </div>
        </div>

        <!-- Laboratory team -->
        <div class="border border-brand-black/10 p-8 md:p-10">
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ THE LABORATORY TEAM ]</p>
          <div class="border border-brand-black/10 divide-y divide-brand-black/10 mb-6">
            {tymLaboratore.map(([pocet, role]) => (
              <div class="flex items-center gap-4 md:gap-6 px-4 py-4 md:px-6">
                <p class="font-mono text-[11px] text-brand-black/70 tracking-wide uppercase leading-snug w-28 md:w-44 shrink-0">{role}</p>
                <div class="flex flex-wrap gap-1.5 flex-1 min-w-0">
                  {Array.from({ length: Number(pocet) }).map(() => (
                    <span class="w-3.5 h-3.5 bg-brand-black" aria-hidden="true"></span>
                  ))}
                </div>
                <p class="font-mono text-[11px] text-brand-black/40 tabular-nums shrink-0 w-6 text-right">{pocet}</p>
              </div>
            ))}
          </div>
          <p class="text-sm text-brand-black/60 leading-relaxed max-w-3xl">
            Every measurement follows a consistent protocol and expert supervision. As a result, data collection stays
            consistent regardless of the composition of the delivery team.
          </p>
        </div>
      </div>

      <!-- Ethics and data -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ ETHICS AND DATA ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">
              Consent and data protection are part of the measurement<span style="color:#2D62FC">.</span>
            </h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Every participant knows in advance what we record, why we collect the data and how we will work with it.
            </p>
          </div>
          <ul class="space-y-2">
            {etika.map(e => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5 last:border-0">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {e}
              </li>
            ))}
          </ul>
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
