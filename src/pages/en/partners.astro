---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const partners = [{"num":"01","name":"Univerzita Hradec Králové","claim":"Where UXMIND lives.","logo":`${base}/logos/uhk.svg`,"logoAlt":"Logo of the University of Hradec Králové","logoClass":"h-16 md:h-20","text":["We don’t do research “in cooperation with academics” — we do it directly in the eye-tracking lab of the Faculty of Informatics and Management at UHK. A university base means calibrated equipment, methodological rigour and piloting before a single real data point is collected.","This is where our EMLI mental load index was born, and from here we head into the field too. Academic precision, commercial pace."],"tags":["FIM UHK","Lab","EMLI"],"links":[{"label":"UHK.CZ →","href":"https://www.uhk.cz"},{"label":"FACULTY OF INFORMATICS AND MANAGEMENT","href":"https://www.uhk.cz/cs/fakulta-informatiky-a-managementu"}]},{"num":"02","name":"MindSense","claim":"Science of attention.","logo":`${base}/logos/mindsense.png`,"logoAlt":"MindSense logo — solutions for research labs","logoClass":"h-10 md:h-12","text":["A technology partner that understands our lab — because it helped build it. MindSense expanded the UHK eye-tracking lab with new research equipment, and as the exclusive authorised Tobii distributor for the Czech Republic and Slovakia it keeps our technology world-class.","Biosensors, EEG, GSR, motion capture and eye tracking in virtual reality: when we need to measure something new, we know where to go for hardware, software and know-how."],"tags":["Tobii","Biosensors","VR"],"links":[{"label":"MINDSENSE.CZ →","href":"https://mindsense.cz"}]}];

const pageSchema = [
  {
    '@type': 'WebPage',
    name: "UXMIND project partners",
    description: "UXMIND project partners: University of Hradec Králové (research base of FIM UHK) and MindSense (technology for research labs, Tobii distributor).",
  },
];
---

<BaseLayout
  lang="en"
  title="Partners"
  description="UXMIND project partners: University of Hradec Králové — the research base of the FIM UHK lab, and MindSense — technology for research labs and Tobii distributor for CZ and SK."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ PROJECT PARTNERS ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          WE DON’T<br/>MEASURE ALONE<span style="color:#2D62FC">.</span>
        </h1>
        <p class="text-lg text-brand-black/60 leading-relaxed max-w-2xl">
          Behind every good measurement there’s a base, technology and people who understand it. UXMIND stands on two pillars — <strong class="text-brand-black">university research and top-tier technology</strong>.
        </p>
      </div>

      <div class="space-y-px border border-brand-black/10">
        {partners.map(p => (
          <div class="reveal p-8 md:p-12 border-b border-brand-black/10 last:border-0">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-10 items-start">
              <div class="flex flex-col gap-6">
                <span class="font-mono text-xs text-brand-black/60">{p.num}</span>
                <img src={p.logo} alt={p.logoAlt} class={`${p.logoClass} w-auto object-contain self-start`} loading="lazy" decoding="async" />
                <div class="flex flex-wrap gap-2">
                  {p.tags.map(tag => (
                    <span class="font-mono text-[11px] border border-brand-black/20 px-2 py-1 tracking-widest">{tag}</span>
                  ))}
                </div>
              </div>
              <div class="md:col-span-2">
                <h2 class="font-display text-3xl md:text-4xl font-bold mb-2">{p.name}</h2>
                <p class="font-mono text-xs text-brand-black/60 tracking-widest uppercase mb-6">{p.claim}</p>
                {p.text.map(t => (
                  <p class="text-brand-black/60 leading-relaxed mb-4 max-w-2xl">{t}</p>
                ))}
                <div class="flex flex-wrap gap-4 mt-6">
                  {p.links.map(l => (
                    <a href={l.href} target="_blank" rel="noopener noreferrer" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                      {l.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="reveal mt-24 grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
        {[{"t":"Base","d":"The FIM UHK lab — controlled conditions, calibration, piloting.","tag":"UHK"},{"t":"Technology","d":"Tobii, Shimmer GSR, Pupil Labs NEON and other biosensors kept current by MindSense.","tag":"MINDSENSE"},{"t":"Output","d":"You get a measurement that holds up — methodologically and technically.","tag":"UXMIND"}].map((v, i) => (
          <div class="bg-brand-white p-8">
            <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
            <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
            <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
            <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
          </div>
        ))}
      </div>

      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16 mt-24">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            WANT TO MEASURE<br/>WITH US<span style="color:#2D62FC">?</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            A university base and top technology are half the work. The other half starts with your brief.
          </p>
          <a href="/en/contact" class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
            GET IN TOUCH →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
