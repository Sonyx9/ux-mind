---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const partners = [
  {
    num: '01',
    name: 'Univerzita Hradec Králové',
    claim: 'Research base and methodology.',
    logo: `${base}/logos/uhk.svg`,
    logoW: 157,
    logoH: 37,
    logoAlt: 'Logo of the University of Hradec Králové',
    logoClass: 'h-16 md:h-20',
    text: [
      'In the Cognitive Studies Lab at FIM UHK we test digital and physical interfaces under controlled conditions and in the field. The facilities let us prepare the methodology, validate the scenario and connect eye tracking with other research methods.',
      'The research environment also includes academic publications, student work and the development of our own methods, including the EMLI mental load index.',
    ],
    tags: ['FIM UHK', 'Lab', 'EMLI'],
    links: [
      { label: 'UHK.CZ →', href: 'https://www.uhk.cz' },
      { label: 'FACULTY OF INFORMATICS AND MANAGEMENT', href: 'https://www.uhk.cz/cs/fakulta-informatiky-a-managementu' },
    ],
  },
  {
    num: '02',
    name: 'MindSense',
    claim: 'Technology and expert support.',
    logo: `${base}/logos/mindsense.webp`,
    logoW: 1118,
    logoH: 194,
    logoAlt: 'MindSense logo — solutions for research labs',
    logoClass: 'h-10 md:h-12',
    text: [
      'MindSense took part in expanding the lab with new research equipment and provides expert support for the technologies we use. It is the exclusive authorised Tobii distributor for the Czech Republic and Slovakia.',
      'It helps connect eye tracking, biosensors, virtual reality and software so that the individual data sources work as a single research whole.',
    ],
    tags: ['Tobii', 'Biosensors', 'VR'],
    links: [
      { label: 'MINDSENSE.CZ →', href: 'https://mindsense.cz' },
    ],
  },
];

const pageSchema = [
  {
    '@type': 'WebPage',
    name: 'UX MIND partners',
    description: 'UX MIND partners: the University of Hradec Králové provides research facilities and MindSense technological and expert support.',
  },
];
---

<BaseLayout
  lang="en"
  title="Project partners"
  description="UX MIND partners: the University of Hradec Králové provides research facilities and MindSense technological and expert support."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ PARTNERS ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          WE DON’T<br/>MEASURE ALONE<span style="color:#2D62FC">.</span>
        </h1>
        <p class="text-lg text-brand-black/60 leading-relaxed max-w-3xl">
          Quality research doesn’t rest on technology alone. It needs the right methodology, reliable equipment and people who can interpret the data. That’s why UX MIND connects <strong class="text-brand-black">the research facilities of FIM UHK with the technological know-how of MindSense</strong>.
        </p>
      </div>

      <!-- Partners -->
      <div class="space-y-px border border-brand-black/10">
        {partners.map(p => (
          <div class="reveal p-8 md:p-12 border-b border-brand-black/10 last:border-0">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-10 items-start">
              <!-- Logo -->
              <div class="flex flex-col gap-6">
                <span class="font-mono text-xs text-brand-black/60">{p.num}</span>
                <img src={p.logo} alt={p.logoAlt} width={p.logoW} height={p.logoH} class={`${p.logoClass} w-auto object-contain self-start`} loading="lazy" decoding="async" />
                <div class="flex flex-wrap gap-2">
                  {p.tags.map(tag => (
                    <span class="font-mono text-[11px] border border-brand-black/20 px-2 py-1 tracking-widest">{tag}</span>
                  ))}
                </div>
              </div>
              <!-- Text -->
              <div class="md:col-span-2">
                <h2 class="font-display text-3xl md:text-4xl font-bold mb-2">{p.name}</h2>
                <p class="font-mono text-xs text-brand-black/60 tracking-widest uppercase mb-6">{p.claim}</p>
                {p.text.map(t => (
                  <p class="text-brand-black/60 leading-relaxed mb-4 max-w-2xl">{t}</p>
                ))}
                <div class="flex flex-wrap gap-4 mt-6">
                  {p.links.map(l => (
                    <a href={l.href} target="_blank" rel="noopener noreferrer" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                      {l.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- How the collaboration fits into measurement -->
      <div class="reveal mt-24 grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          { t: 'Research base', d: 'The FIM UHK lab provides the conditions for preparing, piloting and running studies.', tag: 'UHK' },
          { t: 'Technological support', d: 'MindSense helps with the equipment, its integration and expert support.', tag: 'MINDSENSE' },
          { t: 'The result for the client', d: 'UX MIND turns the measured data into clear conclusions and concrete recommendations.', tag: 'UX MIND' },
        ].map((v, i) => (
          <div class="bg-brand-white p-8 flex flex-col h-full">
            <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
            <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
            <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
            <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest self-start mt-auto">{v.tag}</span>
          </div>
        ))}
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
