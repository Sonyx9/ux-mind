---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const faq = [
  { q: "How many participants are needed for an eye tracking study?", a: "For qualitative insights, 8–12 participants per segment is enough. For quantitative metrics (heatmaps, AOI statistics) we recommend 30 or more, and for calculating the EMLI cognitive load index we work with samples of over 100 participants." },
  { q: "How long does eye tracking testing take?", a: "A typical project takes 1–3 weeks from scenario approval: preparation and piloting, data collection in the lab or in the field, analysis and a report with prioritised recommendations." },
  { q: "Is eye tracking the same as neuromarketing?", a: "It is not. Eye tracking is an objective record of visual attention — we do not promise \"mind reading\" or emotions. We always interpret the data in the context of the task and with clearly stated limits of the method." },
  { q: "What does a heatmap show and what can't I read from it?", a: "A heatmap aggregates where participants looked most often. It does not tell you how demanding the interface was for them — which is why we complement it with AOI metrics (TTFF, dwell time) and the EMLI cognitive load index." },
];

const steps = [
  { num: '01', title: 'Preparation', desc: 'Test scenarios based on your goals and definition of AOI (Areas of Interest).' },
  { num: '02', title: 'Testing', desc: 'Users interact with the product while the eye tracker records their gaze.' },
  { num: '03', title: 'Analysis', desc: 'Heatmaps, gaze plots and AOI statistics from the collected data.' },
  { num: '04', title: 'Recommendations', desc: 'Specific changes to layout and content hierarchy.' },
];

const usecases = [
  { t: 'Websites', d: 'Where users spend time, what they overlook and why they don\'t respond to your CTAs.', tag: 'WEB' },
  { t: 'Mobile apps', d: 'Navigation, readability and usability of mobile products.', tag: 'APP' },
  { t: 'E-commerce', d: 'Product pages, basket and checkout for better conversions.', tag: 'E-SHOP' },
  { t: 'Print materials', d: 'Banners, posters, packaging — what attracts attention on physical materials.', tag: 'PRINT' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: "Eye tracking and user testing",
    description: "Measuring visual attention with eye tracking: heatmaps, AOI analysis, gaze recordings and user testing of websites, apps and print materials.",
    serviceType: 'Eye tracking',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="en"
  title="Eye tracking and attention heatmaps"
  description="Eye tracking of websites, apps and print materials: heatmaps, AOI analysis, gaze recordings and user testing in the FIM UHK lab. Find out what users actually see."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICES / EYE TRACKING ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          WE SEE WHAT<br/>YOU CAN'T<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">An objective record of visual attention.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              Eye tracking reveals precise data on how users perceive your content.
              We know <strong class="text-brand-black">where they look, what they overlook and what catches their eye</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="/en/contact" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              BOOK A TEST →
            </a>
            <a href="/en/services/test-packages" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              TEST PACKAGES
            </a>
          </div>
        </div>
      </div>

      <!-- Info strip -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURATION', '1–3 weeks'],
          ['TECHNOLOGY', 'Tobii Pro · Smart Eye'],
          ['OUTPUTS', 'Heatmaps · AOI · gaze plots'],
          ['PACKAGE', 'Standard UX test'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Photo from a measurement session -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
          alt="Participant during an eye tracking session in the lab — watching the test stimulus on a monitor with an eye tracker"
          title="An eye tracking session in progress in the lab"
          width="1080" height="1920" loading="lazy" decoding="async"
          class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Collecting visual attention data in the lab — the gaze recording is stored for AOI analysis and heatmaps.</p>
      </div>

      <!-- Where we can help -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WHERE WE CAN HELP ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Screen, paper and shelf<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
          {usecases.map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-xl font-bold mb-3 leading-tight">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-sm text-brand-black/60 leading-relaxed mt-4">
          Outside the lab we measure with mobile glasses — see <a href="/en/services/field-research" class="underline hover:no-underline">field research</a>.
        </p>
      </div>

      <!-- How it works + EMLI -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ HOW IT WORKS ]</p>
          <div class="space-y-0">
            {steps.map(step => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="border border-brand-black/10 p-8 flex flex-col justify-between">
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ EXTRA: THE EMLI INDEX ]</p>
            <h3 class="font-display text-2xl font-bold mb-3">Gaze + load in one score<span style="color:#2D62FC">.</span></h3>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              From eye-tracking metrics we compose the EMLI mental load index (0–100).
              Compare which variants or steps cost your users the most effort.
            </p>
          </div>
          <p class="font-display font-bold leading-none mt-6" style="font-size: clamp(2.5rem, 5vw, 4rem); color:#2D62FC;">0–100</p>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ FREQUENTLY ASKED QUESTIONS ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            WHAT DO YOUR<br/>USERS SEE<span style="color:#2D62FC">?</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            Send us your website, app or creative. We'll propose a measurement scenario and tell you what can be safely concluded from it.
          </p>
          <a href="/en/contact" class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
            BOOK A TEST →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
