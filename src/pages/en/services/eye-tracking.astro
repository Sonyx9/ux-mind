---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const attentionSignals = [
  { title: 'What people see first', desc: 'We measure which element gets the first look and in what order people go through the content.' },
  { title: 'What goes unnoticed', desc: 'We reveal important information, offers or controls that the gaze never reaches.' },
  { title: 'Where people search and go back', desc: 'Repeated looks and long searching show places where the visual hierarchy doesn’t guide users clearly enough.' },
  { title: 'Which variant works better', desc: 'We compare designs by the same metrics and show which variant better directs attention to important content.' },
];

const outputs = [
  { title: 'Heatmaps and gaze recordings', desc: 'They clearly show the distribution of attention and the eye path of a specific participant.' },
  { title: 'Metrics of the tracked areas', desc: 'For important elements we measure the first fixation, the number of returns and the time attention is given.' },
  { title: 'Links to the task', desc: 'We connect the gaze with success, time, errors and participants’ statements.' },
  { title: 'Priorities and recommendations', desc: 'We turn the results into concrete changes to content, layout and visual hierarchy.' },
];

const steps = [
  { num: '01', title: 'Research question', desc: 'We clarify the decision the data should support and choose a suitable scope for the study.' },
  { num: '02', title: 'Scenario and piloting', desc: 'We prepare the tasks and the tracked areas and, before collection, verify that the measurement works correctly.' },
  { num: '03', title: 'Data collection', desc: 'We calibrate and measure in the lab or field according to a consistent protocol.' },
  { num: '04', title: 'Analysis and recommendations', desc: 'We connect the gaze with the task context and turn the results into priorities for practice.' },
];

const technology = [
  { name: 'Smart Eye Aurora', type: 'LAB MEASUREMENT', desc: 'A desktop eye tracker for controlled studies of websites, apps and other digital interfaces.' },
  { name: 'Tobii Pro X2-60', type: 'PORTABLE SETUP', desc: 'A 60 Hz eye tracker for on-screen measurement and comparing variants.' },
  { name: 'Pupil Labs Neon (2×)', type: 'MOBILE GLASSES', desc: 'Two sets for tracking attention in stores, showrooms, at stadiums or on the shop floor.' },
];

const studies = [
  { href: '/en/case-studies/ad-banners-gaze-direction', result: 'Attention followed the gaze', title: 'Where the character on the banner looks, the customer looks too.', meta: 'EYE TRACKING · N = 104' },
  { href: '/en/case-studies/product-photography-e-commerce', result: 'The photo slowed the decision', title: 'The lifestyle photo looked better but lengthened the shopping task.', meta: 'EYE TRACKING + UEQ · N = 84' },
  { href: '/en/case-studies/billboards-sports-marketing', result: 'A comparison of 16 designs', title: 'Instead of a vote, we compared the billboards on 79 people.', meta: 'EYE TRACKING + SURVEY · N = 79' },
];

const faq = [
  { q: 'What is eye tracking and how does it work?', a: 'Eye tracking uses a specialised camera to record where a person looks, in what order and for how long. From the eye movement we create a gaze recording and metrics of visual attention.' },
  { q: 'What can eye tracking find out?', a: 'We find out what people notice first, which elements they overlook, where they search and how attention changes between variants. We always evaluate the result in the context of the specific task.' },
  { q: 'What’s the difference between eye tracking and a heatmap from web analytics?', a: 'An analytics heatmap usually works from clicks or cursor movement. Eye tracking records the participant’s actual direction of gaze. Even an eye heatmap alone is not enough, though, so we complement it with other metrics and the course of the task.' },
  { q: 'How many participants are needed for eye tracking?', a: 'The number depends on the goal of the study, the number of target groups and whether we’re looking for qualitative problems or comparing variants. We propose a suitable sample only based on the research question; there is no single universal number.' },
  { q: 'How long does an eye tracking study take and how much does it cost?', a: 'A typical study takes about 1–3 weeks. The price depends on the number of participants, the environment, the scope of stimuli and the required outputs. After an initial brief we prepare a concrete proposal and price.' },
  { q: 'Does the measurement have to take place in the lab?', a: 'No. We most often measure websites, apps and visuals on screen in the lab. For stores, services, events or other real environments we use mobile eye-tracking glasses.' },
  { q: 'Does eye tracking measure emotions or mental load?', a: 'Eye tracking itself measures visual attention, not specific emotions. Depending on the goal of the study we can complement it with biometric methods and with EMLI, our supplementary mental load index derived from selected eye metrics.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: "Eye tracking and user testing",
    description: "Measuring visual attention with eye tracking: heatmaps, AOI analysis, gaze recordings and user testing of websites, apps and print materials.",
    serviceType: 'Eye tracking',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="en"
  title="Eye tracking and attention heatmaps"
  description="Eye tracking of websites, apps and print materials: heatmaps, AOI analysis, gaze recordings and user testing in the FIM UHK lab. Find out what users actually see."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICES / EYE TRACKING ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          MEASURE<br/>ATTENTION<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-3xl">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Find out what people actually see.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify mb-4">
              Eye tracking records where people look while working with a website, app or visual, in what order and for how long. It reveals elements that attract attention as well as important information that goes unnoticed.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify">
              We connect the data with the course of the task and turn it into <strong class="text-brand-black">concrete recommendations for content, layout and visual hierarchy</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/en/contact" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              REQUEST EYE TRACKING →
            </a>
            <a href="/en/services#testovaci-balicky" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              VIEW PACKAGES
            </a>
          </div>
        </div>
      </div>

      <!-- Info strip -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURATION', '1–3 weeks'],
          ['ENVIRONMENT', 'Lab and field'],
          ['OUTPUTS', 'Heatmaps · AOI · gaze plots'],
          ['PACKAGE', 'Eye tracking and biometrics'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Photo from a measurement session -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
          alt="A participant during an eye tracking session in the lab — watching the test stimulus on a monitor with an eye tracker"
          title="An eye tracking session in progress in the lab"
          width="1080" height="1920" loading="lazy" decoding="async"
          class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">A controlled eye-tracking study in the lab — every recording starts with calibration and follows a prepared scenario.</p>
      </div>

      <!-- What we can measure -->
      <div class="reveal mb-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.35fr] gap-10 lg:gap-16">
          <div>
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ WHAT WE CAN MEASURE ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              Attention is not an impression. It’s a data trail<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <div class="border-t border-brand-white/20">
            {attentionSignals.map((signal, i) => (
              <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_13rem_1fr] gap-x-4 gap-y-2 py-6 border-b border-brand-white/20">
                <span class="font-mono text-xs text-brand-white/50 pt-1">0{i + 1}</span>
                <h3 class="font-display text-lg font-bold leading-tight">{signal.title}</h3>
                <p class="col-start-2 sm:col-start-3 text-sm text-brand-white/65 leading-relaxed">{signal.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Outputs -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-16">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WHAT YOU GET ]</p>
          <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight max-w-xl">
            Not just a heatmap. A basis for decisions<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-black/60 leading-relaxed mt-6 max-w-xl text-justify">
            A picture with colourful spots alone is not enough. We interpret every output according to the task, compare it with participant behaviour and turn it into changes you can use in practice.
          </p>
        </div>
        <div class="border-t border-brand-black/20">
          {outputs.map((output, i) => (
            <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_13rem_1fr] gap-x-4 gap-y-2 py-6 border-b border-brand-black/20">
              <span class="font-mono text-xs text-brand-black/50 pt-1">0{i + 1}</span>
              <h3 class="font-display text-lg font-bold leading-tight">{output.title}</h3>
              <p class="col-start-2 sm:col-start-3 text-sm text-brand-black/60 leading-relaxed">{output.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Process -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ HOW THE MEASUREMENT WORKS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          From the question to a defensible conclusion<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
          {steps.map(step => (
            <div class="border-t border-brand-black/20 pt-5">
              <span class="block font-mono text-xs text-brand-black/60 mb-5">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Technology -->
      <div class="reveal mb-24 border border-brand-black/15 p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.75fr_1.4fr] gap-10 lg:gap-16 mb-10">
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ TECHNOLOGY ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              Lab and field<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <p class="text-brand-black/60 leading-relaxed text-justify max-w-2xl">
            We choose the equipment by the environment and the research question. We use desktop systems for precisely controlled on-screen studies, and mobile glasses to measure attention during real movement and decision-making in a space.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-10">
          {technology.map(tool => (
            <div class="border-t border-brand-black/20 pt-5">
              <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-4">{tool.type}</p>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{tool.name}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{tool.desc}</p>
            </div>
          ))}
        </div>
        <p class="font-mono text-[11px] text-brand-black/60 tracking-wide mt-10 pt-5 border-t border-brand-black/10">
          FIMEYELAB research facilities · Faculty of Informatics and Management, University of Hradec Králové
        </p>
      </div>

      <!-- EMLI -->
      <div class="reveal mb-24 border border-brand-black/15 p-8 md:p-12">
        <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1.6fr)_minmax(240px,1fr)] md:items-center gap-10 md:gap-16">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ OPTIONAL: THE EMLI MENTAL LOAD INDEX ]</p>
            <h2 class="font-display text-2xl md:text-4xl font-bold mb-4">Where the interface demands the most effort<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed text-justify mb-4">
              EMLI converts selected eye-tracking indicators into a score from 0 to 100. It makes it possible to compare individual screens, steps or variants and determine where processing information is more demanding.
            </p>
            <p class="text-sm text-brand-black/60 leading-relaxed text-justify">
              <strong class="text-brand-black">The higher the score, the greater the load.</strong> We continuously validate EMLI and use it as a complementary interpretive layer, not as standalone proof.
            </p>
          </div>
          <div aria-label="EMLI scale from lower to higher mental load">
            <div class="h-2 mb-4 bg-gradient-to-r from-brand-black/10 via-brand-blue/50 to-brand-blue" aria-hidden="true"></div>
            <div class="flex items-start justify-between gap-6 font-mono text-[10px] tracking-widest uppercase">
              <p><strong class="block font-display text-4xl leading-none mb-2" style="color:#2D62FC">0</strong>Lower load</p>
              <p class="text-right"><strong class="block font-display text-4xl leading-none mb-2" style="color:#2D62FC">100</strong>Higher load</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Studies -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ EYE TRACKING IN PRACTICE ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Decisions backed by measurement<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {studies.map(study => (
            <a href={study.href} class="group border border-brand-black/15 p-7 min-h-72 flex flex-col hover:bg-brand-black hover:text-brand-white transition-colors">
              <p class="font-display text-xl font-bold leading-tight mb-6" style="color:#2D62FC">{study.result}</p>
              <h3 class="font-display text-2xl font-bold leading-tight mb-8">{study.title}</h3>
              <div class="mt-auto">
                <p class="font-mono text-[10px] tracking-widest opacity-60 mb-4">{study.meta}</p>
                <span class="font-mono text-xs tracking-widest">VIEW STUDY →</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ FREQUENTLY ASKED QUESTIONS ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
