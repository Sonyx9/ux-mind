---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const packages = [
  {
    num: '01',
    id: 'rychla-diagnostika',
    title: 'Quick UX audit',
    tagline: 'A quick expert review that reveals the main problems of a website or app.',
    chips: ['Expert UX audit', 'Key screens', 'Fix priorities'],
    findings: 'Where the interface may confuse users, what complicates completing a task and which shortcomings make sense to address first.',
    forWho: 'For teams who need to quickly check a website, e-shop, app or form. Useful before a redesign, during a drop in conversions or as a basis for further changes.',
    inside: 'An expert review of the key pages and user journeys. We assess their clarity, navigation, content, visual hierarchy and the barriers to completing a task.',
    limits: 'The audit does not work with measurement of real users. It reveals likely problems and sets priorities that can then be verified with user testing.',
    output: 'An overview of the main problems, concrete examples and recommended changes sorted by importance.',
  },
  {
    num: '02',
    id: 'standardni-ux-test',
    title: 'User testing',
    tagline: 'We watch how real users move through the interface and where they get stuck while completing tasks.',
    chips: ['Testing with users', 'Task scenarios', 'Interviews', 'Surveys'],
    findings: 'Whether users can handle important tasks, where they make mistakes, what they don’t understand and which variant is easier to use.',
    forWho: 'For teams who need to verify a specific user journey, a new design or a prototype with real users. Suitable for websites, apps, e-shops and forms.',
    inside: 'Guided testing with users based on prepared tasks. We track success, time, errors and the way they work with the interface. We complement the behaviour with an interview and, as needed, a survey.',
    limits: 'The test shows what users did and how they explain their behaviour. It does not measure precise eye movement or physiological response — premium lab measurement serves those questions.',
    output: 'The results of the individual tasks, the main barriers, examples of user behaviour and recommendations sorted by impact.',
  },
  {
    num: '03',
    id: 'komplexni-biometricky-vyzkum',
    title: 'Eye tracking and biometrics',
    tagline: 'Premium lab measurement for important decisions you need to back with multiple sources of data.',
    chips: ['Everything in 02', 'GSR', 'Facial signals', 'EMLI', 'Workshop'],
    findings: 'What users actually saw, how they proceeded and at which moments their physiological or mental load rose.',
    forWho: 'For decisions that are expensive, hard to reverse or must stand up in front of leadership, an investor or a client. Suitable for major redesigns, key campaigns, product innovations, HMI, retail situations or research where behaviour alone is not enough.',
    inside: 'We complement user testing with eye tracking and, per brief, also GSR, facial signal analysis, a retrospective interview over the gaze recording or mental load measurement using the EMLI model.',
    limits: 'We do not interpret biometric data in isolation. GSR does not tell you whether a reaction is positive or negative, and facial signals are not standalone “emotion reading”. They only make sense in combination with the task, the scenario, eye tracking and the participant’s own account.',
    output: 'An extended research report, integration of the individual data sources, an explanation of the critical moments, recommendations for changes and a workshop on the results.',
    featured: true,
  },
  {
    num: '04',
    id: 'terenni-studie',
    title: 'Field study',
    tagline: 'We observe behaviour where it actually happens — in a store, a place of business or another physical space.',
    chips: ['Field observation', 'Video recording', 'Interviews', 'Mobile eye tracking'],
    findings: 'How people move through a real environment, what they notice, what they pass by and where they stop.',
    forWho: 'For situations where decision-making doesn’t happen only on a screen. Typically in a store, showroom, with a physical product, at an event, in a work environment or in an automotive/HMI context.',
    inside: 'Observation and video recording of the situation, interviews and analysis of behaviour in the real environment. Depending on the research question we can also bring in Pupil Labs NEON mobile eye-tracking glasses or GSR.',
    limits: 'Field research offers a more natural situation, but less control over conditions than the lab. That is why we always determine in advance which conclusions can be safely drawn from field measurement and which should be verified under more controlled conditions.',
    output: 'Video analysis, mapping of key moments, visualisation of attention in the environment, a summary of barriers and recommendations for adjusting the space, communication or customer journey.',
  },
];

const outputs = [
  {
    title: 'Main findings',
    desc: 'An overview of problems, task results and visualisations matching the chosen package.',
  },
  {
    title: 'Explanation of the context',
    desc: 'We show what happened, why it matters and what can be safely concluded from the results.',
  },
  {
    title: 'Priorities and next steps',
    desc: 'Recommended changes sorted by impact and effort. For larger studies also a joint workshop on the results.',
  },
];

const process = [
  { num: '01', title: 'Goal', desc: 'We clarify what you need to find out and what decision the research should support.' },
  { num: '02', title: 'Design', desc: 'We recommend a suitable package, methods, scope and participants.' },
  { num: '03', title: 'Preparation', desc: 'We prepare the scenario, materials and, as needed, a pilot validation.' },
  { num: '04', title: 'Execution', desc: 'We run the audit, user testing or measurement in the lab or field.' },
  { num: '05', title: 'Results', desc: 'We evaluate the data and turn it into concrete recommendations.' },
];

const audiences = [
  'Product & UX',
  'Marketing',
  'E-commerce',
  'Retail & services',
  'Leadership',
];

const faq = [
  {
    q: 'What’s the difference between a UX audit and user testing?',
    a: 'A UX audit is carried out by a specialist without participants and quickly reveals likely interface problems. In user testing we observe real users completing specific tasks. That way we verify where they really get stuck, make mistakes or don’t understand something.',
  },
  {
    q: 'What’s the difference between user testing and eye tracking?',
    a: 'User testing shows whether people can handle important tasks and how they work with the interface. Eye tracking additionally measures their gaze precisely — what they saw, what they overlooked and in what order they looked at elements. That’s why we use it as a premium method for questions that observation alone cannot answer.',
  },
  {
    q: 'How does eye tracking differ from a heatmap in web analytics?',
    a: 'An analytics heatmap usually works with clicks, cursor movement or page scrolling. Eye tracking measures the user’s actual gaze. That way it also captures elements a person noticed but did not click on — or places they overlooked entirely.',
  },
  {
    q: 'How many participants are needed for user testing?',
    a: 'The number depends on the research goal, the diversity of the target group and the method of evaluation. For uncovering problems we often work with a smaller sample. For a reliable comparison of variants or statistical conclusions a larger sample is needed. We recommend the specific number based on the research question.',
  },
  {
    q: 'How much does a UX audit or user testing cost?',
    a: 'The price depends on the scope, the number of journeys or variants tested, the number of participants, the methods used and the form of the output. After a short brief we recommend a suitable scope and prepare a no-obligation quote.',
  },
  {
    q: 'Does testing have to take place in the lab?',
    a: 'No. We can test a website, app or prototype in the lab or remotely depending on the project goal. Behaviour in a store, a place of business or another physical space we observe directly in the field.',
  },
  {
    q: 'How do you protect participant data?',
    a: 'Before testing we define the purpose of processing and obtain informed consent from every participant. We secure the data and, as standard, prepare the outputs in aggregated or pseudonymised form. We set the specific regime according to the sensitivity of the project, client requirements and GDPR.',
  },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'UXMIND test packages',
    description: 'UX research test packages: a quick UX audit, user testing, premium eye tracking with biometrics and field studies.',
    serviceType: 'UX testing',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="en"
  title="UXMIND test packages | Eye tracking, biometrics and UX research"
  description="Choose the scope of UX testing by what you need to find out. A quick UX audit, user testing, eye tracking with biometrics and field studies."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-12">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ TEST PACKAGES ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          SELECT THE SCOPE<br/>OF TESTING<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">By what you need to find out.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              Sometimes it’s enough to quickly reveal the main barriers. Other times you need to compare variants or back an important decision with multiple sources of data. We recommend a scope that matches your goal, your environment and the level of certainty you need.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="#balicky" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              VIEW PACKAGES ↓
            </a>
            <a href="/en/contact" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              ADVICE ON CHOOSING →
            </a>
          </div>
        </div>
      </div>

      <!-- Scope scale: quick picker -->
      <div class="mb-16">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
          {packages.map(pkg => (
            <a href={`#${pkg.id}`} class="group bg-brand-white p-5 hover:bg-brand-black hover:text-brand-white transition-colors">
              <div class="flex justify-between items-start mb-4">
                <span class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/60">{pkg.num}</span>
                <span class="font-mono text-xs opacity-0 group-hover:opacity-100 transition-opacity">↓</span>
              </div>
              <p class="font-display font-bold leading-tight">{pkg.title}</p>
            </a>
          ))}
        </div>
        <!-- Scope axis -->
        <div class="flex items-center gap-3 mt-3 font-mono text-[10px] text-brand-black/60 tracking-widest uppercase">
          <span>Smaller scope</span>
          <span class="flex-1 h-px bg-gradient-to-r from-brand-black/20 to-brand-black"></span>
          <span>More detailed research</span>
        </div>
      </div>

      <!-- Credibility strip -->
      <div class="reveal mb-24 border-y border-brand-black/10 py-4 overflow-hidden">
        <p class="font-mono text-[11px] text-brand-black/60 tracking-wider whitespace-nowrap md:whitespace-normal overflow-x-auto">
          FIM UHK research facilities · Tobii Pro X2-60 · Smart Eye Aurora · Pupil Labs NEON · iMotions CORE · BeSigma · Shimmer3 GSR · lab and field measurement
        </p>
      </div>

      <!-- Why eye tracking alone isn't enough — three layers -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WHY EYE TRACKING ALONE ISN’T ENOUGH ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Attention ≠ understanding ≠ conversion<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {[
            { t: 'What they saw', d: 'Eye tracking shows what the user actually sees and what they pass by.', tag: 'GAZE' },
            { t: 'What they did', d: 'Did they complete the task? How long did it take and where did they make a mistake?', tag: 'BEHAVIOUR' },
            { t: 'Why', d: 'How they rated the interface and what they could explain in hindsight.', tag: 'ACCOUNT' },
          ].map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-sm text-brand-black/60 leading-relaxed mt-4 max-w-2xl">
          Only combining all three layers distinguishes a problem that merely attracts the gaze from a problem that prevents completing the task.
        </p>
      </div>

      <!-- Packages -->
      <div id="balicky" class="mb-24 scroll-mt-28">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ OUR TEST PACKAGES ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-4">Four configurations<span style="color:#2D62FC">.</span></h2>
        <p class="text-brand-black/60 leading-relaxed max-w-2xl mb-12">
          These are not fixed products — we adapt them to the brief. With each one you know in advance what you’ll get and what <strong class="text-brand-black">cannot be reliably claimed</strong> from that scope.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          {packages.map(pkg => (
            <div id={pkg.id} class={`reveal p-8 md:p-10 flex flex-col scroll-mt-28 ${pkg.featured ? 'bg-brand-black text-brand-white' : 'bg-brand-white'}`}>
              <div class="flex justify-between items-start mb-6">
                <span class={`font-mono text-xs ${pkg.featured ? 'text-brand-white/60' : 'text-brand-black/60'}`}>{pkg.num}</span>
                {pkg.featured && (
                  <span class="font-mono text-[10px] tracking-widest px-2 py-1" style="background:#2D62FC; color:#FCFCFC;">PREMIUM MEASUREMENT</span>
                )}
              </div>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-3 leading-tight">{pkg.title}</h3>
              <p class={`leading-relaxed mb-6 ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>{pkg.tagline}</p>

              <div class="flex flex-wrap gap-2 mb-6">
                {pkg.chips.map(chip => (
                  <span class={`font-mono text-[11px] px-2 py-1 tracking-wide border ${pkg.featured ? 'border-brand-white/30 text-brand-white/80' : 'border-brand-black/20 text-brand-black/70'}`}>{chip}</span>
                ))}
              </div>

              <p class={`text-sm leading-relaxed mb-6 ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>
                <span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>You learn</span>
                {pkg.findings}
              </p>

              <details class={`group mt-auto border-t pt-4 ${pkg.featured ? 'border-brand-white/20' : 'border-brand-black/10'}`}>
                <summary class="flex justify-between items-center cursor-pointer font-mono text-xs tracking-widest uppercase list-none [&::-webkit-details-marker]:hidden">
                  PACKAGE DETAIL
                  <span class="font-mono text-lg transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <div class={`mt-4 space-y-4 text-sm leading-relaxed ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Who it’s for</span>{pkg.forWho}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>What’s inside</span>{pkg.inside}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Good to know</span>{pkg.limits}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Typical output</span>{pkg.output}</p>
                </div>
              </details>
            </div>
          ))}
        </div>

        <!-- Custom package -->
        <div id="na-miru" class="reveal relative overflow-hidden bg-brand-black text-brand-white p-8 md:p-12 mt-px scroll-mt-28">
          <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
          <div class="relative flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div>
              <p class="font-mono text-xs text-brand-white/60 mb-2">05</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-3">Custom package<span style="color:#2D62FC">.</span></h3>
              <p class="text-brand-white/70 leading-relaxed max-w-xl">
                First we get to know your business, goals and context — then we design testing and the follow-up optimisation tailored to you. From the research question through the right combination of methods to concrete changes that show up in the results. We compose around the decision that will be made from the data, not around the lab’s equipment.
              </p>
            </div>
            <a href="/en/contact" class="shrink-0 inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              I’M NOT SURE WHICH TO PICK →
            </a>
          </div>
        </div>
      </div>

      <!-- EMLI -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="grid grid-cols-1 md:grid-cols-[minmax(0,2fr)_minmax(240px,1fr)] md:items-center gap-10 md:gap-16">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ EMLI: THE MENTAL LOAD INDEX ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">Where the interface demands the most effort<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed mb-4">
              EMLI converts selected eye-tracking indicators into a score from 0 to 100. This lets us compare individual screens, steps or variants and determine where processing information is more demanding for users.
            </p>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              <strong class="text-brand-black">The higher the score, the greater the load.</strong> We always evaluate the result together with the user’s behaviour and other data, not as a standalone verdict.
            </p>
          </div>
          <div aria-label="EMLI scale from lower to higher mental load">
            <div class="emli-scale h-2 mb-4" aria-hidden="true">
              <div class="emli-fill"></div>
            </div>
            <div class="flex items-start justify-between gap-6 font-mono text-[10px] tracking-widest uppercase">
              <p><strong class="block font-display text-3xl leading-none mb-2 text-brand-blue">0</strong>Lower load</p>
              <p class="text-right"><strong class="block font-display text-3xl leading-none mb-2 text-brand-blue">100</strong>Higher load</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Process and outputs -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ HOW THE COLLABORATION WORKS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10">From the goal to concrete changes<span style="color:#2D62FC">.</span></h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-px bg-brand-black/10 border border-brand-black/10">
          {process.map(step => (
            <div class="bg-brand-white p-6 md:p-7 min-h-64 flex flex-col">
              <span class="font-mono text-xs text-brand-black/60 mb-10">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mt-auto">{step.desc}</p>
            </div>
          ))}
        </div>

        <p class="font-mono text-xs text-brand-black/60 tracking-widest mt-16 mb-8">[ WHAT YOU GET IN THE OUTPUT ]</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {outputs.map((output, i) => (
            <div class="bg-brand-white p-7 md:p-8 min-h-56 flex flex-col">
              <span class="font-mono text-xs text-brand-black/60 mb-8">0{i + 1}</span>
              <h3 class="font-display text-2xl font-bold leading-tight mb-3">{output.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mt-auto">{output.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Who it's for -->
      <div class="reveal mb-24 max-w-4xl">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WHO THE PACKAGES ARE FOR ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6">For teams who want to decide based on data<span style="color:#2D62FC">.</span></h2>
        <p class="text-brand-black/60 leading-relaxed mb-8 max-w-3xl">
          Product and UX teams, marketing, e-commerce, retail and company leadership all make use of the test packages. We adapt the scope to whether you’re dealing with navigation, a form, a campaign, a purchase process, a physical space or the basis for an important decision.
        </p>
        <div class="flex flex-wrap gap-x-5 gap-y-3">
          {audiences.map(a => (
            <span class="font-mono text-[11px] text-brand-black/60 tracking-widest uppercase">{a}</span>
          ))}
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ FREQUENTLY ASKED QUESTIONS ABOUT TESTING ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10">What’s good to know before choosing<span style="color:#2D62FC">.</span></h2>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    // Scroll-reveal — same pattern as on the case studies
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>

  <style>
    /* EMLI scale — the bar sweeps once (0 → 100) and settles at 63; triggered when the section scrolls into view */
    .emli-scale {
      position: relative;
      overflow: hidden;
      background: rgba(45, 98, 252, 0.1);
    }
    .emli-fill {
      position: absolute;
      inset: 0;
      transform-origin: left center;
      background: linear-gradient(90deg, rgba(45, 98, 252, 0.16), #2d62fc);
      transform: scaleX(0.63);
    }
    .reveal.is-visible .emli-fill {
      animation: emliFill 2.8s ease-in-out both;
    }
    @keyframes emliFill {
      0% { transform: scaleX(0); }
      65% { transform: scaleX(1); }
      100% { transform: scaleX(0.63); }
    }
    @media (prefers-reduced-motion: reduce) {
      .reveal.is-visible .emli-fill { animation: none; }
      .emli-fill { transform: scaleX(0.63); }
    }
  </style>
</BaseLayout>
