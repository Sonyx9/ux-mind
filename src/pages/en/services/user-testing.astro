---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const formats = [
  { t: 'Moderated tests', d: 'A researcher guides the participant through the scenario, probing and digging deeper wherever something happens.', tag: 'LAB / ONLINE' },
  { t: 'Unmoderated tests', d: 'Participants complete tasks on their own. Faster data collection, larger samples, more natural conditions.', tag: 'ONLINE' },
  { t: 'Think-aloud', d: 'The participant comments out loud on what they see and why they click. It reveals the mental model, not just behaviour.', tag: 'PROTOCOL' },
];

const findings = [
  'Whether users complete key tasks — and exactly where they fail',
  'How long tasks take and how many errors occur along the way',
  'Which elements users misunderstand or miss entirely',
  'How the behaviour of newcomers differs from experienced users',
  'What users say vs. what they actually do',
];

const process = [
  { num: '01', title: 'Scenario and tasks', desc: 'We define what needs to be verified and prepare realistic tasks.' },
  { num: '02', title: 'Participant recruitment', desc: 'We recruit against your target audience, not a random crowd.' },
  { num: '03', title: 'Testing', desc: 'Moderated or unmoderated, with screen recording and a pilot run.' },
  { num: '04', title: 'Analysis and recommendations', desc: 'Success rate, time, error rate and specific proposed changes.' },
];

const faq = [
  { q: 'How many participants are needed?', a: 'To qualitatively uncover the main problems, 5–8 participants per segment is usually enough. Comparing variants or statistical evaluation requires a larger, more precisely designed sample — we propose the scope based on the research question.' },
  { q: 'Can we test a prototype too?', a: 'Yes. We test production websites and apps as well as clickable prototypes (Figma and similar). The earlier you test, the cheaper the changes are.' },
  { q: 'How does testing differ from a UX audit?', a: 'An audit is an expert evaluation without participants — a faster first step. Testing observes real users completing tasks and verifies actual behaviour. Ideally, one follows the other.' },
  { q: 'Can we watch the testing live?', a: 'Yes, with moderated tests you can join the observation line. Watching your own users is often the most persuasive argument for the team.' },
  { q: 'What if users rate the website positively but fail the task?', a: 'That is exactly what testing reveals. The subjective impression of a "clear page" often does not match the actual success rate — which is why we measure behaviour, not just opinions.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'User testing',
    description: 'Moderated and unmoderated user testing of websites, apps and prototypes. Think-aloud protocol, screen recording, task success analysis and recommendations.',
    serviceType: 'User testing',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="en"
  title="User testing | Moderated and unmoderated UX tests"
  description="User testing of websites, apps and prototypes with real users. Moderated and unmoderated tests, think-aloud, screen recording and specific recommendations."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICES / USER TESTING ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          WATCH WHERE<br/>THEY FAIL<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Tests with real users, not impressions.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              We observe how people complete real tasks in your product. You learn
              <strong class="text-brand-black">what users do</strong> — not just what they say about the product.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="/en/contact" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              REQUEST TESTING →
            </a>
            <a href="/en/services/test-packages" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              TEST PACKAGES
            </a>
          </div>
        </div>
      </div>

      <!-- Info strip -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURATION', '1–4 weeks'],
          ['FORMAT', 'Moderated and online'],
          ['SAMPLE', 'Based on the research question'],
          ['PACKAGE', 'Standard UX test'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Formats -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ TEST FORMATS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Three ways of watching<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {formats.map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Photo -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
          alt="Participant during a user testing session in the lab"
          title="A user testing session in progress"
          width="1080" height="1920" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">In the lab, tests can be extended with eye tracking — you see not only what the user did, but also what they saw while doing it.</p>
      </div>

      <!-- What you learn + process -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ WHAT YOU LEARN ]</p>
          <ul class="space-y-2">
            {findings.map(o => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {o}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ HOW THE TESTING WORKS ]</p>
          <div class="space-y-0">
            {process.map(step => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Limits -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ WHEN YOU NEED MORE ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">You see the behaviour. Not the attention and the load<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              A classic test shows whether the user completed the task. It does not show what they actually saw,
              what they missed and how much it cost them. That is why we combine tests with eye tracking and biometrics.
            </p>
          </div>
          <a href="/en/services/eye-tracking" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            ADD EYE TRACKING →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ FREQUENTLY ASKED QUESTIONS ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            WILL USERS COMPLETE<br/>YOUR TASK<span style="color:#2D62FC">?</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            Send us your product and its key journey. We'll propose a test scenario and the format that delivers the answer fastest.
          </p>
          <a href="/en/contact" class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
            REQUEST TESTING →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
