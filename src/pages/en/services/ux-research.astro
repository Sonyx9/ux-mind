---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const researchQuestions = [
  { title: 'Who you’re creating the product for', desc: 'We get to know the needs, expectations and differences between the groups that use the product or service.' },
  { title: 'What problem people are solving', desc: 'We reveal the real goals, motivations and obstacles, not just requirements formulated without context.' },
  { title: 'How the whole journey unfolds', desc: 'We connect the individual touchpoints and show where the experience works and where it falls apart.' },
  { title: 'What to change first', desc: 'We turn the findings into priorities by impact, certainty and their link to your product goals.' },
];

const methods = [
  { title: 'Understand the needs', methods: 'INTERVIEWS · CONTEXTUAL RESEARCH', desc: 'When you need to understand the motivations, work procedures, decision-making and circumstances in which a problem arises.' },
  { title: 'Verify real behaviour', methods: 'USER TESTING · OBSERVATION', desc: 'When you want to find out whether people can handle important tasks and what stops them in a specific situation.' },
  { title: 'Measure the scope of the problem', methods: 'SURVEYS · ANALYTICS · OPERATIONAL DATA', desc: 'When you need to verify how often a certain pattern appears and which groups it affects.' },
  { title: 'Compare possible directions', methods: 'CONCEPTS · PROTOTYPES · VARIANTS', desc: 'When you’re choosing between solutions and need to back the decision with behaviour and feedback.' },
];

const deliverables = [
  { title: 'An answer to the research question', desc: 'We clearly summarise what the data allow us to say, what remains uncertain and what needs further verification.' },
  { title: 'Evidence and context', desc: 'We back the findings with specific situations, statements, patterns of behaviour and available data.' },
  { title: 'Priorities and opportunities', desc: 'We separate the fundamental problems from the details and show where a change makes the most sense.' },
  { title: 'Materials for further work', desc: 'Depending on the goal we prepare recommendations, a journey map, segmentation, a brief for design or a plan for further validation.' },
];

const situations = [
  { title: 'A new product or service', desc: 'You need to verify who the solution should serve and what problem it should really solve.' },
  { title: 'A redesign or change of direction', desc: 'You don’t just want to redraw the current state, but decide what to keep and what to change.' },
  { title: 'Weak performance with no clear cause', desc: 'The data show a problem, but don’t explain the motivations, expectations or the context of behaviour.' },
  { title: 'A new target group or market', desc: 'You need to understand different needs before transferring your existing solution elsewhere.' },
  { title: 'A journey across channels', desc: 'The experience arises between the website, support, a branch, a store or a physical product.' },
  { title: 'A high-impact decision', desc: 'You need to back a development direction, an investment or a process change before wider deployment.' },
];

const process = [
  { num: '01', title: 'Decision and context', desc: 'We clarify what you need to decide, what you already know and where the biggest gaps are.' },
  { num: '02', title: 'Research design', desc: 'We choose suitable methods, target groups, sample and method of evaluation.' },
  { num: '03', title: 'Preparation and recruitment', desc: 'We prepare the scenario, verify it with a pilot and secure suitable participants.' },
  { num: '04', title: 'Data collection and synthesis', desc: 'We connect interviews, behaviour and available data and look for recurring patterns.' },
  { num: '05', title: 'Recommendations and handover', desc: 'We turn the results into priorities and together define the next product steps.' },
];

const faq = [
  { q: 'What is UX research?', a: 'UX research systematically finds out who the users are, what they need, how they behave and why. It helps decide what problem to solve, what to design and which changes make the most sense.' },
  { q: 'How does UX research differ from user testing?', a: 'User testing verifies a specific interface or prototype. UX research can address broader questions about needs, target groups, the whole customer journey or the direction of the product, and combines several methods depending on the goal.' },
  { q: 'How does UX research differ from market research?', a: 'Market research often focuses on market size, preferences or the brand. UX research goes more into the context of using a product or service and looks for a basis for specific design and product decisions. The two approaches can complement each other well.' },
  { q: 'How many participants do we need?', a: 'The number depends on the research question, the number of target groups and the chosen methods. Qualitative interviews work with a different sample than a survey or a comparison of variants, so we determine the scope when designing the study.' },
  { q: 'How long does UX research take and how much does it cost?', a: 'Most often 3–8 weeks depending on the number of target groups, the recruitment method, the methods and the scope of the output. After an initial brief we prepare a concrete proposal, schedule and price.' },
  { q: 'What if we already have analytics or previous research?', a: 'We first go through the existing data and use it as a starting point. We propose new collection only where we need to fill in missing context or verify uncertain conclusions.' },
  { q: 'Does the research have to be in person?', a: 'No. Interviews and user testing can be conducted in person or remotely depending on the goal. Field research, on the other hand, takes place directly in the environment where people use the service, product or work procedure.' },
  { q: 'When do you bring eye tracking and biometrics into UX research?', a: 'Only when the research question requires precisely measuring visual attention, physiological activation or mental load. It is not an automatic part of every study, but an optional extension.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'UX research',
    description: 'UX research for product decisions: interviews, observation, user testing, surveys, data analysis and prioritised recommendations.',
    serviceType: 'UX research',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="en"
  title="UX research for product decisions | UX MIND"
  description="UX research using interviews, observation, user testing and data analysis. Get clear findings, priorities and recommendations for your product."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICES / UX RESEARCH ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          UNDERSTAND<br/>THE CONTEXT<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-3xl">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Decide what’s worth creating and improving.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify mb-4">
              UX research answers broader questions than a test of a single screen. It helps find out who your users are, what they need, how they decide and which parts of their journey have the greatest impact on the experience with the product or service.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify">
              Depending on the goal we combine interviews, observation, user testing, surveys and available data. The output is <strong class="text-brand-black">clear findings, priorities and recommendations for product decisions</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/en/contact" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              REQUEST UX RESEARCH →
            </a>
            <a href="/en/services#testovaci-balicky" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              VIEW PACKAGES
            </a>
          </div>
        </div>
      </div>

      <!-- Info strip -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURATION', '3–8 weeks'],
          ['METHODS', 'Interviews · observation · data'],
          ['OUTPUTS', 'Findings · priorities · recommendations'],
          ['FORMAT', 'Custom research'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Research questions -->
      <div class="reveal mb-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.35fr] gap-10 lg:gap-16">
          <div>
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ WHAT UX RESEARCH ANSWERS ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              The question first. Then the method<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <div class="border-t border-brand-white/20">
            {researchQuestions.map((question, i) => (
              <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_13rem_1fr] gap-x-4 gap-y-2 py-6 border-b border-brand-white/20">
                <span class="font-mono text-xs text-brand-white/50 pt-1">0{i + 1}</span>
                <h3 class="font-display text-lg font-bold leading-tight">{question.title}</h3>
                <p class="col-start-2 sm:col-start-3 text-sm text-brand-white/65 leading-relaxed">{question.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- When it makes sense -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WHEN UX RESEARCH MAKES SENSE ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-4xl">
          When adjusting a single screen isn’t enough<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12">
          {situations.map((situation, i) => (
            <div class="grid grid-cols-[2rem_1fr] gap-x-4 py-6 border-t border-brand-black/20">
              <span class="font-mono text-xs text-brand-black/50 pt-1">0{i + 1}</span>
              <div>
                <h3 class="font-display text-xl font-bold mb-2 leading-tight">{situation.title}</h3>
                <p class="text-sm text-brand-black/60 leading-relaxed">{situation.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Methods -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ HOW WE COMPOSE THE METHODS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6 max-w-4xl">
          The scope is set by the decision, not by a list of methods<span style="color:#2D62FC">.</span>
        </h2>
        <p class="text-brand-black/60 leading-relaxed text-justify max-w-3xl mb-10">
          We don’t start by putting every available technique into the project. First we determine what type of answer you need, and only then do we propose the smallest meaningful combination of methods.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          {methods.map((method, i) => (
            <div class="bg-brand-white p-8 flex flex-col min-h-64">
              <span class="font-mono text-xs text-brand-black/60 mb-8">0{i + 1}</span>
              <h3 class="font-display text-2xl font-bold mb-3">{method.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6 text-justify">{method.desc}</p>
              <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mt-auto pt-5 border-t border-brand-black/10">{method.methods}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Photo -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/laborator-ux-vyzkumu-vizualizace-1.webp`}
          alt="A UX research lab — facilities for interviews, testing and biometric measurement"
          title="UX research lab"
          width="1200" height="846" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">The FIMEYELAB research facilities at FIM UHK — a space for interviews, user testing and, as needed, synchronised measurement.</p>
      </div>

      <!-- Deliverables -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-16">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WHAT YOU GET ]</p>
          <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight max-w-xl">
            A basis for decisions, not a document for the archive<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-black/60 leading-relaxed mt-6 max-w-xl text-justify">
            We choose the form of the output by who will work with the results and what decision should follow. A journey map or a persona is not a mandatory item — they are created only when they help further work.
          </p>
        </div>
        <div class="border-t border-brand-black/20">
          {deliverables.map((deliverable, i) => (
            <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_13rem_1fr] gap-x-4 gap-y-2 py-6 border-b border-brand-black/20">
              <span class="font-mono text-xs text-brand-black/50 pt-1">0{i + 1}</span>
              <h3 class="font-display text-lg font-bold leading-tight">{deliverable.title}</h3>
              <p class="col-start-2 sm:col-start-3 text-sm text-brand-black/60 leading-relaxed">{deliverable.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Process -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ HOW UX RESEARCH WORKS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-4xl">
          From the question to the next product step<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-x-7 gap-y-10">
          {process.map(step => (
            <div class="border-t border-brand-black/20 pt-5">
              <span class="block font-mono text-xs text-brand-black/60 mb-5">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Advanced measurement -->
      <div class="reveal mb-24 border border-brand-black/15 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ OPTIONAL ADVANCED MEASUREMENT ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">When statements and observation aren’t enough<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              If the research question requires precisely measuring visual attention, physiological activation or mental load, we can extend the study with eye tracking, GSR, facial signal analysis or EMLI. We add a method only when it brings the type of evidence needed.
            </p>
          </div>
          <a href="/en/services/eye-tracking" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            VIEW EYE TRACKING →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ FREQUENTLY ASKED QUESTIONS ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
