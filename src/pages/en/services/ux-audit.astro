---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const reveals = [
  { t: 'Barriers in the journey', d: 'Where users lose their bearings, where they get stuck and what makes them leave.', tag: 'JOURNEY' },
  { t: 'Known issues', d: 'Violations of proven usability principles — before your customers find them.', tag: 'HEURISTICS' },
  { t: 'Quick wins', d: 'High-impact, low-effort changes you can ship straight away.', tag: 'PRIORITIES' },
];

const process = [
  { num: '01', title: 'Brief and scope', desc: 'Key journeys, goals and the business context of your product.' },
  { num: '02', title: 'Heuristic analysis', desc: 'A systematic walkthrough of the interface against proven principles.' },
  { num: '03', title: 'Journey and data analysis', desc: 'User flows; if you have analytics, we bring them in.' },
  { num: '04', title: 'Report and workshop', desc: 'Prioritised recommendations and joint planning of changes.' },
];

const outputs = [
  'Prioritised list of issues by impact',
  'Specific recommendations with proposed solutions',
  'Quick wins ready for immediate deployment',
  'Output report with mockups',
  'Workshop with your team',
];

const faq = [
  { q: 'How long does a UX audit take?', a: 'Typically 2–4 weeks depending on the scope of the product: initial analysis, heuristic evaluation, data analysis and presentation of the results.' },
  { q: 'How does an audit differ from user testing?', a: 'An audit is an expert evaluation — a specialist assesses the interface against proven principles, without participants. Testing observes real users completing tasks. The audit is the faster and cheaper first step; testing verifies behaviour in practice.' },
  { q: 'When is an audit not enough?', a: 'An audit identifies likely problems, but it does not prove their impact on user behaviour or conversion. If you need to back a decision with data, follow it up with measurement — eye tracking, user testing or biometrics.' },
  { q: 'What do you need from us?', a: 'Access to the product (website, app, prototype), a description of the key journeys and goals. If you have analytics, we bring them into the analysis.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'UX audit',
    description: 'Expert UX audit of a website, e-commerce store or app: heuristic analysis, user journey analysis, prioritised recommendations and a workshop. The fast foundation of every improvement.',
    serviceType: 'UX audit',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="en"
  title="UX audit of websites and e-commerce | Expert usability analysis"
  description="UX audit of your website, e-commerce store or app in 2–4 weeks. Heuristic analysis, journey analysis, prioritised recommendations and quick wins. The fast foundation of every improvement."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICES / UX AUDIT ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          START WITH<br/>AN AUDIT<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">The fast foundation of every improvement.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              A specialist walks through your interface from the user's perspective and finds the barriers
              before your customers do. The output is a <strong class="text-brand-black">prioritised plan of changes</strong>, not just a list of flaws.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="/en/contact" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              REQUEST AN AUDIT →
            </a>
            <a href="/en/services/test-packages" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              TEST PACKAGES
            </a>
          </div>
        </div>
      </div>

      <!-- Info strip -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURATION', '2–4 weeks'],
          ['METHOD', 'Expert evaluation'],
          ['PARTICIPANTS', 'Not required'],
          ['PACKAGE', 'Rapid diagnostics'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- What the audit reveals -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WHAT THE AUDIT REVEALS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Problems your users quietly put up with<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {reveals.map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Photo -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/jan-petruzalek-analyza-eye-tracking-dat.webp`}
          alt="Specialist analysing data from a UX audit and eye tracking"
          title="Data analysis during a UX audit"
          width="1200" height="800" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">An audit is not guesswork — we back every finding with a specific place in the interface and the principle it violates.</p>
      </div>

      <!-- Process + output -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ HOW THE AUDIT WORKS ]</p>
          <div class="space-y-0">
            {process.map(step => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ WHAT YOU GET ]</p>
          <ul class="space-y-2">
            {outputs.map(o => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {o}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Limits of the service -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ LIMITS OF THE AUDIT ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">The audit shows where, measurement proves why<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Expert evaluation identifies likely problems, but it does not prove their impact on behaviour and conversion.
              When you need to defend a decision with data, the audit is followed by eye tracking, user testing or biometrics.
            </p>
          </div>
          <a href="/en/services/test-packages" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            FOLLOW-UP MEASUREMENT →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ FREQUENTLY ASKED QUESTIONS ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            WHAT IS YOUR<br/>WEBSITE COSTING YOU<span style="color:#2D62FC">?</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            Send us a link. Within a few days we'll tell you whether an audit makes sense and what to expect from it.
          </p>
          <a href="/en/contact" class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
            REQUEST AN AUDIT →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
