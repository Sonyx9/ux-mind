---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const reveals = [
  { t: 'Barriers in the journey', d: 'Steps where it can be hard to get oriented, continue or find the right information.', tag: 'USER JOURNEY' },
  { t: 'Unclear interface', d: 'Confusing labels, weak visual hierarchy and elements where it isn’t clear what they do.', tag: 'CLARITY' },
  { t: 'Fix priorities', d: 'Problems sorted by impact and effort, so it’s clear what to tackle first.', tag: 'NEXT STEPS' },
];

const process = [
  { num: '01', title: 'Goal and scope', desc: 'We select the key pages, user journeys and goals of the audit.' },
  { num: '02', title: 'Expert review', desc: 'We check the navigation, content, hierarchy and clarity of the interface.' },
  { num: '03', title: 'Context and data', desc: 'We place the findings in the context of the product and bring in available analytics.' },
  { num: '04', title: 'Recommendations and handover', desc: 'We sort the problems by importance and go through the next steps together.' },
];

const outputs = [
  { title: 'Overview of problems', desc: 'We link each finding to a specific place in the interface and explain its impact.' },
  { title: 'Priorities by impact', desc: 'We distinguish what needs to be solved right away, what later and what isn’t important yet.' },
  { title: 'Specific proposed changes', desc: 'We recommend how to remove the problem. For selected places we add a proposal or example solution.' },
  { title: 'Joint handover of the results', desc: 'We go through the conclusions with your team so it’s clear how to put them into practice.' },
];

const faq = [
  { q: 'What does a UX audit include?', a: 'We check the key pages and user journeys, the navigation, content, visual hierarchy and clarity of the interface. The output is an overview of problems, their priorities and specific recommendations for changes.' },
  { q: 'How long does a UX audit take?', a: 'Most often 2–4 weeks depending on the scope of the product and the number of journeys reviewed. We specify the timeline after a short initial brief.' },
  { q: 'How much does a UX audit cost?', a: 'The price depends on the scope of the product, the number of key journeys and the required form of the output. Once we know the brief we prepare a concrete quote with no hidden items.' },
  { q: 'How does a UX audit differ from user testing?', a: 'A UX audit is an expert review of the interface without participants. User testing observes real users completing tasks and verifies how the problems show up in practice.' },
  { q: 'Can you also audit an e-shop, an app or a prototype?', a: 'Yes. We audit websites, e-shops, apps and sufficiently developed prototypes. We always adapt the scope to the stage of the product and the decision you need to make.' },
  { q: 'What do you need to start the audit?', a: 'Access to the product or prototype, a description of the target users and the key tasks they need to accomplish. If you have web analytics or previous research, we can bring them in as additional context.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'UX audit',
    description: 'Expert UX audit of a website, e-commerce store or app: heuristic analysis, user journey analysis, prioritised recommendations and a workshop. The fast foundation of every improvement.',
    serviceType: 'UX audit',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="en"
  title="UX audit of websites and e-commerce | Expert usability analysis"
  description="UX audit of your website, e-commerce store or app in 2–4 weeks. Heuristic analysis, journey analysis, prioritised recommendations and quick wins. The fast foundation of every improvement."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICES / UX AUDIT ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          REVEAL THE<br/>WEAK SPOTS<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-3xl">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">UX audit of a website, e-shop or app.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed mb-4">
              We go through the key pages and user journeys. We check the navigation, the clarity of the content, the visual hierarchy and the barriers to completing important tasks.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed">
              You get specific recommendations sorted by impact and effort, so you know <strong class="text-brand-black">what to fix first</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/en/contact" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              REQUEST A UX AUDIT →
            </a>
            <a href="/en/services#testovaci-balicky" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              VIEW PACKAGES
            </a>
          </div>
        </div>
      </div>

      <!-- Info strip -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURATION', '2–4 weeks'],
          ['METHOD', 'Expert evaluation'],
          ['PARTICIPANTS', 'Not required'],
          ['PACKAGE', 'Quick UX audit'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- What the audit reveals -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ WHAT THE UX AUDIT REVEALS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          What needlessly complicates completing a task<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {reveals.map((v, i) => (
            <div class="bg-brand-white p-8 flex flex-col h-full">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest self-start mt-auto">{v.tag}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Photo -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/jan-petruzalek-analyza-eye-tracking-dat.webp`}
          alt="Specialist analysing data from a UX audit and eye tracking"
          title="Data analysis during a UX audit"
          width="1200" height="800" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">An audit is not guesswork — we back every finding with a specific place in the interface and the principle it violates.</p>
      </div>

      <!-- Process -->
      <div class="reveal mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ HOW THE AUDIT WORKS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Four steps from brief to recommendations<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
          {process.map(step => (
            <div class="border-t border-brand-black/20 pt-5">
              <span class="block font-mono text-xs text-brand-black/60 mb-5">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Output -->
      <div class="reveal mb-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.35fr] gap-10 lg:gap-16">
          <div>
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ WHAT YOU GET ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              A clear plan of what to fix first<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <div class="border-t border-brand-white/20">
            {outputs.map((output, i) => (
              <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_12rem_1fr] gap-x-4 gap-y-2 py-5 border-b border-brand-white/20">
                <span class="font-mono text-xs text-brand-white/50 pt-1">0{i + 1}</span>
                <h3 class="font-display text-lg font-bold leading-tight">{output.title}</h3>
                <p class="col-start-2 sm:col-start-3 text-sm text-brand-white/65 leading-relaxed">{output.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- When an audit is enough and when to test -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ WHEN AN AUDIT IS ENOUGH AND WHEN TO TEST ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">An audit reveals weak spots. Testing verifies their impact<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              A UX audit is suitable when you need to quickly find problems and get a concrete plan of changes.
              If you want to verify how users actually behave in the interface and which barriers have the greatest effect, we follow up with user testing or eye tracking.
            </p>
          </div>
          <a href="/en/services/test-packages" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            VIEW TESTING OPTIONS →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ FREQUENTLY ASKED QUESTIONS ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
