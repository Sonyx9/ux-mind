---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { localizedPath } from '../../i18n/utils';

const updated = 'August 30, 2026';
const cookiesHref = localizedPath('en', 'cookies');

const purposes = [
  {
    name: 'Enquiries & communication',
    legal: 'Legitimate interest / pre-contract',
    purpose: 'Answering questions from email and phone, preparing quotes and arranging cooperation.',
    data: 'Name, email, phone, company, message content.',
    expiry: 'For the duration of communication, then up to 3 years (defence of claims).',
  },
  {
    name: 'Research participants',
    legal: 'Participant consent',
    purpose: 'Running user tests and eye-tracking sessions. Outputs are processed in aggregated and anonymised form.',
    data: 'Eye-tracking data, questionnaire answers, session recording (per protocol).',
    expiry: 'Until the study purpose is met; then anonymisation or deletion.',
  },
  {
    name: 'Client contracts',
    legal: 'Contract / legal obligation',
    purpose: 'Delivering the engagement, invoicing and accounting.',
    data: 'Billing and identification details, contact persons.',
    expiry: 'As required by law (accounting and tax records up to 10 years).',
  },
  {
    name: 'Traffic measurement',
    legal: 'Consent (cookies)',
    purpose: 'Anonymous website traffic statistics so we can improve it.',
    data: 'Cookies and device identifiers (Google Analytics).',
    expiry: 'Up to 24 months, see the cookie policy.',
  },
];

const rights = [
  ['Access', 'Know what data we process about you and obtain a copy.'],
  ['Rectification', 'Have inaccurate data corrected or incomplete data completed.'],
  ['Erasure', 'Have your data deleted once the reason for processing no longer applies.'],
  ['Restriction', 'Temporarily restrict processing, e.g. while accuracy is verified.'],
  ['Portability', 'Receive your data in a machine-readable format or transfer it to another controller.'],
  ['Objection', 'Object to processing based on legitimate interest.'],
  ['Withdraw consent', 'Withdraw a given consent at any time — without affecting processing before withdrawal.'],
];
---

<BaseLayout
  title="Privacy Policy"
  description="How UX MIND Research Lab processes personal data: enquiries, research participants, clients and analytics. Legal bases under the GDPR, retention periods and your rights."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-3xl mx-auto px-6">

      <div class="mb-12">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ LEGAL INFORMATION ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 8vw, 6rem);">
          Privacy policy<span style="color:#2D62FC">.</span>
        </h1>
        <p class="text-sm text-brand-black/50 font-mono">Last updated: {updated}</p>
      </div>

      <div class="space-y-10 text-brand-black/70 leading-relaxed">

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-3">Who the controller is</h2>
          <p class="mb-3">
            The controller of personal data is <strong class="text-brand-black">UX MIND Research Lab s.r.o.</strong>,
            Reg. No. 29714966, registered office in Hradec Králové, Czech Republic. Processing complies with the
            GDPR Regulation (EU) 2016/679 and Czech Act No. 110/2019 Coll. on personal data processing.
          </p>
          <p>
            Questions about personal data and exercising your rights:
            <a href="mailto:spoluprace@uxmind.cz" class="underline hover:text-brand-black">spoluprace@uxmind.cz</a>.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-5">What we process and why</h2>
          <div class="space-y-px bg-brand-black/10 border border-brand-black/10">
            {purposes.map(p => (
              <div class="bg-brand-white p-5">
                <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2">
                  <h3 class="font-mono text-sm tracking-widest uppercase text-brand-black">{p.name}</h3>
                  <span class="font-mono text-[10px] tracking-widest uppercase" style="color:#2D62FC">{p.legal}</span>
                </div>
                <p class="text-sm mb-2">{p.purpose}</p>
                <dl class="text-xs text-brand-black/50 space-y-0.5">
                  <div><dt class="inline font-mono">Data: </dt><dd class="inline">{p.data}</dd></div>
                  <div><dt class="inline font-mono">Retention: </dt><dd class="inline">{p.expiry}</dd></div>
                </dl>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-3">Research participants</h2>
          <p class="mb-3">
            Testing and eye-tracking sessions always take place <strong class="text-brand-black">on the basis of
            informed consent</strong>, which can be withdrawn at any time. Before each session we clearly explain
            the purpose, the procedure and how the data is handled.
          </p>
          <p>
            We present results to clients and the public in <strong class="text-brand-black">aggregated and
            anonymised</strong> form — individuals cannot be identified from published outputs. Raw data
            (eye-tracking, questionnaires, any recordings) is used only for as long as the study requires and is
            then anonymised or deleted.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-3">Who we share data with</h2>
          <p class="mb-3">
            We do not sell personal data. We share it only with vetted processors to the extent needed to operate —
            our hosting and email provider, traffic-measurement tools (Google Analytics, Google Ads) and accounting
            services. We have data-processing agreements in place with these processors.
          </p>
          <p>
            Some providers (Google) may process data outside the EU. Any such transfer is covered by the EU Standard
            Contractual Clauses. Google's terms are described in their
            <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="underline hover:text-brand-black">Privacy Policy ↗</a>.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-5">Your rights</h2>
          <p class="mb-5">You have the following rights regarding your personal data. Exercise them by email — we handle requests without undue delay, within one month at the latest.</p>
          <div class="space-y-px bg-brand-black/10 border border-brand-black/10">
            {rights.map(([name, desc]) => (
              <div class="bg-brand-white p-4 flex flex-col sm:flex-row sm:gap-4">
                <p class="font-mono text-xs tracking-widest uppercase text-brand-black sm:w-48 shrink-0 mb-1 sm:mb-0">{name}</p>
                <p class="text-sm">{desc}</p>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-3">Cookies</h2>
          <p>
            The site uses cookies for operation, traffic measurement and marketing. Details and consent settings
            are in the separate
            <a href={cookiesHref} class="underline hover:text-brand-black">cookie policy</a>.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-3">Supervisory authority</h2>
          <p>
            If you believe we process your data unlawfully, you have the right to lodge a complaint with the
            <strong class="text-brand-black">Czech Office for Personal Data Protection</strong>,
            Pplk. Sochora 27, 170 00 Prague 7,
            <a href="https://www.uoou.cz" target="_blank" rel="noopener noreferrer" class="underline hover:text-brand-black">uoou.cz ↗</a>.
          </p>
        </section>

      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
