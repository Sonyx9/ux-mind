---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="en"
  title="Services"
  description="UX audit of websites and e-commerce, eye tracking, UX research, user testing and field research with mobile eye-tracking glasses. Recommendations backed by data, not impressions."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Header -->
      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ OUR SERVICES ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter" style="font-size: clamp(3rem, 9vw, 8rem);">
          WHAT WE<br/>DO<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Services list -->
      <div class="space-y-px border border-brand-black/10">
        {[
          // Order: from the quick foundation (audit) to the most comprehensive research
          {
            num: '01',
            id: 'ux-audit',
            href: '/en/services/ux-audit',
            title: 'UX Audit',
            desc: 'We go through your website, e-shop or app with a user’s eyes. We find the places where people get stuck, leave or don’t complete an important step. You get specific recommendations sorted by impact.',
            details: ['Heuristic analysis', 'User journey analysis', 'Prioritised list of recommendations', 'Workshop with the team', 'Output report with proposed changes'],
            duration: '2–4 weeks',
            pkg: 'Rapid diagnostics',
          },
          {
            num: '02',
            id: 'testovani-uzivatelu',
            href: '/en/services/user-testing',
            title: 'User Testing',
            desc: 'We give real users specific tasks and watch whether they can complete them. You’ll find out where they get lost, what they don’t understand and why they leave.',
            details: ['Moderated testing', 'Unmoderated online testing', 'The user describes their steps aloud', 'Screen recording', 'Results and recommendations'],
            duration: '1–4 weeks',
            pkg: 'Standard UX test',
          },
          {
            num: '03',
            href: '/en/services/eye-tracking',
            title: 'Eye Tracking',
            desc: 'Using eye tracking we measure where people really look. You’ll find out what they notice, what they overlook and whether important content leads their attention the right way.',
            details: ['Attention heatmaps', 'AOI (Areas of Interest) analysis', 'Eye movement recordings', 'F-pattern & Z-pattern analysis', 'Comparative variant testing'],
            duration: '1–3 weeks',
            pkg: 'Standard UX test',
          },
          {
            num: '04',
            id: 'terenni-mereni',
            href: '/en/services/field-research',
            title: 'Field Research',
            desc: 'We observe customers right where they make decisions — in the store, showroom, at an event or with a physical product. Mobile eye-tracking glasses show what they notice in the real environment and what they miss.',
            details: ['Pupil Labs NEON mobile eye-tracking glasses', 'Video recording of the situation and behaviour in the space', 'GSR and interviews as needed', 'Product placement, signage, POS materials', 'Recommendations for adjusting the space and the customer journey'],
            duration: '2–6 weeks',
            pkg: 'Field study',
          },
          {
            num: '05',
            href: '/en/services/ux-research',
            title: 'UX Research',
            desc: 'We help you understand what users need, what frustrates them and why they behave in certain ways. Depending on the research question we combine interviews, observation, testing and data.',
            details: ['In-depth interviews', 'Contextual research', 'Usability testing', 'Data analysis', 'Personas & Journey maps'],
            duration: '3–8 weeks',
            pkg: 'Comprehensive biometric research',
          },
        ].map(service => (
          <div id={service.id} class="p-8 md:p-12 border-b border-brand-black/10 last:border-0 scroll-mt-28">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <div class="md:col-span-2">
                <div class="flex items-baseline gap-4 mb-4">
                  <span class="font-mono text-xs text-brand-black/60">{service.num}</span>
                  <h2 class="font-display text-3xl md:text-4xl font-bold">
                    <a href={service.href} class="hover:opacity-60 transition-opacity">{service.title}</a>
                  </h2>
                </div>
                <p class="text-brand-black/60 leading-relaxed mb-6">{service.desc}</p>
                <ul class="space-y-1">
                  {service.details.map(d => (
                    <li class="font-mono text-xs text-brand-black/60 flex gap-2">
                      <span>→</span> {d}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="flex flex-col justify-between">
                <div>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">PROJECT DURATION</p>
                  <p class="font-display text-lg font-semibold">{service.duration}</p>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mt-4 mb-1">TYPICAL PACKAGE</p>
                  <a href="/en/services/test-packages" class="font-display text-lg font-semibold underline hover:no-underline">{service.pkg}</a>
                </div>
                <div class="flex flex-col gap-2 mt-6">
                  <a href={service.href} class="inline-block bg-brand-black text-brand-white border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-[#2D62FC] hover:border-[#2D62FC] hover:text-brand-white transition-colors text-center">
                    SERVICE DETAIL →
                  </a>
                  <a href="/en/contact" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors text-center">
                    ASK, NO OBLIGATION
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Test packages -->
      <a id="testovaci-balicky" href="/en/services/test-packages" class="group block mt-24 border border-brand-black bg-brand-black text-brand-white p-8 md:p-12 hover:bg-brand-white hover:text-brand-black transition-colors duration-300 scroll-mt-28">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
          <div class="md:col-span-2">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4 group-hover:text-brand-black/60 transition-colors">[ TEST PACKAGES ]</p>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-4">From a quick check to in-depth research<span style="color:#2D62FC">.</span></h2>
            <p class="text-brand-white/70 leading-relaxed max-w-2xl group-hover:text-brand-black/70 transition-colors">
              Choose the scope by what you need to find out. We combine suitable methods and explain in advance what answers you’ll get from the testing.
            </p>
          </div>
          <div class="flex md:justify-end">
            <span class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase group-hover:border-brand-black group-hover:text-brand-black transition-colors">
              COMPARE PACKAGES →
            </span>
          </div>
        </div>
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
