---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="en"
  title="Services"
  description="UX audit of websites and e-commerce, eye tracking, UX research, user testing and field research with mobile eye-tracking glasses. Recommendations backed by data, not impressions."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Header -->
      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ OUR SERVICES ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter" style="font-size: clamp(3.5rem, 10vw, 9rem);">
          WHAT WE<br/>DO.
        </h1>
      </div>

      <!-- Services list -->
      <div class="space-y-px border border-brand-black/10">
        {[
          // Order: from the quick foundation (audit) to the most comprehensive research
          {
            num: '01',
            id: 'ux-audit',
            href: '/en/services/ux-audit',
            title: 'UX Audit',
            desc: 'The fast foundation of every improvement. A systematic analysis of your digital product — we walk through the interface from the user\'s perspective, identify barriers and propose specific improvements prioritised by impact.',
            details: ['Heuristic analysis', 'User flow analysis', 'Prioritised recommendations list', 'Team workshop', 'Output report with mockups'],
            duration: '2–4 weeks',
            pkg: 'Rapid diagnostics',
          },
          {
            num: '02',
            id: 'testovani-uzivatelu',
            href: '/en/services/user-testing',
            title: 'User Testing',
            desc: 'Moderated and unmoderated tests with real users. We observe how users complete tasks in your product and identify where they fail.',
            details: ['Moderated session tests', 'Unmoderated online tests', 'Think-aloud protocol', 'Screen recording', 'Analysis and recommendations'],
            duration: '1–4 weeks',
            pkg: 'Standard UX test',
          },
          {
            num: '03',
            href: '/en/services/eye-tracking',
            title: 'Eye Tracking',
            desc: 'Precise data on the visual perception of your content. We track users\' eye movements as they interact with your website, app or print materials.',
            details: ['Attention heatmaps', 'AOI (Areas of Interest) analysis', 'Eye movement recordings', 'F-pattern & Z-pattern analysis', 'Comparative variant testing'],
            duration: '1–3 weeks',
            pkg: 'Standard UX test',
          },
          {
            num: '04',
            id: 'terenni-mereni',
            href: '/en/services/field-research',
            title: 'Field Research',
            desc: 'We measure where the customer actually makes decisions — in a store, showroom, at an event or with a physical product. Mobile eye-tracking glasses capture attention in real environments, not just on a screen. Equipment few others in the Czech Republic have.',
            details: ['Pupil Labs NEON mobile eye-tracking glasses', 'Video recording of the situation and behaviour in the space', 'GSR and interviews as needed', 'Product placement, signage, POS materials', 'Recommendations for adjusting the space and customer journey'],
            duration: '2–6 weeks',
            pkg: 'Field study',
          },
          {
            num: '05',
            href: '/en/services/ux-research',
            title: 'UX Research',
            desc: 'The deepest scope: a combination of qualitative and quantitative methods. We help you understand the needs, frustrations and mental models of your users.',
            details: ['In-depth interviews', 'Contextual research', 'Usability testing', 'Data analysis', 'Personas & Journey maps'],
            duration: '3–8 weeks',
            pkg: 'Comprehensive biometric research',
          },
        ].map(service => (
          <div id={service.id} class="p-8 md:p-12 border-b border-brand-black/10 last:border-0 scroll-mt-28">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <div class="md:col-span-2">
                <div class="flex items-baseline gap-4 mb-4">
                  <span class="font-mono text-xs text-brand-black/60">{service.num}</span>
                  <h2 class="font-display text-3xl md:text-4xl font-bold">
                    <a href={service.href} class="hover:opacity-60 transition-opacity">{service.title}</a>
                  </h2>
                </div>
                <p class="text-brand-black/60 leading-relaxed mb-6">{service.desc}</p>
                <ul class="space-y-1">
                  {service.details.map(d => (
                    <li class="font-mono text-xs text-brand-black/60 flex gap-2">
                      <span>→</span> {d}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="flex flex-col justify-between">
                <div>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">PROJECT DURATION</p>
                  <p class="font-display text-lg font-semibold">{service.duration}</p>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mt-4 mb-1">TYPICAL PACKAGE</p>
                  <a href="/en/services/test-packages" class="font-display text-lg font-semibold underline hover:no-underline">{service.pkg}</a>
                </div>
                <div class="flex flex-col gap-2 mt-6">
                  <a href={service.href} class="inline-block bg-brand-black text-brand-white border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors text-center">
                    SERVICE DETAIL →
                  </a>
                  <a href="/en/contact" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors text-center">
                    GET IN TOUCH
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Test packages -->
      <div class="mt-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
          <div class="md:col-span-2">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ TEST PACKAGES ]</p>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-4">From rapid diagnostics to comprehensive biometric research</h2>
            <p class="text-brand-white/70 leading-relaxed max-w-2xl">
              We combine our services into test packages based on the decision you need to make — eye tracking, behavioural data, surveys, GSR and field measurement. You know in advance what you'll get from the testing and what cannot be reliably claimed from that scope.
            </p>
          </div>
          <div class="flex md:justify-end">
            <a href="/en/services/test-packages" class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              VIEW THE PACKAGES →
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
