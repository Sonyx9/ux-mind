---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const fakta = [["METHOD", "Experiment · eye tracking + UEQ"], ["SAMPLE", "84 respondents"], ["VARIANTS", "Packshot vs. lifestyle photography"], ["STATISTICS", "F(1,82) = 4.50 · p = 0.037"]];
const zjisteni = ["The type of photography had a statistically significant effect on task completion time: F(1,82) = 4.50; p = 0.037.", "With the variant showing the product “on a person”, completing the tested task took longer than with the plain packshot.", "The study did not provide clear evidence that the variants also differed in the subjective rating of the user experience."];
const faq = [
  { q: "Is a packshot or lifestyle photography better?", a: "A single study cannot determine a universally better type of photography. In the tested task the lifestyle variant led to a longer time than the packshot. The choice needs to be related to the specific product, page and user goal." },
  { q: "What does p = 0.037 mean?", a: "If there were in fact no difference between the variants and the assumptions of the test used were met, a result this pronounced or more would appear in roughly 3.7% of repetitions. The p-value itself does not say how large the practical or business impact is." },
  { q: "Did the type of photo also affect how the page was rated?", a: "The study did not provide clear evidence of a difference in the subjective rating of the user experience. The longer time therefore cannot automatically be explained by one variant being liked more or less." },
  { q: "Does a longer time mean lower conversion?", a: "No. The study measured the time to complete a specific task, not the impact on real conversion or revenue. Such a conclusion would require linking the research with additional data or a follow-up experiment." },
  { q: "What was eye tracking used for in the study?", a: "Eye tracking supplemented the course of the task with data on visual attention. The main described difference between the variants, however, concerns task completion time, so we do not automatically attribute it to a specific gaze pattern without further analysis." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "The same product. A different length of decision.",
    about: 'Eye tracking, UX research',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'en',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="en"
  title="Case study: packshot vs. lifestyle photography"
  description="Experiment with 84 respondents: in the tested e-commerce task, lifestyle photography led to a longer time than the plain packshot, F(1,82) = 4.50; p = 0.037."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/en/case-studies" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← ALL STUDIES</a>

      <!-- Study header -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">E-commerce</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          The same product. A different length of decision<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Key results -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-1 md:grid-cols-3">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative p-7 md:p-9 border-t-4 border-t-brand-blue border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-mono text-xs tracking-widest text-brand-white/60 mb-5">LIFESTYLE VARIANT</p>
          <p class="font-display text-2xl md:text-3xl font-bold leading-tight">Longer task completion time</p>
        </div>
        <div class="relative p-7 md:p-9 border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">84</p>
          <p class="text-brand-white/70 leading-relaxed">respondents compared two variants</p>
        </div>
        <div class="relative p-7 md:p-9">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.2rem, 4.5vw, 4rem);">p = 0.037</p>
          <p class="text-brand-white/70 leading-relaxed">statistically significant difference in task time</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Content -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— WHAT THE DATA SHOWED</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— WHAT WE NEEDED TO FIND OUT</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">Does the way a product is presented affect how a shopping task unfolds?</p>
            <p class="text-brand-black/70 leading-relaxed">The study compared a plain packshot with a photo of the product “on a person”. The goal was not to pick the nicer image, but to verify whether the type of photography changes the time needed to complete the same task.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— HOW THE MEASUREMENT WORKED</span></p>
            <p class="text-brand-black/70 leading-relaxed">84 respondents took part in the controlled experiment. They completed e-commerce tasks over variants of the product presentation; the process was supplemented with eye-tracking data and the standardized UEQ questionnaire for a subjective rating of the user experience.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ WHAT THE STUDY SAYS — AND WHAT IT DOESN'T ]</p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
                <div class="bg-brand-white p-6">
                  <p class="font-mono text-xs tracking-widest mb-4" style="color:#2D62FC">SUPPORTED BY DATA</p>
                  <p class="text-brand-black/70 leading-relaxed">In the tested task, lifestyle photography led to a longer time than the plain packshot. The difference was statistically significant.</p>
                </div>
                <div class="bg-brand-white p-6">
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">CANNOT BE INFERRED</p>
                  <p class="text-brand-black/70 leading-relaxed">That lifestyle photography generally reduces conversion, that it is always worse, or that users rated it better or worse.</p>
                </div>
              </div>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">The result applies to the specific variants, sample and the tested e-commerce task.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— RECOMMENDATION FOR PRACTICE</span></p>
            <p class="text-brand-black/70 leading-relaxed">Don't choose product photography by impression alone. Validate it on the specific task the page is meant to support, and assess the time or course of the decision together with behaviour, attention and business data.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ THE TAKEAWAY ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">The same product can change how people decide depending on how you show it<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">Testing variants helps choose the photo by the customer's task, not by the team's preference.</p>
            <a href="/en/contact" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">DISCUSS YOUR OWN STUDY →</a>
          </section>
        </div>

        <!-- Facts + photo (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">STUDY PRODUCED IN COLLABORATION WITH</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="University of Hradec Králové — Faculty of Informatics and Management"
                title="Study produced in collaboration with FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">MEASUREMENT FACTS</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <div class="border border-brand-black/10 p-4 bg-brand-white">
                <svg viewBox="0 0 320 210" class="w-full" role="img" aria-label="Diagram of two product page variants: packshot and lifestyle photography">
                  <rect x="4" y="4" width="150" height="170" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="24" y="24" width="110" height="90" fill="rgba(10,10,10,0.06)"/>
                  <rect x="62" y="40" width="34" height="58" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="70" y="32" width="18" height="10" fill="#0A0A0A"/>
                  <rect x="24" y="126" width="70" height="7" fill="rgba(10,10,10,0.35)"/>
                  <rect x="24" y="140" width="46" height="7" fill="#2D62FC"/>
                  <text x="4" y="196" font-family="monospace" font-size="11" fill="#0A0A0A">PACKSHOT</text>
                  <rect x="166" y="4" width="150" height="170" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="186" y="24" width="110" height="90" fill="rgba(10,10,10,0.06)"/>
                  <circle cx="222" cy="52" r="14" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <path d="M 200 114 Q 222 76 244 114" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="256" y="62" width="20" height="36" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                  <rect x="186" y="126" width="70" height="7" fill="rgba(10,10,10,0.35)"/>
                  <rect x="186" y="140" width="46" height="7" fill="rgba(10,10,10,0.2)"/>
                  <text x="166" y="196" font-family="monospace" font-size="11" fill="#0A0A0A">LIFESTYLE</text>
                </svg>
              </div>
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Diagram of the tested variants: plain packshot vs. product “on a person”</figcaption>
            </figure>
            <a href="/en/contact" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              NO-OBLIGATION ENQUIRY →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ GLOSSARY — WHAT THE TERMS IN THIS STUDY MEAN ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">N (sample)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">The number of people included in the analysis. In this study N = 84.</dd></div>
            <div><dt class="font-display font-bold mb-1">F(1,82)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">The value of the test statistic and its degrees of freedom in the statistical test used.</dd></div>
            <div><dt class="font-display font-bold mb-1">p-value</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Helps assess how compatible the data are with the assumption that there is no difference between the variants. It does not by itself describe the size of the impact.</dd></div>
            <div><dt class="font-display font-bold mb-1">UEQ</dt><dd class="text-sm text-brand-black/70 leading-relaxed">A standardized questionnaire for the subjective rating of the user experience.</dd></div>
          </dl>
        </details>
      </section>

      <!-- Study FAQ -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ FREQUENTLY ASKED QUESTIONS ABOUT THE STUDY ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Narrow strip: full study (opens modal) -->
      <section class="reveal mt-16 !hidden bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Want to go through the study in more detail<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">DETAILED REPORT WITH METHODOLOGY AND RECOMMENDATIONS — FREE PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          REQUEST STUDY →
        </button>
      </section>

      <!-- Navigation between studies -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="More case studies">
        <a href="/en/case-studies/backend-stories" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← PREVIOUS STUDY</p>
          <p class="font-display font-bold leading-snug">The longer the text, the less attention</p>
        </a>
        <a href="/en/case-studies/ad-banners-gaze-direction" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">NEXT STUDY →</p>
          <p class="font-display font-bold leading-snug">A character's gaze steered visitors' attention</p>
        </a>
      </nav>

    </div>

      <!-- Modal: request the full study -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ DETAILED STUDY ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Close window">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Want to go through the study in more detail<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">The studies are abridged and anonymized.</p>
          <form class="study-request space-y-4" data-pdf="" data-study="The same product. A different length of decision.">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">NAME *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Your name"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">COMPANY</label>
              <input type="text" id="sr-company" name="company" placeholder="Company name (optional)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="you@email.com"
                class="study-input" />
            </div>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              VIEW STUDY (PDF) →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/50 p-3">Thank you! If the study didn't open by itself, <a href="#" class="study-pdf-link underline hover:text-brand-white/70" target="_blank" rel="noopener">open it with this link</a>.</p>
            <p class="font-mono text-[11px] text-brand-white/70 leading-relaxed">By submitting you agree to view the study and to receive occasional business offers from UX MIND. You can unsubscribe at any time with a single click.</p>
          </form>
        </div>
      </dialog>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../../../scripts/case-study';
</script>
