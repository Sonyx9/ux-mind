---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { features } from '../../../config';

const fakta = [["METHOD", "Eye-tracking experiment"], ["SAMPLE", "104 respondents"], ["VARIABLE", "Direction of the character's gaze"], ["STATISTICS", "F(1,102) = 12.57 · p < 0.001 · ηp² = 0.11"]];
const zjisteni = ["Changing the direction of the character's gaze had a statistically significant effect on the distribution of visual attention: F(1,102) = 12.57; p < 0.001.", "The effect size ηp² = 0.11 corresponds, by commonly used rule-of-thumb thresholds, to a medium-sized effect.", "In the tested creatives the character's composition thus worked as a visual cue. The study, however, did not measure clicks, message recall or conversion."];
const faq = [
  { q: "Did the direction of the character's gaze affect attention?", a: "Yes; in the tested creatives and on a sample of 104 respondents, the distribution of attention between the variants differed to a statistically significant degree: p < 0.001; ηp² = 0.11." },
  { q: "Does this mean we should always turn the character toward the CTA?", a: "Not automatically. The result supports gaze direction as a relevant compositional variable. The suitable variant depends on the specific photo, message, format and goal of the creative, so we recommend comparing real designs." },
  { q: "Did the study prove more clicks or conversions?", a: "No. The study measured the distribution of visual attention, not clicks, recall, purchase or any other business metric. A shift of attention is an important intermediate step, but on its own it does not guarantee action." },
  { q: "What does ηp² = 0.11 mean?", a: "Partial eta squared describes the effect size in the statistical model used. By common rule-of-thumb thresholds the value 0.11 is interpreted as a medium-sized effect; it does not, however, automatically mean an 11% increase in campaign performance." },
  { q: "What does p < 0.001 mean?", a: "If gaze direction in fact had no effect in the model used and its assumptions were met, a result this pronounced or more would be very unusual. The p-value itself does not describe the size or the business value of the effect." },
  { q: "Do we have to redo the whole creative for a test?", a: "Not necessarily. Often it is enough to prepare controlled variants of the photo, crop or position of the character. The other elements should stay as similar as possible so the difference can be interpreted meaningfully." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "A character's gaze steered visitors' attention.",
    about: 'Eye tracking, UX research',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'en',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="en"
  title="Case study: how gaze direction influenced attention"
  description="Eye-tracking experiment with 104 respondents: changing the direction of the character's gaze influenced the distribution of attention, F(1,102) = 12.57; p < 0.001; ηp² = 0.11."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/en/case-studies" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← ALL STUDIES</a>

      <!-- Study header -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Ad creative</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          A character's gaze steered visitors' attention<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Key results -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-1 md:grid-cols-3">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative p-7 md:p-9 border-t-4 border-t-brand-blue border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-mono text-xs tracking-widest text-brand-white/60 mb-5">DIRECTION OF GAZE</p>
          <p class="font-display text-2xl md:text-3xl font-bold leading-tight">Changed the distribution of attention</p>
        </div>
        <div class="relative p-7 md:p-9 border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">104</p>
          <p class="text-brand-white/70 leading-relaxed">respondents in the experiment</p>
        </div>
        <div class="relative p-7 md:p-9">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.2rem, 4.5vw, 4rem);">ηp² = 0.11</p>
          <p class="text-brand-white/70 leading-relaxed">medium-sized effect · p &lt; 0.001</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Content -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— WHAT THE DATA SHOWED</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— WHAT WE NEEDED TO FIND OUT</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">Does the direction of the character's gaze change the distribution of attention in a creative?</p>
            <p class="text-brand-black/70 leading-relaxed">A human face in advertising attracts attention. The experiment tested whether changing the direction of the character's gaze also affects how respondents distribute their attention between the face and the other parts of the tested creative.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— HOW THE MEASUREMENT WORKED</span></p>
            <p class="text-brand-black/70 leading-relaxed">104 respondents took part in the eye-tracking experiment. The creative variants differed in the direction of the character's gaze, and the analysis compared the distribution of visual attention between predefined areas.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ PRINCIPLE OF THE TESTED VARIANTS ]</p>
              <svg viewBox="0 0 640 300" class="w-full" role="img" aria-label="Illustrative diagram: the direction of the character's gaze guides the viewer's attention">
  <text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">ILLUSTRATIVE DIAGRAM OF THE VARIANTS · NOT A HEATMAP</text>
  <g>
    <rect x="0" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <circle cx="70" cy="110" r="26" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <circle cx="62" cy="105" r="3" fill="#0A0A0A"/><circle cx="80" cy="105" r="3" fill="#0A0A0A"/>
    <rect x="200" y="140" width="70" height="46" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <text x="8" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">GAZE INTO THE CAMERA</text>
    <text x="8" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">composition variant A</text>
  </g>
  <g>
    <rect x="340" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <circle cx="410" cy="110" r="26" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <circle cx="424" cy="108" r="3" fill="#0A0A0A"/><circle cx="432" cy="112" r="3" fill="#0A0A0A"/>
    <line x1="440" y1="118" x2="530" y2="152" stroke="#2D62FC" stroke-width="2" stroke-dasharray="4 4"/>
    <rect x="540" y="140" width="70" height="46" fill="none" stroke="#0A0A0A" stroke-width="2"/>
    <text x="348" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">GAZE AT THE PRODUCT</text>
    <text x="348" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">composition variant B</text>
  </g>
  <text x="0" y="296" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">CUE EFFECT: F(1,102) = 12.57 · p &lt; 0.001 · ηp² = 0.11 (MEDIUM-SIZED EFFECT)</text>
</svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">The diagram only explains the manipulated variable. It does not show the actual stimuli or the participants' heatmap; the statistics come from a real measurement.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— RECOMMENDATION FOR PRACTICE</span></p>
            <p class="text-brand-black/70 leading-relaxed">Include gaze direction among the variables when designing and testing creatives. If the character is meant to support attention to a specific message or product, prepare controlled variants and validate them together with campaign metrics.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ THE TAKEAWAY ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">Even a small change of composition can shift the distribution of attention<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">Eye tracking helps choose a variant based on what people actually notice. The impact on clicks or conversion needs to be verified with follow-up data.</p>
            <a href="/en/contact" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">DISCUSS A CREATIVE TEST →</a>
          </section>
        </div>

        <!-- Facts + photo (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">STUDY PRODUCED IN COLLABORATION WITH</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="University of Hradec Králové — Faculty of Informatics and Management"
                title="Study produced in collaboration with FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">MEASUREMENT FACTS</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/laborator-ux-vyzkumu-vizualizace-1.webp`}
                alt="Visualization of the lab's testing workspace — separate booths with workstations"
                width="1080" height="762" loading="lazy" decoding="async"
                class="w-full h-52 object-cover border border-brand-black/10"
              />
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Visualization of the testing booths where creatives are measured without disturbance</figcaption>
            </figure>
            <a href="/en/contact" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              NO-OBLIGATION ENQUIRY →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ GLOSSARY — WHAT THE TERMS IN THIS STUDY MEAN ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">N (sample)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">The number of people included in the analysis. In this study N = 104.</dd></div>
            <div><dt class="font-display font-bold mb-1">F(1,102)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">The value of the test statistic and its degrees of freedom in the statistical test used.</dd></div>
            <div><dt class="font-display font-bold mb-1">p-value</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Helps assess how compatible the data are with the assumption that gaze direction had no effect in the model used.</dd></div>
            <div><dt class="font-display font-bold mb-1">ηp²</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Partial eta squared expresses the effect size in the given statistical model. It is not a percentage increase in campaign performance.</dd></div>
          </dl>
        </details>
      </section>

      <!-- Study FAQ -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ FREQUENTLY ASKED QUESTIONS ABOUT THE STUDY ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Narrow strip: full study (opens modal) -->
      <section class:list={["reveal mt-16 bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5", !features.studyDownloads && "!hidden"]}>
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Want to go through the study in more detail<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">DETAILED REPORT WITH METHODOLOGY AND RECOMMENDATIONS — FREE PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          REQUEST STUDY →
        </button>
      </section>

      <!-- Navigation between studies -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="More case studies">
        <a href="/en/case-studies/product-photography-e-commerce" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← PREVIOUS STUDY</p>
          <p class="font-display font-bold leading-snug">The same product. A different length of decision</p>
        </a>
        <a href="/en/case-studies/e-shop-templates" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">NEXT STUDY →</p>
          <p class="font-display font-bold leading-snug">The task changed where people focused their attention.</p>
        </a>
      </nav>

    </div>

      <!-- Modal: request the full study -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ DETAILED STUDY ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Close window">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Want to go through the study in more detail<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">The studies are abridged and anonymized.</p>
          <form class="study-request space-y-4" data-pdf="" data-study="A character's gaze steered visitors' attention.">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">NAME *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Your name"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">COMPANY</label>
              <input type="text" id="sr-company" name="company" placeholder="Company name (optional)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="you@email.com"
                class="study-input" />
            </div>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              VIEW STUDY (PDF) →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/50 p-3">Thank you! If the study didn't open by itself, <a href="#" class="study-pdf-link underline hover:text-brand-white/70" target="_blank" rel="noopener">open it with this link</a>.</p>
            <p class="font-mono text-[11px] text-brand-white/70 leading-relaxed">By submitting you agree to view the study and to receive occasional business offers from UX MIND. You can unsubscribe at any time with a single click.</p>
          </form>
        </div>
      </dialog>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../../../scripts/case-study';
</script>
