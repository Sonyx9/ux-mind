---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const fakta = [["METHOD", "Eye tracking + questionnaire"], ["SAMPLE", "102 respondents"], ["SCENARIO", "“Find the open IT positions”"], ["OUTPUTS", "Fixation metrics, A/B comparison of CTA"]];
const zjisteni = ["40% of users couldn't find an effective path to the open positions.", "An A/B comparison of the floating CTA produced measurable differences in fixation metrics and in the visit length of the variants.", "The key point: the subjective rating of “clarity” did not match the ability to complete the task — the site was liked even by people who never found the positions."];
const faq = [
  { q: "How many people took part in the career portal study?", a: "102 respondents, mostly from the target group for junior recruitment. We measured with eye tracking using the scenario “find the open IT positions”, supplemented with a questionnaire." },
  { q: "What was the study's main finding?", a: "40% of applicants couldn't find an effective path to the open positions, even though they rated the site as clear. The subjective impression of clarity did not match real task success." },
  { q: "What changed on the site after the study?", a: "The path to open positions was simplified, the navigation was rebuilt and the CTA was adjusted to the context of the applicant's task." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "40% of applicants couldn't find their way to open positions",
    about: 'Eye tracking, UX research',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'en',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="en"
  title="Case study: 40% of applicants couldn't find open positions"
  description="Eye tracking of an automotive company's career portal: 40% of 102 respondents couldn't find an effective path to the open positions. A/B test of the CTA, fixation metrics, navigation rebuild."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/en/case-studies" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← ALL STUDIES</a>

      <!-- Study header -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Automotive · career portal</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-4xl" style="font-size: clamp(3rem, 9vw, 8rem);">
          40% of applicants couldn't find their way to open positions<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Statistics banner -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white p-8 md:p-12 mb-16 flex flex-col md:flex-row md:items-center gap-6 md:gap-12">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252.252.252.0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252.252.252.0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <p class="relative font-display font-bold leading-none tracking-tight whitespace-nowrap" style="font-size: clamp(3rem, 8vw, 6.5rem);" data-count="40" data-suffix=" %">40 %</p>
        <p class="relative text-brand-white/70 text-lg leading-relaxed max-w-md">of applicants couldn't find their way to open positions — on a site that “looked clear”</p>
      </div>

      <section class="reveal mb-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ GLOSSARY — WHAT THE NUMBERS IN THIS STUDY MEAN ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 space-y-4">
            <div><dt class="font-display font-bold mb-1">N (sample)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">The number of real people who took part in the measurement. N = 102 means 102 respondents.</dd></div>
            <div><dt class="font-display font-bold mb-1">p-value</dt><dd class="text-sm text-brand-black/70 leading-relaxed">The probability that the measured difference arose by pure chance. The smaller it is, the more conclusive the result — p = 0.037 means only a 3.7% chance of coincidence (anything below 5% is considered conclusive).</dd></div>
            <div><dt class="font-display font-bold mb-1">Effect size (ηp²)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Tells you how large the difference is in practice — not just whether it exists. As a rough guide: 0.01 small, 0.06 medium, 0.14 large effect.</dd></div>
            <div><dt class="font-display font-bold mb-1">Fixation</dt><dd class="text-sm text-brand-black/70 leading-relaxed">A brief stop of the eye on one spot (fractions of a second). The sequence of fixations makes up everything a person actually “saw” on the page.</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI (area of interest)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">A predefined part of the page — a button, a heading, a photo — for which we measure how much attention it received.</dd></div>
            <div><dt class="font-display font-bold mb-1">UEQ / VisAWI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Standardized scientific questionnaires: UEQ measures the overall user experience, VisAWI the perceived aesthetics of a website. Thanks to standardization, results are comparable across studies.</dd></div>
          </dl>
        </details>
      </section>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Content -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— CONTEXT</span></p>
            <p class="text-lg text-brand-black/80 leading-relaxed">The career portal of a large automotive company was going through a redesign. The internal team considered the site clear and the analytics data did not signal a major problem — only the conversion into submitted CVs did not match the traffic. Classic metrics couldn't say why.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— BUSINESS QUESTION</span></p>
            <p class="font-display text-2xl font-bold leading-snug">A career site has one key job — to lead applicants to the open position listings. Is it doing it?</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— MEASUREMENT</span></p>
            <p class="text-brand-black/70 leading-relaxed">Eye tracking with the scenario “find the open IT positions”, supplemented with a questionnaire. The sample consisted mostly of a student population with a high proportion of IT students — we state this limit deliberately: it matches the target group for junior recruitment, for senior roles the measurement would need to be extended.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">04</span> <span class="text-brand-black/60">— WHAT THE DATA SHOWED</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ DATA VISUALIZED ]</p>
              <svg viewBox="0 0 640 174" class="w-full" role="img" aria-label="Of 102 respondents, 60 percent found their way to the positions and 40 percent did not"><text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10.10.10.0.6)">N = 102 · SCENARIO “FIND THE OPEN POSITIONS”</text><text x="0" y="67" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">FOUND THE WAY</text><rect x="190" y="52" width="400" height="22" fill="rgba(10.10.10.0.06)"/><rect x="190" y="52" width="240" height="22" fill="#0A0A0A" class="viz-bar"/><text x="430" y="67" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">60 %</text><text x="0" y="119" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">DIDN'T FIND THE WAY</text><rect x="190" y="104" width="400" height="22" fill="rgba(10.10.10.0.06)"/><rect x="190" y="104" width="160" height="22" fill="#2D62FC" class="viz-bar"/><text x="350" y="119" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">40 %</text></svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">Four out of ten applicants never reached the listings at all — each of them is a direct loss from the recruitment funnel.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— WHAT WAS DECIDED</span></p>
            <p class="text-brand-black/70 leading-relaxed">Simplifying the path to positions, rebuilding the navigation and working with the CTA in the context of the applicant's task.</p>
          </section>

          <section class="reveal border border-brand-black p-8">
            <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-4">WHAT EMLI WOULD ADD TODAY</p>
            <p class="text-brand-black/70 leading-relaxed">For a similar brief today we additionally measure the EMLI cognitive load index for each step of the path — it would show whether the successful 60% of users succeeded easily, or on the edge of frustration.</p>
          </section>
        </div>

        <!-- Facts + photo (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">STUDY PRODUCED IN COLLABORATION WITH</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="University of Hradec Králové — Faculty of Informatics and Management"
                title="Study produced in collaboration with FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">MEASUREMENT FACTS</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/eye-tracking-mereni-respondentka-laborator.webp`}
                alt="A respondent during eye-tracking measurement in the lab — watching the tested website on a monitor with an eye tracker"
                width="1080" height="720" loading="lazy" decoding="async"
                class="w-full h-52 object-cover border border-brand-black/10"
              />
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">The measurement ran with the scenario “find the open positions” on a monitor with an eye tracker</figcaption>
            </figure>
            <a href="/en/contact" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              GET A QUOTE →
            </a>
          </div>
        </aside>
      </div>

      <!-- Study FAQ -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ FREQUENTLY ASKED QUESTIONS ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Narrow strip: full study (opens modal) -->
      <section class="reveal mt-16 bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Want to go through the study in more detail<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">DETAILED REPORT WITH METHODOLOGY AND RECOMMENDATIONS — FREE PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          REQUEST STUDY →
        </button>
      </section>

      <!-- Navigation between studies -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="More case studies">
        <a href="/en/case-studies/billboardy-sport-marketing" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← PREVIOUS STUDY</p>
          <p class="font-display font-bold leading-snug">16 billboard designs, 79 pairs of eyes</p>
        </a>
        <a href="/en/case-studies/backend-stories" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">NEXT STUDY →</p>
          <p class="font-display font-bold leading-snug">92% of gazes landed on the main CTA</p>
        </a>
      </nav>

      <!-- Closing CTA -->
      <div class="reveal bg-brand-black text-brand-white text-center p-10 md:p-14 mt-10">
        <h2 class="font-display text-3xl md:text-4xl font-bold mb-8">Test the key path on your website<span style="color:#2D62FC">.</span></h2>
        <a href="/en/contact" class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          GET A QUOTE →
        </a>
        <p class="font-mono text-xs text-brand-white/60 mt-6">TYPICAL PACKAGE FOR THIS KIND OF WORK: <a href="/en/services/test-packages" class="text-brand-white underline hover:no-underline">Standard UX test</a></p>
      </div>
    </div>

      <!-- Modal: request the full study -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ DETAILED STUDY ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Close window">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Want to go through the study in more detail<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">The studies are abridged and anonymized.</p>
          <form class="study-request space-y-4" data-pdf={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/studie/karierni-portal-automotive.pdf`} data-study="40% of applicants couldn't find their way to open positions">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">NAME *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Your name"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">COMPANY</label>
              <input type="text" id="sr-company" name="company" placeholder="Company name (optional)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="you@email.com"
                class="study-input" />
            </div>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              VIEW STUDY (PDF) →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/50 p-3">Thank you! If the study didn't open by itself, <a href="#" class="study-pdf-link underline hover:text-brand-white/70" target="_blank" rel="noopener">open it with this link</a>.</p>
            <p class="font-mono text-[11px] text-brand-white/70 leading-relaxed">By submitting you agree to view the study and to receive occasional business offers from UX MIND. You can unsubscribe at any time with a single click.</p>
          </form>
        </div>
      </dialog>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../../../scripts/case-study';
</script>
