---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { features } from '../../../config';

const fakta = [["METHOD", "Eye tracking + rating survey + TOP3"], ["SAMPLE", "79 respondents · 43 men, 36 women · 17–25 years"], ["STIMULI", "16 designs · each shown for 10 seconds"], ["OUTPUTS", "Ranking of variants + visual attention metrics"]];
const zjisteni = ["All six top-rated designs had a black background. The white variants clustered in the lower part of the ranking.", "The winning design achieved the highest weighted score in the TOP3 selection and also the best average ranking.", "Fixation metrics differed only slightly between the best- and worst-rated variants. The ranking was therefore not decided by the level of visual attention alone.", "In the survey, 39% of women and 16% of men stated that visual advertising influences their attendance of a sports event. This is a declared influence, not a measured change in purchasing behaviour."];
const faq = [
  { q: "Does the result mean a black billboard always works better?", a: "No. The black background dominated in this set of 16 designs for a specific football campaign and target group. The result cannot be transferred without further work to every brand, message or placement." },
  { q: "What exactly decided the winning variant?", a: "The winning design achieved the best weighted score in the TOP3 selection and the best average ranking. Eye tracking helped describe visual attention, but fixation metrics alone did not explain the ranking of the variants." },
  { q: "Does 39% vs. 16% prove that advertising influences women more?", a: "Respondents stated this in the survey, so it is a declared influence. The study does not thereby prove that the billboard actually changed ticket purchases or that gender was the cause of the difference." },
  { q: "Why combine eye tracking with a survey?", a: "Eye tracking shows where visual attention was directed. A survey captures preferences, clarity and intent. In this study it was precisely their combination that showed more attention does not automatically mean a better rating." },
  { q: "Can creative be chosen this way before a campaign launches?", a: "Yes. Several final variants can be compared on the target group before production and media deployment. It is important to decide in advance by which goal the winner will be chosen." },
  { q: "Does a similar study also measure ticket sales?", a: "Not automatically. A lab study helps choose and explain creative. The real impact on attendance or sales needs to be verified with subsequent data from the campaign or with a field experiment." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "The first six places belonged to the black billboards.",
    about: 'Eye tracking, UX research',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'en',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="en"
  title="Case study: choosing a billboard with eye tracking"
  description="Eye tracking and the rating of 16 billboard designs with 79 respondents: the black variants took the first six places, but fixation metrics alone did not determine the winner."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/en/case-studies" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← ALL STUDIES</a>

      <!-- Study header -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Sports marketing · OOH</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          The first six places belonged to the black billboards<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Study design -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-1 md:grid-cols-3">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative p-7 md:p-9 border-t-4 border-t-brand-blue border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">6/6</p>
          <p class="text-brand-white/70 leading-relaxed">of the top-rated variants had a black background</p>
        </div>
        <div class="relative p-7 md:p-9 border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">16</p>
          <p class="text-brand-white/70 leading-relaxed">billboard designs compared</p>
        </div>
        <div class="relative p-7 md:p-9">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">79</p>
          <p class="text-brand-white/70 leading-relaxed">respondents from the target age group</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Content -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— WHAT THE DATA SHOWED</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— WHAT NEEDED TO BE DECIDED</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">Which of the 16 designs should go into the campaign to boost stadium attendance?</p>
            <p class="text-brand-black/70 leading-relaxed">The football club didn't want to choose based only on the marketing team's opinion. It therefore compared the variants on young people from the target group and observed their attention as well as their subsequent ratings.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— HOW THE MEASUREMENT WORKED</span></p>
            <p class="text-brand-black/70 leading-relaxed">Each of the 79 respondents saw all 16 designs for 10 seconds. Eye tracking recorded visual attention. A rating survey and a TOP3 selection added the overall rating, clarity and the declared intention to attend the match.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">04</span> <span class="text-brand-black/60">— HOW TO READ THE RESULT</span></p>
            <p class="text-brand-black/70 leading-relaxed">The study picked a winner among specific designs. It does not prove that a black background generally increases the performance of every billboard. Likewise the survey figure 39% vs. 16% describes what respondents stated — not an actual change in ticket sales.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ DATA VISUALIZED ]</p>
              <svg viewBox="0 0 640 174" class="w-full" role="img" aria-label="In the survey, 39 percent of women and 16 percent of men stated that visual advertising influences their attendance of a sports event"><text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">DECLARED INFLUENCE OF VISUAL ADVERTISING · SURVEY · N = 79</text><text x="0" y="67" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">WOMEN</text><rect x="190" y="52" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="52" width="156" height="22" fill="#2D62FC" class="viz-bar"/><text x="346" y="67" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">39 %</text><text x="0" y="119" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">MEN</text><rect x="190" y="104" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="104" width="64" height="22" fill="#0A0A0A" class="viz-bar"/><text x="254" y="119" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">16 %</text></svg>
<svg viewBox="0 0 640 120" class="w-full mt-2" role="img" aria-label="Six top-rated designs had a black background; the lower cluster consisted of white variants">
  <text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">RATING OF 16 DESIGNS · TOP 6 vs LOWER CLUSTER</text>
  <g>
    <rect x="0" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="48" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="96" y="36" width="40" height="26" fill="#0A0A0A"/>
    <rect x="144" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="192" y="36" width="40" height="26" fill="#0A0A0A"/><rect x="240" y="36" width="40" height="26" fill="#0A0A0A"/>
    <text x="292" y="54" font-family="monospace" font-size="11" fill="#0A0A0A">TOP 6 = BLACK BACKGROUND</text>
  </g>
  <g stroke="rgba(10,10,10,0.4)" fill="none">
    <rect x="0" y="76" width="40" height="26"/><rect x="48" y="76" width="40" height="26"/><rect x="96" y="76" width="40" height="26"/><rect x="144" y="76" width="40" height="26"/>
    <text x="196" y="94" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)" stroke="none">LOWER CLUSTER = WHITE VARIANTS</text>
  </g>
</svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">The chart combines the ranking of the tested variants with the survey responses. The 39% vs. 16% figure does not express a measured campaign impact on ticket sales.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— RECOMMENDATION FOR THE CAMPAIGN</span></p>
            <p class="text-brand-black/70 leading-relaxed">For further development, choose the winning black variant and keep its clear hierarchy, a strong headline and one main goal. Then evaluate the creative's real impact on data from the deployed campaign.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ THE TAKEAWAY ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">Attention and preference are not the same thing<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">Eye tracking shows what people see. Rating the variants adds which creative they prefer. To choose a campaign you need to read both results together.</p>
            <a href="/en/contact" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">DISCUSS A CREATIVE TEST →</a>
          </section>
        </div>

        <!-- Facts + photo (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">STUDY PRODUCED IN COLLABORATION WITH</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="University of Hradec Králové — Faculty of Informatics and Management"
                title="Study produced in collaboration with FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">MEASUREMENT FACTS</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <div class="border border-brand-black/10 p-4 bg-brand-white">
                <svg viewBox="0 0 320 210" class="w-full" role="img" aria-label="Illustrative diagram of the principle of the top-rated billboards: black background with a strong headline">
                  <rect x="24" y="16" width="272" height="120" fill="#0A0A0A"/>
                  <rect x="48" y="44" width="130" height="14" fill="#FCFCFC"/>
                  <rect x="48" y="68" width="90" height="8" fill="rgba(252,252,252,0.5)"/>
                  <rect x="48" y="100" width="64" height="16" fill="#2D62FC"/>
                  <circle cx="248" cy="76" r="26" fill="none" stroke="rgba(252,252,252,0.6)" stroke-width="2"/>
                  <rect x="96" y="136" width="10" height="52" fill="#0A0A0A"/>
                  <rect x="214" y="136" width="10" height="52" fill="#0A0A0A"/>
                  <text x="24" y="204" font-family="monospace" font-size="11" fill="#0A0A0A">TOP 6: BLACK BACKGROUND · STRONG HEADLINE</text>
                </svg>
              </div>
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Illustrative diagram of the shared principle of the six top-rated variants</figcaption>
            </figure>
            <a href="/en/contact" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              NO-OBLIGATION ENQUIRY →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ GLOSSARY — HOW TO READ THE STUDY RESULTS ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">N (sample)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">The number of people included in the study. In this case N = 79.</dd></div>
            <div><dt class="font-display font-bold mb-1">TOP3</dt><dd class="text-sm text-brand-black/70 leading-relaxed">A selection of three preferred variants. The order and frequency of choices can be converted into a weighted score.</dd></div>
            <div><dt class="font-display font-bold mb-1">Fixation</dt><dd class="text-sm text-brand-black/70 leading-relaxed">A brief stop of the eye in a certain area. It describes visual attention, not automatically comprehension, preference or purchase.</dd></div>
            <div><dt class="font-display font-bold mb-1">Declared influence</dt><dd class="text-sm text-brand-black/70 leading-relaxed">What a participant stated in the survey. It is not a directly measured change in their actual behaviour.</dd></div>
          </dl>
        </details>
      </section>

      <!-- Study FAQ -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ FREQUENTLY ASKED QUESTIONS ABOUT THE STUDY ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Narrow strip: full study (opens modal) -->
      <section class:list={["reveal mt-16 bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5", !features.studyDownloads && "!hidden"]}>
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Want to go through the study in more detail<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">DETAILED REPORT WITH METHODOLOGY AND RECOMMENDATIONS — FREE PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          REQUEST STUDY →
        </button>
      </section>

      <!-- Navigation between studies -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="More case studies">
        <a href="/en/case-studies/e-shop-templates" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← PREVIOUS STUDY</p>
          <p class="font-display font-bold leading-snug">The task changed where people focused their attention.</p>
        </a>
        <a href="/en/case-studies/career-portal-automotive" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">NEXT STUDY →</p>
          <p class="font-display font-bold leading-snug">40% of applicants couldn't find their way to open positions</p>
        </a>
      </nav>

    </div>

      <!-- Modal: request the full study -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ DETAILED STUDY ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Close window">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Want to go through the study in more detail<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">The studies are abridged and anonymized.</p>
          <form class="study-request space-y-4" data-pdf="" data-study="The first six places belonged to the black billboards.">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">NAME *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Your name"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">COMPANY</label>
              <input type="text" id="sr-company" name="company" placeholder="Company name (optional)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="you@email.com"
                class="study-input" />
            </div>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              VIEW STUDY (PDF) →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/50 p-3">Thank you! If the study didn't open by itself, <a href="#" class="study-pdf-link underline hover:text-brand-white/70" target="_blank" rel="noopener">open it with this link</a>.</p>
            <p class="font-mono text-[11px] text-brand-white/70 leading-relaxed">By submitting you agree to view the study and to receive occasional business offers from UX MIND. You can unsubscribe at any time with a single click.</p>
          </form>
        </div>
      </dialog>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../../../scripts/case-study';
</script>
