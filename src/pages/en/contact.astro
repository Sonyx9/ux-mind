---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { features } from '../../config';
---

<BaseLayout
  lang="en"
  title="Contact"
  description="Arrange a no-obligation consultation on user testing, a website UX audit or eye tracking. We respond within 48 hours."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CONTACT ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          LET’S<br/>VERIFY IT<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-16">

        <!-- Contact info -->
        <div>
          <p class="text-xl text-brand-black/60 leading-relaxed mb-12">
            Send us a website, app, campaign or a brief description of the problem. We’ll get back to you within 48 hours and propose what makes sense to verify and which approach to take.
          </p>

          <div class="space-y-6">
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">EMAIL</p>
              <a href="mailto:spoluprace@uxmind.cz" class="font-display text-2xl font-bold hover:text-brand-blue transition-colors">
                spoluprace@uxmind.cz
              </a>
            </div>
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">PHONE</p>
              <a href="tel:+420728601160" class="font-display text-2xl font-bold hover:text-brand-blue transition-colors">
                +420 728 601 160
              </a>
            </div>
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">LOCATION</p>
              <p class="font-display text-xl font-bold">K Lesu 180, Svinary<br/>500 09 Hradec Králové</p>
            </div>
          </div>

        </div>

        <!-- Contact form -->
        <div class="relative min-h-[620px]">
          <div class:list={["absolute inset-0 z-10 border border-brand-black/10 bg-brand-white/95 flex items-center justify-center p-8 text-center", features.contactForm && "hidden"]}>
            <div class="max-w-sm">
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CONTACT FORM ]</p>
              <p class="font-display text-4xl md:text-5xl font-bold tracking-tight mb-5">COMING SOON<span class="text-brand-blue">.</span></p>
              <p class="text-brand-black/60 leading-relaxed">
                Until we launch the form, write to us at <a href="mailto:spoluprace@uxmind.cz" class="font-bold text-brand-black hover:text-brand-blue transition-colors">spoluprace@uxmind.cz</a>.
              </p>
            </div>
          </div>
          <form class="space-y-6 opacity-20 pointer-events-none select-none" aria-hidden="true">
            <fieldset disabled>
            <div class="space-y-6">
            <div>
              <label for="f-name" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">NAME *</label>
              <input
                type="text"
                id="f-name"
                name="name"
                required
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent"
                placeholder="Your name"
              />
            </div>

            <div>
              <label for="f-email" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">EMAIL *</label>
              <input
                type="email"
                id="f-email"
                name="email"
                required
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent"
                placeholder="your@email.com"
              />
            </div>

            <div>
              <label for="f-company" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">COMPANY</label>
              <input
                type="text"
                id="f-company"
                name="company"
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent"
                placeholder="Company name"
              />
            </div>

            <div>
              <label for="f-service" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">WHAT THE PROJECT IS ABOUT</label>
              <select
                id="f-service"
                name="service"
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent appearance-none"
              >
                <option value="">Select an area...</option>
                <option value="ux-audit">UX Audit</option>
                <option value="eye-tracking">Eye Tracking</option>
                <option value="ux-vyzkum">UX Research</option>
                <option value="testovani">User Testing</option>
                <option value="konzultace">Consultation</option>
                <option value="jine">Other</option>
              </select>
            </div>

            <div>
              <label for="f-message" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">WHAT DO YOU NEED TO FIND OUT? *</label>
              <textarea
                id="f-message"
                name="message"
                required
                rows="5"
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent resize-none"
                placeholder="Just briefly describe the project, problem or decision you need help with."
              ></textarea>
            </div>

            <label class="flex items-start gap-2.5 cursor-pointer">
              <input type="checkbox" name="marketing" class="mt-0.5 shrink-0 accent-[#2D62FC]" />
              <span class="font-mono text-[11px] text-brand-black/60 leading-relaxed">I’d like to receive occasional tips and offers from UX MIND (optional).</span>
            </label>

            <p class="font-mono text-[11px] text-brand-black/50 leading-relaxed">By submitting you ask us to get in touch. How we handle your data is described in our <a href="/en/privacy-policy/" class="underline hover:text-brand-black" target="_blank" rel="noopener">privacy policy</a>.</p>

            <button
              type="submit"
              class="w-full border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors"
            >
              SEND ENQUIRY →
            </button>
            </div>
            </fieldset>
          </form>
        </div>
      </div>

      <!-- Operator and bank details -->
      <div class="mt-16 border border-brand-black/10 p-8 md:p-10">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ WEBSITE OPERATOR ]</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-8 text-sm">
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">COMPANY NAME</p>
            <p class="text-brand-black/80">UX MIND Research Lab s.r.o.</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">COMPANY ID (IČO)</p>
            <p class="text-brand-black/80">29714966</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">DATE OF REGISTRATION</p>
            <p class="text-brand-black/80">24 June 2026</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">FILE NUMBER</p>
            <p class="text-brand-black/80">C 57053, kept by the Regional Court in Hradec Králové</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">REGISTERED OFFICE</p>
            <p class="text-brand-black/80">K Lesu 180, Svinary, 500 09 Hradec Králové</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">BANK</p>
            <p class="text-brand-black/80">MONETA Money Bank, a.s.</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">ACCOUNT NUMBER</p>
            <p class="text-brand-black/80">283221603/0600</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">IBAN</p>
            <p class="text-brand-black/80 break-words">CZ96 0600 0000 0002 8322 1603</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">SWIFT / BIC</p>
            <p class="text-brand-black/80">AGBACZPP</p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
