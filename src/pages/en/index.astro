---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
).slice(0, 3);

const gifSrc = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/hero.webp`;
const yearSuffix = new Date().getFullYear().toString().slice(-2);

const clientLogos = [
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/skoda.png`, w: 1920, h: 630, alt: 'Škoda Auto' },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/fchk.png`, w: 800, h: 800, alt: 'FC Hradec Králové' },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`, w: 157, h: 37, alt: 'University of Hradec Králové' },
];
---

<BaseLayout lang="en" title="UX Research, Eye Tracking & User Testing | UXMIND" description="User testing, eye tracking and cognitive load measurement (EMLI model). Objective UX research backed by the FIM UHK science lab. Test your website on data.">
  <Navbar />

  <!-- HERO SECTION -->
  <section class="hero-shell relative overflow-hidden">

    <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true"
      style="background-image: linear-gradient(rgba(10,10,10,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.07) 1px, transparent 1px); background-size: 25% 33.333%;">
      <div class="hidden md:block">
      {[0, 25, 50, 75, 100].flatMap(x =>
        [0, 33.333, 66.667, 100].map(y => (
          <div class="absolute" style={`left:${x}%; top:${y}%; transform:translate(-50%,-50%);`}>
            <div class="relative" style="width:14px; height:14px;">
              <div class="absolute" style="top:50%; left:0; width:14px; height:1px; background:rgba(10,10,10,0.22); transform:translateY(-50%);"></div>
              <div class="absolute" style="left:50%; top:0; height:14px; width:1px; background:rgba(10,10,10,0.22); transform:translateX(-50%);"></div>
            </div>
          </div>
        ))
      )}
      </div>
    </div>

    <!-- Center CTA — below the hero figure, on the same grid row axis as the spec list -->
    <div class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 z-[60] hidden md:block" style="top: 83.333%;">
      <a href="/en/contact" class="inline-block bg-brand-black text-brand-white border border-brand-black px-6 py-2 font-mono text-xs tracking-widest uppercase transition-colors duration-200 hover:bg-transparent hover:text-brand-black">
        BOOK A MEETING
      </a>
    </div>

    <div class="absolute z-10" style="left: var(--desktop-gutter); top: 16.666%; transform: translateY(-50%); line-height: 1; margin: 0; padding: 0;">
      <h1 class="m-0 p-0 relative" style="line-height:0;">
        <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logo-2line.svg`} alt="UX Mind" width="264" height="88" style="width: clamp(8.4rem, 16.8vw, 264px); height:auto; display:block;" />
        <!-- Easter egg: hotspot over the logo's blue dot + patch shown while the dot is "escaped" -->
        <span id="logo-dot-hotspot" class="hidden md:block" style="position:absolute; left:89%; top:64%; width:14%; height:24%;"></span>
        <span id="logo-dot-patch" style="position:absolute; left:92.4%; top:69%; width:8%; height:14%; background:#FCFCFC; border-radius:50%; display:none;"></span>
      </h1>
      <!-- Mobile-only: first annotation below heading -->
      <p class="md:hidden font-mono tracking-widest text-brand-black/70 mt-3" style="font-size:10px;">WHERE RESEARCH REVEALS TRUTH</p>
    </div>

    <!-- Mobile hero image — static, shown immediately -->
    <div class="md:hidden absolute left-0 right-0 flex items-center justify-center" style="top: 33.333%; height: 33.334%;">
      <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/hero-mobile.webp`} alt="UX Mind — UX research and eye tracking" style="width:100vw; height:auto; object-fit:contain;" width="800" height="450" fetchpriority="high" decoding="async" />
    </div>

    <!-- Center 3D Brain — desktop only -->
    <div class="hidden md:flex absolute inset-0 items-center justify-center">
      <div id="hero-gif-container" class="relative" style="width: min(48vw, 760px); height: min(50vh, 540px);">
        <img
          id="hero-gif"
          src={gifSrc}
          alt="Animated neural network — a visualisation connecting UX research, eye tracking and data"
          class="w-full h-full object-contain"
          width="960" height="540" loading="lazy" decoding="async"
        />

        <!-- Annotation: top -->
        <div class="ann absolute hidden md:flex flex-col items-center opacity-0" style="left:50%; top:-30px; transform:translateX(-50%);">
          <p class="font-mono hero-fluid-micro tracking-widest text-center mb-1 max-w-32">WHERE RESEARCH<br/>REVEALS TRUTH</p>
          <div class="ann-line w-px bg-brand-black" style="height:0;" data-size="200"></div>
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
        </div>

        <!-- Annotation: left -->
        <div class="ann absolute hidden md:flex items-center opacity-0" style="left:22%; top:42%; transform:translate(-100%,-50%);">
          <div class="text-right mr-2">
            <p class="font-mono hero-fluid-micro tracking-widest">FROM THE USER'S<br/>PERSPECTIVE, DESIGN EMERGES</p>
          </div>
          <div class="ann-line h-px bg-brand-black" style="width:0;"></div>
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
        </div>

        <!-- Annotation: right top — top 40% keeps the text below the stats box bottom edge -->
        <div class="ann absolute hidden md:flex items-center opacity-0" style="right:22%; top:40%; transform:translate(100%,-50%);">
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
          <div class="ann-line h-px bg-brand-black" style="width:0;" data-size="110"></div>
          <div class="ml-2">
            <p class="font-mono hero-fluid-micro tracking-widest">EYE TRACKING<br/>REVEALS WHAT<br/>PEOPLE TRULY SEE</p>
          </div>
        </div>

        <!-- Annotation: right bottom -->
        <div class="ann absolute hidden md:flex items-center opacity-0" style="right:22%; top:65%; transform:translate(100%,-50%);">
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
          <div class="ann-line h-px bg-brand-black" style="width:0;" data-size="110"></div>
          <div class="ml-2">
            <p class="font-mono hero-fluid-micro tracking-widest">FOUNDATION<br/>FOR GROWTH</p>
          </div>
        </div>

        <!-- Annotation: bottom -->
        <div class="ann absolute hidden md:flex flex-col items-center opacity-0" style="left:50%; bottom:35%; transform:translate(-50%,100%);">
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
          <div class="ann-line w-px bg-brand-black" style="height:0;"></div>
          <p class="font-mono hero-fluid-micro tracking-widest text-center mt-1 max-w-24">DATA<br/>OVER IMPRESSIONS</p>
        </div>

      </div>
    </div>

    <div class="hero-stats-box hidden md:block absolute z-10 border border-brand-black p-4 bg-brand-white/90 backdrop-blur-sm" style="top: calc(var(--desktop-top-offset) + 3rem); left: calc(75% + clamp(12px,1.8vw,32px)); right: var(--desktop-gutter);">
      <div class="flex justify-between items-center mb-3">
        <p class="font-mono text-xs font-medium tracking-widest">UX MIND</p>
        <p class="font-mono text-xs text-brand-black/60">/{yearSuffix}</p>
      </div>
      <div class="space-y-2">
        <div class="flex items-baseline justify-between">
          <p class="font-display font-bold leading-none stat-projects" style="font-size: calc(clamp(24px, 1.2vw + 14px, 32px) * min(var(--fs, 1), 1.08));">50+</p>
          <p class="font-mono hero-fluid-micro text-brand-black/60 tracking-widest">PROJECTS</p>
        </div>
        <div class="flex items-baseline justify-between">
          <p class="font-display font-bold leading-none stat-respondents" style="font-size: calc(clamp(24px, 1.2vw + 14px, 32px) * min(var(--fs, 1), 1.08));">200+</p>
          <p class="font-mono hero-fluid-micro text-brand-black/60 tracking-widest">RESPONDENTS</p>
        </div>
        <div class="flex items-baseline justify-between gap-3 border-t border-brand-black/20 pt-2 mt-1">
          <p class="font-display font-bold leading-none stat-clicks" style="font-size: calc(clamp(24px, 1.2vw + 14px, 32px) * min(var(--fs, 1), 1.08));">50%</p>
          <p class="font-mono hero-fluid-micro text-brand-black/60 tracking-widest">MORE CLICK-THROUGHS</p>
        </div>
      </div>
    </div>

    <div class="hero-spec-list absolute z-10" style="left: var(--desktop-gutter); top: 83.333%; transform: translateY(-50%);">
      <p class="font-mono text-xs tracking-widest mb-4 text-brand-black/60">[ OUR SPECIALIZATION ]</p>
      <div class="space-y-3">
        {[
          { num: '01', label: 'UX AUDIT' },
          { num: '02', label: 'EYE TRACKING' },
          { num: '03', label: 'UX RESEARCH' },
          { num: '04', label: 'USER TESTING' },
        ].map((item) => (
          <div class="flex items-center gap-2">
            <p class="font-mono text-xs text-brand-black/60 shrink-0">{item.num}.</p>
            <span class="spec-dashes font-mono text-xs tracking-tight">
              {Array.from({length: 20}).map(() => (
                <span style="color:rgb(200,200,200); transition:color 0.8s ease;">|</span>
              ))}
            </span>
            <p class="font-mono text-xs font-medium tracking-widest whitespace-nowrap">{item.label}</p>
          </div>
        ))}
      </div>
      <div class="flex items-center gap-3 mt-3">
        <p id="local-time" class="font-mono text-xs tracking-widest">PRG --:-- -- &nbsp; --/--/----</p>
      </div>
    </div>

    <div id="info-box" class="hidden md:flex absolute z-30 border border-brand-black bg-brand-black text-brand-white flex-col justify-between overflow-hidden"
      style="left:calc(75% + clamp(12px,1.8vw,32px)); right: var(--desktop-gutter); top:calc(66.667% + clamp(10px,1.3vh,28px)); bottom:clamp(8px,1vh,18px); padding:clamp(8px,1.1vh,18px) clamp(10px,1.2vw,20px);">
      <div class="flex-1 min-h-0 overflow-hidden">
        <div class="mb-2">
          <p class="font-mono font-medium tracking-widest bg-brand-white text-brand-black px-1 py-0.5 block w-full" style="font-size:calc(clamp(11px,0.85vw,13px) * min(var(--fs, 1), 1.08));">NOT AN AGENCY – SPECIALISTS</p>
        </div>
        <p class="font-mono text-brand-white/90 leading-relaxed infobox-desc" style="font-size:calc(clamp(11px,0.85vw,13px) * min(var(--fs, 1), 1.08));">
          We are a team of UX specialists. We help companies understand their users through data, research and eye tracking.
        </p>
      </div>
      <div class="shrink-0">
        <div class="flex gap-2 mb-3">
          <a href="/en/case-studies" class="font-mono border border-brand-white px-2 py-0.5 hover:bg-brand-white hover:text-brand-black transition-colors" style="font-size:calc(clamp(11px,0.85vw,13px) * min(var(--fs, 1), 1.08));">CASE STUDIES</a>
          <a href="/en/contact" class="font-mono border border-brand-white px-2 py-0.5 hover:bg-brand-white hover:text-brand-black transition-colors" style="font-size:calc(clamp(11px,0.85vw,13px) * min(var(--fs, 1), 1.08));">CONTACT</a>
        </div>
        <div class="pt-2 border-t border-brand-white/20 flex flex-col items-start gap-1.5">
          <p class="font-mono text-brand-white/75 tracking-widest whitespace-nowrap" style="font-size:calc(clamp(10px,0.75vw,12px) * min(var(--fs, 1), 1.08));">PROJECT WITH:</p>
          <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`} alt="University of Hradec Králové" class="max-w-full shrink-0" style="height:clamp(24px,2.8vh,40px); margin-top:4px; margin-bottom:4px; object-fit:contain; filter: invert(1);" />
        </div>
      </div>
    </div>

    <!-- Cursor dot — only in hero area -->
    <div id="cursor-dot" style="position:fixed; top:0; left:0; width:8px; height:8px; background:#2D62FC; border-radius:50%; pointer-events:none; z-index:9999; transform:translate(-50%,-50%); opacity:0;"></div>

    <button type="button" aria-label="Scroll to content" class="hidden md:flex absolute bottom-6 z-10 flex-col items-start gap-2 animate-bounce cursor-pointer" style="left: 50%;" onclick="window.scrollBy({ top: window.innerHeight * 0.6, behavior: 'smooth' })">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest" style="transform: translateX(-50%);">SCROLL</p>
      <div class="h-8 bg-brand-black/20" style="width: 1px;"></div>
    </button>
  </section>

  <!-- Mobile info box — NOT AN AGENCY, above logo carousel -->
  <div class="md:hidden border border-brand-black bg-brand-black text-brand-white mx-6 my-8 p-6 flex flex-col gap-4">
    <div>
      <p class="font-mono font-medium tracking-widest bg-brand-white text-brand-black px-1 py-0.5 block w-full" style="font-size:12px;">NOT AN AGENCY – SPECIALISTS</p>
    </div>
    <p class="font-mono text-sm text-brand-white/90 leading-relaxed">We are a team of UX specialists. We help companies understand their users through data, research and eye tracking.</p>
    <div class="flex gap-2">
      <a href="/en/case-studies" class="font-mono text-xs border border-brand-white px-2 py-1">CASE STUDIES</a>
      <a href="/en/contact" class="font-mono text-xs border border-brand-white px-2 py-1">CONTACT</a>
    </div>
    <div class="border-t border-brand-white/20 pt-2 flex items-center justify-between">
      <p class="font-mono text-[11px] text-brand-white/75 tracking-widest">PROJECT WITH:</p>
      <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`} alt="Univerzita Hradec Králové" class="h-[40px] w-auto ml-6 my-1" style="filter: invert(1);" />
    </div>
  </div>

  <!-- LOGO STRIP -->
  <div class="border-y border-brand-black/10 py-6 bg-brand-white">
    <!-- Desktop: static strip -->
    <div class="hidden md:flex flex-wrap items-center justify-center gap-x-14 gap-y-6 px-6">
      {clientLogos.map(({ src, alt, w, h }) => (
        <div class="px-4 py-1">
          <img
            src={src}
            alt={alt}
            width={w} height={h}
            class="logo-strip-img select-none"
            style="height:42px; width:auto; max-width:170px; object-fit:contain; display:block;"
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
    <!-- Mobile: auto-scrolling carousel, two logos per row -->
    <div class="md:hidden overflow-hidden">
      <div class="logo-marquee flex items-center">
        {[...clientLogos, ...clientLogos].map(({ src, alt, w, h }) => (
          <div class="flex-shrink-0 flex justify-center items-center px-4" style="width:50vw;">
            <img
              src={src}
              alt={alt}
              width={w} height={h}
              class="logo-strip-img select-none"
              style="height:36px; width:auto; max-width:40vw; object-fit:contain; display:block;"
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <style>
    .logo-strip-img {
      filter: grayscale(1);
      opacity: 0.65;
    }
    .logo-marquee {
      width: max-content;
      /* the loop is visual only (transform) — logos download once and animate from cache */
      animation: logo-scroll 10s linear infinite;
    }
    @keyframes logo-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(-150vw); }
    }
    @media (prefers-reduced-motion: reduce) {
      .logo-marquee { animation: none; }
    }
  </style>

  <!-- THREE QUESTIONS, THREE MEASUREMENTS -->
  <section id="main-content" class="desktop-gutter-x pt-24 pb-12 max-w-7xl mx-auto">
    <div class="mb-12 max-w-3xl">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ THREE QUESTIONS, THREE MEASUREMENTS ]</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">What users see, how they react<br/>and what it costs them<span style="color:#2D62FC">.</span></h2>
      <p class="text-sm text-brand-black/60 leading-relaxed">
        Analytics shows WHERE people clicked. Surveys show WHAT they think. We measure the third layer:
        what they actually saw, how strongly they reacted and where the interface mentally overloaded them.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10">
      {[
        {
          q: 'Do they even see it?',
          desc: 'Visual attention — fixations, TTFF, dwell time, AOI analysis and scanpaths. An objective record of what users actually saw and what they missed.',
          tool: 'EYE-TRACKING',
        },
        {
          q: 'How strongly do they react?',
          desc: 'Physiological arousal and facial signals in the context of the task. Always interpreted with limits in mind — no "emotion reading".',
          tool: 'GSR + FACIAL SIGNALS',
        },
        {
          q: 'Can they do it without strain?',
          desc: 'Mental load as one clear 0–100 score. Find out where your interface overloads users — even when they complete the task in the end.',
          tool: 'EMLI MODEL',
        },
      ].map((item, i) => (
        <div class="bg-brand-white p-8 flex flex-col">
          <p class="font-mono text-xs text-brand-black/60 mb-8">0{i + 1}</p>
          <h3 class="font-display text-2xl font-bold mb-4 leading-tight">{item.q}</h3>
          <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{item.desc}</p>
          <p class="mt-auto"><span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{item.tool}</span></p>
        </div>
      ))}
    </div>
    <!-- Glossary of abbreviations -->
    <p class="font-mono text-[11px] text-brand-black/60 leading-relaxed mt-6">
      <span class="text-brand-black/60 font-medium">GLOSSARY:</span>
      TTFF — time to first fixation · AOI — area of interest · dwell time — total time spent looking at an area · scanpath — the path of the gaze between fixations · GSR — galvanic skin response, an indicator of physiological arousal · EMLI — mental load index derived from eye-tracking metrics
    </p>
  </section>

  <!-- SERVICES SECTION -->
  <section class="desktop-gutter-x py-24 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10">
      {[
        {
          num: '01',
          title: 'UX Audit',
          desc: 'A systematic analysis of your product\'s key journeys: navigation, CTAs, forms. The output isn\'t just charts — it\'s prioritised recommendations on what to improve first.',
          href: '/en/services',
          tags: ['Analysis', 'Recommendations', 'Prioritisation'],
        },
        {
          num: '02',
          title: 'Eye Tracking',
          desc: 'An objective record of visual attention: fixations, time to first fixation (TTFF), dwell time, AOI metrics, heatmaps and scanpaths. What people actually see — and what they miss.',
          href: '/en/services/eye-tracking',
          tags: ['Heatmap', 'AOI · TTFF', 'Scanpath'],
        },
        {
          num: '03',
          title: 'UX Research',
          desc: 'We combine objective behavioural measurement, biometric data and surveys in the context of the task. In the lab and in the field, with piloting, data quality control and honest limits.',
          href: '/en/services/ux-research',
          tags: ['Eye-tracking', 'Biometrics', 'Surveys'],
        },
        {
          num: '04',
          title: 'Case Studies',
          desc: '40% of applicants couldn\'t find open positions. 92% of gazes landed on the main CTA. Real numbers from real measurements — and the decisions they led to.',
          href: '/en/case-studies',
          tags: ['Results', 'Data', 'Decisions'],
        },
      ].map(service => (
        <a href={service.href} class="group bg-brand-white p-8 hover:bg-brand-black hover:text-brand-white transition-colors duration-300">
          <div class="flex justify-between items-start mb-8">
            <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/60">{service.num}</p>
            <span class="font-mono text-xs group-hover:text-brand-white/60">→</span>
          </div>
          <h3 class="font-display text-3xl font-bold mb-4 leading-tight">{service.title}</h3>
          <p class="text-sm text-brand-black/60 group-hover:text-brand-white/60 leading-relaxed mb-6">{service.desc}</p>
          <div class="flex flex-wrap gap-2">
            {service.tags.map(tag => (
              <span class="font-mono text-xs border border-brand-black/20 group-hover:border-brand-white/20 px-2 py-1">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- EMLI SECTION -->
  <section class="desktop-gutter-x py-24 bg-brand-black text-brand-white">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="font-mono text-xs text-brand-white/70 tracking-widest mb-6">[ EMLI — EYE-TRACKING MENTAL LOAD INDEX ]</p>
        <h2 class="font-display text-4xl md:text-6xl font-bold leading-none tracking-tight mb-8">Mental load<br/>as a number<span style="color:#2D62FC">.</span></h2>
        <p class="text-brand-white/60 leading-relaxed mb-6">
          A heatmap shows where people looked. It won't tell you <strong class="text-brand-white">how much it cost them</strong>.
          EMLI converts eight eye-tracking metrics into a single 0–100 load index. Compare design variants,
          form steps or competitor solutions — on hard data, not gut feeling.
        </p>
        <p class="font-mono text-xs text-brand-white/70 leading-relaxed mb-10">
          A model developed and continuously tested in academic research at FIM UHK,<br class="hidden md:block"/> with a fully documented replication methodology.
        </p>
        <a href="/en/contact" class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          MEASURE OUR LOAD →
        </a>
      </div>
      <div class="flex justify-center">
        <!-- EMLI gauge 0–100 -->
        <svg viewBox="0 0 320 200" class="w-full max-w-sm" role="img" aria-label="Illustration of the EMLI mental load index on a 0 to 100 scale">
