---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import HomeHero from '../../components/HomeHero.astro';
import Footer from '../../components/Footer.astro';
const homeStudies = [
  {
    href: '/en/case-studies/career-portal-automotive',
    category: 'ŠKODA AUTO · career portal',
    title: '40% of applicants couldn’t find their way to open positions. Yet the site “looked clear”.',
    method: 'Eye tracking + survey · N = 102',
    result: '4 in 10 missed the openings',
  },
  {
    href: '/en/case-studies/backend-stories',
    category: 'Educational microsite',
    title: 'The longer the text, the less attention.',
    method: 'Eye tracking, AOI analysis · ~120 participants',
    result: '92% noticed the CTA',
  },
  {
    href: '/en/case-studies/ad-banners-gaze-direction',
    category: 'Ad creative',
    title: 'A character’s gaze steered visitors’ attention.',
    method: 'Eye tracking experiment · N = 104',
    result: 'ηp² = 0.11 · medium effect',
  },
];

const gifSrc = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/hero.webp`;
const yearSuffix = new Date().getFullYear().toString().slice(-2);

const clientLogos = [
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/skoda.webp`, w: 1920, h: 630, alt: 'Škoda Auto' , dh: 50 },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/fchk.webp`, w: 800, h: 800, alt: 'FC Hradec Králové' , dh: 54 },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`, w: 157, h: 37, alt: 'University of Hradec Králové' },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/texopluslogo.webp`, w: 216, h: 46, alt: 'TEXO Plus' },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/epodlahovka.webp`, w: 285, h: 49, alt: 'E-podlahovka' },
];
---

<BaseLayout lang="en" title="UX Research, Eye Tracking & User Testing | UX MIND" description="User testing, eye tracking and cognitive load measurement (EMLI model). Objective UX research backed by the FIM UHK science lab. Test your website on data." preloadImages={[{ href: gifSrc, media: "(min-width: 1024px)" }]}>
  <Navbar />

  <HomeHero lang="en" />

  <main id="main-content">

  <!-- LOGO STRIP -->
  <div class="border-y border-brand-black/10 py-6" style="background:#FDFDFD;">
    <p class="font-mono text-xs tracking-widest text-brand-black/60 text-center mb-4">[ WE HAVE WORKED WITH ]</p>
    <!-- Desktop: static strip -->
    <div class="hidden md:flex flex-wrap items-center justify-center gap-x-14 gap-y-6 px-6">
      {clientLogos.map(({ src, alt, w, h, dh }) => (
        <div class="px-4 py-1">
          <img
            src={src}
            alt={alt}
            title={alt}
            width={w} height={h}
            class="logo-strip-img select-none"
            style={`height:${dh || 42}px; width:auto; max-width:170px; object-fit:contain; display:block;`}
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
    <!-- Mobile: auto-scrolling carousel, two logos per row -->
    <div class="md:hidden overflow-hidden">
      <div class="logo-marquee flex items-center" style={`--loop:-${clientLogos.length * 50}vw; animation-duration:${(clientLogos.length * 50 / 15).toFixed(1)}s;`}>
        {[...clientLogos, ...clientLogos].map(({ src, alt, w, h, dh }) => (
          <div class="flex-shrink-0 flex justify-center items-center px-4" style="width:50vw;">
            <img
              src={src}
              alt={alt}
              title={alt}
              width={w} height={h}
              class="logo-strip-img select-none"
              style={`height:${dh ? Math.round(dh * 36 / 42) : 36}px; width:auto; max-width:40vw; object-fit:contain; display:block;`}
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <style>
    .logo-strip-img {
      filter: grayscale(1);
      opacity: 0.65;
    }
    .logo-marquee {
      width: max-content;
      /* the loop is visual only (transform) — logos download once and animate from cache */
      animation: logo-scroll 10s linear infinite;
    }
    @keyframes logo-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(var(--loop)); } /* posun = počet log × 50vw → plynulá smyčka */
    }
    @media (prefers-reduced-motion: reduce) {
      .logo-marquee { animation: none; }
    }
  </style>

  <!-- SERVICES SECTION -->
  <section class="desktop-gutter-x py-24 max-w-7xl mx-auto">
    <div class="mb-12 max-w-3xl">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ OUR SERVICES ]</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">What we do<span style="color:#2D62FC">.</span></h2>
      <p class="text-sm text-brand-black/60 leading-relaxed">
        We help you find where a website, app or communication complicates people's journey. We measure the problem, explain its cause and recommend what to fix first.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10">
      {[
        {
          num: '01',
          title: 'UX Audit',
          desc: 'We go through your website, e-shop or app with a user’s eyes. We find the places where people get stuck, abandon the order or overlook important information. You get a list of fixes sorted by priority.',
          href: '/en/services/ux-audit',
          tags: ['Analysis', 'Recommendations', 'Prioritisation'],
        },
        {
          num: '02',
          title: 'User Testing',
          desc: 'We give real users concrete tasks and watch whether they can complete them. You will see where they get lost, what they don’t understand and why they leave — together with suggestions on what to change.',
          href: '/en/services/user-testing',
          tags: ['Task scenarios', 'Success rate', 'Qualitative insights'],
        },
        {
          num: '03',
          title: 'Eye Tracking',
          desc: 'Using eye tracking we measure where people really look. Heatmaps and gaze recordings reveal what they notice, what they overlook and whether important content leads them the right way.',
          href: '/en/services/eye-tracking',
          tags: ['Heatmap', 'Time to first glance', 'Gaze path'],
        },
        {
          num: '04',
          title: 'Field Research',
          desc: 'We observe customer behaviour right where decisions are made — in the store, showroom, at an event or with a physical product. Mobile eye-tracking glasses show what people notice in the real environment and what they miss.',
          href: '/en/services/field-research',
          tags: ['Mobile eye-tracking', 'Real context', 'Observation'],
        },
        {
          num: '05',
          title: 'UX Research',
          desc: 'When you need to understand not only what isn’t working, but also why. We combine interviews, observation, testing and reaction measurement so you can decide based on users’ real needs.',
          href: '/en/services/ux-research',
          tags: ['Eye-tracking', 'Biometrics', 'Surveys'],
        },
        {
          num: '06',
          title: 'Case Studies',
          desc: 'See what real measurements revealed: 40% of applicants couldn’t find their way to open positions and 92% of respondents noticed the main CTA. We show the data and the changes it led to.',
          href: '/en/case-studies',
          tags: ['Results', 'Data', 'Decisions'],
        },
      ].map(service => (
        <a href={service.href} class="group bg-brand-white p-8 hover:bg-brand-black hover:text-brand-white transition-colors duration-300">
          <div class="flex justify-between items-start mb-8">
            <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/60">{service.num}</p>
            <span class="font-mono text-xs group-hover:text-brand-white/60">→</span>
          </div>
          <h3 class="font-display text-3xl font-bold mb-4 leading-tight">{service.title}</h3>
          <p class="text-sm text-brand-black/60 group-hover:text-brand-white/60 leading-relaxed mb-6">{service.desc}</p>
          <div class="flex flex-wrap gap-2">
            {service.tags.map(tag => (
              <span class="font-mono text-xs border border-brand-black/20 group-hover:border-brand-white/20 px-2 py-1">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
    <!-- Test packages — black strip so it stands out -->
    <a href="/en/services/test-packages" class="group flex flex-col md:flex-row md:items-center justify-between gap-4 bg-brand-black text-brand-white border border-brand-black p-8 hover:bg-[#2D62FC] transition-colors duration-300">
      <div>
        <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-2">[ TEST PACKAGES ]</p>
        <p class="font-display text-2xl font-bold leading-tight">From a quick check to in-depth research. Choose the scope by what you need to find out.</p>
      </div>
      <span class="font-mono text-xs tracking-widest uppercase shrink-0">COMPARE PACKAGES →</span>
    </a>
  </section>

  <!-- THREE QUESTIONS, THREE MEASUREMENTS -->
  <section class="desktop-gutter-x py-24 max-w-7xl mx-auto">
    <div class="mb-12 max-w-3xl">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ THREE QUESTIONS, THREE MEASUREMENTS ]</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">What users see, how they react<br/>and what overloads them<span style="color:#2D62FC">.</span></h2>
      <p class="text-sm text-brand-black/60 leading-relaxed">
        Analytics shows WHERE people clicked. A survey shows WHAT they think. We measure the third layer:
        what they actually saw, how strongly they reacted and where the interface mentally overloaded them.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10">
      {[
        {
          q: 'Do they even see it?',
          desc: 'Visual attention — where people look first, how long they stay on each element and what they miss entirely. Eye tracking objectively captures what the user actually saw.',
          tool: 'EYE-TRACKING',
        },
        {
          q: 'How strongly do they react?',
          desc: 'How strongly the body reacts (skin conductance) and what facial expressions reveal — always in the context of the task. We interpret them within their limits — no “emotion reading”.',
          tool: 'SKIN CONDUCTANCE + FACIAL EXPRESSION',
        },
        {
          q: 'Can they do it without strain?',
          desc: 'Cognitive load as one clear 0–100 score. Find out where the interface overloads users, even when they complete the task in the end.',
          tool: 'EMLI MODEL',
        },
      ].map((item, i) => (
        <div class="bg-brand-white p-8 flex flex-col">
          <p class="font-mono text-xs text-brand-black/60 mb-8">0{i + 1}</p>
          <h3 class="font-display text-2xl font-bold mb-4 leading-tight">{item.q}</h3>
          <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{item.desc}</p>
          <p class="mt-auto"><span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{item.tool}</span></p>
        </div>
      ))}
    </div>
    <!-- Glossary of abbreviations -->
    <details class="group border border-brand-black/15 mt-6">
        <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
          [ GLOSSARY ]
          <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <dl class="px-5 pb-6 space-y-4">
            <div><dt class="font-display font-bold mb-1">TTFF</dt><dd class="text-sm text-brand-black/70 leading-relaxed">time to first fixation</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">area of interest</dd></div>
            <div><dt class="font-display font-bold mb-1">dwell time</dt><dd class="text-sm text-brand-black/70 leading-relaxed">total time spent looking at an area</dd></div>
            <div><dt class="font-display font-bold mb-1">scanpath</dt><dd class="text-sm text-brand-black/70 leading-relaxed">the path of the gaze between fixations</dd></div>
            <div><dt class="font-display font-bold mb-1">GSR</dt><dd class="text-sm text-brand-black/70 leading-relaxed">galvanic skin response, an indicator of physiological arousal</dd></div>
            <div><dt class="font-display font-bold mb-1">EMLI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">mental (cognitive) load index derived from eye-tracking metrics</dd></div>
        </dl>
      </details>
  </section>

  <!-- EMLI SECTION -->
  <section class="desktop-gutter-x py-24 bg-brand-black text-brand-white">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="font-mono text-[11px] tracking-normal whitespace-nowrap md:text-xs md:tracking-widest md:whitespace-normal text-brand-white/70 mb-6">[ EMLI — EYE-TRACKING MENTAL LOAD INDEX ]</p>
        <h2 class="font-display text-4xl md:text-6xl font-bold leading-none tracking-tight mb-8">Mental load<br/>as a number<span style="color:#2D62FC">.</span></h2>
        <p class="text-brand-white/60 leading-relaxed mb-6">
          A heatmap shows where people looked. On its own, though, it can't tell whether the interface was
          easy for them or needlessly overloaded them while completing the task. EMLI combines eight eye-tracking
          metrics into a single cognitive load score from 0 to 100. <strong class="text-brand-white">The higher the score, the greater the load.</strong> That lets you easily compare
          two design variants, individual form steps or competitor solutions — on data, not on impressions.
        </p>
        <p class="font-mono text-xs text-brand-white/70 leading-relaxed mb-10">
          The model emerged from academic research at FIM UHK.<br class="hidden md:block"/> The methodology is documented in detail for independent verification.
        </p>
        <a href="/en/contact" class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          MEASURE MY LOAD →
        </a>
      </div>
      <div class="flex justify-center">
        <!-- EMLI gauge 0–100 -->
        <svg viewBox="0 0 320 200" class="w-full max-w-sm" role="img" aria-label="Illustration of the EMLI mental load index on a 0 to 100 scale">
          <path d="M 30 170 A 130 130 0 0 1 290 170" fill="none" stroke="rgba(252,252,252,0.15)" stroke-width="14" stroke-linecap="round" />
          <path id="emli-arc" d="M 30 170 A 130 130 0 0 1 290 170" pathLength="100" fill="none" stroke="#FCFCFC" stroke-width="14" stroke-linecap="round" stroke-dasharray="65 100" />
          {Array.from({ length: 11 }).map((_, i) => {
            const a = Math.PI - (i * Math.PI) / 10;
            const x1 = 160 + Math.cos(a) * 108, y1 = 170 - Math.sin(a) * 108;
            const x2 = 160 + Math.cos(a) * 98,  y2 = 170 - Math.sin(a) * 98;
            return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="rgba(252,252,252,0.35)" stroke-width="2" />;
          })}
          <g id="emli-needle" style="transform-box: view-box; transform-origin: 160px 170px; transform: rotate(117deg);">
            <line x1="160" y1="170" x2="76" y2="170" stroke="#FCFCFC" stroke-width="2" />
          </g>
          <circle cx="160" cy="170" r="6" fill="#2D62FC" />
          <text x="30" y="192" fill="rgba(252,252,252,0.5)" font-family="monospace" font-size="12">0</text>
          <text x="278" y="192" fill="rgba(252,252,252,0.5)" font-family="monospace" font-size="12">100</text>
          <text id="emli-value" x="160" y="130" fill="#FCFCFC" text-anchor="middle" font-family="monospace" font-size="38" font-weight="700">65</text>
          <text x="160" y="150" fill="rgba(252,252,252,0.6)" text-anchor="middle" font-family="monospace" font-size="11" letter-spacing="3">EMLI</text>
          <text x="160" y="196" fill="rgba(252,252,252,0.5)" text-anchor="middle" font-family="monospace" font-size="10" letter-spacing="2">8 METRICS → 1 INDEX</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- STATS SECTION -->
  <section class="desktop-gutter-x py-16 border-t border-brand-black/10">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8">
      {[
        { num: '5+', label: 'Completed studies' },
        { num: '800+', label: 'Study respondents' },
        { num: '8', label: 'Metrics in the EMLI model' },
        { num: '0–100', label: 'Load index scale' },
      ].map(stat => (
        <div class="text-center">
          <p class="font-display text-5xl md:text-6xl font-bold mb-3">{stat.num}</p>
          <div class="border-t border-brand-black/15 mb-2"></div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest uppercase">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- RESEARCH & TECHNOLOGY -->
  <section class="desktop-gutter-x py-24 border-t border-brand-black/10 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ LAB & TECHNOLOGY ]</p>
        <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">Technology isn't enough.<br/>Methodology decides<span style="color:#2D62FC">.</span></h2>
        <p class="text-sm text-brand-black/60 leading-relaxed mb-8">
          We measure in the Cognitive Studies Lab at FIM UHK as well as directly in the field. But modern
          instruments alone don't guarantee a reliable result. That's why every study starts with a clear
          question, we validate the scenario in advance and check data quality during measurement. We assess
          the results in the context of the specific task and state openly what can — and cannot — be inferred from them.
        </p>
        <div class="flex flex-wrap gap-2">
          {['TOBII PRO X2-60', 'SMART EYE AURORA', 'MOBILE EYE-TRACKING GLASSES', 'EYE-TRACKING DATA SOFTWARE', 'SHIMMER3 GSR'].map(tech => (
            <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{tech}</span>
          ))}
        </div>
        <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mt-8">ACADEMIC BACKGROUND</p>
        <p class="text-sm text-brand-black/60 leading-relaxed mt-4">
          Members of the team publish results in the journals Scientific Reports (Nature Portfolio)
          and the Journal of Environmental Psychology, and at the ACM ETRA conference. We bring the same
          rigour to client projects — from measurement design to a clear interpretation of the results.
        </p>
      </div>
      <div class="flex flex-col">
        <!-- Photo fills the column height (object-cover crop) -->
        <div class="border border-brand-black flex flex-col flex-1 min-h-0">
          <img
            src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/analyza-heatmapy-eye-tracking.webp`}
            alt="Jan Petružálek and Filip Oborník reviewing an attention heatmap from an eye-tracking study on the monitor"
            title="Reviewing an attention heatmap at the FIMEYELAB lab, FIM UHK"
            width="1920" height="1280" loading="lazy" decoding="async"
            class="w-full flex-1 min-h-0 object-cover block"
          />
        </div>
        <div class="mt-4 pt-3 border-t border-brand-black/20 flex items-center justify-between">
          <p class="font-mono text-[10px] text-brand-black/60 tracking-widest">IN COOPERATION WITH:</p>
          <img loading="lazy" decoding="async" width="157" height="37" src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`} alt="University of Hradec Králové" title="University of Hradec Králové" class="h-[40px] w-auto" />
        </div>
      </div>
    </div>
  </section>

  <!-- CASE STUDIES -->
  <section class="desktop-gutter-x py-24 max-w-7xl mx-auto">
    <div class="flex justify-between items-end mb-12">
      <div>
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ CASE STUDIES ]</p>
        <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight">What the<br/>measurements revealed<span style="color:#2D62FC">.</span></h2>
      </div>
      <a href="/en/case-studies" class="font-mono text-xs tracking-widest border-b border-brand-black pb-1 hover:opacity-50 transition-opacity">
        ALL STUDIES →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
      {homeStudies.map(study => (
        <a href={study.href} class="group bg-brand-white p-8 flex flex-col hover:bg-brand-black transition-colors">
          <div class="flex justify-between items-start gap-3 mb-6">
            <span class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 border border-brand-black/20 group-hover:border-brand-white/50 px-2 py-0.5 transition-colors">{study.category}</span>
          </div>
          <h3 class="font-display text-xl font-bold mb-4 leading-tight group-hover:text-brand-white transition-colors">{study.title}</h3>
          <p class="font-mono text-[11px] text-brand-black/60 group-hover:text-brand-white/70 tracking-wide mb-6 transition-colors">METHOD: {study.method}</p>
          <div class="mt-auto">
            <span class="block font-display text-lg font-bold leading-none whitespace-nowrap mb-4" style="color:#2D62FC">{study.result}</span>
            <span class="block font-mono text-xs tracking-widest group-hover:text-brand-white transition-colors">VIEW STUDY →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="desktop-gutter-x py-24 border-t border-brand-black/10 max-w-7xl mx-auto">
    <div class="flex flex-col items-start gap-6 md:flex-row md:justify-between md:items-end mb-12">
      <div>
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ HOW WE COLLABORATE ]</p>
        <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight">How the<br/>collaboration works<span style="color:#2D62FC">.</span></h2>
      </div>
      <a href="/en/services/test-packages" class="font-mono text-xs tracking-widest whitespace-nowrap border-b border-brand-black pb-1 hover:opacity-50 transition-opacity">
        TEST PACKAGES →
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-px bg-brand-black/10 border border-brand-black/10">
      {[
        { num: '01', title: 'Initial consultation', desc: 'You tell us what you need to find out or decide. Together we choose who and what makes sense to test.' },
        { num: '02', title: 'Research design', desc: 'We recommend suitable methods, the number of participants, the scope and the form of the results. You will know in advance which questions the measurement will answer.' },
        { num: '03', title: 'Test preparation', desc: 'We prepare the tasks, materials and questionnaires. For a more complex project we first validate everything with a pilot measurement.' },
        { num: '04', title: 'Measurement', desc: 'We test in the lab or directly in the field. We watch over the correct procedure and the quality of the recorded data.' },
        { num: '05', title: 'Results and recommendations', desc: 'We connect the data with observation and users’ statements. You get clear conclusions, priorities and recommendations on what to fix.' },
      ].map(step => (
        <div class="bg-brand-white p-6 md:p-8">
          <p class="font-mono text-xs text-brand-black/60 mb-6">{step.num}</p>
          <h3 class="font-display text-base font-bold mb-3 whitespace-nowrap">{step.title}</h3>
          <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
        </div>
      ))}
    </div>
  </section>

  </main>

  <Footer />
</BaseLayout>

<script>
  import '../../scripts/homepage';
</script>
