---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
const homeStudies = [
  {
    href: '/en/case-studies/career-portal-automotive',
    category: 'ŠKODA AUTO · career portal',
    title: '40% of applicants couldn’t find their way to open positions. Yet the site “looked clear”.',
    method: 'Eye tracking + survey · N = 102',
    result: '4 in 10 missed the openings',
  },
  {
    href: '/en/case-studies/backend-stories',
    category: 'Educational microsite',
    title: 'The longer the text, the less attention.',
    method: 'Eye tracking, AOI analysis · ~120 participants',
    result: '92% noticed the CTA',
  },
  {
    href: '/en/case-studies/ad-banners-gaze-direction',
    category: 'Ad creative',
    title: 'A character’s gaze steered visitors’ attention.',
    method: 'Eye tracking experiment · N = 104',
    result: 'ηp² = 0.11 · medium effect',
  },
];

const gifSrc = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/hero.webp`;
const yearSuffix = new Date().getFullYear().toString().slice(-2);

const clientLogos = [
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/skoda.webp`, w: 1920, h: 630, alt: 'Škoda Auto' , dh: 50 },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/fchk.webp`, w: 800, h: 800, alt: 'FC Hradec Králové' , dh: 54 },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`, w: 157, h: 37, alt: 'University of Hradec Králové' },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/texopluslogo.webp`, w: 216, h: 46, alt: 'TEXO Plus' },
];
---

<BaseLayout lang="en" title="UX Research, Eye Tracking & User Testing | UXMIND" description="User testing, eye tracking and cognitive load measurement (EMLI model). Objective UX research backed by the FIM UHK science lab. Test your website on data." preloadImage={{ href: gifSrc, media: "(min-width: 768px)" }}>
  <Navbar />

  <!-- HERO SECTION -->
  <section class="hero-shell relative overflow-hidden" style="background:#FDFDFD;">

    <!-- Background grid: 4 columns × 3 rows, plus markers at intersections -->
    <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true"
      style="background-image: linear-gradient(rgba(10,10,10,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.07) 1px, transparent 1px); background-size: 25% 33.333%;">
      <div class="hidden md:block">
      {[0, 25, 50, 75, 100].flatMap(x =>
        [0, 33.333, 66.667, 100].map(y => (
          <div class="absolute" style={`left:${x}%; top:${y}%; width:14px; height:14px; transform:translate(-50%,-50%); background:linear-gradient(rgba(10,10,10,0.22),rgba(10,10,10,0.22)) center/14px 1px no-repeat, linear-gradient(rgba(10,10,10,0.22),rgba(10,10,10,0.22)) center/1px 14px no-repeat;`}></div>
        ))
      )}
      </div>
    </div>

    <!-- Center CTA — below the hero figure, on the same grid row axis as the spec list -->
    <div class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 z-[60] hidden md:block" style="top: 83.333%;">
      <a href="/en/contact" class="inline-block bg-brand-black text-brand-white border border-brand-black px-6 py-2 font-mono text-xs tracking-widest uppercase transition-colors duration-200 hover:bg-transparent hover:text-brand-black">
        BOOK A MEETING
      </a>
    </div>

    <!-- Large headline — top-aligned with the top line (same height where the top table began) -->
    <div class="absolute z-10" style="left: var(--desktop-gutter); top: calc(var(--desktop-top-offset) + 3rem); line-height: 1; margin: 0; padding: 0;">
      <h1 class="m-0 p-0 relative" style="line-height:0;">
        <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logo-2line.svg`} alt="UX Mind" width="264" height="88" style="width: clamp(8.4rem, 16.8vw, 264px); height:auto; display:block;" />
        <!-- Easter egg: hotspot over the logo's blue dot + patch shown while the dot is "escaped" -->
        <span id="logo-dot-hotspot" class="hidden md:block" style="position:absolute; left:89%; top:64%; width:14%; height:24%;"></span>
        <span id="logo-dot-patch" style="position:absolute; left:92.4%; top:69%; width:8%; height:14%; background:#FCFCFC; border-radius:50%; display:none;"></span>
      </h1>
      <!-- Mobile-only: first annotation below heading -->
      <p class="md:hidden font-mono tracking-widest text-brand-black/70 mt-3" style="font-size:10px;">RESEARCH OVER ASSUMPTIONS</p>
    </div>

    <!-- Mobile hero image — static, shown immediately -->
    <div class="md:hidden absolute left-0 right-0 flex items-center justify-center" style="top: 33.333%; height: 33.334%;">
      <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/hero-mobile.webp`} alt="UX Mind — UX research and eye tracking" style="width:100%; height:auto; object-fit:contain;" width="800" height="450" fetchpriority="high" decoding="async" />
    </div>

    <!-- Center 3D Brain — desktop only -->
    <div class="hidden md:flex absolute inset-0 items-center justify-center">
      <div id="hero-gif-container" class="relative" style="width: min(48vw, 760px); height: min(50vh, 540px);">
        <!-- Hero GIF - plays once then freezes on last frame -->
        <img
          id="hero-gif"
          src={gifSrc}
          alt="Animated neural network — a visualisation connecting UX research, eye tracking and data"
          class="w-full h-full object-contain"
          width="960" height="540" loading="lazy" decoding="async"
        />

        <!-- Annotation: top — text visible in hero below CTA, line goes down into image -->
        <div class="ann absolute hidden md:flex flex-col items-center opacity-0" style="left:50%; top:-30px; transform:translateX(-50%);">
          <p class="font-mono hero-fluid-micro tracking-widest text-center mb-1 max-w-32">RESEARCH OVER<br/>ASSUMPTIONS</p>
          <div class="ann-line w-px bg-brand-black" style="height:0;" data-size="200"></div>
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
        </div>

        <!-- Annotation: left — text left of container, dot at 22% from left -->
        <div class="ann absolute hidden md:flex items-center opacity-0" style="left:22%; top:42%; transform:translate(-100%,-50%);">
          <div class="text-right mr-2">
            <p class="font-mono hero-fluid-micro tracking-widest">DESIGN STARTS<br/>WITH THE USER</p>
          </div>
          <div class="ann-line h-px bg-brand-black" style="width:0;"></div>
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
        </div>

        <!-- Annotation: right top — text right of container, dot at 22% from right; top 40% keeps text below the stats box bottom edge -->
        <div class="ann absolute hidden md:flex items-center opacity-0" style="right:22%; top:40%; transform:translate(100%,-50%);">
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
          <div class="ann-line h-px bg-brand-black" style="width:0;" data-size="110"></div>
          <div class="ml-2">
            <p class="font-mono hero-fluid-micro tracking-widest">EYE TRACKING<br/>SHOWS WHAT<br/>PEOPLE SEE</p>
          </div>
        </div>

        <!-- Annotation: right bottom — text right of container, dot at 22% from right -->
        <div class="ann absolute hidden md:flex items-center opacity-0" style="right:22%; top:65%; transform:translate(100%,-50%);">
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
          <div class="ann-line h-px bg-brand-black" style="width:0;" data-size="110"></div>
          <div class="ml-2">
            <p class="font-mono hero-fluid-micro tracking-widest">MEASURE<br/>UNDERSTAND<br/>IMPROVE</p>
          </div>
        </div>

        <!-- Annotation: bottom — text below container, dot at 18% from bottom -->
        <div class="ann absolute hidden md:flex flex-col items-center opacity-0" style="left:50%; bottom:35%; transform:translate(-50%,100%);">
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
          <div class="ann-line w-px bg-brand-black" style="height:0;"></div>
          <p class="font-mono hero-fluid-micro tracking-widest text-center mt-1 max-w-24">DATA<br/>OVER IMPRESSIONS</p>
        </div>

      </div>
    </div><!-- end desktop gif container -->

    <!-- Info box: stats (top right) -->

    <!-- Core services — vertically centered in 3rd grid rectangle (66.667%–100%) -->
    <div class="hero-spec-list absolute z-10" style="left: var(--desktop-gutter); top: 83.333%; transform: translateY(-50%);">
      <p class="font-mono text-xs tracking-widest mb-4 text-brand-black/60">[ OUR SPECIALIZATION ]</p>
      <div class="space-y-3">
        {[
          { num: '01', label: 'UX AUDIT' },
          { num: '02', label: 'USER TESTING' },
          { num: '03', label: 'EYE TRACKING' },
          { num: '04', label: 'FIELD RESEARCH' },
          { num: '05', label: 'UX RESEARCH' },
        ].map((item) => (
          <div class="flex items-center gap-2">
            <p class="font-mono text-xs text-brand-black/60 shrink-0">{item.num}.</p>
            <span class="spec-dashes font-mono text-xs tracking-tight">
              {Array.from({length: 20}).map(() => (
                <span style="color:rgb(200,200,200); transition:color 0.8s ease;">|</span>
              ))}
            </span>
            <p class="font-mono text-xs font-medium tracking-widest whitespace-nowrap">{item.label}</p>
          </div>
        ))}
      </div>
      <div class="flex items-center gap-3 mt-3">
        <p id="local-time" class="font-mono text-xs tracking-widest">PRG --:-- -- &nbsp; --/--/----</p>
      </div>
    </div>

    <!-- Info box: about us — fills right half of bottom grid rectangle -->
    <div id="info-box" class="hidden md:flex absolute z-30 border border-brand-black bg-brand-black text-brand-white flex-col"
      style="left:calc(75% + clamp(12px,1.8vw,32px)); right: var(--desktop-gutter); top: 83.333%; transform: translateY(-50%); padding:clamp(8px,1.1vh,18px) clamp(10px,1.2vw,20px);">
      <div>
        <div class="mb-2">
          <p class="font-mono font-medium tracking-widest bg-brand-white text-brand-black px-1 py-0.5 block w-full" style="font-size:calc(clamp(11px,0.85vw,13px) * min(var(--fs, 1), 1.08));">NOT AN AGENCY – SPECIALISTS</p>
        </div>
        <p class="font-mono text-brand-white/90 leading-relaxed infobox-desc" style="font-size:calc(clamp(11px,0.85vw,13px) * min(var(--fs, 1), 1.08));">
          We are a team of UX specialists. We help companies understand their users through data, research and eye tracking.
        </p>
      </div>
      <div class="shrink-0" style="margin-top:clamp(10px,1.4vh,20px);">
        <div class="pt-2 border-t border-brand-white/20 flex flex-col items-start gap-1.5">
          <p class="font-mono text-brand-white/75 tracking-widest whitespace-nowrap" style="font-size:calc(clamp(10px,0.75vw,12px) * min(var(--fs, 1), 1.08));">PROJECT WITH:</p>
          <img loading="lazy" decoding="async" width="157" height="37" src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`} alt="University of Hradec Králové" class="max-w-full shrink-0" style="height:clamp(24px,2.8vh,40px); object-fit:contain; margin-top:4px; margin-bottom:4px; filter: invert(1);" />
        </div>
      </div>
    </div>

    <!-- Cursor dot — only in hero area -->
    <div id="cursor-dot" style="position:fixed;top:0;left:0;width:8px;height:8px;background:#2D62FC;border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);opacity:0;"></div>

    <!-- Scroll indicator -->
    <button type="button" aria-label="Scroll to content" class="hidden md:flex absolute bottom-6 z-10 flex-col items-start gap-2 animate-bounce cursor-pointer" style="left: 50%;" onclick="window.scrollBy({ top: window.innerHeight * 0.6, behavior: 'smooth' })">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest" style="transform: translateX(-50%);">SCROLL</p>
      <div class="h-8 bg-brand-black/20" style="width: 1px;"></div>
    </button>
  </section>

  <main id="main-content">

  <!-- Mobile info box — NOT AN AGENCY, above logo carousel -->
  <div class="md:hidden border border-brand-black bg-brand-black text-brand-white mx-6 my-8 p-6 flex flex-col gap-4">
    <div>
      <p class="font-mono font-medium tracking-widest bg-brand-white text-brand-black px-1 py-0.5 block w-full" style="font-size:12px;">NOT AN AGENCY – SPECIALISTS</p>
    </div>
    <p class="font-mono text-sm text-brand-white/90 leading-relaxed">We are a team of UX specialists. We help companies understand their users through data, research and eye tracking.</p>
    <div class="flex gap-2">
      <a href="/en/about" class="font-mono text-xs border border-brand-white px-2 py-1">ABOUT</a>
      <a href="/en/contact" class="font-mono text-xs border border-brand-white px-2 py-1">CONTACT</a>
    </div>
    <div class="border-t border-brand-white/20 pt-2 flex items-center justify-between">
      <p class="font-mono text-[11px] text-brand-white/75 tracking-widest">PROJECT WITH:</p>
      <img loading="lazy" decoding="async" width="157" height="37" src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`} alt="University of Hradec Králové" class="h-[40px] w-auto ml-6 my-1" style="filter: invert(1);" />
    </div>
  </div>

  <!-- LOGO STRIP -->
  <div class="border-y border-brand-black/10 py-6" style="background:#FDFDFD;">
    <!-- Desktop: static strip -->
    <div class="hidden md:flex flex-wrap items-center justify-center gap-x-14 gap-y-6 px-6">
      {clientLogos.map(({ src, alt, w, h, dh }) => (
        <div class="px-4 py-1">
          <img
            src={src}
            alt={alt}
            title={alt}
            width={w} height={h}
            class="logo-strip-img select-none"
            style={`height:${dh || 42}px; width:auto; max-width:170px; object-fit:contain; display:block;`}
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
    <!-- Mobile: auto-scrolling carousel, two logos per row -->
    <div class="md:hidden overflow-hidden">
      <div class="logo-marquee flex items-center">
        {[...clientLogos, ...clientLogos].map(({ src, alt, w, h, dh }) => (
          <div class="flex-shrink-0 flex justify-center items-center px-4" style="width:50vw;">
            <img
              src={src}
              alt={alt}
              title={alt}
              width={w} height={h}
              class="logo-strip-img select-none"
              style={`height:${dh ? Math.round(dh * 36 / 42) : 36}px; width:auto; max-width:40vw; object-fit:contain; display:block;`}
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <style>
    .logo-strip-img {
      filter: grayscale(1);
      opacity: 0.65;
    }
    .logo-marquee {
      width: max-content;
      /* the loop is visual only (transform) — logos download once and animate from cache */
      animation: logo-scroll 10s linear infinite;
    }
    @keyframes logo-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(-150vw); }
    }
    @media (prefers-reduced-motion: reduce) {
      .logo-marquee { animation: none; }
    }
  </style>

  <!-- THREE QUESTIONS, THREE MEASUREMENTS -->
  <section class="desktop-gutter-x pt-24 pb-12 max-w-7xl mx-auto">
    <div class="mb-12 max-w-3xl">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ THREE QUESTIONS, THREE MEASUREMENTS ]</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">What users see, how they react<br/>and what overloads them<span style="color:#2D62FC">.</span></h2>
      <p class="text-sm text-brand-black/60 leading-relaxed">
        Analytics shows WHERE people clicked. A survey shows WHAT they think. We measure the third layer:
        what they actually saw, how strongly they reacted and where the interface mentally overloaded them.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10">
      {[
        {
          q: 'Do they even see it?',
          desc: 'Visual attention — heatmaps, fixations, TTFF, dwell time, AOI analysis and scanpaths. Eye tracking objectively captures what the user actually saw and what they missed.',
          tool: 'EYE-TRACKING',
        },
        {
          q: 'How strongly do they react?',
          desc: 'Physiological arousal and facial signals in the context of the task. We always interpret them with limits — no "emotion reading".',
          tool: 'GSR + FACIAL SIGNALS',
        },
        {
          q: 'Can they do it without strain?',
          desc: 'Cognitive load as one clear 0–100 score. Find out where the interface overloads users, even when they complete the task in the end.',
          tool: 'EMLI MODEL',
        },
      ].map((item, i) => (
        <div class="bg-brand-white p-8 flex flex-col">
          <p class="font-mono text-xs text-brand-black/60 mb-8">0{i + 1}</p>
          <h3 class="font-display text-2xl font-bold mb-4 leading-tight">{item.q}</h3>
          <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{item.desc}</p>
          <p class="mt-auto"><span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{item.tool}</span></p>
        </div>
      ))}
    </div>
    <!-- Glossary of abbreviations -->
    <details class="group border border-brand-black/15 mt-6">
        <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
          [ GLOSSARY ]
          <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <dl class="px-5 pb-6 space-y-4">
            <div><dt class="font-display font-bold mb-1">TTFF</dt><dd class="text-sm text-brand-black/70 leading-relaxed">time to first fixation</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">area of interest</dd></div>
            <div><dt class="font-display font-bold mb-1">dwell time</dt><dd class="text-sm text-brand-black/70 leading-relaxed">total time spent looking at an area</dd></div>
            <div><dt class="font-display font-bold mb-1">scanpath</dt><dd class="text-sm text-brand-black/70 leading-relaxed">the path of the gaze between fixations</dd></div>
            <div><dt class="font-display font-bold mb-1">GSR</dt><dd class="text-sm text-brand-black/70 leading-relaxed">galvanic skin response, an indicator of physiological arousal</dd></div>
            <div><dt class="font-display font-bold mb-1">EMLI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">mental (cognitive) load index derived from eye-tracking metrics</dd></div>
        </dl>
      </details>
  </section>

  <!-- SERVICES SECTION -->
  <section class="desktop-gutter-x py-24 max-w-7xl mx-auto">
    <div class="mb-12 max-w-3xl">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ OUR SERVICES ]</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">What we do<span style="color:#2D62FC">.</span></h2>
      <p class="text-sm text-brand-black/60 leading-relaxed">
        We help you find where a website, app or communication complicates people's journey. We measure the problem, explain its cause and recommend what to fix first.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10">
      {[
        {
          num: '01',
          title: 'UX Audit',
          desc: 'We go through your website, e-shop or app with a user’s eyes. We find the places where people get stuck, abandon the order or overlook important information. You get a list of fixes sorted by priority.',
          href: '/en/services/ux-audit',
          tags: ['Analysis', 'Recommendations', 'Prioritisation'],
        },
        {
          num: '02',
          title: 'User Testing',
          desc: 'We give real users concrete tasks and watch whether they can complete them. You will see where they get lost, what they don’t understand and why they leave — together with suggestions on what to change.',
          href: '/en/services/user-testing',
          tags: ['Task scenarios', 'Success rate', 'Qualitative insights'],
        },
        {
          num: '03',
          title: 'Eye Tracking',
          desc: 'Using eye tracking we measure where people really look. Heatmaps and gaze recordings reveal what they notice, what they overlook and whether important content leads them the right way.',
          href: '/en/services/eye-tracking',
          tags: ['Heatmap', 'AOI · TTFF', 'Scanpath'],
        },
        {
          num: '04',
          title: 'Field Research',
          desc: 'We observe customer behaviour right where decisions are made — in the store, showroom, at an event or with a physical product. Mobile eye-tracking glasses show what people notice in the real environment and what they miss.',
          href: '/en/services/field-research',
          tags: ['Mobile eye-tracking', 'Real context', 'Observation'],
        },
        {
          num: '05',
          title: 'UX Research',
          desc: 'When you need to understand not only what isn’t working, but also why. We combine interviews, observation, testing and reaction measurement so you can decide based on users’ real needs.',
          href: '/en/services/ux-research',
          tags: ['Eye-tracking', 'Biometrics', 'Surveys'],
        },
        {
          num: '06',
          title: 'Case Studies',
          desc: 'See what real measurements revealed: 40% of applicants couldn’t find their way to open positions and 92% of respondents noticed the main CTA. We show the data and the changes it led to.',
          href: '/en/case-studies',
          tags: ['Results', 'Data', 'Decisions'],
        },
      ].map(service => (
        <a href={service.href} class="group bg-brand-white p-8 hover:bg-brand-black hover:text-brand-white transition-colors duration-300">
          <div class="flex justify-between items-start mb-8">
            <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/60">{service.num}</p>
            <span class="font-mono text-xs group-hover:text-brand-white/60">→</span>
          </div>
          <h3 class="font-display text-3xl font-bold mb-4 leading-tight">{service.title}</h3>
          <p class="text-sm text-brand-black/60 group-hover:text-brand-white/60 leading-relaxed mb-6">{service.desc}</p>
          <div class="flex flex-wrap gap-2">
            {service.tags.map(tag => (
              <span class="font-mono text-xs border border-brand-black/20 group-hover:border-brand-white/20 px-2 py-1">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
    <!-- Test packages — black strip so it stands out -->
