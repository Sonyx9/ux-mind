---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="en"
  title="Case Studies"
  description="Real eye tracking measurements with verifiable numbers: 40% of applicants didn’t find open positions, 92% of respondents noticed the CTA, p = 0.037. We state the method, sample and limits."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CASE STUDIES ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          WHAT MEASUREMENT<br/>REVEALED<span style="color:#2D62FC">.</span>
        </h1>
        <p class="text-xl text-brand-black/60 max-w-3xl leading-relaxed">
          Real measurements, real samples. We only publish numbers we can back with primary data — including method, sample size and limits.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10">
        {[
          {
            href: '/en/case-studies/karierni-portal-automotive',
            category: "ŠKODA AUTO · career portal",
            title: "40% of applicants couldn’t find their way to open positions. Yet the site “looked clear”.",
            desc: "Eye tracking with a “find open positions” scenario showed that subjective clarity ratings don’t match the ability to complete the task. An A/B comparison of a floating CTA produced measurable differences in fixation metrics and visit length. The result was a simplified path to positions and a rebuilt navigation.",
            method: "Eye tracking + survey · N = 102",
            tags: ["Eye tracking", "Navigation", "A/B test"],
            result: "4 in 10 missed the openings",
          },
          {
            href: '/en/case-studies/backend-stories',
            category: "Educational microsite",
            title: "The longer the text, the less attention.",
            desc: "AOI analysis revealed an attention gradient: the bold headline was registered by approximately 86% of respondents, the short follow-up text by 62% and the long paragraph by 33%. The results supported emphasising the primary CTA and shortening long blocks.",
            method: "Eye tracking, AOI analysis · ~120 participants",
            tags: ["AOI analysis", "Content hierarchy", "CTA"],
            result: "92% noticed the CTA",
          },
          {
            href: '/en/case-studies/produktove-fotografie-e-commerce',
            category: "E-commerce",
            title: "The same product. A different length of decision.",
            desc: "The experiment compared a clean packshot with a lifestyle photo. Photo type had a statistically significant effect on task completion time — F(1,82) = 4.50; p = 0.037. In the tested scenario the lifestyle variant led to a longer time; the difference in subjective ratings was not clearly confirmed.",
            method: "Eye tracking + UEQ · N = 84",
            tags: ["Product photos", "Experiment", "PDP"],
            result: "Lifestyle lengthened task time",
          },
          {
            href: '/en/case-studies/reklamni-bannery-smer-pohledu',
            category: "Ad creative",
            title: "A character’s gaze steered visitors’ attention.",
            desc: "Changing the direction of the character’s gaze had a statistically significant effect on attention distribution: F(1,102) = 12.57; p < 0.001; ηp² = 0.11. The experiment demonstrated a medium-sized effect in the tested creatives; it measured neither clicks nor conversions.",
            method: "Eye tracking experiment · N = 104",
            tags: ["Banners", "Visual cues", "Attention"],
            result: "ηp² = 0.11 · medium effect",
          },
          {
            href: '/en/case-studies/sablony-e-shopu',
            category: "E-shop templates",
            title: "The task changed where people focused their attention.",
            desc: "Eye tracking of three templates with the same product range showed that the distribution of attention changed with the task given. VisAWI added a subjective rating of appearance — the study thus shows why aesthetics and behaviour during a shopping task need to be assessed separately.",
            method: "Eye tracking + VisAWI · N = 61",
            tags: ["E-commerce", "Aesthetics vs. performance", "Task-based testing"],
            result: "3 templates · 2 task types",
          },
          {
            href: '/en/case-studies/billboardy-sport-marketing',
            category: "Sports marketing · OOH",
            title: "The first six places belonged to the black billboards.",
            desc: "Eye tracking and the rating of 16 designs showed a clear preference for the black variants. Fixation metrics alone, however, did not determine the winner — the study shows why choosing creative needs to combine attention with the target group’s rating.",
            method: "Eye tracking + rating survey · N = 79 · 16 stimuli, 10 s each",
            tags: ["Billboards", "OOH", "Gender insight"],
            result: "TOP 6 · black background",
          },
        ].map(study => (
          <div class="bg-brand-white p-10 flex flex-col">
            <div class="flex flex-col gap-2 md:flex-row md:justify-between md:items-start mb-6">
              <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5 self-start">{study.category}</span>
              <a href={study.href} class="font-display text-lg font-bold leading-tight md:text-right md:whitespace-nowrap hover:opacity-70 transition-opacity" style="color:#2D62FC">{study.result}</a>
            </div>
            <h3 class="font-display text-2xl font-bold mb-4 leading-tight"><a href={study.href} class="hover:opacity-60 transition-opacity">{study.title}</a></h3>
            <p class="text-brand-black/60 leading-relaxed mb-6 text-justify">{study.desc}</p>
            <p class="font-mono text-[11px] text-brand-black/60 tracking-wide mb-6">METHOD: {study.method}</p>
            <div class="flex flex-wrap gap-2 mt-auto mb-6">
              {study.tags.map(tag => (
                <span class="font-mono text-xs text-brand-black/60 border border-brand-black/10 px-2 py-1">{tag}</span>
              ))}
            </div>
            <a href={study.href} class="inline-block self-start border border-brand-black px-5 py-2.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              VIEW STUDY →
            </a>
          </div>
        ))}
      </div>

      <details class="group border border-brand-black/15 mt-6">
        <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
          [ GLOSSARY ]
          <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <dl class="px-5 pb-6 space-y-4">
            <div><dt class="font-display font-bold mb-1">p</dt><dd class="text-sm text-brand-black/70 leading-relaxed">probability the result happened by chance (0.037 = 3.7% — the lower, the more conclusive)</dd></div>
            <div><dt class="font-display font-bold mb-1">ηp²</dt><dd class="text-sm text-brand-black/70 leading-relaxed">effect size (0.11 ≈ a medium, real-world effect)</dd></div>
            <div><dt class="font-display font-bold mb-1">N</dt><dd class="text-sm text-brand-black/70 leading-relaxed">number of people tested</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">tracked area of the page</dd></div>
        </dl>
      </details>

      <div class="text-center py-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ WANT DATA LIKE THIS FOR YOUR SITE? ]</p>
        <h2 class="font-display text-5xl font-bold mb-8">Let’s measure your project</h2>
        <a href="/en/contact" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
          GET A QUOTE →
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
