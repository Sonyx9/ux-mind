---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="fr"
  title="Contact"
  description="Réservez une consultation sans engagement pour un test utilisateur, un audit UX ou de l’eye tracking. Nous répondons sous 48 heures."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CONTACT ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          METTONS-LE<br/>À L’ÉPREUVE<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-16">

        <!-- Contact info -->
        <div>
          <p class="text-xl text-brand-black/60 leading-relaxed mb-12 text-justify">
            Envoyez-nous votre site, votre application, votre campagne ou une brève description du problème.
            Nous vous répondons sous 48 heures et proposons ce qu’il est pertinent de vérifier et quelle
            démarche choisir.
          </p>

          <div class="space-y-6">
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">EMAIL</p>
              <a href="mailto:spoluprace@uxmind.cz" class="font-display text-2xl font-bold hover:text-brand-blue transition-colors">
                spoluprace@uxmind.cz
              </a>
            </div>
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">TÉLÉPHONE</p>
              <a href="tel:+420728601160" class="font-display text-2xl font-bold hover:text-brand-blue transition-colors">
                +420 728 601 160
              </a>
            </div>
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">SIÈGE</p>
              <p class="font-display text-xl font-bold">K Lesu 180, Svinary<br/>500 09 Hradec Králové</p>
            </div>
          </div>

        </div>

        <!-- Contact form -->
        <div class="relative min-h-[620px]">
          <div class="absolute inset-0 z-10 border border-brand-black/10 bg-brand-white/95 flex items-center justify-center p-8 text-center">
            <div class="max-w-sm">
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ FORMULAIRE DE CONTACT ]</p>
              <p class="font-display text-4xl md:text-5xl font-bold tracking-tight mb-5">EN PRÉPARATION<span class="text-brand-blue">.</span></p>
              <p class="text-brand-black/60 leading-relaxed">
                En attendant la mise en ligne du formulaire, écrivez-nous à <a href="mailto:spoluprace@uxmind.cz" class="font-bold text-brand-black hover:text-brand-blue transition-colors">spoluprace@uxmind.cz</a>.
              </p>
            </div>
          </div>
          <form class="space-y-6 opacity-20 pointer-events-none select-none" name="contact" method="POST" data-netlify="true" aria-hidden="true">
            <fieldset disabled>
            <div class="space-y-6">
            <div>
              <label for="f-name" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">NOM *</label>
              <input
                type="text"
                id="f-name"
                name="name"
                required
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent"
                placeholder="Votre nom"
              />
            </div>

            <div>
              <label for="f-email" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">EMAIL *</label>
              <input
                type="email"
                id="f-email"
                name="email"
                required
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent"
                placeholder="votre@email.fr"
              />
            </div>

            <div>
              <label for="f-company" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">ENTREPRISE</label>
              <input
                type="text"
                id="f-company"
                name="company"
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent"
                placeholder="Nom de l’entreprise"
              />
            </div>

            <div>
              <label for="f-service" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">QUEL EST L’OBJET DU PROJET</label>
              <select
                id="f-service"
                name="service"
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent appearance-none"
              >
                <option value="">Choisissez un domaine…</option>
                <option value="audit-ux">Audit UX</option>
                <option value="eye-tracking">Eye Tracking</option>
                <option value="recherche-ux">Recherche UX</option>
                <option value="tests-utilisateurs">Tests utilisateurs</option>
                <option value="consultation">Consultation</option>
                <option value="autre">Autre</option>
              </select>
            </div>

            <div>
              <label for="f-message" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">QUE DEVEZ-VOUS DÉCOUVRIR ? *</label>
              <textarea
                id="f-message"
                name="message"
                required
                rows="5"
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent resize-none"
                placeholder="Décrivez brièvement le projet, le problème ou la décision pour laquelle vous avez besoin d’aide."
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors"
            >
              ENVOYER LA DEMANDE →
            </button>
            </div>
            </fieldset>
          </form>
        </div>
      </div>

      <!-- Provozovatel a bankovní spojení -->
      <div class="mt-16 border border-brand-black/10 p-8 md:p-10">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ EXPLOITANT DU SITE ]</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-8 text-sm">
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">RAISON SOCIALE</p>
            <p class="text-brand-black/80">UX MIND Research Lab s.r.o.</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">N° D’IDENTIFICATION (IČO)</p>
            <p class="text-brand-black/80">29714966</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">DATE D’IMMATRICULATION</p>
            <p class="text-brand-black/80">24 juin 2026</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">DOSSIER</p>
            <p class="text-brand-black/80">C 57053, tenu par le tribunal régional de Hradec Králové</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">SIÈGE SOCIAL</p>
            <p class="text-brand-black/80">K Lesu 180, Svinary, 500 09 Hradec Králové</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">BANQUE</p>
            <p class="text-brand-black/80">MONETA Money Bank, a.s.</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">NUMÉRO DE COMPTE</p>
            <p class="text-brand-black/80">283221603/0600</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">IBAN</p>
            <p class="text-brand-black/80 break-words">CZ96 0600 0000 0002 8322 1603</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">SWIFT / BIC</p>
            <p class="text-brand-black/80">AGBACZPP</p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
