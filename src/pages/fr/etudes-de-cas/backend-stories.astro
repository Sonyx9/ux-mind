---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const fakta = [["MÉTHODE", "Eye-tracking, analyse AOI"], ["ÉCHANTILLON", "env. 120 répondants"], ["SCÉNARIOS", "Plusieurs scénarios de tâches"], ["RÉSULTATS", "Statistiques AOI, gradient de lecture"]];
const zjisteni = ["Le CTA « Lire en ligne » a été fixé par ~92 % de l'échantillon.", "Gradient de lecture : le titre en gras a été remarqué par ~86 % des répondants, le texte court associé par 62 %, le long paragraphe par seulement ~33 %.", "~75 % des répondants ont remarqué la section basse de la page avant même de remplir le formulaire."];
const faq = [
  { q: "Que signifie le gradient d'attention ?", a: "La part des répondants ayant remarqué chaque élément diminuait progressivement : titre en gras environ 86 %, texte court 62 % et long paragraphe 33 %. Le résultat décrit cette page précise et les scénarios testés." },
  { q: "Combien de répondants ont remarqué le CTA principal ?", a: "Le CTA « Lire en ligne » a été remarqué par environ 92 % des quelque 120 répondants. C'est l'élément qui a obtenu le taux d'atteinte le plus élevé parmi tous ceux observés." },
  { q: "Une fixation signifie-t-elle que la personne a lu le texte ?", a: "Non. La fixation atteste que le regard s'est dirigé vers la zone donnée, pas une lecture complète ni une compréhension. C'est pourquoi nous formulons le résultat comme le fait de « remarquer » l'élément et l'interprétons dans le contexte de la tâche." },
  { q: "Qu'est-ce que les résultats impliquent pour la création de contenu ?", a: "Sur la page testée, un CTA clair, un titre marquant et un texte court associé ont aidé à concentrer l'attention. Sur un autre site, il faut vérifier le même principe dans son propre contenu et son propre contexte." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "Plus le texte est long, moins il capte l'attention",
    about: 'Eye tracking, recherche UX',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'fr',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="fr"
  title="Étude de cas : comment la longueur du texte a influencé l'attention"
  description="Analyse AOI par eye tracking d'une microsite éducative : le CTA a été remarqué par 92 % des répondants, le titre en gras par 86 %, le texte court par 62 % et le long paragraphe par 33 %."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/fr/etudes-de-cas" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← TOUTES LES ÉTUDES</a>

      <!-- Hlavička studie -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Microsite éducatif</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          Plus le texte est long, moins il capte l'attention<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Hlavní výsledky -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-2 lg:grid-cols-4">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        {[
          ['92 %', 'le CTA'],
          ['86 %', 'le titre en gras'],
          ['62 %', 'le texte court'],
          ['33 %', 'le long paragraphe'],
        ].map(([value, label], i) => (
          <div class:list={["relative p-6 md:p-8 border-brand-white/15", i === 0 && "border-t-4 border-t-brand-blue", i < 2 && "border-b lg:border-b-0", i % 2 === 0 && "border-r", i === 1 && "lg:border-r", i === 2 && "lg:border-r"]}>
            <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.5rem, 5vw, 4.5rem);">{value}</p>
            <p class="text-brand-white/70 text-sm md:text-base leading-relaxed">des répondants ont remarqué {label}</p>
          </div>
        ))}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Obsah -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— CE QUE LES DONNÉES ONT MONTRÉ</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— CE QU'IL FALLAIT DÉCOUVRIR</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">Quels éléments le visiteur remarque-t-il, et où l'attention commence-t-elle à chuter ?</p>
            <p class="text-brand-black/70 leading-relaxed">La microsite éducative combinait du contenu spécialisé avec un appel à l'action principal. L'objectif était de vérifier quelle attention obtiennent les différentes couches de la page — CTA, titres, textes courts et paragraphes plus longs.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— COMMENT S'EST DÉROULÉE LA MESURE</span></p>
            <p class="text-brand-black/70 leading-relaxed">Environ 120 répondants ont suivi plusieurs scénarios de tâches. L'eye tracking a capté leur attention visuelle et l'analyse AOI a calculé la part des répondants ayant fixé les éléments prédéfinis de la page.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ LES DONNÉES EN IMAGE ]</p>
              <svg viewBox="0 0 640 278" class="w-full" role="img" aria-label="Le CTA a été remarqué par 92 pour cent, le titre par 86, le texte court par 62 et le long paragraphe par 33 pour cent des répondants"><text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">GRADIENT DE LECTURE · PART DES RÉPONDANTS AYANT REMARQUÉ L'ÉLÉMENT</text><text x="0" y="67" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">CTA « LIRE EN LIGNE »</text><rect x="190" y="52" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="52" width="368" height="22" fill="#2D62FC" class="viz-bar"/><text x="558" y="67" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">92 %</text><text x="0" y="119" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">TITRE EN GRAS</text><rect x="190" y="104" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="104" width="344" height="22" fill="#0A0A0A" class="viz-bar"/><text x="534" y="119" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">86 %</text><text x="0" y="171" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">TEXTE COURT</text><rect x="190" y="156" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="156" width="248" height="22" fill="#0A0A0A" class="viz-bar"/><text x="438" y="171" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">62 %</text><text x="0" y="223" font-family="monospace" font-size="11" letter-spacing="1" fill="#0A0A0A">LONG PARAGRAPHE</text><rect x="190" y="208" width="400" height="22" fill="rgba(10,10,10,0.06)"/><rect x="190" y="208" width="132" height="22" fill="#0A0A0A" class="viz-bar"/><text x="322" y="223" dx="8" font-family="monospace" font-size="12" font-weight="bold" fill="#0A0A0A">33 %</text></svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">La part des répondants ayant remarqué l'élément diminuait du CTA principal, en passant par le titre et le texte court, jusqu'au long paragraphe.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— CE QUI A ÉTÉ DÉCIDÉ</span></p>
            <p class="text-brand-black/70 leading-relaxed">Les résultats ont motivé une séparation nette du CTA principal, le raccourcissement des longs blocs de texte et un travail plus rigoureux sur la hiérarchie de l'information. L'équipe a ainsi obtenu des données concrètes pour décider quelles parties du contenu mettre en avant, raccourcir ou réorganiser.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ CE QU'IL FAUT EN RETENIR ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">Une information présente sur la page ne signifie pas une information remarquée<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">L'eye tracking montre si la hiérarchie de l'information guide réellement l'attention vers ce que le visiteur doit voir et utiliser.</p>
            <a href="/fr/contact" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">DISCUTER DE VOTRE PROPRE ÉTUDE →</a>
          </section>
        </div>

        <!-- Fakta + foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">ÉTUDE RÉALISÉE EN COLLABORATION AVEC</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Faculté d'informatique et de management"
                title="Étude réalisée en collaboration avec la FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">FAITS DE MESURE</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/jan-petruzalek-analyza-eye-tracking-dat.webp`}
                alt="Un chercheur analyse des données AOI — heatmaps d'attention des différents éléments de la page à l'écran"
                width="1080" height="720" loading="lazy" decoding="async"
                class="w-full h-52 object-cover border border-brand-black/10"
              />
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Analyse AOI : chaque élément de la page a ses propres métriques d'attention</figcaption>
            </figure>
            <a href="/fr/contact" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              DEMANDE SANS ENGAGEMENT →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ GLOSSAIRE — CE QUE SIGNIFIENT LES TERMES DE CETTE ÉTUDE ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">Fixation</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Bref arrêt de l'œil dans une zone donnée. Elle atteste de l'attention visuelle, pas d'une lecture complète ni d'une compréhension.</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI (zone observée)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Partie de la page délimitée à l'avance, par exemple un CTA, un titre ou un bloc de texte, pour laquelle nous calculons des métriques.</dd></div>
            <div><dt class="font-display font-bold mb-1">Taux d'atteinte d'un élément</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Part des répondants ayant fixé au moins une fois la zone donnée pendant le scénario.</dd></div>
            <div><dt class="font-display font-bold mb-1">Gradient d'attention</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Diminution progressive de la part des répondants ayant remarqué chaque couche de contenu.</dd></div>
          </dl>
        </details>
      </section>

      <!-- FAQ ke studii -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ QUESTIONS FRÉQUENTES SUR L'ÉTUDE ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Úzký pruh: kompletní studie (otevírá modal) -->
      <section class="reveal mt-16 !hidden bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Vous voulez parcourir l'étude en détail<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">RAPPORT DÉTAILLÉ AVEC MÉTHODOLOGIE ET RECOMMANDATIONS — GRATUIT EN PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          DEMANDER L'ÉTUDE →
        </button>
      </section>

      <!-- Navigace mezi studiemi -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Autres études de cas">
        <a href="/fr/etudes-de-cas/karierni-portal-automotive" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← ÉTUDE PRÉCÉDENTE</p>
          <p class="font-display font-bold leading-snug">40 % des candidats n'ont pas trouvé le chemin vers les postes vacants</p>
        </a>
        <a href="/fr/etudes-de-cas/produktove-fotografie-e-commerce" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">ÉTUDE SUIVANTE →</p>
          <p class="font-display font-bold leading-snug">Même produit. Un temps de décision différent</p>
        </a>
      </nav>

    </div>

      <!-- Modal: žádost o kompletní studii -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ ÉTUDE DÉTAILLÉE ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Fermer la fenêtre">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Vous voulez parcourir l'étude en détail<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Les études sont abrégées et anonymisées.</p>
          <form class="study-request space-y-4" data-pdf="https://lukaskoula.com" data-study="Plus le texte est long, moins il capte l'attention">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">NOM *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Votre nom"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">ENTREPRISE</label>
              <input type="text" id="sr-company" name="company" placeholder="Nom de l'entreprise (facultatif)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="vous@email.fr"
                class="study-input" />
            </div>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              VOIR L'ÉTUDE (PDF) →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/50 p-3">Merci ! Si l'étude ne s'est pas ouverte d'elle-même, <a href="#" class="study-pdf-link underline hover:text-brand-white/70" target="_blank" rel="noopener">ouvrez-la avec ce lien</a>.</p>
            <p class="font-mono text-[11px] text-brand-white/70 leading-relaxed">En envoyant ce formulaire, vous acceptez l'affichage de l'étude et l'envoi occasionnel d'offres commerciales d'UX MIND. Vous pouvez vous désabonner à tout moment en un clic.</p>
          </form>
        </div>
      </dialog>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../../../scripts/case-study';
</script>
