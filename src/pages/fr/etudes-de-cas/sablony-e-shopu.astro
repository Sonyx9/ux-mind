---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const fakta = [["MÉTHODE", "Eye tracking + VisAWI"], ["ÉCHANTILLON", "61 répondants"], ["STIMULI", "3 templates · assortiment identique"], ["SCÉNARIOS", "Navigation libre · tâche ciblée"]];
const zjisteni = ["Sur un même template, la répartition de l'attention visuelle changeait selon la tâche assignée.", "La navigation libre et la recherche ciblée d'un produit ont conduit les participants vers des parties différentes de la page.", "L'évaluation esthétique et le comportement dans une tâche précise décrivent des aspects différents de l'expérience. Une métrique ne peut donc pas automatiquement remplacer l'autre."];
const faq = [
  { q: "Comment choisir un template d'e-shop ?", a: "D'abord selon l'assortiment, le contenu, les exigences techniques et les parcours clients clés. Il est judicieux de vérifier la sélection restreinte sur des tâches réalistes, car l'aperçu du template seul ne montre pas comment les gens s'y orienteront." },
  { q: "Pourquoi l'évaluation esthétique d'un template ne suffit-elle pas ?", a: "L'esthétique perçue et le comportement dans une tâche sont des construits différents. Un template peut sembler bon, mais un parcours précis peut y être difficile — ou l'inverse. C'est pourquoi nous combinons le questionnaire avec des données de tâche et comportementales." },
  { q: "Combien de templates et de tâches ont été testés ?", a: "L'étude comprenait trois templates avec le même assortiment, deux contextes de tâche différents et 61 répondants. Un scénario favorisait la navigation libre, l'autre le travail ciblé avec l'offre." },
  { q: "L'étude a-t-elle trouvé un seul meilleur template ?", a: "Pas de façon universelle. Le principal constat est que l'interprétation d'un template dépend de la tâche. La variante gagnante doit donc être définie selon le parcours précis et les métriques que l'e-shop doit soutenir." },
  { q: "La répartition de l'attention prouve-t-elle une conversion plus élevée ?", a: "Non. L'eye tracking montre où les gens ont porté leur regard, pas automatiquement l'achat ou le chiffre d'affaires. Pour une conclusion commerciale, il faut relier le résultat à la réussite de la tâche, à l'analytics ou à une expérience complémentaire." },
  { q: "Peut-on tester un template avant le lancement de l'e-shop ?", a: "Oui. On peut tester une démo fonctionnelle, un prototype ou plusieurs templates candidats remplis d'un contenu réaliste. Plus les conditions se rapprochent de l'usage réel, mieux le résultat peut être interprété." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "La tâche a changé où les gens ont porté leur attention.",
    about: 'Eye tracking, recherche UX',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'fr',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="fr"
  title="Étude de cas : comment la tâche a changé l'attention dans un e-shop"
  description="Eye tracking de trois templates d'e-shop avec 61 répondants : la répartition de l'attention sur un même template changeait selon la tâche assignée."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/fr/etudes-de-cas" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← TOUTES LES ÉTUDES</a>

      <!-- Hlavička studie -->
      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Templates e-shop</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-5xl" style="font-size: clamp(2.5rem, 6vw, 5.5rem);">
          La tâche a changé où les gens ont porté leur attention<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Design studie -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white mb-16 grid grid-cols-1 md:grid-cols-3">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative p-7 md:p-9 border-t-4 border-t-brand-blue border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">3</p>
          <p class="text-brand-white/70 leading-relaxed">templates d'e-shop avec le même assortiment</p>
        </div>
        <div class="relative p-7 md:p-9 border-b md:border-b-0 md:border-r border-brand-white/15">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">2</p>
          <p class="text-brand-white/70 leading-relaxed">contextes de tâche différents</p>
        </div>
        <div class="relative p-7 md:p-9">
          <p class="font-display font-bold leading-none tracking-tight mb-4" style="font-size: clamp(2.8rem, 6vw, 5rem);">61</p>
          <p class="text-brand-white/70 leading-relaxed">répondants dans l'étude</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Obsah -->
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— CE QUE LES DONNÉES ONT MONTRÉ</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— CE QU'IL FALLAIT DÉCOUVRIR</span></p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-5">L'apparence seule du template décrit-elle comment les gens y accomplissent une tâche précise ?</p>
            <p class="text-brand-black/70 leading-relaxed">L'étude comparait trois templates d'e-shop remplis du même assortiment. L'objectif était d'observer comment un contexte différent — navigation libre et recherche ciblée dans l'offre — change la façon dont les gens parcourent visuellement la page.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— COMMENT S'EST DÉROULÉE LA MESURE</span></p>
            <p class="text-brand-black/70 leading-relaxed">61 répondants ont participé à l'étude. L'eye tracking a enregistré la répartition de l'attention visuelle lors de tâches différentes, et le questionnaire VisAWI a complété l'évaluation subjective de l'esthétique perçue des templates.</p>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ PRINCIPE DES SCÉNARIOS TESTÉS ]</p>
              <svg viewBox="0 0 640 300" class="w-full" role="img" aria-label="Schéma illustratif : le même template, deux tâches, deux répartitions d'attention différentes">
  <text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">SCHÉMA ILLUSTRATIF · CE N'EST PAS UNE VRAIE HEATMAP</text>
  <g>
    <rect x="0" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <rect x="12" y="52" width="276" height="26" fill="rgba(10,10,10,0.12)"/>
    <g fill="rgba(10,10,10,0.08)">
      <rect x="12" y="92" width="84" height="52"/><rect x="108" y="92" width="84" height="52"/><rect x="204" y="92" width="84" height="52"/>
      <rect x="12" y="156" width="84" height="52"/><rect x="108" y="156" width="84" height="52"/><rect x="204" y="156" width="84" height="52"/>
    </g>
    <circle cx="150" cy="65" r="38" fill="#2D62FC" opacity="0.25"/>
    <circle cx="54" cy="118" r="30" fill="#2D62FC" opacity="0.18"/>
    <text x="8" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">TÂCHE : « PARCOUREZ L'E-SHOP »</text>
    <text x="8" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">attention sur le branding et l'intro</text>
  </g>
  <g>
    <rect x="340" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <rect x="352" y="52" width="276" height="26" fill="rgba(10,10,10,0.12)"/>
    <g fill="rgba(10,10,10,0.08)">
      <rect x="352" y="92" width="84" height="52"/><rect x="448" y="92" width="84" height="52"/><rect x="544" y="92" width="84" height="52"/>
      <rect x="352" y="156" width="84" height="52"/><rect x="448" y="156" width="84" height="52"/><rect x="544" y="156" width="84" height="52"/>
    </g>
    <circle cx="490" cy="118" r="34" fill="#2D62FC" opacity="0.25"/>
    <circle cx="586" cy="182" r="30" fill="#2D62FC" opacity="0.22"/>
    <text x="348" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">TÂCHE : « TROUVEZ ET ACHETEZ UN PRODUIT »</text>
    <text x="348" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">attention sur les produits et le prix</text>
  </g>
  <text x="0" y="296" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">EYE-TRACKING + VisAWI · N = 61 · TROIS TEMPLATES AVEC LE MÊME ASSORTIMENT</text>
</svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">Le schéma explique la différence entre les scénarios. Les zones bleues sont uniquement illustratives et ne représentent pas les données réellement mesurées des participants.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— RECOMMANDATION POUR LA PRATIQUE</span></p>
            <p class="text-brand-black/70 leading-relaxed">Ne pas évaluer un template uniquement en navigation libre ou sur un aperçu statique. Remplir les solutions candidates d'un contenu réaliste et les vérifier sur des tâches correspondant aux véritables parcours clients.</p>
          </section>

          <section class="reveal bg-brand-black text-brand-white p-7 md:p-9">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ CE QU'IL FAUT EN RETENIR ]</p>
            <p class="font-display text-xl md:text-2xl font-bold leading-snug mb-4">Un template ne fonctionne pas en soi. Il fonctionne pour une tâche précise<span style="color:#2D62FC">.</span></p>
            <p class="text-brand-white/70 leading-relaxed mb-7">Un test utilisateur montre si la solution choisie soutient la recherche, la comparaison et l'achat comme votre e-shop en a besoin.</p>
            <a href="/fr/contact" class="inline-block border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">DISCUTER DU TEST DE VOTRE E-SHOP →</a>
          </section>
        </div>

        <!-- Fakta + foto (sticky) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">ÉTUDE RÉALISÉE EN COLLABORATION AVEC</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Univerzita Hradec Králové — Faculté d'informatique et de management"
                title="Étude réalisée en collaboration avec la FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">FAITS DE MESURE</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <div class="border border-brand-black/10 p-4 bg-brand-white">
                <svg viewBox="0 0 320 210" class="w-full" role="img" aria-label="Schéma illustratif de trois templates d'e-shop différents avec le même assortiment">
                  <g>
                    <rect x="4" y="20" width="96" height="130" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                    <rect x="12" y="28" width="80" height="16" fill="rgba(10,10,10,0.25)"/>
                    <rect x="12" y="52" width="80" height="40" fill="rgba(10,10,10,0.08)"/>
                    <rect x="12" y="98" width="38" height="26" fill="rgba(10,10,10,0.08)"/>
                    <rect x="54" y="98" width="38" height="26" fill="rgba(10,10,10,0.08)"/>
                    <circle cx="52" cy="72" r="16" fill="#2D62FC" opacity="0.3"/>
                  </g>
                  <g>
                    <rect x="112" y="20" width="96" height="130" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                    <rect x="120" y="28" width="24" height="114" fill="rgba(10,10,10,0.18)"/>
                    <rect x="152" y="28" width="48" height="26" fill="rgba(10,10,10,0.08)"/>
                    <rect x="152" y="62" width="48" height="26" fill="rgba(10,10,10,0.08)"/>
                    <rect x="152" y="96" width="48" height="26" fill="rgba(10,10,10,0.08)"/>
                    <circle cx="176" cy="75" r="16" fill="#2D62FC" opacity="0.3"/>
                  </g>
                  <g>
                    <rect x="220" y="20" width="96" height="130" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                    <rect x="228" y="28" width="80" height="10" fill="rgba(10,10,10,0.25)"/>
                    <rect x="228" y="46" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="257" y="46" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="286" y="46" width="22" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="228" y="77" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="257" y="77" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="286" y="77" width="22" height="25" fill="rgba(10,10,10,0.08)"/>
                    <circle cx="268" cy="90" r="16" fill="#2D62FC" opacity="0.3"/>
                  </g>
                  <text x="4" y="176" font-family="monospace" font-size="11" fill="#0A0A0A">3 TEMPLATES · MÊME ASSORTIMENT</text>
                  <text x="4" y="194" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">aperçu illustratif des variantes</text>
                </svg>
              </div>
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Schéma illustratif de trois templates avec un assortiment identique</figcaption>
            </figure>
            <a href="/fr/contact" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              DEMANDE SANS ENGAGEMENT →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ GLOSSAIRE — CE QUE SIGNIFIENT LES TERMES DE CETTE ÉTUDE ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
            <div><dt class="font-display font-bold mb-1">N (échantillon)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Nombre de personnes incluses dans l'étude. Dans ce cas, N = 61.</dd></div>
            <div><dt class="font-display font-bold mb-1">Scénario de tâche</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Consigne précise qui détermine ce que le participant doit accomplir sur la page.</dd></div>
            <div><dt class="font-display font-bold mb-1">Fixation</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Bref arrêt de l'œil dans une zone donnée. Elle décrit l'attention visuelle, pas automatiquement la compréhension ou l'achat.</dd></div>
            <div><dt class="font-display font-bold mb-1">VisAWI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Questionnaire standardisé portant sur l'esthétique perçue subjectivement d'une interface web.</dd></div>
          </dl>
        </details>
      </section>

      <!-- FAQ ke studii -->
      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ QUESTIONS FRÉQUENTES SUR L'ÉTUDE ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Úzký pruh: kompletní studie (otevírá modal) -->
      <section class="reveal mt-16 !hidden bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Vous voulez parcourir l'étude en détail<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">RAPPORT DÉTAILLÉ AVEC MÉTHODOLOGIE ET RECOMMANDATIONS — GRATUIT EN PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          DEMANDER L'ÉTUDE →
        </button>
      </section>

      <!-- Navigace mezi studiemi -->
      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Autres études de cas">
        <a href="/fr/etudes-de-cas/reklamni-bannery-smer-pohledu" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← ÉTUDE PRÉCÉDENTE</p>
          <p class="font-display font-bold leading-snug">Le regard du personnage a orienté l'attention des visiteurs</p>
        </a>
        <a href="/fr/etudes-de-cas/billboardy-sport-marketing" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">ÉTUDE SUIVANTE →</p>
          <p class="font-display font-bold leading-snug">Les six premières places sont revenues aux panneaux noirs.</p>
        </a>
      </nav>

    </div>

      <!-- Modal: žádost o kompletní studii -->
      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ ÉTUDE DÉTAILLÉE ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Fermer la fenêtre">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Vous voulez parcourir l'étude en détail<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Les études sont abrégées et anonymisées.</p>
          <form class="study-request space-y-4" data-pdf="https://lukaskoula.com" data-study="La tâche a changé où les gens ont porté leur attention.">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">NOM *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Votre nom"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">ENTREPRISE</label>
              <input type="text" id="sr-company" name="company" placeholder="Nom de l'entreprise (facultatif)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="vous@email.fr"
                class="study-input" />
            </div>
