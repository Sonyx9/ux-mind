---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const fakta = [["MÉTHODE", "Eye-tracking + VisAWI"], ["ÉCHANTILLON", "61 répondants"], ["STIMULI", "3 modèles · assortiment identique"], ["RÉSULTATS", "Répartition de l'attention selon la tâche"]];
const zjisteni = ["Un même modèle a conduit à une répartition différente de l'attention selon la tâche assignée.", "La perception du design change selon la tâche — une évaluation esthétique sans contexte de tâche est trompeuse.", "« Beau » et « fonctionnel » sont deux métriques distinctes qu'il faut mesurer séparément."];
const faq = [
  { q: "Comment choisir un modèle d'e-shop ?", a: "Selon un test avec de vraies tâches d'achat, pas selon l'apparence de l'aperçu. Dans la mesure sur 61 répondants, l'attention sur un même modèle changeait selon la tâche assignée." },
  { q: "Pourquoi l'évaluation esthétique d'un modèle ne suffit-elle pas ?", a: "Parce qu'elle change selon la tâche — « beau » et « fonctionnel » sont deux métriques distinctes qu'il faut mesurer séparément (questionnaire VisAWI + données de performance)." },
  { q: "Combien de modèles et de tâches ont été testés ?", a: "Trois modèles avec le même assortiment et différents types de tâches (navigation libre vs. achat ciblé) sur un échantillon de 61 répondants." },
];
const pageSchema = [
  {
    '@type': 'Article',
    headline: "Trois modèles, le même assortiment. La tâche a décidé.",
    about: 'Eye tracking, recherche UX',
    author: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    inLanguage: 'fr',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="fr"
  title="Étude de cas : modèles d'e-shop et influence de la tâche"
  description="Eye tracking de trois modèles d'e-shop (N = 61) : la répartition de l'attention changeait selon la tâche assignée. Une évaluation esthétique sans tâche est trompeuse."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <a href="/fr/etudes-de-cas" class="font-mono text-xs tracking-widest text-brand-black/60 hover:text-brand-black transition-colors">← TOUTES LES ÉTUDES</a>

      <div class="mt-8 mb-10">
        <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5">Modèles d'e-shop</span>
        <h1 class="font-display font-bold leading-tight tracking-tight mt-6 max-w-4xl" style="font-size: clamp(3rem, 9vw, 8rem);">
          Trois modèles, le même assortiment. La tâche a décidé<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white p-8 md:p-12 mb-16 flex flex-col md:flex-row md:items-center gap-6 md:gap-12">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <p class="relative font-display font-bold leading-none tracking-tight whitespace-nowrap" style="font-size: clamp(3rem, 8vw, 6.5rem);">3 × 2</p>
        <p class="relative text-brand-white/70 text-lg leading-relaxed max-w-md">trois modèles, deux tâches — à chaque fois une carte d'attention différente</p>
      </div>

      <section class="reveal mb-16">
        <details class="group border border-brand-black/15">
          <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
            [ GLOSSAIRE — CE QUE SIGNIFIENT LES CHIFFRES DE CETTE ÉTUDE ]
            <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <dl class="px-5 pb-6 space-y-4">
            <div><dt class="font-display font-bold mb-1">N (échantillon)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Nombre de personnes réelles ayant participé à la mesure. N = 102 signifie 102 répondants.</dd></div>
            <div><dt class="font-display font-bold mb-1">valeur p</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Probabilité que la différence mesurée soit due au pur hasard. Plus elle est faible, plus le résultat est probant — p = 0,037 signifie seulement 3,7 % de chances de hasard (est considéré comme probant tout ce qui est sous 5 %).</dd></div>
            <div><dt class="font-display font-bold mb-1">Taille d'effet (ηp²)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Indique l'ampleur réelle de la différence — pas seulement si elle existe. À titre indicatif : 0,01 petit, 0,06 moyen, 0,14 grand effet.</dd></div>
            <div><dt class="font-display font-bold mb-1">Fixation</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Bref arrêt de l'œil sur un point (des fractions de seconde). La succession des fixations compose tout ce qu'une personne a réellement « vu » sur la page.</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI (zone d'intérêt)</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Partie de la page délimitée à l'avance — bouton, titre, photo — pour laquelle on mesure la quantité d'attention reçue.</dd></div>
            <div><dt class="font-display font-bold mb-1">UEQ / VisAWI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">Questionnaires scientifiques standardisés : UEQ mesure l'expérience utilisateur globale, VisAWI l'esthétique perçue du site. Grâce à la standardisation, les résultats sont comparables entre études.</dd></div>
          </dl>
        </details>
      </section>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">

          <section class="reveal mb-12">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">01</span> <span class="text-brand-black/60">— CONTEXTE</span></p>
            <p class="text-lg text-brand-black/80 leading-relaxed">Le choix d'un modèle est l'une des premières décisions de tout e-shop — et il se fait le plus souvent selon l'apparence de l'aperçu. Nous avons mesuré si l'impression esthétique est un bon repère pour la performance d'achat réelle.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">02</span> <span class="text-brand-black/60">— QUESTION BUSINESS</span></p>
            <p class="font-display text-2xl font-bold leading-snug">Suffit-il de choisir un modèle d'e-shop selon son apparence ? Ou ce qui compte, c'est ce que les clients doivent y accomplir ?</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">03</span> <span class="text-brand-black/60">— MESURE</span></p>
            <p class="text-brand-black/70 leading-relaxed">Eye-tracking de trois modèles avec le même assortiment, avec différentes tâches assignées, complété par le questionnaire VisAWI — un outil standardisé de mesure de l'esthétique perçue du site.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-6"><span style="color:#2D62FC">04</span> <span class="text-brand-black/60">— CE QUE LES DONNÉES ONT MONTRÉ</span></p>
            <div class="space-y-5">
              {zjisteni.map((item, i) => (
                <div class="flex gap-5 items-start border-l-2 pl-5" style="border-color:#2D62FC">
                  <p class="font-mono text-xs text-brand-black/60 mt-1 shrink-0">0{i + 1}</p>
                  <p class="text-brand-black/80 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="reveal mb-12">
            <div class="relative border border-brand-black/15 p-6 md:p-10">
              <span class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-brand-black" aria-hidden="true"></span>
          <span class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-brand-black" aria-hidden="true"></span>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ LES DONNÉES EN IMAGE ]</p>
              <svg viewBox="0 0 640 300" class="w-full" role="img" aria-label="Schéma illustratif : le même modèle, deux tâches, deux répartitions d'attention différentes">
  <text x="0" y="18" font-family="monospace" font-size="12" letter-spacing="2" fill="rgba(10,10,10,0.6)">SCHÉMA ILLUSTRATIF · MÊME MODÈLE, DEUX TÂCHES</text>
  <g>
    <rect x="0" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <rect x="12" y="52" width="276" height="26" fill="rgba(10,10,10,0.12)"/>
    <g fill="rgba(10,10,10,0.08)">
      <rect x="12" y="92" width="84" height="52"/><rect x="108" y="92" width="84" height="52"/><rect x="204" y="92" width="84" height="52"/>
      <rect x="12" y="156" width="84" height="52"/><rect x="108" y="156" width="84" height="52"/><rect x="204" y="156" width="84" height="52"/>
    </g>
    <circle cx="150" cy="65" r="38" fill="#2D62FC" opacity="0.25"/>
    <circle cx="54" cy="118" r="30" fill="#2D62FC" opacity="0.18"/>
    <text x="8" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">TÂCHE : « PARCOUREZ L'E-SHOP »</text>
    <text x="8" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">attention sur le branding et l'intro</text>
  </g>
  <g>
    <rect x="340" y="40" width="300" height="180" fill="none" stroke="rgba(10,10,10,0.3)"/>
    <rect x="352" y="52" width="276" height="26" fill="rgba(10,10,10,0.12)"/>
    <g fill="rgba(10,10,10,0.08)">
      <rect x="352" y="92" width="84" height="52"/><rect x="448" y="92" width="84" height="52"/><rect x="544" y="92" width="84" height="52"/>
      <rect x="352" y="156" width="84" height="52"/><rect x="448" y="156" width="84" height="52"/><rect x="544" y="156" width="84" height="52"/>
    </g>
    <circle cx="490" cy="118" r="34" fill="#2D62FC" opacity="0.25"/>
    <circle cx="586" cy="182" r="30" fill="#2D62FC" opacity="0.22"/>
    <text x="348" y="250" font-family="monospace" font-size="11" fill="#0A0A0A">TÂCHE : « TROUVEZ ET ACHETEZ UN PRODUIT »</text>
    <text x="348" y="268" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">attention sur les produits et le prix</text>
  </g>
  <text x="0" y="296" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">EYE-TRACKING + VisAWI · N = 61 · TROIS MODÈLES AVEC LE MÊME ASSORTIMENT</text>
</svg>
            </div>
            <p class="font-mono text-[11px] text-brand-black/60 mt-3">Schéma du principe : les zones bleues représentent le centre de gravité de l'attention pour différentes tâches sur un même modèle.</p>
          </section>

          <section class="reveal mb-12 border-t border-brand-black/10 pt-10">
            <p class="font-mono text-xs tracking-widest mb-4"><span style="color:#2D62FC">05</span> <span class="text-brand-black/60">— CE QUI A ÉTÉ DÉCIDÉ</span></p>
            <p class="text-brand-black/70 leading-relaxed">Choisir un modèle d'e-shop sur la base d'un test avec de vraies tâches d'achat, et non selon l'impression donnée par l'aperçu.</p>
          </section>

          <section class="reveal border border-brand-black p-8">
            <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-4">CE QU'EMLI APPORTERAIT AUJOURD'HUI</p>
            <p class="text-brand-black/70 leading-relaxed">Pour une mission similaire, nous mesurons aujourd'hui en plus l'indice de charge EMLI pour chaque tâche et chaque modèle — il quantifie quelle combinaison épuise le moins le client.</p>
          </section>
        </div>

        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="border border-brand-black/10 p-6">
              <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-4">ÉTUDE RÉALISÉE EN COLLABORATION AVEC</p>
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`}
                alt="Université de Hradec Králové — Faculté d'informatique et de management"
                title="Étude réalisée en collaboration avec la FIM UHK"
                width="157" height="37" loading="lazy" decoding="async"
                class="h-8 w-auto"
              />
            </div>
            <div class="border border-brand-black p-6">
              <p class="font-mono font-medium tracking-widest bg-brand-black text-brand-white text-xs px-2 py-1 block w-full mb-5">FAITS DE MESURE</p>
              <dl class="space-y-4">
                {fakta.map(([k, v]) => (
                  <div>
                    <dt class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-0.5">{k}</dt>
                    <dd class="text-sm text-brand-black/80 leading-snug">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure>
              <div class="border border-brand-black/10 p-4 bg-brand-white">
                <svg viewBox="0 0 320 210" class="w-full" role="img" aria-label="Schéma de trois modèles d'e-shop différents avec le même assortiment">
                  <g>
                    <rect x="4" y="20" width="96" height="130" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                    <rect x="12" y="28" width="80" height="16" fill="rgba(10,10,10,0.25)"/>
                    <rect x="12" y="52" width="80" height="40" fill="rgba(10,10,10,0.08)"/>
                    <rect x="12" y="98" width="38" height="26" fill="rgba(10,10,10,0.08)"/>
                    <rect x="54" y="98" width="38" height="26" fill="rgba(10,10,10,0.08)"/>
                    <circle cx="52" cy="72" r="16" fill="#2D62FC" opacity="0.3"/>
                  </g>
                  <g>
                    <rect x="112" y="20" width="96" height="130" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                    <rect x="120" y="28" width="24" height="114" fill="rgba(10,10,10,0.18)"/>
                    <rect x="152" y="28" width="48" height="26" fill="rgba(10,10,10,0.08)"/>
                    <rect x="152" y="62" width="48" height="26" fill="rgba(10,10,10,0.08)"/>
                    <rect x="152" y="96" width="48" height="26" fill="rgba(10,10,10,0.08)"/>
                    <circle cx="176" cy="75" r="16" fill="#2D62FC" opacity="0.3"/>
                  </g>
                  <g>
                    <rect x="220" y="20" width="96" height="130" fill="none" stroke="#0A0A0A" stroke-width="2"/>
                    <rect x="228" y="28" width="80" height="10" fill="rgba(10,10,10,0.25)"/>
                    <rect x="228" y="46" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="257" y="46" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="286" y="46" width="22" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="228" y="77" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="257" y="77" width="25" height="25" fill="rgba(10,10,10,0.08)"/>
                    <rect x="286" y="77" width="22" height="25" fill="rgba(10,10,10,0.08)"/>
                    <circle cx="268" cy="90" r="16" fill="#2D62FC" opacity="0.3"/>
                  </g>
                  <text x="4" y="176" font-family="monospace" font-size="11" fill="#0A0A0A">3 MODÈLES · MÊME ASSORTIMENT</text>
                  <text x="4" y="194" font-family="monospace" font-size="11" fill="rgba(10,10,10,0.6)">en bleu : centre de gravité de l'attention</text>
                </svg>
              </div>
              <figcaption class="font-mono text-[11px] text-brand-black/60 mt-2">Schéma des trois modèles testés — l'attention se déplaçait selon la tâche</figcaption>
            </figure>
            <a href="/fr/contact" class="block text-center border border-brand-black px-6 py-3.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              DEMANDE SANS ENGAGEMENT →
            </a>
          </div>
        </aside>
      </div>

      <section class="reveal mt-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ QUESTIONS FRÉQUENTES SUR L'ÉTUDE ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="reveal mt-16 bg-brand-black text-brand-white px-6 md:px-10 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <p class="font-display text-xl md:text-2xl font-bold leading-tight">Vous voulez parcourir l'étude en détail<span style="color:#2D62FC">?</span></p>
          <p class="font-mono text-[11px] text-brand-white/70 tracking-wide mt-1">RAPPORT DÉTAILLÉ AVEC MÉTHODOLOGIE ET RECOMMANDATIONS — GRATUIT EN PDF</p>
        </div>
        <button type="button" class="study-modal-open shrink-0 border border-brand-white px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          DEMANDER L'ÉTUDE →
        </button>
      </section>

      <nav class="reveal grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mt-20 border border-brand-black/10" aria-label="Autres études de cas">
        <a href="/fr/etudes-de-cas/reklamni-bannery-smer-pohledu" class="bg-brand-white p-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">← ÉTUDE PRÉCÉDENTE</p>
          <p class="font-display font-bold leading-snug">Là où regarde le personnage de la bannière, votre client regarde aussi</p>
        </a>
        <a href="/fr/etudes-de-cas/billboardy-sport-marketing" class="bg-brand-white p-6 text-right hover:bg-brand-black hover:text-brand-white transition-colors group">
          <p class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/70 tracking-widest mb-2">ÉTUDE SUIVANTE →</p>
          <p class="font-display font-bold leading-snug">16 maquettes de panneaux, 79 paires d'yeux</p>
        </a>
      </nav>

      <div class="reveal bg-brand-black text-brand-white text-center p-10 md:p-14 mt-10">
        <h2 class="font-display text-3xl md:text-4xl font-bold mb-8">Tester votre e-shop avec de vraies tâches<span style="color:#2D62FC">.</span></h2>
        <a href="/fr/contact" class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
          DEMANDE SANS ENGAGEMENT →
        </a>
        <p class="font-mono text-xs text-brand-white/60 mt-6">PACK TYPIQUE POUR CE TYPE DE MISSION : <a href="/fr/services/packs-de-test" class="text-brand-white underline hover:no-underline">Test UX standard</a></p>
      </div>
    </div>

      <dialog id="study-dialog" class="bg-brand-black text-brand-white p-0 w-[calc(100%-2rem)] max-w-lg border border-brand-white/20 backdrop:bg-brand-black/70">
        <div class="p-8">
          <div class="flex justify-between items-start mb-6">
            <p class="font-mono text-xs text-brand-white/70 tracking-widest">[ ÉTUDE DÉTAILLÉE ]</p>
            <button type="button" class="study-modal-close font-mono text-2xl leading-none hover:text-brand-white/70 transition-colors" aria-label="Fermer la fenêtre">×</button>
          </div>
          <h2 class="font-display text-2xl font-bold mb-3">Vous voulez parcourir l'étude en détail<span style="color:#2D62FC">?</span></h2>
          <p class="text-brand-white/70 text-sm leading-relaxed mb-6">Les études sont abrégées et anonymisées.</p>
          <form class="study-request space-y-4" data-pdf="https://lukaskoula.com" data-study="Trois modèles, le même assortiment. La tâche a décidé.">
            <div>
              <label for="sr-name" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">NOM *</label>
              <input type="text" id="sr-name" name="name" required placeholder="Votre nom"
                class="study-input" />
            </div>
            <div>
              <label for="sr-company" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">ENTREPRISE</label>
              <input type="text" id="sr-company" name="company" placeholder="Nom de l'entreprise (facultatif)"
                class="study-input" />
            </div>
            <div>
              <label for="sr-email" class="font-mono text-xs text-brand-white/70 tracking-widest block mb-2">E-MAIL *</label>
              <input type="email" id="sr-email" name="email" required placeholder="vous@email.fr"
                class="study-input" />
            </div>
            <button type="submit" class="w-full border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              VOIR L'ÉTUDE (PDF) →
            </button>
            <p class="study-request-done hidden font-mono text-xs text-brand-white leading-relaxed border border-brand-white/50 p-3">Merci ! Si l'étude ne s'est pas ouverte d'elle-même, <a href="#" class="study-pdf-link underline hover:text-brand-white/70" target="_blank" rel="noopener">ouvrez-la avec ce lien</a>.</p>
