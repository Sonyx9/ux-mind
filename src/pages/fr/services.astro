---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="fr"
  title="Services"
  description="Audit UX, eye tracking, recherche UX et tests utilisateurs. Un portefeuille complet de services UX pour produits numériques."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ NOS SERVICES ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter" style="font-size: clamp(3.5rem, 10vw, 9rem);">
          CE QUE NOUS<br/>FAISONS.
        </h1>
      </div>

      <div class="space-y-px border border-brand-black/10">
        {[
          {
            num: '01',
            title: 'Audit UX',
            desc: 'Une analyse systématique de votre produit numérique. Nous parcourons l’interface du point de vue de l’utilisateur, identifions les obstacles et proposons des améliorations concrètes, priorisées par impact.',
            details: ['Analyse heuristique', 'Analyse des parcours utilisateurs', 'Liste de recommandations priorisées', 'Atelier d’équipe', 'Rapport final avec maquettes'],
            duration: '2–4 semaines',
          },
          {
            num: '02',
            title: 'Eye Tracking',
            desc: 'Des données précises sur la perception visuelle de vos contenus. Nous suivons les mouvements oculaires des utilisateurs interagissant avec votre site, votre app ou vos supports imprimés.',
            details: ['Heatmaps d’attention', 'Analyse AOI (Areas of Interest)', 'Enregistrements des mouvements oculaires', 'Analyse F-pattern & Z-pattern', 'Tests comparatifs de variantes'],
            duration: '1–3 semaines',
          },
          {
            num: '03',
            title: 'Recherche UX',
            desc: 'Une recherche utilisateur approfondie combinant méthodes qualitatives et quantitatives. Nous vous aidons à comprendre les besoins, frustrations et modèles mentaux de vos utilisateurs.',
            details: ['Entretiens approfondis', 'Recherche contextuelle', 'Tests d’utilisabilité', 'Analyse de données', 'Personas & Journey maps'],
            duration: '3–8 semaines',
          },
          {
            num: '04',
            title: 'Tests utilisateurs',
            desc: 'Tests modérés et non modérés avec de vrais utilisateurs. Nous observons comment ils accomplissent des tâches dans votre produit et identifions où ils échouent.',
            details: ['Sessions de test modérées', 'Tests en ligne non modérés', 'Protocole think-aloud', 'Enregistrement d’écran', 'Analyse et recommandations'],
            duration: '1–4 semaines',
          },
        ].map(service => (
          <div class="p-8 md:p-12 border-b border-brand-black/10 last:border-0">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <div class="md:col-span-2">
                <div class="flex items-baseline gap-4 mb-4">
                  <span class="font-mono text-xs text-brand-black/60">{service.num}</span>
                  <h2 class="font-display text-3xl md:text-4xl font-bold">{service.title}</h2>
                </div>
                <p class="text-brand-black/60 leading-relaxed mb-6">{service.desc}</p>
                <ul class="space-y-1">
                  {service.details.map(d => (
                    <li class="font-mono text-xs text-brand-black/60 flex gap-2">
                      <span>→</span> {d}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="flex flex-col justify-between">
                <div>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">DURÉE DU PROJET</p>
                  <p class="font-display text-lg font-semibold">{service.duration}</p>
                </div>
                <a href="/fr/contact" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors mt-6 text-center">
                  DEMANDER →
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
