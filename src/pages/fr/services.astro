---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="fr"
  title="Services"
  description="Audit UX de site et de boutique en ligne, eye tracking, recherche UX, tests utilisateurs et mesures terrain avec des lunettes d’eye-tracking mobiles. Des recommandations fondées sur les données, pas sur des impressions."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Header -->
      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ NOS SERVICES ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter" style="font-size: clamp(3rem, 9vw, 8rem);">
          CE QUE NOUS<br/>FAISONS<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Services list -->
      <div class="space-y-px border border-brand-black/10">
        {[
          // Řazení: od rychlého základu (audit) po nejkomplexnější výzkum
          {
            num: '01',
            id: 'ux-audit',
            href: '/fr/services/audit-ux',
            title: 'Audit UX',
            desc: 'Nous parcourons votre site, boutique en ligne ou application avec les yeux d’un utilisateur. Nous repérons les endroits où les gens hésitent, partent ou n’achèvent pas une étape importante. Vous recevez des recommandations concrètes classées par impact.',
            details: ['Analyse heuristique', 'Analyse des parcours utilisateurs', 'Liste de recommandations priorisées', 'Atelier avec votre équipe', 'Rapport final avec propositions de modifications'],
            duration: '2–4 semaines',
            pkg: 'Diagnostic rapide',
          },
          {
            num: '02',
            id: 'testovani-uzivatelu',
            href: '/fr/services/tests-utilisateurs',
            title: 'Tests utilisateurs',
            desc: 'Nous confions à de vrais utilisateurs des tâches concrètes et observons s’ils parviennent à les accomplir. Vous découvrez où ils se perdent, ce qu’ils ne comprennent pas et pourquoi ils partent.',
            details: ['Tests modérés', 'Tests en ligne non modérés', 'Protocole de verbalisation à voix haute', 'Enregistrement d’écran', 'Résultats et recommandations'],
            duration: '1–4 semaines',
            pkg: 'Test UX standard',
          },
          {
            num: '03',
            href: '/fr/services/eye-tracking',
            title: 'Eye Tracking',
            desc: 'Grâce à l’eye tracking, nous mesurons où les gens regardent vraiment. Vous découvrez ce qu’ils remarquent, ce qu’ils manquent et si le contenu important guide leur attention dans la bonne direction.',
            details: ['Heatmaps d’attention', 'Analyse AOI (Areas of Interest)', 'Enregistrements des mouvements oculaires', 'Analyse F-pattern & Z-pattern', 'Tests comparatifs de variantes'],
            duration: '1–3 semaines',
            pkg: 'Test UX standard',
          },
          {
            num: '04',
            id: 'terenni-mereni',
            href: '/fr/services/recherche-terrain',
            title: 'Recherche terrain',
            desc: 'Nous observons les clients directement là où ils décident — en magasin, en showroom, lors d’un événement ou face à un produit physique. Des lunettes d’eye-tracking mobiles montrent ce qu’ils remarquent dans un environnement réel et ce qu’ils manquent.',
            details: ['Lunettes d’eye-tracking mobiles Pupil Labs NEON', 'Enregistrement vidéo de la situation et du comportement dans l’espace', 'GSR et entretiens selon les besoins', 'Product placement, signalétique, supports POS', 'Recommandations pour ajuster l’espace et le parcours client'],
            duration: '2–6 semaines',
            pkg: 'Étude terrain',
          },
          {
            num: '05',
            href: '/fr/services/recherche-ux',
            title: 'Recherche UX',
            desc: 'Nous vous aidons à comprendre ce dont les utilisateurs ont besoin, ce qui les frustre et pourquoi ils se comportent d’une certaine façon. Selon la question de recherche, nous combinons entretiens, observation, tests et données.',
            details: ['Entretiens approfondis', 'Recherche contextuelle', 'Tests d’utilisabilité', 'Analyse de données', 'Personas & Journey maps'],
            duration: '3–8 semaines',
            pkg: 'Recherche biométrique complète',
          },
        ].map(service => (
          <div id={service.id} class="p-8 md:p-12 border-b border-brand-black/10 last:border-0 scroll-mt-28">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <div class="md:col-span-2">
                <div class="flex items-baseline gap-4 mb-4">
                  <span class="font-mono text-xs text-brand-black/60">{service.num}</span>
                  <h2 class="font-display text-3xl md:text-4xl font-bold">
                    <a href={service.href} class="hover:opacity-60 transition-opacity">{service.title}</a>
                  </h2>
                </div>
                <p class="text-brand-black/60 leading-relaxed mb-6">{service.desc}</p>
                <ul class="space-y-1">
                  {service.details.map(d => (
                    <li class="font-mono text-xs text-brand-black/60 flex gap-2">
                      <span>→</span> {d}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="flex flex-col justify-between">
                <div>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">DURÉE DU PROJET</p>
                  <p class="font-display text-lg font-semibold">{service.duration}</p>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mt-4 mb-1">PACK TYPE</p>
                  <a href="/fr/services/packs-de-test" class="font-display text-lg font-semibold underline hover:no-underline">{service.pkg}</a>
                </div>
                <div class="flex flex-col gap-2 mt-6">
                  <a href={service.href} class="inline-block bg-brand-black text-brand-white border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-[#2D62FC] hover:border-[#2D62FC] hover:text-brand-white transition-colors text-center">
                    DÉTAIL DU SERVICE →
                  </a>
                  <a href="/fr/contact" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors text-center">
                    DEMANDER SANS ENGAGEMENT
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Testovací balíčky -->
      <a id="packs-de-test" href="/fr/services/packs-de-test" class="group block mt-24 border border-brand-black bg-brand-black text-brand-white p-8 md:p-12 hover:bg-brand-white hover:text-brand-black transition-colors duration-300 scroll-mt-28">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
          <div class="md:col-span-2">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4 group-hover:text-brand-black/60 transition-colors">[ PACKS DE TEST ]</p>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-4">Du contrôle rapide à la recherche approfondie<span style="color:#2D62FC">.</span></h2>
            <p class="text-brand-white/70 leading-relaxed max-w-2xl group-hover:text-brand-black/70 transition-colors">
              Choisissez l’ampleur selon ce que vous devez découvrir. Nous combinons les méthodes adaptées et expliquons à l’avance quelles réponses les tests vous apporteront.
            </p>
          </div>
          <div class="flex md:justify-end">
            <span class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase group-hover:border-brand-black group-hover:text-brand-black transition-colors">
              COMPARER LES PACKS →
            </span>
          </div>
        </div>
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
