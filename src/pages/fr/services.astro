---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="fr"
  title="Services"
  description="Audit UX de site et d’e-commerce, eye tracking, recherche UX, tests utilisateurs et mesures terrain avec lunettes d’eye-tracking mobiles. Des recommandations fondées sur les données, pas sur des impressions."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Header -->
      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ NOS SERVICES ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter" style="font-size: clamp(3.5rem, 10vw, 9rem);">
          CE QUE NOUS<br/>FAISONS.
        </h1>
      </div>

      <!-- Services list -->
      <div class="space-y-px border border-brand-black/10">
        {[
          // Řazení: od rychlého základu (audit) po nejkomplexnější výzkum
          {
            num: '01',
            id: 'ux-audit',
            href: '/fr/services/audit-ux',
            title: 'Audit UX',
            desc: 'Le socle rapide de toute amélioration. Une analyse systématique de votre produit numérique — nous parcourons l’interface du point de vue de l’utilisateur, identifions les obstacles et proposons des améliorations concrètes, priorisées par impact.',
            details: ['Analyse heuristique', 'Analyse des parcours utilisateurs', 'Liste de recommandations priorisées', 'Atelier avec votre équipe', 'Rapport final avec maquettes'],
            duration: '2–4 semaines',
            pkg: 'Diagnostic rapide',
          },
          {
            num: '02',
            id: 'testovani-uzivatelu',
            href: '/fr/services/tests-utilisateurs',
            title: 'Tests utilisateurs',
            desc: 'Des tests modérés et non modérés avec de vrais utilisateurs. Nous observons comment les utilisateurs accomplissent des tâches dans votre produit et identifions où ils échouent.',
            details: ['Sessions de test modérées', 'Tests en ligne non modérés', 'Protocole think-aloud', 'Enregistrement d’écran', 'Analyse et recommandations'],
            duration: '1–4 semaines',
            pkg: 'Test UX standard',
          },
          {
            num: '03',
            href: '/fr/services/eye-tracking',
            title: 'Eye Tracking',
            desc: 'Des données précises sur la perception visuelle de vos contenus. Nous suivons les mouvements oculaires des utilisateurs interagissant avec votre site, votre application ou vos supports imprimés.',
            details: ['Heatmaps d’attention', 'Analyse AOI (Areas of Interest)', 'Enregistrements des mouvements oculaires', 'Analyse F-pattern & Z-pattern', 'Tests comparatifs de variantes'],
            duration: '1–3 semaines',
            pkg: 'Test UX standard',
          },
          {
            num: '04',
            id: 'terenni-mereni',
            href: '/fr/services/recherche-terrain',
            title: 'Recherche terrain',
            desc: 'Nous mesurons là où le client décide réellement — en magasin, en showroom, lors d’un événement ou face à un produit physique. Les lunettes d’eye-tracking mobiles capturent l’attention en environnement réel, pas seulement à l’écran. Un équipement que peu d’acteurs possèdent en République tchèque.',
            details: ['Lunettes d’eye-tracking mobiles Pupil Labs NEON', 'Enregistrement vidéo de la situation et du comportement dans l’espace', 'GSR et entretiens selon les besoins', 'Product placement, signalétique, supports POS', 'Recommandations pour ajuster l’espace et le parcours client'],
            duration: '2–6 semaines',
            pkg: 'Étude terrain',
          },
          {
            num: '05',
            href: '/fr/services/recherche-ux',
            title: 'Recherche UX',
            desc: 'L’étendue la plus profonde : une combinaison de méthodes qualitatives et quantitatives. Nous vous aidons à comprendre les besoins, frustrations et modèles mentaux de vos utilisateurs.',
            details: ['Entretiens approfondis', 'Recherche contextuelle', 'Tests d’utilisabilité', 'Analyse de données', 'Personas & Journey maps'],
            duration: '3–8 semaines',
            pkg: 'Recherche biométrique complète',
          },
        ].map(service => (
          <div id={service.id} class="p-8 md:p-12 border-b border-brand-black/10 last:border-0 scroll-mt-28">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <div class="md:col-span-2">
                <div class="flex items-baseline gap-4 mb-4">
                  <span class="font-mono text-xs text-brand-black/60">{service.num}</span>
                  <h2 class="font-display text-3xl md:text-4xl font-bold">
                    <a href={service.href} class="hover:opacity-60 transition-opacity">{service.title}</a>
                  </h2>
                </div>
                <p class="text-brand-black/60 leading-relaxed mb-6">{service.desc}</p>
                <ul class="space-y-1">
                  {service.details.map(d => (
                    <li class="font-mono text-xs text-brand-black/60 flex gap-2">
                      <span>→</span> {d}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="flex flex-col justify-between">
                <div>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">DURÉE DU PROJET</p>
                  <p class="font-display text-lg font-semibold">{service.duration}</p>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mt-4 mb-1">PACK TYPE</p>
                  <a href="/fr/services/packs-de-test" class="font-display text-lg font-semibold underline hover:no-underline">{service.pkg}</a>
                </div>
                <div class="flex flex-col gap-2 mt-6">
                  <a href={service.href} class="inline-block bg-brand-black text-brand-white border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors text-center">
                    DÉTAIL DU SERVICE →
                  </a>
                  <a href="/fr/contact" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors text-center">
                    NOUS CONTACTER
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Testovací balíčky -->
      <div class="mt-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
          <div class="md:col-span-2">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ PACKS DE TEST ]</p>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-4">Du diagnostic rapide à la recherche biométrique complète</h2>
            <p class="text-brand-white/70 leading-relaxed max-w-2xl">
              Nous composons nos services en packs de test selon la décision que vous devez prendre — eye-tracking, données comportementales, questionnaires, GSR et mesures terrain. Vous savez à l’avance ce que les tests vous apporteront et ce que l’étendue choisie ne permettra pas d’affirmer de manière fiable.
            </p>
          </div>
          <div class="flex md:justify-end">
            <a href="/fr/services/packs-de-test" class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              DÉCOUVRIR LES PACKS →
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
