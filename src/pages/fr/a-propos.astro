---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { localizedPath } from '../../i18n/utils';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const vystupyMereni = [
  ['Attention', 'Quels éléments l’utilisateur remarque, dans quel ordre et ce qu’il manque complètement.'],
  ['Déroulement de la tâche', 'Où il avance sans encombre, où il revient en arrière et à quelle étape il s’arrête.'],
  ['Réaction', 'À quels endroits l’activation ou la charge mentale augmente.'],
];

const vrstvy = [
  {
    t: 'Attention visuelle',
    d: 'L’eye tracking montre où l’utilisateur regarde, dans quel ordre et ce qu’il manque complètement. Nous découvrons aussi la vitesse à laquelle il trouve un élément important et le temps qu’il lui accorde.',
    tag: 'EYE TRACKING',
  },
  {
    t: 'Réaction émotionnelle',
    d: 'La conductance cutanée capte les changements d’activation physiologique, l’analyse des expressions capte l’expression du visage. Elles aident à repérer les moments qui déclenchent une réaction — sans dire, à elles seules, pourquoi.',
    tag: 'GSR + EXPRESSIONS',
  },
  {
    t: 'Charge mentale',
    d: 'Nous mesurons où l’interface exige plus d’attention et d’effort. Nous révélons les endroits qui ralentissent l’utilisateur, le déroutent ou compliquent inutilement l’accomplissement de la tâche.',
    tag: 'EFFORT MENTAL',
  },
];

const vybaveni = [
  { nazev: 'Smart Eye Aurora', typ: 'eye tracking de bureau', k: 'Suivi précis du regard pour tester des sites, des applications et d’autres interfaces numériques.' },
  { nazev: 'Tobii Pro X2-60', typ: 'eye tracking de bureau', k: 'Eye tracker portable pour les études sur écran et la comparaison de variantes.' },
  { nazev: 'Pupil Labs Neon (2×)', typ: 'eye tracking mobile', k: 'Lunettes pour suivre l’attention en magasin, en showroom, dans un stade ou en circulation.' },
  { nazev: 'iMotions + analyse des expressions', typ: 'logiciel de recherche', k: 'Relie l’eye tracking, les expressions faciales et d’autres signaux en un seul enregistrement synchronisé.' },
  { nazev: 'Shimmer3 GSR', typ: 'biométrie', k: 'Capte les changements de conductance cutanée, révélateurs du niveau d’activation physiologique.' },
];

const postup = [
  { num: '01', title: 'Conception de l’étude', desc: 'Nous clarifions ce que vous devez découvrir, qui il est pertinent de tester et selon quels critères nous évaluerons le résultat.' },
  { num: '02', title: 'Préparation et mesure', desc: 'Nous préparons les tâches, mettons en place la technique et réalisons la mesure en laboratoire ou directement sur le terrain.' },
  { num: '03', title: 'Analyse', desc: 'Nous relions le regard, le comportement, les réactions et les témoignages des participants. Nous cherchons des liens, pas des chiffres isolés hors contexte.' },
  { num: '04', title: 'Recommandations pour la pratique', desc: 'Vous recevez des conclusions claires, des priorités et des recommandations concrètes sur quoi changer.' },
];

const rizika = [
  'la calibration correcte pendant toute la durée de la mesure',
  'la fatigue des participants',
  'l’ordre des tâches, pour qu’il n’influence pas le résultat',
  'une consigne claire et sans ambiguïté',
  'que la conclusion ne repose pas sur une seule métrique',
];

const etika = [
  'Protocole standardisé et vérification pilote de l’étude',
  'Consentement éclairé de chaque participant',
  'Traitement des données conforme au RGPD, si nécessaire également sous NDA',
  'Possibilité d’anonymiser les données et le livrable, avec méthodologie documentée',
  'Évaluation par un comité d’éthique si la nature du projet l’exige',
];

const tymLaboratore = [
  ['02', 'Direction et méthodologie'],
  ['01', 'Gestion du laboratoire'],
  ['08', 'Opérateurs formés'],
];

const pageSchema = [
  {
    '@type': 'ResearchOrganization',
    name: 'FIMEYELAB',
    description:
      'Laboratoire d’eye tracking et de biométrie de la Faculté d’informatique et de management de l’Univerzita Hradec Králové. Mesure de l’attention visuelle, de la réaction émotionnelle et de la charge cognitive en laboratoire comme sur le terrain.',
    parentOrganization: {
      '@type': 'CollegeOrUniversity',
      name: 'Univerzita Hradec Králové — Fakulta informatiky a managementu',
    },
  },
  {
    '@type': 'AboutPage',
    name: 'À propos — laboratoire FIMEYELAB',
    description:
      'UX MIND mesure au laboratoire FIMEYELAB à la FIM UHK. Cinq systèmes de mesure, huit publications scientifiques, deux thèses de doctorat soutenues.',
  },
];
---

<BaseLayout
  lang="fr"
  title="Laboratoire FIMEYELAB | Qui se cache derrière UX MIND"
  description="Nous ne mesurons pas en salle de réunion. UX MIND mesure au laboratoire FIMEYELAB à la Faculté d’informatique et de management de l’UHK — cinq systèmes de mesure, huit publications scientifiques, deux thèses de doctorat soutenues."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ À PROPOS / LABORATOIRE ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          LA RECHERCHE<br/>PLUTÔT QUE LES IMPRESSIONS<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-4xl">
          <div>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify mb-4">
              UX MIND combine l’expérience des produits numériques et l’expertise de recherche du laboratoire
              <strong class="text-brand-black">FIMEYELAB</strong> à la Faculté d’informatique et de management de
              l’Univerzita Hradec Králové. Grâce à l’eye tracking, aux tests utilisateurs et aux méthodes biométriques,
              nous découvrons ce que les gens voient réellement, ce qu’ils ne comprennent pas et où ils se perdent
              au moment de décider.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify">
              Le résultat n’est pas seulement des heatmaps et des graphiques. Vous recevez des conclusions claires
              et des recommandations concrètes pour un site, une application, une campagne ou un espace physique.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href={localizedPath('fr', 'case-studies')} class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              ÉTUDES DE CAS
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['SYSTÈMES DE MESURE', '5'],
          ['PUBLICATIONS SCIENTIFIQUES', '8'],
          ['THÈSES SOUTENUES', '2'],
          ['NOUS MESURONS', 'Laboratoire et terrain'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight text-xl">{v}</p>
          </div>
        ))}
      </div>

      <!-- Foto laboratoře -->
      <div class="reveal mb-24 grid grid-cols-1 md:grid-cols-5 gap-8 items-start">
        <div class="md:col-span-2">
          <img
            src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
            alt="Participante lors d’une mesure sur un poste équipé d’un eye tracker au laboratoire FIMEYELAB"
            title="Mesure au laboratoire FIMEYELAB"
            width="1080" height="1920" loading="lazy" decoding="async"
            class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
          />
          <p class="font-mono text-[11px] text-brand-black/60 mt-2">
            Laboratoire FIMEYELAB, Faculté d’informatique et de management de l’UHK.
          </p>
        </div>
        <div class="md:col-span-3">
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ LA MESURE EN PRATIQUE ]</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold leading-tight mb-6">
            Ce que nous observons pendant les tests<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-black/60 leading-relaxed text-justify mb-4">
            L’eye tracker sous l’écran enregistre le mouvement des yeux soixante fois par seconde. La caméra
            au-dessus de l’écran capte les réactions faciales pendant que la participante réalise une tâche
            concrète sur la page testée.
          </p>
          <p class="text-brand-black/60 leading-relaxed text-justify">
            En croisant le regard, le comportement et les réactions, nous découvrons ce que l’utilisateur a
            remarqué, ce qu’il a manqué et à quel moment il a hésité en accomplissant la tâche.
          </p>
          <dl class="mt-8 border-t border-brand-black/10 pt-6 space-y-4">
            {vystupyMereni.map(([label, desc], i) => (
              <div class="flex gap-4">
                <span class="font-mono text-xs shrink-0 pt-0.5" style="color:#2D62FC;">0{i + 1}</span>
                <div>
                  <dt class="font-mono text-[11px] tracking-widest uppercase text-brand-black/70 mb-0.5">{label}</dt>
                  <dd class="text-sm text-brand-black/60 leading-relaxed">{desc}</dd>
                </div>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <!-- Jak to spolu souvisí -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ COMMENT TOUT CELA S’ARTICULE ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-8 max-w-3xl">
          Laboratoire universitaire, cadence commerciale<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          <div class="bg-brand-white p-6 md:p-8">
            <p class="font-mono text-xs text-brand-black/60 mb-6">01</p>
            <h3 class="font-display text-2xl font-bold mb-3">Laboratoire FIMEYELAB</h3>
            <p class="text-brand-black/60 leading-relaxed text-sm text-justify">
              FIMEYELAB appartient à l’Univerzita Hradec Králové. Il sert la recherche, l’enseignement et
              l’encadrement de mémoires et de thèses — et maintient ainsi un niveau d’exigence méthodologique
              qu’une activité purement commerciale ne s’impose pas d’elle-même.
            </p>
          </div>
          <div class="bg-brand-white p-6 md:p-8">
            <p class="font-mono text-xs text-brand-black/60 mb-6">02</p>
            <h3 class="font-display text-2xl font-bold mb-3">UX MIND</h3>
            <p class="text-brand-black/60 leading-relaxed text-sm text-justify">
              Les commandes commerciales au laboratoire passent toujours par UX MIND. Nous sommes le partenaire
              contractuel avec lequel vous signez la commande, obtenez un délai, un prix et un livrable — et qui
              répond du résultat.
            </p>
          </div>
          <div class="bg-brand-white p-6 md:p-8">
            <p class="font-mono text-xs text-brand-black/60 mb-6">03</p>
            <h3 class="font-display text-2xl font-bold mb-3">Le lien</h3>
            <p class="text-brand-black/60 leading-relaxed text-sm text-justify">
              Jan Petružálek est responsable du laboratoire FIMEYELAB et copropriétaire de UX MIND. La méthodologie
              et l’exécution ne sont donc pas deux mondes qui se renvoient la balle par-dessus une clôture.
            </p>
          </div>
        </div>
        <p class="text-brand-black/60 leading-relaxed text-justify mt-8 max-w-3xl">
          Concrètement, cela ne signifie qu’une seule chose pour vous : vous obtenez une méthodologie académique
          sans les délais académiques. C’est ainsi que nous avons mesuré le portail carrière de <strong class="text-brand-black">ŠKODA AUTO</strong>,
          la campagne d’un club de football et les pages produit de boutiques en ligne.
        </p>
      </div>

      <!-- Co umíme změřit -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CE QUE NOUS SAVONS MESURER ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Trois couches de l’expérience utilisateur<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {vrstvy.map((v, i) => (
            <div class="bg-brand-white p-8 flex flex-col">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed text-justify mb-6">{v.d}</p>
              <span class="mt-auto self-start font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Une seule métrique ne suffit pas. C’est pourquoi nous relions le regard, le déroulement de la tâche,
          les réactions et le témoignage de l’utilisateur. Seul leur lien montre où naît le problème et ce qu’il
          est pertinent de changer.
        </p>
      </div>

      <!-- Čím měříme -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ AVEC QUOI NOUS MESURONS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Cinq systèmes pour le laboratoire et le terrain<span style="color:#2D62FC">.</span>
        </h2>
        <div class="border border-brand-black/10">
          {vybaveni.map(z => (
            <div class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-6 p-6 border-b border-brand-black/10 last:border-0">
              <div class="md:col-span-4">
                <p class="font-display text-lg font-bold leading-tight">{z.nazev}</p>
                <p class="font-mono text-[11px] text-brand-black/60 tracking-wide uppercase">{z.typ}</p>
              </div>
              <p class="md:col-span-8 text-sm text-brand-black/60 leading-relaxed">{z.k}</p>
            </div>
          ))}
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Deux paires de lunettes mobiles nous permettent de mesurer plus de participants ou de situations en
          moins de temps.
        </p>
      </div>

      <!-- Vizualizace laboratoře -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/laborator-ux-vyzkumu-vizualizace-1.webp`}
          alt="Visualisation de l’aménagement prévu du laboratoire FIMEYELAB"
          title="Aménagement prévu du laboratoire"
          width="1600" height="1127" loading="lazy" decoding="async"
          class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">
          Visualisation de l’aménagement prévu du laboratoire — des postes de mesure séparés pour des tests simultanés.
        </p>
      </div>

      <!-- Jak měření probíhá -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ COMMENT SE DÉROULE LA MESURE ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          De la question à la recommandation concrète<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
          {postup.map(step => (
            <div class="bg-brand-white p-6 md:p-8 flex flex-col">
              <p class="font-mono text-xs text-brand-black/60 mb-6">{step.num}</p>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
        <div class="mt-6 border border-brand-black/10 p-8 md:p-10">
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ CE QUE NOUS SURVEILLONS DANS LE PROTOCOLE ]</p>
          <ul class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-x-8 gap-y-4 mb-8">
            {rizika.map(r => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed">
                <span class="font-mono text-xs pt-0.5 shrink-0" style="color:#2D62FC;">→</span> {r}
              </li>
            ))}
          </ul>
          <p class="text-sm text-brand-black/60 leading-relaxed max-w-3xl border-t border-brand-black/10 pt-6">
            Grâce à cela, les résultats sont comparables et les recommandations ne reposent ni sur le hasard
            ni sur un seul enregistrement.
          </p>
        </div>
      </div>

      <!-- Akademické zázemí -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ ASSISE ACADÉMIQUE ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Notre expertise en chiffres<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          <div class="bg-brand-white p-8">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">PUBLICATIONS</p>
            <p class="font-display text-5xl font-bold mb-2">8</p>
            <p class="text-sm text-brand-black/60 leading-relaxed mb-6">
              publications scientifiques consacrées à l’eye tracking et à l’expérience utilisateur.
            </p>
            <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-2">EXEMPLE DE PUBLICATION</p>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Franěk, M., &amp; Petružálek, J. (2025). <em>Perceptual fluency and eye movements when viewing
              urban and natural scenes.</em> Scientific Reports, 15(1), čl. 25772.
            </p>
          </div>
          <div class="bg-brand-white p-8">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">RECHERCHE ET FORMATION</p>
            <ul class="space-y-3 text-sm text-brand-black/60 leading-relaxed">
              <li class="pb-3 border-b border-brand-black/5">
                <strong class="text-brand-black">2 thèses de doctorat soutenues</strong><br/>
                Jan Petružálek (2023) — kombinace metod měření uživatelské zkušenosti s využitím eye trackingu<br/>
                Denis Šefara (2022) — využití pozornosti při návrhu business dashboardů
              </li>
              <li>
                <strong class="text-brand-black">8 mémoires de master et de licence soutenus</strong><br/>
                2 mémoires de master, 6 mémoires de licence
              </li>
            </ul>
          </div>
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Le travail continu sur des thèmes de recherche nous permet de vérifier, comparer et développer nos
          méthodes sur différents types de mandats.
        </p>
      </div>

      <!-- Lidé -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ LES PERSONNES ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6 max-w-3xl">
          Deux associés, une équipe de recherche plus large<span style="color:#2D62FC">.</span>
        </h2>
        <p class="text-brand-black/60 leading-relaxed max-w-3xl mb-10">
          UX MIND est dirigé par deux associés. Selon l’ampleur du projet, la direction du laboratoire et des
          opérateurs formés participent aussi à la conception de l’étude, à la mesure et au traitement des données.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mb-px">

          <!-- Jan Petružálek -->
          <div class="bg-brand-white flex flex-col">
            <div class="border-b border-brand-black/10 aspect-[3/2] flex flex-col items-center justify-center text-center px-6" style="background-image: linear-gradient(rgba(10,10,10,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.06) 1px, transparent 1px); background-size: 20% 25%;">
              <p class="font-mono text-[10px] tracking-widest text-brand-black/40 mb-3">[ PORTRAIT EN PRÉPARATION ]</p>
              <p class="font-display text-lg md:text-xl font-bold text-brand-black/40 leading-snug max-w-xs">Jan Petružálek</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase mb-2" style="color:#2D62FC">RESPONSABLE DU LABORATOIRE FIMEYELAB · COPROPRIÉTAIRE DE UX MIND</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-4">Ing. Jan Petružálek, Ph.D.</h3>
              <p class="text-brand-black/60 leading-relaxed mb-6">
                Il conçoit la recherche, supervise le déroulement des mesures et répond de l’analyse et de
                l’interprétation des données. Dans sa thèse, il s’est consacré à la combinaison de méthodes
                de recherche UX avec l’eye tracking. Il publie dans le domaine de l’expérience utilisateur
                et de l’e-commerce.
              </p>
              <a href="https://www.linkedin.com/in/jan-petru%C5%BE%C3%A1lek-79167474/" target="_blank" rel="noopener noreferrer" class="mt-auto self-start inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                LINKEDIN ↗
              </a>
            </div>
          </div>

          <!-- Lukáš Koula -->
          <div class="bg-brand-white flex flex-col">
            <div class="border-b border-brand-black/10 aspect-[3/2] flex flex-col items-center justify-center text-center px-6" style="background-image: linear-gradient(rgba(10,10,10,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.06) 1px, transparent 1px); background-size: 20% 25%;">
              <p class="font-mono text-[10px] tracking-widest text-brand-black/40 mb-3">[ PORTRAIT EN PRÉPARATION ]</p>
              <p class="font-display text-lg md:text-xl font-bold text-brand-black/40 leading-snug max-w-xs">Lukáš Koula</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
