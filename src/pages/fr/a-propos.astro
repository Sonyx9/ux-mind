---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { localizedPath } from '../../i18n/utils';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const vrstvy = [
  {
    t: 'Attention visuelle',
    d: 'Où le regard se pose, dans quel ordre, combien de temps il y reste et ce qu’il manque totalement. Cartes de chaleur, zones d’intérêt, temps jusqu’à la première fixation, durée d’observation.',
    tag: 'EYE TRACKING',
  },
  {
    t: 'Émotions et activation',
    d: 'Ce qu’un questionnaire ne capte pas, parce que la personne ne le sait pas ou ne l’avoue pas. La conductance cutanée mesure la réaction physiologique, l’analyse des micro-expressions reconnaît l’expression du visage.',
    tag: 'GSR + EXPRESSIONS',
  },
  {
    t: 'Charge cognitive',
    d: 'L’effort que coûte l’utilisation d’une interface. La charge est le tueur silencieux de la conversion et de la clarté — l’utilisateur ne part pas en se disant « c’était compliqué », il part, tout simplement.',
    tag: 'EFFORT MENTAL',
  },
];

const vybaveni = [
  { nazev: 'Smart Eye Aurora', typ: 'eye tracking de bureau', k: 'Configuration actuelle pour les études contrôlées sur écran.' },
  { nazev: 'Tobii Pro X2-60', typ: 'eye tracking de bureau', k: 'Plateforme 60 Hz, ensemble portable pour les études axées sur la fixation.' },
  { nazev: 'Pupil Labs Neon (2×)', typ: 'lunettes mobiles', k: 'Mesure en environnement réel — magasin, stade, trafic, rue.' },
  { nazev: 'iMotions + analyse des expressions', typ: 'logiciel', k: 'Synchronisation de tous les signaux avec les stimuli et reconnaissance de l’expression du visage.' },
  { nazev: 'Shimmer3 GSR', typ: 'biométrie', k: 'Conductance cutanée — réaction physiologique et niveau d’activation.' },
];

const postup = [
  { num: '01', title: 'Conception de l’étude', desc: 'Question de recherche, définition des métriques, taille et structure de l’échantillon, scénarios de tâches.' },
  { num: '02', title: 'Collecte des données', desc: 'Protocole pour le laboratoire ou le terrain, calibration, stimuli, enregistrement simultané de tous les signaux.' },
  { num: '03', title: 'Analyse', desc: 'Métriques sur les zones d’intérêt, indicateurs temporels, mise en relation du regard et de la biométrie, statistiques.' },
  { num: '04', title: 'Transfert vers la pratique', desc: 'Recommandations priorisées, rapport avec méthodologie et atelier avec votre équipe.' },
];

const rizika = [
  'la dérive de la calibration au cours de la mesure',
  'la fatigue des participants',
  'l’effet d’ordre — d’où la randomisation et le contrebalancement',
  'une tâche formulée de façon ambiguë',
  'la surévaluation d’une seule métrique',
];

const etika = [
  'Protocole standardisé et test pilote avant chaque étude',
  'Consentement éclairé de chaque participant',
  'Traitement des données conforme au RGPD, généralement sous NDA',
  'Possibilité de données entièrement anonymisées et d’un rapport reproductible',
  'Pour les projets de recherche, évaluation par un comité d’éthique selon les besoins',
];

const tymLaboratore = [
  ['01', 'Direction de la recherche'],
  ['01', 'Chercheur senior'],
  ['01', 'Gestion du laboratoire'],
  ['02', 'Opérateurs seniors'],
  ['06', 'Opérateurs juniors'],
];

const pageSchema = [
  {
    '@type': 'ResearchOrganization',
    name: 'FIMEYELAB',
    description:
      'Laboratoire d’eye tracking et de biométrie de la Faculté d’informatique et de management de l’Université de Hradec Králové. Mesure de l’attention visuelle, de la réaction émotionnelle et de la charge cognitive en laboratoire comme sur le terrain.',
    parentOrganization: {
      '@type': 'CollegeOrUniversity',
      name: 'Univerzita Hradec Králové — Fakulta informatiky a managementu',
    },
  },
  {
    '@type': 'AboutPage',
    name: 'À propos — laboratoire FIMEYELAB',
    description:
      'UX MIND mesure au laboratoire FIMEYELAB de la FIM UHK. Cinq systèmes de mesure, huit publications scientifiques, deux thèses de doctorat soutenues.',
  },
];
---

<BaseLayout
  lang="fr"
  title="Laboratoire FIMEYELAB | Qui se cache derrière UX MIND"
  description="Nous ne mesurons pas en salle de réunion. UX MIND mesure au laboratoire FIMEYELAB de la Faculté d’informatique et de management de l’UHK — cinq systèmes de mesure, huit publications scientifiques, deux thèses de doctorat soutenues."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ À PROPOS / LABORATOIRE ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          UN LABORATOIRE,<br/>PAS UNE AGENCE<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl mb-4">
              Des agences UX, il en existe beaucoup. Des laboratoires qui mesurent le mouvement des yeux, la conductance
              cutanée et les expressions faciales en même temps — et qui ont à leur actif des publications dans des revues
              à comité de lecture — il y en a nettement moins.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              UX MIND mesure au laboratoire <strong class="text-brand-black">FIMEYELAB</strong> de la Faculté d’informatique
              et de management de l’Université de Hradec Králové. Ce n’est pas un ornement marketing : cela signifie un contrôle
              méthodologique, des instruments qu’une agence commerciale ne s’offre pas, et l’obligation de défendre chaque
              conclusion devant un relecteur.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href={localizedPath('fr', 'contact')} class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              PLANIFIER UNE VISITE →
            </a>
            <a href={localizedPath('fr', 'case-studies')} class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              ÉTUDES DE CAS
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['SYSTÈMES DE MESURE', '5'],
          ['PUBLICATIONS SCIENTIFIQUES', '8'],
          ['THÈSES SOUTENUES', '2'],
          ['NOUS MESURONS', 'Laboratoire et terrain'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight text-xl">{v}</p>
          </div>
        ))}
      </div>

      <!-- Foto laboratoře -->
      <div class="reveal mb-24 grid grid-cols-1 md:grid-cols-5 gap-8 items-start">
        <div class="md:col-span-2">
          <img
            src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
            alt="Participante lors d’une mesure sur un poste équipé d’un eye tracker au laboratoire FIMEYELAB"
            title="Mesure au laboratoire FIMEYELAB"
            width="1080" height="1920" loading="lazy" decoding="async"
            class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
          />
          <p class="font-mono text-[11px] text-brand-black/60 mt-2">
            Laboratoire FIMEYELAB, FIM UHK. Aucun rendu 3D, aucune photo d’illustration.
          </p>
        </div>
        <div class="md:col-span-3">
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CE QU’ON VOIT SUR CETTE PHOTO ]</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold leading-tight mb-6">
            Rien de tout cela n’est un décor<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-black/60 leading-relaxed mb-4">
            Sous l’écran se trouve la barre de l’eye tracker, qui capte le mouvement des yeux soixante fois par seconde.
            Au-dessus de l’écran, une caméra pour l’analyse des expressions faciales. La participante réalise une tâche
            donnée sur une vraie page — elle ne commente pas ce qui lui plaît.
          </p>
          <p class="text-brand-black/60 leading-relaxed">
            C’est exactement là qu’est la différence entre une mesure et un groupe de discussion. Nous ne demandons pas
            aux gens ce qu’ils pensent faire. Nous regardons ce qu’ils font réellement.
          </p>
        </div>
      </div>

      <!-- Jak to spolu souvisí -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-12">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ COMMENT TOUT CELA S’ARTICULE ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-8 max-w-3xl">
          Laboratoire universitaire, cadence commerciale<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <p class="font-mono text-xs tracking-widest mb-2" style="color:#2D62FC">LABORATOIRE</p>
            <p class="text-brand-black/60 leading-relaxed text-sm">
              FIMEYELAB appartient à l’Université de Hradec Králové. Il sert à la recherche, à l’enseignement et à
              l’encadrement de mémoires et de thèses — et maintient ainsi un niveau d’exigence méthodologique qu’une
              activité purement commerciale ne s’impose pas.
            </p>
          </div>
          <div>
            <p class="font-mono text-xs tracking-widest mb-2" style="color:#2D62FC">UX MIND</p>
            <p class="text-brand-black/60 leading-relaxed text-sm">
              Les missions commerciales au laboratoire passent toujours par UX MIND. Nous sommes le partenaire contractuel
              avec lequel vous signez la commande, recevez un délai, un prix et un livrable — et qui répond du résultat.
            </p>
          </div>
          <div>
            <p class="font-mono text-xs tracking-widest mb-2" style="color:#2D62FC">LE TRAIT D’UNION</p>
            <p class="text-brand-black/60 leading-relaxed text-sm">
              Jan Petružálek est à la fois responsable du laboratoire FIMEYELAB et copropriétaire de UX MIND. La méthodologie
              et l’exécution ne sont donc pas deux mondes qui se renvoient la balle par-dessus une clôture.
            </p>
          </div>
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Concrètement, cela ne signifie qu’une seule chose pour vous : vous obtenez une méthodologie académique sans les
          délais académiques. C’est ainsi que nous avons mesuré un portail carrière pour <strong class="text-brand-black">ŠKODA AUTO</strong>,
          la campagne d’un club de football et les pages produit de boutiques en ligne.
        </p>
      </div>

      <!-- Co umíme změřit -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CE QUE NOUS SAVONS MESURER ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Trois couches de ce qui se passe dans la tête de l’utilisateur<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {vrstvy.map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Les méthodes se contrôlent mutuellement. Quand l’eye tracking révèle une observation prolongée, la biométrie une
          activation accrue et le questionnaire le calme, nous savons qu’il se passe quelque chose — et nous savons où.
        </p>
      </div>

      <!-- Čím měříme -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ AVEC QUOI NOUS MESURONS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Cinq systèmes, un enregistrement synchronisé<span style="color:#2D62FC">.</span>
        </h2>
        <div class="border border-brand-black/10">
          {vybaveni.map(z => (
            <div class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-6 p-6 border-b border-brand-black/10 last:border-0">
              <div class="md:col-span-4">
                <p class="font-display text-lg font-bold leading-tight">{z.nazev}</p>
                <p class="font-mono text-[11px] text-brand-black/60 tracking-wide uppercase">{z.typ}</p>
              </div>
              <p class="md:col-span-8 text-sm text-brand-black/60 leading-relaxed">{z.k}</p>
            </div>
          ))}
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Deux paires de lunettes mobiles signifient que nous pouvons mesurer deux personnes en même temps — ou continuer
          pendant qu’un jeu est en charge. Sur le terrain, c’est la différence entre « nous avons réussi » et
          « nous reviendrons la prochaine fois ».
        </p>
      </div>

      <!-- Vizualizace laboratoře -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/laborator-ux-vyzkumu-vizualizace-1.webp`}
          alt="Visualisation de l’aménagement prévu du laboratoire FIMEYELAB"
          title="Aménagement prévu du laboratoire"
          width="1600" height="1127" loading="lazy" decoding="async"
          class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">
          Visualisation de l’aménagement prévu du laboratoire — des postes de mesure séparés pour des tests simultanés.
        </p>
      </div>

      <!-- Jak měření probíhá -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ COMMENT SE DÉROULE UNE MESURE ]</p>
          <div class="space-y-0">
            {postup.map(step => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ CE QUE NOUS SURVEILLONS DANS LE PROTOCOLE ]</p>
          <ul class="space-y-2 mb-6">
            {rizika.map(r => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {r}
              </li>
            ))}
          </ul>
          <p class="text-sm text-brand-black/60 leading-relaxed">
            Cette liste est la raison pour laquelle une mesure en laboratoire n’est pas la même chose que « nous avons lancé
            un enregistrement d’écran ». Chacun de ces cinq points peut retourner complètement le résultat, et ils ne peuvent
            se maîtriser qu’en amont.
          </p>
        </div>
      </div>

      <!-- Akademické zázemí -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ ASSISE ACADÉMIQUE ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Ce que vous n’obtiendrez pas d’une agence<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          <div class="bg-brand-white p-8">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">PUBLICATIONS</p>
            <p class="font-display text-5xl font-bold mb-2">8</p>
            <p class="text-sm text-brand-black/60 leading-relaxed mb-6">
              publications scientifiques consacrées à l’eye tracking.
            </p>
            <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-2">REVUE Q1 (2021–2025)</p>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Franěk, M., &amp; Petružálek, J. (2025). <em>Perceptual fluency and eye movements when viewing
              urban and natural scenes.</em> Scientific Reports, 15(1), art. 25772.
            </p>
          </div>
          <div class="bg-brand-white p-8">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">FORMATION ET RELÈVE</p>
            <ul class="space-y-3 text-sm text-brand-black/60 leading-relaxed">
              <li class="pb-3 border-b border-brand-black/5">
                <strong class="text-brand-black">2 thèses de doctorat soutenues</strong><br/>
                Jan Petružálek (2023) — Comparaison et combinaison de méthodes de mesure de l’expérience utilisateur
                à l’aide de la technologie d’eye tracking<br/>
                Denis Šefara (2022) — Tableaux de bord d’entreprise exploitant l’attention de l’utilisateur
              </li>
              <li class="pb-3 border-b border-brand-black/5">
                <strong class="text-brand-black">8 mémoires de master et de licence soutenus</strong><br/>
                2 de master, 6 de licence
              </li>
              <li>
                <strong class="text-brand-black">10 nouveaux sujets pour l’année 2025/2026</strong><br/>
                dont 5 consacrés à l’eye tracking
              </li>
            </ul>
          </div>
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Les étudiants ne sont pas une main-d’œuvre bon marché. Ils sont la raison pour laquelle le laboratoire teste sans
          cesse ses propres méthodes sur de nouveaux sujets — et pour laquelle on ne peut pas s’y installer confortablement
          sur une seule approche.
        </p>
      </div>

      <!-- Lidé -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ LES PERSONNES ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6 max-w-3xl">
          Nous dirigeons l’entreprise à deux. Les mesures, elles, ne se font pas à deux<span style="color:#2D62FC">.</span>
        </h2>
        <p class="text-brand-black/60 leading-relaxed max-w-3xl mb-10">
          UX MIND compte deux associés. Derrière la collecte et le traitement des données se tient l’équipe du laboratoire —
          direction de la recherche, gestion du laboratoire et opérateurs formés.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mb-px">

          <!-- Jan Petružálek -->
          <div class="bg-brand-white flex flex-col">
            <div class="border-b border-brand-black/10 aspect-[3/2] flex flex-col items-center justify-center text-center px-6" style="background-image: linear-gradient(rgba(10,10,10,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.06) 1px, transparent 1px); background-size: 20% 25%;">
              <p class="font-mono text-[10px] tracking-widest text-brand-black/40 mb-3">[ PHOTO EN PRÉPARATION ]</p>
              <p class="font-display text-lg md:text-xl font-bold text-brand-black/40 leading-snug max-w-xs">Nous mesurons où vous regardez. Sur nous-mêmes, nous n’avons pas encore tourné la caméra.</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase mb-2" style="color:#2D62FC">RESPONSABLE DU LABORATOIRE FIMEYELAB · COPROPRIÉTAIRE DE UX MIND</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-4">Ing. Jan Petružálek, Ph.D.</h3>
              <p class="text-brand-black/60 leading-relaxed mb-6">
                Il dirige le laboratoire et la recherche : il conçoit les expériences, veille à la rigueur méthodologique des
                mesures et répond de l’interprétation des données. Doctorat de la FIM UHK, thèse sur la combinaison de méthodes
                de mesure de l’expérience utilisateur avec l’eye tracking, publications dans le domaine de l’IHM et du e-commerce.
              </p>
              <a href="https://www.linkedin.com/in/jan-petru%C5%BE%C3%A1lek-79167474/" target="_blank" rel="noopener noreferrer" class="mt-auto self-start inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                LINKEDIN ↗
              </a>
            </div>
          </div>

          <!-- Lukáš Koula -->
          <div class="bg-brand-white flex flex-col">
            <div class="border-b border-brand-black/10 aspect-[3/2] flex flex-col items-center justify-center text-center px-6" style="background-image: linear-gradient(rgba(10,10,10,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.06) 1px, transparent 1px); background-size: 20% 25%;">
              <p class="font-mono text-[10px] tracking-widest text-brand-black/40 mb-3">[ PHOTO EN PRÉPARATION ]</p>
              <p class="font-display text-lg md:text-xl font-bold text-brand-black/40 leading-snug max-w-xs">Portrait en cours de réalisation. Promis — aucune photo d’illustration.</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase mb-2" style="color:#2D62FC">STRATÉGIE, WEB ET MARKETING · COPROPRIÉTAIRE DE UX MIND</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-4">Mgr. Lukáš Koula</h3>
              <p class="text-brand-black/60 leading-relaxed mb-6">
                Il traduit la recherche en pratique : à partir des constats du laboratoire, il conçoit des modifications
                concrètes de sites, de boutiques en ligne et de campagnes. Partenaire certifié Shoptet Partner et Google Partner.
                Il pilote les projets et la communication avec les clients.
              </p>
              <a href="https://www.linkedin.com/in/lukaskoula/" target="_blank" rel="noopener noreferrer" class="mt-auto self-start inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                LINKEDIN ↗
              </a>
            </div>
          </div>
        </div>

        <!-- Tým laboratoře -->
        <div class="border border-brand-black/10 p-8 md:p-10">
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ L’ÉQUIPE DU LABORATOIRE ]</p>
          <div class="border border-brand-black/10 divide-y divide-brand-black/10 mb-6">
            {tymLaboratore.map(([pocet, role]) => (
              <div class="flex items-center gap-4 md:gap-6 px-4 py-4 md:px-6">
                <p class="font-mono text-[11px] text-brand-black/70 tracking-wide uppercase leading-snug w-28 md:w-44 shrink-0">{role}</p>
                <div class="flex flex-wrap gap-1.5 flex-1 min-w-0">
                  {Array.from({ length: Number(pocet) }).map(() => (
                    <span class="w-3.5 h-3.5 bg-brand-black" aria-hidden="true"></span>
                  ))}
                </div>
                <p class="font-mono text-[11px] text-brand-black/40 tabular-nums shrink-0 w-6 text-right">{pocet}</p>
              </div>
            ))}
          </div>
          <p class="text-sm text-brand-black/60 leading-relaxed max-w-3xl">
            La collecte des données est réalisée par des opérateurs formés, selon un protocole. C’est ce qui garantit la
            reproductibilité — le résultat d’une mesure ne doit pas dépendre de qui est assis devant l’ordinateur.
          </p>
        </div>
      </div>

      <!-- Etika a data -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ ÉTHIQUE ET DONNÉES ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">
              Nous mesurons les yeux, la peau et l’expression du visage des gens<span style="color:#2D62FC">.</span>
            </h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Ce n’est pas une rubrique reléguée au pied de page. Sans un protocole solide et un consentement, chez nous, on ne
              mesure rien.
            </p>
          </div>
          <ul class="space-y-2">
            {etika.map(e => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5 last:border-0">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {e}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- CTA -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            ENVIE DE<br/>VENIR VOIR<span style="color:#2D62FC">?</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            Le laboratoire se visite. Nous vous montrons le matériel, lançons un véritable enregistrement de mesure et vous
            disons franchement si une mesure a du sens pour votre projet — ou si un outil moins cher vous suffira.
          </p>
          <a href={localizedPath('fr', 'contact')} class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
            PLANIFIER UNE VISITE →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
