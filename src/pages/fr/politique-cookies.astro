---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const updated = '28/07/2026';

const categories = [
  {
    name: 'Nécessaires',
    consent: 'Sans consentement',
    purpose: 'Fonctionnement de base du site — choix de la langue, sécurité et mémorisation de votre choix de cookies.',
    examples: 'uxmind-consent, uxmind_consent (stockage du consentement), cookies techniques du serveur',
    expiry: 'Session jusqu’à 6 mois',
  },
  {
    name: 'Analyse',
    consent: 'Uniquement avec votre consentement',
    purpose: 'Statistiques de fréquentation anonymes — combien de personnes visitent le site et quelles pages elles lisent. Elles nous aident à améliorer le site.',
    examples: 'Google Analytics 4 (_ga, _ga_*)',
    expiry: 'Jusqu’à 24 mois',
  },
  {
    name: 'Marketing',
    consent: 'Uniquement avec votre consentement',
    purpose: 'Remarketing et mesure de l’efficacité publicitaire — une publicité plus pertinente et mesurable.',
    examples: 'Google Ads (_gcl_*), cookies de conversion et de remarketing',
    expiry: 'Jusqu’à 24 mois',
  },
];
---

<BaseLayout
  lang="fr"
  title="Politique de cookies"
  description="Comment UX MIND utilise les cookies : nécessaires, d’analyse et de marketing. Consentement selon Google Consent Mode v2, le RGPD et la loi n° 127/2005 Rec. Modifiable à tout moment."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-3xl mx-auto px-6">

      <div class="mb-12">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ INFORMATIONS LÉGALES ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.25rem, 6vw, 4.5rem);">
          Politique cookies<span style="color:#2D62FC">.</span>
        </h1>
        <p class="text-sm text-brand-black/50 font-mono">Dernière mise à jour : {updated}</p>
      </div>

      <div class="space-y-10 text-brand-black/70 leading-relaxed">

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-3">Que sont les cookies</h2>
          <p>
            Les cookies sont de petits fichiers texte qu’un site enregistre dans votre navigateur. Ils assurent
            les fonctions de base du site, mesurent l’audience et soutiennent, le cas échéant, le marketing.
            Certains sont déposés par nous, d’autres par des services tiers (Google).
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-3">Comment nous recueillons le consentement</h2>
          <p class="mb-3">
            Lors de votre première visite, nous affichons un bandeau cookies. Les cookies nécessaires sont
            toujours actifs — ils sont indispensables au fonctionnement du site. Les cookies d’analyse et de
            marketing ne sont activés <strong class="text-brand-black">qu’après votre consentement</strong>.
            Le consentement est libre, granulaire et peut être modifié ou retiré à tout moment.
          </p>
          <p>
            Nous utilisons le <strong class="text-brand-black">Google Consent Mode v2</strong>. Jusqu’au
            consentement, aucun cookie d’analyse ou publicitaire n’est actif ; les balises Google fonctionnent
            en mode sans cookie, sans stockage d’identifiants. Nous agissons conformément au Règlement RGPD
            (UE) 2016/679 et au § 89 de la loi n° 127/2005 Rec. sur les communications électroniques.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-5">Catégories de cookies</h2>
          <div class="space-y-px bg-brand-black/10 border border-brand-black/10">
            {categories.map(c => (
              <div class="bg-brand-white p-5">
                <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2">
                  <h3 class="font-mono text-sm tracking-widest uppercase text-brand-black">{c.name}</h3>
                  <span class="font-mono text-[10px] tracking-widest uppercase" style="color:#2D62FC">{c.consent}</span>
                </div>
                <p class="text-sm mb-2">{c.purpose}</p>
                <dl class="text-xs text-brand-black/50 space-y-0.5">
                  <div><dt class="inline font-mono">Exemples : </dt><dd class="inline">{c.examples}</dd></div>
                  <div><dt class="inline font-mono">Durée : </dt><dd class="inline">{c.expiry}</dd></div>
                </dl>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-3">Modifier ou retirer le consentement</h2>
          <p class="mb-4">
            Vous pouvez modifier vos paramètres à tout moment — ouvrez le panneau et ajustez ou retirez votre
            consentement. Nous mémorisons votre choix pendant 6 mois, après quoi nous vous redemandons. Les
            cookies peuvent aussi être supprimés directement dans les paramètres de votre navigateur.
          </p>
          <button type="button" onclick="window.uxmindConsent && window.uxmindConsent.open()"
            class="inline-block font-mono text-xs tracking-widest uppercase bg-brand-black text-brand-white px-6 py-3 hover:bg-[#2D62FC] transition-colors">
            Ouvrir les paramètres cookies →
          </button>
        </section>

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-3">Tiers</h2>
          <p>
            Les cookies d’analyse et de marketing sont traités par Google (Google Analytics, Google Ads). Les
            conditions et le traitement des données sont décrits dans la
            <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="underline hover:text-brand-black">Politique de confidentialité de Google ↗</a>.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl font-bold text-brand-black mb-3">Responsable</h2>
          <p>
            UX MIND Research Lab s.r.o., n° d’identification : 29714966.<br/>
            Questions sur les cookies et les données personnelles :
            <a href="mailto:spoluprace@uxmind.cz" class="underline hover:text-brand-black">spoluprace@uxmind.cz</a>.
          </p>
        </section>

      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
