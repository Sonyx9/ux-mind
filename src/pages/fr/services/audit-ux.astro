---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const reveals = [
  { t: 'Obstacles dans le parcours', d: 'Où les utilisateurs perdent leurs repères, où ils se bloquent et ce qui les pousse à partir.', tag: 'PARCOURS' },
  { t: 'Problèmes connus', d: 'Les manquements aux principes d’utilisabilité éprouvés — avant que vos clients ne les découvrent.', tag: 'HEURISTIQUES' },
  { t: 'Quick wins', d: 'Des ajustements à fort impact et faible effort, déployables immédiatement.', tag: 'PRIORITÉS' },
];

const process = [
  { num: '01', title: 'Brief et périmètre', desc: 'Parcours clés, objectifs et contexte business du produit.' },
  { num: '02', title: 'Analyse heuristique', desc: 'Un passage systématique de l’interface selon des principes éprouvés.' },
  { num: '03', title: 'Analyse des parcours et des données', desc: 'Flux utilisateurs ; si vous disposez d’analytics, nous les intégrons.' },
  { num: '04', title: 'Rapport et atelier', desc: 'Recommandations priorisées et planification commune des ajustements.' },
];

const outputs = [
  'Liste des problèmes priorisée par impact',
  'Recommandations concrètes avec propositions de solutions',
  'Quick wins à déployer immédiatement',
  'Rapport final avec maquettes',
  'Atelier avec votre équipe',
];

const faq = [
  { q: 'Combien de temps dure un audit UX ?', a: 'Généralement 2–4 semaines selon l’étendue du produit : analyse initiale, évaluation heuristique, analyse des données et présentation des livrables.' },
  { q: 'En quoi l’audit diffère-t-il des tests utilisateurs ?', a: 'L’audit est une évaluation experte — un spécialiste examine l’interface selon des principes éprouvés, sans participants. Les tests observent de vrais utilisateurs accomplissant des tâches. L’audit est une première étape plus rapide et moins coûteuse, les tests vérifient le comportement en pratique.' },
  { q: 'Quand l’audit ne suffit-il pas ?', a: 'L’audit identifie des problèmes probables, mais ne démontre pas leur impact sur le comportement des utilisateurs ni sur la conversion. Si vous devez étayer vos décisions par des données, il est suivi d’une mesure — eye-tracking, tests utilisateurs ou biométrie.' },
  { q: 'De quoi avez-vous besoin de notre part ?', a: 'Un accès au produit (site, application, prototype), une description des parcours clés et des objectifs. Si vous disposez d’analytics, nous les intégrons à l’analyse.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Audit UX',
    description: 'Audit UX expert de site web, e-commerce ou application : analyse heuristique, analyse des parcours utilisateurs, recommandations priorisées et atelier. Le socle rapide de toute amélioration.',
    serviceType: 'Audit UX',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="fr"
  title="Audit UX de site web et e-commerce | Analyse experte d’utilisabilité"
  description="Audit UX de votre site, e-commerce ou application en 2–4 semaines. Analyse heuristique, analyse des parcours, recommandations priorisées et quick wins. Le socle rapide de toute amélioration."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICES / AUDIT UX ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          COMMENCEZ<br/>PAR L’AUDIT<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Le socle rapide de toute amélioration.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              Un spécialiste parcourt votre interface du point de vue de l’utilisateur et repère les obstacles avant
              que vos clients ne les trouvent. Le livrable est un <strong class="text-brand-black">plan d’ajustements priorisé</strong>, pas une simple liste d’erreurs.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="/fr/contact" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              DEMANDER UN AUDIT →
            </a>
            <a href="/fr/services/packs-de-test" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              PACKS DE TEST
            </a>
          </div>
        </div>
      </div>

      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURÉE', '2–4 semaines'],
          ['MÉTHODE', 'Évaluation experte'],
          ['PARTICIPANTS', 'Non requis'],
          ['PACK', 'Diagnostic rapide'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CE QUE L’AUDIT RÉVÈLE ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Les problèmes que les utilisateurs endurent en silence<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {reveals.map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Foto -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/jan-petruzalek-analyza-eye-tracking-dat.webp`}
          alt="Spécialiste analysant les données d’un audit UX et d’eye-tracking"
          title="Analyse de données lors d’un audit UX"
          width="1200" height="800" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">L’audit n’est pas une affaire d’impressions — chaque constat est étayé par un endroit précis de l’interface et par le principe qu’il enfreint.</p>
      </div>

      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ COMMENT SE DÉROULE L’AUDIT ]</p>
          <div class="space-y-0">
            {process.map(step => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ CE QUE VOUS RECEVREZ ]</p>
          <ul class="space-y-2">
            {outputs.map(o => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {o}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ LIMITES DE L’AUDIT ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">L’audit montre où, la mesure prouve pourquoi<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              L’évaluation experte identifie des problèmes probables, mais ne démontre pas leur impact sur le comportement et la conversion.
              Lorsque vous devez défendre une décision avec des données, l’audit est suivi d’eye-tracking, de tests utilisateurs ou de biométrie.
            </p>
          </div>
          <a href="/fr/services/packs-de-test" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            MESURES COMPLÉMENTAIRES →
          </a>
        </div>
      </div>

      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ QUESTIONS FRÉQUENTES ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            COMBIEN VOUS COÛTE<br/>VOTRE SITE <span style="color:#2D62FC">?</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            Envoyez-nous un lien. Sous quelques jours, nous vous dirons si un audit a du sens et ce que vous pouvez en attendre.
          </p>
          <a href="/fr/contact" class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
            DEMANDER UN AUDIT →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
