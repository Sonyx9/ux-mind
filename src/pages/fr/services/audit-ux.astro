---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const reveals = [
  { t: 'Obstacles dans le parcours', d: 'Les étapes où il peut être difficile de s’orienter, de continuer ou de trouver la bonne information.', tag: 'PARCOURS UTILISATEUR' },
  { t: 'Interface peu claire', d: 'Des libellés incompréhensibles, une hiérarchie visuelle faible et des éléments dont on ne sait pas ce qu’ils font.', tag: 'CLARTÉ' },
  { t: 'Priorités des correctifs', d: 'Des problèmes classés par impact et par effort, pour savoir clairement quoi traiter en premier.', tag: 'PROCHAINES ÉTAPES' },
];

const process = [
  { num: '01', title: 'Objectif et périmètre', desc: 'Nous choisissons les pages clés, les parcours utilisateurs et les objectifs de l’audit.' },
  { num: '02', title: 'Contrôle expert', desc: 'Nous vérifions la navigation, le contenu, la hiérarchie et la clarté de l’interface.' },
  { num: '03', title: 'Contexte et données', desc: 'Nous replaçons les constats dans le contexte du produit et intégrons l’analytics disponible.' },
  { num: '04', title: 'Recommandations et remise', desc: 'Nous classons les problèmes par importance et passons ensemble en revue les prochaines étapes.' },
];

const outputs = [
  { title: 'Aperçu des problèmes', desc: 'Nous relions chaque constat à un endroit précis de l’interface et expliquons son impact.' },
  { title: 'Priorités selon l’impact', desc: 'Nous distinguons ce qu’il faut traiter immédiatement, ce qui peut attendre et ce qui n’est pas encore prioritaire.' },
  { title: 'Propositions concrètes de correctifs', desc: 'Nous recommandons comment résoudre le problème. Pour certains endroits, nous ajoutons une proposition ou un exemple de solution.' },
  { title: 'Remise commune des résultats', desc: 'Nous passons les conclusions en revue avec votre équipe, pour que leur mise en pratique soit claire.' },
];

const faq = [
  { q: 'Que comprend un audit UX ?', a: 'Nous vérifions les pages clés et les parcours utilisateurs, la navigation, le contenu, la hiérarchie visuelle et la clarté de l’interface. Le livrable est un aperçu des problèmes, leurs priorités et des recommandations concrètes de correctifs.' },
  { q: 'Combien de temps dure un audit UX ?', a: 'Le plus souvent 2 à 4 semaines selon l’étendue du produit et le nombre de parcours examinés. Nous précisons le délai après un bref brief initial.' },
  { q: 'Combien coûte un audit UX ?', a: 'Le prix dépend de l’étendue du produit, du nombre de parcours clés et de la forme souhaitée du livrable. Après avoir pris connaissance du brief, nous préparons une offre concrète, sans frais cachés.' },
  { q: 'En quoi l’audit UX diffère-t-il des tests utilisateurs ?', a: 'L’audit UX est un contrôle expert de l’interface, sans participants. Les tests utilisateurs observent de vrais utilisateurs accomplissant des tâches et vérifient comment les problèmes se manifestent en pratique.' },
  { q: 'Peut-on aussi auditer une boutique en ligne, une application ou un prototype ?', a: 'Oui. Nous auditons des sites, des boutiques en ligne, des applications et des prototypes suffisamment aboutis. Nous adaptons toujours l’étendue à la phase du produit et à la décision que vous devez prendre.' },
  { q: 'De quoi avez-vous besoin pour démarrer l’audit ?', a: 'D’un accès au produit ou au prototype, d’une description des utilisateurs cibles et des tâches clés qu’ils doivent accomplir. Si vous disposez d’analytics web ou d’une recherche antérieure, nous pouvons les intégrer comme contexte supplémentaire.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Audit UX',
    description: 'Audit UX expert de site, boutique en ligne ou application : analyse heuristique, analyse des parcours utilisateurs, recommandations priorisées et atelier. Le socle rapide de toute amélioration.',
    serviceType: 'Audit UX',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="fr"
  title="Audit UX de site et de boutique en ligne | Analyse experte de l’utilisabilité"
  description="Audit UX de votre site, boutique en ligne ou application en 2 à 4 semaines. Analyse heuristique, analyse des parcours, recommandations priorisées et quick wins. Le socle rapide de toute amélioration."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICES / AUDIT UX ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          RÉVÉLEZ<br/>LES POINTS FAIBLES<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-3xl">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Audit UX de site, de boutique en ligne ou d’application.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify mb-4">
              Nous parcourons les pages clés et les parcours utilisateurs. Nous vérifions la navigation, la clarté
              du contenu, la hiérarchie visuelle et les obstacles à l’accomplissement des tâches importantes.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify">
              Vous recevez des recommandations concrètes classées par impact et par effort, pour savoir <strong class="text-brand-black">quoi corriger en premier</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/fr/contact" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              DEMANDER UN AUDIT →
            </a>
            <a href="/fr/services#packs-de-test" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              VOIR LES PACKS
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURÉE', '2–4 semaines'],
          ['MÉTHODE', 'Évaluation experte'],
          ['PARTICIPANTS', 'Non nécessaires'],
          ['PACK', 'Audit UX rapide'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Co audit odhalí -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CE QUE L’AUDIT UX RÉVÈLE ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Ce qui complique inutilement l’accomplissement d’une tâche<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {reveals.map((v, i) => (
            <div class="bg-brand-white p-8 flex flex-col h-full">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed text-justify mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest self-start mt-auto">{v.tag}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Foto -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/jan-petruzalek-analyza-eye-tracking-dat.webp`}
          alt="Spécialiste analysant les données d’un audit UX et d’eye-tracking"
          title="Analyse de données lors d’un audit UX"
          width="1200" height="800" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">L’audit n’est pas une affaire d’impressions — chaque constat est étayé par un endroit précis de l’interface et par le principe qu’il enfreint.</p>
      </div>

      <!-- Proces -->
      <div class="reveal mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ COMMENT SE DÉROULE L’AUDIT ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Quatre étapes du brief aux recommandations<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
          {process.map(step => (
            <div class="border-t border-brand-black/20 pt-5">
              <span class="block font-mono text-xs text-brand-black/60 mb-5">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Výstup -->
      <div class="reveal mb-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.35fr] gap-10 lg:gap-16">
          <div>
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ CE QUE VOUS RECEVREZ ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              Un plan clair de ce qu’il faut corriger en premier<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <div class="border-t border-brand-white/20">
            {outputs.map((output, i) => (
              <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_12rem_1fr] gap-x-4 gap-y-2 py-5 border-b border-brand-white/20">
                <span class="font-mono text-xs text-brand-white/50 pt-1">0{i + 1}</span>
                <h3 class="font-display text-lg font-bold leading-tight">{output.title}</h3>
                <p class="col-start-2 sm:col-start-3 text-sm text-brand-white/65 leading-relaxed">{output.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Kdy audit stačí a kdy testovat -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ QUAND L’AUDIT SUFFIT ET QUAND TESTER ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">L’audit révèle les points faibles. Les tests en vérifient l’impact<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              L’audit UX est adapté quand vous devez rapidement identifier des problèmes et obtenir un plan
              d’ajustements concret. Si vous voulez vérifier comment les utilisateurs se comportent réellement
              dans l’interface et quels obstacles ont le plus d’impact, nous enchaînons avec des tests utilisateurs
              ou de l’eye tracking.
            </p>
          </div>
          <a href="/fr/services/packs-de-test" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            VOIR LES OPTIONS DE TEST →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ QUESTIONS FRÉQUENTES ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
