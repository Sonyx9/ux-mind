---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const attentionSignals = [
  { title: 'Ce que les gens voient en premier', desc: 'Nous mesurons quel élément capte le premier regard et dans quel ordre les gens parcourent le contenu.' },
  { title: 'Ce qui passe inaperçu', desc: 'Nous révélons les informations importantes, les offres ou les éléments de contrôle que le regard n’atteint jamais.' },
  { title: 'Où les gens cherchent et reviennent', desc: 'Les regards répétés et les recherches prolongées montrent les endroits où la hiérarchie visuelle ne guide pas suffisamment clairement l’utilisateur.' },
  { title: 'Quelle variante fonctionne le mieux', desc: 'Nous comparons les maquettes selon les mêmes métriques et montrons quelle variante oriente le mieux l’attention vers le contenu important.' },
];

const outputs = [
  { title: 'Heatmaps et enregistrement du regard', desc: 'Ils montrent clairement la répartition de l’attention ainsi que le trajet oculaire d’un participant donné.' },
  { title: 'Métriques des zones observées', desc: 'Pour les éléments importants, nous mesurons la première fixation, le nombre de retours et le temps d’attention accordé.' },
  { title: 'Liens avec la tâche', desc: 'Nous relions le regard à la réussite, au temps, aux erreurs et aux témoignages des participants.' },
  { title: 'Priorités et recommandations', desc: 'Nous traduisons les résultats en ajustements concrets du contenu, de la mise en page et de la hiérarchie visuelle.' },
];

const steps = [
  { num: '01', title: 'Question de recherche', desc: 'Nous clarifions la décision que les données doivent soutenir et choisissons l’étendue adaptée de l’étude.' },
  { num: '02', title: 'Scénario et pilote', desc: 'Nous préparons les tâches, les zones observées et vérifions avant la collecte que la mesure fonctionne correctement.' },
  { num: '03', title: 'Collecte des données', desc: 'Nous réalisons la calibration et la mesure en laboratoire ou sur le terrain selon un protocole unifié.' },
  { num: '04', title: 'Analyse et recommandations', desc: 'Nous relions le regard au contexte de la tâche et traduisons les résultats en priorités pour la pratique.' },
];

const technology = [
  { name: 'Smart Eye Aurora', type: 'MESURE EN LABORATOIRE', desc: 'Eye tracker de bureau pour des études contrôlées de sites, d’applications et d’autres interfaces numériques.' },
  { name: 'Tobii Pro X2-60', type: 'ENSEMBLE PORTABLE', desc: 'Eye tracker à 60 Hz pour la mesure sur écran et la comparaison de variantes.' },
  { name: 'Pupil Labs Neon (2×)', type: 'LUNETTES MOBILES', desc: 'Deux ensembles pour suivre l’attention en magasin, en showroom, dans un stade ou en circulation.' },
];

const studies = [
  { href: '/fr/etudes-de-cas/bannieres-direction-regard', result: 'L’attention a suivi le regard', title: 'Là où regarde le personnage de la bannière, le client regarde aussi.', meta: 'EYE TRACKING · N = 104' },
  { href: '/fr/etudes-de-cas/photographie-produit-e-commerce', result: 'La photo a ralenti la décision', title: 'La photo lifestyle semblait plus attrayante, mais elle a rallongé la tâche d’achat.', meta: 'EYE TRACKING + UEQ · N = 84' },
  { href: '/fr/etudes-de-cas/panneaux-sport-marketing', result: 'Comparaison de 16 maquettes', title: 'Plutôt qu’un vote, nous avons comparé les panneaux sur 79 personnes.', meta: 'EYE TRACKING + QUESTIONNAIRE · N = 79' },
];

const faq = [
  { q: 'Qu’est-ce que l’eye tracking et comment ça fonctionne ?', a: 'À l’aide d’une caméra spécialisée, l’eye tracking enregistre où une personne regarde, dans quel ordre et pendant combien de temps. À partir du mouvement des yeux, nous créons un enregistrement du regard et des métriques d’attention visuelle.' },
  { q: 'Que peut-on découvrir grâce à l’eye tracking ?', a: 'Nous découvrons ce que les gens remarquent en premier, quels éléments ils négligent, où ils cherchent et comment l’attention change entre les variantes. Nous évaluons toujours le résultat dans le contexte d’une tâche précise.' },
  { q: 'Quelle est la différence entre l’eye tracking et une heatmap issue de l’analytics web ?', a: 'Une heatmap analytique repose généralement sur les clics ou le mouvement du curseur. L’eye tracking enregistre la direction réelle du regard du participant. Mais une heatmap oculaire seule ne suffit pas non plus, c’est pourquoi nous la complétons par d’autres métriques et le déroulement de la tâche.' },
  { q: 'Combien de participants faut-il pour l’eye tracking ?', a: 'Le nombre dépend de l’objectif de l’étude, du nombre de groupes cibles et du fait que nous recherchions des problèmes qualitatifs ou que nous comparions des variantes. Nous proposons l’échantillon adapté selon la question de recherche ; il n’existe pas de chiffre universel.' },
  { q: 'Combien de temps dure une étude d’eye tracking et combien coûte-t-elle ?', a: 'Une étude type dure environ 1 à 3 semaines. Le prix dépend du nombre de participants, de l’environnement, de l’étendue des stimuli et des livrables demandés. Après un brief initial, nous préparons une proposition concrète ainsi que le prix.' },
  { q: 'La mesure doit-elle avoir lieu en laboratoire ?', a: 'Non. Nous mesurons le plus souvent les sites, applications et visuels sur écran en laboratoire. Pour les magasins, services, événements ou autres environnements réels, nous utilisons des lunettes d’eye-tracking mobiles.' },
  { q: 'L’eye tracking mesure-t-il les émotions ou la charge mentale ?', a: 'L’eye tracking seul mesure l’attention visuelle, pas des émotions précises. Selon l’objectif de l’étude, nous pouvons le compléter par des méthodes biométriques et par EMLI, notre indice complémentaire de charge mentale dérivé de métriques oculaires sélectionnées.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Eye tracking et tests utilisateurs',
    description: 'Mesure de l’attention visuelle par eye tracking : heatmaps, analyse AOI, enregistrements du regard et tests utilisateurs de sites, applications et supports imprimés.',
    serviceType: 'Eye tracking',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="fr"
  title="Eye tracking et heatmaps d’attention"
  description="Eye tracking de sites, applications et supports imprimés : heatmaps, analyse AOI, enregistrements du regard et tests utilisateurs au laboratoire de la FIM UHK. Découvrez ce que les utilisateurs voient réellement."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICES / EYE TRACKING ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          MESUREZ<br/>L’ATTENTION<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-3xl">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Découvrez ce que les gens voient réellement.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify mb-4">
              L’eye tracking enregistre où les gens regardent en utilisant un site, une application ou un visuel,
              dans quel ordre et pendant combien de temps. Il révèle les éléments qui attirent l’attention, ainsi
              que les informations importantes qui passent inaperçues.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify">
              Nous relions les données au déroulement de la tâche et les traduisons en <strong class="text-brand-black">recommandations concrètes pour le contenu, la mise en page et la hiérarchie visuelle</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/fr/contact" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              DEMANDER UN EYE TRACKING →
            </a>
            <a href="/fr/services#packs-de-test" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              VOIR LES PACKS
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURÉE', '1–3 semaines'],
          ['ENVIRONNEMENT', 'Laboratoire et terrain'],
          ['LIVRABLES', 'Heatmaps · AOI · gaze plots'],
          ['PACK', 'Eye tracking et biométrie'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Foto z měření -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
          alt="Participante lors d’une mesure d’eye-tracking en laboratoire — elle observe le stimulus testé sur un écran équipé d’un eye-tracker"
          title="Déroulement d’une mesure d’eye-tracking en laboratoire"
          width="1080" height="1920" loading="lazy" decoding="async"
          class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Une étude d’eye-tracking contrôlée en laboratoire — chaque enregistrement commence par une calibration et se déroule selon un scénario préparé à l’avance.</p>
      </div>

      <!-- Co dokážeme změřit -->
      <div class="reveal mb-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.35fr] gap-10 lg:gap-16">
          <div>
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ CE QUE NOUS POUVONS MESURER ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              L’attention n’est pas une impression. C’est une trace de données<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <div class="border-t border-brand-white/20">
            {attentionSignals.map((signal, i) => (
              <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_13rem_1fr] gap-x-4 gap-y-2 py-6 border-b border-brand-white/20">
                <span class="font-mono text-xs text-brand-white/50 pt-1">0{i + 1}</span>
                <h3 class="font-display text-lg font-bold leading-tight">{signal.title}</h3>
                <p class="col-start-2 sm:col-start-3 text-sm text-brand-white/65 leading-relaxed">{signal.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Výstupy -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-16">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CE QUE VOUS RECEVREZ ]</p>
          <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight max-w-xl">
            Pas seulement une heatmap. Des bases pour décider<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-black/60 leading-relaxed mt-6 max-w-xl text-justify">
            Une simple image avec des zones colorées ne suffit pas. Nous interprétons chaque livrable selon la tâche,
            le comparons au comportement des participants et le traduisons en changements applicables en pratique.
          </p>
        </div>
        <div class="border-t border-brand-black/20">
          {outputs.map((output, i) => (
            <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_13rem_1fr] gap-x-4 gap-y-2 py-6 border-b border-brand-black/20">
              <span class="font-mono text-xs text-brand-black/50 pt-1">0{i + 1}</span>
              <h3 class="font-display text-lg font-bold leading-tight">{output.title}</h3>
              <p class="col-start-2 sm:col-start-3 text-sm text-brand-black/60 leading-relaxed">{output.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Proces -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ COMMENT SE DÉROULE LA MESURE ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          De la question à une conclusion défendable<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
          {steps.map(step => (
            <div class="border-t border-brand-black/20 pt-5">
              <span class="block font-mono text-xs text-brand-black/60 mb-5">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Technologie -->
      <div class="reveal mb-24 border border-brand-black/15 p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.75fr_1.4fr] gap-10 lg:gap-16 mb-10">
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ INFRASTRUCTURE TECHNOLOGIQUE ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              Laboratoire et terrain<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <p class="text-brand-black/60 leading-relaxed text-justify max-w-2xl">
            Nous choisissons l’équipement selon l’environnement et la question de recherche. Nous utilisons des
            systèmes de bureau pour des études précisément contrôlées sur écran, et des lunettes mobiles pour
            mesurer l’attention pendant un déplacement réel et une prise de décision dans l’espace.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-10">
          {technology.map(tool => (
            <div class="border-t border-brand-black/20 pt-5">
              <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-4">{tool.type}</p>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{tool.name}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{tool.desc}</p>
            </div>
          ))}
        </div>
        <p class="font-mono text-[11px] text-brand-black/60 tracking-wide mt-10 pt-5 border-t border-brand-black/10">
          Assise de recherche FIMEYELAB · Faculté d’informatique et de management de l’Univerzita Hradec Králové
        </p>
      </div>

      <!-- EMLI -->
      <div class="reveal mb-24 border border-brand-black/15 p-8 md:p-12">
        <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1.6fr)_minmax(240px,1fr)] md:items-center gap-10 md:gap-16">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ EN COMPLÉMENT : INDICE DE CHARGE MENTALE EMLI ]</p>
            <h2 class="font-display text-2xl md:text-4xl font-bold mb-4">Où l’interface exige le plus d’effort<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed text-justify mb-4">
              EMLI convertit des indicateurs sélectionnés issus de l’eye tracking en un score de 0 à 100. Il permet
              de comparer des écrans, des étapes ou des variantes et de déterminer où le traitement de l’information
              est plus exigeant.
            </p>
            <p class="text-sm text-brand-black/60 leading-relaxed text-justify">
              <strong class="text-brand-black">Plus le score est élevé, plus la charge est grande.</strong> Nous validons
              EMLI en continu et l’utilisons comme couche d’interprétation complémentaire, pas comme preuve autonome.
            </p>
          </div>
          <div aria-label="Échelle EMLI, de la charge mentale la plus faible à la plus élevée">
            <div class="h-2 mb-4 bg-gradient-to-r from-brand-black/10 via-brand-blue/50 to-brand-blue" aria-hidden="true"></div>
            <div class="flex items-start justify-between gap-6 font-mono text-[10px] tracking-widest uppercase">
              <p><strong class="block font-display text-4xl leading-none mb-2" style="color:#2D62FC">0</strong>Charge plus faible</p>
              <p class="text-right"><strong class="block font-display text-4xl leading-none mb-2" style="color:#2D62FC">100</strong>Charge plus élevée</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Studie -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ L’EYE TRACKING EN PRATIQUE ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Des décisions étayées par la mesure<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {studies.map(study => (
            <a href={study.href} class="group border border-brand-black/15 p-7 min-h-72 flex flex-col hover:bg-brand-black hover:text-brand-white transition-colors">
              <p class="font-display text-xl font-bold leading-tight mb-6" style="color:#2D62FC">{study.result}</p>
              <h3 class="font-display text-2xl font-bold leading-tight mb-8">{study.title}</h3>
              <div class="mt-auto">
                <p class="font-mono text-[10px] tracking-widest opacity-60 mb-4">{study.meta}</p>
                <span class="font-mono text-xs tracking-widest">VOIR L’ÉTUDE →</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ QUESTIONS FRÉQUENTES ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
