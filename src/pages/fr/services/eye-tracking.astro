---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const faq = [
  { q: "Combien de participants faut-il pour une étude d'eye tracking ?", a: "Pour des insights qualitatifs, 8–12 participants par segment suffisent. Pour des métriques quantitatives (heatmaps, statistiques AOI), nous recommandons 30 participants et plus, et pour le calcul de l'indice de charge cognitive EMLI, nous travaillons avec des échantillons de plus de 100 participants." },
  { q: "Combien de temps durent les tests d'eye tracking ?", a: "Un projet type dure 1–3 semaines à partir de la validation du scénario : préparation et pilote, collecte des données en laboratoire ou sur le terrain, analyse et rapport avec recommandations priorisées." },
  { q: "L'eye tracking, est-ce la même chose que le neuromarketing ?", a: "Non. L'eye tracking est un enregistrement objectif de l'attention visuelle — nous ne promettons ni « lecture des pensées » ni lecture des émotions. Nous interprétons toujours les données dans le contexte de la tâche et avec les limites de la méthode clairement décrites." },
  { q: "Que montre une heatmap et que ne puis-je pas en déduire ?", a: "Une heatmap agrège les endroits que les participants ont le plus regardés. Mais elle ne dit pas à quel point l'interface leur a été exigeante — c'est pourquoi nous la complétons par des métriques AOI (TTFF, dwell time) et par l'indice de charge cognitive EMLI." },
];

const steps = [
  { num: '01', title: 'Préparation', desc: 'Scénarios de test selon vos objectifs et définition des AOI (Areas of Interest).' },
  { num: '02', title: 'Tests', desc: 'Les utilisateurs interagissent avec le produit, l’eye tracker enregistre le regard.' },
  { num: '03', title: 'Analyse', desc: 'Heatmaps, gaze plots et statistiques AOI à partir des données collectées.' },
  { num: '04', title: 'Recommandations', desc: 'Des ajustements concrets de la mise en page et de la hiérarchie du contenu.' },
];

const usecases = [
  { t: 'Sites web', d: 'Où les utilisateurs passent leur temps, ce qu’ils ignorent et pourquoi ils ne réagissent pas à vos CTA.', tag: 'WEB' },
  { t: 'Applications mobiles', d: 'Navigation, lisibilité et utilisabilité des produits mobiles.', tag: 'APP' },
  { t: 'E-commerce', d: 'Fiches produit, panier et checkout pour de meilleures conversions.', tag: 'E-SHOP' },
  { t: 'Supports imprimés', d: 'Bannières, affiches, packagings — ce qui attire l’attention sur les supports physiques.', tag: 'PRINT' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: "Eye tracking et tests utilisateurs",
    description: "Mesure de l'attention visuelle par eye tracking : heatmaps, analyse AOI, enregistrements du regard et tests utilisateurs de sites, applications et supports imprimés.",
    serviceType: 'Eye tracking',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="fr"
  title="Eye tracking et heatmaps d’attention"
  description="Eye tracking de sites, applications et supports imprimés : heatmaps, analyse AOI, enregistrements du regard et tests utilisateurs au laboratoire de la FIM UHK. Découvrez ce que vos utilisateurs voient réellement."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICES / EYE TRACKING ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          NOUS VOYONS CE QUE<br/>VOUS NE VOYEZ PAS<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Un enregistrement objectif de l’attention visuelle.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              L’eye tracking fournit des données précises sur la façon dont les utilisateurs perçoivent vos contenus.
              Nous savons <strong class="text-brand-black">où ils regardent, ce qu’ils manquent et ce qui capte leur attention</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="/fr/contact" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              PLANIFIER DES TESTS →
            </a>
            <a href="/fr/services/packs-de-test" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              PACKS DE TEST
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURÉE', '1–3 semaines'],
          ['TECHNOLOGIE', 'Tobii Pro · Smart Eye'],
          ['LIVRABLES', 'Heatmaps · AOI · gaze plots'],
          ['PACK', 'Test UX standard'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Foto z měření -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
          alt="Participante lors d’une mesure d’eye-tracking en laboratoire — elle observe le stimulus testé sur un écran équipé d’un eye-tracker"
          title="Déroulement d’une mesure d’eye-tracking en laboratoire"
          width="1080" height="1920" loading="lazy" decoding="async"
          class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Collecte de données d’attention visuelle en laboratoire — l’enregistrement du regard est conservé pour l’analyse AOI et les heatmaps.</p>
      </div>

      <!-- Kde pomůžeme -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ OÙ NOUS POUVONS AIDER ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Écran, papier et rayonnage<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
          {usecases.map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-xl font-bold mb-3 leading-tight">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-sm text-brand-black/60 leading-relaxed mt-4">
          Hors laboratoire, nous mesurons avec des lunettes mobiles — voir <a href="/fr/services/recherche-terrain" class="underline hover:no-underline">recherche terrain</a>.
        </p>
      </div>

      <!-- Jak to funguje + EMLI -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ COMMENT ÇA FONCTIONNE ]</p>
          <div class="space-y-0">
            {steps.map(step => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="border border-brand-black/10 p-8 flex flex-col justify-between">
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ EN PLUS : INDICE EMLI ]</p>
            <h3 class="font-display text-2xl font-bold mb-3">Regard + charge en un seul score<span style="color:#2D62FC">.</span></h3>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              À partir des métriques d’eye-tracking, nous composons l’indice de charge mentale EMLI (0–100).
              Vous comparez quelles variantes ou étapes coûtent le plus d’effort aux utilisateurs.
            </p>
          </div>
          <p class="font-display font-bold leading-none mt-6" style="font-size: clamp(2.5rem, 5vw, 4rem); color:#2D62FC;">0–100</p>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ QUESTIONS FRÉQUENTES ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            QUE VOIENT VOS<br/>UTILISATEURS <span style="color:#2D62FC">?</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            Envoyez-nous votre site, votre application ou votre création. Nous proposerons un scénario de mesure et vous dirons ce qu’il permettra de conclure en toute fiabilité.
          </p>
          <a href="/fr/contact" class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
            PLANIFIER DES TESTS →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
