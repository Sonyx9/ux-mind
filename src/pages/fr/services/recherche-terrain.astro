---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const contexts = [
  { t: 'Retail et points de vente', d: 'Orientation dans l’espace, product placement, signalétique, supports POS et zones de rayonnage.', tag: 'IN-STORE' },
  { t: 'Showrooms et événements', d: 'Ce que les visiteurs remarquent, où ils s’arrêtent et ce qui les amène à interagir.', tag: 'ESPACE' },
  { t: 'Automobile et HMI', d: 'L’attention lors de l’utilisation d’une interface dans un véhicule ou face à un produit physique.', tag: 'HMI' },
];

const findings = [
  'Comment les gens parcourent réellement l’espace — pas comme vous pensez qu’ils le parcourent',
  'Ce qu’ils remarquent, ce qu’ils manquent et où ils s’arrêtent',
  'Si la signalétique et la communication guident l’attention vers l’objectif',
  'Où l’environnement soutient la décision et où il la complique',
  'Comment le comportement varie selon le type de client ou la situation',
];

const process = [
  { num: '01', title: 'Brief et reconnaissance', desc: 'Ce qui doit être décidé et où la mesure aura lieu.' },
  { num: '02', title: 'Scénario et pilote', desc: 'Itinéraires, tâches et protocole technique vérifiés par un pilote sur place.' },
  { num: '03', title: 'Mesure sur le terrain', desc: 'Lunettes d’eye-tracking mobiles, enregistrement vidéo, GSR et entretiens selon les besoins.' },
  { num: '04', title: 'Analyse et recommandations', desc: 'Cartographie des moments clés et propositions d’ajustements de l’espace ou de la communication.' },
];

const faq = [
  { q: 'Comment la mesure terrain se déroule-t-elle techniquement ?', a: 'Le participant porte de légères lunettes d’eye-tracking Pupil Labs NEON, qui enregistrent le regard ainsi que la scène devant lui. Selon les besoins, nous ajoutons un bracelet GSR, un enregistrement vidéo de la situation et des entretiens après le parcours.' },
  { q: 'En quoi diffère-t-elle d’une mesure en laboratoire ?', a: 'Le terrain offre un comportement plus naturel, mais un contrôle moindre des conditions — éclairage, affluence, autres clients. C’est pourquoi nous déterminons à l’avance quelles conclusions peuvent être tirées en toute fiabilité de la mesure terrain et lesquelles méritent une vérification plus contrôlée.' },
  { q: 'Les lunettes ne perturbent-elles pas le comportement naturel ?', a: 'Les lunettes modernes ressemblent à des lunettes ordinaires et les participants les oublient généralement au bout de quelques minutes. Nous évaluons donc les premières minutes d’enregistrement avec prudence.' },
  { q: 'Faut-il l’accord du magasin ou des visiteurs ?', a: 'Oui, nous coordonnons toujours la mesure avec l’exploitant de l’espace et les participants signent un consentement éclairé. Les personnes en arrière-plan de l’enregistrement sont anonymisées.' },
  { q: 'Où pouvez-vous mesurer ?', a: 'Dans les points de vente, showrooms, événements, environnements de travail et véhicules. La limite n’est pas la technologie, mais la sécurité et l’accord avec l’exploitant.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Recherche terrain',
    description: 'Recherche UX terrain avec lunettes d’eye-tracking mobiles Pupil Labs NEON : points de vente, showrooms, événements, automobile et HMI. Attention et comportement en environnement réel.',
    serviceType: 'Eye-tracking terrain',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="fr"
  title="Recherche terrain | Eye-tracking mobile en magasin et showroom"
  description="Recherche UX terrain avec lunettes d’eye-tracking mobiles : points de vente, showrooms, événements, automobile. Découvrez ce que vos clients remarquent en environnement réel."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICES / RECHERCHE TERRAIN ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          AU-DELÀ<br/>DE L’ÉCRAN<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Nous mesurons là où le client décide réellement.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              En magasin, en showroom, lors d’un événement ou face à un produit physique. Les lunettes d’eye-tracking mobiles
              capturent l’attention en environnement réel — <strong class="text-brand-black">un équipement que peu d’acteurs possèdent en République tchèque</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="/fr/contact" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              DEMANDER UNE MESURE →
            </a>
            <a href="/fr/services/packs-de-test" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              PACKS DE TEST
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURÉE', '2–6 semaines'],
          ['TECHNOLOGIE', 'Pupil Labs NEON'],
          ['COMPLÉMENTS', 'GSR · vidéo · entretiens'],
          ['PACK', 'Étude terrain'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Kde měříme -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ OÙ NOUS MESURONS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Le parcours client ne s’arrête pas au site web<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {contexts.map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="reveal mb-24">
        <img
          src={`${base}/images/laborator-ux-vyzkumu-vizualizace-2.webp`}
          alt="Infrastructure de recherche UXMIND — c’est d’ici que nous partons sur le terrain avec l’eye-tracking mobile"
          title="Infrastructure de recherche pour les mesures terrain"
          width="1200" height="800" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Les locaux du laboratoire de la FIM UHK — calibration et préparation du matériel avant le départ sur le terrain.</p>
      </div>

      <!-- Co zjistíte + proces -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ CE QUE VOUS DÉCOUVRIREZ ]</p>
          <ul class="space-y-2">
            {findings.map(o => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {o}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ COMMENT SE DÉROULE LA MESURE ]</p>
          <div class="space-y-0">
            {process.map(step => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Hranice -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ LIMITES DE LA MÉTHODE ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">Le naturel au prix du contrôle<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Le terrain offre une situation plus naturelle, mais un contrôle des conditions moindre qu’en laboratoire.
              C’est pourquoi nous déterminons toujours à l’avance quelles conclusions peuvent être tirées en toute fiabilité
              de la mesure terrain et lesquelles méritent une vérification encore plus contrôlée.
            </p>
          </div>
          <a href="/fr/services/packs-de-test#terenni-studie" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            PACK ÉTUDE TERRAIN →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ QUESTIONS FRÉQUENTES ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            QUE VOIT LE CLIENT<br/>DANS VOTRE MAGASIN <span style="color:#2D62FC">?</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            Décrivez-nous l’espace et la décision que vous devez prendre. Nous proposerons un scénario de mesure terrain et vous dirons ce qu’il permettra de conclure en toute fiabilité.
          </p>
          <a href="/fr/contact" class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
            DEMANDER UNE MESURE →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
