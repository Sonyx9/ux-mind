---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const methods = [
  { title: 'Entretiens approfondis', type: 'QUALITATIF', desc: 'Des entretiens individuels révèlent les motivations, frustrations et modèles mentaux.' },
  { title: 'Tests d’utilisabilité', type: 'QUALITATIF', desc: 'Nous observons les utilisateurs accomplissant des tâches et identifions où ils échouent.' },
  { title: 'Recherche contextuelle', type: 'QUALITATIF', desc: 'Nous observons les utilisateurs dans leur environnement naturel, tels qu’ils travaillent réellement.' },
  { title: 'Enquêtes par questionnaire', type: 'QUANTITATIF', desc: 'Des données auprès de nombreux participants pour des conclusions statistiquement pertinentes.' },
  { title: 'Tests A/B', type: 'QUANTITATIF', desc: 'Nous comparons des variantes de design en conditions réelles et mesurons les résultats.' },
  { title: 'Card sorting', type: 'MIXTE', desc: 'Comment les utilisateurs catégorisent les contenus — la base d’une meilleure architecture de l’information.' },
];

const deliverables = [
  'Rapport de recherche avec méthodologie et constats',
  'Personas — profils des groupes clés fondés sur les données',
  'Journey maps incluant les pain points',
  'Recommandations priorisées par impact',
  'Bases pour une refonte ou des tests complémentaires',
];

const process = [
  { num: '01', title: 'Question de recherche', desc: 'Ce que vous devez décider et qui est concerné.' },
  { num: '02', title: 'Choix des méthodes', desc: 'Une combinaison de méthodes qualitatives et quantitatives selon la question.' },
  { num: '03', title: 'Collecte des données', desc: 'Entretiens, tests, questionnaires — avec pilote et contrôle qualité.' },
  { num: '04', title: 'Synthèse et livrable', desc: 'Nous relions les constats en recommandations, personas et journey maps.' },
];

const faq = [
  { q: 'Quand une recherche approfondie a-t-elle plus de sens qu’un test rapide ?', a: 'Lorsque vous ne décidez pas d’une seule interface, mais d’une stratégie produit : pour qui vous construisez, quels besoins vous adressez, où le parcours utilisateur est le plus fragile. Un test rapide valide une solution concrète, la recherche dit ce qu’il faut construire.' },
  { q: 'Combien de temps dure une recherche UX ?', a: 'Selon l’étendue, généralement 3–8 semaines : conception de la recherche, recrutement, collecte des données, analyse et synthèse en recommandations.' },
  { q: 'Combinez-vous la recherche avec la biométrie ?', a: 'Oui. Les entretiens et observations peuvent être complétés par l’eye-tracking, le GSR ou l’indice de charge mentale EMLI — nous confrontons ainsi les témoignages subjectifs à des données objectives.' },
  { q: 'Et si nous avons déjà nos propres données ?', a: 'Parfait — nous intégrons vos analytics, votre support client ou vos recherches précédentes à la synthèse. La nouvelle collecte cible alors uniquement les endroits où les données manquent.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Recherche UX',
    description: 'Recherche UX approfondie combinant méthodes qualitatives et quantitatives : entretiens, tests d’utilisabilité, questionnaires, personas et journey maps.',
    serviceType: 'Recherche UX',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="fr"
  title="Recherche UX et tests utilisateurs de site web"
  description="Tests utilisateurs de votre site, entretiens approfondis, tests d’utilisabilité, personas et journey maps. Décidez sur la base de données, pas de suppositions."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICES / RECHERCHE UX ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          DES DONNÉES, PAS<br/>DES IMPRESSIONS<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">L’étendue la plus profonde : comprendre les utilisateurs, pas seulement l’interface.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              Nous combinons méthodes qualitatives et quantitatives pour révéler les
              <strong class="text-brand-black">besoins, frustrations et modèles mentaux</strong> de vos utilisateurs.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="/fr/contact" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              LANCER UNE RECHERCHE →
            </a>
            <a href="/fr/services/packs-de-test" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              PACKS DE TEST
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURÉE', '3–8 semaines'],
          ['MÉTHODES', 'Quali + quanti'],
          ['LIVRABLES', 'Personas · journey maps'],
          ['PACK', 'Biométrique complet'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Metody -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ MÉTHODES DE RECHERCHE ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          La bonne méthode pour la bonne question<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {methods.map(method => (
            <div class="bg-brand-white p-8">
              <span class="font-mono text-[10px] text-brand-black/60 border border-brand-black/20 px-2 py-0.5 tracking-widest">{method.type}</span>
              <h3 class="font-display text-xl font-bold mb-3 mt-4">{method.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{method.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Foto -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/laborator-ux-vyzkumu-vizualizace-1.webp`}
          alt="Laboratoire de recherche UX — un espace pour les entretiens, les tests et les mesures biométriques"
          title="Laboratoire de recherche UX"
          width="1200" height="800" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">L’infrastructure de recherche de la FIM UHK — entretiens et tests peuvent être complétés par l’eye-tracking et la biométrie au sein d’une même session.</p>
      </div>

      <!-- Co dostanete + proces -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ CE QUE VOUS RECEVREZ ]</p>
          <ul class="space-y-2">
            {deliverables.map(o => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {o}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ COMMENT SE DÉROULE LA RECHERCHE ]</p>
          <div class="space-y-0">
            {process.map(step => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Biometrie -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ TÉMOIGNAGES + DONNÉES OBJECTIVES ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">Ce que les gens disent vs ce qu’ils font<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Nous confrontons les réponses déclarées au comportement : nous combinons entretiens et questionnaires
              avec l’eye-tracking, le GSR et l’indice de charge mentale EMLI. Vous décidez ensuite sur la base de ce qui s’est réellement passé.
            </p>
          </div>
          <a href="/fr/services/packs-de-test#komplexni-biometricky-vyzkum" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            PACK BIOMÉTRIQUE →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ QUESTIONS FRÉQUENTES ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="reveal relative overflow-hidden bg-brand-black text-brand-white text-center p-10 md:p-16">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
        <div class="relative">
          <h2 class="font-display font-bold leading-none tracking-tighter mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
            APPRENEZ À CONNAÎTRE<br/>VOS UTILISATEURS<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-white/70 leading-relaxed max-w-xl mx-auto mb-10">
            Décrivez-nous ce que vous devez décider. Nous concevrons une recherche qui y répond — sans méthodes superflues.
          </p>
          <a href="/fr/contact" class="inline-block bg-brand-white text-brand-black border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-transparent hover:text-brand-white transition-colors">
            LANCER UNE RECHERCHE →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
