---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const formats = [
  { t: 'Tests modérés', d: 'Un chercheur observe le participant pendant qu’il accomplit les tâches, pose des questions et aide à comprendre pourquoi il s’est arrêté ou a décidé autrement à un endroit précis.', tag: 'EN PROFONDEUR · EN LABORATOIRE ET EN LIGNE' },
  { t: 'Tests non modérés', d: 'Les participants accomplissent les tâches préparées en autonomie. Ce format permet d’impliquer rapidement davantage de personnes et de comparer leurs résultats.', tag: 'ÉCHANTILLON PLUS LARGE · EN LIGNE' },
];

const findings = [
  { title: 'Accomplissement des tâches', desc: 'Nous découvrons si les gens accomplissent les tâches importantes, combien de temps elles leur prennent et à quelles étapes ils s’arrêtent.' },
  { title: 'Clarté de l’interface', desc: 'Nous révélons les éléments, les libellés et les informations que les utilisateurs ne comprennent pas ou qu’ils ne remarquent pas.' },
  { title: 'Raisons des décisions', desc: 'Nous découvrons ce que les utilisateurs attendent, pourquoi ils choisissent tel parcours et si leurs déclarations correspondent à leur comportement réel.' },
];

const process = [
  { num: '01', title: 'Objectif et scénario', desc: 'Nous clarifions ce que vous devez vérifier et préparons des tâches réalistes.' },
  { num: '02', title: 'Sélection des participants', desc: 'Nous définissons le public cible adapté et recrutons des participants selon les critères convenus.' },
  { num: '03', title: 'Tests', desc: 'Les participants accomplissent les tâches préparées. Nous observons leur progression, leurs erreurs, leurs réactions et leurs commentaires.' },
  { num: '04', title: 'Analyse et recommandations', desc: 'Nous évaluons les constats, les classons par importance et les traduisons en propositions concrètes de correctifs.' },
];

const faq = [
  { q: 'Combien de participants faut-il ?', a: 'Pour révéler qualitativement les principaux problèmes, 5 à 8 participants par segment suffisent généralement. Pour comparer des variantes ou procéder à une évaluation statistique, il faut un échantillon plus large et conçu avec plus de précision — nous proposons l’étendue selon la question de recherche.' },
  { q: 'Combien de temps durent les tests utilisateurs ?', a: 'Le plus souvent 1 à 4 semaines selon l’étendue, le mode de recrutement et le nombre de participants. Nous fixons le calendrier précis après avoir clarifié l’objectif et le public cible.' },
  { q: 'Combien coûtent les tests utilisateurs ?', a: 'Le prix dépend du nombre de participants, du mode de recrutement, du format des tests et de l’étendue du livrable. Après un bref brief initial, nous recommandons l’étendue adaptée et préparons une offre concrète.' },
  { q: 'Peut-on aussi tester un prototype ?', a: 'Oui. Nous testons des sites, boutiques en ligne et applications en production ainsi que des prototypes cliquables. Plus un problème est détecté tôt, plus sa correction est simple et économique.' },
  { q: 'En quoi les tests utilisateurs diffèrent-ils d’un audit UX ?', a: 'L’audit UX est un contrôle expert de l’interface, sans participants. Les tests utilisateurs observent de vrais utilisateurs accomplissant des tâches et vérifient comment les problèmes se manifestent en pratique.' },
  { q: 'L’eye tracking fait-il partie des tests utilisateurs ?', a: 'Pas dans l’étendue standard. Nous proposons l’eye tracking comme extension distincte, lorsque vous devez mesurer précisément l’attention visuelle et découvrir quels éléments les gens ont remarqués ou manqués.' },
  { q: 'Pouvons-nous suivre les tests en direct ?', a: 'Oui. Pour les tests modérés, il est possible, sur accord, de suivre le déroulement depuis un espace séparé ou à distance, toujours dans le respect du consentement des participants et des conditions de l’étude.' },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Tests utilisateurs',
    description: 'Tests utilisateurs modérés et non modérés de sites, applications et prototypes. Protocole think-aloud, enregistrement d’écran, analyse du taux de réussite des tâches et recommandations.',
    serviceType: 'Tests utilisateurs',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="fr"
  title="Tests utilisateurs | Tests UX modérés et non modérés"
  description="Tests utilisateurs de sites, applications et prototypes avec de vrais utilisateurs. Tests modérés et non modérés, think-aloud, enregistrement d’écran et recommandations concrètes."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ SERVICES / TESTS UTILISATEURS ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          VÉRIFIEZ<br/>L’UTILISABILITÉ<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-3xl">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Vérifiez les tâches importantes avec de vrais utilisateurs.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify mb-4">
              Nous observons comment les gens utilisent votre site, boutique en ligne, application ou prototype.
              Nous découvrons s’ils parviennent à s’orienter, à accomplir les tâches importantes et quelles parties
              de l’interface ils ne comprennent pas.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed text-justify">
              Vous recevez des constats concrets et des recommandations sur <strong class="text-brand-black">quoi modifier pour rendre le produit plus clair et plus facile à utiliser</strong>.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/fr/contact" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              DEMANDER DES TESTS →
            </a>
            <a href="/fr/services#packs-de-test" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              VOIR LES PACKS
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['DURÉE', '1–4 semaines'],
          ['FORMAT', 'Modéré et en ligne'],
          ['ÉCHANTILLON', 'Selon la question de recherche'],
          ['PACK', 'Test UX standard'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight">{v}</p>
          </div>
        ))}
      </div>

      <!-- Jak testujeme -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ COMMENT NOUS TESTONS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Nous choisissons le format selon l’objectif de l’étude<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          {formats.map((v, i) => (
            <div class="bg-brand-white p-8 flex flex-col h-full">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed text-justify mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest self-start mt-auto">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-sm md:text-base text-brand-black/60 leading-relaxed mt-6 max-w-4xl">
          <strong class="text-brand-black">Selon l’objectif du test</strong>, nous intégrons la verbalisation à voix haute, un entretien de suivi, de courts questionnaires et l’enregistrement d’écran.
        </p>
      </div>

      <!-- Foto -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
          alt="Participante lors d’un test utilisateur en laboratoire"
          title="Déroulement d’un test utilisateur"
          width="1080" height="1920" loading="lazy" decoding="async"
          class="w-full max-h-[480px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">En laboratoire, les tests peuvent être complétés par l’eye-tracking — vous voyez non seulement ce que l’utilisateur a fait, mais aussi ce qu’il a vu en le faisant.</p>
      </div>

      <!-- Co testování odhalí -->
      <div class="reveal mb-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.35fr] gap-10 lg:gap-16">
          <div>
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ CE QUE LES TESTS RÉVÈLENT ]</p>
            <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight">
              Où l’interface aide — et où elle gêne<span style="color:#2D62FC">.</span>
            </h2>
          </div>
          <div class="border-t border-brand-white/20">
            {findings.map((finding, i) => (
              <div class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2rem_12rem_1fr] gap-x-4 gap-y-2 py-6 border-b border-brand-white/20">
                <span class="font-mono text-xs text-brand-white/50 pt-1">0{i + 1}</span>
                <h3 class="font-display text-lg font-bold leading-tight">{finding.title}</h3>
                <p class="col-start-2 sm:col-start-3 text-sm text-brand-white/65 leading-relaxed">{finding.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Proces -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ COMMENT SE DÉROULE LE TEST ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          De l’objectif aux ajustements concrets<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
          {process.map(step => (
            <div class="border-t border-brand-black/20 pt-5">
              <span class="block font-mono text-xs text-brand-black/60 mb-5">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Volitelné rozšíření -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ EXTENSION FACULTATIVE ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">Quand vous devez aussi mesurer l’attention<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Les tests utilisateurs montrent si les gens accomplissent la tâche et où ils s’arrêtent. L’eye tracking
              peut en plus mesurer précisément quels éléments ils ont remarqués, ce qu’ils ont manqué et comment leur
              attention a évolué pendant la tâche. Nous ajoutons des méthodes biométriques uniquement lorsqu’elles
              correspondent à l’objectif de l’étude.
            </p>
          </div>
          <a href="/fr/services/eye-tracking" class="shrink-0 inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
            VOIR L’EYE TRACKING →
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ QUESTIONS FRÉQUENTES ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
