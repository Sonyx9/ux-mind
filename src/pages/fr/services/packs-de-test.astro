---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const packages = [
  {
    num: '01',
    id: 'rychla-diagnostika',
    title: 'Audit UX rapide',
    tagline: 'Un contrôle expert rapide qui révèle les principaux problèmes d’un site ou d’une application.',
    chips: ['Audit UX expert', 'Écrans clés', 'Priorités des correctifs'],
    findings: 'Où l’interface peut dérouter l’utilisateur, ce qui complique l’accomplissement de la tâche et quels défauts il est pertinent de traiter en premier.',
    forWho: 'Pour les équipes qui doivent rapidement examiner un site, une boutique en ligne, une application ou un formulaire. Convient avant une refonte, en cas de baisse de conversion ou comme base pour d’autres ajustements.',
    inside: 'Un contrôle expert des pages clés et des parcours utilisateurs. Nous évaluons leur clarté, la navigation, le contenu, la hiérarchie visuelle et les obstacles à l’accomplissement de la tâche.',
    limits: 'L’audit ne mesure pas de vrais utilisateurs. Il révèle des problèmes probables et détermine des priorités, qui peuvent ensuite être vérifiées par des tests utilisateurs.',
    output: 'Un aperçu des principaux problèmes, des exemples concrets et des correctifs recommandés classés par importance.',
  },
  {
    num: '02',
    id: 'standardni-ux-test',
    title: 'Tests utilisateurs',
    tagline: 'Nous observons comment de vrais utilisateurs parcourent l’interface et où ils bloquent en accomplissant leurs tâches.',
    chips: ['Tests avec utilisateurs', 'Scénarios de tâches', 'Entretiens', 'Questionnaires'],
    findings: 'Si les utilisateurs accomplissent les tâches importantes, où ils commettent des erreurs, ce qu’ils ne comprennent pas et quelle variante s’utilise plus facilement.',
    forWho: 'Pour les équipes qui doivent vérifier un parcours utilisateur précis, une nouvelle maquette ou un prototype avec de vrais utilisateurs. Convient aux sites, applications, boutiques en ligne et formulaires.',
    inside: 'Des tests dirigés avec des utilisateurs selon des tâches préparées. Nous observons le taux de réussite, le temps, les erreurs et la façon d’utiliser l’interface. Nous complétons le comportement par un entretien et, si nécessaire, un questionnaire.',
    limits: 'Le test montre ce que les utilisateurs ont fait et comment ils expliquent leur comportement. Il ne mesure pas le mouvement précis des yeux ni la réaction physiologique — pour ces questions, la mesure premium en laboratoire est plus adaptée.',
    output: 'Les résultats de chaque tâche, les principales barrières, des exemples de comportement des utilisateurs et des recommandations classées par impact.',
  },
  {
    num: '03',
    id: 'komplexni-biometricky-vyzkum',
    title: 'Eye tracking et biométrie',
    tagline: 'Une mesure premium en laboratoire pour les décisions importantes que vous devez étayer par plusieurs sources de données.',
    chips: ['Tout du pack 02', 'GSR', 'Signaux faciaux', 'EMLI', 'Atelier'],
    findings: 'Ce que les utilisateurs ont réellement vu, comment ils ont procédé et à quels moments leur charge physiologique ou mentale a augmenté.',
    forWho: 'Pour les décisions coûteuses, difficilement réversibles ou qui doivent convaincre la direction, un investisseur ou un client. Convient aux refontes majeures, campagnes clés, innovations produit, HMI, situations retail ou recherches où le comportement seul ne suffit pas.',
    inside: 'Nous complétons les tests utilisateurs par l’eye tracking et, selon le brief, aussi par le GSR, l’analyse des signaux faciaux, un entretien rétrospectif sur l’enregistrement du regard ou la mesure de la charge mentale à l’aide du modèle EMLI.',
    limits: 'Nous n’interprétons jamais les données biométriques isolément. Le GSR ne dit pas si la réaction est positive ou négative, et les signaux faciaux ne constituent pas une « lecture des émotions » autonome. Ils ne prennent sens qu’en lien avec la tâche, le scénario, l’eye-tracking et le témoignage du participant.',
    output: 'Un rapport de recherche étendu, la mise en lien des différentes sources de données, l’explication des moments critiques, des recommandations de correctifs et un atelier sur les résultats.',
    featured: true,
  },
  {
    num: '04',
    id: 'terenni-studie',
    title: 'Étude terrain',
    tagline: 'Nous observons le comportement là où il se produit réellement — en magasin, en activité ou dans un autre espace physique.',
    chips: ['Observation sur le terrain', 'Enregistrement vidéo', 'Entretiens', 'Eye tracking mobile'],
    findings: 'Comment les gens parcourent un environnement réel, ce qu’ils remarquent, ce qu’ils manquent et où ils s’arrêtent.',
    forWho: 'Pour les situations où la décision ne se joue pas uniquement à l’écran. Typiquement en magasin, en showroom, face à un produit physique, lors d’un événement, dans un environnement de travail ou dans un contexte automobile/HMI.',
    inside: 'L’observation et l’enregistrement vidéo de la situation, des entretiens et l’analyse du comportement en environnement réel. Selon la question de recherche, nous pouvons aussi intégrer les lunettes d’eye-tracking mobiles Pupil Labs NEON ou le GSR.',
    limits: 'La recherche terrain offre un plus grand naturel de la situation, mais un contrôle des conditions moindre qu’en laboratoire. C’est pourquoi nous déterminons toujours à l’avance quelles conclusions peuvent être tirées en toute fiabilité d’une mesure terrain et lesquelles méritent d’être vérifiées dans des conditions plus contrôlées.',
    output: 'Une analyse vidéo, la cartographie des moments clés, la visualisation de l’attention dans l’environnement, une synthèse des obstacles et des recommandations pour ajuster l’espace, la communication ou le parcours client.',
  },
];

const outputs = [
  {
    title: 'Principaux constats',
    desc: 'Un aperçu des problèmes, les résultats des tâches et des visualisations correspondant au pack choisi.',
  },
  {
    title: 'Explication du contexte',
    desc: 'Nous montrons ce qui s’est passé, pourquoi c’est important et ce que l’on peut conclure en toute fiabilité des résultats.',
  },
  {
    title: 'Priorités et prochaines étapes',
    desc: 'Des correctifs recommandés classés par impact et par effort. Pour les études plus vastes, aussi un atelier commun sur les résultats.',
  },
];

const process = [
  { num: '01', title: 'Objectif', desc: 'Nous clarifions ce que vous devez découvrir et quelle décision la recherche doit soutenir.' },
  { num: '02', title: 'Proposition', desc: 'Nous recommandons le pack adapté, les méthodes, l’ampleur et les participants.' },
  { num: '03', title: 'Préparation', desc: 'Nous préparons le scénario, les supports et, si nécessaire, un test pilote.' },
  { num: '04', title: 'Réalisation', desc: 'Nous réalisons l’audit, les tests utilisateurs ou la mesure en laboratoire ou sur le terrain.' },
  { num: '05', title: 'Résultats', desc: 'Nous analysons les données et les traduisons en recommandations concrètes.' },
];

const audiences = [
  'Produit & UX',
  'Marketing',
  'E-commerce',
  'Retail & services',
  'Direction',
];

const faq = [
  {
    q: 'Quelle est la différence entre un audit UX et des tests utilisateurs ?',
    a: 'L’audit UX est réalisé par un spécialiste sans participants et révèle rapidement les problèmes probables de l’interface. Lors des tests utilisateurs, nous observons de vrais utilisateurs accomplissant des tâches concrètes. Cela permet de vérifier où ils bloquent réellement, commettent des erreurs ou ne comprennent pas quelque chose.',
  },
  {
    q: 'Quelle est la différence entre les tests utilisateurs et l’eye tracking ?',
    a: 'Les tests utilisateurs montrent si les gens accomplissent les tâches importantes et comment ils utilisent l’interface. L’eye tracking mesure en plus précisément leur regard — ce qu’ils ont vu, ce qu’ils ont manqué et dans quel ordre ils ont suivi les éléments. C’est pourquoi nous l’utilisons comme méthode premium pour les questions où la seule observation ne suffit pas.',
  },
  {
    q: 'En quoi l’eye tracking diffère-t-il d’une heatmap issue de l’analytics web ?',
    a: 'Une heatmap issue de l’analytics web repose généralement sur les clics, le mouvement du curseur ou le défilement de la page. L’eye tracking mesure le regard réel de l’utilisateur. Il capture ainsi aussi les éléments qu’une personne a remarqués sans cliquer dessus — ou les endroits qu’elle a complètement manqués.',
  },
  {
    q: 'Combien de participants faut-il pour des tests utilisateurs ?',
    a: 'Le nombre dépend de l’objectif de la recherche, de la diversité du public cible et de la méthode d’évaluation. Pour repérer des problèmes, nous travaillons souvent avec un échantillon plus restreint. Pour comparer des variantes de façon fiable ou tirer des conclusions statistiques, un échantillon plus large est nécessaire. Nous recommandons le nombre précis selon la question de recherche.',
  },
  {
    q: 'Combien coûte un audit UX ou des tests utilisateurs ?',
    a: 'Le prix dépend de l’étendue, du nombre de parcours ou de variantes testés, du nombre de participants, des méthodes utilisées et de la forme du livrable. Après un bref brief, nous recommandons l’étendue adaptée et préparons une offre sans engagement.',
  },
  {
    q: 'Les tests doivent-ils avoir lieu en laboratoire ?',
    a: 'Non. Nous pouvons tester un site, une application ou un prototype en laboratoire ou à distance selon l’objectif du projet. Le comportement en magasin, en activité ou dans un autre espace physique, nous l’observons directement sur le terrain.',
  },
  {
    q: 'Comment protégez-vous les données des participants ?',
    a: 'Avant les tests, nous définissons la finalité du traitement et obtenons le consentement éclairé de chaque participant. Nous sécurisons les données et préparons par défaut les livrables sous forme agrégée ou pseudonymisée. Le régime précis est défini selon la sensibilité du projet, les exigences du client et le RGPD.',
  },
];

const pageSchema = [
  {
    '@type': 'Service',
    name: 'Packs de test UX MIND',
    description: 'Packs de test de recherche UX : audit UX rapide, tests utilisateurs, eye tracking premium avec biométrie et étude terrain.',
    serviceType: 'Tests UX',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  lang="fr"
  title="Packs de test UX MIND | Eye tracking, biométrie et recherche UX"
  description="Choisissez l’étendue des tests UX selon ce que vous devez découvrir. Audit UX rapide, tests utilisateurs, eye tracking avec biométrie et étude terrain."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-12">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ PACKS DE TEST ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          CHOISISSEZ L’ÉTENDUE<br/>DES TESTS<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">Selon ce que vous devez découvrir.</h2>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl text-justify">
              Parfois, il suffit de révéler rapidement les principaux obstacles. D’autres fois, vous devez comparer
              des variantes ou étayer une décision importante par plusieurs sources de données. Nous recommandons
              l’étendue adaptée à votre objectif, votre contexte et le niveau de certitude requis.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="#balicky" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              VOIR LES PACKS ↓
            </a>
            <a href="/fr/contact" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              CONSEIL SUR LE CHOIX →
            </a>
          </div>
        </div>
      </div>

      <!-- Škála rozsahu: rychlá volba -->
      <div class="mb-16">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
          {packages.map(pkg => (
            <a href={`#${pkg.id}`} class="group bg-brand-white p-5 hover:bg-brand-black hover:text-brand-white transition-colors">
              <div class="flex justify-between items-start mb-4">
                <span class="font-mono text-xs text-brand-black/60 group-hover:text-brand-white/60">{pkg.num}</span>
                <span class="font-mono text-xs opacity-0 group-hover:opacity-100 transition-opacity">↓</span>
              </div>
              <p class="font-display font-bold leading-tight">{pkg.title}</p>
            </a>
          ))}
        </div>
        <!-- Osa rozsahu -->
        <div class="flex items-center gap-3 mt-3 font-mono text-[10px] text-brand-black/60 tracking-widest uppercase">
          <span>Étendue réduite</span>
          <span class="flex-1 h-px bg-gradient-to-r from-brand-black/20 to-brand-black"></span>
          <span>Recherche plus approfondie</span>
        </div>
      </div>

      <!-- Důvěryhodnostní pás -->
      <div class="reveal mb-24 border-y border-brand-black/10 py-4 overflow-hidden">
        <p class="font-mono text-[11px] text-brand-black/60 tracking-wider whitespace-nowrap md:whitespace-normal overflow-x-auto">
          Infrastructure de recherche FIM UHK · Tobii Pro X2-60 · Smart Eye Aurora · Pupil Labs NEON · iMotions CORE · BeSigma · Shimmer3 GSR · mesures en laboratoire et sur le terrain
        </p>
      </div>

      <!-- Proč samotný eye-tracking nestačí — tři vrstvy -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ POURQUOI L’EYE-TRACKING SEUL NE SUFFIT PAS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Attention ≠ compréhension ≠ conversion<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {[
            { t: 'Ce qu’il a vu', d: 'L’eye-tracking montre ce que l’utilisateur voit réellement et ce qu’il manque.', tag: 'REGARD' },
            { t: 'Ce qu’il a fait', d: 'A-t-il accompli la tâche ? Combien de temps lui a-t-elle pris et où a-t-il commis des erreurs ?', tag: 'COMPORTEMENT' },
            { t: 'Pourquoi', d: 'Comment il a évalué l’interface et ce qu’il a su expliquer a posteriori.', tag: 'TÉMOIGNAGE' },
          ].map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-sm text-brand-black/60 leading-relaxed mt-4 max-w-2xl">
          Ce n’est qu’en reliant ces trois couches que l’on distingue un problème qui attire simplement le regard d’un problème qui empêche d’accomplir la tâche.
        </p>
      </div>

      <!-- Balíčky -->
      <div id="balicky" class="mb-24 scroll-mt-28">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ NOS PACKS DE TEST ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-4">Quatre configurations<span style="color:#2D62FC">.</span></h2>
        <p class="text-brand-black/60 leading-relaxed max-w-2xl mb-12">
          Ce ne sont pas des produits figés — nous les adaptons selon le brief. Pour chacun, vous savez à l’avance ce que vous obtiendrez et ce que cette étendue <strong class="text-brand-black">ne permettra pas d’affirmer de manière fiable</strong>.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          {packages.map(pkg => (
            <div id={pkg.id} class={`reveal p-8 md:p-10 flex flex-col scroll-mt-28 ${pkg.featured ? 'bg-brand-black text-brand-white' : 'bg-brand-white'}`}>
              <div class="flex justify-between items-start mb-6">
                <span class={`font-mono text-xs ${pkg.featured ? 'text-brand-white/60' : 'text-brand-black/60'}`}>{pkg.num}</span>
                {pkg.featured && (
                  <span class="font-mono text-[10px] tracking-widest px-2 py-1" style="background:#2D62FC; color:#FCFCFC;">MESURE PREMIUM</span>
                )}
              </div>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-3 leading-tight">{pkg.title}</h3>
              <p class={`leading-relaxed mb-6 ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>{pkg.tagline}</p>

              <div class="flex flex-wrap gap-2 mb-6">
                {pkg.chips.map(chip => (
                  <span class={`font-mono text-[11px] px-2 py-1 tracking-wide border ${pkg.featured ? 'border-brand-white/30 text-brand-white/80' : 'border-brand-black/20 text-brand-black/70'}`}>{chip}</span>
                ))}
              </div>

              <p class={`text-sm leading-relaxed mb-6 ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>
                <span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Vous découvrirez</span>
                {pkg.findings}
              </p>

              <details class={`group mt-auto border-t pt-4 ${pkg.featured ? 'border-brand-white/20' : 'border-brand-black/10'}`}>
                <summary class="flex justify-between items-center cursor-pointer font-mono text-xs tracking-widest uppercase list-none [&::-webkit-details-marker]:hidden">
                  DÉTAIL DU PACK
                  <span class="font-mono text-lg transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <div class={`mt-4 space-y-4 text-sm leading-relaxed ${pkg.featured ? 'text-brand-white/70' : 'text-brand-black/60'}`}>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Pour qui</span>{pkg.forWho}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Contenu</span>{pkg.inside}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Ce qu’il est bon de savoir</span>{pkg.limits}</p>
                  <p><span class={`font-mono text-[10px] tracking-widest uppercase block mb-1 ${pkg.featured ? 'text-brand-white/50' : 'text-brand-black/40'}`}>Livrable type</span>{pkg.output}</p>
                </div>
              </details>
            </div>
          ))}
        </div>

        <!-- Balíček na míru -->
        <div id="na-miru" class="reveal relative overflow-hidden bg-brand-black text-brand-white p-8 md:p-12 mt-px scroll-mt-28">
          <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(252,252,252,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(252,252,252,0.05) 1px, transparent 1px); background-size: 25% 50%;"></div>
          <div class="relative flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div>
              <p class="font-mono text-xs text-brand-white/60 mb-2">05</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-3">Pack sur mesure<span style="color:#2D62FC">.</span></h3>
              <p class="text-brand-white/70 leading-relaxed max-w-xl">
                Nous apprenons d’abord à connaître votre activité, vos objectifs et votre contexte — puis nous
                concevons sur mesure les tests et l’optimisation qui suit. De la question de recherche à la
                combinaison de méthodes adaptée, jusqu’aux ajustements concrets qui se retrouvent dans les résultats.
                Nous composons selon la décision qui sera prise à partir des données, pas selon l’équipement du laboratoire.
              </p>
            </div>
            <a href="/fr/contact" class="shrink-0 inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              JE NE SAIS PAS LEQUEL CHOISIR →
            </a>
          </div>
        </div>
      </div>

      <!-- EMLI -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="grid grid-cols-1 md:grid-cols-[minmax(0,2fr)_minmax(240px,1fr)] md:items-center gap-10 md:gap-16">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ EMLI : INDICE DE CHARGE MENTALE ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">Où l’interface exige le plus d’effort<span style="color:#2D62FC">.</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed text-justify mb-4">
              EMLI convertit des indicateurs sélectionnés issus de l’eye tracking en un score de 0 à 100. Cela permet
              de comparer des écrans, des étapes ou des variantes et de déterminer où le traitement de l’information
              est plus exigeant pour l’utilisateur.
            </p>
            <p class="text-sm text-brand-black/60 leading-relaxed text-justify">
              <strong class="text-brand-black">Plus le score est élevé, plus la charge est grande.</strong> Nous évaluons
              toujours le résultat avec le comportement de l’utilisateur et d’autres données, jamais comme un verdict isolé.
            </p>
          </div>
          <div aria-label="Échelle EMLI, de la charge mentale la plus faible à la plus élevée">
            <div class="emli-scale h-2 mb-4" aria-hidden="true">
              <div class="emli-fill"></div>
            </div>
            <div class="flex items-start justify-between gap-6 font-mono text-[10px] tracking-widest uppercase">
              <p><strong class="block font-display text-3xl leading-none mb-2 text-brand-blue">0</strong>Charge plus faible</p>
              <p class="text-right"><strong class="block font-display text-3xl leading-none mb-2 text-brand-blue">100</strong>Charge plus élevée</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Proces a výstupy -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ COMMENT SE DÉROULE LA COLLABORATION ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10">De l’objectif aux ajustements concrets<span style="color:#2D62FC">.</span></h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-px bg-brand-black/10 border border-brand-black/10">
          {process.map(step => (
            <div class="bg-brand-white p-6 md:p-7 min-h-64 flex flex-col">
              <span class="font-mono text-xs text-brand-black/60 mb-10">{step.num}</span>
              <h3 class="font-display text-xl font-bold leading-tight mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed text-justify mt-auto">{step.desc}</p>
            </div>
          ))}
        </div>

        <p class="font-mono text-xs text-brand-black/60 tracking-widest mt-16 mb-8">[ CE QUE CONTIENT LE LIVRABLE ]</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {outputs.map((output, i) => (
            <div class="bg-brand-white p-7 md:p-8 min-h-56 flex flex-col">
              <span class="font-mono text-xs text-brand-black/60 mb-8">0{i + 1}</span>
              <h3 class="font-display text-2xl font-bold leading-tight mb-3">{output.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed text-justify mt-auto">{output.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Pro koho -->
      <div class="reveal mb-24 max-w-4xl">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ POUR QUI LES PACKS SONT-ILS ADAPTÉS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6">Pour les équipes qui veulent décider sur la base de données<span style="color:#2D62FC">.</span></h2>
        <p class="text-brand-black/60 leading-relaxed text-justify mb-8 max-w-3xl">
          Les packs de test conviennent aux équipes produit et UX, au marketing, à l’e-commerce, au retail et aux
          directions d’entreprise. Nous adaptons l’étendue selon que vous travaillez sur la navigation, un formulaire,
          une campagne, le parcours d’achat, un espace physique ou des données pour une décision importante.
        </p>
        <div class="flex flex-wrap gap-x-5 gap-y-3">
          {audiences.map(a => (
            <span class="font-mono text-[11px] text-brand-black/60 tracking-widest uppercase">{a}</span>
          ))}
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ QUESTIONS FRÉQUENTES SUR LES TESTS ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10">Ce qu’il est bon de savoir avant de choisir<span style="color:#2D62FC">.</span></h2>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    // Scroll-reveal — stejný pattern jako na případových studiích
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>

  <style>
    /* EMLI stupnice — čára jednou najede (0 → 100) a ustálí se na 63; spustí se, až sekce naroluje do viewportu */
    .emli-scale {
      position: relative;
      overflow: hidden;
      background: rgba(45, 98, 252, 0.1);
    }
    .emli-fill {
      position: absolute;
      inset: 0;
      transform-origin: left center;
      background: linear-gradient(90deg, rgba(45, 98, 252, 0.16), #2d62fc);
      transform: scaleX(0.63);
    }
    .reveal.is-visible .emli-fill {
      animation: emliFill 2.8s ease-in-out both;
    }
    @keyframes emliFill {
      0% { transform: scaleX(0); }
      65% { transform: scaleX(1); }
      100% { transform: scaleX(0.63); }
    }
    @media (prefers-reduced-motion: reduce) {
      .reveal.is-visible .emli-fill { animation: none; }
      .emli-fill { transform: scaleX(0.63); }
    }
  </style>
</BaseLayout>
