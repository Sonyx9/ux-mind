---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const homeStudies = [
  {
    href: '/fr/etudes-de-cas/karierni-portal-automotive',
    category: "ŠKODA AUTO · portail carrière",
    title: "40 % des candidats n’ont pas trouvé les postes ouverts — sur un site pourtant « clair ».",
    method: "Eye tracking + questionnaire · N = 102",
    result: "40 % perdus",
  },
  {
    href: '/fr/etudes-de-cas/backend-stories',
    category: "Microsite éducatif",
    title: "92 % des regards ont fini sur le CTA principal. Seul un tiers a lu le long paragraphe.",
    method: "Eye tracking, analyse AOI · ~120 participants",
    result: "92 % sur le CTA",
  },
  {
    href: '/fr/etudes-de-cas/reklamni-bannery-smer-pohledu',
    category: "Créa publicitaire",
    title: "Là où regarde le personnage de votre bannière, votre client regarde aussi.",
    method: "Expérience d’eye tracking · N = 104",
    result: "Le regard guide",
  },
];

const gifSrc = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/hero.webp`;
const yearSuffix = new Date().getFullYear().toString().slice(-2);

const clientLogos = [
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/skoda.webp`, w: 1920, h: 630, alt: 'Škoda Auto' , dh: 50 },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/fchk.webp`, w: 800, h: 800, alt: 'FC Hradec Králové' , dh: 54 },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`, w: 157, h: 37, alt: 'Université de Hradec Králové' },
  { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/texopluslogo.webp`, w: 216, h: 46, alt: 'TEXO Plus' },
];
---

<BaseLayout lang="fr" title="Recherche UX, eye tracking & tests utilisateurs | UXMIND" description="Tests utilisateurs, eye tracking et mesure de la charge cognitive (modèle EMLI). Une recherche UX objective, adossée au laboratoire de la FIM UHK.">
  <Navbar />

  <!-- HERO SECTION -->
  <section class="hero-shell relative overflow-hidden" style="background:#FDFDFD;">

    <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true"
      style="background-image: linear-gradient(rgba(10,10,10,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.07) 1px, transparent 1px); background-size: 25% 33.333%;">
      <div class="hidden md:block">
      {[0, 25, 50, 75, 100].flatMap(x =>
        [0, 33.333, 66.667, 100].map(y => (
          <div class="absolute" style={`left:${x}%; top:${y}%; transform:translate(-50%,-50%);`}>
            <div class="relative" style="width:14px; height:14px;">
              <div class="absolute" style="top:50%; left:0; width:14px; height:1px; background:rgba(10,10,10,0.22); transform:translateY(-50%);"></div>
              <div class="absolute" style="left:50%; top:0; height:14px; width:1px; background:rgba(10,10,10,0.22); transform:translateX(-50%);"></div>
            </div>
          </div>
        ))
      )}
      </div>
    </div>

    <!-- Center CTA — below the hero figure, on the same grid row axis as the spec list -->
    <div class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 z-[60] hidden md:block" style="top: 83.333%;">
      <a href="/fr/contact" class="inline-block bg-brand-black text-brand-white border border-brand-black px-6 py-2 font-mono text-xs tracking-widest uppercase transition-colors duration-200 hover:bg-transparent hover:text-brand-black">
        PRENDRE RENDEZ-VOUS
      </a>
    </div>

    <div class="absolute z-10" style="left: var(--desktop-gutter); top: calc(var(--desktop-top-offset) + 3rem); line-height: 1; margin: 0; padding: 0;">
      <h1 class="m-0 p-0 relative" style="line-height:0;">
        <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logo-2line.svg`} alt="UX Mind" width="264" height="88" style="width: clamp(8.4rem, 16.8vw, 264px); height:auto; display:block;" />
        <!-- Easter egg: hotspot over the logo's blue dot + patch shown while the dot is "escaped" -->
        <span id="logo-dot-hotspot" class="hidden md:block" style="position:absolute; left:89%; top:64%; width:14%; height:24%;"></span>
        <span id="logo-dot-patch" style="position:absolute; left:92.4%; top:69%; width:8%; height:14%; background:#FCFCFC; border-radius:50%; display:none;"></span>
      </h1>
      <!-- Mobile-only: first annotation below heading -->
      <p class="md:hidden font-mono tracking-widest text-brand-black/70 mt-3" style="font-size:10px;">OÙ LA RECHERCHE RÉVÈLE LA VÉRITÉ</p>
    </div>

    <!-- Mobile hero image — static, shown immediately -->
    <div class="md:hidden absolute left-0 right-0 flex items-center justify-center" style="top: 33.333%; height: 33.334%;">
      <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/hero-mobile.webp`} alt="UX Mind — recherche UX et eye tracking" style="width:100%; height:auto; object-fit:contain;" width="800" height="450" fetchpriority="high" decoding="async" />
    </div>

    <!-- Center 3D Brain — desktop only -->
    <div class="hidden md:flex absolute inset-0 items-center justify-center">
      <div id="hero-gif-container" class="relative" style="width: min(48vw, 760px); height: min(50vh, 540px);">
        <img
          id="hero-gif"
          src={gifSrc}
          alt="Réseau neuronal animé — visualisation reliant recherche UX, eye tracking et données"
          class="w-full h-full object-contain"
          width="960" height="540" loading="lazy" decoding="async"
        />

        <!-- Annotation: top -->
        <div class="ann absolute hidden md:flex flex-col items-center opacity-0" style="left:50%; top:-30px; transform:translateX(-50%);">
          <p class="font-mono hero-fluid-micro tracking-widest text-center mb-1 max-w-32">OÙ LA RECHERCHE<br/>RÉVÈLE LA VÉRITÉ</p>
          <div class="ann-line w-px bg-brand-black" style="height:0;" data-size="200"></div>
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
        </div>

        <!-- Annotation: left -->
        <div class="ann absolute hidden md:flex items-center opacity-0" style="left:22%; top:42%; transform:translate(-100%,-50%);">
          <div class="text-right mr-2">
            <p class="font-mono hero-fluid-micro tracking-widest">DU POINT DE VUE<br/>DE L’UTILISATEUR<br/>NAÎT LE DESIGN</p>
          </div>
          <div class="ann-line h-px bg-brand-black" style="width:0;"></div>
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
        </div>

        <!-- Annotation: right top — top 40% keeps the text below the stats box bottom edge -->
        <div class="ann absolute hidden md:flex items-center opacity-0" style="right:22%; top:40%; transform:translate(100%,-50%);">
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
          <div class="ann-line h-px bg-brand-black" style="width:0;" data-size="110"></div>
          <div class="ml-2">
            <p class="font-mono hero-fluid-micro tracking-widest">L’EYE TRACKING<br/>RÉVÈLE CE QUE<br/>L’ON VOIT VRAIMENT</p>
          </div>
        </div>

        <!-- Annotation: right bottom -->
        <div class="ann absolute hidden md:flex items-center opacity-0" style="right:22%; top:65%; transform:translate(100%,-50%);">
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
          <div class="ann-line h-px bg-brand-black" style="width:0;" data-size="110"></div>
          <div class="ml-2">
            <p class="font-mono hero-fluid-micro tracking-widest">UNE BASE POUR<br/>LA CROISSANCE</p>
          </div>
        </div>

        <!-- Annotation: bottom -->
        <div class="ann absolute hidden md:flex flex-col items-center opacity-0" style="left:50%; bottom:35%; transform:translate(-50%,100%);">
          <div class="flex-shrink-0" style="width:10px;height:10px;border:1px solid #0A0A0A;background:#FCFCFC;border-radius:50%;display:flex;align-items:center;justify-content:center;"><div style="width:4px;height:4px;background:#0A0A0A;border-radius:50%;"></div></div>
          <div class="ann-line w-px bg-brand-black" style="height:0;"></div>
          <p class="font-mono hero-fluid-micro tracking-widest text-center mt-1 max-w-24">DES DONNÉES,<br/>PAS DES<br/>IMPRESSIONS</p>
        </div>

      </div>
    </div>

    <div class="hero-stats-box hidden absolute z-10 border border-brand-black p-4 bg-brand-white/90 backdrop-blur-sm" style="top: calc(var(--desktop-top-offset) + 3rem); left: calc(75% + clamp(12px,1.8vw,32px)); right: var(--desktop-gutter);">
      <div class="flex justify-between items-center mb-3">
        <p class="font-mono text-xs font-medium tracking-widest">UX MIND</p>
        <p class="font-mono text-xs text-brand-black/60">/{yearSuffix}</p>
      </div>
      <div class="space-y-2">
        <div class="flex items-baseline justify-between">
          <p class="font-display font-bold leading-none stat-projects" style="font-size: calc(clamp(24px, 1.2vw + 14px, 32px) * min(var(--fs, 1), 1.08));">50+</p>
          <p class="font-mono hero-fluid-micro text-brand-black/60 tracking-widest">PROJETS</p>
        </div>
        <div class="flex items-baseline justify-between">
          <p class="font-display font-bold leading-none stat-respondents" style="font-size: calc(clamp(24px, 1.2vw + 14px, 32px) * min(var(--fs, 1), 1.08));">200+</p>
          <p class="font-mono hero-fluid-micro text-brand-black/60 tracking-widest">PARTICIPANTS</p>
        </div>
        <div class="flex items-baseline justify-between gap-3 border-t border-brand-black/20 pt-2 mt-1">
          <p class="font-display font-bold leading-none stat-clicks" style="font-size: calc(clamp(24px, 1.2vw + 14px, 32px) * min(var(--fs, 1), 1.08));">50%</p>
          <p class="font-mono hero-fluid-micro text-brand-black/60 tracking-widest">CLICS EN PLUS</p>
        </div>
      </div>
    </div>

    <div class="hero-spec-list absolute z-10" style="left: var(--desktop-gutter); top: 83.333%; transform: translateY(-50%);">
      <p class="font-mono text-xs tracking-widest mb-4 text-brand-black/60">[ NOTRE SPÉCIALISATION ]</p>
      <div class="space-y-3">
        {[
          { num: '01', label: 'AUDIT UX' },
          { num: '02', label: 'TESTS UTILISATEURS' },
          { num: '03', label: 'EYE TRACKING' },
          { num: '04', label: 'RECHERCHE TERRAIN' },
          { num: '05', label: 'RECHERCHE UX' },
        ].map((item) => (
          <div class="flex items-center gap-2">
            <p class="font-mono text-xs text-brand-black/60 shrink-0">{item.num}.</p>
            <span class="spec-dashes font-mono text-xs tracking-tight">
              {Array.from({length: 20}).map(() => (
                <span style="color:rgb(200,200,200); transition:color 0.8s ease;">|</span>
              ))}
            </span>
            <p class="font-mono text-xs font-medium tracking-widest whitespace-nowrap">{item.label}</p>
          </div>
        ))}
      </div>
      <div class="flex items-center gap-3 mt-3">
        <p id="local-time" class="font-mono text-xs tracking-widest">PRG --:-- -- &nbsp; --/--/----</p>
      </div>
    </div>

    <div id="info-box" class="hidden md:flex absolute z-30 border border-brand-black bg-brand-black text-brand-white flex-col"
      style="left:calc(75% + clamp(12px,1.8vw,32px)); right: var(--desktop-gutter); top: 83.333%; transform: translateY(-50%); padding:clamp(8px,1.1vh,18px) clamp(10px,1.2vw,20px);">
      <div>
        <div class="mb-2">
          <p class="font-mono font-medium tracking-widest bg-brand-white text-brand-black px-1 py-0.5 block w-full" style="font-size:calc(clamp(11px,0.85vw,13px) * min(var(--fs, 1), 1.08));">PAS UNE AGENCE – DES SPÉCIALISTES</p>
        </div>
        <p class="font-mono text-brand-white/90 leading-relaxed infobox-desc" style="font-size:calc(clamp(11px,0.85vw,13px) * min(var(--fs, 1), 1.08));">
          Une équipe de spécialistes UX. Nous aidons les entreprises à comprendre leurs utilisateurs par les données et l’eye-tracking.
        </p>
      </div>
      <div class="shrink-0">
        <div class="pt-2 border-t border-brand-white/20 flex flex-col items-start gap-1.5">
          <p class="font-mono text-brand-white/75 tracking-widest whitespace-nowrap" style="font-size:calc(clamp(10px,0.75vw,12px) * min(var(--fs, 1), 1.08));">PROJET AVEC :</p>
          <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`} alt="Université de Hradec Králové" class="max-w-full shrink-0" style="height:clamp(24px,2.8vh,40px); margin-top:4px; margin-bottom:4px; object-fit:contain; filter: invert(1);" />
        </div>
      </div>
    </div>

    <!-- Cursor dot — only in hero area -->
    <div id="cursor-dot" style="position:fixed; top:0; left:0; width:8px; height:8px; background:#2D62FC; border-radius:50%; pointer-events:none; z-index:9999; transform:translate(-50%,-50%); opacity:0;"></div>

    <button type="button" aria-label="Faire défiler vers le contenu" class="hidden md:flex absolute bottom-6 z-10 flex-col items-start gap-2 animate-bounce cursor-pointer" style="left: 50%;" onclick="window.scrollBy({ top: window.innerHeight * 0.6, behavior: 'smooth' })">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest" style="transform: translateX(-50%);">SCROLL</p>
      <div class="h-8 bg-brand-black/20" style="width: 1px;"></div>
    </button>
  </section>

  <!-- Mobile info box — NOT AN AGENCY, above logo carousel -->
  <div class="md:hidden border border-brand-black bg-brand-black text-brand-white mx-6 my-8 p-6 flex flex-col gap-4">
    <div>
      <p class="font-mono font-medium tracking-widest bg-brand-white text-brand-black px-1 py-0.5 block w-full" style="font-size:12px;">PAS UNE AGENCE – DES SPÉCIALISTES</p>
    </div>
    <p class="font-mono text-sm text-brand-white/90 leading-relaxed">Une équipe de spécialistes UX. Nous aidons les entreprises à comprendre leurs utilisateurs par les données et l’eye-tracking.</p>
    <div class="flex gap-2">
      <a href="/fr/a-propos" class="font-mono text-xs border border-brand-white px-2 py-1">À PROPOS</a>
      <a href="/fr/contact" class="font-mono text-xs border border-brand-white px-2 py-1">CONTACT</a>
    </div>
    <div class="border-t border-brand-white/20 pt-2 flex items-center justify-between">
      <p class="font-mono text-[11px] text-brand-white/75 tracking-widest">PROJET AVEC :</p>
      <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logos/uhk.svg`} alt="Université de Hradec Králové" class="h-[40px] w-auto ml-6 my-1" style="filter: invert(1);" />
    </div>
  </div>

  <!-- LOGO STRIP -->
  <div class="border-y border-brand-black/10 py-6" style="background:#FDFDFD;">
    <!-- Desktop: static strip -->
    <div class="hidden md:flex flex-wrap items-center justify-center gap-x-14 gap-y-6 px-6">
      {clientLogos.map(({ src, alt, w, h, dh }) => (
        <div class="px-4 py-1">
          <img
            src={src}
            alt={alt}
            title={alt}
            width={w} height={h}
            class="logo-strip-img select-none"
            style={`height:${dh || 42}px; width:auto; max-width:170px; object-fit:contain; display:block;`}
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
    <!-- Mobile: auto-scrolling carousel, two logos per row -->
    <div class="md:hidden overflow-hidden">
      <div class="logo-marquee flex items-center">
        {[...clientLogos, ...clientLogos].map(({ src, alt, w, h, dh }) => (
          <div class="flex-shrink-0 flex justify-center items-center px-4" style="width:50vw;">
            <img
              src={src}
              alt={alt}
              title={alt}
              width={w} height={h}
              class="logo-strip-img select-none"
              style={`height:${dh ? Math.round(dh * 36 / 42) : 36}px; width:auto; max-width:40vw; object-fit:contain; display:block;`}
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <style>
    .logo-strip-img {
      filter: grayscale(1);
      opacity: 0.65;
    }
    .logo-marquee {
      width: max-content;
      /* the loop is visual only (transform) — logos download once and animate from cache */
      animation: logo-scroll 10s linear infinite;
    }
    @keyframes logo-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(-150vw); }
    }
    @media (prefers-reduced-motion: reduce) {
      .logo-marquee { animation: none; }
    }
  </style>

  <!-- THREE QUESTIONS, THREE MEASUREMENTS -->
  <section id="main-content" class="desktop-gutter-x pt-24 pb-12 max-w-7xl mx-auto">
    <div class="mb-12 max-w-3xl">
      <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-2">[ TROIS QUESTIONS, TROIS MESURES ]</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6">Ce que les utilisateurs voient, comment ils réagissent<br/>et ce que cela leur coûte<span style="color:#2D62FC">.</span></h2>
      <p class="text-sm text-brand-black/60 leading-relaxed">
        L’analytics montre OÙ les gens ont cliqué. Les questionnaires montrent CE qu’ils pensent. Nous mesurons la troisième couche :
        ce qu’ils ont réellement vu, l’intensité de leur réaction et où l’interface les a mentalement surchargés.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10">
      {[
        {
          q: 'Le voient-ils seulement ?',
          desc: 'Attention visuelle — fixations, TTFF, dwell time, analyse AOI et scanpaths. Un enregistrement objectif de ce que les utilisateurs ont réellement vu et manqué.',
          tool: 'EYE-TRACKING',
        },
        {
          q: 'Avec quelle intensité réagissent-ils ?',
          desc: 'Excitation physiologique et signaux faciaux dans le contexte de la tâche. Toujours interprétés avec leurs limites — pas de « lecture des émotions ».',
          tool: 'GSR + SIGNAUX FACIAUX',
        },
        {
          q: 'Y arrivent-ils sans effort ?',
          desc: 'La charge mentale en un score clair de 0 à 100. Découvrez où votre interface surcharge les utilisateurs — même lorsqu’ils finissent par accomplir la tâche.',
          tool: 'MODÈLE EMLI',
        },
      ].map((item, i) => (
        <div class="bg-brand-white p-8 flex flex-col">
          <p class="font-mono text-xs text-brand-black/60 mb-8">0{i + 1}</p>
          <h3 class="font-display text-2xl font-bold mb-4 leading-tight">{item.q}</h3>
          <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{item.desc}</p>
          <p class="mt-auto"><span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{item.tool}</span></p>
        </div>
      ))}
    </div>
    <!-- Glossary of abbreviations -->
    <details class="group border border-brand-black/15 mt-6">
        <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
          [ GLOSSAIRE ]
          <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <dl class="px-5 pb-6 space-y-4">
            <div><dt class="font-display font-bold mb-1">TTFF</dt><dd class="text-sm text-brand-black/70 leading-relaxed">temps jusqu’à la première fixation</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">zone d’intérêt</dd></div>
            <div><dt class="font-display font-bold mb-1">dwell time</dt><dd class="text-sm text-brand-black/70 leading-relaxed">temps total de regard sur une zone</dd></div>
            <div><dt class="font-display font-bold mb-1">scanpath</dt><dd class="text-sm text-brand-black/70 leading-relaxed">trajet du regard entre les fixations</dd></div>
            <div><dt class="font-display font-bold mb-1">GSR</dt><dd class="text-sm text-brand-black/70 leading-relaxed">réponse électrodermale, indicateur d’excitation physiologique</dd></div>
            <div><dt class="font-display font-bold mb-1">EMLI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">indice de charge mentale dérivé des métriques d’eye-tracking</dd></div>
        </dl>
      </details>
  </section>

  <!-- SERVICES SECTION -->
  <section class="desktop-gutter-x py-24 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10">
      {[
        {
          num: '01',
          title: "Audit UX",
          desc: "Analyse systématique des parcours clés de votre produit : navigation, CTA, formulaires. Le résultat n'est pas juste des graphiques — ce sont des recommandations priorisées sur ce qu'il faut améliorer d'abord.",
          href: '/fr/services/audit-ux',
          tags: ["Analyse", "Recommandations", "Priorisation"],
        },
        {
          num: '02',
          title: "Tests utilisateurs",
          desc: "Scénarios de tâches avec de vrais utilisateurs : où ils hésitent, où ils se perdent, pourquoi ils partent. Modérés et non modérés, avec taux de réussite mesurable et insights qualitatifs.",
          href: '/fr/services/tests-utilisateurs',
          tags: ["Scénarios de tâches", "Taux de réussite", "Insights qualitatifs"],
        },
        {
          num: '03',
          title: "Eye Tracking",
          desc: "Enregistrement objectif de l'attention visuelle : fixations, temps jusqu'à la première fixation (TTFF), dwell time, métriques AOI, heatmaps et scanpaths. Ce que les gens voient vraiment — et ce qu'ils manquent.",
          href: '/fr/services/eye-tracking',
          tags: ["Heatmap", "AOI · TTFF", "Scanpath"],
        },
        {
          num: '04',
          title: "Recherche terrain",
          desc: "Eye-tracking et observation sur site — en magasin, en événement, en environnement réel. Lunettes d'eye-tracking mobiles et comportement authentique hors du laboratoire.",
          href: '/fr/services/recherche-terrain',
