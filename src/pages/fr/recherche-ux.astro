---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="fr"
  title="Recherche UX"
  description="Recherche utilisateur UX approfondie. Entretiens, tests d’utilisabilité, personas et journey maps."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ RECHERCHE UX ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          DES DONNÉES,<br/>PAS DES SUPPOSITIONS.
        </h1>
        <p class="text-xl text-brand-black/60 max-w-2xl leading-relaxed">
          Des décisions fondées sur des données, pas sur des conjectures. La recherche UX vous montre ce dont vos utilisateurs ont vraiment besoin.
        </p>
      </div>

      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ MÉTHODES DE RECHERCHE ]</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10">
          {[
            { title: 'Entretiens approfondis', type: 'Qualitatif', desc: 'Des entretiens individuels qui révèlent motivations, frustrations et modèles mentaux.' },
            { title: 'Tests d’utilisabilité', type: 'Qualitatif', desc: 'Nous observons les utilisateurs accomplir des tâches et identifions où ils échouent.' },
            { title: 'Recherche contextuelle', type: 'Qualitatif', desc: 'Nous observons les utilisateurs dans leur environnement naturel pour voir comment ils travaillent réellement.' },
            { title: 'Enquêtes', type: 'Quantitatif', desc: 'De grands ensembles de données pour des conclusions statistiquement pertinentes.' },
            { title: 'Tests A/B', type: 'Quantitatif', desc: 'Nous comparons des variantes de design sur du trafic réel et mesurons les résultats.' },
            { title: 'Card sorting', type: 'Mixte', desc: 'Nous découvrons comment les utilisateurs catégorisent les contenus pour améliorer l’architecture de l’information.' },
          ].map(method => (
            <div class="bg-brand-white p-8">
              <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5 mb-4 inline-block">{method.type}</span>
              <h3 class="font-display text-xl font-bold mb-3 mt-3">{method.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{method.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="mb-24 border-t border-brand-black/10 pt-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ CE QUE VOUS RECEVEZ ]</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          {[
            { title: 'Rapport de recherche', desc: 'Un document complet avec méthodologie, conclusions et recommandations.' },
            { title: 'Personas', desc: 'Des personnages fondés sur les données, représentant vos groupes d’utilisateurs clés.' },
            { title: 'Journey maps', desc: 'La visualisation du parcours utilisateur dans le produit, points de friction inclus.' },
            { title: 'Recommandations priorisées', desc: 'Des étapes concrètes ordonnées par impact et effort de mise en œuvre.' },
          ].map(item => (
            <div>
              <h3 class="font-display text-2xl font-bold mb-3">{item.title}</h3>
              <p class="text-brand-black/60 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="text-center py-16 border-t border-brand-black/10">
        <h2 class="font-display text-4xl font-bold mb-6">Apprenez à connaître vos utilisateurs en profondeur</h2>
        <a href="/fr/contact" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
          LANCER LA RECHERCHE →
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
