---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="fr"
  title="Études de cas"
  description="De vraies études d’eye tracking aux chiffres vérifiables : 40 % de candidats perdus, 92 % des regards sur le CTA principal, p = 0,037. Nous ne publions que ce que les données prouvent."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ ÉTUDES DE CAS ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          LES RÉSULTATS<br/>PARLENT<span style="color:#2D62FC">.</span>
        </h1>
        <p class="text-xl text-brand-black/60 max-w-3xl leading-relaxed">
          De vraies mesures, de vrais échantillons. Nous ne publions que des chiffres étayés par des données primaires — méthode, taille d’échantillon et limites comprises.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10">
        {[
          {
            category: "Automobile · portail carrière",
            title: "40 % des candidats n’ont pas trouvé les postes ouverts — sur un site pourtant « clair ».",
            desc: "L’eye tracking avec le scénario « trouvez les postes ouverts » a montré que la clarté perçue ne correspond pas à la réussite de la tâche. Une comparaison A/B d’un CTA flottant a produit des différences mesurables dans les métriques de fixation et la durée de visite. Résultat : un parcours simplifié et une navigation repensée.",
            method: "Eye tracking + questionnaire · N = 102",
            tags: ["Eye tracking", "Navigation", "Test A/B"],
            result: "40 % perdus",
          },
          {
            category: "Microsite éducatif",
            title: "92 % des regards ont fini sur le CTA principal. Seul un tiers a lu le long paragraphe.",
            desc: "L’analyse AOI a révélé un gradient de lecture : ~86 % des participants ont enregistré le titre en gras, 62 % le texte court et seulement ~33 % le long paragraphe. L’orientation vient de la hiérarchie, pas du volume de texte — le CTA principal a été renforcé, les longs blocs raccourcis.",
            method: "Eye tracking, analyse AOI · ~120 participants",
            tags: ["Analyse AOI", "Hiérarchie de contenu", "CTA"],
            result: "92 % sur le CTA",
          },
          {
            category: "E-commerce",
            title: "Les photos lifestyle sont plus belles. Mais elles ont ralenti la décision d’achat — mesurablement.",
            desc: "Une expérience a comparé un packshot épuré à une photo lifestyle. Le type de photo a eu un effet significatif sur le temps d’exécution de la tâche — F(1,82) = 4,50 ; p = 0,037. Pas d’effet clair sur les évaluations subjectives : « plus joli » ne veut pas dire « plus performant ».",
            method: "Eye tracking + UEQ · N = 84",
            tags: ["Photos produit", "Expérimentation", "PDP"],
            result: "Beau mais lent",
          },
          {
            category: "Créa publicitaire",
            title: "Là où regarde le personnage de votre bannière, votre client regarde aussi.",
            desc: "La manipulation de l’indice visuel (direction du regard du modèle) a eu un fort effet statistique sur la répartition de l’attention : F(1,102) = 12,57 ; p < 0,001 ; ηp² = 0,11 — un effet de taille moyenne. La direction du regard est l’un des outils les moins chers pour guider l’attention vers le message et le CTA.",
            method: "Expérience d’eye tracking · N = 104",
            tags: ["Bannières", "Indices visuels", "Attention"],
            result: "Le regard guide",
          },
          {
            category: "Templates e-shop",
            title: "Trois templates, le même assortiment. L’attention changeait selon la tâche donnée.",
            desc: "Le même template produisait des schémas d’attention différents selon la tâche reçue. Les évaluations esthétiques hors contexte de tâche sont trompeuses — testez votre template avec de vraies tâches d’achat, pas « à l’impression ».",
            method: "Eye tracking + VisAWI · N = 61",
            tags: ["E-commerce", "Esthétique vs performance", "Tests par tâches"],
            result: "Le contexte prime",
          },
          {
            category: "Marketing sportif · OOH",
            title: "16 maquettes d’affichage, 79 paires d’yeux. Les variantes noires minimalistes ont gagné.",
            desc: "Les six maquettes les mieux notées avaient toutes un fond noir ; la variante gagnante a obtenu le meilleur score TOP3 et le meilleur rang moyen. Insight le plus fort : la publicité visuelle influence 39 % des femmes contre 16 % des hommes. Recommandation : fond épuré, titre clair, composition non agressive.",
            method: "Eye tracking + questionnaire d’évaluation · N = 79 · 16 stimuli de 10 s",
            tags: ["Affichage", "OOH", "Insight genre"],
            result: "39 % vs 16 %",
          },
        ].map(study => (
          <div class="bg-brand-white p-10 flex flex-col">
            <div class="flex flex-col gap-2 md:flex-row md:justify-between md:items-start mb-6">
              <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5 self-start">{study.category}</span>
              <a href={study.href} class="font-display text-2xl font-bold leading-none md:text-right hover:opacity-70 transition-opacity" style="color:#2D62FC">{study.result}</a>
            </div>
            <h3 class="font-display text-2xl font-bold mb-4 leading-tight"><a href={study.href} class="hover:opacity-60 transition-opacity">{study.title}</a></h3>
            <p class="text-brand-black/60 leading-relaxed mb-6">{study.desc}</p>
            <p class="font-mono text-[11px] text-brand-black/60 tracking-wide mb-6">MÉTHODE : {study.method}</p>
            <div class="flex flex-wrap gap-2 mt-auto">
              {study.tags.map(tag => (
                <span class="font-mono text-xs text-brand-black/60 border border-brand-black/10 px-2 py-1">{tag}</span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <details class="group border border-brand-black/15 mt-6">
        <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
          [ GLOSSAIRE ]
          <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <dl class="px-5 pb-6 space-y-4">
            <div><dt class="font-display font-bold mb-1">p</dt><dd class="text-sm text-brand-black/70 leading-relaxed">probabilité que le résultat soit dû au hasard (0,037 = 3,7 % — plus c’est bas, plus c’est concluant)</dd></div>
            <div><dt class="font-display font-bold mb-1">ηp²</dt><dd class="text-sm text-brand-black/70 leading-relaxed">taille d’effet (0,11 ≈ effet moyen, visible en pratique)</dd></div>
            <div><dt class="font-display font-bold mb-1">N</dt><dd class="text-sm text-brand-black/70 leading-relaxed">nombre de personnes testées</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">zone observée de la page</dd></div>
        </dl>
      </details>

      <div class="text-center py-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ ENVIE DE TELLES DONNÉES POUR VOTRE SITE ? ]</p>
        <h2 class="font-display text-5xl font-bold mb-8">Mesurons votre projet</h2>
        <a href="/fr/contact" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
          DEMANDER UN DEVIS →
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
