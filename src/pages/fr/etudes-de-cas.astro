---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  lang="fr"
  title="Études de cas"
  description="De vraies mesures d’eye tracking aux chiffres vérifiables : 40 % des candidats n’ont pas trouvé les postes ouverts, le CTA a été remarqué par 92 % des participants, p = 0,037. Nous indiquons la méthode, l’échantillon et les limites."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ ÉTUDES DE CAS ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          CE QU’A RÉVÉLÉ<br/>LA MESURE<span style="color:#2D62FC">.</span>
        </h1>
        <p class="text-xl text-brand-black/60 max-w-3xl leading-relaxed">
          De vraies mesures, de vrais échantillons. Nous ne publions que des chiffres étayés par des données primaires — méthode, taille d’échantillon et limites comprises.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10">
        {[
          {
            category: "ŠKODA AUTO · portail carrière",
            href: "/fr/etudes-de-cas/portail-carriere-automobile",
            title: "40 % des candidats n’ont pas trouvé les postes ouverts — sur un site pourtant « clair ».",
            desc: "L’eye tracking avec le scénario « trouvez les postes ouverts » a montré que la clarté perçue ne correspond pas à la réussite de la tâche. Une comparaison A/B d’un CTA flottant a produit des différences mesurables dans les métriques de fixation et la durée de visite. Résultat : un parcours simplifié et une navigation repensée.",
            method: "Eye tracking + questionnaire · N = 102",
            tags: ["Eye tracking", "Navigation", "Test A/B"],
            result: "4 candidats sur 10 n’ont pas trouvé les postes",
          },
          {
            category: "Microsite éducatif",
            href: "/fr/etudes-de-cas/backend-stories",
            title: "Plus le texte est long, moins il capte l’attention.",
            desc: "L’analyse AOI a révélé un gradient d’attention : le titre en gras a été enregistré par environ 86 % des participants, le texte court qui suit par 62 % et le long paragraphe par 33 %. Les résultats ont conduit à mettre en avant le CTA principal et à raccourcir les longs blocs.",
            method: "Eye tracking, analyse AOI · env. 120 participants",
            tags: ["Analyse AOI", "Hiérarchie de contenu", "CTA"],
            result: "92 % ont remarqué le CTA",
          },
          {
            category: "E-commerce",
            href: "/fr/etudes-de-cas/photographie-produit-e-commerce",
            title: "Même produit. Un temps de décision différent.",
            desc: "L’expérience a comparé un packshot épuré à une photo lifestyle. Le type de photo a influencé de façon statistiquement significative la durée d’exécution de la tâche — F(1,82) = 4,50 ; p = 0,037. La variante lifestyle a entraîné un temps plus long dans le scénario testé ; la différence dans l’évaluation subjective n’a pas été clairement confirmée.",
            method: "Eye tracking + UEQ · N = 84",
            tags: ["Photos produit", "Expérimentation", "PDP"],
            result: "Le lifestyle a rallongé la tâche",
          },
          {
            category: "Créa publicitaire",
            href: "/fr/etudes-de-cas/bannieres-direction-regard",
            title: "Le regard du personnage a orienté l’attention des visiteurs.",
            desc: "Le changement de direction du regard du personnage a statistiquement influencé de façon significative la répartition de l’attention : F(1,102) = 12,57 ; p < 0,001 ; ηp² = 0,11. L’expérience a démontré un effet de taille moyenne sur les créations testées ; elle n’a mesuré ni les clics ni la conversion.",
            method: "Expérience d’eye tracking · N = 104",
            tags: ["Bannières", "Indices visuels", "Attention"],
            result: "ηp² = 0,11 · effet moyen",
          },
          {
            category: "Templates e-shop",
            href: "/fr/etudes-de-cas/modeles-boutique-en-ligne",
            title: "La tâche a changé où les gens ont porté leur attention.",
            desc: "L’eye tracking de trois templates avec le même assortiment a montré que la répartition de l’attention changeait selon la tâche donnée. VisAWI a complété l’évaluation subjective de l’apparence — l’étude montre ainsi pourquoi il faut évaluer séparément l’esthétique et le comportement pendant une tâche d’achat.",
            method: "Eye tracking + VisAWI · N = 61",
            tags: ["E-commerce", "Esthétique vs performance", "Tests par tâches"],
            result: "3 templates · 2 types de tâche",
          },
          {
            category: "Marketing sportif · publicité extérieure",
            href: "/fr/etudes-de-cas/panneaux-sport-marketing",
            title: "Les six premières places sont revenues aux panneaux noirs.",
            desc: "L’eye tracking et l’évaluation de 16 maquettes ont montré une préférence claire pour les variantes noires. Les seules métriques de fixation n’ont toutefois pas déterminé le gagnant — l’étude montre pourquoi il faut associer l’attention à l’évaluation du public cible lors du choix d’une création.",
            method: "Eye tracking + questionnaire d’évaluation · N = 79 · 16 stimuli de 10 s",
            tags: ["Billboard", "OOH", "Insight genre"],
            result: "TOP 6 · fond noir",
          },
        ].map(study => (
          <div class="bg-brand-white p-10 flex flex-col">
            <div class="flex flex-col gap-2 md:flex-row md:justify-between md:items-start mb-6">
              <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5 self-start">{study.category}</span>
              <a href={study.href} class="font-display text-lg font-bold leading-tight md:text-right md:whitespace-nowrap hover:opacity-70 transition-opacity" style="color:#2D62FC">{study.result}</a>
            </div>
            <h3 class="font-display text-2xl font-bold mb-4 leading-tight"><a href={study.href} class="hover:opacity-60 transition-opacity">{study.title}</a></h3>
            <p class="text-brand-black/60 leading-relaxed mb-6 text-justify">{study.desc}</p>
            <p class="font-mono text-[11px] text-brand-black/60 tracking-wide mb-6">MÉTHODE : {study.method}</p>
            <div class="flex flex-wrap gap-2 mt-auto mb-6">
              {study.tags.map(tag => (
                <span class="font-mono text-xs text-brand-black/60 border border-brand-black/10 px-2 py-1">{tag}</span>
              ))}
            </div>
            <a href={study.href} class="inline-block self-start border border-brand-black px-5 py-2.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              VOIR L’ÉTUDE →
            </a>
          </div>
        ))}
      </div>

      <details class="group border border-brand-black/15 mt-6">
        <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
          [ GLOSSAIRE ]
          <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <dl class="px-5 pb-6 space-y-4">
            <div><dt class="font-display font-bold mb-1">p</dt><dd class="text-sm text-brand-black/70 leading-relaxed">probabilité que le résultat soit dû au hasard (0,037 = 3,7 % — plus c’est bas, plus c’est concluant)</dd></div>
            <div><dt class="font-display font-bold mb-1">ηp²</dt><dd class="text-sm text-brand-black/70 leading-relaxed">taille d’effet (0,11 ≈ effet moyen, visible en pratique)</dd></div>
            <div><dt class="font-display font-bold mb-1">N</dt><dd class="text-sm text-brand-black/70 leading-relaxed">nombre de personnes testées</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">zone observée de la page</dd></div>
        </dl>
      </details>

    </div>
  </main>

  <Footer />
</BaseLayout>
