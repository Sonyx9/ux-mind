---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const partners = [
  {
    num: '01',
    name: 'Univerzita Hradec Králové',
    claim: 'Assise de recherche et méthodologie.',
    logo: `${base}/logos/uhk.svg`,
    logoAlt: 'Logo de l’Univerzita Hradec Králové',
    logoClass: 'h-16 md:h-20',
    text: [
      'Au Laboratoire d’études cognitives de la FIM UHK, nous testons des interfaces numériques et physiques, en conditions contrôlées comme sur le terrain. Cette assise nous permet de préparer la méthodologie, de vérifier le scénario et de relier l’eye tracking à d’autres méthodes de recherche.',
      'L’environnement de recherche comprend aussi des publications scientifiques, des travaux étudiants et le développement de méthodes propres, dont l’indice de charge mentale EMLI.',
    ],
    tags: ['FIM UHK', 'Laboratoire', 'EMLI'],
    links: [
      { label: 'UHK.CZ →', href: 'https://www.uhk.cz' },
      { label: 'FACULTÉ D’INFORMATIQUE ET DE MANAGEMENT', href: 'https://www.uhk.cz/cs/fakulta-informatiky-a-managementu' },
    ],
  },
  {
    num: '02',
    name: 'MindSense',
    claim: 'Technologie et support expert.',
    logo: `${base}/logos/mindsense.webp`,
    logoAlt: 'Logo MindSense — solutions pour laboratoires de recherche',
    logoClass: 'h-10 md:h-12',
    text: [
      'MindSense a participé à l’extension du laboratoire avec de nouveaux équipements de recherche et assure le support expert des technologies utilisées. C’est le distributeur exclusif et agréé de Tobii pour la République tchèque et la Slovaquie.',
      'Il aide à relier l’eye tracking, les biocapteurs, la réalité virtuelle et les logiciels afin que les différentes sources de données fonctionnent comme un seul ensemble de recherche.',
    ],
    tags: ['Tobii', 'Biocapteurs', 'VR'],
    links: [
      { label: 'MINDSENSE.CZ →', href: 'https://mindsense.cz' },
    ],
  },
];

const pageSchema = [
  {
    '@type': 'WebPage',
    name: 'Partenaires UX MIND',
    description: 'Partenaires UX MIND : Univerzita Hradec Králové fournit l’assise de recherche et MindSense le support technologique et expert.',
  },
];
---

<BaseLayout
  lang="fr"
  title="Partenaires du projet"
  description="Partenaires UX MIND : Univerzita Hradec Králové fournit l’assise de recherche et MindSense le support technologique et expert."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ PARTENAIRES ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          NOUS NE MESURONS<br/>PAS SEULS<span style="color:#2D62FC">.</span>
        </h1>
        <p class="text-lg text-brand-black/60 leading-relaxed max-w-3xl text-justify">
          Une recherche de qualité ne repose pas que sur la technique. Elle a besoin d’une méthodologie
          rigoureuse, d’un équipement fiable et de personnes capables d’interpréter les données. UX MIND
          relie donc <strong class="text-brand-black">l’assise de recherche de la FIM UHK au savoir-faire technologique de MindSense</strong>.
        </p>
      </div>

      <!-- Partneři -->
      <div class="space-y-px border border-brand-black/10">
        {partners.map(p => (
          <div class="reveal p-8 md:p-12 border-b border-brand-black/10 last:border-0">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-10 items-start">
              <!-- Logo -->
              <div class="flex flex-col gap-6">
                <span class="font-mono text-xs text-brand-black/60">{p.num}</span>
                <img src={p.logo} alt={p.logoAlt} class={`${p.logoClass} w-auto object-contain self-start`} loading="lazy" decoding="async" />
                <div class="flex flex-wrap gap-2">
                  {p.tags.map(tag => (
                    <span class="font-mono text-[11px] border border-brand-black/20 px-2 py-1 tracking-widest">{tag}</span>
                  ))}
                </div>
              </div>
              <!-- Text -->
              <div class="md:col-span-2">
                <h2 class="font-display text-3xl md:text-4xl font-bold mb-2">{p.name}</h2>
                <p class="font-mono text-xs text-brand-black/60 tracking-widest uppercase mb-6">{p.claim}</p>
                {p.text.map(t => (
                  <p class="text-brand-black/60 leading-relaxed mb-4 max-w-2xl text-justify">{t}</p>
                ))}
                <div class="flex flex-wrap gap-4 mt-6">
                  {p.links.map(l => (
                    <a href={l.href} target="_blank" rel="noopener noreferrer" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                      {l.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Jak spolupráce zapadá do měření -->
      <div class="reveal mt-24 grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          { t: 'Assise de recherche', d: 'Le laboratoire FIM UHK fournit les conditions pour préparer, tester en pilote et réaliser les études.', tag: 'UHK' },
          { t: 'Support technologique', d: 'MindSense aide avec l’équipement, sa mise en réseau et un support expert.', tag: 'MINDSENSE' },
          { t: 'Résultat pour le client', d: 'UX MIND transforme les données mesurées en conclusions claires et en recommandations concrètes.', tag: 'UX MIND' },
        ].map((v, i) => (
          <div class="bg-brand-white p-8 flex flex-col h-full">
            <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
            <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
            <p class="text-sm text-brand-black/60 leading-relaxed mb-6 text-justify">{v.d}</p>
            <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest self-start mt-auto">{v.tag}</span>
          </div>
        ))}
      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
