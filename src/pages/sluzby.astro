---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Služby"
  description="UX audit webu i e-shopu, eye tracking, UX výzkum, uživatelské testování a terénní měření s mobilními eye-tracking brýlemi. Doporučení podložená daty, ne dojmy."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Header -->
      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ NAŠE SLUŽBY ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter" style="font-size: clamp(3rem, 9vw, 8rem);">
          CO<br/>DĚLÁME<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <!-- Services list -->
      <div class="space-y-px border border-brand-black/10">
        {[
          // Řazení: od rychlého základu (audit) po nejkomplexnější výzkum
          {
            num: '01',
            id: 'ux-audit',
            href: '/sluzby/ux-audit',
            title: 'UX Audit',
            desc: 'Rychlý základ každého zlepšování. Systematická analýza vašeho digitálního produktu — procházíme rozhraní z pohledu uživatele, identifikujeme bariéry a navrhujeme konkrétní zlepšení s prioritizací podle dopadu.',
            details: ['Heuristická analýza', 'Analýza tok uživatele', 'Prioritizovaný seznam doporučení', 'Workshop s týmem', 'Výstupní zpráva s mockupy'],
            duration: '2–4 týdny',
            pkg: 'Rychlá diagnostika',
          },
          {
            num: '02',
            id: 'testovani-uzivatelu',
            href: '/sluzby/testovani-uzivatelu',
            title: 'Testování uživatelů',
            desc: 'Moderované i nemoderované testy s reálnými uživateli. Sledujeme jak uživatelé plní úkoly ve vašem produktu a identifikujeme, kde selhávají.',
            details: ['Moderované session testy', 'Nemoderované online testy', 'Think-aloud protokol', 'Záznam obrazovky', 'Analýza a doporučení'],
            duration: '1–4 týdny',
            pkg: 'Standardní UX test',
          },
          {
            num: '03',
            href: '/sluzby/eye-tracking',
            title: 'Eye Tracking',
            desc: 'Přesná data o vizuálním vnímání vašeho obsahu. Sledujeme pohyb očí uživatelů při interakci s webem, aplikací nebo tiskovými materiály.',
            details: ['Heatmapy pozornosti', 'Analýza AOI (Areas of Interest)', 'Záznamy pohybu očí', 'F-pattern & Z-pattern analýza', 'Srovnávací testování variant'],
            duration: '1–3 týdny',
            pkg: 'Standardní UX test',
          },
          {
            num: '04',
            id: 'terenni-mereni',
            href: '/sluzby/terenni-mereni',
            title: 'Terénní měření',
            desc: 'Měříme tam, kde se zákazník skutečně rozhoduje — v prodejně, showroomu, na eventu nebo u fyzického produktu. Mobilní eye-tracking brýle zachytí pozornost v reálném prostředí, ne jen na obrazovce. Vybavení, které v ČR jen tak někdo nemá.',
            details: ['Mobilní eye-tracking brýle Pupil Labs NEON', 'Videozáznam situace a chování v prostoru', 'GSR a rozhovory podle potřeby', 'Product placement, značení, POS materiály', 'Doporučení pro úpravu prostoru a zákaznické cesty'],
            duration: '2–6 týdnů',
            pkg: 'Terénní studie',
          },
          {
            num: '05',
            href: '/sluzby/ux-vyzkum',
            title: 'UX Výzkum',
            desc: 'Nejhlubší rozsah: kombinace kvalitativních a kvantitativních metod. Pomáháme porozumět potřebám, frustracím a mentálním modelům vašich uživatelů.',
            details: ['Hloubkové rozhovory', 'Kontextuální výzkum', 'Testování použitelnosti', 'Analýza dat', 'Personas & Journey mapy'],
            duration: '3–8 týdnů',
            pkg: 'Komplexní biometrický výzkum',
          },
        ].map(service => (
          <div id={service.id} class="p-8 md:p-12 border-b border-brand-black/10 last:border-0 scroll-mt-28">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <div class="md:col-span-2">
                <div class="flex items-baseline gap-4 mb-4">
                  <span class="font-mono text-xs text-brand-black/60">{service.num}</span>
                  <h2 class="font-display text-3xl md:text-4xl font-bold">
                    <a href={service.href} class="hover:opacity-60 transition-opacity">{service.title}</a>
                  </h2>
                </div>
                <p class="text-brand-black/60 leading-relaxed mb-6">{service.desc}</p>
                <ul class="space-y-1">
                  {service.details.map(d => (
                    <li class="font-mono text-xs text-brand-black/60 flex gap-2">
                      <span>→</span> {d}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="flex flex-col justify-between">
                <div>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">DÉLKA PROJEKTU</p>
                  <p class="font-display text-lg font-semibold">{service.duration}</p>
                  <p class="font-mono text-xs text-brand-black/60 tracking-widest mt-4 mb-1">TYPICKÝ BALÍČEK</p>
                  <a href="/sluzby/testovaci-balicky" class="font-display text-lg font-semibold underline hover:no-underline">{service.pkg}</a>
                </div>
                <div class="flex flex-col gap-2 mt-6">
                  <a href={service.href} class="inline-block bg-brand-black text-brand-white border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors text-center">
                    DETAIL SLUŽBY →
                  </a>
                  <a href="/kontakt" class="inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors text-center">
                    NEZÁVAZNĚ SE ZEPTAT
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Testovací balíčky -->
      <div class="mt-24 bg-brand-black text-brand-white p-8 md:p-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
          <div class="md:col-span-2">
            <p class="font-mono text-xs text-brand-white/60 tracking-widest mb-4">[ TESTOVACÍ BALÍČKY ]</p>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-4">Od rychlé diagnostiky po komplexní biometrický výzkum</h2>
            <p class="text-brand-white/70 leading-relaxed max-w-2xl">
              Služby skládáme do testovacích balíčků podle rozhodnutí, které potřebujete udělat — eye-tracking, behaviorální data, dotazníky, GSR i terénní měření. Předem víte, co z testování získáte i co z daného rozsahu nepůjde spolehlivě tvrdit.
            </p>
          </div>
          <div class="flex md:justify-end">
            <a href="/sluzby/testovaci-balicky" class="inline-block border border-brand-white px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              PROHLÉDNOUT BALÍČKY →
            </a>
          </div>
        </div>
      </div>

      <!-- Pro koho — odkaz na segmenty -->
      <a href="/segmenty" class="block border border-brand-black/10 p-8 md:p-10 mt-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3 group-hover:text-brand-white/60">[ PRO KOHO ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold leading-tight">Kde všude to dává smysl<span style="color:#2D62FC">?</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed mt-2 group-hover:text-brand-white/70">Stejná metoda, devět oborů — od e-shopu po stadion. Podívejte se, co konkrétně měříme ve vašem segmentu.</p>
          </div>
          <span class="shrink-0 font-mono text-xs tracking-widest uppercase group-hover:text-brand-white">VŠECHNY SEGMENTY →</span>
        </div>
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
