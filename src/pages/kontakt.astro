---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Kontakt"
  description="Domluvte si nezávaznou konzultaci uživatelského testování, UX auditu webu nebo eye trackingu. Odpovídáme do 48 hodin."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ KONTAKT ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          POJĎME TO<br/>OVĚŘIT<span style="color:#2D62FC">.</span>
        </h1>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-16">

        <!-- Contact info -->
        <div>
          <p class="text-xl text-brand-black/60 leading-relaxed mb-12">
            Pošlete nám web, aplikaci, kampaň nebo stručný popis problému. Ozveme se do 48 hodin a navrhneme, co má smysl ověřit a jaký postup zvolit.
          </p>

          <div class="space-y-6">
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">EMAIL</p>
              <a href="mailto:spoluprace@uxmind.cz" class="font-display text-2xl font-bold hover:text-brand-blue transition-colors">
                spoluprace@uxmind.cz
              </a>
            </div>
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">TELEFON</p>
              <a href="tel:+420728601160" class="font-display text-2xl font-bold hover:text-brand-blue transition-colors">
                +420 728 601 160
              </a>
            </div>
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">SÍDLO</p>
              <p class="font-display text-xl font-bold">K Lesu 180, Svinary<br/>500 09 Hradec Králové</p>
            </div>
          </div>

        </div>

        <!-- Contact form -->
        <div class="relative min-h-[620px]">
          <div class="absolute inset-0 z-10 border border-brand-black/10 bg-brand-white/95 flex items-center justify-center p-8 text-center">
            <div class="max-w-sm">
              <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ KONTAKTNÍ FORMULÁŘ ]</p>
              <p class="font-display text-4xl md:text-5xl font-bold tracking-tight mb-5">PŘIPRAVUJEME<span class="text-brand-blue">.</span></p>
              <p class="text-brand-black/60 leading-relaxed">
                Než formulář spustíme, napište nám na <a href="mailto:spoluprace@uxmind.cz" class="font-bold text-brand-black hover:text-brand-blue transition-colors">spoluprace@uxmind.cz</a>.
              </p>
            </div>
          </div>
          <form class="space-y-6 opacity-20 pointer-events-none select-none" aria-hidden="true">
            <fieldset disabled>
            <div class="space-y-6">
            <div>
              <label for="f-name" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">JMÉNO *</label>
              <input
                type="text"
                id="f-name"
                name="name"
                required
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent"
                placeholder="Vaše jméno"
              />
            </div>

            <div>
              <label for="f-email" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">EMAIL *</label>
              <input
                type="email"
                id="f-email"
                name="email"
                required
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent"
                placeholder="vas@email.cz"
              />
            </div>

            <div>
              <label for="f-company" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">FIRMA</label>
              <input
                type="text"
                id="f-company"
                name="company"
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent"
                placeholder="Název firmy"
              />
            </div>

            <div>
              <label for="f-service" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">ČEHO SE PROJEKT TÝKÁ</label>
              <select
                id="f-service"
                name="service"
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent appearance-none"
              >
                <option value="">Vyberte oblast...</option>
                <option value="ux-audit">UX Audit</option>
                <option value="eye-tracking">Eye Tracking</option>
                <option value="ux-vyzkum">UX Výzkum</option>
                <option value="testovani">Testování uživatelů</option>
                <option value="konzultace">Konzultace</option>
                <option value="jine">Jiné</option>
              </select>
            </div>

            <div>
              <label for="f-message" class="font-mono text-xs text-brand-black/60 tracking-widest block mb-2">CO POTŘEBUJETE ZJISTIT? *</label>
              <textarea
                id="f-message"
                name="message"
                required
                rows="5"
                class="w-full border border-brand-black/20 px-4 py-3 font-sans text-base focus:outline-none focus:border-brand-black transition-colors bg-transparent resize-none"
                placeholder="Stačí stručně popsat projekt, problém nebo rozhodnutí, se kterým potřebujete pomoci."
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors"
            >
              ODESLAT DOTAZ →
            </button>
            </div>
            </fieldset>
          </form>
        </div>
      </div>

      <!-- Provozovatel a bankovní spojení -->
      <div class="mt-16 border border-brand-black/10 p-8 md:p-10">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ PROVOZOVATEL WEBU ]</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-8 text-sm">
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">NÁZEV SUBJEKTU</p>
            <p class="text-brand-black/80">UX MIND Research Lab s.r.o.</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">IČO</p>
            <p class="text-brand-black/80">29714966</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">DEN ZÁPISU</p>
            <p class="text-brand-black/80">24. června 2026</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">SPISOVÁ ZNAČKA</p>
            <p class="text-brand-black/80">C 57053 vedená u Krajského soudu v Hradci Králové</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">SÍDLO</p>
            <p class="text-brand-black/80">K Lesu 180, Svinary, 500 09 Hradec Králové</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">BANKA</p>
            <p class="text-brand-black/80">MONETA Money Bank, a.s.</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">ČÍSLO ÚČTU</p>
            <p class="text-brand-black/80">283221603/0600</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">IBAN</p>
            <p class="text-brand-black/80 break-words">CZ96 0600 0000 0002 8322 1603</p>
          </div>
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-1">SWIFT / BIC</p>
            <p class="text-brand-black/80">AGBACZPP</p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
