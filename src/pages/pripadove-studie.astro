---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Případové studie"
  description="Reálná eye tracking měření s doložitelnými čísly: 40 % uchazečů nenašlo volné pozice, CTA zaznamenalo 92 % respondentů, p = 0,037. Uvádíme metodu, vzorek i limity."
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ PŘÍPADOVÉ STUDIE ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          CO ODHALILO<br/>MĚŘENÍ<span style="color:#2D62FC">.</span>
        </h1>
        <p class="text-xl text-brand-black/60 max-w-3xl leading-relaxed">
          Reálná měření, reálné vzorky. Uvádíme jen čísla, která umíme doložit primárními daty — včetně metody, velikosti vzorku a limitů.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10">
        {[
          {
            category: "ŠKODA AUTO · kariérní portál",
            href: "/pripadove-studie/karierni-portal-automotive",
            title: "40 % uchazečů nenašlo cestu k volným pozicím. Web přitom „vypadal přehledně“.",
            desc: "Eye-tracking se scénářem „najděte volné pozice“ ukázal, že subjektivní hodnocení přehlednosti neodpovídá schopnosti splnit úkol. A/B porovnání plovoucího CTA přineslo měřitelné rozdíly ve fixačních metrikách i délce návštěvy. Výsledkem bylo zjednodušení cesty k pozicím a přestavba navigace.",
            method: "Eye-tracking + dotazník · N = 102",
            tags: ["Eye tracking", "Navigace", "A/B test"],
            result: "4 z 10 nenašli volné pozice",
          },
          {
            category: "Edukační microsite",
            href: "/pripadove-studie/backend-stories",
            title: "Čím delší text, tím méně pozornosti.",
            desc: "AOI analýza odhalila gradient pozornosti: výrazný nadpis zaznamenalo přibližně 86 % respondentů, krátký návazný text 62 % a dlouhý odstavec 33 %. Výsledky podpořily zvýraznění primárního CTA a zkrácení dlouhých bloků.",
            method: "Eye-tracking, AOI analýza · cca 120 respondentů",
            tags: ["AOI analýza", "Hierarchie obsahu", "CTA"],
            result: "92 % zaznamenalo CTA",
          },
          {
            category: "E-commerce",
            href: "/pripadove-studie/produktove-fotografie-e-commerce",
            title: "Stejný produkt. Jinak dlouhé rozhodování.",
            desc: "Experiment porovnal čistý packshot s lifestyle fotografií. Typ fotografie statisticky významně ovlivnil dobu plnění úkolu — F(1,82) = 4,50; p = 0,037. Lifestyle varianta vedla v testovaném scénáři k delšímu času, rozdíl v subjektivním hodnocení se jednoznačně nepotvrdil.",
            method: "Eye-tracking + UEQ · N = 84",
            tags: ["Produktové foto", "Experiment", "PDP"],
            result: "Lifestyle prodloužil dobu úkolu",
          },
          {
            category: "Reklamní kreativa",
            href: "/pripadove-studie/reklamni-bannery-smer-pohledu",
            title: "Pohled postavy nasměroval pozornost návštěvníků.",
            desc: "Změna směru pohledu postavy statisticky významně ovlivnila rozložení pozornosti: F(1,102) = 12,57; p < 0,001; ηp² = 0,11. Experiment doložil středně velký efekt v testovaných kreativách; kliknutí ani konverzi neměřil.",
            method: "Eye-tracking experiment · N = 104",
            tags: ["Bannery", "Vizuální vodítka", "Pozornost"],
            result: "ηp² = 0,11 · střední efekt",
          },
          {
            category: "E-shop šablony",
            href: "/pripadove-studie/sablony-e-shopu",
            title: "Úkol změnil, kam lidé zaměřili pozornost.",
            desc: "Eye tracking tří šablon se shodným sortimentem ukázal, že se rozložení pozornosti měnilo podle zadaného úkolu. VisAWI doplnil subjektivní hodnocení vzhledu — studie tak ukazuje, proč je potřeba estetiku a chování při nákupním úkolu posuzovat odděleně.",
            method: "Eye-tracking + VisAWI · N = 61",
            tags: ["E-commerce", "Estetika vs. výkon", "Úkolové testování"],
            result: "3 šablony · 2 typy úkolu",
          },
          {
            category: "Sport marketing · venkovní reklama",
            href: "/pripadove-studie/billboardy-sport-marketing",
            title: "Prvních šest míst patřilo černým billboardům.",
            desc: "Eye tracking a hodnocení 16 návrhů ukázaly jasnou preferenci černých variant. Samotné fixační metriky však vítěze neurčily — studie ukazuje, proč je při výběru kreativy potřeba spojit pozornost s hodnocením cílové skupiny.",
            method: "Eye-tracking + hodnotící dotazník · N = 79 · 16 stimulů á 10 s",
            tags: ["Billboard", "OOH", "Gender insight"],
            result: "TOP 6 · černé pozadí",
          },
        ].map(study => (
          <div class="bg-brand-white p-10 flex flex-col">
            <div class="flex flex-col gap-2 md:flex-row md:justify-between md:items-start mb-6">
              <span class="font-mono text-xs text-brand-black/60 border border-brand-black/20 px-2 py-0.5 self-start">{study.category}</span>
              <a href={study.href} class="font-display text-lg font-bold leading-tight md:text-right md:whitespace-nowrap hover:opacity-70 transition-opacity" style="color:#2D62FC">{study.result}</a>
            </div>
            <h3 class="font-display text-2xl font-bold mb-4 leading-tight"><a href={study.href} class="hover:opacity-60 transition-opacity">{study.title}</a></h3>
            <p class="text-brand-black/60 leading-relaxed mb-6 text-justify">{study.desc}</p>
            <p class="font-mono text-[11px] text-brand-black/60 tracking-wide mb-6">METODA: {study.method}</p>
            <div class="flex flex-wrap gap-2 mt-auto mb-6">
              {study.tags.map(tag => (
                <span class="font-mono text-xs text-brand-black/60 border border-brand-black/10 px-2 py-1">{tag}</span>
              ))}
            </div>
            <a href={study.href} class="inline-block self-start border border-brand-black px-5 py-2.5 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              PROJÍT STUDII →
            </a>
          </div>
        ))}
      </div>

      <details class="group border border-brand-black/15 mt-6">
        <summary class="flex justify-between items-center gap-6 cursor-pointer p-5 font-mono text-xs tracking-widest list-none [&::-webkit-details-marker]:hidden">
          [ SLOVNÍK POJMŮ ]
          <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <dl class="px-5 pb-6 space-y-4">
            <div><dt class="font-display font-bold mb-1">p</dt><dd class="text-sm text-brand-black/70 leading-relaxed">pravděpodobnost, že výsledek vznikl náhodou (0,037 = 3,7 % — čím méně, tím průkaznější)</dd></div>
            <div><dt class="font-display font-bold mb-1">ηp²</dt><dd class="text-sm text-brand-black/70 leading-relaxed">velikost efektu (0,11 ≈ středně silný vliv v praxi)</dd></div>
            <div><dt class="font-display font-bold mb-1">N</dt><dd class="text-sm text-brand-black/70 leading-relaxed">počet testovaných lidí</dd></div>
            <div><dt class="font-display font-bold mb-1">AOI</dt><dd class="text-sm text-brand-black/70 leading-relaxed">sledovaná oblast stránky</dd></div>
        </dl>
      </details>

      <a href="/segmenty" class="block border border-brand-black/10 p-8 md:p-10 mt-6 hover:bg-brand-black hover:text-brand-white transition-colors group">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3 group-hover:text-brand-white/60">[ PRO KOHO MĚŘÍME ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold leading-tight">Hledáte data přesně pro svůj obor<span style="color:#2D62FC">?</span></h2>
            <p class="text-sm text-brand-black/60 leading-relaxed mt-2 group-hover:text-brand-white/70">E-shopy, sport, automotive, univerzity a další. U každého segmentu poctivě uvádíme, co máme doložené vlastními daty.</p>
          </div>
          <span class="shrink-0 font-mono text-xs tracking-widest uppercase group-hover:text-brand-white">VŠECHNY SEGMENTY →</span>
        </div>
      </a>

    </div>
  </main>

  <Footer />
</BaseLayout>
