---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const fotkaLegenda = [
  ['Eye tracker', 'Lišta pod monitorem snímá pohyb očí 60× za sekundu.'],
  ['Analýza mimiky', 'Kamera nad monitorem rozpoznává výraz obličeje.'],
  ['Reálný úkol', 'Respondentka plní zadání na reálné stránce — neříká, co se jí líbí.'],
];

const vrstvy = [
  {
    t: 'Vizuální pozornost',
    d: 'Kam se člověk podívá, v jakém pořadí, jak dlouho tam zůstane a co mine úplně. Heatmapy, oblasti zájmu, doba do první fixace, doba prohlížení.',
    tag: 'EYE TRACKING',
  },
  {
    t: 'Emoce a aktivace',
    d: 'Co dotazník nezachytí, protože o tom člověk neví nebo to nepřizná. Kožní vodivost měří fyziologickou reakci, analýza mimiky rozpoznává výraz obličeje.',
    tag: 'GSR + MIMIKA',
  },
  {
    t: 'Kognitivní zátěž',
    d: 'Kolik úsilí stojí použití rozhraní. Zátěž je tichý zabiják konverze i srozumitelnosti — uživatel neodejde s tím, že „to bylo náročné“, prostě odejde.',
    tag: 'MENTÁLNÍ ÚSILÍ',
  },
];

const vybaveni = [
  { nazev: 'Smart Eye Aurora', typ: 'stolní eye tracking', k: 'Současná konfigurace pro řízené studie na obrazovce.' },
  { nazev: 'Tobii Pro X2-60', typ: 'stolní eye tracking', k: 'Platforma 60 Hz, přenosná sestava pro fixačně orientované studie.' },
  { nazev: 'Pupil Labs Neon (2×)', typ: 'mobilní brýle', k: 'Měření v reálném prostředí — prodejna, stadion, provoz, ulice.' },
  { nazev: 'iMotions + analýza mimiky', typ: 'software', k: 'Synchronizace všech signálů se stimuly a rozpoznání výrazu obličeje.' },
  { nazev: 'Shimmer3 GSR', typ: 'biometrie', k: 'Kožní vodivost — fyziologická reakce a míra aktivace.' },
];

const postup = [
  { num: '01', title: 'Návrh studie', desc: 'Výzkumná otázka, definice metrik, velikost a struktura vzorku, scénáře úkolů.' },
  { num: '02', title: 'Sběr dat', desc: 'Protokol pro laboratoř nebo terén, kalibrace, stimuly, souběžný záznam všech signálů.' },
  { num: '03', title: 'Analýza', desc: 'Metriky nad oblastmi zájmu, časové ukazatele, propojení pohledu s biometrií, statistika.' },
  { num: '04', title: 'Přenos do praxe', desc: 'Prioritizovaná doporučení, report s metodikou a workshop s vaším týmem.' },
];

const rizika = [
  'posun kalibrace v průběhu měření',
  'únava respondentů',
  'efekt pořadí — proto randomizace a protivyvážení',
  'nejednoznačně zadaný úkol',
  'přeceňování jediné metriky',
];

const etika = [
  'Standardizovaný protokol a pilotní testování před každou studií',
  'Informovaný souhlas každého respondenta',
  'Zpracování dat podle GDPR, běžně pod NDA',
  'Možnost plně anonymizovaných dat a reprodukovatelného reportu',
  'U výzkumných projektů posouzení etickou komisí podle potřeby',
];

const tymLaboratore = [
  ['01', 'Vedení výzkumu'],
  ['01', 'Senior výzkumník'],
  ['01', 'Správa laboratoře'],
  ['02', 'Senior operátoři'],
  ['06', 'Junior operátoři'],
];

const pageSchema = [
  {
    '@type': 'ResearchOrganization',
    name: 'FIMEYELAB',
    description:
      'Laboratoř eye trackingu a biometrie Fakulty informatiky a managementu Univerzity Hradec Králové. Měření vizuální pozornosti, emoční reakce a kognitivní zátěže v laboratoři i v terénu.',
    parentOrganization: {
      '@type': 'CollegeOrUniversity',
      name: 'Univerzita Hradec Králové — Fakulta informatiky a managementu',
    },
  },
  {
    '@type': 'AboutPage',
    name: 'O nás — laboratoř FIMEYELAB',
    description:
      'UX MIND měří v laboratoři FIMEYELAB na FIM UHK. Pět měřicích systémů, osm odborných publikací, dvě obhájené disertace.',
  },
];
---

<BaseLayout
  title="Laboratoř FIMEYELAB | Kdo za UX MIND stojí"
  description="Neměříme v zasedačce. UX MIND měří v laboratoři FIMEYELAB na Fakultě informatiky a managementu UHK — pět měřicích systémů, osm odborných publikací, dvě obhájené disertace."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ O NÁS / LABORATOŘ ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          LABORATOŘ,<br/>NE AGENTURA<span style="color:#2D62FC">.</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
          <div>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl mb-4">
              UX agentur je v Česku spousta. Laboratoří, které měří pohyb očí, kožní vodivost a mimiku
              najednou — a mají za sebou publikace v recenzovaných časopisech — je podstatně míň.
            </p>
            <p class="text-lg text-brand-black/60 leading-relaxed max-w-xl">
              UX MIND měří v laboratoři <strong class="text-brand-black">FIMEYELAB</strong> na Fakultě informatiky
              a managementu Univerzity Hradec Králové. To není marketingová ozdoba: znamená to metodickou kontrolu,
              přístroje, které si komerční agentura nepořídí, a povinnost obhájit každý závěr před recenzentem.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 md:justify-end">
            <a href="/kontakt" class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              DOMLUVIT NÁVŠTĚVU →
            </a>
            <a href="/pripadove-studie" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              PŘÍPADOVÉ STUDIE
            </a>
          </div>
        </div>
      </div>

      <!-- Info pás -->
      <div class="reveal mb-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-brand-black/10 border border-brand-black/10">
        {[
          ['MĚŘICÍ SYSTÉMY', '5'],
          ['ODBORNÉ PUBLIKACE', '8'],
          ['OBHÁJENÉ DISERTACE', '2'],
          ['MĚŘÍME', 'Laboratoř i terén'],
        ].map(([k, v]) => (
          <div class="bg-brand-white p-5">
            <p class="font-mono text-[10px] text-brand-black/60 tracking-widest mb-1">{k}</p>
            <p class="font-display font-bold leading-tight text-xl">{v}</p>
          </div>
        ))}
      </div>

      <!-- Foto laboratoře -->
      <div class="reveal mb-24 grid grid-cols-1 md:grid-cols-5 gap-8 items-start">
        <div class="md:col-span-2">
          <img
            src={`${base}/images/eye-tracking-mereni-respondentka-laborator.webp`}
            alt="Respondentka při měření u sestavy s eye trackerem v laboratoři FIMEYELAB"
            title="Měření v laboratoři FIMEYELAB"
            width="1080" height="1920" loading="lazy" decoding="async"
            class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
          />
          <p class="font-mono text-[11px] text-brand-black/60 mt-2">
            Laboratoř FIMEYELAB, FIM UHK. Žádný render, žádné stock foto.
          </p>
        </div>
        <div class="md:col-span-3">
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CO NA TÉ FOTCE JE ]</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold leading-tight mb-6">
            Nic z toho není kulisa<span style="color:#2D62FC">.</span>
          </h2>
          <p class="text-brand-black/60 leading-relaxed mb-4">
            Pod monitorem je lišta eye trackeru, která snímá pohyb očí šedesátkrát za sekundu.
            Nad monitorem kamera pro analýzu mimiky. Respondentka plní zadaný úkol na reálné stránce
            — nekomentuje, co se jí líbí.
          </p>
          <p class="text-brand-black/60 leading-relaxed">
            Přesně v tom je rozdíl mezi měřením a fokusní skupinou. Neptáme se lidí, co si myslí,
            že dělají. Díváme se, co skutečně dělají.
          </p>
          <dl class="mt-8 border-t border-brand-black/10 pt-6 space-y-4">
            {fotkaLegenda.map(([label, desc], i) => (
              <div class="flex gap-4">
                <span class="font-mono text-xs shrink-0 pt-0.5" style="color:#2D62FC;">0{i + 1}</span>
                <div>
                  <dt class="font-mono text-[11px] tracking-widest uppercase text-brand-black/70 mb-0.5">{label}</dt>
                  <dd class="text-sm text-brand-black/60 leading-relaxed">{desc}</dd>
                </div>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <!-- Jak to spolu souvisí -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-12">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ JAK TO SPOLU SOUVISÍ ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-8 max-w-3xl">
          Univerzitní laboratoř, komerční tempo<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <p class="font-mono text-xs tracking-widest mb-2" style="color:#2D62FC">LABORATOŘ</p>
            <p class="text-brand-black/60 leading-relaxed text-sm">
              FIMEYELAB patří Univerzitě Hradec Králové. Slouží výzkumu, výuce a vedení diplomových
              a disertačních prací — a drží tím metodickou laťku, kterou si komerční provoz sám na sebe neklade.
            </p>
          </div>
          <div>
            <p class="font-mono text-xs tracking-widest mb-2" style="color:#2D62FC">UX MIND</p>
            <p class="text-brand-black/60 leading-relaxed text-sm">
              Komerční zakázky v laboratoři běží vždy přes UX MIND. Jsme smluvní partner, se kterým
              podepíšete zakázku, dostanete termín, cenu i výstup — a který za výsledek odpovídá.
            </p>
          </div>
          <div>
            <p class="font-mono text-xs tracking-widest mb-2" style="color:#2D62FC">SPOJKA</p>
            <p class="text-brand-black/60 leading-relaxed text-sm">
              Jan Petružálek je vedoucím laboratoře FIMEYELAB a zároveň spolumajitelem UX MIND.
              Metodika a exekuce tak nejsou dva světy, které si něco přehazují přes plot.
            </p>
          </div>
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Prakticky to pro vás znamená jediné: dostanete akademickou metodiku bez akademických lhůt.
          Měřili jsme takhle kariérní portál pro <strong class="text-brand-black">ŠKODA AUTO</strong>,
          kampaň fotbalového klubu i produktové stránky e-shopů.
        </p>
      </div>

      <!-- Co umíme změřit -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ CO UMÍME ZMĚŘIT ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Tři vrstvy toho, co se děje v hlavě uživatele<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          {vrstvy.map((v, i) => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/60 mb-6">0{i + 1}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{v.t}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">{v.d}</p>
              <span class="font-mono text-xs border border-brand-black/20 px-2 py-1 tracking-widest">{v.tag}</span>
            </div>
          ))}
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Metody se navzájem kontrolují. Když eye tracking ukáže dlouhé prohlížení, biometrie zvýšenou
          aktivaci a dotazník klid, víme, že se něco děje — a víme kde.
        </p>
      </div>

      <!-- Čím měříme -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ ČÍM MĚŘÍME ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          Pět systémů, jeden synchronizovaný záznam<span style="color:#2D62FC">.</span>
        </h2>
        <div class="border border-brand-black/10">
          {vybaveni.map(z => (
            <div class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-6 p-6 border-b border-brand-black/10 last:border-0">
              <div class="md:col-span-4">
                <p class="font-display text-lg font-bold leading-tight">{z.nazev}</p>
                <p class="font-mono text-[11px] text-brand-black/60 tracking-wide uppercase">{z.typ}</p>
              </div>
              <p class="md:col-span-8 text-sm text-brand-black/60 leading-relaxed">{z.k}</p>
            </div>
          ))}
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Dvoje mobilní brýle znamenají, že umíme měřit dva lidi současně — nebo pokračovat, když jedna
          sada zrovna nabíjí. V terénu je to rozdíl mezi „stihli jsme to“ a „přijedeme příště“.
        </p>
      </div>

      <!-- Vizualizace laboratoře -->
      <div class="reveal mb-24">
        <img
          src={`${base}/images/laborator-ux-vyzkumu-vizualizace-1.webp`}
          alt="Vizualizace plánovaného uspořádání laboratoře FIMEYELAB"
          title="Plánované uspořádání laboratoře"
          width="1600" height="1127" loading="lazy" decoding="async"
          class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">
          Vizualizace plánovaného uspořádání laboratoře — oddělená měřicí místa pro souběžné testování.
        </p>
      </div>

      <!-- Jak měření probíhá -->
      <div class="reveal mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ JAK MĚŘENÍ PROBÍHÁ ]</p>
          <div class="space-y-0">
            {postup.map(step => (
              <div class="flex gap-5 items-start pb-4 mb-4 border-b border-brand-black/10 last:border-0">
                <span class="font-mono text-xs text-brand-black/60 pt-1">{step.num}</span>
                <div>
                  <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
                  <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div>
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ CO V PROTOKOLU HLÍDÁME ]</p>
          <ul class="space-y-2 mb-6">
            {rizika.map(r => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {r}
              </li>
            ))}
          </ul>
          <p class="text-sm text-brand-black/60 leading-relaxed">
            Tenhle seznam je důvod, proč měření v laboratoři není totéž co „pustili jsme si nahrávku obrazovky“.
            Každá z těch pěti věcí umí výsledek otočit naruby a všechny se dají ošetřit jen předem.
          </p>
        </div>
      </div>

      <!-- Akademické zázemí -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ AKADEMICKÉ ZÁZEMÍ ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-10 max-w-3xl">
          To, co u agentury nezjistíte<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 border border-brand-black/10">
          <div class="bg-brand-white p-8">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">PUBLIKACE</p>
            <p class="font-display text-5xl font-bold mb-2">8</p>
            <p class="text-sm text-brand-black/60 leading-relaxed mb-6">
              odborných publikací zaměřených na eye tracking.
            </p>
            <p class="font-mono text-[11px] text-brand-black/60 tracking-widest mb-2">Q1 ČASOPIS (2021–2025)</p>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Franěk, M., &amp; Petružálek, J. (2025). <em>Perceptual fluency and eye movements when viewing
              urban and natural scenes.</em> Scientific Reports, 15(1), čl. 25772.
            </p>
          </div>
          <div class="bg-brand-white p-8">
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">ŠKOLA A DOROST</p>
            <ul class="space-y-3 text-sm text-brand-black/60 leading-relaxed">
              <li class="pb-3 border-b border-brand-black/5">
                <strong class="text-brand-black">2 obhájené disertace</strong><br/>
                Jan Petružálek (2023) — Komparace a kombinace metod měření uživatelské zkušenosti
                s využitím eye-tracking technologie<br/>
                Denis Šefara (2022) — Business dashboardy pracující s pozorností uživatele
              </li>
              <li class="pb-3 border-b border-brand-black/5">
                <strong class="text-brand-black">8 obhájených diplomových a bakalářských prací</strong><br/>
                2 magisterské, 6 bakalářských
              </li>
              <li>
                <strong class="text-brand-black">10 nových témat pro rok 2025/2026</strong><br/>
                z toho 5 zaměřených na eye tracking
              </li>
            </ul>
          </div>
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Studenti nejsou levná pracovní síla. Jsou důvod, proč laboratoř neustále testuje vlastní metody
          na nových zadáních — a proč se v ní nedá zabydlet u jednoho postupu.
        </p>
      </div>

      <!-- Lidé -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ LIDÉ ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6 max-w-3xl">
          Firmu vedeme dva. Měření nedělají dva<span style="color:#2D62FC">.</span>
        </h2>
        <p class="text-brand-black/60 leading-relaxed max-w-3xl mb-10">
          UX MIND má dva společníky. Za sběrem a zpracováním dat stojí tým laboratoře — vedení výzkumu,
          správa laboratoře a vyškolení operátoři.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mb-px">

          <!-- Jan Petružálek -->
          <div class="bg-brand-white flex flex-col">
            <div class="border-b border-brand-black/10 aspect-[3/2] flex flex-col items-center justify-center text-center px-6" style="background-image: linear-gradient(rgba(10,10,10,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(10,10,10,0.06) 1px, transparent 1px); background-size: 20% 25%;">
              <p class="font-mono text-[10px] tracking-widest text-brand-black/40 mb-3">[ FOTO SE PŘIPRAVUJE ]</p>
              <p class="font-display text-lg md:text-xl font-bold text-brand-black/40 leading-snug max-w-xs">Měříme, kam se díváte. Na sebe jsme kameru ještě neotočili.</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase mb-2" style="color:#2D62FC">VEDOUCÍ LABORATOŘE FIMEYELAB · SPOLUMAJITEL UX MIND</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-4">Ing. Jan Petružálek, Ph.D.</h3>
              <p class="text-brand-black/60 leading-relaxed mb-6">
                Vede laboratoř i výzkum: navrhuje experimenty, hlídá metodickou čistotu měření a odpovídá
                za interpretaci dat. Doktorát z FIM UHK, disertace o kombinaci metod měření uživatelské
                zkušenosti s eye trackingem, publikace v oblasti HCI a e-commerce.
              </p>
              <a href="https://www.linkedin.com/in/jan-petru%C5%BE%C3%A1lek-79167474/" target="_blank" rel="noopener noreferrer" class="mt-auto self-start inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                LINKEDIN ↗
              </a>
            </div>
          </div>

          <!-- Lukáš Koula -->
          <div class="bg-brand-white flex flex-col">
