---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { MEDIA_PAGE_LIVE } from '../data/media';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Rozcestník na konci stránky, ať V médiích a Partneři nejsou dostupné jen z rozbalovacího menu
const dalsi = [
  { t: 'Kde a čím měříme', d: 'Laboratoř FIMEYELAB, terén a vybavení, se kterým měříme.', href: '/o-nas/kde-merime' },
  ...(MEDIA_PAGE_LIVE ? [{ t: 'V médiích', d: 'Podcasty, reportáže a články o eye trackingu a našich měřeních.', href: '/v-mediich' }] : []),
  { t: 'Partneři', d: 'Univerzita Hradec Králové a MindSense: výzkumné zázemí a technologická podpora.', href: '/partneri' },
];

const etika = [
  'Standardizovaný protokol a pilotní ověření studie',
  'Informovaný souhlas každého účastníka',
  'Zpracování dat podle GDPR a podle potřeby také pod NDA',
  'Možnost anonymizace dat a výstupu s popsanou metodikou',
  'Posouzení etickou komisí, pokud to povaha projektu vyžaduje',
];

const tymLaboratore = [
  ['02', 'Vedení a metodika'],
  ['01', 'Správa laboratoře'],
  ['08', 'Vyškolení operátoři'],
];

// Neutrální silueta hlavy (hlava + ramena) místo abstraktních čtverečků.
const HEAD = '<circle cx="16" cy="11" r="6"/><path d="M6 29c0-5.6 4.5-9.6 10-9.6S26 23.4 26 29z"/>';

const description = 'UX MIND vedou Jan Petružálek a Lukáš Koula. Měříme ve spolupráci s laboratoří FIMEYELAB na FIM UHK a výsledky převádíme do konkrétních doporučení.';

const pageSchema = [
  {
    '@type': 'AboutPage',
    name: 'O nás: tým UX MIND',
    description,
    about: { '@id': 'https://uxmind.cz/#organization' },
    mentions: [
      { '@id': 'https://uxmind.cz/o-nas/#jan-petruzalek' },
      { '@id': 'https://uxmind.cz/o-nas/#lukas-koula' },
    ],
    primaryImageOfPage: 'https://uxmind.cz/og/og-o-nas.jpg',
  },
  {
    '@type': 'Person',
    '@id': 'https://uxmind.cz/o-nas/#jan-petruzalek',
    name: 'Jan Petružálek',
    honorificPrefix: 'Ing.',
    honorificSuffix: 'Ph.D.',
    jobTitle: 'Spolumajitel UX MIND, vedoucí laboratoře FIMEYELAB (FIM UHK)',
    worksFor: { '@id': 'https://uxmind.cz/#organization' },
    image: 'https://uxmind.cz/images/jan-petruzalek-portret.webp',
    sameAs: ['https://www.linkedin.com/in/jan-petru%C5%BE%C3%A1lek-79167474/'],
  },
  {
    '@type': 'Person',
    '@id': 'https://uxmind.cz/o-nas/#lukas-koula',
    name: 'Lukáš Koula',
    honorificPrefix: 'Mgr.',
    jobTitle: 'Spolumajitel UX MIND, strategie, web a marketing',
    worksFor: { '@id': 'https://uxmind.cz/#organization' },
    image: 'https://uxmind.cz/images/lukas-koula-portret.webp',
    sameAs: ['https://www.linkedin.com/in/lukaskoula/'],
  },
];
---

<BaseLayout
  title="O nás: tým UX MIND a spolupráce s laboratoří FIMEYELAB"
  description={description}
  image="/og/og-o-nas.jpg"
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Hero -->
      <div class="mb-20">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ O NÁS ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          VÝZKUM<br/>MÍSTO DOJMŮ<span style="color:#2D62FC">.</span>
        </h1>
        <div class="max-w-3xl">
          <p class="text-lg text-brand-black/60 leading-relaxed mb-4">
            UX MIND jsou dva společníci. <strong class="text-brand-black">Jan Petružálek</strong> navrhuje výzkum
            a vykládá data, <strong class="text-brand-black">Lukáš Koula</strong> z nich dělá změny na webech,
            v e-shopech a kampaních. Měříme ve spolupráci s laboratoří FIMEYELAB na Fakultě informatiky
            a managementu Univerzity Hradec Králové.
          </p>
          <p class="text-lg text-brand-black/60 leading-relaxed">
            Zjišťujeme, co lidé na stránce nebo v prostoru opravdu vidí, čemu nerozumějí a kde se ztrácejí.
            Dostanete závěry, podle kterých jde rovnou něco změnit.
          </p>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href={`${base}/o-nas/kde-merime`} class="inline-block bg-brand-black text-brand-white border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-white hover:text-brand-black transition-colors">
              KDE A ČÍM MĚŘÍME →
            </a>
            <a href={`${base}/pripadove-studie`} class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
              PŘÍPADOVÉ STUDIE
            </a>
          </div>
        </div>
      </div>

      <!-- Lidé -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ KDO JSME ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-6 max-w-3xl">
          Dva společníci, širší výzkumný tým<span style="color:#2D62FC">.</span>
        </h2>
        <p class="text-brand-black/60 leading-relaxed max-w-3xl mb-10">
          UX MIND vedou dva společníci. Na návrhu studie, měření a zpracování dat se podle rozsahu projektu
          podílí také vedení laboratoře a vyškolení operátoři.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10 mb-px">

          <!-- Jan Petružálek -->
          <div class="bg-brand-white p-6 md:p-8 flex flex-col sm:flex-row gap-6 lg:gap-8">
            <div class="w-40 sm:w-44 lg:w-48 shrink-0 aspect-[4/5] overflow-hidden border border-brand-black/10">
              <img
                src={`${base}/images/jan-petruzalek-portret.webp`}
                alt="Jan Petružálek, vedoucí laboratoře FIMEYELAB a spolumajitel UX MIND" title="Jan Petružálek, vedoucí laboratoře FIMEYELAB a spolumajitel UX MIND"
                width="640" height="800" loading="lazy" decoding="async"
                class="w-full h-full object-cover object-center block"
              />
            </div>
            <div class="flex flex-col flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase mb-2" style="color:#2D62FC">VEDOUCÍ LABORATOŘE FIMEYELAB<span class="block mt-1">SPOLUMAJITEL UX MIND</span></p>
              <h3 class="font-display text-2xl font-bold mb-3">Ing. Jan Petružálek, Ph.D.</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">
                Navrhuje výzkum, dohlíží na průběh měření a odpovídá za analýzu a interpretaci dat.
                Ve své disertaci se věnoval kombinaci metod UX výzkumu s eye trackingem. Publikuje
                v oblasti uživatelské zkušenosti a e-commerce.
              </p>
              <a href="https://www.linkedin.com/in/jan-petru%C5%BE%C3%A1lek-79167474/" target="_blank" rel="noopener noreferrer" class="mt-auto self-start inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                LINKEDIN ↗
              </a>
            </div>
          </div>

          <!-- Lukáš Koula -->
          <div class="bg-brand-white p-6 md:p-8 flex flex-col sm:flex-row gap-6 lg:gap-8">
            <div class="w-40 sm:w-44 lg:w-48 shrink-0 aspect-[4/5] overflow-hidden border border-brand-black/10">
              <img
                src={`${base}/images/lukas-koula-portret.webp`}
                alt="Lukáš Koula, spolumajitel UX MIND" title="Lukáš Koula, spolumajitel UX MIND"
                width="640" height="800" loading="lazy" decoding="async"
                class="w-full h-full object-cover object-center block"
              />
            </div>
            <div class="flex flex-col flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase mb-2" style="color:#2D62FC">STRATEGIE, WEB A MARKETING<span class="block mt-1">SPOLUMAJITEL UX MIND</span></p>
              <h3 class="font-display text-2xl font-bold mb-3">Mgr. Lukáš Koula</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed mb-6">
                Převádí výsledky výzkumu do konkrétních doporučení pro weby, e-shopy a kampaně. Vede projekty,
                komunikaci s klienty a propojuje výzkum s obchodními a marketingovými cíli. Je certifikovaný
                Shoptet Partner a Google Partner.
              </p>
              <a href="https://www.linkedin.com/in/lukaskoula/" target="_blank" rel="noopener noreferrer" class="mt-auto self-start inline-block border border-brand-black px-6 py-3 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
                LINKEDIN ↗
              </a>
            </div>
          </div>
        </div>

        <!-- Tým laboratoře -->
        <div class="border border-brand-black/10 p-8 md:p-10">
          <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-6">[ TÝM LABORATOŘE ]</p>
          <div class="border border-brand-black/10 divide-y divide-brand-black/10 mb-6">
            {tymLaboratore.map(([pocet, role]) => (
              <div class="flex items-center gap-4 md:gap-6 px-4 py-4 md:px-6">
                <p class="font-mono text-[11px] text-brand-black/70 tracking-wide uppercase leading-snug w-28 md:w-44 shrink-0">{role}</p>
                <div class="flex flex-wrap gap-2 flex-1 min-w-0">
                  {Array.from({ length: Number(pocet) }).map(() => (
                    <svg viewBox="0 0 32 32" class="w-[18px] h-[18px] fill-brand-black shrink-0" aria-hidden="true" set:html={HEAD}></svg>
                  ))}
                </div>
                <p class="font-mono text-[11px] text-brand-black/40 tabular-nums shrink-0 w-6 text-right">{pocet}</p>
              </div>
            ))}
          </div>
          <p class="text-sm text-brand-black/60 leading-relaxed max-w-3xl">
            Každé měření probíhá podle jednotného protokolu a pod odborným dohledem. Díky tomu zůstává
            sběr dat konzistentní bez ohledu na složení realizačního týmu.
          </p>
        </div>
      </div>

      <!-- Jak to spolu souvisí -->
      <div class="reveal mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ UX MIND A UHK ]</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight mb-8 max-w-3xl">
          Univerzitní laboratoř, komerční tempo<span style="color:#2D62FC">.</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-brand-black/10 border border-brand-black/10">
          <div class="bg-brand-white p-6 md:p-8">
            <p class="font-mono text-xs text-brand-black/60 mb-6">01</p>
            <h3 class="font-display text-2xl font-bold mb-3">Laboratoř FIMEYELAB</h3>
            <p class="text-brand-black/60 leading-relaxed text-sm">
              FIMEYELAB patří Univerzitě Hradec Králové. Slouží výzkumu, výuce a vedení diplomových
              a disertačních prací. Drží tím metodickou laťku, kterou si komerční provoz sám na sebe neklade.
            </p>
          </div>
          <div class="bg-brand-white p-6 md:p-8">
            <p class="font-mono text-xs text-brand-black/60 mb-6">02</p>
            <h3 class="font-display text-2xl font-bold mb-3">UX MIND</h3>
            <p class="text-brand-black/60 leading-relaxed text-sm">
              Komerční zakázky v laboratoři běží vždy přes UX MIND. Jsme smluvní partner, se kterým
              podepíšete zakázku, dostanete termín, cenu i výstup. A který za výsledek odpovídá.
            </p>
          </div>
          <div class="bg-brand-white p-6 md:p-8">
            <p class="font-mono text-xs text-brand-black/60 mb-6">03</p>
            <h3 class="font-display text-2xl font-bold mb-3">Propojení</h3>
            <p class="text-brand-black/60 leading-relaxed text-sm">
              Jan Petružálek je vedoucím laboratoře FIMEYELAB a zároveň spolumajitelem UX MIND.
              Metodika a exekuce tak nejsou dva světy, které si něco přehazují přes plot.
            </p>
          </div>
        </div>
        <p class="text-brand-black/60 leading-relaxed mt-8 max-w-3xl">
          Pro vás to znamená akademickou metodiku bez akademických lhůt.
          Měřili jsme takhle kariérní portál pro <strong class="text-brand-black">ŠKODA AUTO</strong>,
          kampaň fotbalového klubu i produktové stránky e-shopů.
        </p>
      </div>

      <!-- Etika a data -->
      <div class="reveal mb-24 border border-brand-black/10 p-8 md:p-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div>
            <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-3">[ ETIKA A DATA ]</p>
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">
              Souhlas a ochrana dat jsou součástí měření<span style="color:#2D62FC">.</span>
            </h2>
            <p class="text-sm text-brand-black/60 leading-relaxed">
              Každý účastník předem ví, co zaznamenáváme, proč data sbíráme a jak s nimi budeme pracovat.
            </p>
          </div>
          <ul class="space-y-2">
            {etika.map(e => (
              <li class="flex gap-2 text-sm text-brand-black/60 leading-relaxed py-1 border-b border-brand-black/5 last:border-0">
                <span class="font-mono text-xs pt-0.5" style="color:#2D62FC;">→</span> {e}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Dál o nás -->
      <nav aria-label="Dál o nás" class:list={["reveal grid grid-cols-1 gap-px bg-brand-black/10 border border-brand-black/10", dalsi.length > 2 ? "md:grid-cols-3" : "md:grid-cols-2"]}>
        {dalsi.map(x => (
          <a href={base + x.href} class="group bg-brand-white p-8 flex items-start justify-between gap-6 hover:bg-[#2D62FC]/5 transition-colors">
            <div>
              <p class="font-mono text-xs text-brand-black/60 tracking-widest uppercase mb-3">[ DÁL O NÁS ]</p>
              <p class="font-display text-2xl md:text-3xl font-bold mb-2 group-hover:text-[#2D62FC] transition-colors">{x.t}</p>
              <p class="text-sm text-brand-black/60 leading-relaxed">{x.d}</p>
            </div>
            <span class="font-mono text-lg group-hover:text-[#2D62FC]" aria-hidden="true">→</span>
          </a>
        ))}
      </nav>

    </div>
  </main>

  <Footer />

  <script>
    document.body.classList.add('reveal-ready');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</BaseLayout>
