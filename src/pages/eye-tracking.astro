---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const faq = [
  { q: "Kolik respondentů je potřeba pro eye tracking studii?", a: "Pro kvalitativní vhledy stačí 8–12 respondentů na segment. Pro kvantitativní metriky (heatmapy, AOI statistiky) doporučujeme 30 a více a pro výpočet indexu kognitivní zátěže EMLI pracujeme se vzorky nad 100 respondentů." },
  { q: "Jak dlouho trvá eye tracking testování?", a: "Typický projekt trvá 1–3 týdny od schválení scénáře: příprava a pilotáž, sběr dat v laboratoři nebo v terénu, analýza a report s prioritizovanými doporučeními." },
  { q: "Je eye tracking totéž co neuromarketing?", a: "Není. Eye tracking je objektivní záznam vizuální pozornosti — neslibujeme „čtení myšlenek“ ani emocí. Data interpretujeme vždy v kontextu úkolu a s jasně popsanými limity metody." },
  { q: "Co ukáže heatmapa a co z ní nevyčtu?", a: "Heatmapa agreguje, kam se respondenti dívali nejčastěji. Neřekne ale, jak náročné pro ně rozhraní bylo — proto ji doplňujeme AOI metrikami (TTFF, dwell time) a indexem kognitivní zátěže EMLI." },
];
const pageSchema = [
  {
    '@type': 'Service',
    name: "Eye tracking a uživatelské testování",
    description: "Měření vizuální pozornosti pomocí eye trackingu: heatmapy, AOI analýza, záznamy pohledu a uživatelské testování webů, aplikací a tiskovin.",
    serviceType: 'Eye tracking',
    provider: { '@type': 'Organization', name: 'UX MIND Research Lab s.r.o.' },
    areaServed: 'CZ',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Eye tracking a heatmapy pozornosti"
  description="Eye tracking webů, aplikací i tiskovin: heatmapy, AOI analýza, záznamy pohledu a uživatelské testování v laboratoři FIM UHK. Zjistěte, co uživatelé skutečně vidí."
  schema={pageSchema}
>
  <Navbar />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Header -->
      <div class="mb-16">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">[ EYE TRACKING ]</p>
        <h1 class="font-display font-bold leading-none tracking-tighter mb-8" style="font-size: clamp(3rem, 9vw, 8rem);">
          VIDÍME<br/>CO VY NE.
        </h1>
        <p class="text-xl text-brand-black/60 max-w-2xl leading-relaxed">
          Eye tracking odhaluje přesná data o tom, jak uživatelé vnímají váš obsah. Víme kam se dívají, co přehlíží a co je zaujme.
        </p>
      </div>

      <!-- Foto z měření -->
      <div class="mb-24">
        <img
          src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/eye-tracking-mereni-respondentka-laborator.webp`}
          alt="Respondentka během eye-tracking měření v laboratoři — sleduje testovaný stimul na monitoru s eye-trackerem"
          title="Průběh eye-tracking měření v laboratoři"
          width="1080" height="1920" loading="lazy" decoding="async"
          class="w-full max-h-[520px] object-cover object-center border border-brand-black/10"
        />
        <p class="font-mono text-[11px] text-brand-black/60 mt-2">Sběr dat vizuální pozornosti v laboratoři — záznam pohledu se ukládá pro AOI analýzu a heatmapy.</p>
      </div>

      <!-- How it works -->
      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ JAK TO FUNGUJE ]</p>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-px bg-brand-black/10">
          {[
            { num: '01', title: 'Příprava', desc: 'Nastavíme testovací scénáře podle vašich cílů. Definujeme AOI (Areas of Interest), které chceme sledovat.' },
            { num: '02', title: 'Testování', desc: 'Uživatelé interagují s vaším produktem. Eye tracker přesně sleduje pohyb jejich očí.' },
            { num: '03', title: 'Analýza', desc: 'Zpracujeme data do vizuálních heatmap, gaze plotů a AOI statistik.' },
            { num: '04', title: 'Doporučení', desc: 'Předáme konkrétní doporučení jak vylepšit rozvržení a hierarchii obsahu.' },
          ].map(step => (
            <div class="bg-brand-white p-8">
              <p class="font-mono text-xs text-brand-black/50 mb-6">{step.num}</p>
              <h3 class="font-display text-2xl font-bold mb-3">{step.title}</h3>
              <p class="text-sm text-brand-black/60 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Use cases -->
      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ KDE POMŮŽEME ]</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brand-black/10">
          {[
            { title: 'Webové stránky', desc: 'Zjistíme kde uživatelé tráví čas, co přehlíží a proč nereagují na vaše CTA.' },
            { title: 'Mobilní aplikace', desc: 'Testujeme navigaci, čitelnost a použitelnost vašich mobilních produktů.' },
            { title: 'E-commerce', desc: 'Optimalizujeme produktové stránky, košík a checkout pro lepší konverze.' },
            { title: 'Tiskové materiály', desc: 'Bannery, plakáty, obaly – zjistíme co přitahuje pozornost na fyzických materiálech.' },
          ].map(usecase => (
            <div class="bg-brand-white p-8">
              <h3 class="font-display text-2xl font-bold mb-3">{usecase.title}</h3>
              <p class="text-brand-black/60 leading-relaxed">{usecase.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <!-- FAQ -->
      <div class="mb-24">
        <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-8">[ ČASTÉ DOTAZY ]</p>
        <div class="border-t border-brand-black/10">
          {faq.map(f => (
            <details class="group border-b border-brand-black/10">
              <summary class="flex justify-between items-center gap-6 cursor-pointer py-5 font-display text-lg md:text-xl font-bold list-none [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="font-mono text-xl shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="text-brand-black/60 leading-relaxed pb-6 max-w-3xl">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="text-center py-16 border-t border-brand-black/10">
        <h2 class="font-display text-4xl font-bold mb-6">Zjistěte co vidí vaši uživatelé</h2>
        <a href="/kontakt" class="inline-block border border-brand-black px-8 py-4 font-mono text-xs tracking-widest uppercase hover:bg-brand-black hover:text-brand-white transition-colors">
          DOMLUVIT TESTOVÁNÍ →
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
