---
import '../styles/global.css';
import { getLang, getPathInLang, getBreadcrumbTrail, languages } from '../i18n/utils';
import CookieConsent from '../components/CookieConsent.astro';

// Google Analytics 4 — doplněním measurement ID (G-XXXXXXXXXX) se aktivuje; měření řídí Consent Mode v2.
const GA_ID = '';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  lang?: string;
  /** Volitelná strukturovaná data (JSON-LD) — objekt nebo pole objektů */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** false = neemitovat hreflang (stránka existuje jen v jednom jazyce, např. segmenty) */
  hreflang?: boolean;
  /** true = <meta name="robots" content="noindex, follow"> (např. 404) */
  noindex?: boolean;
  /** Cesta k LCP obrázku k přednačtení (volitelně omezená media dotazem) */
  preloadImage?: { href: string; media?: string };
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  title,
  description = 'UX Mind — specializujeme se na UX výzkum, UX audit a eye tracking. Pomáháme firmám vytvářet lepší digitální produkty.',
  image = `${base}/og-image.jpg`,
  type = 'website',
  lang = 'cs',
  schema,
  hreflang = true,
  noindex = false,
  preloadImage,
} = Astro.props;

const baseUrl = `${base}/`;
const siteOrigin = new URL(Astro.site!).origin;
/** Absolutní URL z cesty; interní cesty vždy s koncovým lomítkem (GitHub Pages jinak přesměrovává). */
const withSlash = (p: string) => (p.endsWith('/') || /\.[a-z0-9]+$/i.test(p) ? p : `${p}/`);
/** Cesta ke statickému souboru v /public — doplní base prefix jen tehdy, když tam ještě není. */
const asset = (p: string) => {
  if (p.startsWith('http://') || p.startsWith('https://')) return p;
  const clean = p.startsWith('/') ? p : `/${p}`;
  return siteOrigin + (clean.startsWith(`${base}/`) ? clean : base + clean);
};
const canonicalPath = withSlash(
  Astro.url.pathname.startsWith(base) ? Astro.url.pathname : base + Astro.url.pathname,
);
const canonicalURL = siteOrigin + canonicalPath;
const resolvedImage = asset(image);
// Nepřidávat sufix, pokud už titulek značku obsahuje
const fullTitle = title === 'UX Mind' || title.includes('UXMIND') || title.includes('UX Mind')
  ? title
  : `${title} | UX Mind`;
const ogLocales: Record<string, string> = { cs: 'cs_CZ', en: 'en_GB', de: 'de_DE', fr: 'fr_FR', es: 'es_ES' };
const skipLabels: Record<string, string> = { cs: 'Přeskočit na obsah', en: 'Skip to content', de: 'Zum Inhalt springen', fr: 'Aller au contenu', es: 'Saltar al contenido' };

// hreflang alternativy — stejná stránka ve všech jazycích
const sitePath = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length) || '/'
  : Astro.url.pathname;
// Progress bar čtení se zobrazuje všude kromě homepage
const isHome = ['/', '/en/', '/en', '/de/', '/de', '/fr/', '/fr', '/es/', '/es'].includes(sitePath);
const alternates = languages.map(l => ({
  code: l.code,
  url: siteOrigin + withSlash(base + getPathInLang(sitePath, l.code)),
}));
const defaultAlternate = alternates.find(a => a.code === 'cs');

// Globální strukturovaná data: firma + web
const siteUrl = new URL(baseUrl, Astro.site).toString();
const orgSchema = {
  '@type': 'ProfessionalService',
  '@id': `${siteUrl}#organization`,
  name: 'UX MIND Research Lab s.r.o.',
  alternateName: 'UX Mind',
  url: siteUrl,
  logo: new URL('logo.svg', siteUrl).toString(),
  image: resolvedImage,
  email: 'spoluprace@uxmind.cz',
  telephone: '+420728601160',
  identifier: { '@type': 'PropertyValue', propertyID: 'IČO', value: '29714966' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'K Lesu 180, Svinary',
    addressLocality: 'Hradec Králové',
    postalCode: '500 09',
    addressCountry: 'CZ',
  },
  areaServed: 'CZ',
  knowsAbout: ['UX výzkum', 'Eye tracking', 'Uživatelské testování', 'UX audit', 'Kognitivní zátěž', 'EMLI'],
};
const webPageSchema = {
  '@type': 'WebPage',
  '@id': `${canonicalURL}#webpage`,
  url: canonicalURL,
  name: fullTitle,
  description,
  isPartOf: { '@id': `${siteUrl}#website` },
  about: { '@id': `${siteUrl}#organization` },
  primaryImageOfPage: resolvedImage,
  inLanguage: lang,
};
const webSiteSchema = {
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  name: 'UX Mind',
  url: siteUrl,
  inLanguage: lang,
  publisher: { '@id': `${siteUrl}#organization` },
};
const rawExtras = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

/**
 * Jedna identita firmy v grafu: kdekoliv je vnořená kopie organizace
 * (provider / author / publisher), nahradíme ji odkazem na #organization.
 * Zároveň doplníme Article/Service o vazby, které lze bezpečně odvodit.
 */
const ORG_REF = { '@id': `${siteUrl}#organization` };
const PAGE_TYPES = new Set(['WebPage', 'AboutPage', 'ContactPage', 'CollectionPage', 'ItemPage', 'ProfilePage', 'CheckoutPage', 'QAPage']);
const isOrgCopy = (v: any) =>
  v && typeof v === 'object' && !Array.isArray(v) && !v['@id'] &&
  (v['@type'] === 'Organization' || v['@type'] === 'ProfessionalService') &&
  typeof v.name === 'string' && v.name.startsWith('UX MIND');
function normalize(node: any): any {
  if (Array.isArray(node)) return node.map(normalize);
  if (!node || typeof node !== 'object') return node;
  const out: Record<string, unknown> = {};
  for (const [k, v] of Object.entries(node)) out[k] = isOrgCopy(v) ? ORG_REF : normalize(v);
  const t = out['@type'];
  if (t === 'Article' || t === 'NewsArticle' || t === 'BlogPosting' || t === 'ScholarlyArticle') {
    out['@id'] ??= `${canonicalURL}#article`;
    out.url ??= canonicalURL;
    out.mainEntityOfPage ??= { '@id': `${canonicalURL}#webpage` };
    out.publisher ??= ORG_REF;
    out.author ??= ORG_REF;
    out.image ??= resolvedImage;
    out.inLanguage ??= lang;
    out.isPartOf ??= { '@id': `${siteUrl}#website` };
  }
  if (t === 'Service') {
    out['@id'] ??= `${canonicalURL}#service`;
    out.provider ??= ORG_REF;
    out.url ??= canonicalURL;
  }
  if (t === 'FAQPage') {
    out['@id'] ??= `${canonicalURL}#faq`;
    out.isPartOf ??= { '@id': `${canonicalURL}#webpage` };
    out.inLanguage ??= lang;
  }
  if (PAGE_TYPES.has(String(t))) {
    out['@id'] ??= `${canonicalURL}#webpage`;
    out.url ??= canonicalURL;
    out.name ??= fullTitle;
    out.description ??= description;
    out.isPartOf ??= { '@id': `${siteUrl}#website` };
    out.inLanguage ??= lang;
  }
  return out;
}
const extraSchemas = rawExtras.map(normalize);
// Drobečková navigace odvozená ze skutečné struktury URL; poslední položka = tato stránka
const trail = getBreadcrumbTrail(sitePath, lang as any);
const breadcrumbSchema = trail.length
  ? {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalURL}#breadcrumb`,
      itemListElement: [
        ...trail.map((t, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: t.name,
          item: siteOrigin + withSlash(base + t.path),
        })),
        { '@type': 'ListItem', position: trail.length + 1, name: title, item: canonicalURL },
      ],
    }
  : null;
// Vlastní stránkový uzel má přednost — jinak by v grafu byla dvě @id #webpage
const hasOwnPageNode = extraSchemas.some((n: any) => PAGE_TYPES.has(String(n?.['@type'])));
const hasOwnBreadcrumb = extraSchemas.some((n: any) => n?.['@type'] === 'BreadcrumbList');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    orgSchema,
    webSiteSchema,
    ...(hasOwnPageNode ? [] : [webPageSchema]),
    ...(breadcrumbSchema && !hasOwnBreadcrumb ? [breadcrumbSchema] : []),
    ...extraSchemas,
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Consent Mode v2 — výchozí stav (opt-in), načítá se před Google tagy -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        personalization_storage: 'denied',
        security_storage: 'granted',
        wait_for_update: 500,
      });
      // Aplikuj dřívější volbu ještě před vykreslením (žádné blikání pro vracející se návštěvníky)
      try {
        var __c = JSON.parse(localStorage.getItem('uxmind-consent') || 'null');
        if (__c && __c.v) {
          gtag('consent', 'update', {
            analytics_storage: __c.analytics ? 'granted' : 'denied',
            ad_storage: __c.marketing ? 'granted' : 'denied',
            ad_user_data: __c.marketing ? 'granted' : 'denied',
            ad_personalization: __c.marketing ? 'granted' : 'denied',
            personalization_storage: __c.marketing ? 'granted' : 'denied',
          });
        }
      } catch (e) {}
      gtag('js', new Date());
    </script>
    {GA_ID && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>}
    {GA_ID && <script is:inline set:html={`gtag('config', '${GA_ID}', { anonymize_ip: true });`} />}
    <!-- Google Tag Manager (načítá se po nastavení Consent Mode v2 defaultů výše) -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WJ9BBVG8');</script>
    <!-- End Google Tag Manager -->
    <link rel="icon" type="image/png" sizes="512x512" href={`${baseUrl}favicon.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${baseUrl}apple-touch-icon.png`} />
    <link rel="author" type="text/plain" href={`${baseUrl}humans.txt`} />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalURL} />
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage.href}
        media={preloadImage.media}
        fetchpriority="high"
      />
    )}

    <!-- hreflang — jazykové verze stránky (vynecháno u jednojazyčných stránek, např. segmenty) -->
    {hreflang && alternates.map(a => (
      <link rel="alternate" hreflang={a.code} href={a.url} />
    ))}
    {hreflang && defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.url} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale" content={ogLocales[lang] ?? 'en_GB'} />
    {languages.filter(l => l.code !== lang).map(l => (
      <meta property="og:locale:alternate" content={ogLocales[l.code]} />
    ))}
    <meta property="og:site_name" content="UX Mind" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />
    <meta name="twitter:image:alt" content={fullTitle} />

    <!-- Strukturovaná data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Fonty jsou self-hostované přes Fontsource (import v global.css) -->
  </head>
  <body class="bg-brand-white text-brand-black">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WJ9BBVG8" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[200] focus:bg-brand-black focus:text-brand-white focus:px-4 focus:py-2 font-mono text-xs tracking-widest">
      {skipLabels[lang] ?? 'Skip to content'}
    </a>

    <slot />

    <slot name="cursor" />

    <CookieConsent />

    {!isHome && (
      <script is:inline>
        (function () {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          var bar = document.createElement('div');
          bar.style.cssText = 'position:fixed;top:0;left:0;height:3px;width:0;background:#2D62FC;z-index:90;pointer-events:none;transition:width .1s linear;';
          document.body.appendChild(bar);
          function update() {
            var d = document.documentElement;
            var max = d.scrollHeight - window.innerHeight;
            bar.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
          }
          window.addEventListener('scroll', update, { passive: true });
          window.addEventListener('resize', update);
          update();
        })();
      </script>
    )}
  </body>
</html>
