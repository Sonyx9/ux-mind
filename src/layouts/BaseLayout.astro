---
import '../styles/global.css';
import { getLang, getPathInLang, languages } from '../i18n/utils';
import CookieConsent from '../components/CookieConsent.astro';

// Google Analytics 4 — po vyplnění measurement ID (např. 'G-XXXXXXXXXX') se GA4 aktivuje.
// Měření je řízeno Consent Mode v2: bez souhlasu běží jen anonymní cookieless pingy.
const GA_ID = '';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  lang?: string;
  /** Volitelná strukturovaná data (JSON-LD) — objekt nebo pole objektů */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  title,
  description = 'UX Mind — specializujeme se na UX výzkum, UX audit a eye tracking. Pomáháme firmám vytvářet lepší digitální produkty.',
  image = `${base}/og-image.jpg`,
  type = 'website',
  lang = 'cs',
  schema,
} = Astro.props;

const baseUrl = `${base}/`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedImage = image.startsWith('http://') || image.startsWith('https://')
  ? image
  : new URL(image.replace(/^\//, ''), new URL(baseUrl, Astro.site)).toString();
// Nepřidávat sufix, pokud už titulek značku obsahuje
const fullTitle = title === 'UX Mind' || title.includes('UXMIND') || title.includes('UX Mind')
  ? title
  : `${title} | UX Mind`;
const ogLocales: Record<string, string> = { cs: 'cs_CZ', en: 'en_GB', de: 'de_DE', fr: 'fr_FR', es: 'es_ES' };
const skipLabels: Record<string, string> = { cs: 'Přeskočit na obsah', en: 'Skip to content', de: 'Zum Inhalt springen', fr: 'Aller au contenu', es: 'Saltar al contenido' };

// hreflang alternativy — stejná stránka ve všech jazycích
const sitePath = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length) || '/'
  : Astro.url.pathname;
// Progress bar čtení se zobrazuje všude kromě homepage
const isHome = ['/', '/en/', '/en', '/de/', '/de', '/fr/', '/fr', '/es/', '/es'].includes(sitePath);
const alternates = languages.map(l => ({
  code: l.code,
  url: new URL((base + getPathInLang(sitePath, l.code)).replace(/^\//, ''), Astro.site).toString(),
}));
const defaultAlternate = alternates.find(a => a.code === 'cs');

// Globální strukturovaná data: firma + web
const siteUrl = new URL(baseUrl, Astro.site).toString();
const orgSchema = {
  '@type': 'ProfessionalService',
  '@id': `${siteUrl}#organization`,
  name: 'UX MIND Research Lab s.r.o.',
  alternateName: 'UX Mind',
  url: siteUrl,
  logo: new URL('logo.svg', siteUrl).toString(),
  image: resolvedImage,
  email: 'spoluprace@uxmind.cz',
  telephone: '+420728601160',
  identifier: { '@type': 'PropertyValue', propertyID: 'IČO', value: '29714966' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'K Lesu 180, Svinary',
    addressLocality: 'Hradec Králové',
    postalCode: '500 09',
    addressCountry: 'CZ',
  },
  areaServed: 'CZ',
  knowsAbout: ['UX výzkum', 'Eye tracking', 'Uživatelské testování', 'UX audit', 'Kognitivní zátěž', 'EMLI'],
};
const webSiteSchema = {
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  name: 'UX Mind',
  url: siteUrl,
  inLanguage: lang,
  publisher: { '@id': `${siteUrl}#organization` },
};
const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [orgSchema, webSiteSchema, ...extraSchemas],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Consent Mode v2 — výchozí stav: vše odmítnuto (EU opt-in). MUSÍ být před Google tagy. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        personalization_storage: 'denied',
        security_storage: 'granted',
        wait_for_update: 500,
      });
      // Aplikuj dřívější volbu ještě před vykreslením (žádné blikání pro vracející se návštěvníky)
      try {
        var __c = JSON.parse(localStorage.getItem('uxmind-consent') || 'null');
        if (__c && __c.v) {
          gtag('consent', 'update', {
            analytics_storage: __c.analytics ? 'granted' : 'denied',
            ad_storage: __c.marketing ? 'granted' : 'denied',
            ad_user_data: __c.marketing ? 'granted' : 'denied',
            ad_personalization: __c.marketing ? 'granted' : 'denied',
            personalization_storage: __c.marketing ? 'granted' : 'denied',
          });
        }
      } catch (e) {}
      gtag('js', new Date());
    </script>
    {GA_ID && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>}
    {GA_ID && <script is:inline set:html={`gtag('config', '${GA_ID}', { anonymize_ip: true });`} />}
    <link rel="icon" type="image/png" sizes="512x512" href={`${baseUrl}favicon.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${baseUrl}apple-touch-icon.png`} />
    <link rel="author" type="text/plain" href={`${baseUrl}humans.txt`} />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang — jazykové verze stránky -->
    {alternates.map(a => (
      <link rel="alternate" hreflang={a.code} href={a.url} />
    ))}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.url} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale" content={ogLocales[lang] ?? 'en_GB'} />
    {languages.filter(l => l.code !== lang).map(l => (
      <meta property="og:locale:alternate" content={ogLocales[l.code]} />
    ))}
    <meta property="og:site_name" content="UX Mind" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />
    <meta name="twitter:image:alt" content={fullTitle} />

    <!-- Strukturovaná data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Fonty jsou self-hostované přes Fontsource (import v global.css) -->
  </head>
  <body class="bg-brand-white text-brand-black">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[200] focus:bg-brand-black focus:text-brand-white focus:px-4 focus:py-2 font-mono text-xs tracking-widest">
      {skipLabels[lang] ?? 'Skip to content'}
    </a>
    <slot />

    <slot name="cursor" />

    <CookieConsent />

    {!isHome && (
      <script is:inline>
        (function () {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          var bar = document.createElement('div');
          bar.style.cssText = 'position:fixed;top:0;left:0;height:3px;width:0;background:#2D62FC;z-index:90;pointer-events:none;transition:width .1s linear;';
          document.body.appendChild(bar);
          function update() {
            var d = document.documentElement;
            var max = d.scrollHeight - window.innerHeight;
            bar.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
          }
          window.addEventListener('scroll', update, { passive: true });
          window.addEventListener('resize', update);
          update();
        })();
      </script>
    )}
  </body>
</html>
