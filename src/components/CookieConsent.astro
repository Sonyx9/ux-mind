    marketingT: 'Marketing',
    marketingD: 'Remarketing und Anzeigenmessung (Google Ads). Ermöglichen relevantere, messbare Werbung.',
    always: 'Immer aktiv',
    reopen: 'Cookie-Einstellungen',
  },
  fr: {
    title: 'Nous respectons votre vie privée',
    body: 'Nous utilisons des cookies pour faire fonctionner le site, mesurer l’audience et, le cas échéant, adapter le marketing. Les cookies nécessaires sont toujours actifs ; l’analyse et le marketing uniquement avec votre consentement.',
    policy: 'Politique cookies',
    acceptAll: 'Tout accepter',
    rejectAll: 'Tout refuser',
    settings: 'Paramètres',
    save: 'Enregistrer',
    back: 'Retour',
    necessaryT: 'Nécessaires',
    necessaryD: 'Requis pour le fonctionnement de base du site (langue, sécurité, mémorisation de ce choix). Non désactivables.',
    analyticsT: 'Analyse',
    analyticsD: 'Statistiques de fréquentation anonymes (Google Analytics) — elles nous aident à améliorer le site.',
    marketingT: 'Marketing',
    marketingD: 'Remarketing et mesure publicitaire (Google Ads). Pour une publicité plus pertinente et mesurable.',
    always: 'Toujours actif',
    reopen: 'Paramètres cookies',
  },
  es: {
    title: 'Valoramos tu privacidad',
    body: 'Usamos cookies para que el sitio funcione, medir el tráfico y, cuando proceda, personalizar el marketing. Las cookies necesarias siempre se ejecutan; las de análisis y marketing solo con tu consentimiento.',
    policy: 'Política de cookies',
