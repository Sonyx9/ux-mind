    acceptAll: 'Přijmout vše',
    rejectAll: 'Odmítnout vše',
    settings: 'Nastavení',
    save: 'Uložit volbu',
    back: 'Zpět',
    necessaryT: 'Nezbytné',
    necessaryD: 'Potřebné pro základní chod webu (jazyk, bezpečnost, zapamatování této volby). Nelze vypnout.',
    analyticsT: 'Analytické',
    analyticsD: 'Anonymní statistiky návštěvnosti (Google Analytics) — pomáhají nám web zlepšovat.',
    marketingT: 'Marketingové',
    marketingD: 'Remarketing a měření reklam (Google Ads). Umožňují cílenější a měřitelnou reklamu.',
    always: 'Vždy aktivní',
    reopen: 'Nastavení cookies',
  },
  en: {
    title: 'We value your privacy',
