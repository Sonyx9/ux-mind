---
import { getLang, localizedPath } from '../i18n/utils';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Strhnout base prefix (/ux-mind), jinak getLang na GitHub Pages vrátí vždy 'cs'
const rawPath = Astro.url.pathname;
const path = rawPath.startsWith(base) ? rawPath.slice(base.length) || '/' : rawPath;
const lang = getLang(path);

// Lokalizovaná stránka se zásadami cookies dle jazyka
const policyHref = base + localizedPath(lang, 'cookies');

type Str = {
  title: string;
  body: string;
  policy: string;
  acceptAll: string;
  rejectAll: string;
  settings: string;
  save: string;
  back: string;
  necessaryT: string;
  necessaryD: string;
  analyticsT: string;
  analyticsD: string;
  marketingT: string;
  marketingD: string;
  always: string;
  reopen: string;
};

const t: Record<string, Str> = {
  cs: {
    title: 'Vážíme si vašeho soukromí',
    body: 'Používáme cookies, abychom web zajistili funkční, měřili jeho návštěvnost a případně přizpůsobili marketing. Nezbytné cookies běží vždy; analytické a marketingové jen s vaším souhlasem.',
