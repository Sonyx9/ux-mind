    analyticsD: 'Anonymous traffic statistics (Google Analytics) — they help us improve the site.',
    marketingT: 'Marketing',
    marketingD: 'Remarketing and ad measurement (Google Ads). Enable more relevant, measurable advertising.',
    always: 'Always on',
    reopen: 'Cookie settings',
  },
  de: {
    title: 'Wir schätzen Ihre Privatsphäre',
    body: 'Wir verwenden Cookies, damit die Website funktioniert, die Zugriffe gemessen und Marketing ggf. angepasst werden. Notwendige Cookies laufen immer; Analyse und Marketing nur mit Ihrer Einwilligung.',
    policy: 'Cookie-Richtlinie',
    acceptAll: 'Alle akzeptieren',
    rejectAll: 'Alle ablehnen',
    settings: 'Einstellungen',
    save: 'Auswahl speichern',
    back: 'Zurück',
    necessaryT: 'Notwendig',
    necessaryD: 'Für den grundlegenden Betrieb der Website erforderlich (Sprache, Sicherheit, Speichern dieser Auswahl). Nicht abschaltbar.',
    analyticsT: 'Analyse',
