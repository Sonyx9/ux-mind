---
// Pás dlaždic s ukázkami výstupů (heatmapa, AOI, záznam pohledu). Klik otevře obrázek v plné velikosti.
// Mřížka: 3 položky = 3 sloupce, jinak (2, 4) = 2 sloupce → 4 ukázky jako 2×2.
import { ukazky, ukazkaPoznamka } from '../data/ukazky';

interface Props {
  ids: string[];
  label?: string;
  nadpis?: string;
}
const { ids, label = '[ UKÁZKA VÝSTUPŮ ]', nadpis = 'Takhle vypadají výstupy z měření' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const items = ids.map(id => ukazky.find(u => u.id === id)).filter(Boolean) as typeof ukazky;
---
<div class="reveal mb-24">
  <p class="font-mono text-xs text-brand-black/60 tracking-widest mb-4">{label}</p>
  <h2 class="font-display text-3xl md:text-5xl font-bold leading-tight max-w-3xl mb-10">
    {nadpis}<span style="color:#2D62FC">.</span>
  </h2>
  <div class={`grid grid-cols-1 ${items.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2'} gap-6`}>
    {items.map(u => (
      <figure class="group">
        <a href={`${base}/images/ukazky/${u.src}`} target="_blank" rel="noopener" class="relative block aspect-[4/3] overflow-hidden border border-brand-black/10 bg-brand-black/5" title={`${u.nadpis} – otevřít v plné velikosti`}>
          <img
            src={`${base}/images/ukazky/${u.src}`}
            alt={u.alt}
            title={u.nadpis}
            width={u.width} height={u.height} loading="lazy" decoding="async"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            style={`object-position: ${u.vyrez ?? (u.pozice === 'top' ? '50% 0%' : '50% 50%')};`}
          />
          {u.pozice === 'top' && (
            <span class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-brand-white to-transparent"></span>
          )}
          <span class="absolute right-3 bottom-3 font-mono text-[10px] tracking-widest uppercase bg-brand-black text-brand-white px-2 py-1">Zvětšit ↗</span>
        </a>
        <figcaption class="mt-4">
          <h3 class="font-display text-lg font-bold leading-tight mb-2">{u.nadpis}</h3>
          <p class="text-sm text-brand-black/60 leading-relaxed">{u.popis}</p>
        </figcaption>
      </figure>
    ))}
  </div>
  <p class="font-mono text-[11px] text-brand-black/60 mt-6">{ukazkaPoznamka}</p>
</div>
