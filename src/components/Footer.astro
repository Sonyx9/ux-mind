---
import { getLang, localizedPath, getNavLinks, getFooterSegments } from '../i18n/utils';
import ContactCta from './ContactCta.astro';
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Strhnout base prefix (/ux-mind), jinak getLang na GitHub Pages vrátí vždy 'cs'
const rawPath = Astro.url.pathname;
const langPath = rawPath.startsWith(base) ? rawPath.slice(base.length) || '/' : rawPath;
const lang = getLang(langPath);
const normalizedLangPath = langPath.replace(/\/+$/, '') || '/';
const showContactCta = lang === 'cs' && normalizedLangPath !== '/kontakt';
const cookiePolicyHref = base + localizedPath(lang, 'cookies');
// Zásady zpracování osobních údajů — jen v jazycích, kde stránka existuje (jinak by localizedPath spadl na home)
const privacyPath = localizedPath(lang, 'privacy');
const privacyPolicyHref = privacyPath !== localizedPath(lang, 'home') ? base + privacyPath : null;

// Navigace v patičce — jen hlavní položky (podstránky služeb jsou sbalené)
const nav = getNavLinks(lang);
const flatNav: { href: string; label: string; indent: boolean }[] =
  nav
    .filter(l => l.href !== '/segmenty')
    .map(l => ({ href: base + l.href, label: l.label, indent: false }));
// Sloupec „Pro koho" — hlavní segmenty (zatím jen čeština)
const footerSegments = getFooterSegments(lang).map(s => ({ href: base + s.href, label: s.label }));

const t = {
  cs: { desc: 'UX výzkum, UX audit a eye tracking. Odhalujeme, kde uživatelé tápou a co má smysl zlepšit.', nav: 'Navigace', segments: 'Pro koho', contact: 'Kontakt', rights: 'Všechna práva vyhrazena.', tagline: 'UX / EYE TRACKING / VÝZKUM UŽIVATELŮ', policy: 'Zásady cookies', privacy: 'Zpracování osobních údajů', settings: 'Nastavení cookies' },
  en: { desc: 'We specialise in UX research, UX audits and eye tracking. We help companies build better digital products.', nav: 'Navigation', segments: 'For whom', contact: 'Contact', rights: 'All rights reserved.', tagline: 'UX / EYE TRACKING / USER RESEARCH', policy: 'Cookie policy', privacy: 'Privacy policy', settings: 'Cookie settings' },
  de: { desc: 'Wir sind auf UX-Forschung, UX-Audits und Eye Tracking spezialisiert. Wir helfen Unternehmen, bessere digitale Produkte zu entwickeln.', nav: 'Navigation', segments: 'Für wen', contact: 'Kontakt', rights: 'Alle Rechte vorbehalten.', tagline: 'UX / EYE TRACKING / NUTZERFORSCHUNG', policy: 'Cookie-Richtlinie', privacy: 'Datenschutz', settings: 'Cookie-Einstellungen' },
  fr: { desc: 'Nous sommes spécialisés en recherche UX, audits UX et eye tracking. Nous aidons les entreprises à créer de meilleurs produits numériques.', nav: 'Navigation', segments: 'Pour qui', contact: 'Contact', rights: 'Tous droits réservés.', tagline: 'UX / EYE TRACKING / RECHERCHE UTILISATEURS', policy: 'Politique cookies', privacy: 'Confidentialité', settings: 'Paramètres cookies' },
  es: { desc: 'Nos especializamos en investigación UX, auditorías UX y eye tracking. Ayudamos a las empresas a crear mejores productos digitales.', nav: 'Navegación', segments: 'Para quién', contact: 'Contacto', rights: 'Todos los derechos reservados.', tagline: 'UX / EYE TRACKING / INVESTIGACIÓN DE USUARIOS', policy: 'Política de cookies', privacy: 'Privacidad', settings: 'Configuración de cookies' },
};
const s = t[lang] ?? t.en;
---

{showContactCta && <ContactCta href={`${base}/kontakt`} />}

<footer class="border-t border-brand-black/10 desktop-gutter-x py-12 mt-24">
  <div class:list={["max-w-7xl mx-auto grid grid-cols-1 gap-12 px-6 md:px-0", footerSegments.length ? "md:grid-cols-6" : "md:grid-cols-4"]}>
    <div class="md:col-span-2">
      <img src={`${base}/logo.svg`} alt="UX Mind" class="h-6 w-auto mb-4" />
      <p class="text-sm text-brand-black/60 max-w-xs leading-relaxed">
        {s.desc}
      </p>
    </div>

    <div>
      <p class="font-mono text-xs tracking-widest uppercase mb-4 text-brand-black/60">{s.nav}</p>
      <ul class="space-y-2">
        {flatNav.map(link => (
          <li class={link.indent ? 'pl-3' : ''}>
            <a href={link.href} class={`text-sm hover:text-[#2D62FC] transition-colors ${link.indent ? 'text-brand-black/45' : 'text-brand-black/60'}`}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    {footerSegments.length > 0 && (
      <div class="md:col-span-2">
        <p class="font-mono text-xs tracking-widest uppercase mb-4 text-brand-black/60">{s.segments}</p>
        <ul class="grid grid-cols-2 gap-x-8 gap-y-2">
          {footerSegments.map(link => (
            <li>
              <a href={link.href} class="text-sm text-brand-black/60 hover:text-[#2D62FC] transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div>
      <p class="font-mono text-xs tracking-widest uppercase mb-4 text-brand-black/60">{s.contact}</p>
      <ul class="space-y-2">
        <li>
          <a href="mailto:spoluprace@uxmind.cz" class="text-sm text-brand-black/60 hover:text-[#2D62FC] transition-colors">
            spoluprace@uxmind.cz
          </a>
        </li>
        <li>
          <a href="tel:+420728601160" class="text-sm text-brand-black/60 hover:text-[#2D62FC] transition-colors">
            +420 728 601 160
          </a>
        </li>
      </ul>
      <div class="mt-4 pt-3 border-t border-brand-black/10">
        <p class="text-sm text-brand-black/60">UX MIND Research Lab s.r.o.</p>
        <p class="text-sm text-brand-black/60">IČO: 29714966</p>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto mt-12 pt-8 border-t border-brand-black/10 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 px-6 md:px-0">
    <p class="font-mono text-xs text-brand-black/60">
      <a href="https://lukaskoula.com" target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-brand-black/60 hover:text-[#2D62FC] transition-colors">Lukáš Koula</a> © {currentYear} UX Mind. {s.rights}
    </p>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
      {privacyPolicyHref && (
        <a href={privacyPolicyHref} class="font-mono text-xs text-brand-black/60 hover:text-[#2D62FC] transition-colors">{s.privacy}</a>
      )}
      <a href={cookiePolicyHref} class="font-mono text-xs text-brand-black/60 hover:text-[#2D62FC] transition-colors">{s.policy}</a>
      <button type="button" onclick="window.uxmindConsent && window.uxmindConsent.open()" class="font-mono text-xs text-brand-black/60 hover:text-[#2D62FC] transition-colors">{s.settings}</button>
      <p class="font-mono text-xs text-brand-black/60">{s.tagline}</p>
    </div>
  </div>
</footer>
