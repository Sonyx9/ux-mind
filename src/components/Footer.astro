---
import { getLang, localizedPath } from '../i18n/utils';
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Strhnout base prefix (/ux-mind), jinak getLang na GitHub Pages vrátí vždy 'cs'
const rawPath = Astro.url.pathname;
const langPath = rawPath.startsWith(base) ? rawPath.slice(base.length) || '/' : rawPath;
const lang = getLang(langPath);
const cookiePolicyHref = base + localizedPath(lang, 'cookies');
const cookieLabels: Record<string, { policy: string; settings: string }> = {
  cs: { policy: 'Zásady cookies', settings: 'Nastavení cookies' },
  en: { policy: 'Cookie policy', settings: 'Cookie settings' },
  de: { policy: 'Cookie-Richtlinie', settings: 'Cookie-Einstellungen' },
  fr: { policy: 'Politique cookies', settings: 'Paramètres cookies' },
  es: { policy: 'Política de cookies', settings: 'Configuración de cookies' },
};
const cl = cookieLabels[lang] ?? cookieLabels.en;
---

<footer class="border-t border-brand-black/10 desktop-gutter-x py-12 mt-24">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12 px-6 md:px-0">
    <div class="md:col-span-2">
      <img src={`${base}/logo.svg`} alt="UX Mind" class="h-6 w-auto mb-4" />
      <p class="text-sm text-brand-black/60 max-w-xs leading-relaxed">
        Specializujeme se na UX výzkum, UX audit a eye tracking. Pomáháme firmám vytvářet lepší digitální produkty.
      </p>
    </div>

    <div>
      <p class="font-mono text-xs tracking-widest uppercase mb-4 text-brand-black/60">Navigace</p>
      <ul class="space-y-2">
        {[
          { href: '/sluzby', label: 'Služby' },
          { href: '/pripadove-studie', label: 'Případové studie' },
          { href: '/o-nas', label: 'O nás' },
          { href: '/partneri', label: 'Partneři' },
        ].map(link => (
          <li>
            <a href={link.href} class="text-sm text-brand-black/60 hover:text-brand-black transition-colors">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="font-mono text-xs tracking-widest uppercase mb-4 text-brand-black/60">Kontakt</p>
      <ul class="space-y-2">
        <li>
          <a href="mailto:spoluprace@uxmind.cz" class="text-sm text-brand-black/60 hover:text-brand-black transition-colors">
            spoluprace@uxmind.cz
          </a>
        </li>
        <li>
          <a href="tel:+420728601160" class="text-sm text-brand-black/60 hover:text-brand-black transition-colors">
            +420 728 601 160
          </a>
        </li>
      </ul>
      <div class="mt-4 pt-3 border-t border-brand-black/10">
        <p class="text-sm text-brand-black/60">UX MIND Research Lab s.r.o.</p>
        <p class="text-sm text-brand-black/60">IČO: 29714966</p>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto mt-12 pt-8 border-t border-brand-black/10 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 px-6 md:px-0">
    <p class="font-mono text-xs text-brand-black/60">
      <a href="https://lukaskoula.com" target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-brand-black/60">Lukáš Koula</a> © {currentYear} UX Mind. Všechna práva vyhrazena.
    </p>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
      <a href={cookiePolicyHref} class="font-mono text-xs text-brand-black/60 hover:text-brand-black transition-colors">{cl.policy}</a>
      <button type="button" onclick="window.uxmindConsent && window.uxmindConsent.open()" class="font-mono text-xs text-brand-black/60 hover:text-brand-black transition-colors">{cl.settings}</button>
      <p class="font-mono text-xs text-brand-black/60">UX / EYE TRACKING / VÝZKUM UŽIVATELŮ</p>
    </div>
  </div>
</footer>
