---
import { getLang, getPathInLang, getNavLinks, languages } from '../i18n/utils';

const currentPath = Astro.url.pathname;
// Strip base prefix so comparisons work both locally and on GitHub Pages
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = currentPath.startsWith(base) ? currentPath.slice(base.length) || '/' : currentPath;
const lang = getLang(path);
const navLinks = getNavLinks(lang).map(l => ({
  ...l,
  href: base + l.href,
  children: l.children?.map(c => ({ ...c, href: base + c.href })),
}));
// Jazykové menu: aktuální jazyk + odkazy na tutéž stránku v ostatních jazycích
const langItems = languages.map(l => ({
  code: l.code,
  label: l.label,
  href: base + getPathInLang(path, l.code),
  current: l.code === lang,
}));
const currentLangLabel = langItems.find(l => l.current)?.label ?? 'CZ';
const homeHref = base + getPathInLang('/', lang);
const contactHref = base + getPathInLang('/kontakt', lang);
const t = {
  cs: { cta: 'DOMLUVIT SCHŮZKU', close: 'ZAVŘÍT', langTitle: 'Jazyk webu', fsTitle: 'Velikost písma', fsSmall: 'Malé písmo', fsMedium: 'Střední písmo', fsLarge: 'Velké písmo' },
  en: { cta: 'BOOK A MEETING', close: 'CLOSE', langTitle: 'Site language', fsTitle: 'Font size', fsSmall: 'Small text', fsMedium: 'Medium text', fsLarge: 'Large text' },
  de: { cta: 'TERMIN VEREINBAREN', close: 'SCHLIESSEN', langTitle: 'Sprache der Website', fsTitle: 'Schriftgröße', fsSmall: 'Kleine Schrift', fsMedium: 'Mittlere Schrift', fsLarge: 'Große Schrift' },
  fr: { cta: 'PRENDRE RENDEZ-VOUS', close: 'FERMER', langTitle: 'Langue du site', fsTitle: 'Taille du texte', fsSmall: 'Petit texte', fsMedium: 'Texte moyen', fsLarge: 'Grand texte' },
  es: { cta: 'CONCERTAR UNA CITA', close: 'CERRAR', langTitle: 'Idioma del sitio', fsTitle: 'Tamaño del texto', fsSmall: 'Texto pequeño', fsMedium: 'Texto mediano', fsLarge: 'Texto grande' },
}[lang];
const mobileCTALabel = t.cta;
const isHome = ['/', '/en/', '/en', '/de/', '/de', '/fr/', '/fr', '/es/', '/es'].includes(path);
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 py-5 mix-blend-multiply transition-colors duration-300">
  <div id="nav-inner" class="desktop-gutter-x relative flex items-center justify-between">
    <!-- Logo (desktop: fades in after scroll; mobile non-homepage: always visible) -->
    <a id="nav-logo" href={homeHref} class="block hover:opacity-50 transition-opacity ml-[5px]" style={`line-height:0; opacity:0; pointer-events:none; transition: opacity 0.3s ease; ${!isHome ? 'opacity:1; pointer-events:auto;' : ''}`}>
      <img src={`${base}/logo.svg`} alt="UX Mind" width="551" height="94" style="height:clamp(18px, 0.55vw + 14px, 22px); width:auto; display:block;" />
    </a>

    <!-- Mobile CTA — na všech stránkách (mezi logem a [ MENU ]) -->
    <a href={contactHref} class="md:hidden font-mono text-[10px] tracking-widest uppercase bg-brand-black text-brand-white px-3 py-1.5 whitespace-nowrap shrink-0">
      {mobileCTALabel}
    </a>

    <div id="nav-full" class="hidden xl:flex items-center gap-[clamp(1rem,1.8vw,2rem)]">
      {navLinks.map(link => link.children ? (
        <div class="nav-drop relative">
          <a
            href={link.href}
            class={`flex items-center gap-1 font-mono text-[clamp(0.625rem,0.28vw+0.48rem,0.75rem)] tracking-widest uppercase transition-opacity ${
              currentPath === link.href || currentPath === link.href.replace(/\/$/, '') + '/' || link.children.some(c => currentPath === c.href || currentPath === c.href.replace(/\/$/, '') + '/')
                ? 'opacity-100' : 'opacity-60 hover:opacity-100 hover:text-[#2D62FC]'
            }`}
            aria-haspopup="true"
          >
            {link.label}<span style="font-size:7px; line-height:1;">▼</span>
          </a>
          <div class="nav-drop-menu hidden absolute left-0 top-full pt-2 z-[110]">
            <div class="isolate bg-brand-white border border-brand-black/20 shadow-sm min-w-max">
              {link.children.map(c => (
                <a
                  href={c.href}
                  class={`block px-4 py-2 font-mono text-[clamp(0.625rem,0.28vw+0.48rem,0.75rem)] tracking-widest uppercase transition-colors ${
                    currentPath === c.href || currentPath === c.href.replace(/\/$/, '') + '/' ? 'opacity-100' : 'opacity-60 hover:opacity-100 hover:text-[#2D62FC] hover:bg-[#2D62FC]/10'
                  }`}
                >
                  {c.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      ) : link.href === contactHref ? (
        <a
          href={link.href}
          class="font-mono text-[clamp(0.625rem,0.28vw+0.48rem,0.75rem)] tracking-widest uppercase border border-brand-black px-3 py-1.5 transition-colors hover:border-[#2D62FC] hover:text-[#2D62FC]"
        >
          {link.label}
        </a>
      ) : (
        <a
          href={link.href}
          class={`font-mono text-[clamp(0.625rem,0.28vw+0.48rem,0.75rem)] tracking-widest uppercase transition-opacity ${
            currentPath === link.href || currentPath === link.href.replace(/\/$/, '') + '/' ? 'opacity-100' : 'opacity-60 hover:opacity-100 hover:text-[#2D62FC]'
          }`}
        >
          {link.label}
        </a>
      ))}
      <div class="lang-switch relative font-mono text-[clamp(0.625rem,0.28vw+0.48rem,0.75rem)] tracking-widest uppercase">
        <button class="lang-toggle font-medium flex items-center gap-1 hover:opacity-50 transition-opacity" aria-haspopup="listbox" aria-expanded="false" title={t.langTitle}>
          {currentLangLabel}<span style="font-size:7px; line-height:1;">▼</span>
        </button>
        <div class="lang-menu hidden absolute right-0 top-full mt-2 bg-brand-white border border-brand-black/20 z-[110] shadow-sm" role="listbox">
          {langItems.map(item => item.current
            ? <span class="block px-3 py-1.5 font-medium" aria-current="true">{item.label}</span>
            : <a href={item.href} class="block px-3 py-1.5 opacity-60 hover:opacity-100 transition-opacity">{item.label}</a>
          )}
        </div>
      </div>
      <div class="fs-switch flex flex-col items-center" aria-label={t.fsTitle}>
        <div class="flex items-end" style="gap:3px;">
          <button data-fs="1" class="border border-brand-black/40 hover:border-brand-black transition-colors" style="width:7px; height:8px;" title={t.fsSmall} aria-label={t.fsSmall}></button>
          <button data-fs="1.08" class="border border-brand-black/40 hover:border-brand-black transition-colors" style="width:7px; height:12px;" title={t.fsMedium} aria-label={t.fsMedium}></button>
          <button data-fs="1.16" class="border border-brand-black/40 hover:border-brand-black transition-colors" style="width:7px; height:16px;" title={t.fsLarge} aria-label={t.fsLarge}></button>
        </div>
        <span class="font-mono tracking-widest text-brand-black/60 mt-0.5" style="font-size:8px;">TEXT</span>
      </div>
    </div>

    <!-- Tablet (md–<xl): jen [ MENU ]. Jazyk je v rozbalovacím menu, přepínač písma je jen na PC. -->
    <button id="mobile-menu-btn" class="hidden md:block xl:hidden font-mono text-xs tracking-widest uppercase" aria-label="Menu">[ MENU ]</button>

    <!-- Mobile-only menu button (< md) -->
    <button
      id="mobile-menu-btn-sm"
      class="md:hidden font-mono text-xs tracking-widest uppercase"
      aria-label="Menu"
    >
      [ MENU ]
    </button>
  </div>
</nav>

<!-- Slide-in menu -->
<div
  id="mobile-menu"
  class="fixed top-0 right-0 bottom-0 z-[100] bg-brand-white w-4/5 max-w-xs flex flex-col pt-20 px-8 pb-8 gap-6 shadow-2xl"
  style="transform: translateX(100%); transition: transform 0.3s ease;"
>
  <button id="mobile-menu-close" class="absolute top-5 right-6 font-mono text-xs tracking-widest">[ {t.close} ]</button>
  {navLinks.map(link => (
    <div class="border-b border-brand-black/10 pb-4">
      <div class="flex items-center justify-between gap-3">
        <a href={link.href} class="font-display text-2xl font-bold hover:text-[#2D62FC] transition-colors">
          {link.label}
        </a>
        {link.children && link.children.length > 0 && (
          <button type="button" class="mobile-submenu-toggle font-mono text-2xl leading-none w-8 h-8 flex items-center justify-center shrink-0 transition-transform" aria-expanded="false" aria-label="Rozbalit podpoložky">+</button>
        )}
      </div>
      {link.children && link.children.length > 0 && (
        <div class="mobile-submenu hidden mt-3 flex-col gap-2.5 pl-4 border-l border-brand-black/15">
          {link.children.map(c => (
            <a href={c.href} class="font-mono text-xs tracking-widest uppercase opacity-60 hover:opacity-100 hover:text-[#2D62FC] transition-colors">
              {c.label}
            </a>
          ))}
        </div>
      )}
    </div>
  ))}
  <div class="flex gap-4 mt-2">
    {langItems.filter(l => !l.current).map(item => (
      <a href={item.href} class="font-mono text-sm tracking-widest uppercase opacity-60 hover:opacity-100 transition-opacity">
        {item.label} ↗
      </a>
    ))}
  </div>
</div>

<!-- Overlay backdrop -->
<div id="mobile-overlay" class="fixed inset-0 z-[99] bg-brand-black/30 hidden"></div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;
  const overlay = document.getElementById('mobile-overlay');

  function openMenu() {
    if (menu) menu.style.transform = 'translateX(0)';
    overlay?.classList.remove('hidden');
  }
  function closeMenu() {
    if (menu) menu.style.transform = 'translateX(100%)';
    overlay?.classList.add('hidden');
  }

  btn?.addEventListener('click', openMenu);
  document.getElementById('mobile-menu-btn-sm')?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });

  // Mobilní podmenu (Služby, Pro koho): sbalené, rozbalí se po kliku na „+"
  document.querySelectorAll<HTMLButtonElement>('.mobile-submenu-toggle').forEach(toggle => {
    const sub = toggle.closest('div')?.parentElement?.querySelector<HTMLElement>('.mobile-submenu');
    if (!sub) return;
    toggle.addEventListener('click', () => {
      const open = sub.classList.toggle('hidden') === false;
      sub.classList.toggle('flex', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.style.transform = open ? 'rotate(45deg)' : '';
    });
  });

  const nav = document.getElementById('main-nav');
  const logo = document.getElementById('nav-logo') as HTMLAnchorElement | null;
  const isHomePage = document.querySelector('h1') !== null && logo?.style.opacity === '0';

  // Viditelnost skupin menu (PC / tablet / mobil) řídí výhradně CSS breakpointy
  // (hidden xl:flex / md:block xl:hidden / md:hidden) — stejně jako na ostatních
  // stránkách. JS zde jen na homepage vysouvá logo po odscrollování z hero.
  function updateNav() {
    if (!nav) return;
    const scrolled = window.scrollY > 30;
    nav.style.background = scrolled ? 'rgba(252,252,252,0.85)' : '';
    nav.style.backdropFilter = scrolled ? 'blur(8px)' : '';
    nav.style.mixBlendMode = scrolled ? 'normal' : 'multiply';

    if (logo && isHomePage) {
      const h1 = document.querySelector('h1');
      if (h1) {
        const showLogo = h1.getBoundingClientRect().bottom < 0;
        logo.style.opacity = showLogo ? '1' : '0';
        logo.style.pointerEvents = showLogo ? 'auto' : 'none';
      }
    }
  }
  window.addEventListener('scroll', updateNav, { passive: true });
  window.addEventListener('resize', updateNav);
  updateNav();

  // Přepínač velikosti textu — tři sloupce (malý/střední/velký) s popiskem TEXT.
  // Škáluje se POUZE obsah pod hero sekcí (zoom) — hero, navigace ani scroll indikátor se nemění.
  (function () {
    const FS_KEY = 'uxmind-font-scale';
    const LEVELS = [1, 1.08, 1.16];
    const bars = document.querySelectorAll<HTMLButtonElement>('.fs-switch button');

    function applyFS(v: number) {
      const idx = LEVELS.indexOf(v);
      // root font-size neškálujeme (kvůli art-directed hero layoutu)
      document.documentElement.style.fontSize = '';
      // hero texty se škálují přes CSS proměnnou --fs (pozice v mřížce zůstávají)
      document.documentElement.style.setProperty('--fs', v === 1 ? '' : String(v));
      // zoom na obsahové bloky: vše za hero sekcí + main a footer na podstránkách
      document.querySelectorAll<HTMLElement>('.hero-shell ~ *, main, footer').forEach(el => {
        el.style.setProperty('zoom', v === 1 ? '' : String(v));
      });
      bars.forEach(b => {
        const bi = LEVELS.indexOf(parseFloat(b.dataset.fs || '1'));
        const filled = bi > -1 && bi <= idx;
        b.style.background = filled ? '#0A0A0A' : 'transparent';
        b.setAttribute('aria-pressed', bi === idx ? 'true' : 'false');
      });
    }

    let fs = parseFloat(localStorage.getItem(FS_KEY) || '1');
    if (!LEVELS.includes(fs)) fs = 1;
    applyFS(fs);

    bars.forEach(b => b.addEventListener('click', () => {
      fs = parseFloat(b.dataset.fs || '1');
      localStorage.setItem(FS_KEY, String(fs));
      applyFS(fs);
    }));
  })();

  // Dropdown Služby v desktop navigaci — otevírá se na hover/focus.
  // Při otevření vypínáme mix-blend-multiply na navigaci (stejně jako u jazykového menu),
  // jinak by bílý podklad menu působil průhledně.
  (function () {
    const navEl = document.getElementById('main-nav');
    document.querySelectorAll<HTMLElement>('.nav-drop').forEach(drop => {
      const menu = drop.querySelector<HTMLElement>('.nav-drop-menu');
      const show = () => {
        menu?.classList.remove('hidden');
        if (navEl) navEl.style.mixBlendMode = 'normal';
      };
      const hide = () => {
        menu?.classList.add('hidden');
        if (navEl) navEl.style.mixBlendMode = window.scrollY > 30 ? 'normal' : 'multiply';
      };
      drop.addEventListener('mouseenter', show);
      drop.addEventListener('mouseleave', hide);
      drop.addEventListener('focusin', show);
      drop.addEventListener('focusout', e => {
        if (!drop.contains(e.relatedTarget as Node)) hide();
      });
    });
  })();

  // Jazykový přepínač — rozbalovací menu (aktuální jazyk + další; připraveno na víc jazyků).
  // Při otevření vypínáme mix-blend-multiply na navigaci, jinak by bílý podklad menu působil průhledně.
  (function () {
    const switches = document.querySelectorAll<HTMLElement>('.lang-switch');
    const navEl = document.getElementById('main-nav');
    function closeAll() {
      switches.forEach(s => {
        s.querySelector('.lang-menu')?.classList.add('hidden');
        s.querySelector('.lang-toggle')?.setAttribute('aria-expanded', 'false');
      });
      if (navEl) navEl.style.mixBlendMode = window.scrollY > 30 ? 'normal' : 'multiply';
    }
    switches.forEach(s => {
      const toggle = s.querySelector<HTMLElement>('.lang-toggle');
      const menu = s.querySelector<HTMLElement>('.lang-menu');
      toggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        const wasOpen = menu ? !menu.classList.contains('hidden') : false;
        closeAll();
        if (!wasOpen && menu && toggle) {
          menu.classList.remove('hidden');
          toggle.setAttribute('aria-expanded', 'true');
          if (navEl) navEl.style.mixBlendMode = 'normal';
        }
      });
    });
    document.addEventListener('click', closeAll);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAll(); });
    window.addEventListener('scroll', closeAll, { passive: true });
  })();
</script>
