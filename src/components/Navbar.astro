---
import { getLang, getAlternatePath, getNavLinks } from '../i18n/utils';

const currentPath = Astro.url.pathname;
// Strip base prefix so comparisons work both locally and on GitHub Pages
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = currentPath.startsWith(base) ? currentPath.slice(base.length) || '/' : currentPath;
const lang = getLang(path);
const alternatePath = base + getAlternatePath(path);
const navLinks = getNavLinks(lang).map(l => ({ ...l, href: base + l.href }));
const altLabel = lang === 'cs' ? 'EN' : 'CZ';
const homeHref = base + (lang === 'cs' ? '/' : '/en/');
const contactHref = base + (lang === 'cs' ? '/kontakt' : '/en/contact');
const mobileCTALabel = lang === 'cs' ? 'DOMLUVIT SCHŮZKU' : 'BOOK A MEETING';
const isHome = path === '/' || path === '/en/' || path === '/en';
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 py-5 mix-blend-multiply transition-colors duration-300">
  <div id="nav-inner" class="desktop-gutter-x relative flex items-center justify-between">
    <!-- Logo (desktop: fades in after scroll; mobile non-homepage: always visible) -->
    <a id="nav-logo" href={homeHref} class="block hover:opacity-50 transition-opacity ml-[5px]" style={`line-height:0; opacity:0; pointer-events:none; transition: opacity 0.3s ease; ${!isHome ? 'opacity:1; pointer-events:auto;' : ''}`}>
      <img src={`${base}/logo.svg`} alt="UX Mind" style="height:clamp(18px, 0.55vw + 14px, 22px); width:auto; display:block;" />
    </a>

    <!-- Mobile CTA — only on homepage, left side -->
    {isHome && (
      <a href={contactHref} class="md:hidden font-mono text-[10px] tracking-widest uppercase bg-brand-black text-brand-white px-3 py-1.5">
        {mobileCTALabel}
      </a>
    )}

    <div id="nav-full" class="hidden 3xl:flex items-center gap-[clamp(1rem,1.8vw,2rem)]">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`font-mono text-[clamp(0.625rem,0.28vw+0.48rem,0.75rem)] tracking-widest uppercase transition-opacity ${
            currentPath === link.href || currentPath === link.href.replace(/\/$/, '') + '/' ? 'opacity-100' : 'opacity-50 hover:opacity-100'
          }`}
        >
          {link.label}
        </a>
      ))}
      <div class="flex items-center gap-1 font-mono text-[clamp(0.625rem,0.28vw+0.48rem,0.75rem)] tracking-widest uppercase">
        <span class="border border-brand-black px-1.5 py-0.5 font-medium">{lang === 'cs' ? 'CZ' : 'EN'}</span>
        <span class="opacity-30">/</span>
        <a href={alternatePath} class="border border-brand-black/30 px-1.5 py-0.5 opacity-40 hover:opacity-100 hover:border-brand-black transition-all">{altLabel}</a>
      </div>
      <div class="fs-switch flex items-end gap-1 font-mono" aria-label={lang === 'cs' ? 'Velikost písma' : 'Font size'}>
        <button data-fs="1" class="border border-brand-black/30 px-1.5 leading-tight" style="font-size:10px; padding-top:3px; padding-bottom:3px;" title={lang === 'cs' ? 'Základní písmo' : 'Default font size'}>A</button>
        <button data-fs="1.08" class="border border-brand-black/30 px-1.5 leading-tight" style="font-size:12px; padding-top:2px; padding-bottom:2px;" title={lang === 'cs' ? 'Větší písmo' : 'Larger font size'}>A</button>
        <button data-fs="1.16" class="border border-brand-black/30 px-1.5 leading-tight" style="font-size:14px; padding-top:1px; padding-bottom:1px;" title={lang === 'cs' ? 'Největší písmo' : 'Largest font size'}>A</button>
      </div>
    </div>

    <!-- Hamburger row — md up to 1800px -->
    <div id="nav-hamburger" class="hidden md:flex 3xl:hidden items-center gap-3">
      <button id="mobile-menu-btn" class="font-mono text-xs tracking-widest uppercase" aria-label="Menu">[ MENU ]</button>
      <div class="flex items-center gap-1 font-mono text-xs tracking-widest uppercase">
        <span class="border border-brand-black px-1.5 py-0.5 font-medium">{lang === 'cs' ? 'CZ' : 'EN'}</span>
        <span class="opacity-30">/</span>
        <a href={alternatePath} class="border border-brand-black/30 px-1.5 py-0.5 opacity-40 hover:opacity-100 hover:border-brand-black transition-all">{altLabel}</a>
      </div>
      <div class="fs-switch flex items-end gap-1 font-mono" aria-label={lang === 'cs' ? 'Velikost písma' : 'Font size'}>
        <button data-fs="1" class="border border-brand-black/30 px-1.5 leading-tight" style="font-size:10px; padding-top:3px; padding-bottom:3px;" title={lang === 'cs' ? 'Základní písmo' : 'Default font size'}>A</button>
        <button data-fs="1.08" class="border border-brand-black/30 px-1.5 leading-tight" style="font-size:12px; padding-top:2px; padding-bottom:2px;" title={lang === 'cs' ? 'Větší písmo' : 'Larger font size'}>A</button>
        <button data-fs="1.16" class="border border-brand-black/30 px-1.5 leading-tight" style="font-size:14px; padding-top:1px; padding-bottom:1px;" title={lang === 'cs' ? 'Největší písmo' : 'Largest font size'}>A</button>
      </div>
    </div>

    <!-- Mobile-only menu button (< md) -->
    <button
      id="mobile-menu-btn-sm"
      class="md:hidden font-mono text-xs tracking-widest uppercase"
      aria-label="Menu"
    >
      [ MENU ]
    </button>
  </div>
</nav>

<!-- Slide-in menu -->
<div
  id="mobile-menu"
  class="fixed top-0 right-0 bottom-0 z-[100] bg-brand-white w-4/5 max-w-xs flex flex-col pt-20 px-8 pb-8 gap-6 shadow-2xl"
  style="transform: translateX(100%); transition: transform 0.3s ease;"
>
  <button id="mobile-menu-close" class="absolute top-5 right-6 font-mono text-xs tracking-widest">[ {lang === 'cs' ? 'ZAVŘÍT' : 'CLOSE'} ]</button>
  {navLinks.map(link => (
    <a
      href={link.href}
      class="font-display text-2xl font-bold hover:opacity-50 transition-opacity border-b border-brand-black/10 pb-4"
    >
      {link.label}
    </a>
  ))}
  <a href={alternatePath} class="font-mono text-sm tracking-widest uppercase opacity-40 hover:opacity-100 transition-opacity mt-2">
    {altLabel} ↗
  </a>
</div>

<!-- Overlay backdrop -->
<div id="mobile-overlay" class="fixed inset-0 z-[99] bg-brand-black/30 hidden"></div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;
  const overlay = document.getElementById('mobile-overlay');

  function openMenu() {
    if (menu) menu.style.transform = 'translateX(0)';
    overlay?.classList.remove('hidden');
  }
  function closeMenu() {
    if (menu) menu.style.transform = 'translateX(100%)';
    overlay?.classList.add('hidden');
  }

  btn?.addEventListener('click', openMenu);
  document.getElementById('mobile-menu-btn-sm')?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  const nav = document.getElementById('main-nav');
  const logo = document.getElementById('nav-logo') as HTMLAnchorElement | null;
  const isHomePage = document.querySelector('h1') !== null && logo?.style.opacity === '0';

  const navFull = document.getElementById('nav-full') as HTMLElement | null;
  const navHamburger = document.getElementById('nav-hamburger') as HTMLElement | null;
  const mobileMenuSm = document.getElementById('mobile-menu-btn-sm');

  function applyHomeMenuVisibility(showLogo: boolean) {
    if (!navFull || !navHamburger) return;
    const w = window.innerWidth;
    const menuBtn = document.getElementById('mobile-menu-btn');

    if (!showLogo) {
      // Hero: jen sbalené [ MENU ] — vycentrované, vpravo zůstávají CZ/EN + velikost písma
      navFull.style.display = 'none';
      if (w >= 768) {
        navHamburger.style.display = 'flex';
        if (menuBtn) {
          menuBtn.style.position = 'absolute';
          menuBtn.style.left = '50%';
          menuBtn.style.transform = 'translateX(-50%)';
        }
      } else {
        navHamburger.style.display = 'none';
        if (mobileMenuSm) mobileMenuSm.style.display = '';
      }
      return;
    }

    // Po scrollu: rozbalená navigace jako na podstránkách, [ MENU ] zpět vpravo
    if (menuBtn) {
      menuBtn.style.position = '';
      menuBtn.style.left = '';
      menuBtn.style.transform = '';
    }
    if (mobileMenuSm) mobileMenuSm.style.display = '';

    if (w >= 1800) {
      navFull.style.display = 'flex';
      navHamburger.style.display = 'none';
    } else if (w >= 768) {
      navFull.style.display = 'flex';
      navHamburger.style.display = 'none';
    } else {
      navFull.style.display = 'none';
      navHamburger.style.display = 'none';
    }
  }

  function updateNav() {
    if (!nav) return;
    const scrolled = window.scrollY > 30;
    nav.style.background = scrolled ? 'rgba(252,252,252,0.85)' : '';
    nav.style.backdropFilter = scrolled ? 'blur(8px)' : '';
    nav.style.mixBlendMode = scrolled ? 'normal' : 'multiply';

    if (logo && isHomePage) {
      const h1 = document.querySelector('h1');
      if (h1) {
        const showLogo = h1.getBoundingClientRect().bottom < 0;
        logo.style.opacity = showLogo ? '1' : '0';
        logo.style.pointerEvents = showLogo ? 'auto' : 'none';
        applyHomeMenuVisibility(showLogo);
      }
    }
  }
  window.addEventListener('scroll', updateNav, { passive: true });
  window.addEventListener('resize', updateNav);
  updateNav();

  // Přepínač velikosti písma (A A A) — škáluje rem jednotky, volba se pamatuje
  (function () {
    const FS_KEY = 'uxmind-font-scale';
    const buttons = document.querySelectorAll<HTMLButtonElement>('.fs-switch button');
    function applyFS(v: number) {
      document.documentElement.style.fontSize = v === 1 ? '' : (v * 100) + '%';
      buttons.forEach(b => {
        const active = parseFloat(b.dataset.fs || '1') === v;
        b.style.borderColor = active ? '#0A0A0A' : 'rgba(10,10,10,0.3)';
        b.style.opacity = active ? '1' : '0.45';
      });
    }
    let fs = parseFloat(localStorage.getItem(FS_KEY) || '1');
    if (![1, 1.08, 1.16].includes(fs)) fs = 1;
    applyFS(fs);
    buttons.forEach(b => b.addEventListener('click', () => {
      fs = parseFloat(b.dataset.fs || '1');
      localStorage.setItem(FS_KEY, String(fs));
      applyFS(fs);
    }));
  })();
</script>
