---
import { getLang, getAlternatePath, getNavLinks } from '../i18n/utils';

const currentPath = Astro.url.pathname;
// Strip base prefix so comparisons work both locally and on GitHub Pages
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = currentPath.startsWith(base) ? currentPath.slice(base.length) || '/' : currentPath;
const lang = getLang(path);
const alternatePath = base + getAlternatePath(path);
const navLinks = getNavLinks(lang).map(l => ({ ...l, href: base + l.href }));
const altLabel = lang === 'cs' ? 'EN' : 'CZ';
const homeHref = base + (lang === 'cs' ? '/' : '/en/');
const contactHref = base + (lang === 'cs' ? '/kontakt' : '/en/contact');
const mobileCTALabel = lang === 'cs' ? 'DOMLUVIT SCHŮZKU' : 'BOOK A MEETING';
const isHome = path === '/' || path === '/en/' || path === '/en';
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 py-5 mix-blend-multiply transition-colors duration-300">
  <div id="nav-inner" class="desktop-gutter-x relative flex items-center justify-between">
    <!-- Logo (desktop: fades in after scroll; mobile non-homepage: always visible) -->
    <a id="nav-logo" href={homeHref} class="block hover:opacity-50 transition-opacity ml-[5px]" style={`line-height:0; opacity:0; pointer-events:none; transition: opacity 0.3s ease; ${!isHome ? 'opacity:1; pointer-events:auto;' : ''}`}>
      <img src={`${base}/logo.svg`} alt="UX Mind" style="height:clamp(18px, 0.55vw + 14px, 22px); width:auto; display:block;" />
    </a>

    <!-- Mobile CTA — only on homepage, left side -->
    {isHome && (
      <a href={contactHref} class="md:hidden font-mono text-[10px] tracking-widest uppercase bg-brand-black text-brand-white px-3 py-1.5">
        {mobileCTALabel}
      </a>
    )}

    <div id="nav-full" class="hidden 3xl:flex items-center gap-[clamp(1rem,1.8vw,2rem)]">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`font-mono text-[clamp(0.625rem,0.28vw+0.48rem,0.75rem)] tracking-widest uppercase transition-opacity ${
            currentPath === link.href || currentPath === link.href.replace(/\/$/, '') + '/' ? 'opacity-100' : 'opacity-60 hover:opacity-100'
          }`}
        >
          {link.label}
        </a>
      ))}
      <div class="lang-switch relative font-mono text-[clamp(0.625rem,0.28vw+0.48rem,0.75rem)] tracking-widest uppercase">
        <button class="lang-toggle font-medium flex items-center gap-1 hover:opacity-50 transition-opacity" aria-haspopup="listbox" aria-expanded="false" title={lang === 'cs' ? 'Jazyk webu' : 'Site language'}>
          {lang === 'cs' ? 'CZ' : 'EN'}<span style="font-size:7px; line-height:1;">▼</span>
        </button>
        <div class="lang-menu hidden absolute right-0 top-full mt-2 bg-brand-white border border-brand-black/20 z-[110] shadow-sm" role="listbox">
          <span class="block px-3 py-1.5 font-medium" aria-current="true">{lang === 'cs' ? 'CZ' : 'EN'}</span>
          <a href={alternatePath} class="block px-3 py-1.5 opacity-60 hover:opacity-100 transition-opacity">{altLabel}</a>
        </div>
      </div>
      <div class="fs-switch flex flex-col items-center" aria-label={lang === 'cs' ? 'Velikost písma' : 'Font size'}>
        <div class="flex items-end" style="gap:3px;">
          <button data-fs="1" class="border border-brand-black/40 hover:border-brand-black transition-colors" style="width:7px; height:8px;" title={lang === 'cs' ? 'Malé písmo' : 'Small text'} aria-label={lang === 'cs' ? 'Malé písmo' : 'Small text'}></button>
          <button data-fs="1.08" class="border border-brand-black/40 hover:border-brand-black transition-colors" style="width:7px; height:12px;" title={lang === 'cs' ? 'Střední písmo' : 'Medium text'} aria-label={lang === 'cs' ? 'Střední písmo' : 'Medium text'}></button>
          <button data-fs="1.16" class="border border-brand-black/40 hover:border-brand-black transition-colors" style="width:7px; height:16px;" title={lang === 'cs' ? 'Velké písmo' : 'Large text'} aria-label={lang === 'cs' ? 'Velké písmo' : 'Large text'}></button>
        </div>
        <span class="font-mono tracking-widest text-brand-black/60 mt-0.5" style="font-size:8px;">TEXT</span>
      </div>
    </div>

    <!-- Hamburger row — md up to 1800px -->
    <div id="nav-hamburger" class="hidden md:flex 3xl:hidden items-center gap-3">
      <button id="mobile-menu-btn" class="font-mono text-xs tracking-widest uppercase" aria-label="Menu">[ MENU ]</button>
      <div class="lang-switch relative font-mono text-xs tracking-widest uppercase">
        <button class="lang-toggle font-medium flex items-center gap-1 hover:opacity-50 transition-opacity" aria-haspopup="listbox" aria-expanded="false" title={lang === 'cs' ? 'Jazyk webu' : 'Site language'}>
          {lang === 'cs' ? 'CZ' : 'EN'}<span style="font-size:7px; line-height:1;">▼</span>
        </button>
        <div class="lang-menu hidden absolute right-0 top-full mt-2 bg-brand-white border border-brand-black/20 z-[110] shadow-sm" role="listbox">
          <span class="block px-3 py-1.5 font-medium" aria-current="true">{lang === 'cs' ? 'CZ' : 'EN'}</span>
          <a href={alternatePath} class="block px-3 py-1.5 opacity-60 hover:opacity-100 transition-opacity">{altLabel}</a>
        </div>
      </div>
      <div class="fs-switch flex flex-col items-center" aria-label={lang === 'cs' ? 'Velikost písma' : 'Font size'}>
        <div class="flex items-end" style="gap:3px;">
          <button data-fs="1" class="border border-brand-black/40 hover:border-brand-black transition-colors" style="width:7px; height:8px;" title={lang === 'cs' ? 'Malé písmo' : 'Small text'} aria-label={lang === 'cs' ? 'Malé písmo' : 'Small text'}></button>
          <button data-fs="1.08" class="border border-brand-black/40 hover:border-brand-black transition-colors" style="width:7px; height:12px;" title={lang === 'cs' ? 'Střední písmo' : 'Medium text'} aria-label={lang === 'cs' ? 'Střední písmo' : 'Medium text'}></button>
          <button data-fs="1.16" class="border border-brand-black/40 hover:border-brand-black transition-colors" style="width:7px; height:16px;" title={lang === 'cs' ? 'Velké písmo' : 'Large text'} aria-label={lang === 'cs' ? 'Velké písmo' : 'Large text'}></button>
        </div>
        <span class="font-mono tracking-widest text-brand-black/60 mt-0.5" style="font-size:8px;">TEXT</span>
      </div>
    </div>

    <!-- Mobile-only menu button (< md) -->
    <button
      id="mobile-menu-btn-sm"
      class="md:hidden font-mono text-xs tracking-widest uppercase"
      aria-label="Menu"
    >
      [ MENU ]
    </button>
  </div>
</nav>

<!-- Slide-in menu -->
<div
  id="mobile-menu"
  class="fixed top-0 right-0 bottom-0 z-[100] bg-brand-white w-4/5 max-w-xs flex flex-col pt-20 px-8 pb-8 gap-6 shadow-2xl"
  style="transform: translateX(100%); transition: transform 0.3s ease;"
>
  <button id="mobile-menu-close" class="absolute top-5 right-6 font-mono text-xs tracking-widest">[ {lang === 'cs' ? 'ZAVŘÍT' : 'CLOSE'} ]</button>
  {navLinks.map(link => (
    <a
      href={link.href}
      class="font-display text-2xl font-bold hover:opacity-50 transition-opacity border-b border-brand-black/10 pb-4"
    >
      {link.label}
    </a>
  ))}
  <a href={alternatePath} class="font-mono text-sm tracking-widest uppercase opacity-60 hover:opacity-100 transition-opacity mt-2">
    {altLabel} ↗
  </a>
</div>

<!-- Overlay backdrop -->
<div id="mobile-overlay" class="fixed inset-0 z-[99] bg-brand-black/30 hidden"></div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;
  const overlay = document.getElementById('mobile-overlay');

  function openMenu() {
    if (menu) menu.style.transform = 'translateX(0)';
    overlay?.classList.remove('hidden');
  }
  function closeMenu() {
    if (menu) menu.style.transform = 'translateX(100%)';
    overlay?.classList.add('hidden');
  }

  btn?.addEventListener('click', openMenu);
  document.getElementById('mobile-menu-btn-sm')?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });

  const nav = document.getElementById('main-nav');
  const logo = document.getElementById('nav-logo') as HTMLAnchorElement | null;
  const isHomePage = document.querySelector('h1') !== null && logo?.style.opacity === '0';

  const navFull = document.getElementById('nav-full') as HTMLElement | null;
  const navHamburger = document.getElementById('nav-hamburger') as HTMLElement | null;
  const mobileMenuSm = document.getElementById('mobile-menu-btn-sm');

  function applyHomeMenuVisibility(showLogo: boolean) {
    if (!navFull || !navHamburger) return;
    const w = window.innerWidth;
    const menuBtn = document.getElementById('mobile-menu-btn');

    if (!showLogo) {
      // Hero: jen sbalené [ MENU ] — vycentrované, vpravo zůstávají CZ/EN + velikost písma
      navFull.style.display = 'none';
      if (w >= 768) {
        navHamburger.style.display = 'flex';
        if (menuBtn) {
          menuBtn.style.position = 'absolute';
          menuBtn.style.left = '50%';
          menuBtn.style.transform = 'translateX(-50%)';
        }
      } else {
        navHamburger.style.display = 'none';
        if (mobileMenuSm) mobileMenuSm.style.display = '';
      }
      return;
    }

    // Po scrollu: rozbalená navigace jako na podstránkách, [ MENU ] zpět vpravo
    if (menuBtn) {
      menuBtn.style.position = '';
      menuBtn.style.left = '';
      menuBtn.style.transform = '';
    }
    if (mobileMenuSm) mobileMenuSm.style.display = '';

    if (w >= 1800) {
      navFull.style.display = 'flex';
      navHamburger.style.display = 'none';
    } else if (w >= 768) {
      navFull.style.display = 'flex';
      navHamburger.style.display = 'none';
    } else {
      navFull.style.display = 'none';
      navHamburger.style.display = 'none';
    }
  }

  function updateNav() {
    if (!nav) return;
    const scrolled = window.scrollY > 30;
    nav.style.background = scrolled ? 'rgba(252,252,252,0.85)' : '';
    nav.style.backdropFilter = scrolled ? 'blur(8px)' : '';
    nav.style.mixBlendMode = scrolled ? 'normal' : 'multiply';

    if (logo && isHomePage) {
      const h1 = document.querySelector('h1');
      if (h1) {
        const showLogo = h1.getBoundingClientRect().bottom < 0;
        logo.style.opacity = showLogo ? '1' : '0';
        logo.style.pointerEvents = showLogo ? 'auto' : 'none';
        applyHomeMenuVisibility(showLogo);
      }
    }
  }
  window.addEventListener('scroll', updateNav, { passive: true });
  window.addEventListener('resize', updateNav);
  updateNav();

  // Přepínač velikosti textu — tři sloupce (malý/střední/velký) s popiskem TEXT.
  // Škáluje se POUZE obsah pod hero sekcí (zoom) — hero, navigace ani scroll indikátor se nemění.
  (function () {
    const FS_KEY = 'uxmind-font-scale';
    const LEVELS = [1, 1.08, 1.16];
    const bars = document.querySelectorAll<HTMLButtonElement>('.fs-switch button');

    function applyFS(v: number) {
      const idx = LEVELS.indexOf(v);
      // root font-size neškálujeme (kvůli art-directed hero layoutu)
      document.documentElement.style.fontSize = '';
      // hero texty se škálují přes CSS proměnnou --fs (pozice v mřížce zůstávají)
      document.documentElement.style.setProperty('--fs', v === 1 ? '' : String(v));
      // zoom na obsahové bloky: vše za hero sekcí + main a footer na podstránkách
      document.querySelectorAll<HTMLElement>('.hero-shell ~ *, main, footer').forEach(el => {
        el.style.setProperty('zoom', v === 1 ? '' : String(v));
      });
      bars.forEach(b => {
        const bi = LEVELS.indexOf(parseFloat(b.dataset.fs || '1'));
        const filled = bi > -1 && bi <= idx;
        b.style.background = filled ? '#0A0A0A' : 'transparent';
        b.setAttribute('aria-pressed', bi === idx ? 'true' : 'false');
      });
    }

    let fs = parseFloat(localStorage.getItem(FS_KEY) || '1');
    if (!LEVELS.includes(fs)) fs = 1;
    applyFS(fs);

    bars.forEach(b => b.addEventListener('click', () => {
      fs = parseFloat(b.dataset.fs || '1');
      localStorage.setItem(FS_KEY, String(fs));
      applyFS(fs);
    }));
  })();

  // Jazykový přepínač — rozbalovací menu (aktuální jazyk + další; připraveno na víc jazyků).
  // Při otevření vypínáme mix-blend-multiply na navigaci, jinak by bílý podklad menu působil průhledně.
  (function () {
    const switches = document.querySelectorAll<HTMLElement>('.lang-switch');
    const navEl = document.getElementById('main-nav');
    function closeAll() {
      switches.forEach(s => {
        s.querySelector('.lang-menu')?.classList.add('hidden');
        s.querySelector('.lang-toggle')?.setAttribute('aria-expanded', 'false');
      });
      if (navEl) navEl.style.mixBlendMode = window.scrollY > 30 ? 'normal' : 'multiply';
    }
    switches.forEach(s => {
      const toggle = s.querySelector<HTMLElement>('.lang-toggle');
      const menu = s.querySelector<HTMLElement>('.lang-menu');
      toggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        const wasOpen = menu ? !menu.classList.contains('hidden') : false;
        closeAll();
        if (!wasOpen && menu && toggle) {
          menu.classList.remove('hidden');
          toggle.setAttribute('aria-expanded', 'true');
          if (navEl) navEl.style.mixBlendMode = 'normal';
        }
      });
    });
    document.addEventListener('click', closeAll);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAll(); });
    window.addEventListener('scroll', closeAll, { passive: true });
  })();
</script>
